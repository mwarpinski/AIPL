;; The aipl command, written in AIPL: the self-hosted toolchain
;; (driver.aipl: resolve, check, compile to wasm) and the native backend
;; (native/native.aipl: wasm to a Linux x86-64 executable) as one program.
;; Built natively, it is the stage-0 compiler (bootstrap/README.md): it
;; builds the next version of itself with no Rust involved.
;;
;;   aipl compile FILE.aipl -o OUT.wasm
;;   aipl compile --exe [--sandbox] [--listen ADDR:PORT]... [--allow-run PROGRAM]... FILE.aipl -o OUT
;;   aipl compile [--exe] --max-memory SIZE FILE.aipl -o OUT   (memory's limit, 1M to 2G)
;;   aipl compile --no-opt ...   (without the optimizer, codegen_opt.aipl; it runs by default)
;;   aipl verify FILE.aipl   (resolve and type-check; compile nothing)
;;   aipl doc [MODULE | MODULE.ITEM | FILE.aipl]  (aipl_src/doc.aipl)
;;   aipl --version
;;
;; The standard library is found at $AIPL_STD, else share/aipl/std/ beside
;; the executable's folder, else aipl_src/std/ below the working directory
;; (stdpath.aipl). Exit status 0 on success, 1 on a resolve,
;; type, compile, or write error (reported on stderr as "Error: ..."), 2 on
;; bad usage. An executable it writes (--exe) has its execute bit set, by
;; fs.chmod (aipl_sys_v1; WASI has no call for it).
(module aipl
  (import driver)
  (import option)
  (import stdpath)
  (import native/native)
  (import os)
  (import io)
  (import fs)
  (import str)
  (import fmt)
  (import doc)
  (import buf)
  (import alloc)

  (fn usage [] -> i32
    (call io.eprintln "usage: aipl compile [--exe [--sandbox] [--listen ADDR:PORT]... [--allow-run PROGRAM]... [--serve ADDR:PORT]] [--tests] [--max-memory SIZE] [--no-opt] FILE.aipl -o OUT")
    (call io.eprintln "       aipl verify FILE.aipl")
    (call io.eprintln "       aipl doc [MODULE | MODULE.ITEM | FILE.aipl] [--private] | --find WORD | --check FILE.aipl...")
    (call io.eprintln "       aipl --version")
    2)

  ;; Argument i, whose index the caller checked against os.arg_count.
  (fn arg [i:i32] -> str.Bytes
    (call (option.unwrap_or str.Bytes) (call os.arg i) (call str.from_str "")))

  (fn fail [s:str] -> i32
    (call io.write_str 2 "Error: ")
    (call io.eprintln s)
    1)

  (fn fail_bytes [prefix:str b:str.Bytes] -> i32
    (call io.write_str 2 "Error: ")
    (call io.write_str 2 prefix)
    (unsafe (fs.write 2 (call str.addr b) (get b str.Bytes.len)))
    (call io.eprintln "")
    1)

  ;; fail_bytes, after removing the temporary file that was being written
  ;; (there may be none: what is left of a failed write is no use).
  (fn fail_removing [tmp:str.Bytes prefix:str b:str.Bytes] -> i32
    (let _gone:bool (match_result (call fs.remove_path tmp) (ok done true) (err e false)))
    (call fail_bytes prefix b))

  ;; aipl verify FILE.aipl: the front end alone, as the Rust command's verify
  ;; (src/main.rs): the same message on success, the same errors.
  (fn verify [n:i32] -> i32
    (when (neq n 3) (return (call usage)))
    (let std_dir:str.Bytes (call stdpath.find))
    (let entry:str.Bytes (call arg 2))
    (let res:(ptr driver.Out) (call driver.verify_file (call str.addr entry) (get entry str.Bytes.len) (call str.addr std_dir) (get std_dir str.Bytes.len)))
    (when (neq (get res driver.Out.status) 0)
        (return (call fail_bytes "" (unsafe (call str.bytes (get res driver.Out.addr) (get res driver.Out.len))))))
    (call io.write_str 1 "[AIPL Verifier] OK: module '")
    (unsafe (fs.write 1 (get res driver.Out.addr) (get res driver.Out.len)))
    (call io.println "' type-checks. Contracts are type-checked, not proven; req/ens run on every call, in the VM and in compiled code.")
    0)

  (fn write_int [fd:i32 n:i32] -> void
    (unsafe (let digits:i32 (mem.alloc 11))
    (fs.write fd digits (call fmt.int_to_bytes n digits))))

  (fn main [] -> i32
    (let n:i32 (call os.arg_count))
    (when (lt n 2) (return (call usage)))
    (let cmd:str.Bytes (call arg 1))
    (when (call str.is cmd "--version") (call io.println "aipl 0.1.0") (return 0))
    (when (call str.is cmd "doc") (return (call doc.command 2)))
    (when (call str.is cmd "verify") (return (call verify n)))
    (when (not (call str.is cmd "compile")) (return (call usage)))
    (let exe:bool false)
    (let tests:bool false)
    (let sandbox:bool false)
    ;; the optimizer runs unless --no-opt (docs/design/OPT_PLAN.md)
    (let opt:bool true)
    ;; --listen grants, one ADDR:PORT a line (native.compile_with)
    (let listen:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    ;; --serve: the address the executable serves on, a fresh copy per connection
    (let serve:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    ;; memory's maximum in pages (--max-memory; src/compiler/mod.rs memory_pages)
    (let max_pages:i32 32768)
    (let in_i:i32 -1)
    (let out_i:i32 -1)
    (let i:i32 2)
    (while (lt i n)
      (let a:str.Bytes (call arg i))
      (cond
        ((call str.is a "--exe") (set! exe true))
        ((call str.is a "--tests") (set! tests true))
        ((call str.is a "--no-opt") (set! opt false))
        ((call str.is a "--sandbox") (set! sandbox true))
        ((call str.is a "--max-memory")
         (when (gte (+ i 1) n) (return (call usage)))
         (set! max_pages (call driver.memory_pages (call arg (+ i 1))))
         (when (lt max_pages 0)
               (let m:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
               (call buf.push_str m "--max-memory ")
               (call buf.push_bytes m (call arg (+ i 1)))
               (call buf.push_str m ": expected a size from 1M to 2G in whole 64K pages, as 512M")
               (return (call fail_bytes "" (call buf.bytes m))))
         (set! i (+ i 1)))
        ((call str.is a "--listen")
         (when (gte (+ i 1) n) (return (call usage)))
         ;; checked before anything is compiled, with src/net.rs parse_grant's message
         (when (not (call native.valid_grant (call arg (+ i 1))))
               (let m:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
               (call buf.push_str m "--listen ")
               (call buf.push_bytes m (call arg (+ i 1)))
               (call buf.push_str m ": expected ADDR:PORT, as 127.0.0.1:8080 or [::1]:8080")
               (return (call fail_bytes "" (call buf.bytes m))))
         (call buf.push_bytes listen (call arg (+ i 1)))
         (call buf.push_byte listen 10)
         (set! i (+ i 1)))
        ((call str.is a "--allow-run")
         (when (gte (+ i 1) n) (return (call usage)))
         ;; a program the executable may start, a `run:PROGRAM` line among the grants;
         ;; checked before anything is compiled, as native.compile_with does too
         (when (gt (get (call arg (+ i 1)) str.Bytes.len) (call native.max_run_grant))
               (let m:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
               (call buf.push_str m "--allow-run ")
               (call buf.push_bytes m (call arg (+ i 1)))
               (call buf.push_str m ": the program's path is longer than 256 bytes, the most a native executable's grant holds")
               (return (call fail_bytes "" (call buf.bytes m))))
         (call buf.push_str listen "run:")
         (call buf.push_bytes listen (call arg (+ i 1)))
         (call buf.push_byte listen 10)
         (set! i (+ i 1)))
        ((call str.is a "--serve")
         (when (or (gte (+ i 1) n) (gt (call buf.len serve) 0)) (return (call usage)))
         (when (not (call native.valid_grant (call arg (+ i 1))))
               (let m:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
               (call buf.push_str m "--serve ")
               (call buf.push_bytes m (call arg (+ i 1)))
               (call buf.push_str m ": expected ADDR:PORT, as 127.0.0.1:8080 or [::1]:8080")
               (return (call fail_bytes "" (call buf.bytes m))))
         (call buf.push_bytes serve (call arg (+ i 1)))
         (set! i (+ i 1)))
        ((call str.is a "-o")
         (when (gte (+ i 1) n) (return (call usage)))
         (set! out_i (+ i 1))
         (set! i (+ i 1)))
        ((lt in_i 0) (set! in_i i))
        (else (return (call usage))))
      (set! i (+ i 1)))
    (when (or (lt in_i 0) (lt out_i 0)) (return (call usage)))
    (when (and (or sandbox (or (gt (call buf.len listen) 0) (gt (call buf.len serve) 0))) (not exe)) (return (call usage)))
    (let std_dir:str.Bytes (call stdpath.find))
    (let entry:str.Bytes (call arg in_i))
    (let out:str.Bytes (call arg out_i))
    (let ea:i32 (call str.addr entry))
    (let el:i32 (get entry str.Bytes.len))
    (let da:i32 (call str.addr std_dir))
    (let dl:i32 (get std_dir str.Bytes.len))
    (let res:(ptr driver.Out) (cond
                                ((and tests opt) (call driver.compile_tests_opt ea el da dl max_pages))
                                (tests (call driver.compile_tests_limited ea el da dl max_pages))
                                (opt (call driver.compile_file_opt ea el da dl max_pages))
                                (else (call driver.compile_file_limited ea el da dl max_pages))))
    (let status:i32 (get res driver.Out.status))
    (when (or (eq status 1) (eq status 3))
        (return (call fail_bytes "" (unsafe (call str.bytes (get res driver.Out.addr) (get res driver.Out.len))))))
    (when (eq status 2)
          (call io.write_str 2 "Error: compile error ")
          (call write_int 2 (get res driver.Out.len))
          (call io.eprintln " (AIPL_SPEC.md 6.4)")
          (return 1))
    (let bytes:str.Bytes (unsafe (call str.bytes (get res driver.Out.addr) (get res driver.Out.len))))
    (when exe
          (let o:(ptr native.Output) (call native.compile_with bytes sandbox (call buf.bytes listen) (call buf.bytes serve)))
          (when (not (get o native.Output.ok)) (return (call fail_bytes "native backend: " (get o native.Output.error))))
          (set! bytes (get o native.Output.exe)))
    ;; Written beside the output and renamed into place, as the Rust command
    ;; does: a file that was run is never opened for writing again (Linux can
    ;; refuse with "Text file busy"; macOS kills a binary rewritten in place).
    (let tmp_buf:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (call buf.push_bytes tmp_buf out)
    (call buf.push_str tmp_buf ".aipl-tmp")
    (let tmp:str.Bytes (call buf.bytes tmp_buf))
    (when (match_result (call io.write_path tmp bytes) (ok wrote (neq wrote (get bytes str.Bytes.len))) (err e true))
        (return (call fail_removing tmp "cannot write " out)))
    ;; an executable is one: the execute bit, as the Rust command sets it
    (when (and exe (match_result (call fs.chmod_path tmp fs.PROGRAM) (ok done false) (err e true)))
        (return (call fail_removing tmp "cannot make executable " out)))
    (when (match_result (call fs.rename_path tmp out) (ok done false) (err e true))
        (return (call fail_removing tmp "cannot write " out)))
    (call io.write_str 1 "[AIPL Compiler] Successfully compiled '")
    (unsafe (fs.write 1 (call str.addr entry) (get entry str.Bytes.len)))
    (call io.write_str 1 "' -> '")
    (unsafe (fs.write 1 (call str.addr out) (get out str.Bytes.len)))
    (call io.write_str 1 "' (")
    (call write_int 1 (get bytes str.Bytes.len))
    (call io.println " bytes)")
    0)

  ;; WASI command entry point: runs main and exits with its status.
  (fn _start [] -> void
    (sys.exit (call main))))
