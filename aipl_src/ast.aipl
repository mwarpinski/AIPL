;; The typed syntax tree of an AIPL program, as AIPL data: what
;; parser.aipl builds and checker.aipl checks. Mirrors src/ast.rs, form for
;; form (docs/design/CHECKER_PLAN.md).
;;
;; Names and literal texts are spans of the source (str.Bytes), never
;; copied. Every expression records `at`, the source offset of its first
;; token (a group's opening parenthesis); compiler.line_col turns it into
;; the line:col that messages report.
(module ast
  (import str)
  (import alloc)

  ;; A type, as src/ast.rs Type. A struct is named inside a ptr, or on its
  ;; own for a value struct; any other bare name is an enum or a union.
  (union Type [(i32) (i64) (f32) (f64) (bool) (str) (void)
               (ptr n:(ptr PtrType))
               (struct_ name:str.Bytes)
               (result n:(ptr ResultType))
               (arr n:(ptr ArrType))
               (fn_ n:(ptr FnType))
               (enum_ name:str.Bytes)
               (union_ name:str.Bytes)
               ;; storage types: a struct field's or array element's only, read as an i32
               (u8) (i8) (u16) (i16)] (pub))

  ;; An optional type or expression (src/ast.rs Option<Type>, Option<Box<Expr>>).
  (union MaybeType [(none) (some t:Type)] (pub))
  (union MaybeExpr [(none) (some e:Expr)] (pub))

  ;; The built-in operators, in src/ast.rs OpCode order.
  (enum Op [add sub mul div mod divu remu bitxor shl shr shru bitand bitor
            mem_load8 mem_load32 mem_load64 mem_store8 mem_store32 mem_store64
            mem_load8_s mem_load16_u mem_load16_s mem_store16 mem_alloc mem_grow
            atomic_add atomic_cas atomic_lock atomic_unlock
            eq neq lt lte checked_add checked_sub checked_mul ltu lteu gtu gteu gt gte and or not
            sys_print sys_time sys_monotonic sys_random sys_exit
            fs_open fs_read fs_write fs_close fs_delete args_sizes args_get env_sizes env_get
            thread_spawn thread_join i64_extend_s i64_extend_u i32_wrap
            f64_convert_i64_s f32_demote f64_promote f32_convert_i32_s f32_convert_i64_s f64_convert_i32_s
            i32_trunc_f32_s i32_trunc_f64_s i64_trunc_f32_s f32_reinterpret_i32 i32_reinterpret_f32 f64_sqrt i64_trunc_f64_s f64_reinterpret_i64 i64_reinterpret_f64
            str_len str_ptr fs_opendir fs_readdir fs_stat
            format_str format_to format_print format_println format_eprintln format_piece
            try_ try_opt try_or defer format_dbg format_expect] (pub))

  ;; ptr.addr, arr.addr, enum.ord: a value's address or ordinal as an i32;
  ;; ptr.gen, arr.gen: the generation a pointer carries.
  (enum AddrKind [ptr arr enum_ ptr_gen arr_gen] (pub))

  ;; One step of a put's or arr.set's field path: field fname of struct
  ;; sname (src/ast.rs PutField.path, ArrSet.path).
  (struct Step [(pub sname:str.Bytes) (pub fname:str.Bytes)] (pub))

  ;; One arm of a match (src/ast.rs MatchArm). binders is null for an arm
  ;; written without brackets.
  (struct Arm [(pub member:str.Bytes) (pub binders:(arr str.Bytes)) (pub body:(arr Expr)) (pub at:i32)] (pub))

  ;; An expression, one variant per form of src/ast.rs Expr. A float
  ;; literal (f64 or f32) keeps its text; a string literal its text between the quotes,
  ;; escapes unexpanded.
  (union Expr [(lit_int at:i32 v:i64)
               (lit_i64 at:i32 v:i64)
               (lit_float at:i32 text:str.Bytes)
               (lit_f32 at:i32 text:str.Bytes)
               (lit_bool at:i32 v:bool)
               (lit_str at:i32 raw:str.Bytes)
               (var at:i32 name:str.Bytes)
               (let_ n:(ptr LetExpr))
               (set n:(ptr SetExpr))
               (if_ n:(ptr IfExpr))
               (loop n:(ptr LoopExpr))
               (while_ n:(ptr WhileExpr))
               (call at:i32 func:str.Bytes args:(arr Expr))
               (op at:i32 op:Op args:(arr Expr))
               (ok n:(ptr OkExpr))
               (err n:(ptr ErrExpr))
               (match_result n:(ptr MatchResultExpr))
               (block at:i32 body:(arr Expr))
               (unsafe_ at:i32 body:(arr Expr))
               (new_ at:i32 name:str.Bytes)
               (get_ n:(ptr GetExpr))
               (put_ n:(ptr PutExpr))
               (sizeof at:i32 ty:Type)
               (arr_new n:(ptr ArrNewExpr))
               (arr_get n:(ptr ArrGetExpr))
               (arr_set n:(ptr ArrSetExpr))
               (arr_len n:(ptr ArrLenExpr))
               (null at:i32 ty:Type)
               (cast n:(ptr CastExpr))
               ;; (ptr.make S addr gen) / (arr.make T addr gen): a checked pointer
               (make_ptr n:(ptr MakePtrExpr))
               (make n:(ptr MakeExpr))
               (record at:i32 sname:str.Bytes args:(arr Expr))
               (with_ n:(ptr WithExpr))
               (match_ n:(ptr MatchExpr))
               (return_ n:(ptr ReturnExpr))
               (break_ at:i32)
               (continue_ at:i32)
               (ref at:i32 name:str.Bytes)
               (call_ref n:(ptr CallRefExpr))
               (addr n:(ptr AddrExpr))] (pub))

  (union Contract [(requires e:Expr) (ensures e:Expr) (invariant e:Expr)] (pub))

  (struct Field [(pub name:str.Bytes) (pub ty:Type)] (pub))
  ;; value: a value struct, (struct S [...] (value)) (src/ast.rs StructDef.is_value).
  (struct StructDef [(pub name:str.Bytes) (pub fields:(arr (ptr Field))) (pub at:i32) (pub value:bool)] (pub))
  ;; members are names with their values (src/ast.rs EnumDef)
  (struct Member [(pub name:str.Bytes) (pub value:i32)] (pub))
  (struct EnumDef [(pub name:str.Bytes) (pub members:(arr (ptr Member))) (pub at:i32)] (pub))
  (struct Variant [(pub name:str.Bytes) (pub fields:(arr (ptr Field)))] (pub))
  (struct UnionDef [(pub name:str.Bytes) (pub variants:(arr (ptr Variant))) (pub at:i32)] (pub))
  (struct Param [(pub name:str.Bytes) (pub ty:Type)] (pub))
  ;; unsafe_: the (unsafe) clause (src/ast.rs FnDef.is_unsafe); no_leak:
  ;; the (no_leak) clause (is_no_leak, leaks.aipl).
  (struct FnDef [(pub name:str.Bytes) (pub params:(arr (ptr Param))) (pub ret:Type)
                 (pub contracts:(arr Contract)) (pub body:(arr Expr)) (pub at:i32) (pub unsafe_:bool) (pub no_leak:bool)] (pub))
  (struct Import [(pub name:str.Bytes) (pub alias:str.Bytes)] (pub))
  (struct Module [(pub name:str.Bytes) (pub imports:(arr (ptr Import)))
                  (pub structs:(arr (ptr StructDef))) (pub enums:(arr (ptr EnumDef)))
                  (pub unions:(arr (ptr UnionDef))) (pub fns:(arr (ptr FnDef)))] (pub))

  ;; The fields of the variants that hold sub-expressions or sub-types (and
  ;; Expr.make, too wide to hold inline): every union is a value
  ;; (docs/design/MEMORY_PLAN.md M4), so a variant that would contain its
  ;; own union, or need more than 8 slots, holds a pointer to a struct of
  ;; its fields instead. The fields are read-only outside this module; the
  ;; constructors below are the only way to make one.
  (struct PtrType [(read inner:Type)] (pub))
  (struct ResultType [(read ok:Type) (read err:Type)] (pub))
  (struct ArrType [(read elem:Type)] (pub))
  (struct FnType [(read params:(arr Type)) (read ret:Type)] (pub))
  (struct LetExpr [(read at:i32) (read name:str.Bytes) (read ty:Type) (read val:Expr)] (pub))
  (struct SetExpr [(read at:i32) (read name:str.Bytes) (read val:Expr)] (pub))
  (struct IfExpr [(read at:i32) (read cond:Expr) (read then_:Expr) (read else_:Expr)] (pub))
  (struct LoopExpr [(read at:i32) (read var:str.Bytes) (read start:Expr) (read end:Expr) (read step:Expr) (read body:(arr Expr))] (pub))
  (struct WhileExpr [(read at:i32) (read cond:Expr) (read body:(arr Expr))] (pub))
  (struct OkExpr [(read at:i32) (read val:Expr) (read ty:MaybeType)] (pub))
  (struct ErrExpr [(read at:i32) (read val:Expr) (read ty:MaybeType)] (pub))
  (struct MatchResultExpr [(read at:i32) (read val:Expr) (read ok_var:str.Bytes) (read ok_body:(arr Expr)) (read err_var:str.Bytes) (read err_body:(arr Expr))] (pub))
  (struct GetExpr [(read at:i32) (read sname:str.Bytes) (read fname:str.Bytes) (read ptr:Expr)] (pub))
  (struct PutExpr [(read at:i32) (read sname:str.Bytes) (read fname:str.Bytes) (read ptr:Expr) (read val:Expr) (read path:(arr (ptr Step)))] (pub))
  (struct ArrNewExpr [(read at:i32) (read ty:Type) (read size:Expr)] (pub))
  (struct ArrGetExpr [(read at:i32) (read ty:Type) (read ptr:Expr) (read index:Expr)] (pub))
  (struct ArrSetExpr [(read at:i32) (read ty:Type) (read ptr:Expr) (read index:Expr) (read val:Expr) (read path:(arr (ptr Step)))] (pub))
  (struct ArrLenExpr [(read at:i32) (read arr:Expr)] (pub))
  (struct CastExpr [(read at:i32) (read ty:Type) (read addr:Expr)] (pub))
  (struct MakePtrExpr [(read at:i32) (read ty:Type) (read addr:Expr) (read gen:Expr)] (pub))
  (struct MakeExpr [(read at:i32) (read uname:str.Bytes) (read variant:str.Bytes) (read args:(arr Expr))] (pub))
  (struct WithExpr [(read at:i32) (read sname:str.Bytes) (read fname:str.Bytes) (read val:Expr) (read new:Expr)] (pub))
  (struct MatchExpr [(read at:i32) (read val:Expr) (read arms:(arr (ptr Arm))) (read else_body:(arr Expr))] (pub))
  (struct ReturnExpr [(read at:i32) (read val:MaybeExpr)] (pub))
  (struct CallRefExpr [(read at:i32) (read sig:Type) (read func:Expr) (read args:(arr Expr))] (pub))
  (struct AddrExpr [(read at:i32) (read val:Expr) (read kind:AddrKind)] (pub))

  ;; One constructor per such variant, its cell from a.
  (fn ptr_type [a:alloc.Allocator inner:Type] -> Type (pub)
    (let n:(ptr PtrType) (call (alloc.create PtrType) a))
    (put n PtrType.inner inner)
    (make Type.ptr n))
  (fn result_type [a:alloc.Allocator ok:Type err:Type] -> Type (pub)
    (let n:(ptr ResultType) (call (alloc.create ResultType) a))
    (put n ResultType.ok ok)
    (put n ResultType.err err)
    (make Type.result n))
  (fn arr_type [a:alloc.Allocator elem:Type] -> Type (pub)
    (let n:(ptr ArrType) (call (alloc.create ArrType) a))
    (put n ArrType.elem elem)
    (make Type.arr n))
  (fn fn_type [a:alloc.Allocator params:(arr Type) ret:Type] -> Type (pub)
    (let n:(ptr FnType) (call (alloc.create FnType) a))
    (put n FnType.params params)
    (put n FnType.ret ret)
    (make Type.fn_ n))
  (fn let_expr [a:alloc.Allocator at:i32 name:str.Bytes ty:Type val:Expr] -> Expr (pub)
    (let n:(ptr LetExpr) (call (alloc.create LetExpr) a))
    (put n LetExpr.at at)
    (put n LetExpr.name name)
    (put n LetExpr.ty ty)
    (put n LetExpr.val val)
    (make Expr.let_ n))
  (fn set_expr [a:alloc.Allocator at:i32 name:str.Bytes val:Expr] -> Expr (pub)
    (let n:(ptr SetExpr) (call (alloc.create SetExpr) a))
    (put n SetExpr.at at)
    (put n SetExpr.name name)
    (put n SetExpr.val val)
    (make Expr.set n))
  (fn if_expr [a:alloc.Allocator at:i32 cond:Expr then_:Expr else_:Expr] -> Expr (pub)
    (let n:(ptr IfExpr) (call (alloc.create IfExpr) a))
    (put n IfExpr.at at)
    (put n IfExpr.cond cond)
    (put n IfExpr.then_ then_)
    (put n IfExpr.else_ else_)
    (make Expr.if_ n))
  (fn loop_expr [a:alloc.Allocator at:i32 var:str.Bytes start:Expr end:Expr step:Expr body:(arr Expr)] -> Expr (pub)
    (let n:(ptr LoopExpr) (call (alloc.create LoopExpr) a))
    (put n LoopExpr.at at)
    (put n LoopExpr.var var)
    (put n LoopExpr.start start)
    (put n LoopExpr.end end)
    (put n LoopExpr.step step)
    (put n LoopExpr.body body)
    (make Expr.loop n))
  (fn while_expr [a:alloc.Allocator at:i32 cond:Expr body:(arr Expr)] -> Expr (pub)
    (let n:(ptr WhileExpr) (call (alloc.create WhileExpr) a))
    (put n WhileExpr.at at)
    (put n WhileExpr.cond cond)
    (put n WhileExpr.body body)
    (make Expr.while_ n))
  (fn ok_expr [a:alloc.Allocator at:i32 val:Expr ty:MaybeType] -> Expr (pub)
    (let n:(ptr OkExpr) (call (alloc.create OkExpr) a))
    (put n OkExpr.at at)
    (put n OkExpr.val val)
    (put n OkExpr.ty ty)
    (make Expr.ok n))
  (fn err_expr [a:alloc.Allocator at:i32 val:Expr ty:MaybeType] -> Expr (pub)
    (let n:(ptr ErrExpr) (call (alloc.create ErrExpr) a))
    (put n ErrExpr.at at)
    (put n ErrExpr.val val)
    (put n ErrExpr.ty ty)
    (make Expr.err n))
  (fn match_result_expr [a:alloc.Allocator at:i32 val:Expr ok_var:str.Bytes ok_body:(arr Expr) err_var:str.Bytes err_body:(arr Expr)] -> Expr (pub)
    (let n:(ptr MatchResultExpr) (call (alloc.create MatchResultExpr) a))
    (put n MatchResultExpr.at at)
    (put n MatchResultExpr.val val)
    (put n MatchResultExpr.ok_var ok_var)
    (put n MatchResultExpr.ok_body ok_body)
    (put n MatchResultExpr.err_var err_var)
    (put n MatchResultExpr.err_body err_body)
    (make Expr.match_result n))
  (fn get_expr [a:alloc.Allocator at:i32 sname:str.Bytes fname:str.Bytes ptr:Expr] -> Expr (pub)
    (let n:(ptr GetExpr) (call (alloc.create GetExpr) a))
    (put n GetExpr.at at)
    (put n GetExpr.sname sname)
    (put n GetExpr.fname fname)
    (put n GetExpr.ptr ptr)
    (make Expr.get_ n))
  (fn put_expr [a:alloc.Allocator at:i32 sname:str.Bytes fname:str.Bytes ptr:Expr val:Expr path:(arr (ptr Step))] -> Expr (pub)
    (let n:(ptr PutExpr) (call (alloc.create PutExpr) a))
    (put n PutExpr.at at)
    (put n PutExpr.sname sname)
    (put n PutExpr.fname fname)
    (put n PutExpr.ptr ptr)
    (put n PutExpr.val val)
    (put n PutExpr.path path)
    (make Expr.put_ n))
  (fn arr_new_expr [a:alloc.Allocator at:i32 ty:Type size:Expr] -> Expr (pub)
    (let n:(ptr ArrNewExpr) (call (alloc.create ArrNewExpr) a))
    (put n ArrNewExpr.at at)
    (put n ArrNewExpr.ty ty)
    (put n ArrNewExpr.size size)
    (make Expr.arr_new n))
  (fn arr_get_expr [a:alloc.Allocator at:i32 ty:Type ptr:Expr index:Expr] -> Expr (pub)
    (let n:(ptr ArrGetExpr) (call (alloc.create ArrGetExpr) a))
    (put n ArrGetExpr.at at)
    (put n ArrGetExpr.ty ty)
    (put n ArrGetExpr.ptr ptr)
    (put n ArrGetExpr.index index)
    (make Expr.arr_get n))
  (fn arr_set_expr [a:alloc.Allocator at:i32 ty:Type ptr:Expr index:Expr val:Expr path:(arr (ptr Step))] -> Expr (pub)
    (let n:(ptr ArrSetExpr) (call (alloc.create ArrSetExpr) a))
    (put n ArrSetExpr.at at)
    (put n ArrSetExpr.ty ty)
    (put n ArrSetExpr.ptr ptr)
    (put n ArrSetExpr.index index)
    (put n ArrSetExpr.val val)
    (put n ArrSetExpr.path path)
    (make Expr.arr_set n))
  (fn arr_len_expr [a:alloc.Allocator at:i32 arr:Expr] -> Expr (pub)
    (let n:(ptr ArrLenExpr) (call (alloc.create ArrLenExpr) a))
    (put n ArrLenExpr.at at)
    (put n ArrLenExpr.arr arr)
    (make Expr.arr_len n))
  (fn cast_expr [a:alloc.Allocator at:i32 ty:Type addr:Expr] -> Expr (pub)
    (let n:(ptr CastExpr) (call (alloc.create CastExpr) a))
    (put n CastExpr.at at)
    (put n CastExpr.ty ty)
    (put n CastExpr.addr addr)
    (make Expr.cast n))
  (fn make_ptr_expr [a:alloc.Allocator at:i32 ty:Type addr:Expr gen:Expr] -> Expr (pub)
    (let n:(ptr MakePtrExpr) (call (alloc.create MakePtrExpr) a))
    (put n MakePtrExpr.at at)
    (put n MakePtrExpr.ty ty)
    (put n MakePtrExpr.addr addr)
    (put n MakePtrExpr.gen gen)
    (make Expr.make_ptr n))
  (fn make_expr [a:alloc.Allocator at:i32 uname:str.Bytes variant:str.Bytes args:(arr Expr)] -> Expr (pub)
    (let n:(ptr MakeExpr) (call (alloc.create MakeExpr) a))
    (put n MakeExpr.at at)
    (put n MakeExpr.uname uname)
    (put n MakeExpr.variant variant)
    (put n MakeExpr.args args)
    (make Expr.make n))
  (fn with_expr [a:alloc.Allocator at:i32 sname:str.Bytes fname:str.Bytes val:Expr new:Expr] -> Expr (pub)
    (let n:(ptr WithExpr) (call (alloc.create WithExpr) a))
    (put n WithExpr.at at)
    (put n WithExpr.sname sname)
    (put n WithExpr.fname fname)
    (put n WithExpr.val val)
    (put n WithExpr.new new)
    (make Expr.with_ n))
  (fn match_expr [a:alloc.Allocator at:i32 val:Expr arms:(arr (ptr Arm)) else_body:(arr Expr)] -> Expr (pub)
    (let n:(ptr MatchExpr) (call (alloc.create MatchExpr) a))
    (put n MatchExpr.at at)
    (put n MatchExpr.val val)
    (put n MatchExpr.arms arms)
    (put n MatchExpr.else_body else_body)
    (make Expr.match_ n))
  (fn return_expr [a:alloc.Allocator at:i32 val:MaybeExpr] -> Expr (pub)
    (let n:(ptr ReturnExpr) (call (alloc.create ReturnExpr) a))
    (put n ReturnExpr.at at)
    (put n ReturnExpr.val val)
    (make Expr.return_ n))
  (fn call_ref_expr [a:alloc.Allocator at:i32 sig:Type func:Expr args:(arr Expr)] -> Expr (pub)
    (let n:(ptr CallRefExpr) (call (alloc.create CallRefExpr) a))
    (put n CallRefExpr.at at)
    (put n CallRefExpr.sig sig)
    (put n CallRefExpr.func func)
    (put n CallRefExpr.args args)
    (make Expr.call_ref n))
  (fn addr_expr [a:alloc.Allocator at:i32 val:Expr kind:AddrKind] -> Expr (pub)
    (let n:(ptr AddrExpr) (call (alloc.create AddrExpr) a))
    (put n AddrExpr.at at)
    (put n AddrExpr.val val)
    (put n AddrExpr.kind kind)
    (make Expr.addr n))

  ;; Where an expression starts.
  (fn at [e:Expr] -> i32 (pub)
    (match e
      (Expr.lit_int [at _] at) (Expr.lit_i64 [at _] at) (Expr.lit_float [at _] at) (Expr.lit_f32 [at _] at)
      (Expr.lit_bool [at _] at) (Expr.lit_str [at _] at) (Expr.var [at _] at)
      (Expr.let_ [n_let] (let at:i32 (get n_let LetExpr.at)) at) (Expr.set [n_set] (let at:i32 (get n_set SetExpr.at)) at) (Expr.if_ [n_if] (let at:i32 (get n_if IfExpr.at)) at)
      (Expr.loop [n_loop] (let at:i32 (get n_loop LoopExpr.at)) at) (Expr.while_ [n_while] (let at:i32 (get n_while WhileExpr.at)) at) (Expr.call [at _ _] at)
      (Expr.op [at _ _] at) (Expr.ok [n_ok] (let at:i32 (get n_ok OkExpr.at)) at) (Expr.err [n_err] (let at:i32 (get n_err ErrExpr.at)) at)
      (Expr.match_result [n_match_result] (let at:i32 (get n_match_result MatchResultExpr.at)) at) (Expr.block [at _] at) (Expr.unsafe_ [at _] at) (Expr.new_ [at _] at)
      (Expr.get_ [n_get] (let at:i32 (get n_get GetExpr.at)) at) (Expr.put_ [n_put] (let at:i32 (get n_put PutExpr.at)) at) (Expr.sizeof [at _] at)
      (Expr.arr_new [n_arr_new] (let at:i32 (get n_arr_new ArrNewExpr.at)) at) (Expr.arr_get [n_arr_get] (let at:i32 (get n_arr_get ArrGetExpr.at)) at) (Expr.arr_set [n_arr_set] (let at:i32 (get n_arr_set ArrSetExpr.at)) at)
      (Expr.arr_len [n_arr_len] (let at:i32 (get n_arr_len ArrLenExpr.at)) at) (Expr.null [at _] at) (Expr.cast [n_cast] (let at:i32 (get n_cast CastExpr.at)) at) (Expr.make_ptr [n_make_ptr] (let at:i32 (get n_make_ptr MakePtrExpr.at)) at)
      (Expr.make [n_make] (let at:i32 (get n_make MakeExpr.at)) at) (Expr.record [at _ _] at) (Expr.with_ [n_with] (let at:i32 (get n_with WithExpr.at)) at)
      (Expr.match_ [n_match] (let at:i32 (get n_match MatchExpr.at)) at) (Expr.return_ [n_return] (let at:i32 (get n_return ReturnExpr.at)) at)
      (Expr.break_ [at] at) (Expr.continue_ [at] at) (Expr.ref [at _] at)
      (Expr.call_ref [n_call_ref] (let at:i32 (get n_call_ref CallRefExpr.at)) at) (Expr.addr [n_addr] (let at:i32 (get n_addr AddrExpr.at)) at))))
