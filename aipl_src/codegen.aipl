    (let root:i32 (call compiler.parse_ast tok n ast))
    (let func_count:i32 (call collect_functions src root (mem.load32 20)))
    (let e0:i32 (call func_entry_ptr (mem.load32 20) 0))
    (let e0_pcount:i32 (mem.load32 (+ e0 8)))
    (let e0_ret:i32 (mem.load32 (+ e0 12)))
    (let e0_p0:i32 (mem.load32 (+ e0 24)))
    (let e0_p1:i32 (mem.load32 (+ e0 28)))
