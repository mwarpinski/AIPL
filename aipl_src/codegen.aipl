          (let off:i32 0)
          (set! off (+ off (call compile_expr cg (call nth_child node 1) (+ out_ptr off))))
          (set! off (+ off (call emit_store_guard (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call compile_expr cg (call nth_child node 2) (+ out_ptr off))))
          (set! off (+ off (call compile_expr cg (call nth_child node 3) (+ out_ptr off))))
          (set! off (+ off (call emit_local_set (+ out_ptr off) io_b)))
          (set! off (+ off (call emit_local_set (+ out_ptr off) io_a)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) io_a)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) io_b)))
          (set! off (+ off (call emit_atomic (+ out_ptr off) 72)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) io_a)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 70)))
          (set! res off))
        (block))
    (if (eq op_id Kw.atomic_lock) ;; atomic.lock ptr: cmpxchg 0 -> 1, sleep while held, trap on a non-lock word
        (block
          (let off:i32 0)
          (set! off (+ off (call compile_expr cg (call nth_child node 1) (+ out_ptr off))))
          (set! off (+ off (call emit_store_guard (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_local_set (+ out_ptr off) io_a)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 2)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 64)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 3)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 64)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) io_a)))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 0)))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 1)))
          (set! off (+ off (call emit_atomic (+ out_ptr off) 72)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 34)))
          (set! off (+ off (call compiler.encode_u32 (+ out_ptr off) io_b)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 69)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 13)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 1)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) io_b)))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 1)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 71)))
          (set! off (+ off (call emit_trap_if (+ out_ptr off))))
          (set! off (+ off (call emit_local_get (+ out_ptr off) io_a)))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 1)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 66)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 127)))
          (set! off (+ off (call emit_atomic (+ out_ptr off) 1)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 26)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 12)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 0)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 11)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 11)))
          (set! res off))
        (block))
    (if (eq op_id Kw.atomic_unlock) ;; atomic.unlock ptr: xchg 1 -> 0 (trap otherwise), wake all waiters
        (block
          (let off:i32 0)
          (set! off (+ off (call compile_expr cg (call nth_child node 1) (+ out_ptr off))))
          (set! off (+ off (call emit_store_guard (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_byte (+ out_ptr off) 34)))
          (set! off (+ off (call compiler.encode_u32 (+ out_ptr off) io_a)))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 0)))
          (set! off (+ off (call emit_atomic (+ out_ptr off) 65)))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 1)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 71)))
          (set! off (+ off (call emit_trap_if (+ out_ptr off))))
          (set! off (+ off (call emit_local_get (+ out_ptr off) io_a)))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) -1)))
          (set! off (+ off (call emit_atomic (+ out_ptr off) 0)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 26)))
          (set! res off))
        (block))
    (if (eq op_id Kw.thread_spawn) ;; thread.spawn worker arg -> handle: a 16-byte record [done result fn arg] passed to thread-spawn
        (block
          (let off:i32 0)
          (set! off (+ off (call compile_expr cg (call nth_child node 1) (+ out_ptr off))))
          (set! off (+ off (call compile_expr cg (call nth_child node 2) (+ out_ptr off))))
          (set! off (+ off (call emit_local_set (+ out_ptr off) io_b)))
          (set! off (+ off (call emit_local_set (+ out_ptr off) io_a)))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 0)))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 16)))
          (set! off (+ off (call emit_rmw_add (+ out_ptr off))))
          (set! off (+ off (call emit_local_set (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_grow_to_cursor (+ out_ptr off))))
          (set! off (+ off (call emit_local_get (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 0)))
          (set! off (+ off (call emit_memop_offset (+ out_ptr off) 54 2 0)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 0)))
          (set! off (+ off (call emit_memop_offset (+ out_ptr off) 54 2 4)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_local_get (+ out_ptr off) io_a)))
          (set! off (+ off (call emit_memop_offset (+ out_ptr off) 54 2 8)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_local_get (+ out_ptr off) io_b)))
          (set! off (+ off (call emit_memop_offset (+ out_ptr off) 54 2 12)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_call (+ out_ptr off) (call get_wasi_index 10))))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 0)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 72)))
          (set! off (+ off (call emit_trap_if (+ out_ptr off))))
          (set! off (+ off (call emit_local_get (+ out_ptr off) (get cg Cg.nlocals))))
          (set! res off))
        (block))
    (if (eq op_id Kw.thread_join) ;; thread.join handle -> result: sleep until done, read the result
        (block
          (let off:i32 0)
          (set! off (+ off (call compile_expr cg (call nth_child node 1) (+ out_ptr off))))
          (set! off (+ off (call emit_local_set (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_byte (+ out_ptr off) 2)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 64)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 3)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 64)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_atomic (+ out_ptr off) 16)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 13)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 1)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 0)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 66)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 127)))
          (set! off (+ off (call emit_atomic (+ out_ptr off) 1)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 26)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 12)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 0)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 11)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 11)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_memop_offset (+ out_ptr off) 40 2 4)))
          (set! res off))
        (block))

    (if (or (eq op_id Kw.sys_time) (eq op_id Kw.sys_monotonic)) ;; sys.time / sys.monotonic -> clock_time_get into cell 80, i64.load
        (block
          (let off:i32 (call emit_i32_const out_ptr (if (eq op_id Kw.sys_time) 0 1)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 66)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 1)))
          (set! off (+ off (call emit_rt (+ out_ptr off) 80)))
          (set! off (+ off (call emit_call (+ out_ptr off) (call get_wasi_index 11))))
          (set! off (+ off (call emit_trap_if (+ out_ptr off))))
          (set! off (+ off (call emit_rt (+ out_ptr off) 80)))
          (set! off (+ off (call emit_memop (+ out_ptr off) 41 3)))
          (set! res off))
        (block))
    (if (eq op_id Kw.sys_random) ;; sys.random ptr len -> random_get, errno -> 0 / -1
        (block
          (let off:i32 (call compile_expr cg (call nth_child node 1) out_ptr))
          (set! off (+ off (call compile_expr cg (call nth_child node 2) (+ out_ptr off))))
          (set! off (+ off (call emit_call (+ out_ptr off) (call get_wasi_index 12))))
          (set! off (+ off (call emit_errno_to_result (+ out_ptr off) -1)))
          (set! res off))
        (block))

    ;; and / or short-circuit, as wasm.rs: (and a b) = a; if (result i32) b else
    ;; i32.const 0 end; (or a b) = a; if (result i32) i32.const 1 else b end.
    (if (or (eq op_id Kw.and) (eq op_id Kw.or))
        (block
          (let off:i32 (call compile_expr cg (call nth_child node 1) out_ptr))
          (set! off (+ off (call emit_byte (+ out_ptr off) 4)))
          (set! off (+ off (call emit_byte (+ out_ptr off) 127)))
          (call label_push 0)
          (if (eq op_id Kw.and)
              (block
                (set! off (+ off (call compile_expr cg (call nth_child node 2) (+ out_ptr off))))
                (set! off (+ off (call emit_byte (+ out_ptr off) 5)))
                (set! off (+ off (call emit_i32_const (+ out_ptr off) 0))))
              (block
                (set! off (+ off (call emit_i32_const (+ out_ptr off) 1)))
                (set! off (+ off (call emit_byte (+ out_ptr off) 5)))
                (set! off (+ off (call compile_expr cg (call nth_child node 2) (+ out_ptr off))))))
          (call label_pop)
          (set! res (+ off (call emit_byte (+ out_ptr off) 11))))
        (block))

    (if (eq res -1)
        (block
          (let t:Ty (call node_type cg (call nth_child node 1)))
          (let n1:i32 (call compile_expr cg (call nth_child node 1) out_ptr))
          (let n2:i32 (call compile_expr cg (call nth_child node 2) (+ out_ptr n1)))
          (set! res (+ (+ n1 n2) (call emit_typed_binop (+ out_ptr (+ n1 n2)) op_id t))))
        (block))

    res)

  (fn compile_let [cg:(ptr Cg) node:(ptr compiler.Node) out_ptr:i32] -> i32 (let name_node:(ptr compiler.Node) (call nth_child node 1)) (let val_node:(ptr compiler.Node) (call nth_child node 4)) (let n1:i32 (call compile_expr cg val_node out_ptr)) (let idx:i32 (call find_local cg (call node_a name_node) (call node_b name_node))) (+ n1 (call emit_local_set (+ out_ptr n1) idx)))

  (fn compile_set [cg:(ptr Cg) node:(ptr compiler.Node) out_ptr:i32] -> i32 (let name_node:(ptr compiler.Node) (call nth_child node 1)) (let val_node:(ptr compiler.Node) (call nth_child node 2)) (let n1:i32 (call compile_expr cg val_node out_ptr)) (let idx:i32 (call find_local cg (call node_a name_node) (call node_b name_node))) (+ n1 (call emit_local_set (+ out_ptr n1) idx)))

  (fn compile_call [cg:(ptr Cg) node:(ptr compiler.Node) out_ptr:i32] -> i32
    (let fname_node:(ptr compiler.Node) (call nth_child node 1))
    (let offset:i32 0)
    (let arg:(ptr compiler.Node) (call node_next (call node_next (call first_child node))))
    (while (neq arg (ptr.null compiler.Node)) (let n:i32 (call compile_expr cg arg (+ out_ptr offset))) (set! offset (+ offset n)) (set! arg (call node_next arg)))
    (let fidx:i32 (call find_function cg (call node_a fname_node) (call node_b fname_node)))
    (if (eq fidx -1)
        (block
          (mem.store32 44 (call node_a fname_node))
          (mem.store32 48 (call node_b fname_node))
          (let _e:i32 (call set_compile_error CgErr.undefined_function))
          offset)
        (block
          (let import_cnt:i32 (mem.load32 32))
          (+ offset (call emit_call (+ out_ptr offset) (+ import_cnt fidx))))))

  (fn compile_stmt [cg:(ptr Cg) node:(ptr compiler.Node) out_ptr:i32] -> i32 (let n:i32 (call compile_expr cg node out_ptr)) (if (call is_void_node cg node) n (+ n (call emit_byte (+ out_ptr n) 26))))

  (fn compile_stmt_seq [cg:(ptr Cg) first:(ptr compiler.Node) out_ptr:i32] -> i32 (let offset:i32 0) (let node:(ptr compiler.Node) first) (while (neq node (ptr.null compiler.Node)) (let nxt:(ptr compiler.Node) (call node_next node)) (let n:i32 0) (if (eq nxt (ptr.null compiler.Node)) (set! n (call compile_expr cg node (+ out_ptr offset))) (set! n (call compile_stmt cg node (+ out_ptr offset)))) (set! offset (+ offset n)) (set! node nxt)) offset)

  (fn compile_all_stmts [cg:(ptr Cg) first:(ptr compiler.Node) out_ptr:i32] -> i32 (let offset:i32 0) (let node:(ptr compiler.Node) first) (while (neq node (ptr.null compiler.Node)) (let nxt:(ptr compiler.Node) (call node_next node)) (let n:i32 (call compile_stmt cg node (+ out_ptr offset))) (set! offset (+ offset n)) (set! node nxt)) offset)

  (fn compile_block [cg:(ptr Cg) node:(ptr compiler.Node) out_ptr:i32] -> i32 (call compile_stmt_seq cg (call node_next (call first_child node)) out_ptr))

  (fn compile_if [cg:(ptr Cg) node:(ptr compiler.Node) out_ptr:i32] -> i32
    (let cond_node:(ptr compiler.Node) (call nth_child node 1))
    (let then_node:(ptr compiler.Node) (call nth_child node 2))
    (let else_node:(ptr compiler.Node) (call nth_child node 3))
    (let off:i32 0)
    (set! off (+ off (call compile_expr cg cond_node (+ out_ptr off))))
    (let void_then:bool (call is_void_node cg then_node))
    (let block_ty:i32 64)
    (if void_then (set! block_ty 64) (set! block_ty (call block_type_byte (call node_type cg then_node))))
    (mem.store8 (+ out_ptr off) 4)
    (mem.store8 (+ out_ptr (+ off 1)) block_ty)
    (set! off (+ off 2))
    (call label_push 0)
    (set! off (+ off (call compile_expr cg then_node (+ out_ptr off))))
    (mem.store8 (+ out_ptr off) 5)
    (set! off (+ off 1))
    (set! off (+ off (call compile_expr cg else_node (+ out_ptr off))))
    (call label_pop)
    (mem.store8 (+ out_ptr off) 11)
    (set! off (+ off 1))
    off)

  ;; block { loop { cond; eqz; br_if 1; body; br 0 } }: break = br to the block,
  ;; continue = br to the loop header (wasm.rs Expr::While).
  (fn compile_while [cg:(ptr Cg) node:(ptr compiler.Node) out_ptr:i32] -> i32
    (let off:i32 0)
    (set! off (+ off (call emit_byte (+ out_ptr off) 2)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 64)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 3)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 64)))
    (call label_push 1)
    (call label_push 2)
    (set! off (+ off (call compile_expr cg (call nth_child node 1) (+ out_ptr off))))
    (set! off (+ off (call emit_byte (+ out_ptr off) 69)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 13)))
    (set! off (+ off (call compiler.encode_u32 (+ out_ptr off) 1)))
    (set! off (+ off (call compile_all_stmts cg (call nth_child node 2) (+ out_ptr off))))
    (call label_pop)
    (call label_pop)
    (set! off (+ off (call emit_byte (+ out_ptr off) 12)))
    (set! off (+ off (call compiler.encode_u32 (+ out_ptr off) 0)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 11)))
    (+ off (call emit_byte (+ out_ptr off) 11)))

  ;; var = start; block { loop { var > end -> br_if 1; block { body }; var += step; br 0 } }:
  ;; break = br to the outer block, continue = br to the end of the body block,
  ;; which falls into the step (wasm.rs Expr::Loop).
  (fn compile_loop [cg:(ptr Cg) node:(ptr compiler.Node) out_ptr:i32] -> i32
    (let var_node:(ptr compiler.Node) (call nth_child node 1))
    (let var_idx:i32 (call find_local cg (call node_a var_node) (call node_b var_node)))
    (let end_idx:i32 (call find_hidden cg (call node_a var_node) (call node_b var_node) Ty.loop_end))
    (let step_idx:i32 (call find_hidden cg (call node_a var_node) (call node_b var_node) Ty.loop_step))
    ;; start, end, and step are each evaluated once, in that order
    (let off:i32 (call compile_expr cg (call nth_child node 2) out_ptr))
    (set! off (+ off (call emit_local_set (+ out_ptr off) var_idx)))
    (set! off (+ off (call compile_expr cg (call nth_child node 3) (+ out_ptr off))))
    (set! off (+ off (call emit_local_set (+ out_ptr off) end_idx)))
    (set! off (+ off (call compile_expr cg (call nth_child node 4) (+ out_ptr off))))
    (set! off (+ off (call emit_local_set (+ out_ptr off) step_idx)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 2)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 64)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 3)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 64)))
    (call label_push 1)
    (call label_push 2)
    (set! off (+ off (call emit_local_get (+ out_ptr off) var_idx)))
    (set! off (+ off (call emit_local_get (+ out_ptr off) end_idx)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 74)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 13)))
    (set! off (+ off (call compiler.encode_u32 (+ out_ptr off) 1)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 2)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 64)))
    (call label_push 3)
    (set! off (+ off (call compile_all_stmts cg (call nth_child node 5) (+ out_ptr off))))
    (call label_pop)
    (set! off (+ off (call emit_byte (+ out_ptr off) 11)))
    (call label_pop)
    (call label_pop)
    (set! off (+ off (call emit_local_get (+ out_ptr off) var_idx)))
    (set! off (+ off (call emit_local_get (+ out_ptr off) step_idx)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 106)))
    (set! off (+ off (call emit_local_set (+ out_ptr off) var_idx)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 12)))
    (set! off (+ off (call compiler.encode_u32 (+ out_ptr off) 0)))
    (set! off (+ off (call emit_byte (+ out_ptr off) 11)))
    (+ off (call emit_byte (+ out_ptr off) 11)))

  (fn is_else_clause [cg:(ptr Cg) clause:(ptr compiler.Node)] -> bool
    (eq (call group_head_keyword cg clause) Kw.else))

  ;; (cond (c1 e...) ... (else e...)) as the nested ifs the Rust parser builds:
  ;; (if c1 (block e...) (if c2 (block e...) ... (block else...))).
  (fn compile_cond_from [cg:(ptr Cg) clause:(ptr compiler.Node) out_ptr:i32] -> i32
    (let head:(ptr compiler.Node) (call first_child clause))
    (if (call is_else_clause cg clause)
        (return (call compile_stmt_seq cg (call node_next head) out_ptr))
        (block))
    (let body_first:(ptr compiler.Node) (call node_next head))
    (let off:i32 (call compile_expr cg head out_ptr))
    (let bt:i32 64)
    (if (call is_void_node cg (call last_child clause))
        (block)
        (set! bt (call block_type_byte (call body_type cg body_first))))
    (set! off (+ off (call emit_byte (+ out_ptr off) 4)))
    (set! off (+ off (call emit_byte (+ out_ptr off) bt)))
    (call label_push 0)
    (set! off (+ off (call compile_stmt_seq cg body_first (+ out_ptr off))))
    (set! off (+ off (call emit_byte (+ out_ptr off) 5)))
    (set! off (+ off (call compile_cond_from cg (call node_next clause) (+ out_ptr off))))
    (call label_pop)
    (+ off (call emit_byte (+ out_ptr off) 11)))

  (fn compile_function_body [cg:(ptr Cg) entry:(ptr FnInfo) out_ptr:i32] -> i32 (let fndef_group:(ptr compiler.Node) (get entry FnInfo.node)) (let ret_type:Ty (get entry FnInfo.ret)) (let off:i32 0) (let bchild:(ptr compiler.Node) (call nth_child fndef_group 5)) (while (neq bchild (ptr.null compiler.Node)) (if (call is_contract_head cg bchild) (set! bchild (call node_next bchild)) (block (let is_last:bool (eq (call node_next bchild) (ptr.null compiler.Node))) (let keep_value:bool (and is_last (neq ret_type Ty.void))) (let n:i32 (call compile_expr cg bchild (+ out_ptr off))) (set! off (+ off n)) (if (and (not keep_value) (not (call is_void_node cg bchild))) (set! off (+ off (call emit_byte (+ out_ptr off) 26))) (block)) (set! bchild (call node_next bchild))))) off)

  ;; ===== Master WASM Module Generator =====
  (fn compile_module [src_ptr:i32 src_len:i32] -> i32
    (let _init:i32 (call init_keywords))
    ;; constants and enums are erased to literals and i32 first (consts.aipl)
    (let plain:(ptr buf.Buf) (call buf.make (+ src_len 64)))
    (if (not (call consts.expand (call str.bytes src_ptr src_len) plain (call buf.make 64)))
        (block (call set_compile_error CgErr.unknown_enum_member) (return -1))
        (block))
    (set! src_ptr (get (call buf.bytes plain) str.Bytes.addr))
    (let cg:(ptr Cg) (call new_cg src_ptr))
    (set! src_len (call buf.len plain))
    ;; Buffers are sized from the input: a token is at least one source byte
    ;; (12-byte records), an AST node is at most one per token (16 bytes).
    (let tok_buf:i32 (call cg_alloc (* (+ src_len 1) 12)))
    (let tok_cnt:i32 (call compiler.tokenize src_ptr src_len tok_buf))
    (let ast_buf:i32 (call cg_alloc (* (+ tok_cnt 2) 16)))
    (let root:(ptr compiler.Node) (call compiler.parse_ast tok_buf tok_cnt ast_buf))
    
    (let _p:i32 (call walk_module_prepass cg root))
    ;; threaded modules call workers through the table (wasm.rs worker_sig)
    (let worker_type:i32 0)
    (if (call threaded)
        (block
          (mem.store32 (call ref_state) 1)
          (set! worker_type (call worker_sig_index)))
        (block))
    ;; Literals plus the heap start must fit in the initial 16 pages (wasm.rs STRING_DATA_LIMIT).
    (if (gt (call heap_start) 1048576) (call set_compile_error CgErr.too_many_literals) 0)
    (let _s:i32 (call collect_structs cg root))
    (let import_count:i32 (mem.load32 32))
    (let func_count:i32 (call collect_functions cg root))
    (put cg Cg.nfns func_count)
    
    ;; Output, section scratch, and per-function scratch share one capacity;
    ;; overrunning it is reported as compile error 91 at the end.
    (let cap:i32 (+ (* src_len 4) 65536))
    (let out:i32 (call cg_alloc cap))
    (let off:i32 (call compiler.emit_header out))
    (let scratch:i32 (call cg_alloc cap))


    ;; 1. Type Section (Section ID 1)
    (let sc_off:i32 0)
    (let sig_count:i32 (mem.load32 (+ (call ref_state) 4)))
    (let uses_refs:bool (neq (mem.load32 (call ref_state)) 0))
    (let total_types:i32 (+ import_count (+ func_count sig_count)))
    (if (call threaded) (set! total_types (+ total_types 2)) (block))
    ;; a zero-argument main and no _start: an automatic _start (wasm.rs auto_start)
    (let main_idx:i32 (call find_function cg (- (str.ptr "main") src_ptr) 4))
    (let auto_start:bool (and (gte main_idx 0)
                              (and (eq (get (call func_entry_ptr cg main_idx) FnInfo.nparams) 0)
                                   (lt (call find_function cg (- (str.ptr "_start") src_ptr) 6) 0))))
    (if auto_start (set! total_types (+ total_types 1)) (block))
    (let extra_fns:i32 (if (call threaded) 2 0))
    (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) total_types)))
    
    ;; WASI import types (fixed order)
    (let w:i32 0)
    (while (lt w 13)
      (let w_idx:i32 (call get_wasi_index w))
      (if (neq w_idx -1)
          (block
            (mem.store8 (+ scratch sc_off) 96) (set! sc_off (+ sc_off 1))
            (cond
              ((eq w 0) (mem.store8 (+ scratch sc_off) 4) (set! sc_off (+ sc_off 1))
                  (mem.store8 (+ scratch sc_off) 127) (mem.store8 (+ scratch (+ sc_off 1)) 127) (mem.store8 (+ scratch (+ sc_off 2)) 127) (mem.store8 (+ scratch (+ sc_off 3)) 127) (set! sc_off (+ sc_off 4))
                  (mem.store8 (+ scratch sc_off) 1) (mem.store8 (+ scratch (+ sc_off 1)) 127) (set! sc_off (+ sc_off 2)) 0)
              ((eq w 1) (mem.store8 (+ scratch sc_off) 4) (set! sc_off (+ sc_off 1))
                  (mem.store8 (+ scratch sc_off) 127) (mem.store8 (+ scratch (+ sc_off 1)) 127) (mem.store8 (+ scratch (+ sc_off 2)) 127) (mem.store8 (+ scratch (+ sc_off 3)) 127) (set! sc_off (+ sc_off 4))
                  (mem.store8 (+ scratch sc_off) 1) (mem.store8 (+ scratch (+ sc_off 1)) 127) (set! sc_off (+ sc_off 2)) 0)
              ((eq w 2) (mem.store8 (+ scratch sc_off) 9) (set! sc_off (+ sc_off 1))
                  (mem.store8 (+ scratch sc_off) 127) (mem.store8 (+ scratch (+ sc_off 1)) 127) (mem.store8 (+ scratch (+ sc_off 2)) 127) (mem.store8 (+ scratch (+ sc_off 3)) 127) (mem.store8 (+ scratch (+ sc_off 4)) 127) (set! sc_off (+ sc_off 5))
                  (mem.store8 (+ scratch sc_off) 126) (mem.store8 (+ scratch (+ sc_off 1)) 126) (set! sc_off (+ sc_off 2))
                  (mem.store8 (+ scratch sc_off) 127) (mem.store8 (+ scratch (+ sc_off 1)) 127) (set! sc_off (+ sc_off 2))
                  (mem.store8 (+ scratch sc_off) 1) (mem.store8 (+ scratch (+ sc_off 1)) 127) (set! sc_off (+ sc_off 2)) 0)
              ((eq w 3) (mem.store8 (+ scratch sc_off) 1) (set! sc_off (+ sc_off 1))
                  (mem.store8 (+ scratch sc_off) 127) (set! sc_off (+ sc_off 1))
                  (mem.store8 (+ scratch sc_off) 1) (mem.store8 (+ scratch (+ sc_off 1)) 127) (set! sc_off (+ sc_off 2)) 0)
              ((eq w 4) (mem.store8 (+ scratch sc_off) 1) (set! sc_off (+ sc_off 1))
                  (mem.store8 (+ scratch sc_off) 127) (set! sc_off (+ sc_off 1))
                  (mem.store8 (+ scratch sc_off) 0) (set! sc_off (+ sc_off 1)) 0)
              ((eq w 5) (mem.store8 (+ scratch sc_off) 3) (set! sc_off (+ sc_off 1))
                  (mem.store8 (+ scratch sc_off) 127) (mem.store8 (+ scratch (+ sc_off 1)) 127) (mem.store8 (+ scratch (+ sc_off 2)) 127) (set! sc_off (+ sc_off 3))
                  (mem.store8 (+ scratch sc_off) 1) (mem.store8 (+ scratch (+ sc_off 1)) 127) (set! sc_off (+ sc_off 2)) 0)
              ;; clock_time_get: [i32 i64 i32] -> [i32]
              ((eq w 11) (mem.store8 (+ scratch sc_off) 3) (mem.store8 (+ scratch (+ sc_off 1)) 127)
                  (mem.store8 (+ scratch (+ sc_off 2)) 126) (mem.store8 (+ scratch (+ sc_off 3)) 127)
                  (mem.store8 (+ scratch (+ sc_off 4)) 1) (mem.store8 (+ scratch (+ sc_off 5)) 127) (set! sc_off (+ sc_off 6)) 0)
              ;; random_get: [i32 i32] -> [i32]
              ((eq w 12) (mem.store8 (+ scratch sc_off) 2) (mem.store8 (+ scratch (+ sc_off 1)) 127)
                  (mem.store8 (+ scratch (+ sc_off 2)) 127) (mem.store8 (+ scratch (+ sc_off 3)) 1)
                  (mem.store8 (+ scratch (+ sc_off 4)) 127) (set! sc_off (+ sc_off 5)) 0)
              ;; thread-spawn: [i32] -> [i32]
              ((eq w 10) (mem.store8 (+ scratch sc_off) 1) (mem.store8 (+ scratch (+ sc_off 1)) 127)
                  (mem.store8 (+ scratch (+ sc_off 2)) 1) (mem.store8 (+ scratch (+ sc_off 3)) 127) (set! sc_off (+ sc_off 4)) 0)
              ;; args/environ sizes and get: [i32 i32] -> [i32]
              ((gte w 6) (mem.store8 (+ scratch sc_off) 2) (set! sc_off (+ sc_off 1))
                  (mem.store8 (+ scratch sc_off) 127) (mem.store8 (+ scratch (+ sc_off 1)) 127) (set! sc_off (+ sc_off 2))
                  (mem.store8 (+ scratch sc_off) 1) (mem.store8 (+ scratch (+ sc_off 1)) 127) (set! sc_off (+ sc_off 2)) 0)
              (else 0)))
          0)
      (set! w (+ w 1)))

    ;; User function types
    (let f:i32 0)
    (while (lt f func_count)
      (let entry:(ptr FnInfo) (call func_entry_ptr cg f))
      (let pcount:i32 (get entry FnInfo.nparams))
      (let ret_ty:Ty (get entry FnInfo.ret))
      (mem.store8 (+ scratch sc_off) 96) (set! sc_off (+ sc_off 1))
      (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) pcount)))
      (let p:i32 0)
      (while (lt p pcount)
        (let pty:Ty (arr.get Ty (get entry FnInfo.params) p))
        (mem.store8 (+ scratch sc_off) (call type_id_to_valtype pty)) (set! sc_off (+ sc_off 1))
        (set! p (+ p 1)))
      (if (eq ret_ty Ty.void) ;; void
          (block (mem.store8 (+ scratch sc_off) 0) (set! sc_off (+ sc_off 1)))
          (block
            (mem.store8 (+ scratch sc_off) 1) (set! sc_off (+ sc_off 1))
            (mem.store8 (+ scratch sc_off) (call type_id_to_valtype ret_ty)) (set! sc_off (+ sc_off 1))))
      (set! f (+ f 1)))

    ;; call_ref signature types, after the function types (wasm.rs ref_sigs)
    (loop si 0 (- sig_count 1) 1
      (let sp:i32 (call ref_sig_ptr si))
      (let np:i32 (mem.load8 sp))
      (mem.store8 (+ scratch sc_off) 96) (set! sc_off (+ sc_off 1))
      (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) np)))
      (loop pi 1 np 1
        (mem.store8 (+ scratch sc_off) (mem.load8 (+ sp pi))) (set! sc_off (+ sc_off 1)))
      (let nr:i32 (mem.load8 (+ sp (+ 1 np))))
      (mem.store8 (+ scratch sc_off) nr) (set! sc_off (+ sc_off 1))
      (if (eq nr 1)
          (block (mem.store8 (+ scratch sc_off) (mem.load8 (+ sp (+ 2 np)))) (set! sc_off (+ sc_off 1)))
          (block)))
    ;; threaded: the start function [] -> [] and wasi_thread_start [i32 i32] -> []
    (if (call threaded)
        (block
          (mem.store8 (+ scratch sc_off) 96) (mem.store8 (+ scratch (+ sc_off 1)) 0) (mem.store8 (+ scratch (+ sc_off 2)) 0)
          (mem.store8 (+ scratch (+ sc_off 3)) 96) (mem.store8 (+ scratch (+ sc_off 4)) 2) (mem.store8 (+ scratch (+ sc_off 5)) 127)
          (mem.store8 (+ scratch (+ sc_off 6)) 127) (mem.store8 (+ scratch (+ sc_off 7)) 0)
          (set! sc_off (+ sc_off 8)))
        (block))
    ;; _start: [] -> []
    (if auto_start
        (block
          (mem.store8 (+ scratch sc_off) 96) (mem.store8 (+ scratch (+ sc_off 1)) 0) (mem.store8 (+ scratch (+ sc_off 2)) 0)
          (set! sc_off (+ sc_off 3)))
        (block))

    (mem.store8 (+ out off) 1) (set! off (+ off 1))
    (set! off (+ off (call compiler.encode_u32 (+ out off) sc_off)))
    (let i:i32 0)
    (while (lt i sc_off)
      (mem.store8 (+ out off) (mem.load8 (+ scratch i)))
      (set! off (+ off 1))
      (set! i (+ i 1)))

    ;; 2. Import Section (Section ID 2, only if import_count > 0)
    (if (or (gt import_count 0) (call threaded))
        (block
          (set! sc_off 0)
          (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) (if (call threaded) (+ import_count 1) import_count))))
          (let curr_imp:i32 0)
          (set! w 0)
          (while (lt w 13)
            (let w_idx:i32 (call get_wasi_index w))
            (if (neq w_idx -1)
                (block
                  ;; module name ("wasi" for thread-spawn), then the function's name
                  (set! sc_off (+ sc_off (call emit_name (+ scratch sc_off) (if (eq w 10) "wasi" "wasi_snapshot_preview1"))))
                  (set! sc_off (+ sc_off (call emit_name (+ scratch sc_off) (call wasi_name w))))
                  ;; Entity type 0 (Func) + type index
                  (mem.store8 (+ scratch sc_off) 0) (set! sc_off (+ sc_off 1))
                  (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) curr_imp)))
                  (set! curr_imp (+ curr_imp 1))
                  0)
                0)
            (set! w (+ w 1)))
          ;; threaded: the shared memory, "env" "memory", min 16 max 1024 (flags 3: max + shared)
          (if (call threaded)
              (block
                (set! sc_off (+ sc_off (call emit_name (+ scratch sc_off) "env")))
                (set! sc_off (+ sc_off (call emit_name (+ scratch sc_off) "memory")))
                (mem.store8 (+ scratch sc_off) 2) (mem.store8 (+ scratch (+ sc_off 1)) 3) (set! sc_off (+ sc_off 2))
                (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) 16)))
                (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) 1024))))
              (block))
          
          (mem.store8 (+ out off) 2) (set! off (+ off 1))
          (set! off (+ off (call compiler.encode_u32 (+ out off) sc_off)))
          (set! i 0)
          (while (lt i sc_off)
            (mem.store8 (+ out off) (mem.load8 (+ scratch i)))
            (set! off (+ off 1))
            (set! i (+ i 1)))
          0)
        0)

    ;; 3. Function Section (Section ID 3); a threaded module adds its start
    ;; function and wasi_thread_start, whose types follow the call_ref types
    (set! sc_off 0)
    (let n_fns:i32 (+ func_count (+ extra_fns (if auto_start 1 0))))
    (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) n_fns)))
    (set! f 0)
    (while (lt f func_count)
      (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) (+ import_count f))))
      (set! f (+ f 1)))
    (if (call threaded)
        (block
          (let tbase:i32 (+ import_count (+ func_count sig_count)))
          (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) tbase)))
          (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) (+ tbase 1)))))
        (block))
    (if auto_start
        (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) (+ import_count (+ func_count (+ sig_count extra_fns))))))
        (block))

    (mem.store8 (+ out off) 3) (set! off (+ off 1))
    (set! off (+ off (call compiler.encode_u32 (+ out off) sc_off)))
    (set! i 0)
    (while (lt i sc_off)
      (mem.store8 (+ out off) (mem.load8 (+ scratch i)))
      (set! off (+ off 1))
      (set! i (+ i 1)))

    ;; Table Section (Section ID 4), only with function refs: one funcref
    ;; table holding every function, min = max = function count
    (if uses_refs
        (block
          (set! sc_off 0)
          (mem.store8 (+ scratch sc_off) 1) (set! sc_off (+ sc_off 1))
          (mem.store8 (+ scratch sc_off) 112) (set! sc_off (+ sc_off 1))
          (mem.store8 (+ scratch sc_off) 1) (set! sc_off (+ sc_off 1))
          (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) func_count)))
          (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) func_count)))
          (mem.store8 (+ out off) 4) (set! off (+ off 1))
          (set! off (+ off (call compiler.encode_u32 (+ out off) sc_off)))
          (loop k 0 (- sc_off 1) 1
            (mem.store8 (+ out off) (mem.load8 (+ scratch k)))
            (set! off (+ off 1))))
        (block))

    ;; 4. Memory Section (Section ID 5); a threaded module imports its memory
    ;; and has a Global Section (ID 6) instead: global 0, the runtime scratch
    ;; pointer, mutable i32 = 64
    (if (call threaded)
        (block
          (mem.store8 (+ out off) 6) (mem.store8 (+ out (+ off 1)) 7) (mem.store8 (+ out (+ off 2)) 1)
          (mem.store8 (+ out (+ off 3)) 127) (mem.store8 (+ out (+ off 4)) 1)
          (set! off (+ off 5))
          (set! off (+ off (call emit_i32_const (+ out off) 64)))
          (mem.store8 (+ out off) 11) (set! off (+ off 1)))
        (block
      (set! sc_off 0)
      (mem.store8 (+ scratch sc_off) 1) (set! sc_off (+ sc_off 1)) ;; 1 memory
      (mem.store8 (+ scratch sc_off) 1) (set! sc_off (+ sc_off 1)) ;; flags: has max
      (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) 16))) ;; min 16
      (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) 1024))) ;; max 1024 pages (vm.rs MAX_PAGES)

      (mem.store8 (+ out off) 5) (set! off (+ off 1))
      (set! off (+ off (call compiler.encode_u32 (+ out off) sc_off)))
      (set! i 0)
      (while (lt i sc_off)
        (mem.store8 (+ out off) (mem.load8 (+ scratch i)))
        (set! off (+ off 1))
        (set! i (+ i 1)))))
    ;; 5. Export Section (Section ID 7)
    (set! sc_off 0)
    (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) (+ func_count (+ 1 (+ (if (call threaded) 1 0) (if auto_start 1 0)))))))
    (set! f 0)
    (while (lt f func_count)
      (let entry:(ptr FnInfo) (call func_entry_ptr cg f))
      (let name_pos:i32 (get entry FnInfo.name_pos))
      (let name_len:i32 (get entry FnInfo.name_len))
      (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) name_len)))
      (let n_idx:i32 0)
      (while (lt n_idx name_len)
        (mem.store8 (+ scratch sc_off) (mem.load8 (+ src_ptr (+ name_pos n_idx))))
        (set! sc_off (+ sc_off 1))
        (set! n_idx (+ n_idx 1)))
      (mem.store8 (+ scratch sc_off) 0) (set! sc_off (+ sc_off 1)) ;; ExportKind: Func
      (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) (+ import_count f))))
      (set! f (+ f 1)))

    ;; Export "memory"
    (set! sc_off (+ sc_off (call emit_name (+ scratch sc_off) "memory")))
    (mem.store8 (+ scratch sc_off) 2) (set! sc_off (+ sc_off 1)) ;; ExportKind: Memory
    (mem.store8 (+ scratch sc_off) 0) (set! sc_off (+ sc_off 1)) ;; Index 0
    (if (call threaded)
        (block
          (set! sc_off (+ sc_off (call emit_name (+ scratch sc_off) "wasi_thread_start")))
          (mem.store8 (+ scratch sc_off) 0) (set! sc_off (+ sc_off 1))
          (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) (+ import_count (+ func_count 1))))))
        (block))
    (if auto_start
        (block
          (set! sc_off (+ sc_off (call emit_name (+ scratch sc_off) "_start")))
          (mem.store8 (+ scratch sc_off) 0) (set! sc_off (+ sc_off 1))
          (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) (+ import_count (+ func_count extra_fns))))))
        (block))

    (mem.store8 (+ out off) 7) (set! off (+ off 1))
    (set! off (+ off (call compiler.encode_u32 (+ out off) sc_off)))
    (set! i 0)
    (while (lt i sc_off)
      (mem.store8 (+ out off) (mem.load8 (+ scratch i)))
      (set! off (+ off 1))
      (set! i (+ i 1)))

    ;; Start Section (Section ID 8), threaded only: the one-time init function
    (if (call threaded)
        (block
          (mem.store8 (+ out off) 8) (set! off (+ off 1))
          (let n:i32 (call compiler.encode_u32 (+ scratch 0) (+ import_count func_count)))
          (set! off (+ off (call compiler.encode_u32 (+ out off) n)))
          (set! off (+ off (call compiler.encode_u32 (+ out off) (+ import_count func_count)))))
        (block))
    ;; Element Section (Section ID 9), only with function refs: one active
    ;; segment at table offset 0 listing every function in order
    (if uses_refs
        (block
          (set! sc_off 0)
          (mem.store8 (+ scratch sc_off) 1) (set! sc_off (+ sc_off 1))
          (mem.store8 (+ scratch sc_off) 0) (set! sc_off (+ sc_off 1))
          (set! sc_off (+ sc_off (call emit_i32_const (+ scratch sc_off) 0)))
          (mem.store8 (+ scratch sc_off) 11) (set! sc_off (+ sc_off 1))
          (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) func_count)))
          (loop fi 0 (- func_count 1) 1
            (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) (+ import_count fi)))))
          (mem.store8 (+ out off) 9) (set! off (+ off 1))
          (set! off (+ off (call compiler.encode_u32 (+ out off) sc_off)))
          (loop k 0 (- sc_off 1) 1
            (mem.store8 (+ out off) (mem.load8 (+ scratch k)))
            (set! off (+ off 1))))
        (block))

    ;; Data Count Section (Section ID 12), threaded only (memory.init needs it)
    (let n_segments:i32 (if (gt (call get_str_blob_len) 0) 2 1))
    (if (call threaded)
        (block
          (mem.store8 (+ out off) 12) (mem.store8 (+ out (+ off 1)) 1) (mem.store8 (+ out (+ off 2)) n_segments)
          (set! off (+ off 3)))
        (block))
    ;; 6. Code Section (Section ID 10)
    (set! sc_off 0)
    (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) n_fns)))
    
    (let fcode_scratch:i32 (call cg_alloc cap))
    (set! f 0)
    (while (lt f func_count)
      (let entry:(ptr FnInfo) (call func_entry_ptr cg f))
      (let fndef_group:(ptr compiler.Node) (get entry FnInfo.node))
      (let pcount:i32 (get entry FnInfo.nparams))
      (let total_locals:i32 (call collect_locals_for_function cg entry))
      (let extra_local_cnt:i32 (- total_locals pcount))
      (let fn_uses_io_flag:bool (call fn_uses_io cg fndef_group))
      
      (let fcode_off:i32 0)

      
      ;; Locals header count
      (let num_local_entries:i32 extra_local_cnt)
      (set! num_local_entries (+ num_local_entries 1)) ;; +1 for store guard scratch
      (if fn_uses_io_flag (set! num_local_entries (+ num_local_entries 1)) (block))
      
      (set! fcode_off (+ fcode_off (call compiler.encode_u32 (+ fcode_scratch fcode_off) num_local_entries)))
      
      ;; 1 per let/loop local
      (let l_idx:i32 0)
      (while (lt l_idx extra_local_cnt)
        (let ltype_id:Ty (get (call local_at cg (+ pcount l_idx)) Local.ty))
        (set! fcode_off (+ fcode_off (call compiler.encode_u32 (+ fcode_scratch fcode_off) 1)))
        (mem.store8 (+ fcode_scratch fcode_off) (call type_id_to_valtype ltype_id))
        (set! fcode_off (+ fcode_off 1))
        (set! l_idx (+ l_idx 1)))
      
      ;; Store guard scratch (1, i32)
      (set! fcode_off (+ fcode_off (call compiler.encode_u32 (+ fcode_scratch fcode_off) 1)))
      (mem.store8 (+ fcode_scratch fcode_off) 127) (set! fcode_off (+ fcode_off 1))
      
      ;; I/O scratch locals (2, i32) if needed
      (if fn_uses_io_flag
          (block
            (set! fcode_off (+ fcode_off (call compiler.encode_u32 (+ fcode_scratch fcode_off) 2)))
            (mem.store8 (+ fcode_scratch fcode_off) 127) (set! fcode_off (+ fcode_off 1)) 0)
          0)
      
      ;; Body code
      (put cg Cg.nlocals total_locals)
      (let body_bytes:i32 (call compile_function_body cg entry (+ fcode_scratch fcode_off)))
      (set! fcode_off (+ fcode_off body_bytes))
      (mem.store8 (+ fcode_scratch fcode_off) 11) (set! fcode_off (+ fcode_off 1)) ;; end
      
      ;; Encode function size prefix and append function code
      (if (gt fcode_off cap) (call set_compile_error CgErr.output_full) 0)
      (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) fcode_off)))
      (set! i 0)
      (while (lt i fcode_off)
        (mem.store8 (+ scratch sc_off) (mem.load8 (+ fcode_scratch i)))
        (set! sc_off (+ sc_off 1))
        (set! i (+ i 1)))
      (set! f (+ f 1)))

    (if (call threaded)
        (block
          (let b1:i32 (call threaded_init_body fcode_scratch (call get_str_blob_len)))
          (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) b1)))
          (loop k 0 (- b1 1) 1 (mem.store8 (+ scratch (+ sc_off k)) (mem.load8 (+ fcode_scratch k))))
          (set! sc_off (+ sc_off b1))
          (let b2:i32 (call thread_start_body fcode_scratch (+ import_count (+ func_count worker_type))))
          (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) b2)))
          (loop k 0 (- b2 1) 1 (mem.store8 (+ scratch (+ sc_off k)) (mem.load8 (+ fcode_scratch k))))
          (set! sc_off (+ sc_off b2)))
        (block))
    (if auto_start
        (block
          ;; no locals; call main; drop a non-void result; end
          (let b:i32 (call emit_byte fcode_scratch 0))
          (set! b (+ b (call emit_call (+ fcode_scratch b) (+ import_count main_idx))))
          (if (neq (get (call func_entry_ptr cg main_idx) FnInfo.ret) Ty.void)
              (set! b (+ b (call emit_byte (+ fcode_scratch b) 26)))
              (block))
          (set! b (+ b (call emit_byte (+ fcode_scratch b) 11)))
          (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) b)))
          (loop k 0 (- b 1) 1 (mem.store8 (+ scratch (+ sc_off k)) (mem.load8 (+ fcode_scratch k))))
          (set! sc_off (+ sc_off b)))
        (block))
    (mem.store8 (+ out off) 10) (set! off (+ off 1))
    (set! off (+ off (call compiler.encode_u32 (+ out off) sc_off)))
    (set! i 0)
    (while (lt i sc_off)
      (mem.store8 (+ out off) (mem.load8 (+ scratch i)))
      (set! off (+ off 1))
      (set! i (+ i 1)))

    ;; 7. Data Section (Section ID 11)
    (set! sc_off 0)
    (let string_blob_len:i32 (call get_str_blob_len))
    (let has_strings:bool (gt string_blob_len 0))
    (let seg_cnt:i32 1)
    (if has_strings (set! seg_cnt 2) (set! seg_cnt 1))
    (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) seg_cnt)))
    
    ;; Segment 0: heap cursor = heap_start at address 0 (passive when
    ;; threaded: the start function copies it once)
    (if (call threaded)
        (block (mem.store8 (+ scratch sc_off) 1) (set! sc_off (+ sc_off 1)))
        (block
          (mem.store8 (+ scratch sc_off) 0) (set! sc_off (+ sc_off 1)) ;; active segment 0
          (mem.store8 (+ scratch sc_off) 65) (set! sc_off (+ sc_off 1)) ;; i32.const
          (set! sc_off (+ sc_off (call encode_s32 (+ scratch sc_off) 0)))
          (mem.store8 (+ scratch sc_off) 11) (set! sc_off (+ sc_off 1)))) ;; end
    (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) 4))) ;; 4 bytes
    (mem.store32 (+ scratch sc_off) (call heap_start))
    (set! sc_off (+ sc_off 4))

    ;; Segment 1: string blob at address 1024
    (if has_strings
        (block
          (if (call threaded)
              (block (mem.store8 (+ scratch sc_off) 1) (set! sc_off (+ sc_off 1)))
              (block
                (mem.store8 (+ scratch sc_off) 0) (set! sc_off (+ sc_off 1))
                (mem.store8 (+ scratch sc_off) 65) (set! sc_off (+ sc_off 1)) ;; i32.const
                (set! sc_off (+ sc_off (call encode_s32 (+ scratch sc_off) 1024)))
                (mem.store8 (+ scratch sc_off) 11) (set! sc_off (+ sc_off 1)))) ;; end
          (set! sc_off (+ sc_off (call compiler.encode_u32 (+ scratch sc_off) string_blob_len)))
          (set! i 0)
          (while (lt i string_blob_len)
            (mem.store8 (+ scratch sc_off) (mem.load8 (+ (call str_blob_buf) i)))
            (set! sc_off (+ sc_off 1))
            (set! i (+ i 1)))
          0)
        0)

    (mem.store8 (+ out off) 11) (set! off (+ off 1))
    (set! off (+ off (call compiler.encode_u32 (+ out off) sc_off)))
    (set! i 0)
    (while (lt i sc_off)
      (mem.store8 (+ out off) (mem.load8 (+ scratch i)))
      (set! off (+ off 1))
      (set! i (+ i 1)))

    (if (gt off cap) (call set_compile_error CgErr.output_full) 0)
    (mem.store32 60 out)
    (if (call has_compile_error) -1 off))

;; ===== Threaded modules: generated functions (wasm.rs threaded_init_function, thread_start_function) =====

  ;; The start function body (no locals): the first instance copies the heap
  ;; cursor and the string literals into the shared memory, guarded by the
  ;; flag at 88. Returns the byte count.
  (fn threaded_init_body [p:i32 blob_len:i32] -> i32
    (let off:i32 (call emit_byte p 0))
    (set! off (+ off (call emit_i32_const (+ p off) 88)))
    (set! off (+ off (call emit_i32_const (+ p off) 0)))
    (set! off (+ off (call emit_i32_const (+ p off) 1)))
    (set! off (+ off (call emit_atomic (+ p off) 72)))
    (set! off (+ off (call emit_byte (+ p off) 69)))
    (set! off (+ off (call emit_byte (+ p off) 4)))
    (set! off (+ off (call emit_byte (+ p off) 64)))
    (set! off (+ off (call emit_i32_const (+ p off) 0)))
    (set! off (+ off (call emit_i32_const (+ p off) 0)))
    (set! off (+ off (call emit_i32_const (+ p off) 4)))
    (set! off (+ off (call emit_memory_init (+ p off) 0)))
    (if (gt blob_len 0)
        (block
          (set! off (+ off (call emit_i32_const (+ p off) 1024)))
          (set! off (+ off (call emit_i32_const (+ p off) 0)))
          (set! off (+ off (call emit_i32_const (+ p off) blob_len)))
          (set! off (+ off (call emit_memory_init (+ p off) 1))))
        (block))
    (set! off (+ off (call emit_byte (+ p off) 11)))
    (+ off (call emit_byte (+ p off) 11)))

  ;; memory.init data_index, memory 0
  (fn emit_memory_init [p:i32 data_index:i32] -> i32
    (mem.store8 p 252)
    (mem.store8 (+ p 1) 8)
    (let n:i32 (call compiler.encode_u32 (+ p 2) data_index))
    (mem.store8 (+ p (+ 2 n)) 0)
    (+ 3 n))

  ;; wasi_thread_start(tid, rec) body (no locals): allocate this thread's
  ;; 24-byte runtime scratch block, run rec.fn(rec.arg) through the table,
  ;; store the result, set done, and wake joiners.
  (fn thread_start_body [p:i32 worker_type:i32] -> i32
    (let off:i32 (call emit_byte p 0))
    (set! off (+ off (call emit_i32_const (+ p off) 0)))
    (set! off (+ off (call emit_i32_const (+ p off) 24)))
    (set! off (+ off (call emit_rmw_add (+ p off))))
    (set! off (+ off (call emit_byte (+ p off) 36))) ;; global.set 0
    (set! off (+ off (call emit_byte (+ p off) 0)))
    (set! off (+ off (call emit_grow_to_cursor (+ p off))))
    (set! off (+ off (call emit_local_get (+ p off) 1)))
    (set! off (+ off (call emit_local_get (+ p off) 1)))
    (set! off (+ off (call emit_memop_offset (+ p off) 40 2 12)))
    (set! off (+ off (call emit_local_get (+ p off) 1)))
    (set! off (+ off (call emit_memop_offset (+ p off) 40 2 8)))
    (set! off (+ off (call emit_byte (+ p off) 17))) ;; call_indirect
    (set! off (+ off (call compiler.encode_u32 (+ p off) worker_type)))
    (set! off (+ off (call emit_byte (+ p off) 0)))
    (set! off (+ off (call emit_memop_offset (+ p off) 54 2 4)))
    (set! off (+ off (call emit_local_get (+ p off) 1)))
    (set! off (+ off (call emit_i32_const (+ p off) 1)))
    (set! off (+ off (call emit_atomic (+ p off) 23))) ;; i32.atomic.store
    (set! off (+ off (call emit_local_get (+ p off) 1)))
    (set! off (+ off (call emit_i32_const (+ p off) -1)))
    (set! off (+ off (call emit_atomic (+ p off) 0))) ;; memory.atomic.notify
    (set! off (+ off (call emit_byte (+ p off) 26)))
    (+ off (call emit_byte (+ p off) 11)))

    ;; ===== Harnesses =====
  (fn test_signatures_and_locals [] -> i32
    (let _kw_init:i32 (call init_keywords))
    (let text:str "(module test_mod (fn add [a:i32 b:i32] -> i32 (+ a b)) (fn compute [x:i32] -> i32 (let y:i32 (call add x 5)) (let z:i32 0) (loop i 0 9 1 (set! z (+ z i))) (+ y z)))")
    (let src:i32 (str.ptr text))
    (let tok:i32 (mem.alloc (* 12 (+ (str.len text) 1))))
    (let n:i32 (call compiler.tokenize src (str.len text) tok))
    (let ast:i32 (mem.alloc (* 16 (+ n 2))))
    (let root:(ptr compiler.Node) (call compiler.parse_ast tok n ast))
    (let cg:(ptr Cg) (call new_cg src))
    (let func_count:i32 (call collect_functions cg root))
    (put cg Cg.nfns func_count)
    (let e0:(ptr FnInfo) (call func_entry_ptr cg 0))
    (let e0_pcount:i32 (get e0 FnInfo.nparams))
    (let e0_ret:Ty (get e0 FnInfo.ret))
    (let e1:(ptr FnInfo) (call func_entry_ptr cg 1))
    (let local_count:i32 (call collect_locals_for_function cg e1))
    ;; compute's locals: x, y, z, i, and the loop's hidden end and step
    (if (and (eq func_count 2) (and (eq e0_pcount 2) (and (eq e0_ret Ty.i32) (eq local_count 6))))
        1
        0))

  ;; Compiles `text`: the module length if it compiled without error and
  ;; starts with the wasm magic and version, else -1. Byte-for-byte
  ;; agreement with the Rust backend is checked by tests/test_selfhost.rs.
  (fn compiles [text:str] -> i32
    (let len:i32 (call compile_module (str.ptr text) (str.len text)))
    (if (or (lte len 0) (call has_compile_error)) (return -1) (block))
    (let out:i32 (mem.load32 60))
    (if (and (eq (mem.load32 out) 1836278016) (eq (mem.load32 (+ out 4)) 1)) len -1))

  (fn test_compile_add [] -> i32
    (call compiles "(module add (fn add [a:i32 b:i32] -> i32 (+ a b)))"))

  (fn test_compile_compute [] -> i32
    (call compiles "(module compute (fn add [a:i32 b:i32] -> i32 (+ a b)) (fn compute [x:i32] -> i32 (let y:i32 (call add x 5)) (let z:i32 0) (loop i 0 9 1 (set! z (+ z i))) (+ y z)))"))

  (fn test_compile_store [] -> i32
    (call compiles "(module store (fn add [a:i32 b:i32] -> i32 (mem.store32 a b) (mem.load32 a)))"))

  ;; Group runner for `aipl test` / test_suite.aipl
  (fn run_codegen_tests [] -> i32
    (let passed:i32 0)
    (if (eq (call test_signatures_and_locals) 1) (set! passed (+ passed 1)) (block))
    (if (gt (call test_compile_add) 0) (set! passed (+ passed 1)) (block))
    (if (gt (call test_compile_compute) 0) (set! passed (+ passed 1)) (block))
    (if (gt (call test_compile_store) 0) (set! passed (+ passed 1)) (block))
    passed)
)
