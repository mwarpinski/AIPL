;; AIPL Self-Hosted Code Generator: generic S-expression tree (from
;; compiler.tokenize + compiler.parse_ast) -> real WebAssembly bytes.
;;
;; Scope is deliberately bounded to match exactly what src/compiler/wasm.rs
;; genuinely implements today - not the full language spec. Anything outside
;; that set is a loud compile error here too, never a silent wrong answer:
;;   - types: i32, i64, f32, f64, bool, void (param/return types)
;;   - operators: + - * / ^ shl shr bitand bitor, mem.load8/32/64,
;;     mem.store8/32/64, eq neq lt lte gt gte and or not
;;   - forms: let, set!, if, loop, while, call, block
;; NOT supported (loud error, matching wasm.rs's real gaps): strings, mod,
;; float memory ops, atomics, vectors/arrays, DOM/web/sys/fs/thread ops,
;; (ptr T)/(fn ...)/(arr T N)/(vec T N) types.
;;
;; This is a from-scratch reimplementation of wasm.rs's codegen operating on
;; the generic tree instead of a typed Rust enum, so it re-derives (and must
;; stay consistent with) several non-obvious things the Rust side already
;; learned the hard way this session: an `if`'s wasm block type must agree
;; with what BOTH branches actually leave on the stack (not just the then
;; branch), intermediate statement-position values must be `drop`ped, and a
;; `loop`'s induction variable needs a real local slot.

(module codegen
  (import compiler)

  ;; ===== Generic byte-span comparison =====
  (fn sym_eq [src_ptr:i32 pos:i32 len:i32 lit_ptr:i32 lit_len:i32] -> bool
    (if (neq len lit_len)
        false
        (block
          (let i:i32 0)
          (let eq_so_far:bool true)
          (while (lt i len)
            (if (neq (mem.load8 (+ src_ptr (+ pos i))) (mem.load8 (+ lit_ptr i)))
                (set! eq_so_far false)
                (set! eq_so_far eq_so_far))
            (set! i (+ i 1)))
          eq_so_far)))

  ;; ===== Node accessors (see compiler.aipl for the tree layout) =====
  (fn node_kind [node:i32] -> i32 (mem.load32 (+ node 0)))
  (fn node_a [node:i32] -> i32 (mem.load32 (+ node 4)))
  (fn node_b [node:i32] -> i32 (mem.load32 (+ node 8)))
  (fn node_next [node:i32] -> i32 (mem.load32 (+ node 12)))
  (fn nth_child [group:i32 n:i32] -> i32
    (req (gte n 0))
    (let cur:i32 (call node_a group))
    (let i:i32 0)
    (while (lt i n)
      (set! cur (call node_next cur))
      (set! i (+ i 1)))
    cur)
  ;; ===== Runtime memory cells (see AIPL_SPEC.md, Memory layout) =====
  ;; codegen owns cells 16..31 of the runtime block:
  ;;   mem[16] = keyword table pointer      (256 bytes, heap-allocated once)
  ;;   mem[20] = function table pointer     (64 entries x 56 bytes)
  ;;   mem[24] = default locals table ptr   (256 entries x 12 bytes)
  ;;   mem[28] = running locals count for the function being compiled
  ;; mem[4] is the shared compile-error flag. No table lives at a literal
  ;; address anymore; every buffer comes from (mem.alloc N).
  (fn kw [] -> i32 (mem.load32 16))
  (fn fn_table [] -> i32 (mem.load32 20))
  (fn locals_table [] -> i32 (mem.load32 24))

  ;; Idempotent: allocates the tables on first call, and always clears the
  ;; compile-error flag and the locals count.
  (fn codegen_init [] -> i32
    (if (eq (mem.load32 16) 0)
        (block
          (mem.store32 16 (mem.alloc 256))
          (mem.store32 20 (mem.alloc 3584))
          (mem.store32 24 (mem.alloc 3072))
          0)
        0)
    (mem.store32 4 0)
    (mem.store32 28 0)
    0)

  ;; ===== Keyword table (populated via init_keywords, which also runs codegen_init) =====
  (fn init_keywords [] -> i32
    (let _init:i32 (call codegen_init))
    (mem.store8 (+ (call kw) 0) 43) ;; '+'[0]
    (mem.store8 (+ (call kw) 1) 45) ;; '-'[0]
    (mem.store8 (+ (call kw) 2) 42) ;; '*'[0]
    (mem.store8 (+ (call kw) 3) 47) ;; '/'[0]
    (mem.store8 (+ (call kw) 4) 94) ;; '^'[0]
    (mem.store8 (+ (call kw) 5) 115) ;; 'shl'[0]
    (mem.store8 (+ (call kw) 6) 104) ;; 'shl'[1]
    (mem.store8 (+ (call kw) 7) 108) ;; 'shl'[2]
    (mem.store8 (+ (call kw) 8) 115) ;; 'shr'[0]
    (mem.store8 (+ (call kw) 9) 104) ;; 'shr'[1]
    (mem.store8 (+ (call kw) 10) 114) ;; 'shr'[2]
    (mem.store8 (+ (call kw) 11) 98) ;; 'bitand'[0]
    (mem.store8 (+ (call kw) 12) 105) ;; 'bitand'[1]
    (mem.store8 (+ (call kw) 13) 116) ;; 'bitand'[2]
    (mem.store8 (+ (call kw) 14) 97) ;; 'bitand'[3]
    (mem.store8 (+ (call kw) 15) 110) ;; 'bitand'[4]
    (mem.store8 (+ (call kw) 16) 100) ;; 'bitand'[5]
    (mem.store8 (+ (call kw) 17) 98) ;; 'bitor'[0]
    (mem.store8 (+ (call kw) 18) 105) ;; 'bitor'[1]
    (mem.store8 (+ (call kw) 19) 116) ;; 'bitor'[2]
    (mem.store8 (+ (call kw) 20) 111) ;; 'bitor'[3]
    (mem.store8 (+ (call kw) 21) 114) ;; 'bitor'[4]
    (mem.store8 (+ (call kw) 22) 109) ;; 'mem.load8'[0]
    (mem.store8 (+ (call kw) 23) 101) ;; 'mem.load8'[1]
    (mem.store8 (+ (call kw) 24) 109) ;; 'mem.load8'[2]
    (mem.store8 (+ (call kw) 25) 46) ;; 'mem.load8'[3]
    (mem.store8 (+ (call kw) 26) 108) ;; 'mem.load8'[4]
    (mem.store8 (+ (call kw) 27) 111) ;; 'mem.load8'[5]
    (mem.store8 (+ (call kw) 28) 97) ;; 'mem.load8'[6]
    (mem.store8 (+ (call kw) 29) 100) ;; 'mem.load8'[7]
    (mem.store8 (+ (call kw) 30) 56) ;; 'mem.load8'[8]
    (mem.store8 (+ (call kw) 31) 109) ;; 'mem.load32'[0]
    (mem.store8 (+ (call kw) 32) 101) ;; 'mem.load32'[1]
    (mem.store8 (+ (call kw) 33) 109) ;; 'mem.load32'[2]
    (mem.store8 (+ (call kw) 34) 46) ;; 'mem.load32'[3]
    (mem.store8 (+ (call kw) 35) 108) ;; 'mem.load32'[4]
    (mem.store8 (+ (call kw) 36) 111) ;; 'mem.load32'[5]
    (mem.store8 (+ (call kw) 37) 97) ;; 'mem.load32'[6]
    (mem.store8 (+ (call kw) 38) 100) ;; 'mem.load32'[7]
    (mem.store8 (+ (call kw) 39) 51) ;; 'mem.load32'[8]
    (mem.store8 (+ (call kw) 40) 50) ;; 'mem.load32'[9]
    (mem.store8 (+ (call kw) 41) 109) ;; 'mem.load64'[0]
    (mem.store8 (+ (call kw) 42) 101) ;; 'mem.load64'[1]
    (mem.store8 (+ (call kw) 43) 109) ;; 'mem.load64'[2]
    (mem.store8 (+ (call kw) 44) 46) ;; 'mem.load64'[3]
    (mem.store8 (+ (call kw) 45) 108) ;; 'mem.load64'[4]
    (mem.store8 (+ (call kw) 46) 111) ;; 'mem.load64'[5]
    (mem.store8 (+ (call kw) 47) 97) ;; 'mem.load64'[6]
    (mem.store8 (+ (call kw) 48) 100) ;; 'mem.load64'[7]
    (mem.store8 (+ (call kw) 49) 54) ;; 'mem.load64'[8]
    (mem.store8 (+ (call kw) 50) 52) ;; 'mem.load64'[9]
    (mem.store8 (+ (call kw) 51) 109) ;; 'mem.store8'[0]
    (mem.store8 (+ (call kw) 52) 101) ;; 'mem.store8'[1]
    (mem.store8 (+ (call kw) 53) 109) ;; 'mem.store8'[2]
    (mem.store8 (+ (call kw) 54) 46) ;; 'mem.store8'[3]
    (mem.store8 (+ (call kw) 55) 115) ;; 'mem.store8'[4]
    (mem.store8 (+ (call kw) 56) 116) ;; 'mem.store8'[5]
    (mem.store8 (+ (call kw) 57) 111) ;; 'mem.store8'[6]
    (mem.store8 (+ (call kw) 58) 114) ;; 'mem.store8'[7]
    (mem.store8 (+ (call kw) 59) 101) ;; 'mem.store8'[8]
    (mem.store8 (+ (call kw) 60) 56) ;; 'mem.store8'[9]
    (mem.store8 (+ (call kw) 61) 109) ;; 'mem.store32'[0]
    (mem.store8 (+ (call kw) 62) 101) ;; 'mem.store32'[1]
    (mem.store8 (+ (call kw) 63) 109) ;; 'mem.store32'[2]
    (mem.store8 (+ (call kw) 64) 46) ;; 'mem.store32'[3]
    (mem.store8 (+ (call kw) 65) 115) ;; 'mem.store32'[4]
    (mem.store8 (+ (call kw) 66) 116) ;; 'mem.store32'[5]
    (mem.store8 (+ (call kw) 67) 111) ;; 'mem.store32'[6]
    (mem.store8 (+ (call kw) 68) 114) ;; 'mem.store32'[7]
    (mem.store8 (+ (call kw) 69) 101) ;; 'mem.store32'[8]
    (mem.store8 (+ (call kw) 70) 51) ;; 'mem.store32'[9]
    (mem.store8 (+ (call kw) 71) 50) ;; 'mem.store32'[10]
    (mem.store8 (+ (call kw) 72) 109) ;; 'mem.store64'[0]
    (mem.store8 (+ (call kw) 73) 101) ;; 'mem.store64'[1]
    (mem.store8 (+ (call kw) 74) 109) ;; 'mem.store64'[2]
    (mem.store8 (+ (call kw) 75) 46) ;; 'mem.store64'[3]
    (mem.store8 (+ (call kw) 76) 115) ;; 'mem.store64'[4]
    (mem.store8 (+ (call kw) 77) 116) ;; 'mem.store64'[5]
    (mem.store8 (+ (call kw) 78) 111) ;; 'mem.store64'[6]
    (mem.store8 (+ (call kw) 79) 114) ;; 'mem.store64'[7]
    (mem.store8 (+ (call kw) 80) 101) ;; 'mem.store64'[8]
    (mem.store8 (+ (call kw) 81) 54) ;; 'mem.store64'[9]
    (mem.store8 (+ (call kw) 82) 52) ;; 'mem.store64'[10]
    (mem.store8 (+ (call kw) 83) 101) ;; 'eq'[0]
    (mem.store8 (+ (call kw) 84) 113) ;; 'eq'[1]
    (mem.store8 (+ (call kw) 85) 110) ;; 'neq'[0]
    (mem.store8 (+ (call kw) 86) 101) ;; 'neq'[1]
    (mem.store8 (+ (call kw) 87) 113) ;; 'neq'[2]
    (mem.store8 (+ (call kw) 88) 108) ;; 'lt'[0]
    (mem.store8 (+ (call kw) 89) 116) ;; 'lt'[1]
    (mem.store8 (+ (call kw) 90) 108) ;; 'lte'[0]
    (mem.store8 (+ (call kw) 91) 116) ;; 'lte'[1]
    (mem.store8 (+ (call kw) 92) 101) ;; 'lte'[2]
    (mem.store8 (+ (call kw) 93) 103) ;; 'gt'[0]
    (mem.store8 (+ (call kw) 94) 116) ;; 'gt'[1]
    (mem.store8 (+ (call kw) 95) 103) ;; 'gte'[0]
    (mem.store8 (+ (call kw) 96) 116) ;; 'gte'[1]
    (mem.store8 (+ (call kw) 97) 101) ;; 'gte'[2]
    (mem.store8 (+ (call kw) 98) 97) ;; 'and'[0]
    (mem.store8 (+ (call kw) 99) 110) ;; 'and'[1]
    (mem.store8 (+ (call kw) 100) 100) ;; 'and'[2]
    (mem.store8 (+ (call kw) 101) 111) ;; 'or'[0]
    (mem.store8 (+ (call kw) 102) 114) ;; 'or'[1]
    (mem.store8 (+ (call kw) 103) 110) ;; 'not'[0]
    (mem.store8 (+ (call kw) 104) 111) ;; 'not'[1]
    (mem.store8 (+ (call kw) 105) 116) ;; 'not'[2]
    (mem.store8 (+ (call kw) 106) 108) ;; 'let'[0]
    (mem.store8 (+ (call kw) 107) 101) ;; 'let'[1]
    (mem.store8 (+ (call kw) 108) 116) ;; 'let'[2]
    (mem.store8 (+ (call kw) 109) 115) ;; 'set!'[0]
    (mem.store8 (+ (call kw) 110) 101) ;; 'set!'[1]
    (mem.store8 (+ (call kw) 111) 116) ;; 'set!'[2]
    (mem.store8 (+ (call kw) 112) 33) ;; 'set!'[3]
    (mem.store8 (+ (call kw) 113) 105) ;; 'if'[0]
    (mem.store8 (+ (call kw) 114) 102) ;; 'if'[1]
    (mem.store8 (+ (call kw) 115) 108) ;; 'loop'[0]
    (mem.store8 (+ (call kw) 116) 111) ;; 'loop'[1]
    (mem.store8 (+ (call kw) 117) 111) ;; 'loop'[2]
    (mem.store8 (+ (call kw) 118) 112) ;; 'loop'[3]
    (mem.store8 (+ (call kw) 119) 119) ;; 'while'[0]
    (mem.store8 (+ (call kw) 120) 104) ;; 'while'[1]
    (mem.store8 (+ (call kw) 121) 105) ;; 'while'[2]
    (mem.store8 (+ (call kw) 122) 108) ;; 'while'[3]
    (mem.store8 (+ (call kw) 123) 101) ;; 'while'[4]
    (mem.store8 (+ (call kw) 124) 99) ;; 'call'[0]
    (mem.store8 (+ (call kw) 125) 97) ;; 'call'[1]
    (mem.store8 (+ (call kw) 126) 108) ;; 'call'[2]
    (mem.store8 (+ (call kw) 127) 108) ;; 'call'[3]
    (mem.store8 (+ (call kw) 128) 98) ;; 'block'[0]
    (mem.store8 (+ (call kw) 129) 108) ;; 'block'[1]
    (mem.store8 (+ (call kw) 130) 111) ;; 'block'[2]
    (mem.store8 (+ (call kw) 131) 99) ;; 'block'[3]
    (mem.store8 (+ (call kw) 132) 107) ;; 'block'[4]
    (mem.store8 (+ (call kw) 133) 114) ;; 'req'[0]
    (mem.store8 (+ (call kw) 134) 101) ;; 'req'[1]
    (mem.store8 (+ (call kw) 135) 113) ;; 'req'[2]
    (mem.store8 (+ (call kw) 136) 101) ;; 'ens'[0]
    (mem.store8 (+ (call kw) 137) 110) ;; 'ens'[1]
    (mem.store8 (+ (call kw) 138) 115) ;; 'ens'[2]
    (mem.store8 (+ (call kw) 139) 105) ;; 'inv'[0]
    (mem.store8 (+ (call kw) 140) 110) ;; 'inv'[1]
    (mem.store8 (+ (call kw) 141) 118) ;; 'inv'[2]
    (mem.store8 (+ (call kw) 142) 109) ;; 'module'[0]
    (mem.store8 (+ (call kw) 143) 111) ;; 'module'[1]
    (mem.store8 (+ (call kw) 144) 100) ;; 'module'[2]
    (mem.store8 (+ (call kw) 145) 117) ;; 'module'[3]
    (mem.store8 (+ (call kw) 146) 108) ;; 'module'[4]
    (mem.store8 (+ (call kw) 147) 101) ;; 'module'[5]
    (mem.store8 (+ (call kw) 148) 102) ;; 'fn'[0]
    (mem.store8 (+ (call kw) 149) 110) ;; 'fn'[1]
    (mem.store8 (+ (call kw) 150) 105) ;; 'i32'[0]
    (mem.store8 (+ (call kw) 151) 51) ;; 'i32'[1]
    (mem.store8 (+ (call kw) 152) 50) ;; 'i32'[2]
    (mem.store8 (+ (call kw) 153) 105) ;; 'i64'[0]
    (mem.store8 (+ (call kw) 154) 54) ;; 'i64'[1]
    (mem.store8 (+ (call kw) 155) 52) ;; 'i64'[2]
    (mem.store8 (+ (call kw) 156) 102) ;; 'f32'[0]
    (mem.store8 (+ (call kw) 157) 51) ;; 'f32'[1]
    (mem.store8 (+ (call kw) 158) 50) ;; 'f32'[2]
    (mem.store8 (+ (call kw) 159) 102) ;; 'f64'[0]
    (mem.store8 (+ (call kw) 160) 54) ;; 'f64'[1]
    (mem.store8 (+ (call kw) 161) 52) ;; 'f64'[2]
    (mem.store8 (+ (call kw) 162) 98) ;; 'bool'[0]
    (mem.store8 (+ (call kw) 163) 111) ;; 'bool'[1]
    (mem.store8 (+ (call kw) 164) 111) ;; 'bool'[2]
    (mem.store8 (+ (call kw) 165) 108) ;; 'bool'[3]
    (mem.store8 (+ (call kw) 166) 118) ;; 'void'[0]
    (mem.store8 (+ (call kw) 167) 111) ;; 'void'[1]
    (mem.store8 (+ (call kw) 168) 105) ;; 'void'[2]
    (mem.store8 (+ (call kw) 169) 100) ;; 'void'[3]
    0)

  ;; Returns a unified keyword id (operators 0-23, structural forms
  ;; 100-111, types 200-205), or -1 if the span is a variable/function name.
  (fn classify_keyword [src_ptr:i32 pos:i32 len:i32] -> i32
    (if (call sym_eq src_ptr pos len (+ (call kw) 0) 1) 0 (if (call sym_eq src_ptr pos len (+ (call kw) 1) 1) 1 (if (call sym_eq src_ptr pos len (+ (call kw) 2) 1) 2 (if (call sym_eq src_ptr pos len (+ (call kw) 3) 1) 3 (if (call sym_eq src_ptr pos len (+ (call kw) 4) 1) 4 (if (call sym_eq src_ptr pos len (+ (call kw) 5) 3) 5 (if (call sym_eq src_ptr pos len (+ (call kw) 8) 3) 6 (if (call sym_eq src_ptr pos len (+ (call kw) 11) 6) 7 (if (call sym_eq src_ptr pos len (+ (call kw) 17) 5) 8 (if (call sym_eq src_ptr pos len (+ (call kw) 22) 9) 9 (if (call sym_eq src_ptr pos len (+ (call kw) 31) 10) 10 (if (call sym_eq src_ptr pos len (+ (call kw) 41) 10) 11 (if (call sym_eq src_ptr pos len (+ (call kw) 51) 10) 12 (if (call sym_eq src_ptr pos len (+ (call kw) 61) 11) 13 (if (call sym_eq src_ptr pos len (+ (call kw) 72) 11) 14 (if (call sym_eq src_ptr pos len (+ (call kw) 83) 2) 15 (if (call sym_eq src_ptr pos len (+ (call kw) 85) 3) 16 (if (call sym_eq src_ptr pos len (+ (call kw) 88) 2) 17 (if (call sym_eq src_ptr pos len (+ (call kw) 90) 3) 18 (if (call sym_eq src_ptr pos len (+ (call kw) 93) 2) 19 (if (call sym_eq src_ptr pos len (+ (call kw) 95) 3) 20 (if (call sym_eq src_ptr pos len (+ (call kw) 98) 3) 21 (if (call sym_eq src_ptr pos len (+ (call kw) 101) 2) 22 (if (call sym_eq src_ptr pos len (+ (call kw) 103) 3) 23 (if (call sym_eq src_ptr pos len (+ (call kw) 106) 3) 100 (if (call sym_eq src_ptr pos len (+ (call kw) 109) 4) 101 (if (call sym_eq src_ptr pos len (+ (call kw) 113) 2) 102 (if (call sym_eq src_ptr pos len (+ (call kw) 115) 4) 103 (if (call sym_eq src_ptr pos len (+ (call kw) 119) 5) 104 (if (call sym_eq src_ptr pos len (+ (call kw) 124) 4) 105 (if (call sym_eq src_ptr pos len (+ (call kw) 128) 5) 106 (if (call sym_eq src_ptr pos len (+ (call kw) 133) 3) 107 (if (call sym_eq src_ptr pos len (+ (call kw) 136) 3) 108 (if (call sym_eq src_ptr pos len (+ (call kw) 139) 3) 109 (if (call sym_eq src_ptr pos len (+ (call kw) 142) 6) 110 (if (call sym_eq src_ptr pos len (+ (call kw) 148) 2) 111 (if (call sym_eq src_ptr pos len (+ (call kw) 150) 3) 200 (if (call sym_eq src_ptr pos len (+ (call kw) 153) 3) 201 (if (call sym_eq src_ptr pos len (+ (call kw) 156) 3) 202 (if (call sym_eq src_ptr pos len (+ (call kw) 159) 3) 203 (if (call sym_eq src_ptr pos len (+ (call kw) 162) 4) 204 (if (call sym_eq src_ptr pos len (+ (call kw) 166) 4) 205 -1)))))))))))))))))))))))))))))))))))))))))))


  (fn type_id_to_valtype [type_id:i32] -> i32
    (if (eq type_id 200) 127
    (if (eq type_id 201) 126
    (if (eq type_id 202) 125
    (if (eq type_id 203) 124
    (if (eq type_id 204) 127
    127))))))

  ;; ===== Pass 1: function signature table =====
  ;; Entry = 56 bytes: [name_ptr,name_len,param_count,ret_type_id,
  ;;                    wasm_func_index,fndef_group, param_type_id x8]
  (fn func_entry_ptr [func_table_base:i32 idx:i32] -> i32
    (+ func_table_base (* idx 56)))

  (fn collect_functions [src_ptr:i32 root:i32 func_table_base:i32] -> i32
    (let count:i32 0)
    (let child:i32 (call node_next (call node_next (call node_a root))))
    (let done:bool false)
    (while (not done)
      (if (eq child 0)
          (block (set! done true) 0)
          (block
            (let fname_node:i32 (call nth_child child 1))
            (let params_node:i32 (call nth_child child 2))
            (let rettype_node:i32 (call nth_child child 4))
            (let entry:i32 (call func_entry_ptr func_table_base count))
            (mem.store32 (+ entry 0) (call node_a fname_node))
            (mem.store32 (+ entry 4) (call node_b fname_node))
            (mem.store32 (+ entry 12) (call classify_keyword src_ptr (call node_a rettype_node) (call node_b rettype_node)))
            (mem.store32 (+ entry 16) count)
            (mem.store32 (+ entry 20) child)
            (let pcount:i32 0)
            (let pchild:i32 (call node_a params_node))
            (let pdone:bool false)
            (while (not pdone)
              (if (eq pchild 0)
                  (block (set! pdone true) 0)
                  (block
                    (let ptype_node:i32 (call node_next (call node_next pchild)))
                    (mem.store32 (+ entry (+ 24 (* pcount 4)))
                                 (call classify_keyword src_ptr (call node_a ptype_node) (call node_b ptype_node)))
                    (set! pcount (+ pcount 1))
                    (set! pchild (call node_next ptype_node))
                    0)))
            (mem.store32 (+ entry 8) pcount)
            (set! count (+ count 1))
            (set! child (call node_next child))
            0)))
    count)

  ;; Looks up a function by name; returns its wasm_func_index, or -1.
  (fn find_function [src_ptr:i32 func_table_base:i32 func_count:i32 name_ptr:i32 name_len:i32] -> i32
    (let i:i32 0)
    (let found:i32 -1)
    (while (lt i func_count)
      (let entry:i32 (call func_entry_ptr func_table_base i))
      (let e_name_ptr:i32 (mem.load32 (+ entry 0)))
      (let e_name_len:i32 (mem.load32 (+ entry 4)))
      (if (call sym_eq src_ptr name_ptr name_len (+ src_ptr e_name_ptr) e_name_len)
          (set! found i)
          (set! found found))
      (set! i (+ i 1)))
    found)

  ;; ===== Pass 2 (per function): local variable table =====
  ;; Entry = 12 bytes: [name_ptr, name_len, type_id]. A local's wasm index
  ;; IS its position in the table (params occupy the first slots, in order).
  ;; The running count lives at runtime cell mem[28] - functions only
  ;; return one value, so state shared across the recursive tree walk below
  ;; lives in memory, same pattern used by the parser's parse_node.

  (fn locals_entry_ptr [base:i32 idx:i32] -> i32
    (+ base (* idx 12)))

  (fn find_local [base:i32 count:i32 src_ptr:i32 name_ptr:i32 name_len:i32] -> i32
    (let i:i32 0)
    (let found:i32 -1)
    (while (lt i count)
      (let e:i32 (call locals_entry_ptr base i))
      (let e_name_ptr:i32 (mem.load32 (+ e 0)))
      (let e_name_len:i32 (mem.load32 (+ e 4)))
      (if (call sym_eq src_ptr name_ptr name_len (+ src_ptr e_name_ptr) e_name_len)
          (set! found i)
          (set! found found))
      (set! i (+ i 1)))
    found)

  (fn add_local_if_new [src_ptr:i32 base:i32 name_ptr:i32 name_len:i32 type_id:i32] -> i32
    (let count:i32 (mem.load32 28))
    (let existing:i32 (call find_local base count src_ptr name_ptr name_len))
    (if (eq existing -1)
        (block
          (let e:i32 (call locals_entry_ptr base count))
          (mem.store32 (+ e 0) name_ptr)
          (mem.store32 (+ e 4) name_len)
          (mem.store32 (+ e 8) type_id)
          (mem.store32 28 (+ count 1))
          0)
        0))

  ;; Recurses into every child of every paren-group looking for `let`/`loop`
  ;; forms anywhere in the subtree, regardless of what construct contains
  ;; them - the generic tree makes this simpler than Rust's collect_lets,
  ;; which has to special-case every AST variant that can nest a body.
  (fn collect_locals_walk [src_ptr:i32 base:i32 node:i32] -> i32
    (if (neq (call node_kind node) 20)
        0
        (block
          (let head:i32 (call node_a node))
          (let kw:i32 -1)
          (if (eq (call node_kind head) 6)
              (set! kw (call classify_keyword src_ptr (call node_a head) (call node_b head)))
              (set! kw -1))
          (if (eq kw 100)
              (block
                (let name_node:i32 (call nth_child node 1))
                (let type_node:i32 (call nth_child node 3))
                (let type_id:i32 (call classify_keyword src_ptr (call node_a type_node) (call node_b type_node)))
                (call add_local_if_new src_ptr base (call node_a name_node) (call node_b name_node) type_id))
              (if (eq kw 103)
                  (block
                    (let var_node:i32 (call nth_child node 1))
                    (call add_local_if_new src_ptr base (call node_a var_node) (call node_b var_node) 200))
                  0))
          (let child:i32 (call node_a node))
          (let done:bool false)
          (while (not done)
            (if (eq child 0)
                (block (set! done true) 0)
                (block
                  (let _w:i32 (call collect_locals_walk src_ptr base child))
                  (set! child (call node_next child))
                  0)))
          0)))

  (fn is_contract_head [src_ptr:i32 group:i32] -> bool
    (let head:i32 (call node_a group))
    (if (neq (call node_kind head) 6)
        false
        (block
          (let kw:i32 (call classify_keyword src_ptr (call node_a head) (call node_b head)))
          (or (eq kw 107) (or (eq kw 108) (eq kw 109))))))

  ;; Populates `base` with this function's params (first, in order) then any
  ;; let/loop-introduced locals found anywhere in its body. Returns the total
  ;; local count (== the number of wasm locals, params included).
  (fn collect_locals_for_function [src_ptr:i32 entry:i32 base:i32] -> i32
    (mem.store32 28 0)
    (let fndef_group:i32 (mem.load32 (+ entry 20)))
    (let params_node:i32 (call nth_child fndef_group 2))
    (let pchild:i32 (call node_a params_node))
    (let pdone:bool false)
    (while (not pdone)
      (if (eq pchild 0)
          (block (set! pdone true) 0)
          (block
            (let type_node:i32 (call node_next (call node_next pchild)))
            (let type_id:i32 (call classify_keyword src_ptr (call node_a type_node) (call node_b type_node)))
            (let _r:i32 (call add_local_if_new src_ptr base (call node_a pchild) (call node_b pchild) type_id))
            (set! pchild (call node_next type_node))
            0)))
    (let bchild:i32 (call nth_child fndef_group 5))
    (let bdone:bool false)
    (while (not bdone)
      (if (eq bchild 0)
          (block (set! bdone true) 0)
          (block
            (if (call is_contract_head src_ptr bchild)
                0
                (call collect_locals_walk src_ptr base bchild))
            (set! bchild (call node_next bchild))
            0)))
    (mem.load32 28))

