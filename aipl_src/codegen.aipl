  (fn compile_group [src_ptr:i32 node:i32 out_ptr:i32 locals_base:i32 locals_count:i32 func_table_base:i32 func_count:i32] -> i32
    (let kw:i32 (call group_head_keyword src_ptr node))
    (let head_node:i32 (call node_a node))
    (cond
      ((eq kw 100) (call compile_let src_ptr node out_ptr locals_base locals_count func_table_base func_count))
      ((eq kw 101) (call compile_set src_ptr node out_ptr locals_base locals_count func_table_base func_count))
      ((eq kw 102) (call compile_if src_ptr node out_ptr locals_base locals_count func_table_base func_count))
      ((eq kw 103) (call compile_loop src_ptr node out_ptr locals_base locals_count func_table_base func_count))
      ((eq kw 104) (call compile_while src_ptr node out_ptr locals_base locals_count func_table_base func_count))
      ((eq kw 105) (call compile_call src_ptr node out_ptr locals_base locals_count func_table_base func_count))
      ((eq kw 106) (call compile_block src_ptr node out_ptr locals_base locals_count func_table_base func_count))
      ((eq kw 112) (call compile_match_result src_ptr node out_ptr locals_base locals_count func_table_base func_count))
      ((eq kw 114) (call compile_cond_from src_ptr (call nth_child node 1) out_ptr locals_base locals_count func_table_base func_count))
