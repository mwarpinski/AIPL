;; AIPL Self-Hosted Code Generator: generic S-expression tree (from
;; compiler.tokenize + compiler.parse_ast) -> real WebAssembly bytes.
;;
;; Scope matches src/compiler/wasm.rs byte-for-byte.

(module codegen
  (import compiler)
  (import consts)
  (import str)
  (import buf)
  (import strmap)

  ;; ===== Generic byte-span comparison =====
  (fn sym_eq [cg:(ptr Cg) pos:i32 len:i32 lit_ptr:i32 lit_len:i32] -> bool
    (if (neq len lit_len) (return false) (block))
    (loop i 0 (- len 1) 1
      (if (neq (mem.load8 (+ (get cg Cg.src) (+ pos i))) (mem.load8 (+ lit_ptr i))) (return false) (block)))
    true)

  ;; ===== Node accessors (see compiler.aipl for the tree layout) =====
  (fn node_kind [node:(ptr compiler.Node)] -> compiler.Kind
    (if (eq node (ptr.null compiler.Node)) compiler.Kind.none (get node compiler.Node.kind)))
  ;; An atom's value: an integer literal's value, or the source offset of a
  ;; symbol, string, or i64/float literal (compiler.aipl). A group's is its
  ;; first child's address: use first_child.
  (fn node_a [node:(ptr compiler.Node)] -> i32 (if (eq node (ptr.null compiler.Node)) 0 (get node compiler.Node.a)))
  (fn node_b [node:(ptr compiler.Node)] -> i32 (if (eq node (ptr.null compiler.Node)) 0 (get node compiler.Node.b)))
  (fn node_next [node:(ptr compiler.Node)] -> (ptr compiler.Node)
    (if (eq node (ptr.null compiler.Node)) node (get node compiler.Node.next)))
  (fn first_child [group:(ptr compiler.Node)] -> (ptr compiler.Node)
    (if (eq group (ptr.null compiler.Node)) group (ptr.cast compiler.Node (get group compiler.Node.a))))

  (fn nth_child [group:(ptr compiler.Node) n:i32] -> (ptr compiler.Node)
    (req (gte n 0))
    (let cur:(ptr compiler.Node) (call first_child group))
    (let i:i32 0)
    (while (lt i n)
      (set! cur (call node_next cur))
      (set! i (+ i 1)))
    cur)

  ;; ===== The compile =====
  ;; What every compile function needs, passed as one value: the source text,
  ;; the locals of the function being compiled, and the module's functions.
  ;; (The tables are still raw memory; docs/CODEGEN_REWRITE.md CR6.)
  (struct Cg [src:i32 locals:(arr (ptr Local)) nlocals:i32 fns:(arr (ptr FnInfo)) nfns:i32
              structs:(arr (ptr StructInfo)) nstructs:i32])

  ;; A struct of the module and its layout (checker.rs get_field_offset):
  ;; fields in declaration order, each aligned to its size.
  (struct StructInfo [name_pos:i32 name_len:i32 size:i32 fields:(arr (ptr Field)) nfields:i32])
  (struct Field [name_pos:i32 name_len:i32 offset:i32 ty:Ty])

  ;; A local of the function being compiled (parameters first): its name (a
  ;; span of the source) and type. A loop's hidden end and step locals carry
  ;; the loop variable's name and the type loop_end / loop_step.
  (struct Local [name_pos:i32 name_len:i32 ty:Ty])

  ;; A function of the module: its name (a span of the source), parameter
  ;; and result types, wasm index, and definition.
  (struct FnInfo [name_pos:i32 name_len:i32 nparams:i32 ret:Ty index:i32
                  node:(ptr compiler.Node) params:(arr Ty)])

  (fn new_cg [src:i32] -> (ptr Cg)
    (let cg:(ptr Cg) (new Cg))
    (put cg Cg.src src)
    (put cg Cg.locals (arr.new (ptr Local) 1024))
    (put cg Cg.nlocals 0)
    (put cg Cg.fns (arr.new (ptr FnInfo) 2048))
    (put cg Cg.nfns 0)
    (put cg Cg.structs (arr.new (ptr StructInfo) 255))
    (put cg Cg.nstructs 0)
    cg)

  ;; ===== Runtime memory cells (AIPL_SPEC.md 7.9) =====
  ;;   mem[4]  = compile error code (0 = none; codes in AIPL_SPEC.md 6.4)
  ;;   mem[8]  = header pointer (16 bytes: +4 call_ref signatures, +8 label stack, +12 WASI import indices; the structs are Cg.structs)
  ;;   mem[12] = string state block pointer (16384 bytes: blob len, count,
  ;;             newline addr, blob buffer ptr, then 1364 12-byte entries;
  ;;             the blob buffer holds 65536 bytes)
  ;;   mem[16] = keyword table pointer      (1024 bytes)
  ;;   mem[20] = unused (the function table is Cg.fns)
  ;;   mem[24], mem[28] = unused (the locals are Cg.locals and Cg.nlocals)
  ;;   mem[32] = WASI import count
  ;;   mem[36..56] = unused (the WASI import indices moved to struct_table + 12)
  ;;   mem[60] = compiled module output pointer
  (fn str_table_ptr [] -> i32 (mem.load32 12))
  (fn struct_table [] -> i32 (mem.load32 8))
  ;; Function-ref state, 1024 bytes, pointer kept at struct_table + 4:
  ;; [uses_refs][sig_count][32 signatures x 20 bytes: nparams, params..., nresults, result]
  (fn ref_state [] -> i32 (mem.load32 (+ (call struct_table) 4)))
  (fn ref_sig_ptr [i:i32] -> i32 (+ (+ (call ref_state) 8) (* i 20)))

  ;; Label stack, 1024 bytes, pointer kept at struct_table + 8: [count][kinds...]
  ;; for the structured instructions around user code, innermost last, so
  ;; break/continue can compute their branch depth (wasm.rs Label).
  ;; Kinds: 0 if/else, 1 loop exit block (break), 2 loop header (while
  ;; continue), 3 block around a loop body (loop continue).
  (fn label_stack [] -> i32 (mem.load32 (+ (call struct_table) 8)))
  (fn label_push [kind:i32] -> i32
    (let ls:i32 (call label_stack))
    (let n:i32 (mem.load32 ls))
    (if (gte n 255) (return (call set_compile_error CgErr.too_deeply_nested)) (block))
    (mem.store32 (+ ls (+ 4 (* n 4))) kind)
    (mem.store32 ls (+ n 1))
    0)
  (fn label_pop [] -> i32
    (let ls:i32 (call label_stack))
    (mem.store32 ls (- (mem.load32 ls) 1))
    0)
  ;; Branch depth to the innermost label of kind a or b (compile error 101 if none).
  (fn label_depth [a:i32 b:i32] -> i32
    (let ls:i32 (call label_stack))
    (let n:i32 (mem.load32 ls))
    (loop d 0 (- n 1) 1
      (let k:i32 (mem.load32 (+ ls (+ 4 (* (- (- n 1) d) 4)))))
      (if (or (eq k a) (eq k b)) (return d) (block)))
    (call set_compile_error CgErr.jump_outside_loop)
    0)
  (fn kw [] -> i32 (mem.load32 16))
  (fn get_str_blob_len [] -> i32 (mem.load32 (+ (call str_table_ptr) 0)))
  (fn set_str_blob_len [len:i32] -> i32 (mem.store32 (+ (call str_table_ptr) 0) len) 0)
  (fn get_str_count [] -> i32 (mem.load32 (+ (call str_table_ptr) 4)))
  (fn set_str_count [cnt:i32] -> i32 (mem.store32 (+ (call str_table_ptr) 4) cnt) 0)
  (fn get_newline_addr [] -> i32 (mem.load32 (+ (call str_table_ptr) 8)))
  (fn set_newline_addr [addr:i32] -> i32 (mem.store32 (+ (call str_table_ptr) 8) addr) 0)
  (fn str_blob_buf [] -> i32 (mem.load32 (+ (call str_table_ptr) 12)))
  (fn str_entry_ptr [idx:i32] -> i32 (+ (+ (call str_table_ptr) 16) (* idx 12)))
  ;; String literals are placed at 1024; the heap starts at the first 8-aligned
  ;; address after them (wasm.rs heap_start_after), and stores below it trap.
  (fn heap_start [] -> i32 (bitand (+ 1031 (call get_str_blob_len)) -8))

  ;; Idempotent: allocates the tables on first call, and clears error flags.
  (fn codegen_init [] -> i32
    (if (eq (mem.load32 16) 0)
        (block
          (mem.store32 8 (mem.alloc 16))
          (mem.store32 12 (mem.alloc 16384))
          (mem.store32 16 (ptr.addr (call new_keywords)))
          (mem.store32 (+ (mem.load32 12) 12) (mem.alloc 65536))
          (mem.store32 (+ (mem.load32 8) 4) (mem.alloc 1024))
          (mem.store32 (+ (mem.load32 8) 8) (mem.alloc 1024))
          (mem.store32 (+ (mem.load32 8) 12) (mem.alloc 52))
          0)
        0)

    (mem.store32 4 0)
    (mem.store32 (call ref_state) 0)
    (mem.store32 (call label_stack) 0)
    (mem.store32 (+ (call ref_state) 4) 0)
    (mem.store32 32 0)
    (call set_str_blob_len 0)
    (call set_str_count 0)
    (call set_newline_addr 0)
    (let i:i32 0)
    (while (lt i 13)
      (mem.store32 (call wasi_cell i) -1)
      (set! i (+ i 1)))
    0)

  ;; ===== Keywords =====
  ;; Every word with a meaning of its own: ops (0-86), forms (100-115), and
  ;; type names (200-209); none for any other symbol. The values are the ids
  ;; the code generator has always used.
  (enum Kw [(none -1) (add 0) (sub 1) (mul 2) (div 3) (xor 4) (shl 5) (shr 6) (bitand 7) (bitor 8) (mem_load8 9) (mem_load32 10) (mem_load64 11) (mem_store8 12) (mem_store32 13) (mem_store64 14) (eq 15) (neq 16) (lt 17) (lte 18) (gt 19) (gte 20) (and 21) (or 22) (not 23) (str_len 30) (str_ptr 31) (sys_print 32) (sys_exit 33) (fs_open 34) (fs_read 35) (fs_write 36) (fs_close 37) (fs_delete 38) (rem 39) (divu 40) (remu 41) (shru 42) (mem_alloc 43) (mem_grow 44) (i64_extend_s 45) (i64_extend_u 46) (i32_wrap 47) (ok 48) (err 49) (new 50) (get 51) (put 52) (sizeof 53) (arr_new 54) (arr_get 55) (arr_set 56) (f64_convert_i64_s 57) (i64_trunc_f64_s 58) (f64_reinterpret_i64 59) (i64_reinterpret_f64 60) (ptr_null 61) (ptr_cast 62) (ptr_addr 63) (arr_null 64) (arr_cast 65) (arr_addr 66) (arr_len 67) (ref 68) (call_ref 69) (return 70) (break 71) (continue 72) (args_sizes 73) (args_get 74) (env_sizes 75) (env_get 76) (thread_spawn 77) (thread_join 78) (atomic_add 79) (atomic_cas 80) (atomic_lock 81) (atomic_unlock 82) (sys_time 83) (sys_monotonic 84) (sys_random 85) (f64_sqrt 86) (let 100) (set 101) (if 102) (loop 103) (while 104) (call 105) (block 106) (req 107) (ens 108) (inv 109) (module 110) (fn 111) (match_result 112) (struct 113) (cond 114) (else 115) (ty_i32 200) (ty_i64 201) (ty_f32 202) (ty_f64 203) (ty_bool 204) (ty_void 205) (ty_str 206) (ty_result 207) (ty_ptr 208) (ty_arr 209)])

  ;; The keyword map, at cell 16: keyword text -> Kw, plus one scratch slice
  ;; so that a lookup allocates nothing.
  (struct Keywords [map:(ptr (strmap.StrMap Kw)) key:(ptr str.Bytes)])

  (fn keywords [] -> (ptr Keywords) (ptr.cast Keywords (mem.load32 16)))

  (fn new_keywords [] -> (ptr Keywords)
    (let ks:(ptr Keywords) (new Keywords))
    (put ks Keywords.map (call (strmap.make Kw) 256))
    (put ks Keywords.key (call str.bytes 0 0))
    ks)

  (fn reg [m:(ptr (strmap.StrMap Kw)) word:str k:Kw] -> void
    (call (strmap.set Kw) m (call str.from_str word) k))

  ;; Fills the keyword map once (it also runs codegen_init, every time).
  (fn init_keywords [] -> i32
    (let _init:i32 (call codegen_init))
    (let m:(ptr (strmap.StrMap Kw)) (get (call keywords) Keywords.map))
    (if (gt (call (strmap.count Kw) m) 0) (return 0) (block))
    (call reg m "+" Kw.add)
    (call reg m "-" Kw.sub)
    (call reg m "*" Kw.mul)
    (call reg m "/" Kw.div)
    (call reg m "^" Kw.xor)
    (call reg m "shl" Kw.shl)
    (call reg m "shr" Kw.shr)
    (call reg m "bitand" Kw.bitand)
    (call reg m "bitor" Kw.bitor)
    (call reg m "mem.load8" Kw.mem_load8)
    (call reg m "mem.load32" Kw.mem_load32)
    (call reg m "mem.load64" Kw.mem_load64)
    (call reg m "mem.store8" Kw.mem_store8)
    (call reg m "mem.store32" Kw.mem_store32)
    (call reg m "mem.store64" Kw.mem_store64)
    (call reg m "eq" Kw.eq)
    (call reg m "neq" Kw.neq)
    (call reg m "lt" Kw.lt)
    (call reg m "lte" Kw.lte)
    (call reg m "gt" Kw.gt)
    (call reg m "gte" Kw.gte)
    (call reg m "and" Kw.and)
    (call reg m "or" Kw.or)
    (call reg m "not" Kw.not)
    (call reg m "str.len" Kw.str_len)
    (call reg m "str.ptr" Kw.str_ptr)
    (call reg m "sys.print" Kw.sys_print)
    (call reg m "sys.exit" Kw.sys_exit)
    (call reg m "fs.open" Kw.fs_open)
    (call reg m "fs.read" Kw.fs_read)
    (call reg m "fs.write" Kw.fs_write)
    (call reg m "fs.close" Kw.fs_close)
    (call reg m "fs.delete" Kw.fs_delete)
    (call reg m "%" Kw.rem)
    (call reg m "divu" Kw.divu)
    (call reg m "remu" Kw.remu)
    (call reg m "shru" Kw.shru)
    (call reg m "mem.alloc" Kw.mem_alloc)
    (call reg m "mem.grow" Kw.mem_grow)
    (call reg m "i64.extend_s" Kw.i64_extend_s)
    (call reg m "i64.extend_u" Kw.i64_extend_u)
    (call reg m "i32.wrap" Kw.i32_wrap)
    (call reg m "ok" Kw.ok)
    (call reg m "err" Kw.err)
    (call reg m "new" Kw.new)
    (call reg m "get" Kw.get)
    (call reg m "put" Kw.put)
    (call reg m "sizeof" Kw.sizeof)
    (call reg m "arr.new" Kw.arr_new)
    (call reg m "arr.get" Kw.arr_get)
    (call reg m "arr.set" Kw.arr_set)
    (call reg m "f64.convert_i64_s" Kw.f64_convert_i64_s)
    (call reg m "i64.trunc_f64_s" Kw.i64_trunc_f64_s)
    (call reg m "f64.reinterpret_i64" Kw.f64_reinterpret_i64)
    (call reg m "i64.reinterpret_f64" Kw.i64_reinterpret_f64)
    (call reg m "ptr.null" Kw.ptr_null)
    (call reg m "ptr.cast" Kw.ptr_cast)
    (call reg m "ptr.addr" Kw.ptr_addr)
    (call reg m "arr.null" Kw.arr_null)
    (call reg m "arr.cast" Kw.arr_cast)
    (call reg m "arr.addr" Kw.arr_addr)
    (call reg m "arr.len" Kw.arr_len)
    (call reg m "ref" Kw.ref)
    (call reg m "call_ref" Kw.call_ref)
    (call reg m "return" Kw.return)
    (call reg m "break" Kw.break)
    (call reg m "continue" Kw.continue)
    (call reg m "args.sizes" Kw.args_sizes)
    (call reg m "args.get" Kw.args_get)
    (call reg m "env.sizes" Kw.env_sizes)
    (call reg m "env.get" Kw.env_get)
    (call reg m "thread.spawn" Kw.thread_spawn)
    (call reg m "thread.join" Kw.thread_join)
    (call reg m "atomic.add" Kw.atomic_add)
    (call reg m "atomic.cas" Kw.atomic_cas)
    (call reg m "atomic.lock" Kw.atomic_lock)
    (call reg m "atomic.unlock" Kw.atomic_unlock)
    (call reg m "sys.time" Kw.sys_time)
    (call reg m "sys.monotonic" Kw.sys_monotonic)
    (call reg m "sys.random" Kw.sys_random)
    (call reg m "f64.sqrt" Kw.f64_sqrt)
    (call reg m "let" Kw.let)
    (call reg m "set!" Kw.set)
    (call reg m "if" Kw.if)
    (call reg m "loop" Kw.loop)
    (call reg m "while" Kw.while)
    (call reg m "call" Kw.call)
    (call reg m "block" Kw.block)
    (call reg m "req" Kw.req)
    (call reg m "ens" Kw.ens)
    (call reg m "inv" Kw.inv)
    (call reg m "module" Kw.module)
    (call reg m "fn" Kw.fn)
    (call reg m "match_result" Kw.match_result)
    (call reg m "struct" Kw.struct)
    (call reg m "cond" Kw.cond)
    (call reg m "else" Kw.else)
    (call reg m "i32" Kw.ty_i32)
    (call reg m "i64" Kw.ty_i64)
    (call reg m "f32" Kw.ty_f32)
    (call reg m "f64" Kw.ty_f64)
    (call reg m "bool" Kw.ty_bool)
    (call reg m "void" Kw.ty_void)
    (call reg m "str" Kw.ty_str)
    (call reg m "result" Kw.ty_result)
    (call reg m "ptr" Kw.ty_ptr)
    (call reg m "arr" Kw.ty_arr)
    0)

  ;; An operator (as opposed to a form, a type name, or none): ids 0-99.
  (fn is_op [k:Kw] -> bool
    (and (gte (enum.ord k) 0) (lt (enum.ord k) 100)))

  ;; return, break, continue: statements that jump.
  (fn is_jump [k:Kw] -> bool
    (or (eq k Kw.return) (or (eq k Kw.break) (eq k Kw.continue))))

  ;; Arithmetic and bitwise ops, whose type is their operands' type.
  (fn is_arith [k:Kw] -> bool
    (or (or (eq k Kw.add) (or (eq k Kw.sub) (or (eq k Kw.mul) (or (eq k Kw.div) (eq k Kw.xor)))))
        (or (or (eq k Kw.shl) (or (eq k Kw.shr) (or (eq k Kw.bitand) (eq k Kw.bitor))))
            (or (eq k Kw.rem) (or (eq k Kw.divu) (or (eq k Kw.remu) (eq k Kw.shru)))))))

  ;; Comparisons and logic, which yield bool.
  (fn is_compare [k:Kw] -> bool
    (or (or (eq k Kw.eq) (or (eq k Kw.neq) (or (eq k Kw.lt) (or (eq k Kw.lte) (or (eq k Kw.gt) (eq k Kw.gte))))))
        (or (eq k Kw.and) (or (eq k Kw.or) (eq k Kw.not)))))

  ;; The WASI function behind args.sizes / args.get / env.sizes / env.get, or -1.
  (fn proc_wasi [k:Kw] -> i32
    (cond
      ((eq k Kw.args_sizes) 6)
      ((eq k Kw.args_get) 7)
      ((eq k Kw.env_sizes) 8)
      ((eq k Kw.env_get) 9)
      (else -1)))

  ;; The keyword spelled by len bytes at src_ptr + pos, or Kw.none.
  (fn classify_keyword [cg:(ptr Cg) pos:i32 len:i32] -> Kw
    (let ks:(ptr Keywords) (call keywords))
    (let key:(ptr str.Bytes) (get ks Keywords.key))
    (put key str.Bytes.addr (+ (get cg Cg.src) pos))
    (put key str.Bytes.len len)
    (call (strmap.get_or Kw) (get ks Keywords.map) key Kw.none))

;; ===== Types =====
  ;; A value's static type, as expr_type in wasm.rs computes it. bool, str,
  ;; results, pointers, arrays, and function refs are i32 in wasm; loop_end
  ;; and loop_step are the hidden locals holding a loop's bound and step.
  ;; The values are the ids codegen has always stored in its tables.
  (enum Ty [(none -1) (i32 200) i64 f32 f64 bool void str result ptr arr fn loop_end loop_step])

  ;; The type a type keyword names, or Ty.none.
  (fn ty_of_kw [k:Kw] -> Ty
    (cond
      ((eq k Kw.ty_i32) Ty.i32)
      ((eq k Kw.ty_i64) Ty.i64)
      ((eq k Kw.ty_f32) Ty.f32)
      ((eq k Kw.ty_f64) Ty.f64)
      ((eq k Kw.ty_bool) Ty.bool)
      ((eq k Kw.ty_void) Ty.void)
      ((eq k Kw.ty_str) Ty.str)
      ((eq k Kw.ty_result) Ty.result)
      ((eq k Kw.ty_ptr) Ty.ptr)
      ((eq k Kw.ty_arr) Ty.arr)
      (else Ty.none)))

  ;; The type a type node names: a scalar symbol, or a (result T E), (ptr S),
  ;; (arr T), or (fn [..] -> r) group. Anything else is compile error 98.
  (fn type_node_id [cg:(ptr Cg) node:(ptr compiler.Node)] -> Ty
    (let t:Ty Ty.none)
    (if (eq (call node_kind node) compiler.Kind.symbol)
        (set! t (call ty_of_kw (call classify_keyword cg (call node_a node) (call node_b node))))
        (if (eq (call node_kind node) compiler.Kind.paren)
            (block
              (let head:Kw (call group_head_keyword cg node))
              (if (or (eq head Kw.ty_result) (or (eq head Kw.ty_ptr) (eq head Kw.ty_arr))) (set! t (call ty_of_kw head)) (block))
              (if (eq head Kw.fn) (set! t Ty.fn) (block)))
            (block)))
    (if (eq t Ty.none)
        (block (call set_compile_error CgErr.unlowerable_type) Ty.i32)
        t))

  ;; The wasm value type byte: 0x7f i32, 0x7e i64, 0x7d f32, 0x7c f64.
  (fn type_id_to_valtype [t:Ty] -> i32
    (cond
      ((eq t Ty.i64) 126)
      ((eq t Ty.f32) 125)
      ((eq t Ty.f64) 124)
      ((eq t Ty.void) (call set_compile_error CgErr.unlowerable_type) 127)
      ((eq t Ty.none) (call set_compile_error CgErr.unlowerable_type) 127)
      (else 127)))

  ;; Block type byte for a value of this type: 0x40 (empty) for void.
  (fn block_type_byte [t:Ty] -> i32
    (if (eq t Ty.void) 64 (call type_id_to_valtype t)))

  ;; Scalars that can live in a struct field or array element.
  (fn is_memory_type [t:Ty] -> bool
    (not (or (eq t Ty.void) (or (eq t Ty.result) (or (eq t Ty.none) (or (eq t Ty.loop_end) (eq t Ty.loop_step)))))))
  ;; Element type of arr.new/get/set: a memory scalar, else compile error 95.
  (fn elem_type_id [cg:(ptr Cg) node:(ptr compiler.Node)] -> Ty
    (let t:Ty (call type_node_id cg node))
    (if (call is_memory_type t) t (block (call set_compile_error CgErr.not_a_memory_type) Ty.i32)))
  (fn type_size [t:Ty] -> i32 (if (or (eq t Ty.i64) (eq t Ty.f64)) 8 4))
  (fn mem_align [t:Ty] -> i32 (if (eq (call type_size t) 8) 3 2))
  (fn load_opcode [t:Ty] -> i32 (cond
                                  ((eq t Ty.i64) 41)
                                  ((eq t Ty.f32) 42)
                                  ((eq t Ty.f64) 43)
                                  (else 40)))
  (fn store_opcode [t:Ty] -> i32 (cond
                                   ((eq t Ty.i64) 55)
                                   ((eq t Ty.f32) 56)
                                   ((eq t Ty.f64) 57)
                                   (else 54)))

  ;; ===== Function table =====
  (fn func_entry_ptr [cg:(ptr Cg) idx:i32] -> (ptr FnInfo)
    (arr.get (ptr FnInfo) (get cg Cg.fns) idx))

  ;; Records every (fn ...) of the module, in order; returns the count.
  (fn collect_functions [cg:(ptr Cg) root:(ptr compiler.Node)] -> i32
    (let count:i32 0)
    (let child:(ptr compiler.Node) (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (if (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.fn))
          (block
            (let fname_node:(ptr compiler.Node) (call nth_child child 1))
            (let params_node:(ptr compiler.Node) (call nth_child child 2))
            (if (gte count 2048) (call set_compile_error CgErr.too_many_functions) 0)
            (let f:(ptr FnInfo) (new FnInfo))
            (put f FnInfo.name_pos (call node_a fname_node))
            (put f FnInfo.name_len (call node_b fname_node))
            (put f FnInfo.ret (call type_node_id cg (call nth_child child 4)))
            (put f FnInfo.index count)
            (put f FnInfo.node child)
            (put f FnInfo.params (arr.new Ty 16))
            (let pcount:i32 0)
            (let pchild:(ptr compiler.Node) (call first_child params_node))
            (while (neq pchild (ptr.null compiler.Node))
              (let ptype_node:(ptr compiler.Node) (call node_next (call node_next pchild)))
              (if (gte pcount 16) (call set_compile_error CgErr.too_many_functions) 0)
              (arr.set Ty (get f FnInfo.params) (if (gte pcount 16) 15 pcount) (call type_node_id cg ptype_node))
              (set! pcount (+ pcount 1))
              (set! pchild (call node_next ptype_node)))
            (put f FnInfo.nparams pcount)
            (arr.set (ptr FnInfo) (get cg Cg.fns) (if (gte count 2048) 2047 count) f)
            (if (lt count 2048) (set! count (+ count 1)) (block)))
          (block))
      (set! child (call node_next child)))
    count)

  ;; Exact name match, as in the checker: `a.f` never resolves to a bare `f`.
  (fn find_function [cg:(ptr Cg) name_ptr:i32 name_len:i32] -> i32
    (loop i 0 (- (get cg Cg.nfns) 1) 1
      (let entry:(ptr FnInfo) (call func_entry_ptr cg i))
      (if (call sym_eq cg name_ptr name_len (+ (get cg Cg.src) (get entry FnInfo.name_pos)) (get entry FnInfo.name_len))
          (return i)
          (block)))
    -1)

  ;; ===== Local variable table =====
  (fn local_at [cg:(ptr Cg) idx:i32] -> (ptr Local)
    (arr.get (ptr Local) (get cg Cg.locals) idx))

  (fn find_local [cg:(ptr Cg) name_ptr:i32 name_len:i32] -> i32
    (loop i 0 (- (get cg Cg.nlocals) 1) 1
      (let l:(ptr Local) (call local_at cg i))
      (if (call sym_eq cg name_ptr name_len (+ (get cg Cg.src) (get l Local.name_pos)) (get l Local.name_len))
          (return i)
          (block)))
    -1)

  ;; Appends a local (the 1024th and later overwrite the last, after compile
  ;; error 93).
  (fn add_local [cg:(ptr Cg) name_ptr:i32 name_len:i32 ty:Ty] -> void
    (let count:i32 (get cg Cg.nlocals))
    (if (gte count 1024) (call set_compile_error CgErr.too_many_locals) 0)
    (let l:(ptr Local) (new Local))
    (put l Local.name_pos name_ptr)
    (put l Local.name_len name_len)
    (put l Local.ty ty)
    (arr.set (ptr Local) (get cg Cg.locals) (if (gte count 1024) 1023 count) l)
    (put cg Cg.nlocals (if (gte count 1024) 1024 (+ count 1))))

  (fn add_local_if_new [cg:(ptr Cg) name_ptr:i32 name_len:i32 ty:Ty] -> i32
    (if (eq (call find_local cg name_ptr name_len) -1) (call add_local cg name_ptr name_len ty) (block))
    0)

  ;; A loop's hidden end / step local (wasm.rs `i#end` / `i#step`), added once
  ;; per name like any local. Lookups by name find the variable itself,
  ;; which is always added first.
  (fn find_hidden [cg:(ptr Cg) name_ptr:i32 name_len:i32 marker:Ty] -> i32
    (loop i 0 (- (get cg Cg.nlocals) 1) 1
      (let l:(ptr Local) (call local_at cg i))
      (if (and (eq (get l Local.ty) marker)
               (call sym_eq cg name_ptr name_len (+ (get cg Cg.src) (get l Local.name_pos)) (get l Local.name_len)))
          (return i)
          (block)))
    -1)

  (fn add_hidden_if_new [cg:(ptr Cg) name_ptr:i32 name_len:i32 marker:Ty] -> i32
    (if (lt (call find_hidden cg name_ptr name_len marker) 0) (call add_local cg name_ptr name_len marker) (block))
    0)

  (fn collect_locals_walk [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (if (neq (call node_kind node) compiler.Kind.paren)
        0
        (block
          (let head:i32 (call node_a node))
          (let kw:Kw (call group_head_keyword cg node))
          (cond
            ((eq kw Kw.let) (let name_node:(ptr compiler.Node) (call nth_child node 1))
                (let type_node:(ptr compiler.Node) (call nth_child node 3))
                (let type_id:Ty (call type_node_id cg type_node))
                (call add_local_if_new cg (call node_a name_node) (call node_b name_node) type_id))
            ((eq kw Kw.loop) (let var_node:(ptr compiler.Node) (call nth_child node 1))
                    (call add_local_if_new cg (call node_a var_node) (call node_b var_node) Ty.i32)
                    (call add_hidden_if_new cg (call node_a var_node) (call node_b var_node) Ty.loop_end)
                    (call add_hidden_if_new cg (call node_a var_node) (call node_b var_node) Ty.loop_step))
            ((eq kw Kw.match_result) (let ok_group:(ptr compiler.Node) (call nth_child node 2))
                        (let err_group:(ptr compiler.Node) (call nth_child node 3))
                        (let ok_var:(ptr compiler.Node) (call nth_child ok_group 1))
                        (let err_var:(ptr compiler.Node) (call nth_child err_group 1))
                        (call add_local_if_new cg (call node_a ok_var) (call node_b ok_var) Ty.i32)
                        (call add_local_if_new cg (call node_a err_var) (call node_b err_var) Ty.i32))
            (else 0))
          (let child:(ptr compiler.Node) (call first_child node))
          (while (neq child (ptr.null compiler.Node)) (let _w:i32 (call collect_locals_walk cg child)) (set! child (call node_next child)))
          0)))

  ;; Any body item may be an atom (a bare number, name, or string): its
  ;; Node.a is a value, not a child address, so check the kind first.
  (fn is_contract_head [cg:(ptr Cg) group:(ptr compiler.Node)] -> bool
    (if (neq (call node_kind group) compiler.Kind.paren) (return false) (block))
    (let head:(ptr compiler.Node) (call first_child group))
    (if (neq (call node_kind head) compiler.Kind.symbol)
        false
        (block
          (let kw:Kw (call classify_keyword cg (call node_a head) (call node_b head)))
          (or (eq kw Kw.req) (or (eq kw Kw.ens) (eq kw Kw.inv))))))

  ;; Collects the function's locals into cg (parameters first, then every
  ;; let, loop variable and its hidden end and step, and match_result
  ;; variable, in a pre-order walk); returns the count.
  (fn collect_locals_for_function [cg:(ptr Cg) entry:(ptr FnInfo)] -> i32
    (put cg Cg.nlocals 0)
    (let fndef_group:(ptr compiler.Node) (get entry FnInfo.node))
    (let pchild:(ptr compiler.Node) (call first_child (call nth_child fndef_group 2)))
    (while (neq pchild (ptr.null compiler.Node))
      (let type_node:(ptr compiler.Node) (call node_next (call node_next pchild)))
      (call add_local_if_new cg (call node_a pchild) (call node_b pchild) (call type_node_id cg type_node))
      (set! pchild (call node_next type_node)))
    (let bchild:(ptr compiler.Node) (call nth_child fndef_group 5))
    (while (neq bchild (ptr.null compiler.Node))
      (if (call is_contract_head cg bchild) 0 (call collect_locals_walk cg bchild))
      (set! bchild (call node_next bchild)))
    (get cg Cg.nlocals))

  ;; ===== Low-level WASM instruction emitters =====
  (fn encode_s32 [ptr:i32 val:i32] -> i32
    (let bytes_written:i32 0)
    (let value:i32 val)
    (let more:bool true)
    (while more
      (let byte_val:i32 (bitand value 127))
      (set! value (shr value 7))
      (let sign_bit:i32 (bitand byte_val 64))
      (let done_now:bool false)
      (if (and (eq value 0) (eq sign_bit 0))
          (set! done_now true)
          (if (and (eq value -1) (neq sign_bit 0))
              (set! done_now true)
              (set! done_now false)))
      (let byte_out:i32 byte_val)
      (if done_now (set! byte_out byte_val) (set! byte_out (bitor byte_val 128)))
      (mem.store8 (+ ptr bytes_written) byte_out)
      (set! bytes_written (+ bytes_written 1))
      (if done_now (set! more false) (set! more true)))
    bytes_written)

;; Value of an `i64` literal token such as `-7i64`. Digits accumulate
  ;; negatively so that -9223372036854775808i64 does not overflow.
  (fn parse_i64_literal [cg:(ptr Cg) pos:i32 len:i32] -> i64
    (let neg:bool (eq (mem.load8 (+ (get cg Cg.src) pos)) 45))
    (let i:i32 (if neg 1 0))
    (let v:i64 0i64)
    (while (lt i (- len 3))
      (set! v (- (* v 10i64) (i64.extend_s (- (mem.load8 (+ (get cg Cg.src) (+ pos i))) 48))))
      (set! i (+ i 1)))
    (if neg v (- 0i64 v)))

  ;; Signed LEB128 of a 64-bit value (the i64.const immediate).
  (fn encode_s64 [ptr:i32 val:i64] -> i32
    (let v:i64 val)
    (let n:i32 0)
    (let more:bool true)
    (while more
      (let b:i32 (i32.wrap (bitand v 127i64)))
      (set! v (shr v 7i64))
      (if (or (and (eq v 0i64) (eq (bitand b 64) 0)) (and (eq v -1i64) (neq (bitand b 64) 0)))
          (set! more false)
          (set! b (bitor b 128)))
      (mem.store8 (+ ptr n) b)
      (set! n (+ n 1)))
    n)

;; 10^n as i64, for 0 <= n <= 18.
  (fn pow10_i64 [n:i32] -> i64
    (let v:i64 1i64)
    (loop i 1 n 1 (set! v (* v 10i64)))
    v)

  ;; f64.const for a decimal literal such as -2.5, with the bits Rust's
  ;; parse::<f64> gives. The literal is m / 10^k; with m <= 2^53 and k <= 22
  ;; both are exact doubles, so one IEEE division is correctly rounded.
  ;; Literals outside that range are compile error 973.
  (fn emit_f64_literal [ptr:i32 cg:(ptr Cg) pos:i32 len:i32] -> i32
    (let neg:bool (eq (mem.load8 (+ (get cg Cg.src) pos)) 45))
    (let i:i32 (if neg 1 0))
    (let m:i64 0i64)
    (let sig:i32 0)
    (let frac:i32 0)
    (let seen_dot:bool false)
    (while (lt i len)
      (let c:i32 (mem.load8 (+ (get cg Cg.src) (+ pos i))))
      (if (eq c 46)
          (set! seen_dot true)
          (block
            (set! m (+ (* m 10i64) (i64.extend_s (- c 48))))
            (if (or (gt sig 0) (neq c 48)) (set! sig (+ sig 1)) (block))
            (if seen_dot (set! frac (+ frac 1)) (block))))
      (set! i (+ i 1)))
    ;; sig <= 18 keeps m from overflowing i64; m <= 2^53 makes it an exact double
    (if (or (gt sig 18) (or (gt m 9007199254740992i64) (gt frac 22))) (call set_compile_error CgErr.inexact_float_literal) 0)
    (let p:f64 (f64.convert_i64_s (call pow10_i64 (if (gt frac 18) 18 frac))))
    (if (gt frac 18) (set! p (* p (f64.convert_i64_s (call pow10_i64 (- frac 18))))) (block))
    (let v:f64 (/ (f64.convert_i64_s m) p))
    (if neg (set! v (* v (f64.convert_i64_s -1i64))) (block))
    (let bits:i64 (i64.reinterpret_f64 v))
    (mem.store8 ptr 68)
    (loop b 0 7 1
      (mem.store8 (+ ptr (+ 1 b)) (i32.wrap (bitand (shru bits (i64.extend_u (* b 8))) 255i64))))
    9)

  ;; After the heap cursor is bumped: grow memory to cover it if needed, with
  ;; no locals and no net stack effect (wasm.rs emit_grow_to_cursor).
;; A 0xFE-prefixed atomic instruction with align 2, offset 0.
  (fn emit_atomic [ptr:i32 op:i32] -> i32
    (mem.store8 ptr 254)
    (let n:i32 (call compiler.encode_u32 (+ ptr 1) op))
    (mem.store8 (+ ptr (+ 1 n)) 2)
    (mem.store8 (+ ptr (+ 2 n)) 0)
    (+ 3 n))

  ;; With a condition on the stack: if it holds, unreachable.
  (fn emit_trap_if [ptr:i32] -> i32
    (mem.store8 ptr 4)
    (mem.store8 (+ ptr 1) 64)
    (mem.store8 (+ ptr 2) 0)
    (mem.store8 (+ ptr 3) 11)
    4)

  ;; Rounds the i32 on the stack up to a multiple of 8 (wasm.rs emit_round8):
  ;; every allocation size is, so every block is 8-aligned.
  (fn emit_round8 [ptr:i32] -> i32
    (let off:i32 (call emit_i32_const ptr 7))
    (set! off (+ off (call emit_byte (+ ptr off) 106)))
    (set! off (+ off (call emit_i32_const (+ ptr off) -8)))
    (+ off (call emit_byte (+ ptr off) 113)))

  ;; The directory fd for the path in locals (ptr, len), as wasm.rs
  ;; emit_path_dir: "/..." resolves in fd 4 (the host's "/") with the slash
  ;; dropped, anything else in fd 3 (the working directory).
  (fn emit_path_dir [p:i32 ptr_l:i32 len_l:i32] -> i32
    (let off:i32 (call emit_local_get p ptr_l))
    (set! off (+ off (call emit_memop (+ p off) 45 0))) ;; i32.load8_u
    (set! off (+ off (call emit_i32_const (+ p off) 47)))
    (set! off (+ off (call emit_byte (+ p off) 70)))
    (set! off (+ off (call emit_byte (+ p off) 4)))
    (set! off (+ off (call emit_byte (+ p off) 127)))
    (set! off (+ off (call emit_local_get (+ p off) ptr_l)))
    (set! off (+ off (call emit_i32_const (+ p off) 1)))
    (set! off (+ off (call emit_byte (+ p off) 106)))
    (set! off (+ off (call emit_local_set (+ p off) ptr_l)))
    (set! off (+ off (call emit_local_get (+ p off) len_l)))
    (set! off (+ off (call emit_i32_const (+ p off) 1)))
    (set! off (+ off (call emit_byte (+ p off) 107)))
    (set! off (+ off (call emit_local_set (+ p off) len_l)))
    (set! off (+ off (call emit_i32_const (+ p off) 4)))
    (set! off (+ off (call emit_byte (+ p off) 5)))
    (set! off (+ off (call emit_i32_const (+ p off) 3)))
    (+ off (call emit_byte (+ p off) 11)))

    ;; i32.atomic.rmw.add with align 2, offset 0: [addr] [n] -> [old]. Every
  ;; allocation claims its block with one of these on the cursor at address 0.
  (fn emit_rmw_add [ptr:i32] -> i32
    (mem.store8 ptr 254)
    (mem.store8 (+ ptr 1) 30)
    (mem.store8 (+ ptr 2) 2)
    (mem.store8 (+ ptr 3) 0)
    4)

  (fn emit_grow_to_cursor [ptr:i32] -> i32
    (let off:i32 0)
    (set! off (+ off (call emit_i32_const (+ ptr off) 0)))
    (set! off (+ off (call emit_memop (+ ptr off) 40 2)))
    (set! off (+ off (call emit_size_bytes (+ ptr off))))
    (set! off (+ off (call emit_byte (+ ptr off) 75)))
    (set! off (+ off (call emit_byte (+ ptr off) 4)))
    (set! off (+ off (call emit_byte (+ ptr off) 64)))
    (set! off (+ off (call emit_i32_const (+ ptr off) 0)))
    (set! off (+ off (call emit_memop (+ ptr off) 40 2)))
    (set! off (+ off (call emit_size_bytes (+ ptr off))))
    (set! off (+ off (call emit_byte (+ ptr off) 107)))
    (set! off (+ off (call emit_i32_const (+ ptr off) 65535)))
    (set! off (+ off (call emit_byte (+ ptr off) 106)))
    (set! off (+ off (call emit_i32_const (+ ptr off) 16)))
    (set! off (+ off (call emit_byte (+ ptr off) 118)))
    (set! off (+ off (call emit_byte (+ ptr off) 64)))
    (set! off (+ off (call emit_byte (+ ptr off) 0)))
    (set! off (+ off (call emit_byte (+ ptr off) 26)))
    (+ off (call emit_byte (+ ptr off) 11)))

  ;; memory.size; i32.const 16; i32.shl -> memory size in bytes
  (fn emit_size_bytes [ptr:i32] -> i32
    (call emit_byte ptr 63)
    (call emit_byte (+ ptr 1) 0)
    (let n:i32 (+ 2 (call emit_i32_const (+ ptr 2) 16)))
    (+ n (call emit_byte (+ ptr n) 116)))

  (fn emit_byte [ptr:i32 b:i32] -> i32
    (mem.store8 ptr b)
    1)

  (fn emit_i32_const [ptr:i32 val:i32] -> i32
    (mem.store8 ptr 65)
    (+ 1 (call encode_s32 (+ ptr 1) val)))

  (fn emit_local_get [ptr:i32 idx:i32] -> i32
    (mem.store8 ptr 32)
    (+ 1 (call compiler.encode_u32 (+ ptr 1) idx)))

  (fn emit_local_set [ptr:i32 idx:i32] -> i32
    (mem.store8 ptr 33)
    (+ 1 (call compiler.encode_u32 (+ ptr 1) idx)))

  (fn emit_call [ptr:i32 idx:i32] -> i32
    (mem.store8 ptr 16)
    (+ 1 (call compiler.encode_u32 (+ ptr 1) idx)))

  (fn emit_memop [ptr:i32 opcode:i32 align:i32] -> i32
    (mem.store8 ptr opcode)
    (mem.store8 (+ ptr 1) align)
    (mem.store8 (+ ptr 2) 0)
    3)

  (fn emit_store_guard [ptr:i32 scratch_idx:i32] -> i32
    (let off:i32 0)
    (set! off (+ off (call emit_byte (+ ptr off) 34)))                  ;; local.tee
    (set! off (+ off (call compiler.encode_u32 (+ ptr off) scratch_idx)))
    (set! off (+ off (call emit_local_get (+ ptr off) scratch_idx)))
    (set! off (+ off (call emit_i32_const (+ ptr off) 4)))
    (set! off (+ off (call emit_byte (+ ptr off) 73)))                  ;; i32.lt_u
    (set! off (+ off (call emit_local_get (+ ptr off) scratch_idx)))
    (set! off (+ off (call emit_i32_const (+ ptr off) 64)))
    (set! off (+ off (call emit_byte (+ ptr off) 107)))                 ;; i32.sub
    (set! off (+ off (call emit_i32_const (+ ptr off) (- (call heap_start) 64))))
    (set! off (+ off (call emit_byte (+ ptr off) 73)))                  ;; i32.lt_u
    (set! off (+ off (call emit_byte (+ ptr off) 114)))                 ;; i32.or
    (set! off (+ off (call emit_byte (+ ptr off) 4)))                   ;; if
    (set! off (+ off (call emit_byte (+ ptr off) 64)))                  ;; blocktype: empty
    (set! off (+ off (call emit_byte (+ ptr off) 0)))                   ;; unreachable
    (set! off (+ off (call emit_byte (+ ptr off) 11)))                  ;; end
    off)

  ;; Opcode for a binary arithmetic/comparison op on operands of type t, as
  ;; arith_instruction / compare_instruction in wasm.rs; -1 if unsupported.
  (fn binop_opcode [op_id:Kw t:Ty] -> i32
    (cond
      ((eq t Ty.i32) (cond
                    ((eq op_id Kw.add) 106)
                    ((eq op_id Kw.sub) 107)
                    ((eq op_id Kw.mul) 108)
                    ((eq op_id Kw.div) 109)
                    ((eq op_id Kw.xor) 115)
                    ((eq op_id Kw.shl) 116)
                    ((eq op_id Kw.shr) 117)
                    ((eq op_id Kw.bitand) 113)
                    ((eq op_id Kw.bitor) 114)
                    ((eq op_id Kw.eq) 70)
                    ((eq op_id Kw.neq) 71)
                    ((eq op_id Kw.lt) 72)
                    ((eq op_id Kw.lte) 76)
                    ((eq op_id Kw.gt) 74)
                    ((eq op_id Kw.gte) 78)
                    ((eq op_id Kw.rem) 111)
                    ((eq op_id Kw.divu) 110)
                    ((eq op_id Kw.remu) 112)
                    ((eq op_id Kw.shru) 118)
                    (else -1)))
      ((eq t Ty.i64) (cond
                    ((eq op_id Kw.add) 124)
                    ((eq op_id Kw.sub) 125)
                    ((eq op_id Kw.mul) 126)
                    ((eq op_id Kw.div) 127)
                    ((eq op_id Kw.xor) 133)
                    ((eq op_id Kw.shl) 134)
                    ((eq op_id Kw.shr) 135)
                    ((eq op_id Kw.bitand) 131)
                    ((eq op_id Kw.bitor) 132)
                    ((eq op_id Kw.eq) 81)
                    ((eq op_id Kw.neq) 82)
                    ((eq op_id Kw.lt) 83)
                    ((eq op_id Kw.lte) 87)
                    ((eq op_id Kw.gt) 85)
                    ((eq op_id Kw.gte) 89)
                    ((eq op_id Kw.rem) 129)
                    ((eq op_id Kw.divu) 128)
                    ((eq op_id Kw.remu) 130)
                    ((eq op_id Kw.shru) 136)
                    (else -1)))
      ((eq t Ty.f32) (cond
                    ((eq op_id Kw.add) 146)
                    ((eq op_id Kw.sub) 147)
                    ((eq op_id Kw.mul) 148)
                    ((eq op_id Kw.div) 149)
                    ((eq op_id Kw.eq) 91)
                    ((eq op_id Kw.neq) 92)
                    ((eq op_id Kw.lt) 93)
                    ((eq op_id Kw.lte) 95)
                    ((eq op_id Kw.gt) 94)
                    ((eq op_id Kw.gte) 96)
                    (else -1)))
      ((eq t Ty.f64) (cond
                    ((eq op_id Kw.add) 160)
                    ((eq op_id Kw.sub) 161)
                    ((eq op_id Kw.mul) 162)
                    ((eq op_id Kw.div) 163)
                    ((eq op_id Kw.eq) 97)
                    ((eq op_id Kw.neq) 98)
                    ((eq op_id Kw.lt) 99)
                    ((eq op_id Kw.lte) 101)
                    ((eq op_id Kw.gt) 100)
                    ((eq op_id Kw.gte) 102)
                    (else -1)))
      ((or (eq t Ty.bool) (or (eq t Ty.str) (or (eq t Ty.ptr) (or (eq t Ty.arr) (eq t Ty.fn))))) (if (eq op_id Kw.eq) 70 (if (eq op_id Kw.neq) 71 -1)))
      (else -1)))

  ;; and / or are i32.and / i32.or whatever the operands; others go through
  ;; binop_opcode with the first operand's type. Unsupported: compile error 99.
  (fn emit_typed_binop [ptr:i32 op_id:Kw t:Ty] -> i32
    (if (eq op_id Kw.and) (call emit_byte ptr 113)
    (if (eq op_id Kw.or) (call emit_byte ptr 114)
    (block
      (let opc:i32 (call binop_opcode op_id t))
      (if (eq opc -1)
          (block (call set_compile_error CgErr.no_instruction_for_type) 0)
          (call emit_byte ptr opc))))))

  (fn emit_local_tee [ptr:i32 idx:i32] -> i32
    (mem.store8 ptr 34)
    (+ 1 (call compiler.encode_u32 (+ ptr 1) idx)))

  (fn emit_memop_offset [ptr:i32 opcode:i32 align:i32 offset:i32] -> i32
    (mem.store8 ptr opcode)
    (mem.store8 (+ ptr 1) align)
    (let n:i32 (call compiler.encode_u32 (+ ptr 2) offset))
    (+ 2 n))

  ;; ===== Voidness classification =====
  (fn is_void_op [k:Kw] -> bool
    (or (eq k Kw.atomic_lock) (or (eq k Kw.atomic_unlock)
    (or (eq k Kw.return) (or (eq k Kw.break) (or (eq k Kw.continue)
    (or (eq k Kw.mem_store8) (or (eq k Kw.mem_store32) (or (eq k Kw.mem_store64)
    (or (eq k Kw.sys_print) (or (eq k Kw.sys_exit) (or (eq k Kw.put) (eq k Kw.arr_set)))))))))))))

  (fn last_child [group:(ptr compiler.Node)] -> (ptr compiler.Node)
    (let cur:(ptr compiler.Node) (call first_child group))
    (while (neq (call node_next cur) (ptr.null compiler.Node))
      (set! cur (call node_next cur)))
    cur)

  ;; -1 unless group is a (...) whose head is a symbol. Checks the kinds itself
  ;; so any caller is safe: an atom's a field is a value, not a node address.
  (fn group_head_keyword [cg:(ptr Cg) group:(ptr compiler.Node)] -> Kw
    (if (neq (call node_kind group) compiler.Kind.paren) (return Kw.none) (block))
    (let head:(ptr compiler.Node) (call first_child group))
    (if (neq (call node_kind head) compiler.Kind.symbol)
        Kw.none
        (call classify_keyword cg (call node_a head) (call node_b head))))

  (fn is_void_call [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (let fname:(ptr compiler.Node) (call nth_child node 1))
    (let fidx:i32 (call find_function cg (call node_a fname) (call node_b fname)))
    (if (eq fidx -1)
        false
        (eq (get (call func_entry_ptr cg fidx) FnInfo.ret) Ty.void)))

  (fn is_void_node [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (if (neq (call node_kind node) compiler.Kind.paren)
        false
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (let res:bool false)
          (if (eq kw Kw.let) (set! res true) (block))
          (if (eq kw Kw.set) (set! res true) (block))
          (if (eq kw Kw.loop) (set! res true) (block))
          (if (eq kw Kw.while) (set! res true) (block))
          (if (eq kw Kw.struct) (set! res true) (block))
          (if (eq kw Kw.match_result) (set! res (call is_void_node cg (call last_child (call nth_child node 2)))) (block))
          ;; an empty (block) is void, like Expr::Block([]) in wasm.rs
          (if (eq kw Kw.block) (set! res (or (eq (call node_next (call first_child node)) (ptr.null compiler.Node)) (call is_void_node cg (call last_child node)))) (block))
          (if (eq kw Kw.if) (set! res (and (call is_void_node cg (call nth_child node 2)) (call is_void_node cg (call nth_child node 3)))) (block))
          (if (eq kw Kw.call) (set! res (call is_void_call cg node)) (block))
          (if (call is_op kw) (set! res (call is_void_op kw)) (block))
          (if (eq kw Kw.cond)
              (block
                (let all_void:bool true)
                (let clause:(ptr compiler.Node) (call nth_child node 1))
                (while (neq clause (ptr.null compiler.Node))
                  (if (call is_void_node cg (call last_child clause)) (block) (set! all_void false))
                  (set! clause (call node_next clause)))
                (set! res all_void))
              (block))
          ;; call_ref is void when its signature returns void (after the generic op rule)
          (if (eq kw Kw.call_ref) (set! res (eq (call type_node_id cg (call nth_child (call nth_child node 1) 3)) Ty.void)) (block))
          res)))

  ;; ===== Struct table & resolution =====
  ;; Index of the last `target` byte in the span, or -1.
  (fn find_last_char [cg:(ptr Cg) pos:i32 len:i32 target:i32] -> i32
    (let found:i32 -1)
    (loop i 0 (- len 1) 1
      (if (eq (mem.load8 (+ (get cg Cg.src) (+ pos i))) target) (set! found i) (block)))
    found)

  ;; Records every (struct ...) of the module with its layout; returns the
  ;; count. Past 255 structs or 64 fields: compile error 94.
  (fn collect_structs [cg:(ptr Cg) root:(ptr compiler.Node)] -> i32
    (let scount:i32 0)
    (let child:(ptr compiler.Node) (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (if (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.struct))
          (block
            (let sname_node:(ptr compiler.Node) (call nth_child child 1))
            (if (gte scount 255) (call set_compile_error CgErr.table_full) 0)
            (let si:(ptr StructInfo) (new StructInfo))
            (put si StructInfo.name_pos (call node_a sname_node))
            (put si StructInfo.name_len (call node_b sname_node))
            (put si StructInfo.fields (arr.new (ptr Field) 64))
            (let cur_offset:i32 0)
            (let max_align:i32 1)
            (let fcount:i32 0)
            (let fchild:(ptr compiler.Node) (call first_child (call nth_child child 2)))
            (while (neq fchild (ptr.null compiler.Node))
              (let type_node:(ptr compiler.Node) (call node_next (call node_next fchild)))
              (if (gte fcount 64) (call set_compile_error CgErr.table_full) 0)
              (let ftype:Ty (call type_node_id cg type_node))
              (if (call is_memory_type ftype) 0 (call set_compile_error CgErr.not_a_memory_type))
              (let fsize:i32 (call type_size ftype))
              (if (gt fsize max_align) (set! max_align fsize) (block))
              (set! cur_offset (bitand (+ cur_offset (- fsize 1)) (- 0 fsize)))
              (let f:(ptr Field) (new Field))
              (put f Field.name_pos (call node_a fchild))
              (put f Field.name_len (call node_b fchild))
              (put f Field.offset cur_offset)
              (put f Field.ty ftype)
              (arr.set (ptr Field) (get si StructInfo.fields) (if (gte fcount 64) 63 fcount) f)
              (set! cur_offset (+ cur_offset fsize))
              (if (lt fcount 64) (set! fcount (+ fcount 1)) (block))
              (if (neq type_node (ptr.null compiler.Node))
                  (set! fchild (call node_next type_node))
                  (set! fchild (ptr.null compiler.Node))))
            (put si StructInfo.size (bitand (+ cur_offset (- max_align 1)) (- 0 max_align)))
            (put si StructInfo.nfields fcount)
            (arr.set (ptr StructInfo) (get cg Cg.structs) (if (gte scount 255) 254 scount) si)
            (if (lt scount 255) (set! scount (+ scount 1)) (block)))
          (block))
      (set! child (call node_next child)))
    (put cg Cg.nstructs scount)
    scount)

  ;; The struct with this name, or null.
  (fn find_struct [cg:(ptr Cg) s_pos:i32 s_len:i32] -> (ptr StructInfo)
    (loop i 0 (- (get cg Cg.nstructs) 1) 1
      (let si:(ptr StructInfo) (arr.get (ptr StructInfo) (get cg Cg.structs) i))
      (if (call sym_eq cg s_pos s_len (+ (get cg Cg.src) (get si StructInfo.name_pos)) (get si StructInfo.name_len))
          (return si)
          (block)))
    (ptr.null StructInfo))

  ;; Field S.f (the first field of that name, as in checker.rs), or null.
  (fn find_field [cg:(ptr Cg) s_pos:i32 s_len:i32 f_pos:i32 f_len:i32] -> (ptr Field)
    (let si:(ptr StructInfo) (call find_struct cg s_pos s_len))
    (if (eq si (ptr.null StructInfo)) (return (ptr.null Field)) (block))
    (loop fj 0 (- (get si StructInfo.nfields) 1) 1
      (let f:(ptr Field) (arr.get (ptr Field) (get si StructInfo.fields) fj))
      (if (call sym_eq cg f_pos f_len (+ (get cg Cg.src) (get f Field.name_pos)) (get f Field.name_len))
          (return f)
          (block)))
    (ptr.null Field))

  (fn get_struct_size [cg:(ptr Cg) s_pos:i32 s_len:i32] -> i32
    (let si:(ptr StructInfo) (call find_struct cg s_pos s_len))
    (if (eq si (ptr.null StructInfo)) (block (call set_compile_error CgErr.unknown_struct_or_field) 0) (get si StructInfo.size)))

  (fn get_field_offset [cg:(ptr Cg) s_pos:i32 s_len:i32 f_pos:i32 f_len:i32] -> i32
    (let f:(ptr Field) (call find_field cg s_pos s_len f_pos f_len))
    (if (eq f (ptr.null Field)) (block (call set_compile_error CgErr.unknown_struct_or_field) 0) (get f Field.offset)))

  ;; The type of field S.f, or Ty.none if unknown.
  (fn get_field_type [cg:(ptr Cg) s_pos:i32 s_len:i32 f_pos:i32 f_len:i32] -> Ty
    (let f:(ptr Field) (call find_field cg s_pos s_len f_pos f_len))
    (if (eq f (ptr.null Field)) Ty.none (get f Field.ty)))

  ;; A bool read from memory is normalised to 0/1 (i32.const 0; i32.ne), as in wasm.rs normalize_bool.
  (fn emit_normalize_bool [ptr:i32] -> i32
    (let n:i32 (call emit_i32_const ptr 0))
    (+ n (call emit_byte (+ ptr n) 71)))

  ;; ===== Compile error signaling =====
  ;; Compile errors (AIPL_SPEC.md 6.4). The host reads the number from cell 4,
  ;; so the values are fixed.
  (enum CgErr [(memory_cap 90)            ;; mem.grow refused: more than 1024 pages
               (output_full 91)           ;; output or a function body passed 4 * src_len + 64 KiB
               (too_many_functions 92)    ;; more than 2048 functions, or 16 parameters
               (too_many_locals 93)       ;; more than 1024 locals in a function
               (table_full 94)            ;; 255 structs, 64 fields, or 31 call_ref signatures
               (not_a_memory_type 95)     ;; a field or element type that is not a scalar
               (unknown_struct_or_field 96)
               (wide_result_payload 97)   ;; an ok/err payload that is not 32-bit
               (unlowerable_type 98)
               (no_instruction_for_type 99) ;; e.g. % on f64, + on str
               (too_deeply_nested 100)    ;; more than 255 nested blocks
               (jump_outside_loop 101)
               (too_many_literals 768)
               (unknown_symbol 971)
               (inexact_float_literal 973)
               (unknown_enum_member 974)
               (unknown_form 987)
               (empty_expression 999)
               (undefined_function 1452)])

  ;; Records the first error only: later errors are usually consequences of it.
  (fn set_compile_error [e:CgErr] -> i32
    (if (eq (mem.load32 4) 0) (mem.store32 4 (enum.ord e)) (block))
    0)

  (fn has_compile_error [] -> bool
    (neq (mem.load32 4) 0))

  ;; mem.alloc that grows linear memory to cover the new block. mem.alloc only
  ;; moves the cursor; without this a large compile walks off the end of
  ;; memory. Sets compile error 90 if the 1024-page cap would be exceeded.
  (fn cg_alloc [n:i32] -> i32
    (let p:i32 (mem.alloc n))
    (let end:i32 (mem.load32 0))
    (let have:i32 (* (mem.grow 0) 65536))
    (if (gt end have)
        (if (eq (mem.grow (+ (/ (- end have) 65536) 1)) -1)
            (call set_compile_error CgErr.memory_cap)
            0)
        0)
    p)

  (fn alloc_src [len:i32] -> i32
    (mem.alloc len))

  ;; ===== String Interning =====
  (fn find_interned_string [cg:(ptr Cg) pos:i32 len:i32] -> i32
    (loop i 0 (- (call get_str_count) 1) 1
      (let entry:i32 (call str_entry_ptr i))
      (let e_pos:i32 (mem.load32 (+ entry 0)))
      (if (and (neq e_pos -1) (call sym_eq cg pos len (+ (get cg Cg.src) e_pos) (mem.load32 (+ entry 4))))
          (return (mem.load32 (+ entry 8)))
          (block)))
    -1)

;; The address of an interned string whose bytes equal the `n` bytes at
  ;; `bytes`, or -1. Each blob string is a 4-byte length, then its bytes; an
  ;; address is 1028 + the offset of its bytes in the blob.
  (fn find_interned_content [bytes:i32 n:i32] -> i32
    (let blob:i32 (call str_blob_buf))
    (let off:i32 0)
    (let end:i32 (call get_str_blob_len))
    (while (lt off end)
      (let k:i32 (mem.load32 (+ blob off)))
      (if (and (eq k n) (call bytes_equal (+ blob (+ off 4)) bytes n))
          (return (+ 1028 off))
          (block))
      (set! off (+ off (+ 4 k))))
    -1)

  (fn bytes_equal [a:i32 b:i32 n:i32] -> bool
    (loop i 0 (- n 1) 1
      (if (neq (mem.load8 (+ a i)) (mem.load8 (+ b i))) (return false) (block)))
    true)

  (fn intern_string [cg:(ptr Cg) pos:i32 len:i32] -> i32
    (let existing:i32 (call find_interned_string cg pos len))
    (if (neq existing -1) (return existing) (block))
    ;; the blob buffer and entry table are full: compile error 768
    (if (or (gt (+ (call get_str_blob_len) (+ 4 len)) 65536) (gte (call get_str_count) 1364))
        (block (call set_compile_error CgErr.too_many_literals) (return 1028))
        (block))
    (let blob_len:i32 (call get_str_blob_len))
    (let addr:i32 (+ 1028 blob_len))
    ;; Decode escapes while writing bytes into str_blob_buf heap memory
    (let write_ptr:i32 (+ (call str_blob_buf) (+ blob_len 4)))
    (let decoded_len:i32 0)
    (let i:i32 0)
    (while (lt i len)
      (let b:i32 (mem.load8 (+ (get cg Cg.src) (+ pos i))))
      (if (and (eq b 92) (lt (+ i 1) len))
          (block
            (let nb:i32 (mem.load8 (+ (get cg Cg.src) (+ pos (+ i 1)))))
            (let esc:i32 nb)
            (cond
              ((eq nb 110) (set! esc 10))
              ((eq nb 116) (set! esc 9))
              ((eq nb 114) (set! esc 13))
              ((eq nb 48) (set! esc 0))
              ((eq nb 92) (set! esc 92))
              ((eq nb 34) (set! esc 34))
              (else (set! esc nb)))
            (mem.store8 (+ write_ptr decoded_len) esc)
            (set! decoded_len (+ decoded_len 1))
            (set! i (+ i 2)))
          (block
            (mem.store8 (+ write_ptr decoded_len) b)
            (set! decoded_len (+ decoded_len 1))
            (set! i (+ i 1)))))
    ;; Literals are interned by content, as wasm.rs string_layout does: if
    ;; these bytes are already in the blob (another spelling of the same
    ;; text, or the newline sys.print reserves), this spelling points there.
    (let same:i32 (call find_interned_content write_ptr decoded_len))
    (if (neq same -1)
        (block
          (let sc:i32 (call get_str_count))
          (let e:i32 (call str_entry_ptr sc))
          (mem.store32 (+ e 0) pos)
          (mem.store32 (+ e 4) len)
          (mem.store32 (+ e 8) same)
          (call set_str_count (+ sc 1))
          (return same))
        (block))
    ;; Store length as 4 LE bytes at blob_ptr in heap memory
    (let blob_ptr:i32 (+ (call str_blob_buf) blob_len))
    (mem.store8 (+ blob_ptr 0) (bitand decoded_len 255))
    (mem.store8 (+ blob_ptr 1) (bitand (shr decoded_len 8) 255))
    (mem.store8 (+ blob_ptr 2) (bitand (shr decoded_len 16) 255))
    (mem.store8 (+ blob_ptr 3) (bitand (shr decoded_len 24) 255))

    (let new_blob_len:i32 (+ blob_len (+ 4 decoded_len)))
    (call set_str_blob_len new_blob_len)

    (let scount:i32 (call get_str_count))
    (let entry:i32 (call str_entry_ptr scount))
    (mem.store32 (+ entry 0) pos)
    (mem.store32 (+ entry 4) len)
    (mem.store32 (+ entry 8) addr)
    (call set_str_count (+ scount 1))
    addr)

  (fn intern_newline [] -> i32
    (if (neq (call get_newline_addr) 0)
        (call get_newline_addr)
        (block
          (let blob_len:i32 (call get_str_blob_len))
          (let addr:i32 (+ 1028 blob_len))
          (let write_ptr:i32 (+ (call str_blob_buf) (+ blob_len 4)))
          (mem.store8 write_ptr 10)
          (let blob_ptr:i32 (+ (call str_blob_buf) blob_len))
          (mem.store8 (+ blob_ptr 0) 1)
          (mem.store8 (+ blob_ptr 1) 0)
          (mem.store8 (+ blob_ptr 2) 0)
          (mem.store8 (+ blob_ptr 3) 0)
          (let new_blob_len:i32 (+ blob_len 5))
          (call set_str_blob_len new_blob_len)
          (let scount:i32 (call get_str_count))
          (let entry:i32 (call str_entry_ptr scount))
          (mem.store32 (+ entry 0) -1)
          (mem.store32 (+ entry 4) 1)
          (mem.store32 (+ entry 8) addr)
          (call set_str_count (+ scount 1))
          (call set_newline_addr addr)
          addr)))

  ;; A wasm name: its length (LEB128), then its bytes. Returns the byte count.
  (fn emit_name [ptr:i32 s:str] -> i32
    (let n:i32 (call compiler.encode_u32 ptr (str.len s)))
    (loop i 0 (- (str.len s) 1) 1
      (mem.store8 (+ ptr (+ n i)) (mem.load8 (+ (str.ptr s) i))))
    (+ n (str.len s)))

  ;; The import name of WASI function w (the order of wasm.rs Wasi).
  (fn wasi_name [w:i32] -> str
    (cond
      ((eq w 0) "fd_write")
      ((eq w 1) "fd_read")
      ((eq w 2) "path_open")
      ((eq w 3) "fd_close")
      ((eq w 4) "proc_exit")
      ((eq w 5) "path_unlink_file")
      ((eq w 6) "args_sizes_get")
      ((eq w 7) "args_get")
      ((eq w 8) "environ_sizes_get")
      ((eq w 9) "environ_get")
      ((eq w 10) "thread-spawn")
      ((eq w 11) "clock_time_get")
      (else "random_get")))

  ;; ===== WASI Import Detection =====
  ;; WASI import table, 11 words at struct_table + 12, in the fixed import
  ;; order (wasm.rs enum Wasi): fd_write, fd_read, path_open, fd_close,
  ;; proc_exit, path_unlink_file, args_sizes_get, args_get,
  ;; environ_sizes_get, environ_get, wasi-threads' thread-spawn (10),
  ;; clock_time_get (11), random_get (12).
  ;; 1 while marking used, then the function index, or -1 if unused.
  (fn wasi_cell [wasi_id:i32] -> i32
    (+ (mem.load32 (+ (call struct_table) 12)) (* wasi_id 4)))

  (fn mark_wasi_used [wasi_id:i32] -> i32
    (mem.store32 (call wasi_cell wasi_id) 1)
    0)

  (fn finalize_wasi_indices [] -> i32
    (let count:i32 0)
    (let i:i32 0)
    (while (lt i 13)
      (let cell_idx:i32 (call wasi_cell i))
      (if (eq (mem.load32 cell_idx) 1)
          (block
            (mem.store32 cell_idx count)
            (set! count (+ count 1))
            0)
          (block
            (mem.store32 cell_idx -1)
            0))
      (set! i (+ i 1)))
    (mem.store32 32 count)
    count)

  (fn get_wasi_index [wasi_id:i32] -> i32
    (mem.load32 (call wasi_cell wasi_id)))

  ;; A module that uses thread.spawn is threaded (wasm.rs `threaded`).
  (fn threaded [] -> bool
    (neq (call get_wasi_index 10) -1))

  ;; ===== AST Walker for WASI & Strings =====
  (fn walk_ast_for_wasi [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (let kind:compiler.Kind (call node_kind node))
    (if (eq kind compiler.Kind.paren)
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (cond
            ((eq kw Kw.sys_print) (call mark_wasi_used 0) 0)
            ((eq kw Kw.sys_exit) (call mark_wasi_used 4) 0)
            ((eq kw Kw.fs_open) (call mark_wasi_used 2) 0)
            ((eq kw Kw.fs_read) (call mark_wasi_used 1) 0)
            ((eq kw Kw.fs_write) (call mark_wasi_used 0) 0)
            ((eq kw Kw.fs_close) (call mark_wasi_used 3) 0)
            ((eq kw Kw.fs_delete) (call mark_wasi_used 5) 0)
            ((eq kw Kw.args_sizes) (call mark_wasi_used 6) 0)
            ((eq kw Kw.args_get) (call mark_wasi_used 7) 0)
            ((eq kw Kw.env_sizes) (call mark_wasi_used 8) 0)
            ((eq kw Kw.env_get) (call mark_wasi_used 9) 0)
            ((eq kw Kw.thread_spawn) (call mark_wasi_used 10) 0)
            ((or (eq kw Kw.sys_time) (eq kw Kw.sys_monotonic)) (call mark_wasi_used 11) 0)
            ((eq kw Kw.sys_random) (call mark_wasi_used 12) 0)
            (else 0))
          (let child:(ptr compiler.Node) (call first_child node))
          (while (neq child (ptr.null compiler.Node)) (call walk_ast_for_wasi cg child) (set! child (call node_next child)))
          0)
        0))

  (fn walk_ast_for_strings [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (let kind:compiler.Kind (call node_kind node))
    (if (eq kind compiler.Kind.string)
        (call intern_string cg (call node_a node) (call node_b node))
        (if (eq kind compiler.Kind.paren)
            (block
              (let child:(ptr compiler.Node) (call first_child node))
              (while (neq child (ptr.null compiler.Node)) (call walk_ast_for_strings cg child) (set! child (call node_next child)))
              0)
            0)))

  ;; Encodes a (fn [..] -> r) type node as [nparams, valtypes..., nresults, result]
  ;; at out (wasm-level, so (fn [bool] -> i32) and (fn [i32] -> i32) coincide).
  (fn encode_sig [cg:(ptr Cg) sig:(ptr compiler.Node) out:i32] -> i32
    (let n:i32 0)
    (let p:(ptr compiler.Node) (call first_child (call nth_child sig 1)))
    (while (neq p (ptr.null compiler.Node))
      (if (lt n 16) (mem.store8 (+ out (+ 1 n)) (call type_id_to_valtype (call type_node_id cg p))) (block (call set_compile_error CgErr.too_many_functions) (block)))
      (set! n (+ n 1))
      (set! p (call node_next p)))
    (mem.store8 out n)
    (let ret:Ty (call type_node_id cg (call nth_child sig 3)))
    (if (eq ret Ty.void)
        (mem.store8 (+ out (+ 1 n)) 0)
        (block
          (mem.store8 (+ out (+ 1 n)) 1)
          (mem.store8 (+ out (+ 2 n)) (call type_id_to_valtype ret))))
    0)

  ;; Index of the signature of a call_ref's type node, adding it if new.
  (fn sig_index [cg:(ptr Cg) sig:(ptr compiler.Node)] -> i32
    (let tmp:i32 (call ref_sig_ptr 32))
    ;; clear the 20-byte buffer: a shorter signature must not keep the tail of
    ;; a longer earlier one, or identical signatures would not compare equal
    (loop b 0 19 1 (mem.store8 (+ tmp b) 0))
    (call encode_sig cg sig tmp)
    (call add_sig_from_tmp))

  ;; Index of the signature in the scratch buffer, adding it if new.
  (fn add_sig_from_tmp [] -> i32
    (let tmp:i32 (call ref_sig_ptr 32))
    (let count:i32 (mem.load32 (+ (call ref_state) 4)))
    (loop i 0 (- count 1) 1
      (let same:bool true)
      (loop b 0 19 1
        (if (neq (mem.load8 (+ (call ref_sig_ptr i) b)) (mem.load8 (+ tmp b))) (set! same false) (block)))
      (if same (return i) (block)))
    ;; 32 signatures fit the 1024-byte ref state (8 + 32 x 20 bytes)
    (if (gte count 31) (call set_compile_error CgErr.table_full) 0)
    (loop b 0 19 1 (mem.store8 (+ (call ref_sig_ptr count) b) (mem.load8 (+ tmp b))))
    (mem.store32 (+ (call ref_state) 4) (+ count 1))
    count)

  ;; Threaded modules call workers through the table as (fn [i32] -> i32);
  ;; registered after the walk, as wasm.rs appends it. Returns its index.
  (fn worker_sig_index [] -> i32
    (let tmp:i32 (call ref_sig_ptr 32))
    (loop b 0 19 1 (mem.store8 (+ tmp b) 0))
    (mem.store8 tmp 1)
    (mem.store8 (+ tmp 1) 127)
    (mem.store8 (+ tmp 2) 1)
    (mem.store8 (+ tmp 3) 127)
    (call add_sig_from_tmp))

  ;; Marks the module as using function refs and collects call_ref signatures
  ;; in source order, as wasm.rs walk_module does.
  (fn walk_ast_for_refs [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (if (eq (call node_kind node) compiler.Kind.paren)
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (if (or (eq kw Kw.ref) (eq kw Kw.call_ref)) (mem.store32 (call ref_state) 1) (block))
          (if (eq kw Kw.call_ref) (call sig_index cg (call nth_child node 1)) 0)
          (let child:(ptr compiler.Node) (call first_child node))
          (while (neq child (ptr.null compiler.Node))
            (call walk_ast_for_refs cg child)
            (set! child (call node_next child)))
          0)
        0))

  (fn walk_module_prepass [cg:(ptr Cg) root:(ptr compiler.Node)] -> i32
    ;; Pass 1: WASI detection
    (let child:(ptr compiler.Node) (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (if (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.fn))
          (block
            (let bchild:(ptr compiler.Node) (call nth_child child 5))
            (while (neq bchild (ptr.null compiler.Node))
              (call walk_ast_for_wasi cg bchild)
              (set! bchild (call node_next bchild))))
          (block))
      (set! child (call node_next child)))

    (call finalize_wasi_indices)

    ;; Pass 2: Intern newline if sys.print is present and fd_write used
    (if (and (neq (call get_wasi_index 0) -1) (call ast_uses_sys_print cg root))
        (block (call intern_newline) 0)
        0)

    ;; Pass 3: Intern string literals
    (set! child (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (if (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.fn))
          (block
            (let bchild:(ptr compiler.Node) (call nth_child child 5))
            (while (neq bchild (ptr.null compiler.Node))
              (call walk_ast_for_strings cg bchild)
              (call walk_ast_for_refs cg bchild)
              (set! bchild (call node_next bchild))))
          (block))
      (set! child (call node_next child)))
    0)

  (fn ast_uses_sys_print [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (if (neq (call node_kind node) compiler.Kind.paren)
        false
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (if (eq kw Kw.sys_print)
              true
              (block
                (let child:(ptr compiler.Node) (call first_child node))
                (let found:bool false)
                (while (neq child (ptr.null compiler.Node))
                  (if (call ast_uses_sys_print cg child)
                      (set! found true)
                      (block))
                  (set! child (call node_next child)))
                found)))))

  ;; Ops whose lowering uses the two extra scratch locals (wasm.rs
  ;; fn_uses_io): the WASI ops, arr.new, thread.spawn, and the atomics that
  ;; wait or compare.
  (fn needs_io_scratch [k:Kw] -> bool
    (cond
      ((or (eq k Kw.sys_print) (or (eq k Kw.sys_exit) (or (eq k Kw.fs_open) (or (eq k Kw.fs_read)
          (or (eq k Kw.fs_write) (or (eq k Kw.fs_close) (eq k Kw.fs_delete))))))) true)
      ((or (eq k Kw.args_sizes) (or (eq k Kw.args_get) (or (eq k Kw.env_sizes) (or (eq k Kw.env_get) (eq k Kw.thread_spawn))))) true)
      ((or (eq k Kw.arr_new) (or (eq k Kw.atomic_cas) (or (eq k Kw.atomic_lock) (eq k Kw.atomic_unlock)))) true)
      (else (or (eq k Kw.sys_time) (or (eq k Kw.sys_monotonic) (eq k Kw.sys_random))))))

  ;; Check if function uses I/O ops
  (fn ast_uses_io [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (if (neq (call node_kind node) compiler.Kind.paren)
        false
        (block
          (if (call needs_io_scratch (call group_head_keyword cg node))
              true
              (block
                (let child:(ptr compiler.Node) (call first_child node))
                (let found:bool false)
                (while (neq child (ptr.null compiler.Node))
                  (if (call ast_uses_io cg child)
                      (set! found true)
                      (block))
                  (set! child (call node_next child)))
                found)))))

  (fn fn_uses_io [cg:(ptr Cg) fndef_group:(ptr compiler.Node)] -> bool
    (let bchild:(ptr compiler.Node) (call nth_child fndef_group 5))
    (let found:bool false)
    (while (neq bchild (ptr.null compiler.Node))
      (if (call ast_uses_io cg bchild)
          (set! found true)
          (block))
      (set! bchild (call node_next bchild)))
    found)

  ;; Payload of (ok v) / (err e), skipping the `: T` of (ok:T v) / (err:T e).
  (fn result_payload [node:(ptr compiler.Node)] -> (ptr compiler.Node)
    (if (eq (call node_kind (call nth_child node 1)) compiler.Kind.colon)
        (call nth_child node 3)
        (call nth_child node 1)))

  ;; ===== Static expression types (mirrors expr_type in wasm.rs) =====
  (fn node_type [cg:(ptr Cg) node:(ptr compiler.Node)] -> Ty
    (let kind:compiler.Kind (call node_kind node))
    (let res:Ty Ty.i32)
    (if (eq kind compiler.Kind.bool) (set! res Ty.bool) (block))
    (if (eq kind compiler.Kind.string) (set! res Ty.str) (block))
    (if (eq kind compiler.Kind.int64) (set! res Ty.i64) (block))
    (if (eq kind compiler.Kind.float) (set! res Ty.f64) (block))
    (if (eq kind compiler.Kind.symbol)
        (block
          (let idx:i32 (call find_local cg (call node_a node) (call node_b node)))
          (if (neq idx -1) (set! res (get (call local_at cg idx) Local.ty)) (block)))
        (block))
    (if (eq kind compiler.Kind.paren) (set! res (call group_type cg node)) (block))
    res)

  ;; Type of the last expression of a body starting at `first` (void if empty).
  (fn body_type [cg:(ptr Cg) first:(ptr compiler.Node)] -> Ty
    (if (eq first (ptr.null compiler.Node))
        Ty.void
        (block
          (let cur:(ptr compiler.Node) first)
          (while (neq (call node_next cur) (ptr.null compiler.Node)) (set! cur (call node_next cur)))
          (call node_type cg cur))))

  (fn group_type [cg:(ptr Cg) node:(ptr compiler.Node)] -> Ty
    (let kw:Kw (call group_head_keyword cg node))
    (let res:Ty Ty.i32)
    ;; let, set!, loop, while, put, arr.set, stores, sys.print, sys.exit
    (if (or (eq kw Kw.let) (or (eq kw Kw.set) (or (eq kw Kw.loop) (or (eq kw Kw.while) (or (eq kw Kw.put) (eq kw Kw.arr_set))))))
        (set! res Ty.void) (block))
    (if (or (eq kw Kw.mem_store8) (or (eq kw Kw.mem_store32) (or (eq kw Kw.mem_store64) (or (eq kw Kw.sys_print) (eq kw Kw.sys_exit))))) (set! res Ty.void) (block))
    ;; return, break, continue are statements
    (if (call is_jump kw) (set! res Ty.void) (block))
    ;; cond: the type of its first clause's body (the desugared if's then branch)
    (if (eq kw Kw.cond) (set! res (call body_type cg (call node_next (call first_child (call nth_child node 1))))) (block))
    (if (eq kw Kw.if) (set! res (call node_type cg (call nth_child node 2))) (block))
    (if (eq kw Kw.block) (set! res (call body_type cg (call node_next (call first_child node)))) (block))
    (if (eq kw Kw.match_result)
        (set! res (call body_type cg (call node_next (call node_next (call first_child (call nth_child node 2))))))
        (block))
    (if (eq kw Kw.call)
        (block
          (let fname:(ptr compiler.Node) (call nth_child node 1))
          (let fidx:i32 (call find_function cg (call node_a fname) (call node_b fname)))
          (if (neq fidx -1) (set! res (get (call func_entry_ptr cg fidx) FnInfo.ret)) (block)))
        (block))
    ;; ok / err: the payload's type, as expr_type does
    (if (or (eq kw Kw.ok) (eq kw Kw.err)) (set! res (call node_type cg (call result_payload node))) (block))
    (if (eq kw Kw.get)
        (block
          (let sf_node:(ptr compiler.Node) (call nth_child node 2))
          (let sf_pos:i32 (call node_a sf_node))
          (let sf_len:i32 (call node_b sf_node))
          (let dot_idx:i32 (call find_last_char cg sf_pos sf_len 46))
          (let ft:Ty (call get_field_type cg sf_pos dot_idx (+ sf_pos (+ dot_idx 1)) (- sf_len (+ dot_idx 1))))
          (if (neq ft Ty.none) (set! res ft) (block)))
        (block))
    (if (eq kw Kw.arr_get) (set! res (call type_node_id cg (call nth_child node 1))) (block))
    ;; arithmetic and bitwise: the first operand's type
    (if (call is_arith kw)
        (set! res (call node_type cg (call nth_child node 1)))
        (block))
    ;; comparisons and logic
    (if (call is_compare kw) (set! res Ty.bool) (block))
    ;; mem.load64, i64.extend_s, i64.extend_u, i64.trunc_f64_s, i64.reinterpret_f64
    (if (or (eq kw Kw.mem_load64) (or (eq kw Kw.i64_extend_s) (or (eq kw Kw.i64_extend_u) (or (eq kw Kw.i64_trunc_f64_s) (eq kw Kw.i64_reinterpret_f64))))) (set! res Ty.i64) (block))
    (if (eq kw Kw.ref) (set! res Ty.fn) (block))
    ;; sys.time / sys.monotonic -> i64
    (if (or (eq kw Kw.sys_time) (eq kw Kw.sys_monotonic)) (set! res Ty.i64) (block))
    ;; atomic.cas -> bool; atomic.lock / unlock are statements
    (if (eq kw Kw.atomic_cas) (set! res Ty.bool) (block))
    (if (or (eq kw Kw.atomic_lock) (eq kw Kw.atomic_unlock)) (set! res Ty.void) (block))
    (if (eq kw Kw.call_ref) (set! res (call type_node_id cg (call nth_child (call nth_child node 1) 3))) (block))
    ;; new, ptr.null, ptr.cast -> (ptr S); arr.new, arr.null, arr.cast -> (arr T)
    (if (or (eq kw Kw.new) (or (eq kw Kw.ptr_null) (eq kw Kw.ptr_cast))) (set! res Ty.ptr) (block))
    (if (or (eq kw Kw.arr_new) (or (eq kw Kw.arr_null) (eq kw Kw.arr_cast))) (set! res Ty.arr) (block))
    ;; f64.convert_i64_s, f64.reinterpret_i64, f64.sqrt
    (if (or (eq kw Kw.f64_convert_i64_s) (or (eq kw Kw.f64_reinterpret_i64) (eq kw Kw.f64_sqrt))) (set! res Ty.f64) (block))
    res)

  ;; ===== Expression / statement codegen =====
  (fn compile_expr [cg:(ptr Cg) node:(ptr compiler.Node) out_ptr:i32] -> i32
    (if (eq node (ptr.null compiler.Node))
        (block
          (let _e:i32 (call set_compile_error CgErr.empty_expression))
          0)
        (block
          (let kind:compiler.Kind (call node_kind node))
          (cond
            ((eq kind compiler.Kind.int) (call emit_i32_const out_ptr (call node_a node)))
            ((eq kind compiler.Kind.bool) (call emit_i32_const out_ptr (call node_a node)))
            ((eq kind compiler.Kind.int64) (call emit_byte out_ptr 66)
                (+ 1 (call encode_s64 (+ out_ptr 1) (call parse_i64_literal cg (call node_a node) (call node_b node)))))
            ((eq kind compiler.Kind.float) (call emit_f64_literal out_ptr cg (call node_a node) (call node_b node)))
            ((eq kind compiler.Kind.string) (let addr:i32 (call find_interned_string cg (call node_a node) (call node_b node)))
                (call emit_i32_const out_ptr addr))
            ((eq kind compiler.Kind.symbol) (let idx:i32 (call find_local cg (call node_a node) (call node_b node)))
                (if (eq idx -1)
                    (block
                      (let _e:i32 (call set_compile_error CgErr.unknown_symbol))
                      (call emit_i32_const out_ptr 0))
                    (call emit_local_get out_ptr idx)))
            (else (call compile_group cg node out_ptr))))))

  (fn compile_group [cg:(ptr Cg) node:(ptr compiler.Node) out_ptr:i32] -> i32
    (let kw:Kw (call group_head_keyword cg node))
    (let head_node:i32 (call node_a node))
    (cond
      ((eq kw Kw.let) (call compile_let cg node out_ptr))
      ((eq kw Kw.set) (call compile_set cg node out_ptr))
      ((eq kw Kw.if) (call compile_if cg node out_ptr))
      ((eq kw Kw.loop) (call compile_loop cg node out_ptr))
      ((eq kw Kw.while) (call compile_while cg node out_ptr))
      ((eq kw Kw.call) (call compile_call cg node out_ptr))
      ((eq kw Kw.block) (call compile_block cg node out_ptr))
      ((eq kw Kw.match_result) (call compile_match_result cg node out_ptr))
      ((eq kw Kw.cond) (call compile_cond_from cg (call nth_child node 1) out_ptr))
      ((neq kw Kw.none) (call compile_op cg kw node out_ptr))
      (else (let _e:i32 (call set_compile_error CgErr.unknown_form))
          (call emit_i32_const out_ptr 0))))

  (fn compile_match_result [cg:(ptr Cg) node:(ptr compiler.Node) out_ptr:i32] -> i32
    (let expr_node:(ptr compiler.Node) (call nth_child node 1))
    (let ok_group:(ptr compiler.Node) (call nth_child node 2))
    (let err_group:(ptr compiler.Node) (call nth_child node 3))
    (let scratch:i32 (get cg Cg.nlocals))
    (let off:i32 0)
    (set! off (+ off (call compile_expr cg expr_node (+ out_ptr off))))
    (set! off (+ off (call emit_local_set (+ out_ptr off) scratch)))
    (set! off (+ off (call emit_local_get (+ out_ptr off) scratch)))
    (set! off (+ off (call emit_memop (+ out_ptr off) 40 2)))
    (mem.store8 (+ out_ptr off) 69) (set! off (+ off 1))
    (let ok_last:(ptr compiler.Node) (call last_child ok_group))
    (let is_void:bool (call is_void_node cg ok_last))
    (let block_ty:i32 64)
    (if is_void (set! block_ty 64) (set! block_ty (call block_type_byte (call node_type cg ok_last))))
    (mem.store8 (+ out_ptr off) 4)
    (mem.store8 (+ out_ptr (+ off 1)) block_ty)
    (set! off (+ off 2))
    (call label_push 0)
    (let ok_var_node:(ptr compiler.Node) (call nth_child ok_group 1))
    (let ok_var_idx:i32 (call find_local cg (call node_a ok_var_node) (call node_b ok_var_node)))
    (if (neq ok_var_idx -1)
        (block
          (set! off (+ off (call emit_local_get (+ out_ptr off) scratch)))
          (set! off (+ off (call emit_memop_offset (+ out_ptr off) 40 2 4)))
          (set! off (+ off (call emit_local_set (+ out_ptr off) ok_var_idx)))
          0)
        0)
    (let ok_body_first:(ptr compiler.Node) (call node_next (call node_next (call first_child ok_group))))
    (set! off (+ off (call compile_stmt_seq cg ok_body_first (+ out_ptr off))))
    (mem.store8 (+ out_ptr off) 5) (set! off (+ off 1))
    (let err_var_node:(ptr compiler.Node) (call nth_child err_group 1))
    (let err_var_idx:i32 (call find_local cg (call node_a err_var_node) (call node_b err_var_node)))
    (if (neq err_var_idx -1)
        (block
          (set! off (+ off (call emit_local_get (+ out_ptr off) scratch)))
          (set! off (+ off (call emit_memop_offset (+ out_ptr off) 40 2 4)))
          (set! off (+ off (call emit_local_set (+ out_ptr off) err_var_idx)))
          0)
        0)
    (let err_body_first:(ptr compiler.Node) (call node_next (call node_next (call first_child err_group))))
    (set! off (+ off (call compile_stmt_seq cg err_body_first (+ out_ptr off))))
    (call label_pop)
    (mem.store8 (+ out_ptr off) 11) (set! off (+ off 1))
    off)

  ;; Emit errno to result helper
  ;; The address of runtime cell `cell` (64..88), as wasm.rs emit_rt: the fixed
  ;; cell, or in a threaded module global 0 (this thread's scratch block) plus
  ;; the cell's offset.
  (fn emit_rt [ptr:i32 cell:i32] -> i32
    (if (call threaded)
        (block
          (let off:i32 (call emit_byte ptr 35)) ;; global.get 0
          (set! off (+ off (call emit_byte (+ ptr off) 0)))
          (if (neq cell 64)
              (block
                (set! off (+ off (call emit_i32_const (+ ptr off) (- cell 64))))
                (set! off (+ off (call emit_byte (+ ptr off) 106))))
              (block))
          off)
        (call emit_i32_const ptr cell)))

  (fn emit_errno_to_result [out_ptr:i32 out_cell:i32] -> i32
    (let off:i32 0)
    (mem.store8 (+ out_ptr off) 4)
    (mem.store8 (+ out_ptr (+ off 1)) 127)
    (set! off (+ off 2))
    (set! off (+ off (call emit_i32_const (+ out_ptr off) -1)))
    (mem.store8 (+ out_ptr off) 5)
    (set! off (+ off 1))
    (if (gte out_cell 0)
        (block
          (set! off (+ off (call emit_rt (+ out_ptr off) out_cell)))
          (set! off (+ off (call emit_memop (+ out_ptr off) 40 2))))
        (set! off (+ off (call emit_i32_const (+ out_ptr off) 0))))
    (mem.store8 (+ out_ptr off) 11)
    (set! off (+ off 1))
    off)

  (fn compile_op [cg:(ptr Cg) op_id:Kw node:(ptr compiler.Node) out_ptr:i32] -> i32
    (let import_cnt:i32 (mem.load32 32))
    (let io_a:i32 (+ (get cg Cg.nlocals) 1))
    (let io_b:i32 (+ (get cg Cg.nlocals) 2))
    (let res:i32 -1)

    (if (eq op_id Kw.mem_load8)
        (block (let n1:i32 (call compile_expr cg (call nth_child node 1) out_ptr)) (set! res (+ n1 (call emit_memop (+ out_ptr n1) 45 0))))
        (block))
    (if (eq op_id Kw.mem_load32)
        (block (let n1:i32 (call compile_expr cg (call nth_child node 1) out_ptr)) (set! res (+ n1 (call emit_memop (+ out_ptr n1) 40 2))))
        (block))
    (if (eq op_id Kw.mem_load64)
        (block (let n1:i32 (call compile_expr cg (call nth_child node 1) out_ptr)) (set! res (+ n1 (call emit_memop (+ out_ptr n1) 41 3))))
        (block))
    (if (eq op_id Kw.mem_store8)
        (block (let n1:i32 (call compile_expr cg (call nth_child node 1) out_ptr)) (let g:i32 (call emit_store_guard (+ out_ptr n1) (get cg Cg.nlocals))) (let n2:i32 (call compile_expr cg (call nth_child node 2) (+ out_ptr (+ n1 g)))) (set! res (+ (+ n1 (+ g n2)) (call emit_memop (+ out_ptr (+ n1 (+ g n2))) 58 0))))
        (block))
    (if (eq op_id Kw.mem_store32)
        (block (let n1:i32 (call compile_expr cg (call nth_child node 1) out_ptr)) (let g:i32 (call emit_store_guard (+ out_ptr n1) (get cg Cg.nlocals))) (let n2:i32 (call compile_expr cg (call nth_child node 2) (+ out_ptr (+ n1 g)))) (set! res (+ (+ n1 (+ g n2)) (call emit_memop (+ out_ptr (+ n1 (+ g n2))) 54 2))))
        (block))
    (if (eq op_id Kw.mem_store64)
        (block (let n1:i32 (call compile_expr cg (call nth_child node 1) out_ptr)) (let g:i32 (call emit_store_guard (+ out_ptr n1) (get cg Cg.nlocals))) (let n2:i32 (call compile_expr cg (call nth_child node 2) (+ out_ptr (+ n1 g)))) (set! res (+ (+ n1 (+ g n2)) (call emit_memop (+ out_ptr (+ n1 (+ g n2))) 55 3))))
        (block))
    (if (eq op_id Kw.not)
        (block (let n1:i32 (call compile_expr cg (call nth_child node 1) out_ptr)) (set! res (+ n1 (call emit_byte (+ out_ptr n1) 69))))
        (block))
    (if (eq op_id Kw.str_len) ;; str.len -> i32.const 4, i32.sub, i32.load
        (block
          (let n1:i32 (call compile_expr cg (call nth_child node 1) out_ptr))
          (let off:i32 n1)
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 4)))
          (mem.store8 (+ out_ptr off) 107) ;; i32.sub
          (set! off (+ off 1))
          (set! off (+ off (call emit_memop (+ out_ptr off) 40 2)))
          (set! res off))
        (block))
    (if (eq op_id Kw.str_ptr) ;; str.ptr -> identity
        (set! res (call compile_expr cg (call nth_child node 1) out_ptr))
        (block))
    (if (eq op_id Kw.sys_print) ;; sys.print
        (block
          (let off:i32 0)
          (let arg:(ptr compiler.Node) (call node_next (call first_child node)))
          (while (neq arg (ptr.null compiler.Node))
            (set! off (+ off (call compile_expr cg arg (+ out_ptr off))))
            (set! off (+ off (call emit_local_set (+ out_ptr off) (get cg Cg.nlocals))))
            ;; iov0 = { ptr, len }
            (set! off (+ off (call emit_rt (+ out_ptr off) 64)))
            (set! off (+ off (call emit_local_get (+ out_ptr off) (get cg Cg.nlocals))))
            (set! off (+ off (call emit_memop (+ out_ptr off) 54 2)))
            (set! off (+ off (call emit_rt (+ out_ptr off) 68)))
            (set! off (+ off (call emit_local_get (+ out_ptr off) (get cg Cg.nlocals))))
            (set! off (+ off (call emit_i32_const (+ out_ptr off) 4)))
            (mem.store8 (+ out_ptr off) 107) (set! off (+ off 1)) ;; sub
            (set! off (+ off (call emit_memop (+ out_ptr off) 40 2))) ;; load
            (set! off (+ off (call emit_memop (+ out_ptr off) 54 2)))
            ;; iov1 = { "\n", 1 }
            (let nl_addr:i32 (call get_newline_addr))
            (set! off (+ off (call emit_rt (+ out_ptr off) 72)))
            (set! off (+ off (call emit_i32_const (+ out_ptr off) nl_addr)))
            (set! off (+ off (call emit_memop (+ out_ptr off) 54 2)))
            (set! off (+ off (call emit_rt (+ out_ptr off) 76)))
            (set! off (+ off (call emit_i32_const (+ out_ptr off) 1)))
            (set! off (+ off (call emit_memop (+ out_ptr off) 54 2)))
            ;; Call fd_write (1, iovs=64, iovs_len=1, nwritten=80)
            (set! off (+ off (call emit_i32_const (+ out_ptr off) 1)))
            (set! off (+ off (call emit_rt (+ out_ptr off) 64)))
            (set! off (+ off (call emit_i32_const (+ out_ptr off) 1)))
            (set! off (+ off (call emit_rt (+ out_ptr off) 80)))
            (set! off (+ off (call emit_call (+ out_ptr off) (call get_wasi_index 0))))
            (set! off (+ off (call emit_byte (+ out_ptr off) 26))) ;; drop
            ;; Call fd_write (1, iovs=72, iovs_len=1, nwritten=80)
            (set! off (+ off (call emit_i32_const (+ out_ptr off) 1)))
            (set! off (+ off (call emit_rt (+ out_ptr off) 72)))
            (set! off (+ off (call emit_i32_const (+ out_ptr off) 1)))
            (set! off (+ off (call emit_rt (+ out_ptr off) 80)))
            (set! off (+ off (call emit_call (+ out_ptr off) (call get_wasi_index 0))))
            (set! off (+ off (call emit_byte (+ out_ptr off) 26))) ;; drop
            
            (set! arg (call node_next arg)))
          (set! res off))
        (block))
    (if (eq op_id Kw.sys_exit) ;; sys.exit
        (block
          (let n1:i32 (call compile_expr cg (call nth_child node 1) out_ptr))
          (set! res (+ n1 (call emit_call (+ out_ptr n1) (call get_wasi_index 4)))))
        (block))
    (if (eq op_id Kw.fs_open) ;; fs.open (path_ptr, path_len, flags)
        (block
          (let off:i32 0)
          (set! off (+ off (call compile_expr cg (call nth_child node 1) (+ out_ptr off))))
          (set! off (+ off (call compile_expr cg (call nth_child node 2) (+ out_ptr off))))
          (set! off (+ off (call compile_expr cg (call nth_child node 3) (+ out_ptr off))))
          (set! off (+ off (call emit_local_set (+ out_ptr off) io_b)))
          (set! off (+ off (call emit_local_set (+ out_ptr off) io_a)))
          (set! off (+ off (call emit_local_set (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_path_dir (+ out_ptr off) (get cg Cg.nlocals) io_a)))
          ;; dirflags = 0
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 0)))
          (set! off (+ off (call emit_local_get (+ out_ptr off) (get cg Cg.nlocals))))
          (set! off (+ off (call emit_local_get (+ out_ptr off) io_a)))
          ;; oflags
          (set! off (+ off (call emit_local_get (+ out_ptr off) io_b)))
          (mem.store8 (+ out_ptr off) 4) (mem.store8 (+ out_ptr (+ off 1)) 127) (set! off (+ off 2)) ;; if(i32)
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 9))) ;; CREAT|TRUNC (1|8 = 9)
          (mem.store8 (+ out_ptr off) 5) (set! off (+ off 1)) ;; else
          (set! off (+ off (call emit_i32_const (+ out_ptr off) 0)))
          (mem.store8 (+ out_ptr off) 11) (set! off (+ off 1)) ;; end
          ;; fs_rights_base (i64)
