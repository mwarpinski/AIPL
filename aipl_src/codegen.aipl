        (and (eq e0_pcount 2) (and (eq e0_ret 200) (and (eq e0_p0 200) (and (eq e0_p1 200) (and (eq e0_name0 97)
        (and (eq e1_pcount 1) (and (eq e1_ret 200)
        (and (eq local_count 4)
        (and (eq l0_name 120) (and (eq l1_name 121) (and (eq l2_name 122) (and (eq l3_name 105) (eq l3_type 200))))))))))))))
        1
