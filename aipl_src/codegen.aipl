;; AIPL Self-Hosted Code Generator: generic S-expression tree (from
;; compiler.tokenize + compiler.parse_ast) -> real WebAssembly bytes.
;;
;; Scope matches src/compiler/wasm.rs byte-for-byte.

(module codegen
  (import compiler)
  (import consts)
  (import str)
  (import buf)
  (import strmap)

  ;; ===== Generic byte-span comparison =====
  (fn sym_eq [cg:(ptr Cg) pos:i32 len:i32 lit_ptr:i32 lit_len:i32] -> bool
    (if (neq len lit_len) (return false) (block))
    (loop i 0 (- len 1) 1
      (if (neq (mem.load8 (+ (get cg Cg.src) (+ pos i))) (mem.load8 (+ lit_ptr i))) (return false) (block)))
    true)

  ;; ===== Node accessors (see compiler.aipl for the tree layout) =====
  (fn node_kind [node:(ptr compiler.Node)] -> compiler.Kind
    (if (eq node (ptr.null compiler.Node)) compiler.Kind.none (get node compiler.Node.kind)))
  ;; An atom's value: an integer literal's value, or the source offset of a
  ;; symbol, string, or i64/float literal (compiler.aipl). A group's is its
  ;; first child's address: use first_child.
  (fn node_a [node:(ptr compiler.Node)] -> i32 (if (eq node (ptr.null compiler.Node)) 0 (get node compiler.Node.a)))
  (fn node_b [node:(ptr compiler.Node)] -> i32 (if (eq node (ptr.null compiler.Node)) 0 (get node compiler.Node.b)))
  (fn node_next [node:(ptr compiler.Node)] -> (ptr compiler.Node)
    (if (eq node (ptr.null compiler.Node)) node (get node compiler.Node.next)))
  (fn first_child [group:(ptr compiler.Node)] -> (ptr compiler.Node)
    (if (eq group (ptr.null compiler.Node)) group (ptr.cast compiler.Node (get group compiler.Node.a))))

  (fn nth_child [group:(ptr compiler.Node) n:i32] -> (ptr compiler.Node)
    (req (gte n 0))
    (let cur:(ptr compiler.Node) (call first_child group))
    (let i:i32 0)
    (while (lt i n)
      (set! cur (call node_next cur))
      (set! i (+ i 1)))
    cur)

  ;; ===== The compile =====
  ;; What every compile function needs, passed as one value: the source text,
  ;; the locals of the function being compiled, and the module's functions.
  ;; (The tables are still raw memory; docs/CODEGEN_REWRITE.md CR6.)
  (struct Cg [src:i32 locals:(arr (ptr Local)) nlocals:i32 fns:(arr (ptr FnInfo)) nfns:i32
              structs:(arr (ptr StructInfo)) nstructs:i32
              wasi:(arr i32) nimports:i32 labels:(arr Label) nlabels:i32
              uses_refs:bool sigs:(arr (ptr Sig)) nsigs:i32
              strs:(arr (ptr StrLit)) nstrs:i32 blob:(ptr buf.Buf) newline:i32])

  ;; A string literal's spelling (a span of the source; pos -1 for the
  ;; newline sys.print reserves) and the address of its interned bytes. The
  ;; blob holds every distinct literal as [len u32 LE][bytes], in first-use
  ;; order; it becomes the data segment at 1024, so an address is 1028 + the
  ;; offset of the bytes in the blob.
  (struct StrLit [pos:i32 len:i32 addr:i32])

  ;; A call_ref signature as wasm sees it: parameter value-type bytes and an
  ;; optional result (so (fn [bool] -> i32) and (fn [i32] -> i32) coincide).
  (struct Sig [nparams:i32 params:(arr i32) has_result:bool result:i32])

  ;; The WASI functions a module may import, in the fixed import order of
  ;; wasm.rs enum Wasi.
  (enum Wasi [(none -1) fd_write fd_read path_open fd_close proc_exit path_unlink_file
              args_sizes_get args_get environ_sizes_get environ_get thread_spawn
              clock_time_get random_get])

  ;; A struct of the module and its layout (checker.rs get_field_offset):
  ;; fields in declaration order, each aligned to its size.
  (struct StructInfo [name_pos:i32 name_len:i32 size:i32 fields:(arr (ptr Field)) nfields:i32])
  (struct Field [name_pos:i32 name_len:i32 offset:i32 ty:Ty])

  ;; A local of the function being compiled (parameters first): its name (a
  ;; span of the source) and type. A loop's hidden end and step locals carry
  ;; the loop variable's name and the type loop_end / loop_step.
  (struct Local [name_pos:i32 name_len:i32 ty:Ty])

  ;; A function of the module: its name (a span of the source), parameter
  ;; and result types, wasm index, and definition.
  (struct FnInfo [name_pos:i32 name_len:i32 nparams:i32 ret:Ty index:i32
                  node:(ptr compiler.Node) params:(arr Ty)])

  (fn new_cg [src:i32] -> (ptr Cg)
    (let cg:(ptr Cg) (new Cg))
    (put cg Cg.src src)
    (put cg Cg.locals (arr.new (ptr Local) 1024))
    (put cg Cg.nlocals 0)
    (put cg Cg.fns (arr.new (ptr FnInfo) 2048))
    (put cg Cg.nfns 0)
    (put cg Cg.structs (arr.new (ptr StructInfo) 255))
    (put cg Cg.nstructs 0)
    (put cg Cg.wasi (arr.new i32 13))
    (loop w 0 12 1 (arr.set i32 (get cg Cg.wasi) w -1))
    (put cg Cg.nimports 0)
    (put cg Cg.labels (arr.new Label 255))
    (put cg Cg.nlabels 0)
    (put cg Cg.uses_refs false)
    (put cg Cg.sigs (arr.new (ptr Sig) 31))
    (put cg Cg.nsigs 0)
    (put cg Cg.strs (arr.new (ptr StrLit) 1364))
    (put cg Cg.nstrs 0)
    (put cg Cg.blob (call buf.make 4096))
    (put cg Cg.newline 0)
    cg)

  ;; ===== Runtime memory cells (AIPL_SPEC.md 7.9) =====
  ;; The compile's state is in Cg. These cells remain:
  ;;   mem[4]  = compile error code (0 = none; read by the host)
  ;;   mem[16] = keyword map (Keywords)
  ;;   mem[44], mem[48] = callee name span after compile error 1452 (read by the host)
  ;;   mem[60] = compiled module output pointer (read by the host)

  ;; The structured instructions around the code being compiled, innermost
  ;; last, so break and continue can compute their branch depth (wasm.rs
  ;; Label): an if/else, the block a loop's break leaves, the loop a while's
  ;; continue restarts, and the block around a loop body that a loop's
  ;; continue leaves (falling into the step).
  (enum Label [if_else loop_exit loop_header loop_body])

  (fn label_push [cg:(ptr Cg) l:Label] -> i32
    (let n:i32 (get cg Cg.nlabels))
    (if (gte n 255) (return (call set_compile_error CgErr.too_deeply_nested)) (block))
    (arr.set Label (get cg Cg.labels) n l)
    (put cg Cg.nlabels (+ n 1))
    0)
  (fn label_pop [cg:(ptr Cg)] -> i32
    (put cg Cg.nlabels (- (get cg Cg.nlabels) 1))
    0)
  ;; Branch depth to the innermost label a or b (compile error 101 if none).
  (fn label_depth [cg:(ptr Cg) a:Label b:Label] -> i32
    (let n:i32 (get cg Cg.nlabels))
    (loop d 0 (- n 1) 1
      (let l:Label (arr.get Label (get cg Cg.labels) (- (- n 1) d)))
      (if (or (eq l a) (eq l b)) (return d) (block)))
    (call set_compile_error CgErr.jump_outside_loop)
    0)
  ;; String literals are placed at 1024; the heap starts at the first 8-aligned
  ;; address after them (wasm.rs heap_start_after), and stores below it trap.
  (fn heap_start [cg:(ptr Cg)] -> i32 (bitand (+ 1031 (call buf.len (get cg Cg.blob))) -8))

  ;; Idempotent: allocates the tables on first call, and clears error flags.
  ;; Builds the keyword map once (cell 16) and clears the error flag (cell 4);
  ;; everything else a compile needs is in its Cg.
  (fn codegen_init [] -> i32
    (if (eq (mem.load32 16) 0) (mem.store32 16 (ptr.addr (call new_keywords))) (block))
    (mem.store32 4 0)
    0)

  ;; ===== Keywords =====
  ;; Every word with a meaning of its own: ops (0-86), forms (100-115), and
  ;; type names (200-209); none for any other symbol. The values are the ids
  ;; the code generator has always used.
  (enum Kw [(none -1) (add 0) (sub 1) (mul 2) (div 3) (xor 4) (shl 5) (shr 6) (bitand 7) (bitor 8) (mem_load8 9) (mem_load32 10) (mem_load64 11) (mem_store8 12) (mem_store32 13) (mem_store64 14) (eq 15) (neq 16) (lt 17) (lte 18) (gt 19) (gte 20) (and 21) (or 22) (not 23) (str_len 30) (str_ptr 31) (sys_print 32) (sys_exit 33) (fs_open 34) (fs_read 35) (fs_write 36) (fs_close 37) (fs_delete 38) (rem 39) (divu 40) (remu 41) (shru 42) (mem_alloc 43) (mem_grow 44) (i64_extend_s 45) (i64_extend_u 46) (i32_wrap 47) (ok 48) (err 49) (new 50) (get 51) (put 52) (sizeof 53) (arr_new 54) (arr_get 55) (arr_set 56) (f64_convert_i64_s 57) (i64_trunc_f64_s 58) (f64_reinterpret_i64 59) (i64_reinterpret_f64 60) (ptr_null 61) (ptr_cast 62) (ptr_addr 63) (arr_null 64) (arr_cast 65) (arr_addr 66) (arr_len 67) (ref 68) (call_ref 69) (return 70) (break 71) (continue 72) (args_sizes 73) (args_get 74) (env_sizes 75) (env_get 76) (thread_spawn 77) (thread_join 78) (atomic_add 79) (atomic_cas 80) (atomic_lock 81) (atomic_unlock 82) (sys_time 83) (sys_monotonic 84) (sys_random 85) (f64_sqrt 86) (let 100) (set 101) (if 102) (loop 103) (while 104) (call 105) (block 106) (req 107) (ens 108) (inv 109) (module 110) (fn 111) (match_result 112) (struct 113) (cond 114) (else 115) (ty_i32 200) (ty_i64 201) (ty_f32 202) (ty_f64 203) (ty_bool 204) (ty_void 205) (ty_str 206) (ty_result 207) (ty_ptr 208) (ty_arr 209)])

  ;; The keyword map, at cell 16: keyword text -> Kw, plus one scratch slice
  ;; so that a lookup allocates nothing.
  (struct Keywords [map:(ptr (strmap.StrMap Kw)) key:(ptr str.Bytes)])

  (fn keywords [] -> (ptr Keywords) (ptr.cast Keywords (mem.load32 16)))

  (fn new_keywords [] -> (ptr Keywords)
    (let ks:(ptr Keywords) (new Keywords))
    (put ks Keywords.map (call (strmap.make Kw) 256))
    (put ks Keywords.key (call str.bytes 0 0))
    ks)

  (fn reg [m:(ptr (strmap.StrMap Kw)) word:str k:Kw] -> void
    (call (strmap.set Kw) m (call str.from_str word) k))

  ;; Fills the keyword map once (it also runs codegen_init, every time).
  (fn init_keywords [] -> i32
    (let _init:i32 (call codegen_init))
    (let m:(ptr (strmap.StrMap Kw)) (get (call keywords) Keywords.map))
    (if (gt (call (strmap.count Kw) m) 0) (return 0) (block))
    (call reg m "+" Kw.add)
    (call reg m "-" Kw.sub)
    (call reg m "*" Kw.mul)
    (call reg m "/" Kw.div)
    (call reg m "^" Kw.xor)
    (call reg m "shl" Kw.shl)
    (call reg m "shr" Kw.shr)
    (call reg m "bitand" Kw.bitand)
    (call reg m "bitor" Kw.bitor)
    (call reg m "mem.load8" Kw.mem_load8)
    (call reg m "mem.load32" Kw.mem_load32)
    (call reg m "mem.load64" Kw.mem_load64)
    (call reg m "mem.store8" Kw.mem_store8)
    (call reg m "mem.store32" Kw.mem_store32)
    (call reg m "mem.store64" Kw.mem_store64)
    (call reg m "eq" Kw.eq)
    (call reg m "neq" Kw.neq)
    (call reg m "lt" Kw.lt)
    (call reg m "lte" Kw.lte)
    (call reg m "gt" Kw.gt)
    (call reg m "gte" Kw.gte)
    (call reg m "and" Kw.and)
    (call reg m "or" Kw.or)
    (call reg m "not" Kw.not)
    (call reg m "str.len" Kw.str_len)
    (call reg m "str.ptr" Kw.str_ptr)
    (call reg m "sys.print" Kw.sys_print)
    (call reg m "sys.exit" Kw.sys_exit)
    (call reg m "fs.open" Kw.fs_open)
    (call reg m "fs.read" Kw.fs_read)
    (call reg m "fs.write" Kw.fs_write)
    (call reg m "fs.close" Kw.fs_close)
    (call reg m "fs.delete" Kw.fs_delete)
    (call reg m "%" Kw.rem)
    (call reg m "divu" Kw.divu)
    (call reg m "remu" Kw.remu)
    (call reg m "shru" Kw.shru)
    (call reg m "mem.alloc" Kw.mem_alloc)
    (call reg m "mem.grow" Kw.mem_grow)
    (call reg m "i64.extend_s" Kw.i64_extend_s)
    (call reg m "i64.extend_u" Kw.i64_extend_u)
    (call reg m "i32.wrap" Kw.i32_wrap)
    (call reg m "ok" Kw.ok)
    (call reg m "err" Kw.err)
    (call reg m "new" Kw.new)
    (call reg m "get" Kw.get)
    (call reg m "put" Kw.put)
    (call reg m "sizeof" Kw.sizeof)
    (call reg m "arr.new" Kw.arr_new)
    (call reg m "arr.get" Kw.arr_get)
    (call reg m "arr.set" Kw.arr_set)
    (call reg m "f64.convert_i64_s" Kw.f64_convert_i64_s)
    (call reg m "i64.trunc_f64_s" Kw.i64_trunc_f64_s)
    (call reg m "f64.reinterpret_i64" Kw.f64_reinterpret_i64)
    (call reg m "i64.reinterpret_f64" Kw.i64_reinterpret_f64)
    (call reg m "ptr.null" Kw.ptr_null)
    (call reg m "ptr.cast" Kw.ptr_cast)
    (call reg m "ptr.addr" Kw.ptr_addr)
    (call reg m "arr.null" Kw.arr_null)
    (call reg m "arr.cast" Kw.arr_cast)
    (call reg m "arr.addr" Kw.arr_addr)
    (call reg m "arr.len" Kw.arr_len)
    (call reg m "ref" Kw.ref)
    (call reg m "call_ref" Kw.call_ref)
    (call reg m "return" Kw.return)
    (call reg m "break" Kw.break)
    (call reg m "continue" Kw.continue)
    (call reg m "args.sizes" Kw.args_sizes)
    (call reg m "args.get" Kw.args_get)
    (call reg m "env.sizes" Kw.env_sizes)
    (call reg m "env.get" Kw.env_get)
    (call reg m "thread.spawn" Kw.thread_spawn)
    (call reg m "thread.join" Kw.thread_join)
    (call reg m "atomic.add" Kw.atomic_add)
    (call reg m "atomic.cas" Kw.atomic_cas)
    (call reg m "atomic.lock" Kw.atomic_lock)
    (call reg m "atomic.unlock" Kw.atomic_unlock)
    (call reg m "sys.time" Kw.sys_time)
    (call reg m "sys.monotonic" Kw.sys_monotonic)
    (call reg m "sys.random" Kw.sys_random)
    (call reg m "f64.sqrt" Kw.f64_sqrt)
    (call reg m "let" Kw.let)
    (call reg m "set!" Kw.set)
    (call reg m "if" Kw.if)
    (call reg m "loop" Kw.loop)
    (call reg m "while" Kw.while)
    (call reg m "call" Kw.call)
    (call reg m "block" Kw.block)
    (call reg m "req" Kw.req)
    (call reg m "ens" Kw.ens)
    (call reg m "inv" Kw.inv)
    (call reg m "module" Kw.module)
    (call reg m "fn" Kw.fn)
    (call reg m "match_result" Kw.match_result)
    (call reg m "struct" Kw.struct)
    (call reg m "cond" Kw.cond)
    (call reg m "else" Kw.else)
    (call reg m "i32" Kw.ty_i32)
    (call reg m "i64" Kw.ty_i64)
    (call reg m "f32" Kw.ty_f32)
    (call reg m "f64" Kw.ty_f64)
    (call reg m "bool" Kw.ty_bool)
    (call reg m "void" Kw.ty_void)
    (call reg m "str" Kw.ty_str)
    (call reg m "result" Kw.ty_result)
    (call reg m "ptr" Kw.ty_ptr)
    (call reg m "arr" Kw.ty_arr)
    0)

  ;; An operator (as opposed to a form, a type name, or none): ids 0-99.
  (fn is_op [k:Kw] -> bool
    (and (gte (enum.ord k) 0) (lt (enum.ord k) 100)))

  ;; return, break, continue: statements that jump.
  (fn is_jump [k:Kw] -> bool
    (or (eq k Kw.return) (or (eq k Kw.break) (eq k Kw.continue))))

  ;; Arithmetic and bitwise ops, whose type is their operands' type.
  (fn is_arith [k:Kw] -> bool
    (or (or (eq k Kw.add) (or (eq k Kw.sub) (or (eq k Kw.mul) (or (eq k Kw.div) (eq k Kw.xor)))))
        (or (or (eq k Kw.shl) (or (eq k Kw.shr) (or (eq k Kw.bitand) (eq k Kw.bitor))))
            (or (eq k Kw.rem) (or (eq k Kw.divu) (or (eq k Kw.remu) (eq k Kw.shru)))))))

  ;; Comparisons and logic, which yield bool.
  (fn is_compare [k:Kw] -> bool
    (or (or (eq k Kw.eq) (or (eq k Kw.neq) (or (eq k Kw.lt) (or (eq k Kw.lte) (or (eq k Kw.gt) (eq k Kw.gte))))))
        (or (eq k Kw.and) (or (eq k Kw.or) (eq k Kw.not)))))

  ;; The WASI function behind args.sizes / args.get / env.sizes / env.get, or none.
  (fn proc_wasi [k:Kw] -> Wasi
    (cond
      ((eq k Kw.args_sizes) Wasi.args_sizes_get)
      ((eq k Kw.args_get) Wasi.args_get)
      ((eq k Kw.env_sizes) Wasi.environ_sizes_get)
      ((eq k Kw.env_get) Wasi.environ_get)
      (else Wasi.none)))

  ;; The keyword spelled by len bytes at src_ptr + pos, or Kw.none.
  (fn classify_keyword [cg:(ptr Cg) pos:i32 len:i32] -> Kw
    (let ks:(ptr Keywords) (call keywords))
    (let key:(ptr str.Bytes) (get ks Keywords.key))
    (put key str.Bytes.addr (+ (get cg Cg.src) pos))
    (put key str.Bytes.len len)
    (call (strmap.get_or Kw) (get ks Keywords.map) key Kw.none))

;; ===== Types =====
  ;; A value's static type, as expr_type in wasm.rs computes it. bool, str,
  ;; results, pointers, arrays, and function refs are i32 in wasm; loop_end
  ;; and loop_step are the hidden locals holding a loop's bound and step.
  ;; The values are the ids codegen has always stored in its tables.
  (enum Ty [(none -1) (i32 200) i64 f32 f64 bool void str result ptr arr fn loop_end loop_step])

  ;; The type a type keyword names, or Ty.none.
  (fn ty_of_kw [k:Kw] -> Ty
    (cond
      ((eq k Kw.ty_i32) Ty.i32)
      ((eq k Kw.ty_i64) Ty.i64)
      ((eq k Kw.ty_f32) Ty.f32)
      ((eq k Kw.ty_f64) Ty.f64)
      ((eq k Kw.ty_bool) Ty.bool)
      ((eq k Kw.ty_void) Ty.void)
      ((eq k Kw.ty_str) Ty.str)
      ((eq k Kw.ty_result) Ty.result)
      ((eq k Kw.ty_ptr) Ty.ptr)
      ((eq k Kw.ty_arr) Ty.arr)
      (else Ty.none)))

  ;; The type a type node names: a scalar symbol, or a (result T E), (ptr S),
  ;; (arr T), or (fn [..] -> r) group. Anything else is compile error 98.
  (fn type_node_id [cg:(ptr Cg) node:(ptr compiler.Node)] -> Ty
    (let t:Ty Ty.none)
    (if (eq (call node_kind node) compiler.Kind.symbol)
        (set! t (call ty_of_kw (call classify_keyword cg (call node_a node) (call node_b node))))
        (if (eq (call node_kind node) compiler.Kind.paren)
            (block
              (let head:Kw (call group_head_keyword cg node))
              (if (or (eq head Kw.ty_result) (or (eq head Kw.ty_ptr) (eq head Kw.ty_arr))) (set! t (call ty_of_kw head)) (block))
              (if (eq head Kw.fn) (set! t Ty.fn) (block)))
            (block)))
    (if (eq t Ty.none)
        (block (call set_compile_error CgErr.unlowerable_type) Ty.i32)
        t))

  ;; The wasm value type byte: 0x7f i32, 0x7e i64, 0x7d f32, 0x7c f64.
  (fn type_id_to_valtype [t:Ty] -> i32
    (cond
      ((eq t Ty.i64) 126)
      ((eq t Ty.f32) 125)
      ((eq t Ty.f64) 124)
      ((eq t Ty.void) (call set_compile_error CgErr.unlowerable_type) 127)
      ((eq t Ty.none) (call set_compile_error CgErr.unlowerable_type) 127)
      (else 127)))

  ;; Block type byte for a value of this type: 0x40 (empty) for void.
  (fn block_type_byte [t:Ty] -> i32
    (if (eq t Ty.void) 64 (call type_id_to_valtype t)))

  ;; Scalars that can live in a struct field or array element.
  (fn is_memory_type [t:Ty] -> bool
    (not (or (eq t Ty.void) (or (eq t Ty.result) (or (eq t Ty.none) (or (eq t Ty.loop_end) (eq t Ty.loop_step)))))))
  ;; Element type of arr.new/get/set: a memory scalar, else compile error 95.
  (fn elem_type_id [cg:(ptr Cg) node:(ptr compiler.Node)] -> Ty
    (let t:Ty (call type_node_id cg node))
    (if (call is_memory_type t) t (block (call set_compile_error CgErr.not_a_memory_type) Ty.i32)))
  (fn type_size [t:Ty] -> i32 (if (or (eq t Ty.i64) (eq t Ty.f64)) 8 4))
  (fn mem_align [t:Ty] -> i32 (if (eq (call type_size t) 8) 3 2))
  (fn load_opcode [t:Ty] -> i32 (cond
                                  ((eq t Ty.i64) 41)
                                  ((eq t Ty.f32) 42)
                                  ((eq t Ty.f64) 43)
                                  (else 40)))
  (fn store_opcode [t:Ty] -> i32 (cond
                                   ((eq t Ty.i64) 55)
                                   ((eq t Ty.f32) 56)
                                   ((eq t Ty.f64) 57)
                                   (else 54)))

  ;; ===== Function table =====
  (fn func_entry_ptr [cg:(ptr Cg) idx:i32] -> (ptr FnInfo)
    (arr.get (ptr FnInfo) (get cg Cg.fns) idx))

  ;; Records every (fn ...) of the module, in order; returns the count.
  (fn collect_functions [cg:(ptr Cg) root:(ptr compiler.Node)] -> i32
    (let count:i32 0)
    (let child:(ptr compiler.Node) (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (if (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.fn))
          (block
            (let fname_node:(ptr compiler.Node) (call nth_child child 1))
            (let params_node:(ptr compiler.Node) (call nth_child child 2))
            (if (gte count 2048) (call set_compile_error CgErr.too_many_functions) 0)
            (let f:(ptr FnInfo) (new FnInfo))
            (put f FnInfo.name_pos (call node_a fname_node))
            (put f FnInfo.name_len (call node_b fname_node))
            (put f FnInfo.ret (call type_node_id cg (call nth_child child 4)))
            (put f FnInfo.index count)
            (put f FnInfo.node child)
            (put f FnInfo.params (arr.new Ty 16))
            (let pcount:i32 0)
            (let pchild:(ptr compiler.Node) (call first_child params_node))
            (while (neq pchild (ptr.null compiler.Node))
              (let ptype_node:(ptr compiler.Node) (call node_next (call node_next pchild)))
              (if (gte pcount 16) (call set_compile_error CgErr.too_many_functions) 0)
              (arr.set Ty (get f FnInfo.params) (if (gte pcount 16) 15 pcount) (call type_node_id cg ptype_node))
              (set! pcount (+ pcount 1))
              (set! pchild (call node_next ptype_node)))
            (put f FnInfo.nparams pcount)
            (arr.set (ptr FnInfo) (get cg Cg.fns) (if (gte count 2048) 2047 count) f)
            (if (lt count 2048) (set! count (+ count 1)) (block)))
          (block))
      (set! child (call node_next child)))
    count)

  ;; Exact name match, as in the checker: `a.f` never resolves to a bare `f`.
  (fn find_function [cg:(ptr Cg) name_ptr:i32 name_len:i32] -> i32
    (loop i 0 (- (get cg Cg.nfns) 1) 1
      (let entry:(ptr FnInfo) (call func_entry_ptr cg i))
      (if (call sym_eq cg name_ptr name_len (+ (get cg Cg.src) (get entry FnInfo.name_pos)) (get entry FnInfo.name_len))
          (return i)
          (block)))
    -1)

  ;; ===== Local variable table =====
  (fn local_at [cg:(ptr Cg) idx:i32] -> (ptr Local)
    (arr.get (ptr Local) (get cg Cg.locals) idx))

  (fn find_local [cg:(ptr Cg) name_ptr:i32 name_len:i32] -> i32
    (loop i 0 (- (get cg Cg.nlocals) 1) 1
      (let l:(ptr Local) (call local_at cg i))
      (if (call sym_eq cg name_ptr name_len (+ (get cg Cg.src) (get l Local.name_pos)) (get l Local.name_len))
          (return i)
          (block)))
    -1)

  ;; Appends a local (the 1024th and later overwrite the last, after compile
  ;; error 93).
  (fn add_local [cg:(ptr Cg) name_ptr:i32 name_len:i32 ty:Ty] -> void
    (let count:i32 (get cg Cg.nlocals))
    (if (gte count 1024) (call set_compile_error CgErr.too_many_locals) 0)
    (let l:(ptr Local) (new Local))
    (put l Local.name_pos name_ptr)
    (put l Local.name_len name_len)
    (put l Local.ty ty)
    (arr.set (ptr Local) (get cg Cg.locals) (if (gte count 1024) 1023 count) l)
    (put cg Cg.nlocals (if (gte count 1024) 1024 (+ count 1))))

  (fn add_local_if_new [cg:(ptr Cg) name_ptr:i32 name_len:i32 ty:Ty] -> i32
    (if (eq (call find_local cg name_ptr name_len) -1) (call add_local cg name_ptr name_len ty) (block))
    0)

  ;; A loop's hidden end / step local (wasm.rs `i#end` / `i#step`), added once
  ;; per name like any local. Lookups by name find the variable itself,
  ;; which is always added first.
  (fn find_hidden [cg:(ptr Cg) name_ptr:i32 name_len:i32 marker:Ty] -> i32
    (loop i 0 (- (get cg Cg.nlocals) 1) 1
      (let l:(ptr Local) (call local_at cg i))
      (if (and (eq (get l Local.ty) marker)
               (call sym_eq cg name_ptr name_len (+ (get cg Cg.src) (get l Local.name_pos)) (get l Local.name_len)))
          (return i)
          (block)))
    -1)

  (fn add_hidden_if_new [cg:(ptr Cg) name_ptr:i32 name_len:i32 marker:Ty] -> i32
    (if (lt (call find_hidden cg name_ptr name_len marker) 0) (call add_local cg name_ptr name_len marker) (block))
    0)

  (fn collect_locals_walk [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (if (neq (call node_kind node) compiler.Kind.paren)
        0
        (block
          (let head:i32 (call node_a node))
          (let kw:Kw (call group_head_keyword cg node))
          (cond
            ((eq kw Kw.let) (let name_node:(ptr compiler.Node) (call nth_child node 1))
                (let type_node:(ptr compiler.Node) (call nth_child node 3))
                (let type_id:Ty (call type_node_id cg type_node))
                (call add_local_if_new cg (call node_a name_node) (call node_b name_node) type_id))
            ((eq kw Kw.loop) (let var_node:(ptr compiler.Node) (call nth_child node 1))
                    (call add_local_if_new cg (call node_a var_node) (call node_b var_node) Ty.i32)
                    (call add_hidden_if_new cg (call node_a var_node) (call node_b var_node) Ty.loop_end)
                    (call add_hidden_if_new cg (call node_a var_node) (call node_b var_node) Ty.loop_step))
            ((eq kw Kw.match_result) (let ok_group:(ptr compiler.Node) (call nth_child node 2))
                        (let err_group:(ptr compiler.Node) (call nth_child node 3))
                        (let ok_var:(ptr compiler.Node) (call nth_child ok_group 1))
                        (let err_var:(ptr compiler.Node) (call nth_child err_group 1))
                        (call add_local_if_new cg (call node_a ok_var) (call node_b ok_var) Ty.i32)
                        (call add_local_if_new cg (call node_a err_var) (call node_b err_var) Ty.i32))
            (else 0))
          (let child:(ptr compiler.Node) (call first_child node))
          (while (neq child (ptr.null compiler.Node)) (let _w:i32 (call collect_locals_walk cg child)) (set! child (call node_next child)))
          0)))

  ;; Any body item may be an atom (a bare number, name, or string): its
  ;; Node.a is a value, not a child address, so check the kind first.
  (fn is_contract_head [cg:(ptr Cg) group:(ptr compiler.Node)] -> bool
    (if (neq (call node_kind group) compiler.Kind.paren) (return false) (block))
    (let head:(ptr compiler.Node) (call first_child group))
    (if (neq (call node_kind head) compiler.Kind.symbol)
        false
        (block
          (let kw:Kw (call classify_keyword cg (call node_a head) (call node_b head)))
          (or (eq kw Kw.req) (or (eq kw Kw.ens) (eq kw Kw.inv))))))

  ;; Collects the function's locals into cg (parameters first, then every
  ;; let, loop variable and its hidden end and step, and match_result
  ;; variable, in a pre-order walk); returns the count.
  (fn collect_locals_for_function [cg:(ptr Cg) entry:(ptr FnInfo)] -> i32
    (put cg Cg.nlocals 0)
    (let fndef_group:(ptr compiler.Node) (get entry FnInfo.node))
    (let pchild:(ptr compiler.Node) (call first_child (call nth_child fndef_group 2)))
    (while (neq pchild (ptr.null compiler.Node))
      (let type_node:(ptr compiler.Node) (call node_next (call node_next pchild)))
      (call add_local_if_new cg (call node_a pchild) (call node_b pchild) (call type_node_id cg type_node))
      (set! pchild (call node_next type_node)))
    (let bchild:(ptr compiler.Node) (call nth_child fndef_group 5))
    (while (neq bchild (ptr.null compiler.Node))
      (if (call is_contract_head cg bchild) 0 (call collect_locals_walk cg bchild))
      (set! bchild (call node_next bchild)))
    (get cg Cg.nlocals))

  ;; ===== WebAssembly encoding =====
  ;; Opcodes (the 0xFC and 0xFE prefixes take a second, LEB128 opcode),
  ;; block types, and value types, as the binary format spells them.
  (const OP_UNREACHABLE:i32 0)
  (const OP_BLOCK:i32 2)
  (const OP_LOOP:i32 3)
  (const OP_IF:i32 4)
  (const OP_ELSE:i32 5)
  (const OP_END:i32 11)
  (const OP_BR:i32 12)
  (const OP_BR_IF:i32 13)
  (const OP_RETURN:i32 15)
  (const OP_CALL:i32 16)
  (const OP_DROP:i32 26)
  (const OP_LOCAL_GET:i32 32)
  (const OP_LOCAL_SET:i32 33)
  (const OP_LOCAL_TEE:i32 34)
  (const OP_GLOBAL_GET:i32 35)
  (const OP_GLOBAL_SET:i32 36)
  (const OP_I32_LOAD:i32 40)
  (const OP_I64_LOAD:i32 41)
  (const OP_F32_LOAD:i32 42)
  (const OP_F64_LOAD:i32 43)
  (const OP_I32_LOAD8_U:i32 45)
  (const OP_I32_STORE:i32 54)
  (const OP_I64_STORE:i32 55)
  (const OP_F32_STORE:i32 56)
  (const OP_F64_STORE:i32 57)
  (const OP_I32_STORE8:i32 58)
  (const OP_MEMORY_SIZE:i32 63)
  (const OP_MEMORY_GROW:i32 64)
  (const OP_I32_CONST:i32 65)
  (const OP_I64_CONST:i32 66)
  (const OP_F64_CONST:i32 68)
  (const OP_I32_EQZ:i32 69)
  (const OP_I32_EQ:i32 70)
  (const OP_I32_NE:i32 71)
  (const OP_I32_LT_S:i32 72)
  (const OP_I32_LT_U:i32 73)
  (const OP_I32_GT_S:i32 74)
  (const OP_I32_GT_U:i32 75)
  (const OP_I32_ADD:i32 106)
  (const OP_I32_SUB:i32 107)
  (const OP_I32_MUL:i32 108)
  (const OP_I32_AND:i32 113)
  (const OP_I32_OR:i32 114)
  (const OP_I32_SHL:i32 116)
  (const OP_I32_SHR_U:i32 118)
  (const OP_I64_REINTERPRET_F64:i32 189)
  (const OP_F64_REINTERPRET_I64:i32 191)
  (const OP_PREFIX_MISC:i32 252)
  (const OP_I32_WRAP_I64:i32 167)
  (const OP_F64_SQRT:i32 159)
  (const OP_I64_EXTEND_I32_S:i32 172)
  (const OP_I64_EXTEND_I32_U:i32 173)
  (const OP_I64_TRUNC_F64_S:i32 176)
  (const OP_F64_CONVERT_I64_S:i32 185)
  (const OP_CALL_INDIRECT:i32 17)
  (const MISC_MEMORY_INIT:i32 8)
  (const OP_PREFIX_ATOMIC:i32 254)
  (const ATOMIC_NOTIFY:i32 0)
  (const ATOMIC_WAIT32:i32 1)
  (const ATOMIC_LOAD:i32 16)
  (const ATOMIC_STORE:i32 23)
  (const ATOMIC_RMW_ADD:i32 30)
  (const ATOMIC_RMW_XCHG:i32 65)
  (const ATOMIC_RMW_CMPXCHG:i32 72)
  (const BLOCK_EMPTY:i32 64)
  (const VT_I32:i32 127)
  (const VT_I64:i32 126)
  (const VT_F32:i32 125)
  (const VT_F64:i32 124)
  (const FUNC_TYPE:i32 96)

  ;; ===== Output =====
  ;; A cursor writing bytes forward from base. Emitters append at pos.
  (struct Out [base:i32 pos:i32])

  (fn out_at [addr:i32] -> (ptr Out)
    (let o:(ptr Out) (new Out))
    (put o Out.base addr)
    (put o Out.pos 0)
    o)

  ;; The address of the next byte, for code that still writes at an address
  ;; and returns a count (advance by it).
  (fn cursor [o:(ptr Out)] -> i32 (+ (get o Out.base) (get o Out.pos)))
  (fn advance [o:(ptr Out) n:i32] -> void (put o Out.pos (+ (get o Out.pos) n)))

  (fn put_byte [o:(ptr Out) b:i32] -> void
    (mem.store8 (call cursor o) b)
    (put o Out.pos (+ (get o Out.pos) 1)))

  ;; LEB128 immediates.
  (fn put_u32 [o:(ptr Out) v:i32] -> void (call advance o (call compiler.encode_u32 (call cursor o) v)))
  (fn put_s32 [o:(ptr Out) v:i32] -> void (call advance o (call encode_s32 (call cursor o) v)))
  (fn put_s64 [o:(ptr Out) v:i64] -> void (call advance o (call encode_s64 (call cursor o) v)))

  ;; ===== Low-level WASM instruction emitters =====
  (fn encode_s32 [ptr:i32 val:i32] -> i32
    (let bytes_written:i32 0)
    (let value:i32 val)
    (let more:bool true)
    (while more
      (let byte_val:i32 (bitand value 127))
      (set! value (shr value 7))
      (let sign_bit:i32 (bitand byte_val 64))
      (let done_now:bool false)
      (if (and (eq value 0) (eq sign_bit 0))
          (set! done_now true)
          (if (and (eq value -1) (neq sign_bit 0))
              (set! done_now true)
              (set! done_now false)))
      (let byte_out:i32 byte_val)
      (if done_now (set! byte_out byte_val) (set! byte_out (bitor byte_val 128)))
      (mem.store8 (+ ptr bytes_written) byte_out)
      (set! bytes_written (+ bytes_written 1))
      (if done_now (set! more false) (set! more true)))
    bytes_written)

;; Value of an `i64` literal token such as `-7i64`. Digits accumulate
  ;; negatively so that -9223372036854775808i64 does not overflow.
  (fn parse_i64_literal [cg:(ptr Cg) pos:i32 len:i32] -> i64
    (let neg:bool (eq (mem.load8 (+ (get cg Cg.src) pos)) 45))
    (let i:i32 (if neg 1 0))
    (let v:i64 0i64)
    (while (lt i (- len 3))
      (set! v (- (* v 10i64) (i64.extend_s (- (mem.load8 (+ (get cg Cg.src) (+ pos i))) 48))))
      (set! i (+ i 1)))
    (if neg v (- 0i64 v)))

  ;; Signed LEB128 of a 64-bit value (the i64.const immediate).
  (fn encode_s64 [ptr:i32 val:i64] -> i32
    (let v:i64 val)
    (let n:i32 0)
    (let more:bool true)
    (while more
      (let b:i32 (i32.wrap (bitand v 127i64)))
      (set! v (shr v 7i64))
      (if (or (and (eq v 0i64) (eq (bitand b 64) 0)) (and (eq v -1i64) (neq (bitand b 64) 0)))
          (set! more false)
          (set! b (bitor b 128)))
      (mem.store8 (+ ptr n) b)
      (set! n (+ n 1)))
    n)

;; 10^n as i64, for 0 <= n <= 18.
  (fn pow10_i64 [n:i32] -> i64
    (let v:i64 1i64)
    (loop i 1 n 1 (set! v (* v 10i64)))
    v)

  ;; f64.const for a decimal literal such as -2.5, with the bits Rust's
  ;; parse::<f64> gives. The literal is m / 10^k; with m <= 2^53 and k <= 22
  ;; both are exact doubles, so one IEEE division is correctly rounded.
  ;; Literals outside that range are compile error 973.
  (fn emit_f64_literal [o:(ptr Out) cg:(ptr Cg) pos:i32 len:i32] -> void
    (let neg:bool (eq (mem.load8 (+ (get cg Cg.src) pos)) 45))
    (let i:i32 (if neg 1 0))
    (let m:i64 0i64)
    (let sig:i32 0)
    (let frac:i32 0)
    (let seen_dot:bool false)
    (while (lt i len)
      (let c:i32 (mem.load8 (+ (get cg Cg.src) (+ pos i))))
      (if (eq c 46)
          (set! seen_dot true)
          (block
            (set! m (+ (* m 10i64) (i64.extend_s (- c 48))))
            (if (or (gt sig 0) (neq c 48)) (set! sig (+ sig 1)) (block))
            (if seen_dot (set! frac (+ frac 1)) (block))))
      (set! i (+ i 1)))
    ;; sig <= 18 keeps m from overflowing i64; m <= 2^53 makes it an exact double
    (if (or (gt sig 18) (or (gt m 9007199254740992i64) (gt frac 22))) (call set_compile_error CgErr.inexact_float_literal) 0)
    (let p:f64 (f64.convert_i64_s (call pow10_i64 (if (gt frac 18) 18 frac))))
    (if (gt frac 18) (set! p (* p (f64.convert_i64_s (call pow10_i64 (- frac 18))))) (block))
    (let v:f64 (/ (f64.convert_i64_s m) p))
    (if neg (set! v (* v (f64.convert_i64_s -1i64))) (block))
    (let bits:i64 (i64.reinterpret_f64 v))
    (call put_byte o OP_F64_CONST)
    (loop b 0 7 1
      (call put_byte o (i32.wrap (bitand (shru bits (i64.extend_u (* b 8))) 255i64)))))




  ;; After the heap cursor is bumped: grow memory to cover it if needed, with
  ;; no locals and no net stack effect (wasm.rs emit_grow_to_cursor).
;; A 0xFE-prefixed atomic instruction with align 2, offset 0.
  (fn emit_atomic [o:(ptr Out) op:i32] -> void
    (call put_byte o OP_PREFIX_ATOMIC)
    (call put_u32 o op)
    (call put_byte o 2)
    (call put_byte o 0))




  ;; With a condition on the stack: if it holds, unreachable.
  (fn emit_trap_if [o:(ptr Out)] -> void
    (call put_byte o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call put_byte o OP_UNREACHABLE)
    (call put_byte o OP_END))




  ;; Rounds the i32 on the stack up to a multiple of 8 (wasm.rs emit_round8):
  ;; every allocation size is, so every block is 8-aligned.
  (fn emit_round8 [o:(ptr Out)] -> void
    (call emit_i32_const o 7)
    (call put_byte o OP_I32_ADD)
    (call emit_i32_const o -8)
    (call put_byte o OP_I32_AND))



  ;; The directory fd for the path in locals (ptr, len), as wasm.rs
  ;; emit_path_dir: "/..." resolves in fd 4 (the host's "/") with the slash
  ;; dropped, anything else in fd 3 (the working directory).
  (fn emit_path_dir [o:(ptr Out) ptr_l:i32 len_l:i32] -> void
    (call emit_local_get o ptr_l)
    (call emit_memop o OP_I32_LOAD8_U 0) ;; i32.load8_u
    (call emit_i32_const o 47)
    (call put_byte o OP_I32_EQ)
    (call put_byte o OP_IF)
    (call put_byte o VT_I32)
    (call emit_local_get o ptr_l)
    (call emit_i32_const o 1)
    (call put_byte o OP_I32_ADD)
    (call emit_local_set o ptr_l)
    (call emit_local_get o len_l)
    (call emit_i32_const o 1)
    (call put_byte o OP_I32_SUB)
    (call emit_local_set o len_l)
    (call emit_i32_const o 4)
    (call put_byte o OP_ELSE)
    (call emit_i32_const o 3)
    (call put_byte o OP_END))




    ;; i32.atomic.rmw.add with align 2, offset 0: [addr] [n] -> [old]. Every
  ;; allocation claims its block with one of these on the cursor at address 0.
  (fn emit_rmw_add [o:(ptr Out)] -> void
    (call put_byte o OP_PREFIX_ATOMIC)
    (call put_byte o ATOMIC_RMW_ADD)
    (call put_byte o 2)
    (call put_byte o 0))




  (fn emit_grow_to_cursor [o:(ptr Out)] -> void
    (call emit_i32_const o 0)
    (call emit_memop o OP_I32_LOAD 2)
    (call emit_size_bytes o)
    (call put_byte o OP_I32_GT_U)
    (call put_byte o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call emit_i32_const o 0)
    (call emit_memop o OP_I32_LOAD 2)
    (call emit_size_bytes o)
    (call put_byte o OP_I32_SUB)
    (call emit_i32_const o 65535)
    (call put_byte o OP_I32_ADD)
    (call emit_i32_const o 16)
    (call put_byte o OP_I32_SHR_U)
    (call put_byte o OP_MEMORY_GROW)
    (call put_byte o 0)
    (call put_byte o OP_DROP)
    (call put_byte o OP_END))



  ;; memory.size; i32.const 16; i32.shl -> memory size in bytes
  (fn emit_size_bytes [o:(ptr Out)] -> void
    (call put_byte o OP_MEMORY_SIZE)
    (call put_byte o 0)
    (call emit_i32_const o 16)
    (call put_byte o OP_I32_SHL))




  (fn emit_i32_const [o:(ptr Out) val:i32] -> void
    (call put_byte o OP_I32_CONST)
    (call put_s32 o val))




  (fn emit_local_get [o:(ptr Out) idx:i32] -> void
    (call put_byte o OP_LOCAL_GET)
    (call put_u32 o idx))




  (fn emit_local_set [o:(ptr Out) idx:i32] -> void
    (call put_byte o OP_LOCAL_SET)
    (call put_u32 o idx))




  (fn emit_call [o:(ptr Out) idx:i32] -> void
    (call put_byte o OP_CALL)
    (call put_u32 o idx))




  (fn emit_memop [o:(ptr Out) opcode:i32 align:i32] -> void
    (call put_byte o opcode)
    (call put_byte o align)
    (call put_byte o 0))




  (fn emit_store_guard [cg:(ptr Cg) o:(ptr Out) scratch_idx:i32] -> void
    (call put_byte o OP_LOCAL_TEE)
    (call put_u32 o scratch_idx)
    (call emit_local_get o scratch_idx)
    (call emit_i32_const o 4)
    (call put_byte o OP_I32_LT_U)
    (call emit_local_get o scratch_idx)
    (call emit_i32_const o 64)
    (call put_byte o OP_I32_SUB)
    (call emit_i32_const o (- (call heap_start cg) 64))
    (call put_byte o OP_I32_LT_U)
    (call put_byte o OP_I32_OR)
    (call put_byte o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call put_byte o OP_UNREACHABLE)
    (call put_byte o OP_END))  ;; end



  ;; Opcode for a binary arithmetic/comparison op on operands of type t, as
  ;; arith_instruction / compare_instruction in wasm.rs; -1 if unsupported.
  (fn binop_opcode [op_id:Kw t:Ty] -> i32
    (cond
      ((eq t Ty.i32) (cond
                    ((eq op_id Kw.add) 106)
                    ((eq op_id Kw.sub) 107)
                    ((eq op_id Kw.mul) 108)
                    ((eq op_id Kw.div) 109)
                    ((eq op_id Kw.xor) 115)
                    ((eq op_id Kw.shl) 116)
                    ((eq op_id Kw.shr) 117)
                    ((eq op_id Kw.bitand) 113)
                    ((eq op_id Kw.bitor) 114)
                    ((eq op_id Kw.eq) 70)
                    ((eq op_id Kw.neq) 71)
                    ((eq op_id Kw.lt) 72)
                    ((eq op_id Kw.lte) 76)
                    ((eq op_id Kw.gt) 74)
                    ((eq op_id Kw.gte) 78)
                    ((eq op_id Kw.rem) 111)
                    ((eq op_id Kw.divu) 110)
                    ((eq op_id Kw.remu) 112)
                    ((eq op_id Kw.shru) 118)
                    (else -1)))
      ((eq t Ty.i64) (cond
                    ((eq op_id Kw.add) 124)
                    ((eq op_id Kw.sub) 125)
                    ((eq op_id Kw.mul) 126)
                    ((eq op_id Kw.div) 127)
                    ((eq op_id Kw.xor) 133)
                    ((eq op_id Kw.shl) 134)
                    ((eq op_id Kw.shr) 135)
                    ((eq op_id Kw.bitand) 131)
                    ((eq op_id Kw.bitor) 132)
                    ((eq op_id Kw.eq) 81)
                    ((eq op_id Kw.neq) 82)
                    ((eq op_id Kw.lt) 83)
                    ((eq op_id Kw.lte) 87)
                    ((eq op_id Kw.gt) 85)
                    ((eq op_id Kw.gte) 89)
                    ((eq op_id Kw.rem) 129)
                    ((eq op_id Kw.divu) 128)
                    ((eq op_id Kw.remu) 130)
                    ((eq op_id Kw.shru) 136)
                    (else -1)))
      ((eq t Ty.f32) (cond
                    ((eq op_id Kw.add) 146)
                    ((eq op_id Kw.sub) 147)
                    ((eq op_id Kw.mul) 148)
                    ((eq op_id Kw.div) 149)
                    ((eq op_id Kw.eq) 91)
                    ((eq op_id Kw.neq) 92)
                    ((eq op_id Kw.lt) 93)
                    ((eq op_id Kw.lte) 95)
                    ((eq op_id Kw.gt) 94)
                    ((eq op_id Kw.gte) 96)
                    (else -1)))
      ((eq t Ty.f64) (cond
                    ((eq op_id Kw.add) 160)
                    ((eq op_id Kw.sub) 161)
                    ((eq op_id Kw.mul) 162)
                    ((eq op_id Kw.div) 163)
                    ((eq op_id Kw.eq) 97)
                    ((eq op_id Kw.neq) 98)
                    ((eq op_id Kw.lt) 99)
                    ((eq op_id Kw.lte) 101)
                    ((eq op_id Kw.gt) 100)
                    ((eq op_id Kw.gte) 102)
                    (else -1)))
      ((or (eq t Ty.bool) (or (eq t Ty.str) (or (eq t Ty.ptr) (or (eq t Ty.arr) (eq t Ty.fn))))) (if (eq op_id Kw.eq) 70 (if (eq op_id Kw.neq) 71 -1)))
      (else -1)))

  ;; and / or are i32.and / i32.or whatever the operands; others go through
  ;; binop_opcode with the first operand's type. Unsupported: compile error 99.
  (fn emit_typed_binop [o:(ptr Out) op_id:Kw t:Ty] -> void
    (cond
      ((eq op_id Kw.and) (call put_byte o OP_I32_AND))
      ((eq op_id Kw.or) (call put_byte o OP_I32_OR))
      (else
       (let opc:i32 (call binop_opcode op_id t))
       (if (eq opc -1)
           (block (call set_compile_error CgErr.no_instruction_for_type) (block))
           (call put_byte o opc)))))




  (fn emit_memop_offset [o:(ptr Out) opcode:i32 align:i32 offset:i32] -> void
    (call put_byte o opcode)
    (call put_byte o align)
    (call put_u32 o offset))




  ;; ===== Voidness classification =====
  (fn is_void_op [k:Kw] -> bool
    (or (eq k Kw.atomic_lock) (or (eq k Kw.atomic_unlock)
    (or (eq k Kw.return) (or (eq k Kw.break) (or (eq k Kw.continue)
    (or (eq k Kw.mem_store8) (or (eq k Kw.mem_store32) (or (eq k Kw.mem_store64)
    (or (eq k Kw.sys_print) (or (eq k Kw.sys_exit) (or (eq k Kw.put) (eq k Kw.arr_set)))))))))))))

  (fn last_child [group:(ptr compiler.Node)] -> (ptr compiler.Node)
    (let cur:(ptr compiler.Node) (call first_child group))
    (while (neq (call node_next cur) (ptr.null compiler.Node))
      (set! cur (call node_next cur)))
    cur)

  ;; -1 unless group is a (...) whose head is a symbol. Checks the kinds itself
  ;; so any caller is safe: an atom's a field is a value, not a node address.
  (fn group_head_keyword [cg:(ptr Cg) group:(ptr compiler.Node)] -> Kw
    (if (neq (call node_kind group) compiler.Kind.paren) (return Kw.none) (block))
    (let head:(ptr compiler.Node) (call first_child group))
    (if (neq (call node_kind head) compiler.Kind.symbol)
        Kw.none
        (call classify_keyword cg (call node_a head) (call node_b head))))

  (fn is_void_call [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (let fname:(ptr compiler.Node) (call nth_child node 1))
    (let fidx:i32 (call find_function cg (call node_a fname) (call node_b fname)))
    (if (eq fidx -1)
        false
        (eq (get (call func_entry_ptr cg fidx) FnInfo.ret) Ty.void)))

  (fn is_void_node [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (if (neq (call node_kind node) compiler.Kind.paren)
        false
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (let res:bool false)
          (if (eq kw Kw.let) (set! res true) (block))
          (if (eq kw Kw.set) (set! res true) (block))
          (if (eq kw Kw.loop) (set! res true) (block))
          (if (eq kw Kw.while) (set! res true) (block))
          (if (eq kw Kw.struct) (set! res true) (block))
          (if (eq kw Kw.match_result) (set! res (call is_void_node cg (call last_child (call nth_child node 2)))) (block))
          ;; an empty (block) is void, like Expr::Block([]) in wasm.rs
          (if (eq kw Kw.block) (set! res (or (eq (call node_next (call first_child node)) (ptr.null compiler.Node)) (call is_void_node cg (call last_child node)))) (block))
          (if (eq kw Kw.if) (set! res (and (call is_void_node cg (call nth_child node 2)) (call is_void_node cg (call nth_child node 3)))) (block))
          (if (eq kw Kw.call) (set! res (call is_void_call cg node)) (block))
          (if (call is_op kw) (set! res (call is_void_op kw)) (block))
          (if (eq kw Kw.cond)
              (block
                (let all_void:bool true)
                (let clause:(ptr compiler.Node) (call nth_child node 1))
                (while (neq clause (ptr.null compiler.Node))
                  (if (call is_void_node cg (call last_child clause)) (block) (set! all_void false))
                  (set! clause (call node_next clause)))
                (set! res all_void))
              (block))
          ;; call_ref is void when its signature returns void (after the generic op rule)
          (if (eq kw Kw.call_ref) (set! res (eq (call type_node_id cg (call nth_child (call nth_child node 1) 3)) Ty.void)) (block))
          res)))

  ;; ===== Struct table & resolution =====
  ;; Index of the last `target` byte in the span, or -1.
  (fn find_last_char [cg:(ptr Cg) pos:i32 len:i32 target:i32] -> i32
    (let found:i32 -1)
    (loop i 0 (- len 1) 1
      (if (eq (mem.load8 (+ (get cg Cg.src) (+ pos i))) target) (set! found i) (block)))
    found)

  ;; Records every (struct ...) of the module with its layout; returns the
  ;; count. Past 255 structs or 64 fields: compile error 94.
  (fn collect_structs [cg:(ptr Cg) root:(ptr compiler.Node)] -> i32
    (let scount:i32 0)
    (let child:(ptr compiler.Node) (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (if (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.struct))
          (block
            (let sname_node:(ptr compiler.Node) (call nth_child child 1))
            (if (gte scount 255) (call set_compile_error CgErr.table_full) 0)
            (let si:(ptr StructInfo) (new StructInfo))
            (put si StructInfo.name_pos (call node_a sname_node))
            (put si StructInfo.name_len (call node_b sname_node))
            (put si StructInfo.fields (arr.new (ptr Field) 64))
            (let cur_offset:i32 0)
            (let max_align:i32 1)
            (let fcount:i32 0)
            (let fchild:(ptr compiler.Node) (call first_child (call nth_child child 2)))
            (while (neq fchild (ptr.null compiler.Node))
              (let type_node:(ptr compiler.Node) (call node_next (call node_next fchild)))
              (if (gte fcount 64) (call set_compile_error CgErr.table_full) 0)
              (let ftype:Ty (call type_node_id cg type_node))
              (if (call is_memory_type ftype) 0 (call set_compile_error CgErr.not_a_memory_type))
              (let fsize:i32 (call type_size ftype))
              (if (gt fsize max_align) (set! max_align fsize) (block))
              (set! cur_offset (bitand (+ cur_offset (- fsize 1)) (- 0 fsize)))
              (let f:(ptr Field) (new Field))
              (put f Field.name_pos (call node_a fchild))
              (put f Field.name_len (call node_b fchild))
              (put f Field.offset cur_offset)
              (put f Field.ty ftype)
              (arr.set (ptr Field) (get si StructInfo.fields) (if (gte fcount 64) 63 fcount) f)
              (set! cur_offset (+ cur_offset fsize))
              (if (lt fcount 64) (set! fcount (+ fcount 1)) (block))
              (if (neq type_node (ptr.null compiler.Node))
                  (set! fchild (call node_next type_node))
                  (set! fchild (ptr.null compiler.Node))))
            (put si StructInfo.size (bitand (+ cur_offset (- max_align 1)) (- 0 max_align)))
            (put si StructInfo.nfields fcount)
            (arr.set (ptr StructInfo) (get cg Cg.structs) (if (gte scount 255) 254 scount) si)
            (if (lt scount 255) (set! scount (+ scount 1)) (block)))
          (block))
      (set! child (call node_next child)))
    (put cg Cg.nstructs scount)
    scount)

  ;; The struct with this name, or null.
  (fn find_struct [cg:(ptr Cg) s_pos:i32 s_len:i32] -> (ptr StructInfo)
    (loop i 0 (- (get cg Cg.nstructs) 1) 1
      (let si:(ptr StructInfo) (arr.get (ptr StructInfo) (get cg Cg.structs) i))
      (if (call sym_eq cg s_pos s_len (+ (get cg Cg.src) (get si StructInfo.name_pos)) (get si StructInfo.name_len))
          (return si)
          (block)))
    (ptr.null StructInfo))

  ;; Field S.f (the first field of that name, as in checker.rs), or null.
  (fn find_field [cg:(ptr Cg) s_pos:i32 s_len:i32 f_pos:i32 f_len:i32] -> (ptr Field)
    (let si:(ptr StructInfo) (call find_struct cg s_pos s_len))
    (if (eq si (ptr.null StructInfo)) (return (ptr.null Field)) (block))
    (loop fj 0 (- (get si StructInfo.nfields) 1) 1
      (let f:(ptr Field) (arr.get (ptr Field) (get si StructInfo.fields) fj))
      (if (call sym_eq cg f_pos f_len (+ (get cg Cg.src) (get f Field.name_pos)) (get f Field.name_len))
          (return f)
          (block)))
    (ptr.null Field))

  (fn get_struct_size [cg:(ptr Cg) s_pos:i32 s_len:i32] -> i32
    (let si:(ptr StructInfo) (call find_struct cg s_pos s_len))
    (if (eq si (ptr.null StructInfo)) (block (call set_compile_error CgErr.unknown_struct_or_field) 0) (get si StructInfo.size)))

  (fn get_field_offset [cg:(ptr Cg) s_pos:i32 s_len:i32 f_pos:i32 f_len:i32] -> i32
    (let f:(ptr Field) (call find_field cg s_pos s_len f_pos f_len))
    (if (eq f (ptr.null Field)) (block (call set_compile_error CgErr.unknown_struct_or_field) 0) (get f Field.offset)))

  ;; The type of field S.f, or Ty.none if unknown.
  (fn get_field_type [cg:(ptr Cg) s_pos:i32 s_len:i32 f_pos:i32 f_len:i32] -> Ty
    (let f:(ptr Field) (call find_field cg s_pos s_len f_pos f_len))
    (if (eq f (ptr.null Field)) Ty.none (get f Field.ty)))

  ;; A bool read from memory is normalised to 0/1 (i32.const 0; i32.ne), as in wasm.rs normalize_bool.
  (fn emit_normalize_bool [o:(ptr Out)] -> void
    (call emit_i32_const o 0)
    (call put_byte o OP_I32_NE))




  ;; ===== Compile error signaling =====
  ;; Compile errors (AIPL_SPEC.md 6.4). The host reads the number from cell 4,
  ;; so the values are fixed.
  (enum CgErr [(memory_cap 90)            ;; mem.grow refused: more than 1024 pages
               (output_full 91)           ;; output or a function body passed 4 * src_len + 64 KiB
               (too_many_functions 92)    ;; more than 2048 functions, or 16 parameters
               (too_many_locals 93)       ;; more than 1024 locals in a function
               (table_full 94)            ;; 255 structs, 64 fields, or 31 call_ref signatures
               (not_a_memory_type 95)     ;; a field or element type that is not a scalar
               (unknown_struct_or_field 96)
               (wide_result_payload 97)   ;; an ok/err payload that is not 32-bit
               (unlowerable_type 98)
               (no_instruction_for_type 99) ;; e.g. % on f64, + on str
               (too_deeply_nested 100)    ;; more than 255 nested blocks
               (jump_outside_loop 101)
               (too_many_literals 768)
               (unknown_symbol 971)
               (inexact_float_literal 973)
               (unknown_enum_member 974)
               (unknown_form 987)
               (empty_expression 999)
               (undefined_function 1452)])

  ;; Records the first error only: later errors are usually consequences of it.
  (fn set_compile_error [e:CgErr] -> i32
    (if (eq (mem.load32 4) 0) (mem.store32 4 (enum.ord e)) (block))
    0)

  (fn has_compile_error [] -> bool
    (neq (mem.load32 4) 0))

  ;; mem.alloc that grows linear memory to cover the new block. mem.alloc only
  ;; moves the cursor; without this a large compile walks off the end of
  ;; memory. Sets compile error 90 if the 1024-page cap would be exceeded.
  (fn cg_alloc [n:i32] -> i32
    (let p:i32 (mem.alloc n))
    (let end:i32 (mem.load32 0))
    (let have:i32 (* (mem.grow 0) 65536))
    (if (gt end have)
        (if (eq (mem.grow (+ (/ (- end have) 65536) 1)) -1)
            (call set_compile_error CgErr.memory_cap)
            0)
        0)
    p)

  (fn alloc_src [len:i32] -> i32
    (mem.alloc len))

  ;; ===== String Interning =====
  ;; The address of the literal spelled by this span, or -1 if not interned.
  (fn find_interned_string [cg:(ptr Cg) pos:i32 len:i32] -> i32
    (loop i 0 (- (get cg Cg.nstrs) 1) 1
      (let e:(ptr StrLit) (arr.get (ptr StrLit) (get cg Cg.strs) i))
      (if (and (neq (get e StrLit.pos) -1) (call sym_eq cg pos len (+ (get cg Cg.src) (get e StrLit.pos)) (get e StrLit.len)))
          (return (get e StrLit.addr))
          (block)))
    -1)

  ;; The address of interned bytes equal to the n bytes at `bytes`, or -1.
  (fn find_interned_content [cg:(ptr Cg) bytes:i32 n:i32] -> i32
    (let blob:i32 (get (get cg Cg.blob) buf.Buf.data))
    (let off:i32 0)
    (let end:i32 (call buf.len (get cg Cg.blob)))
    (while (lt off end)
      (let k:i32 (mem.load32 (+ blob off)))
      (if (and (eq k n) (call bytes_equal (+ blob (+ off 4)) bytes n))
          (return (+ 1028 off))
          (block))
      (set! off (+ off (+ 4 k))))
    -1)

  (fn bytes_equal [a:i32 b:i32 n:i32] -> bool
    (loop i 0 (- n 1) 1
      (if (neq (mem.load8 (+ a i)) (mem.load8 (+ b i))) (return false) (block)))
    true)

  (fn add_str_entry [cg:(ptr Cg) pos:i32 len:i32 addr:i32] -> void
    (let e:(ptr StrLit) (new StrLit))
    (put e StrLit.pos pos)
    (put e StrLit.len len)
    (put e StrLit.addr addr)
    (arr.set (ptr StrLit) (get cg Cg.strs) (get cg Cg.nstrs) e)
    (put cg Cg.nstrs (+ (get cg Cg.nstrs) 1)))

  ;; Appends [len u32 LE][bytes] to the blob; returns the bytes' address.
  (fn append_to_blob [cg:(ptr Cg) bytes:i32 n:i32] -> i32
    (let blob:(ptr buf.Buf) (get cg Cg.blob))
    (let addr:i32 (+ 1028 (call buf.len blob)))
    (call buf.push_byte blob (bitand n 255))
    (call buf.push_byte blob (bitand (shr n 8) 255))
    (call buf.push_byte blob (bitand (shr n 16) 255))
    (call buf.push_byte blob (bitand (shr n 24) 255))
    (loop i 0 (- n 1) 1 (call buf.push_byte blob (mem.load8 (+ bytes i))))
    addr)

  ;; Interns the literal spelled by this span (escapes decoded) by content,
  ;; as wasm.rs string_layout does; returns its address. Past 64 KiB of
  ;; literals or 1364 spellings: compile error 768.
  (fn intern_string [cg:(ptr Cg) pos:i32 len:i32] -> i32
    (let existing:i32 (call find_interned_string cg pos len))
    (if (neq existing -1) (return existing) (block))
    (if (or (gt (+ (call buf.len (get cg Cg.blob)) (+ 4 len)) 65536) (gte (get cg Cg.nstrs) 1364))
        (block (call set_compile_error CgErr.too_many_literals) (return 1028))
        (block))
    (let text:(ptr buf.Buf) (call buf.make (+ len 1)))
    (let i:i32 0)
    (while (lt i len)
      (let b:i32 (mem.load8 (+ (get cg Cg.src) (+ pos i))))
      (if (and (eq b 92) (lt (+ i 1) len))
          (block
            (let nb:i32 (mem.load8 (+ (get cg Cg.src) (+ pos (+ i 1)))))
            (call buf.push_byte text
                  (cond
                    ((eq nb 110) 10)
                    ((eq nb 116) 9)
                    ((eq nb 114) 13)
                    ((eq nb 48) 0)
                    (else nb)))
            (set! i (+ i 2)))
          (block
            (call buf.push_byte text b)
            (set! i (+ i 1)))))
    ;; another spelling of the same text (or the reserved newline) shares it
    (let data:i32 (get text buf.Buf.data))
    (let addr:i32 (call find_interned_content cg data (call buf.len text)))
    (if (eq addr -1) (set! addr (call append_to_blob cg data (call buf.len text))) (block))
    (call add_str_entry cg pos len addr)
    addr)

  ;; The newline sys.print writes after each argument, interned once.
  (fn intern_newline [cg:(ptr Cg)] -> i32
    (if (eq (get cg Cg.newline) 0)
        (block
          (let nl:i32 (mem.alloc 8))
          (mem.store8 nl 10)
          (let addr:i32 (call append_to_blob cg nl 1))
          (call add_str_entry cg -1 1 addr)
          (put cg Cg.newline addr))
        (block))
    (get cg Cg.newline))

  ;; A wasm name: its length (LEB128), then its bytes. Returns the byte count.
  (fn emit_name [o:(ptr Out) s:str] -> void
    (call put_u32 o (str.len s))
    (loop i 0 (- (str.len s) 1) 1
      (call put_byte o (mem.load8 (+ (str.ptr s) i)))))




  ;; The import name of WASI function w (the order of wasm.rs Wasi).
  ;; The import name of a WASI function.
  (fn wasi_name [w:Wasi] -> str
    (cond
      ((eq w Wasi.fd_write) "fd_write")
      ((eq w Wasi.fd_read) "fd_read")
      ((eq w Wasi.path_open) "path_open")
      ((eq w Wasi.fd_close) "fd_close")
      ((eq w Wasi.proc_exit) "proc_exit")
      ((eq w Wasi.path_unlink_file) "path_unlink_file")
      ((eq w Wasi.args_sizes_get) "args_sizes_get")
      ((eq w Wasi.args_get) "args_get")
      ((eq w Wasi.environ_sizes_get) "environ_sizes_get")
      ((eq w Wasi.environ_get) "environ_get")
      ((eq w Wasi.thread_spawn) "thread-spawn")
      ((eq w Wasi.clock_time_get) "clock_time_get")
      (else "random_get")))

  ;; ===== WASI Import Detection =====
  ;; Cg.wasi holds, per WASI function, -1 (unused), 1 while marking it used,
  ;; then its function index (imports come first, in the fixed order).
  (fn mark_wasi_used [cg:(ptr Cg) w:Wasi] -> i32
    (arr.set i32 (get cg Cg.wasi) (enum.ord w) 1)
    0)

  (fn finalize_wasi_indices [cg:(ptr Cg)] -> i32
    (let count:i32 0)
    (loop i 0 12 1
      (if (eq (arr.get i32 (get cg Cg.wasi) i) 1)
          (block
            (arr.set i32 (get cg Cg.wasi) i count)
            (set! count (+ count 1)))
          (arr.set i32 (get cg Cg.wasi) i -1)))
    (put cg Cg.nimports count)
    count)

  (fn get_wasi_index [cg:(ptr Cg) w:Wasi] -> i32
    (arr.get i32 (get cg Cg.wasi) (enum.ord w)))

  ;; A module that uses thread.spawn is threaded (wasm.rs `threaded`).
  (fn threaded [cg:(ptr Cg)] -> bool
    (neq (call get_wasi_index cg Wasi.thread_spawn) -1))

  ;; ===== AST Walker for WASI & Strings =====
  (fn walk_ast_for_wasi [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (let kind:compiler.Kind (call node_kind node))
    (if (eq kind compiler.Kind.paren)
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (cond
            ((eq kw Kw.sys_print) (call mark_wasi_used cg Wasi.fd_write) 0)
            ((eq kw Kw.sys_exit) (call mark_wasi_used cg Wasi.proc_exit) 0)
            ((eq kw Kw.fs_open) (call mark_wasi_used cg Wasi.path_open) 0)
            ((eq kw Kw.fs_read) (call mark_wasi_used cg Wasi.fd_read) 0)
            ((eq kw Kw.fs_write) (call mark_wasi_used cg Wasi.fd_write) 0)
            ((eq kw Kw.fs_close) (call mark_wasi_used cg Wasi.fd_close) 0)
            ((eq kw Kw.fs_delete) (call mark_wasi_used cg Wasi.path_unlink_file) 0)
            ((eq kw Kw.args_sizes) (call mark_wasi_used cg Wasi.args_sizes_get) 0)
            ((eq kw Kw.args_get) (call mark_wasi_used cg Wasi.args_get) 0)
            ((eq kw Kw.env_sizes) (call mark_wasi_used cg Wasi.environ_sizes_get) 0)
            ((eq kw Kw.env_get) (call mark_wasi_used cg Wasi.environ_get) 0)
            ((eq kw Kw.thread_spawn) (call mark_wasi_used cg Wasi.thread_spawn) 0)
            ((or (eq kw Kw.sys_time) (eq kw Kw.sys_monotonic)) (call mark_wasi_used cg Wasi.clock_time_get) 0)
            ((eq kw Kw.sys_random) (call mark_wasi_used cg Wasi.random_get) 0)
            (else 0))
          (let child:(ptr compiler.Node) (call first_child node))
          (while (neq child (ptr.null compiler.Node)) (call walk_ast_for_wasi cg child) (set! child (call node_next child)))
          0)
        0))

  (fn walk_ast_for_strings [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (let kind:compiler.Kind (call node_kind node))
    (if (eq kind compiler.Kind.string)
        (call intern_string cg (call node_a node) (call node_b node))
        (if (eq kind compiler.Kind.paren)
            (block
              (let child:(ptr compiler.Node) (call first_child node))
              (while (neq child (ptr.null compiler.Node)) (call walk_ast_for_strings cg child) (set! child (call node_next child)))
              0)
            0)))

  ;; Encodes a (fn [..] -> r) type node as [nparams, valtypes..., nresults, result]
  ;; at out (wasm-level, so (fn [bool] -> i32) and (fn [i32] -> i32) coincide).
  ;; The wasm signature of a (fn [..] -> r) type node.
  (fn encode_sig [cg:(ptr Cg) sig:(ptr compiler.Node)] -> (ptr Sig)
    (let out:(ptr Sig) (new Sig))
    (put out Sig.params (arr.new i32 16))
    (let n:i32 0)
    (let p:(ptr compiler.Node) (call first_child (call nth_child sig 1)))
    (while (neq p (ptr.null compiler.Node))
      (if (lt n 16)
          (arr.set i32 (get out Sig.params) n (call type_id_to_valtype (call type_node_id cg p)))
          (block (call set_compile_error CgErr.too_many_functions) (block)))
      (set! n (+ n 1))
      (set! p (call node_next p)))
    (put out Sig.nparams (if (lt n 16) n 16))
    (let ret:Ty (call type_node_id cg (call nth_child sig 3)))
    (put out Sig.has_result (neq ret Ty.void))
    (put out Sig.result (if (eq ret Ty.void) 0 (call type_id_to_valtype ret)))
    out)

  (fn sig_eq [a:(ptr Sig) b:(ptr Sig)] -> bool
    (if (or (neq (get a Sig.nparams) (get b Sig.nparams))
            (or (neq (get a Sig.has_result) (get b Sig.has_result)) (neq (get a Sig.result) (get b Sig.result))))
        (return false)
        (block))
    (loop i 0 (- (get a Sig.nparams) 1) 1
      (if (neq (arr.get i32 (get a Sig.params) i) (arr.get i32 (get b Sig.params) i)) (return false) (block)))
    true)

  ;; The index of a signature among the module's call_ref signatures, adding
  ;; it if new (past 31: compile error 94).
  (fn add_sig [cg:(ptr Cg) s:(ptr Sig)] -> i32
    (let count:i32 (get cg Cg.nsigs))
    (loop i 0 (- count 1) 1
      (if (call sig_eq (arr.get (ptr Sig) (get cg Cg.sigs) i) s) (return i) (block)))
    (if (gte count 31) (block (call set_compile_error CgErr.table_full) (return 30)) (block))
    (arr.set (ptr Sig) (get cg Cg.sigs) count s)
    (put cg Cg.nsigs (+ count 1))
    count)

  ;; Index of the signature of a call_ref's type node, adding it if new.
  (fn sig_index [cg:(ptr Cg) sig:(ptr compiler.Node)] -> i32
    (call add_sig cg (call encode_sig cg sig)))

  ;; Threaded modules call workers through the table as (fn [i32] -> i32);
  ;; registered after the walk, as wasm.rs appends it. Returns its index.
  (fn worker_sig_index [cg:(ptr Cg)] -> i32
    (let w:(ptr Sig) (new Sig))
    (put w Sig.params (arr.new i32 1))
    (arr.set i32 (get w Sig.params) 0 127)
    (put w Sig.nparams 1)
    (put w Sig.has_result true)
    (put w Sig.result 127)
    (call add_sig cg w))

  ;; Marks the module as using function refs and collects call_ref signatures
  ;; in source order, as wasm.rs walk_module does.
  (fn walk_ast_for_refs [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (if (eq (call node_kind node) compiler.Kind.paren)
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (if (or (eq kw Kw.ref) (eq kw Kw.call_ref)) (put cg Cg.uses_refs true) (block))
          (if (eq kw Kw.call_ref) (call sig_index cg (call nth_child node 1)) 0)
          (let child:(ptr compiler.Node) (call first_child node))
          (while (neq child (ptr.null compiler.Node))
            (call walk_ast_for_refs cg child)
            (set! child (call node_next child)))
          0)
        0))

  (fn walk_module_prepass [cg:(ptr Cg) root:(ptr compiler.Node)] -> i32
    ;; Pass 1: WASI detection
    (let child:(ptr compiler.Node) (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (if (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.fn))
          (block
            (let bchild:(ptr compiler.Node) (call nth_child child 5))
            (while (neq bchild (ptr.null compiler.Node))
              (call walk_ast_for_wasi cg bchild)
              (set! bchild (call node_next bchild))))
          (block))
      (set! child (call node_next child)))

    (call finalize_wasi_indices cg)

    ;; Pass 2: Intern newline if sys.print is present and fd_write used
    (if (and (neq (call get_wasi_index cg Wasi.fd_write) -1) (call ast_uses_sys_print cg root))
        (block (call intern_newline cg) 0)
        0)

    ;; Pass 3: Intern string literals
    (set! child (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (if (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.fn))
          (block
            (let bchild:(ptr compiler.Node) (call nth_child child 5))
            (while (neq bchild (ptr.null compiler.Node))
              (call walk_ast_for_strings cg bchild)
              (call walk_ast_for_refs cg bchild)
              (set! bchild (call node_next bchild))))
          (block))
      (set! child (call node_next child)))
    0)

  (fn ast_uses_sys_print [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (if (neq (call node_kind node) compiler.Kind.paren)
        false
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (if (eq kw Kw.sys_print)
              true
              (block
                (let child:(ptr compiler.Node) (call first_child node))
                (let found:bool false)
                (while (neq child (ptr.null compiler.Node))
                  (if (call ast_uses_sys_print cg child)
                      (set! found true)
                      (block))
                  (set! child (call node_next child)))
                found)))))

  ;; Ops whose lowering uses the two extra scratch locals (wasm.rs
  ;; fn_uses_io): the WASI ops, arr.new, thread.spawn, and the atomics that
  ;; wait or compare.
  (fn needs_io_scratch [k:Kw] -> bool
    (cond
      ((or (eq k Kw.sys_print) (or (eq k Kw.sys_exit) (or (eq k Kw.fs_open) (or (eq k Kw.fs_read)
          (or (eq k Kw.fs_write) (or (eq k Kw.fs_close) (eq k Kw.fs_delete))))))) true)
      ((or (eq k Kw.args_sizes) (or (eq k Kw.args_get) (or (eq k Kw.env_sizes) (or (eq k Kw.env_get) (eq k Kw.thread_spawn))))) true)
      ((or (eq k Kw.arr_new) (or (eq k Kw.atomic_cas) (or (eq k Kw.atomic_lock) (eq k Kw.atomic_unlock)))) true)
      (else (or (eq k Kw.sys_time) (or (eq k Kw.sys_monotonic) (eq k Kw.sys_random))))))

  ;; Check if function uses I/O ops
  (fn ast_uses_io [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (if (neq (call node_kind node) compiler.Kind.paren)
        false
        (block
          (if (call needs_io_scratch (call group_head_keyword cg node))
              true
              (block
                (let child:(ptr compiler.Node) (call first_child node))
                (let found:bool false)
                (while (neq child (ptr.null compiler.Node))
                  (if (call ast_uses_io cg child)
                      (set! found true)
                      (block))
                  (set! child (call node_next child)))
                found)))))

  (fn fn_uses_io [cg:(ptr Cg) fndef_group:(ptr compiler.Node)] -> bool
    (let bchild:(ptr compiler.Node) (call nth_child fndef_group 5))
    (let found:bool false)
    (while (neq bchild (ptr.null compiler.Node))
      (if (call ast_uses_io cg bchild)
          (set! found true)
          (block))
      (set! bchild (call node_next bchild)))
    found)

  ;; Payload of (ok v) / (err e), skipping the `: T` of (ok:T v) / (err:T e).
  (fn result_payload [node:(ptr compiler.Node)] -> (ptr compiler.Node)
    (if (eq (call node_kind (call nth_child node 1)) compiler.Kind.colon)
        (call nth_child node 3)
        (call nth_child node 1)))

  ;; ===== Static expression types (mirrors expr_type in wasm.rs) =====
  (fn node_type [cg:(ptr Cg) node:(ptr compiler.Node)] -> Ty
    (let kind:compiler.Kind (call node_kind node))
    (let res:Ty Ty.i32)
    (if (eq kind compiler.Kind.bool) (set! res Ty.bool) (block))
    (if (eq kind compiler.Kind.string) (set! res Ty.str) (block))
    (if (eq kind compiler.Kind.int64) (set! res Ty.i64) (block))
    (if (eq kind compiler.Kind.float) (set! res Ty.f64) (block))
    (if (eq kind compiler.Kind.symbol)
        (block
          (let idx:i32 (call find_local cg (call node_a node) (call node_b node)))
          (if (neq idx -1) (set! res (get (call local_at cg idx) Local.ty)) (block)))
        (block))
    (if (eq kind compiler.Kind.paren) (set! res (call group_type cg node)) (block))
    res)

  ;; Type of the last expression of a body starting at `first` (void if empty).
  (fn body_type [cg:(ptr Cg) first:(ptr compiler.Node)] -> Ty
    (if (eq first (ptr.null compiler.Node))
        Ty.void
        (block
          (let cur:(ptr compiler.Node) first)
          (while (neq (call node_next cur) (ptr.null compiler.Node)) (set! cur (call node_next cur)))
          (call node_type cg cur))))

  (fn group_type [cg:(ptr Cg) node:(ptr compiler.Node)] -> Ty
    (let kw:Kw (call group_head_keyword cg node))
    (let res:Ty Ty.i32)
    ;; let, set!, loop, while, put, arr.set, stores, sys.print, sys.exit
    (if (or (eq kw Kw.let) (or (eq kw Kw.set) (or (eq kw Kw.loop) (or (eq kw Kw.while) (or (eq kw Kw.put) (eq kw Kw.arr_set))))))
        (set! res Ty.void) (block))
    (if (or (eq kw Kw.mem_store8) (or (eq kw Kw.mem_store32) (or (eq kw Kw.mem_store64) (or (eq kw Kw.sys_print) (eq kw Kw.sys_exit))))) (set! res Ty.void) (block))
    ;; return, break, continue are statements
    (if (call is_jump kw) (set! res Ty.void) (block))
    ;; cond: the type of its first clause's body (the desugared if's then branch)
    (if (eq kw Kw.cond) (set! res (call body_type cg (call node_next (call first_child (call nth_child node 1))))) (block))
    (if (eq kw Kw.if) (set! res (call node_type cg (call nth_child node 2))) (block))
    (if (eq kw Kw.block) (set! res (call body_type cg (call node_next (call first_child node)))) (block))
    (if (eq kw Kw.match_result)
        (set! res (call body_type cg (call node_next (call node_next (call first_child (call nth_child node 2))))))
        (block))
    (if (eq kw Kw.call)
        (block
          (let fname:(ptr compiler.Node) (call nth_child node 1))
          (let fidx:i32 (call find_function cg (call node_a fname) (call node_b fname)))
          (if (neq fidx -1) (set! res (get (call func_entry_ptr cg fidx) FnInfo.ret)) (block)))
        (block))
    ;; ok / err: the payload's type, as expr_type does
    (if (or (eq kw Kw.ok) (eq kw Kw.err)) (set! res (call node_type cg (call result_payload node))) (block))
    (if (eq kw Kw.get)
        (block
          (let sf_node:(ptr compiler.Node) (call nth_child node 2))
          (let sf_pos:i32 (call node_a sf_node))
          (let sf_len:i32 (call node_b sf_node))
          (let dot_idx:i32 (call find_last_char cg sf_pos sf_len 46))
          (let ft:Ty (call get_field_type cg sf_pos dot_idx (+ sf_pos (+ dot_idx 1)) (- sf_len (+ dot_idx 1))))
          (if (neq ft Ty.none) (set! res ft) (block)))
        (block))
    (if (eq kw Kw.arr_get) (set! res (call type_node_id cg (call nth_child node 1))) (block))
    ;; arithmetic and bitwise: the first operand's type
    (if (call is_arith kw)
        (set! res (call node_type cg (call nth_child node 1)))
        (block))
    ;; comparisons and logic
    (if (call is_compare kw) (set! res Ty.bool) (block))
    ;; mem.load64, i64.extend_s, i64.extend_u, i64.trunc_f64_s, i64.reinterpret_f64
    (if (or (eq kw Kw.mem_load64) (or (eq kw Kw.i64_extend_s) (or (eq kw Kw.i64_extend_u) (or (eq kw Kw.i64_trunc_f64_s) (eq kw Kw.i64_reinterpret_f64))))) (set! res Ty.i64) (block))
    (if (eq kw Kw.ref) (set! res Ty.fn) (block))
    ;; sys.time / sys.monotonic -> i64
    (if (or (eq kw Kw.sys_time) (eq kw Kw.sys_monotonic)) (set! res Ty.i64) (block))
    ;; atomic.cas -> bool; atomic.lock / unlock are statements
    (if (eq kw Kw.atomic_cas) (set! res Ty.bool) (block))
    (if (or (eq kw Kw.atomic_lock) (eq kw Kw.atomic_unlock)) (set! res Ty.void) (block))
    (if (eq kw Kw.call_ref) (set! res (call type_node_id cg (call nth_child (call nth_child node 1) 3))) (block))
    ;; new, ptr.null, ptr.cast -> (ptr S); arr.new, arr.null, arr.cast -> (arr T)
    (if (or (eq kw Kw.new) (or (eq kw Kw.ptr_null) (eq kw Kw.ptr_cast))) (set! res Ty.ptr) (block))
    (if (or (eq kw Kw.arr_new) (or (eq kw Kw.arr_null) (eq kw Kw.arr_cast))) (set! res Ty.arr) (block))
    ;; f64.convert_i64_s, f64.reinterpret_i64, f64.sqrt
    (if (or (eq kw Kw.f64_convert_i64_s) (or (eq kw Kw.f64_reinterpret_i64) (eq kw Kw.f64_sqrt))) (set! res Ty.f64) (block))
    res)

  ;; ===== Expression / statement codegen =====
  (fn compile_expr [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (if (eq node (ptr.null compiler.Node))
        (block (call set_compile_error CgErr.empty_expression) (return))
        (block))
    (let kind:compiler.Kind (call node_kind node))
    (cond
      ((or (eq kind compiler.Kind.int) (eq kind compiler.Kind.bool)) (call emit_i32_const o (call node_a node)))
      ((eq kind compiler.Kind.int64)
       (call put_byte o OP_I64_CONST)
       (call put_s64 o (call parse_i64_literal cg (call node_a node) (call node_b node))))
      ((eq kind compiler.Kind.float) (call emit_f64_literal o cg (call node_a node) (call node_b node)))
      ((eq kind compiler.Kind.string)
       (call emit_i32_const o (call find_interned_string cg (call node_a node) (call node_b node))))
      ((eq kind compiler.Kind.symbol)
       (let idx:i32 (call find_local cg (call node_a node) (call node_b node)))
       (if (eq idx -1)
           (block (call set_compile_error CgErr.unknown_symbol) (call emit_i32_const o 0))
           (call emit_local_get o idx)))
      (else (call compile_group cg node o))))




  (fn compile_group [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let kw:Kw (call group_head_keyword cg node))
    (cond
      ((eq kw Kw.let) (call compile_let cg node o))
      ((eq kw Kw.set) (call compile_set cg node o))
      ((eq kw Kw.if) (call compile_if cg node o))
      ((eq kw Kw.loop) (call compile_loop cg node o))
      ((eq kw Kw.while) (call compile_while cg node o))
      ((eq kw Kw.call) (call compile_call cg node o))
      ((eq kw Kw.block) (call compile_block cg node o))
      ((eq kw Kw.match_result) (call compile_match_result cg node o))
      ((eq kw Kw.cond) (call compile_cond_from cg (call nth_child node 1) o))
      ((neq kw Kw.none) (call compile_op cg kw node o))
      (else (call set_compile_error CgErr.unknown_form) (call emit_i32_const o 0))))




  (fn compile_match_result [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let expr_node:(ptr compiler.Node) (call nth_child node 1))
    (let ok_group:(ptr compiler.Node) (call nth_child node 2))
    (let err_group:(ptr compiler.Node) (call nth_child node 3))
    (let scratch:i32 (get cg Cg.nlocals))
    (call compile_expr cg expr_node o)
    (call emit_local_set o scratch)
    (call emit_local_get o scratch)
    (call emit_memop o OP_I32_LOAD 2)
    (call put_byte o OP_I32_EQZ)
    (let ok_last:(ptr compiler.Node) (call last_child ok_group))
    (let is_void:bool (call is_void_node cg ok_last))
    (let block_ty:i32 64)
    (if is_void (set! block_ty 64) (set! block_ty (call block_type_byte (call node_type cg ok_last))))
    (call put_byte o OP_IF) (call put_byte o block_ty)
    (call label_push cg Label.if_else)
    (let ok_var_node:(ptr compiler.Node) (call nth_child ok_group 1))
    (let ok_var_idx:i32 (call find_local cg (call node_a ok_var_node) (call node_b ok_var_node)))
    (if (neq ok_var_idx -1)
        (block
          (call emit_local_get o scratch)
          (call emit_memop_offset o OP_I32_LOAD 2 4)
          (call emit_local_set o ok_var_idx)
          0)
        0)
    (let ok_body_first:(ptr compiler.Node) (call node_next (call node_next (call first_child ok_group))))
    (call compile_stmt_seq cg ok_body_first o)
    (call put_byte o OP_ELSE)
    (let err_var_node:(ptr compiler.Node) (call nth_child err_group 1))
    (let err_var_idx:i32 (call find_local cg (call node_a err_var_node) (call node_b err_var_node)))
    (if (neq err_var_idx -1)
        (block
          (call emit_local_get o scratch)
          (call emit_memop_offset o OP_I32_LOAD 2 4)
          (call emit_local_set o err_var_idx)
          0)
        0)
    (let err_body_first:(ptr compiler.Node) (call node_next (call node_next (call first_child err_group))))
    (call compile_stmt_seq cg err_body_first o)
    (call label_pop cg)
    (call put_byte o OP_END))



  ;; The address of runtime cell `cell` (64-87): the cell itself, or in a
  ;; threaded module the same offset in this thread's block (global 0).
  (fn emit_rt [cg:(ptr Cg) o:(ptr Out) cell:i32] -> void
    (if (call threaded cg)
        (block
          (call put_byte o OP_GLOBAL_GET) ;; global.get 0
          (call put_byte o 0)
          (if (neq cell 64)
              (block
                (call emit_i32_const o (- cell 64))
                (call put_byte o OP_I32_ADD))
              (block)))
        (call emit_i32_const o cell)))




  (fn emit_errno_to_result [cg:(ptr Cg) o:(ptr Out) out_cell:i32] -> void
    (call put_byte o OP_IF) (call put_byte o VT_I32)
    (call emit_i32_const o -1)
    (call put_byte o OP_ELSE)
    (if (gte out_cell 0)
        (block
          (call emit_rt cg o out_cell)
          (call emit_memop o OP_I32_LOAD 2))
        (call emit_i32_const o 0))
    (call put_byte o OP_END))



  (fn compile_op [cg:(ptr Cg) op_id:Kw node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let import_cnt:i32 (get cg Cg.nimports))
    (let io_a:i32 (+ (get cg Cg.nlocals) 1))
    (let io_b:i32 (+ (get cg Cg.nlocals) 2))
    (let done:bool false)

    (if (eq op_id Kw.mem_load8)
        (block (call compile_expr cg (call nth_child node 1) o) (call emit_memop o OP_I32_LOAD8_U 0) (set! done true))
        (block))
    (if (eq op_id Kw.mem_load32)
        (block (call compile_expr cg (call nth_child node 1) o) (call emit_memop o OP_I32_LOAD 2) (set! done true))
        (block))
    (if (eq op_id Kw.mem_load64)
        (block (call compile_expr cg (call nth_child node 1) o) (call emit_memop o OP_I64_LOAD 3) (set! done true))
        (block))
    (if (eq op_id Kw.mem_store8)
        (block (call compile_expr cg (call nth_child node 1) o) (call emit_store_guard cg o (get cg Cg.nlocals)) (call compile_expr cg (call nth_child node 2) o) (call emit_memop o OP_I32_STORE8 0) (set! done true))
        (block))
    (if (eq op_id Kw.mem_store32)
        (block (call compile_expr cg (call nth_child node 1) o) (call emit_store_guard cg o (get cg Cg.nlocals)) (call compile_expr cg (call nth_child node 2) o) (call emit_memop o OP_I32_STORE 2) (set! done true))
        (block))
    (if (eq op_id Kw.mem_store64)
        (block (call compile_expr cg (call nth_child node 1) o) (call emit_store_guard cg o (get cg Cg.nlocals)) (call compile_expr cg (call nth_child node 2) o) (call emit_memop o OP_I64_STORE 3) (set! done true))
        (block))
    (if (eq op_id Kw.not)
        (block (call compile_expr cg (call nth_child node 1) o) (call put_byte o OP_I32_EQZ) (set! done true))
        (block))
    (if (eq op_id Kw.str_len) ;; str.len -> i32.const 4, i32.sub, i32.load
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_i32_const o 4)
          (call put_byte o OP_I32_SUB)
          (call emit_memop o OP_I32_LOAD 2)
          (set! done true))
        (block))
    (if (eq op_id Kw.str_ptr) ;; str.ptr -> identity
        (block (call compile_expr cg (call nth_child node 1) o) (set! done true))
        (block))
    (if (eq op_id Kw.sys_print) ;; sys.print
        (block
          (let arg:(ptr compiler.Node) (call node_next (call first_child node)))
          (while (neq arg (ptr.null compiler.Node))
            (call compile_expr cg arg o)
            (call emit_local_set o (get cg Cg.nlocals))
            ;; iov0 = { ptr, len }
            (call emit_rt cg o 64)
            (call emit_local_get o (get cg Cg.nlocals))
            (call emit_memop o OP_I32_STORE 2)
            (call emit_rt cg o 68)
            (call emit_local_get o (get cg Cg.nlocals))
            (call emit_i32_const o 4)
            (call put_byte o OP_I32_SUB) ;; sub
            (call emit_memop o OP_I32_LOAD 2) ;; load
            (call emit_memop o OP_I32_STORE 2)
            ;; iov1 = { "\n", 1 }
            (let nl_addr:i32 (get cg Cg.newline))
            (call emit_rt cg o 72)
            (call emit_i32_const o nl_addr)
            (call emit_memop o OP_I32_STORE 2)
            (call emit_rt cg o 76)
            (call emit_i32_const o 1)
            (call emit_memop o OP_I32_STORE 2)
            ;; Call fd_write (1, iovs=64, iovs_len=1, nwritten=80)
            (call emit_i32_const o 1)
            (call emit_rt cg o 64)
            (call emit_i32_const o 1)
            (call emit_rt cg o 80)
            (call emit_call o (call get_wasi_index cg Wasi.fd_write))
            (call put_byte o OP_DROP) ;; drop
            ;; Call fd_write (1, iovs=72, iovs_len=1, nwritten=80)
            (call emit_i32_const o 1)
            (call emit_rt cg o 72)
            (call emit_i32_const o 1)
            (call emit_rt cg o 80)
            (call emit_call o (call get_wasi_index cg Wasi.fd_write))
            (call put_byte o OP_DROP) ;; drop
            
            (set! arg (call node_next arg)))
          (set! done true))
        (block))
    (if (eq op_id Kw.sys_exit) ;; sys.exit
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_call o (call get_wasi_index cg Wasi.proc_exit)) (set! done true))
        (block))
    (if (eq op_id Kw.fs_open) ;; fs.open (path_ptr, path_len, flags)
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call compile_expr cg (call nth_child node 3) o)
          (call emit_local_set o io_b)
          (call emit_local_set o io_a)
          (call emit_local_set o (get cg Cg.nlocals))
          (call emit_path_dir o (get cg Cg.nlocals) io_a)
          ;; dirflags = 0
          (call emit_i32_const o 0)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_local_get o io_a)
          ;; oflags
          (call emit_local_get o io_b)
          (call put_byte o OP_IF) (call put_byte o VT_I32) ;; if(i32)
          (call emit_i32_const o 9) ;; CREAT|TRUNC (1|8 = 9)
          (call put_byte o OP_ELSE)
          (call emit_i32_const o 0)
          (call put_byte o OP_END)
          ;; fs_rights_base (i64)
          (call emit_local_get o io_b)
          (call put_byte o OP_IF) (call put_byte o VT_I64) ;; if(i64)
          (call put_byte o OP_I64_CONST) ;; i64.const 66 (2|64 = 66)
          (call put_s32 o 66)
          (call put_byte o OP_ELSE)
          (call put_byte o OP_I64_CONST) ;; i64.const 2
          (call put_s32 o 2)
          (call put_byte o OP_END)
          ;; fs_rights_inheriting (i64) = 0
          (call put_byte o OP_I64_CONST) ;; i64.const 0
          (call put_s32 o 0)
          ;; fdflags = 0
          (call emit_i32_const o 0)
          ;; out_fd cell RT_OPENED_FD = 84
          (call emit_rt cg o 84)
          (call emit_call o (call get_wasi_index cg Wasi.path_open))
          (call emit_errno_to_result cg o 84)
          (set! done true))
        (block))
    (if (eq op_id Kw.fs_read) ;; fs.read (fd, buf_ptr, max_len)
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call compile_expr cg (call nth_child node 3) o)
          (call emit_local_set o io_b)
          (call emit_local_set o io_a)
          (call emit_local_set o (get cg Cg.nlocals))
          ;; iov0: RT_IOV0_BUF = 64
          (call emit_rt cg o 64)
          (call emit_local_get o io_a)
          (call emit_memop o OP_I32_STORE 2)
          ;; iov0: RT_IOV0_LEN = 68
          (call emit_rt cg o 68)
          (call emit_local_get o io_b)
          (call emit_memop o OP_I32_STORE 2)
          ;; call fd_read(fd, iovs=64, iovs_len=1, nread=80)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_rt cg o 64)
          (call emit_i32_const o 1)
          (call emit_rt cg o 80)
          (call emit_call o (call get_wasi_index cg Wasi.fd_read))
          (call emit_errno_to_result cg o 80)
          (set! done true))
        (block))
    (if (eq op_id Kw.fs_write) ;; fs.write (fd, buf_ptr, len)
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call compile_expr cg (call nth_child node 3) o)
          (call emit_local_set o io_b)
          (call emit_local_set o io_a)
          (call emit_local_set o (get cg Cg.nlocals))
          ;; iov0: RT_IOV0_BUF = 64
          (call emit_rt cg o 64)
          (call emit_local_get o io_a)
          (call emit_memop o OP_I32_STORE 2)
          ;; iov0: RT_IOV0_LEN = 68
          (call emit_rt cg o 68)
          (call emit_local_get o io_b)
          (call emit_memop o OP_I32_STORE 2)
          ;; call fd_write(fd, iovs=64, iovs_len=1, nwritten=80)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_rt cg o 64)
          (call emit_i32_const o 1)
          (call emit_rt cg o 80)
          (call emit_call o (call get_wasi_index cg Wasi.fd_write))
          (call emit_errno_to_result cg o 80)
          (set! done true))
        (block))
    (if (eq op_id Kw.fs_close) ;; fs.close (fd)
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_call o (call get_wasi_index cg Wasi.fd_close))
          (call emit_errno_to_result cg o -1)
          (set! done true))
        (block))
    (if (neq (call proc_wasi op_id) Wasi.none) ;; args.sizes, args.get, env.sizes, env.get (a, b)
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_call o (call get_wasi_index cg (call proc_wasi op_id)))
          (call emit_errno_to_result cg o -1)
          (set! done true))
        (block))
    (if (eq op_id Kw.fs_delete) ;; fs.delete (path_ptr, path_len)
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_local_set o io_a)
          (call emit_local_set o (get cg Cg.nlocals))
          (call emit_path_dir o (get cg Cg.nlocals) io_a)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_local_get o io_a)
          (call emit_call o (call get_wasi_index cg Wasi.path_unlink_file))
          (call emit_errno_to_result cg o -1)
          (set! done true))
        (block))
    (if (eq op_id Kw.mem_alloc) ;; mem.alloc (size) -> i32.const 0, size rounded to 8, i32.atomic.rmw.add
        (block
          (call emit_i32_const o 0)
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_round8 o)
          (call emit_rmw_add o)
          (call emit_grow_to_cursor o)
          (set! done true))
        (block))
    (if (eq op_id Kw.mem_grow) ;; mem.grow (pages) -> memory.grow 0
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call put_byte o OP_MEMORY_GROW)
          (call put_byte o 0)
          (set! done true))
        (block))
    (if (eq op_id Kw.i64_extend_s) ;; i64.extend_s
        (block (call compile_expr cg (call nth_child node 1) o) (call put_byte o OP_I64_EXTEND_I32_S) (set! done true))
        (block))
    (if (eq op_id Kw.i64_extend_u) ;; i64.extend_u
        (block (call compile_expr cg (call nth_child node 1) o) (call put_byte o OP_I64_EXTEND_I32_U) (set! done true))
        (block))
    (if (eq op_id Kw.i32_wrap) ;; i32.wrap
        (block (call compile_expr cg (call nth_child node 1) o) (call put_byte o OP_I32_WRAP_I64) (set! done true))
        (block))
    (if (eq op_id Kw.f64_convert_i64_s) ;; f64.convert_i64_s
        (block (call compile_expr cg (call nth_child node 1) o) (call put_byte o OP_F64_CONVERT_I64_S) (set! done true))
        (block))
    (if (eq op_id Kw.f64_sqrt) ;; f64.sqrt
        (block (call compile_expr cg (call nth_child node 1) o) (call put_byte o OP_F64_SQRT) (set! done true))
        (block))
    (if (eq op_id Kw.i64_trunc_f64_s) ;; i64.trunc_f64_s
        (block (call compile_expr cg (call nth_child node 1) o) (call put_byte o OP_I64_TRUNC_F64_S) (set! done true))
        (block))
    (if (eq op_id Kw.f64_reinterpret_i64) ;; f64.reinterpret_i64
        (block (call compile_expr cg (call nth_child node 1) o) (call put_byte o OP_F64_REINTERPRET_I64) (set! done true))
        (block))
    (if (eq op_id Kw.i64_reinterpret_f64) ;; i64.reinterpret_f64
        (block (call compile_expr cg (call nth_child node 1) o) (call put_byte o OP_I64_REINTERPRET_F64) (set! done true))
        (block))
    (if (or (eq op_id Kw.ptr_null) (eq op_id Kw.arr_null)) ;; ptr.null / arr.null -> i32.const 0
        (block (call emit_i32_const o 0) (set! done true))
        (block))
    (if (or (eq op_id Kw.ptr_cast) (eq op_id Kw.arr_cast)) ;; ptr.cast / arr.cast: the address itself
        (block (call compile_expr cg (call nth_child node 2) o) (set! done true))
        (block))
    (if (or (eq op_id Kw.ptr_addr) (eq op_id Kw.arr_addr)) ;; ptr.addr / arr.addr: the pointer itself
        (block (call compile_expr cg (call nth_child node 1) o) (set! done true))
        (block))
    (if (eq op_id Kw.arr_len) ;; arr.len -> i32.const 4, i32.sub, i32.load (like str.len)
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_i32_const o 4)
          (call put_byte o OP_I32_SUB)
          (call emit_memop o OP_I32_LOAD 2) (set! done true))
        (block))
    (if (eq op_id Kw.ref) ;; ref f -> i32.const (f's position, its table slot)
        (block
          (let fname:(ptr compiler.Node) (call nth_child node 1))
          (let fidx:i32 (call find_function cg (call node_a fname) (call node_b fname)))
          (if (eq fidx -1) (call set_compile_error CgErr.undefined_function) 0)
          (call emit_i32_const o fidx) (set! done true))
        (block))
    (if (eq op_id Kw.call_ref) ;; call_ref sig f args... -> args, f, call_indirect
        (block
          (let arg:(ptr compiler.Node) (call nth_child node 3))
          (while (neq arg (ptr.null compiler.Node))
            (call compile_expr cg arg o)
            (set! arg (call node_next arg)))
          (call compile_expr cg (call nth_child node 2) o)
          (call put_byte o OP_CALL_INDIRECT)
          (let tidx:i32 (+ (get cg Cg.nimports) (+ (get cg Cg.nfns) (call sig_index cg (call nth_child node 1)))))
          (call put_u32 o tidx)
          (call put_byte o 0)
          (set! done true))
        (block))
    (if (eq op_id Kw.return) ;; return [v] -> v; return
        (block
          (if (neq (call nth_child node 1) (ptr.null compiler.Node))
              (call compile_expr cg (call nth_child node 1) o)
              (block))
          (call put_byte o OP_RETURN) (set! done true))
        (block))
    (if (eq op_id Kw.break) ;; break -> br to the innermost loop exit block
        (block
          (call put_byte o OP_BR)
          (call put_u32 o (call label_depth cg Label.loop_exit Label.loop_exit)) (set! done true))
        (block))
    (if (eq op_id Kw.continue) ;; continue -> br to the innermost loop header or loop-body block
        (block
          (call put_byte o OP_BR)
          (call put_u32 o (call label_depth cg Label.loop_header Label.loop_body)) (set! done true))
        (block))
    (if (eq op_id Kw.ok) ;; ok
        (block
          (if (neq (call type_id_to_valtype (call node_type cg (call result_payload node))) 127)
              (call set_compile_error CgErr.wide_result_payload)
              0)
          (call emit_i32_const o 0)
          (call emit_i32_const o 8)
          (call emit_rmw_add o)
          (call emit_local_set o (get cg Cg.nlocals))
          (call emit_grow_to_cursor o)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_i32_const o 0)
          (call emit_memop o OP_I32_STORE 2)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_local_get o (get cg Cg.nlocals))
          (call compile_expr cg (call result_payload node) o)
          (call emit_memop_offset o OP_I32_STORE 2 4)
          (set! done true))
        (block))
    (if (eq op_id Kw.err) ;; err
        (block
          (if (neq (call type_id_to_valtype (call node_type cg (call result_payload node))) 127)
              (call set_compile_error CgErr.wide_result_payload)
              0)
          (call emit_i32_const o 0)
          (call emit_i32_const o 8)
          (call emit_rmw_add o)
          (call emit_local_set o (get cg Cg.nlocals))
          (call emit_grow_to_cursor o)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_i32_const o 1)
          (call emit_memop o OP_I32_STORE 2)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_local_get o (get cg Cg.nlocals))
          (call compile_expr cg (call result_payload node) o)
          (call emit_memop_offset o OP_I32_STORE 2 4)
          (set! done true))
        (block))
    (if (eq op_id Kw.new) ;; new Struct
        (block
          (let snode:(ptr compiler.Node) (call nth_child node 1))
          (let size:i32 (call get_struct_size cg (call node_a snode) (call node_b snode)))
          (call emit_i32_const o 0)
          (call emit_i32_const o (bitand (+ size 7) -8))
          (call emit_rmw_add o)
          (call emit_grow_to_cursor o)
          (set! done true))
        (block))
    (if (eq op_id Kw.get) ;; get ptr Struct.field: load by field type at its offset
        (block
          (let ptr_node:(ptr compiler.Node) (call nth_child node 1))
          (let sf_node:(ptr compiler.Node) (call nth_child node 2))
          (let sf_pos:i32 (call node_a sf_node))
          (let sf_len:i32 (call node_b sf_node))
          (let dot_idx:i32 (call find_last_char cg sf_pos sf_len 46))
          (let f_offset:i32 (call get_field_offset cg sf_pos dot_idx (+ sf_pos (+ dot_idx 1)) (- sf_len (+ dot_idx 1))))
          (let ftype:Ty (call get_field_type cg sf_pos dot_idx (+ sf_pos (+ dot_idx 1)) (- sf_len (+ dot_idx 1))))
          (call compile_expr cg ptr_node o)
          (call emit_memop_offset o (call load_opcode ftype) (call mem_align ftype) f_offset)
          (if (eq ftype Ty.bool)
              (call emit_normalize_bool o)
              (block))
          (set! done true))
        (block))
    (if (eq op_id Kw.put) ;; put ptr Struct.field val: store by field type at its offset
        (block
          (let ptr_node:(ptr compiler.Node) (call nth_child node 1))
          (let sf_node:(ptr compiler.Node) (call nth_child node 2))
          (let val_node:(ptr compiler.Node) (call nth_child node 3))
          (let sf_pos:i32 (call node_a sf_node))
          (let sf_len:i32 (call node_b sf_node))
          (let dot_idx:i32 (call find_last_char cg sf_pos sf_len 46))
          (let f_offset:i32 (call get_field_offset cg sf_pos dot_idx (+ sf_pos (+ dot_idx 1)) (- sf_len (+ dot_idx 1))))
          (let ftype:Ty (call get_field_type cg sf_pos dot_idx (+ sf_pos (+ dot_idx 1)) (- sf_len (+ dot_idx 1))))
          (call compile_expr cg ptr_node o)
          (call emit_store_guard cg o (get cg Cg.nlocals))
          (call compile_expr cg val_node o)
          (call emit_memop_offset o (call store_opcode ftype) (call mem_align ftype) f_offset)
          (set! done true))
        (block))
    (if (eq op_id Kw.sizeof) ;; sizeof Struct
        (block
          (let snode:(ptr compiler.Node) (call nth_child node 1))
          (let size:i32 (call get_struct_size cg (call node_a snode) (call node_b snode)))
          (call emit_i32_const o size) (set! done true))
        (block))
    (if (eq op_id Kw.arr_new) ;; arr.new type size: same sequence as wasm.rs Expr::ArrNew
        (block
          (let etype:Ty (call elem_type_id cg (call nth_child node 1)))
          (let size_node:(ptr compiler.Node) (call nth_child node 2))
          (call compile_expr cg size_node o)
          (call emit_local_set o (get cg Cg.nlocals))
          ;; if n < 0: unreachable
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_i32_const o 0)
          (call put_byte o OP_I32_LT_S)
          (call put_byte o OP_IF)
          (call put_byte o BLOCK_EMPTY)
          (call put_byte o OP_UNREACHABLE)
          (call put_byte o OP_END)
          ;; claim 4 + n * sizeof(type) bytes atomically; the block starts at old
          (call emit_i32_const o 0)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_i32_const o (call type_size etype))
          (call put_byte o OP_I32_MUL)
          (call emit_i32_const o 4)
          (call put_byte o OP_I32_ADD)
          (call emit_round8 o)
          (call emit_rmw_add o)
          (call emit_local_set o io_a)
          (call emit_grow_to_cursor o)
          ;; header mem[old] = n; the array is old + 4
          (call emit_local_get o io_a)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_memop o OP_I32_STORE 2)
          (call emit_local_get o io_a)
          (call emit_i32_const o 4)
          (call put_byte o OP_I32_ADD)
          (set! done true))
        (block))
    (if (eq op_id Kw.arr_get) ;; arr.get type ptr index: load at ptr + index * sizeof(type)
        (block
          (let etype:Ty (call elem_type_id cg (call nth_child node 1)))
          (let ptr_node:(ptr compiler.Node) (call nth_child node 2))
          (let idx_node:(ptr compiler.Node) (call nth_child node 3))
          (call compile_expr cg ptr_node o)
          (call compile_expr cg idx_node o)
          (call emit_i32_const o (call type_size etype))
          (call put_byte o OP_I32_MUL)
          (call put_byte o OP_I32_ADD)
          (call emit_memop o (call load_opcode etype) (call mem_align etype))
          (if (eq etype Ty.bool)
              (call emit_normalize_bool o)
              (block))
          (set! done true))
        (block))
    (if (eq op_id Kw.arr_set) ;; arr.set type ptr index val
        (block
          (let etype:Ty (call elem_type_id cg (call nth_child node 1)))
          (let ptr_node:(ptr compiler.Node) (call nth_child node 2))
          (let idx_node:(ptr compiler.Node) (call nth_child node 3))
          (let val_node:(ptr compiler.Node) (call nth_child node 4))
          (call compile_expr cg ptr_node o)
          (call compile_expr cg idx_node o)
          (call emit_i32_const o (call type_size etype))
          (call put_byte o OP_I32_MUL)
          (call put_byte o OP_I32_ADD)
          (call emit_store_guard cg o (get cg Cg.nlocals))
          (call compile_expr cg val_node o)
          (call emit_memop o (call store_opcode etype) (call mem_align etype))
          (set! done true))
        (block))

    (if (eq op_id Kw.atomic_add) ;; atomic.add ptr v -> previous value (wasm.rs AtomicAdd)
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_store_guard cg o (get cg Cg.nlocals))
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_atomic o ATOMIC_RMW_ADD)
          (set! done true))
        (block))
    (if (eq op_id Kw.atomic_cas) ;; atomic.cas ptr expected new -> bool
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_store_guard cg o (get cg Cg.nlocals))
          (call compile_expr cg (call nth_child node 2) o)
          (call compile_expr cg (call nth_child node 3) o)
          (call emit_local_set o io_b)
          (call emit_local_set o io_a)
          (call emit_local_get o io_a)
          (call emit_local_get o io_b)
          (call emit_atomic o ATOMIC_RMW_CMPXCHG)
          (call emit_local_get o io_a)
          (call put_byte o OP_I32_EQ)
          (set! done true))
        (block))
    (if (eq op_id Kw.atomic_lock) ;; atomic.lock ptr: cmpxchg 0 -> 1, sleep while held, trap on a non-lock word
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_store_guard cg o (get cg Cg.nlocals))
          (call emit_local_set o io_a)
          (call put_byte o OP_BLOCK)
          (call put_byte o BLOCK_EMPTY)
          (call put_byte o OP_LOOP)
          (call put_byte o BLOCK_EMPTY)
          (call emit_local_get o io_a)
          (call emit_i32_const o 0)
          (call emit_i32_const o 1)
          (call emit_atomic o ATOMIC_RMW_CMPXCHG)
          (call put_byte o OP_LOCAL_TEE)
          (call put_u32 o io_b)
          (call put_byte o OP_I32_EQZ)
          (call put_byte o OP_BR_IF)
          (call put_byte o 1)
          (call emit_local_get o io_b)
          (call emit_i32_const o 1)
          (call put_byte o OP_I32_NE)
          (call emit_trap_if o)
          (call emit_local_get o io_a)
          (call emit_i32_const o 1)
          (call put_byte o OP_I64_CONST) (call put_s64 o -1i64)
          (call emit_atomic o ATOMIC_WAIT32)
          (call put_byte o OP_DROP)
          (call put_byte o OP_BR)
          (call put_byte o 0)
          (call put_byte o OP_END)
          (call put_byte o OP_END)
          (set! done true))
        (block))
    (if (eq op_id Kw.atomic_unlock) ;; atomic.unlock ptr: xchg 1 -> 0 (trap otherwise), wake all waiters
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_store_guard cg o (get cg Cg.nlocals))
          (call put_byte o OP_LOCAL_TEE)
          (call put_u32 o io_a)
          (call emit_i32_const o 0)
          (call emit_atomic o ATOMIC_RMW_XCHG)
          (call emit_i32_const o 1)
          (call put_byte o OP_I32_NE)
          (call emit_trap_if o)
          (call emit_local_get o io_a)
          (call emit_i32_const o -1)
          (call emit_atomic o ATOMIC_NOTIFY)
          (call put_byte o OP_DROP)
          (set! done true))
        (block))
    (if (eq op_id Kw.thread_spawn) ;; thread.spawn worker arg -> handle: a 16-byte record [done result fn arg] passed to thread-spawn
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_local_set o io_b)
          (call emit_local_set o io_a)
          (call emit_i32_const o 0)
          (call emit_i32_const o 16)
          (call emit_rmw_add o)
          (call emit_local_set o (get cg Cg.nlocals))
          (call emit_grow_to_cursor o)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_i32_const o 0)
          (call emit_memop_offset o OP_I32_STORE 2 0)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_i32_const o 0)
          (call emit_memop_offset o OP_I32_STORE 2 4)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_local_get o io_a)
          (call emit_memop_offset o OP_I32_STORE 2 8)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_local_get o io_b)
          (call emit_memop_offset o OP_I32_STORE 2 12)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_call o (call get_wasi_index cg Wasi.thread_spawn))
          (call emit_i32_const o 0)
          (call put_byte o OP_I32_LT_S)
          (call emit_trap_if o)
          (call emit_local_get o (get cg Cg.nlocals))
          (set! done true))
        (block))
    (if (eq op_id Kw.thread_join) ;; thread.join handle -> result: sleep until done, read the result
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_local_set o (get cg Cg.nlocals))
          (call put_byte o OP_BLOCK)
          (call put_byte o BLOCK_EMPTY)
          (call put_byte o OP_LOOP)
          (call put_byte o BLOCK_EMPTY)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_atomic o ATOMIC_LOAD)
          (call put_byte o OP_BR_IF)
          (call put_byte o 1)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_i32_const o 0)
          (call put_byte o OP_I64_CONST) (call put_s64 o -1i64)
          (call emit_atomic o ATOMIC_WAIT32)
          (call put_byte o OP_DROP)
          (call put_byte o OP_BR)
          (call put_byte o 0)
          (call put_byte o OP_END)
          (call put_byte o OP_END)
          (call emit_local_get o (get cg Cg.nlocals))
          (call emit_memop_offset o OP_I32_LOAD 2 4)
          (set! done true))
        (block))

    (if (or (eq op_id Kw.sys_time) (eq op_id Kw.sys_monotonic)) ;; sys.time / sys.monotonic -> clock_time_get into cell 80, i64.load
        (block
          (call emit_i32_const o (if (eq op_id Kw.sys_time) 0 1))
          (call put_byte o OP_I64_CONST)
          (call put_byte o 1)
          (call emit_rt cg o 80)
          (call emit_call o (call get_wasi_index cg Wasi.clock_time_get))
          (call emit_trap_if o)
          (call emit_rt cg o 80)
          (call emit_memop o OP_I64_LOAD 3)
          (set! done true))
        (block))
    (if (eq op_id Kw.sys_random) ;; sys.random ptr len -> random_get, errno -> 0 / -1
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_call o (call get_wasi_index cg Wasi.random_get))
          (call emit_errno_to_result cg o -1)
          (set! done true))
        (block))

    ;; and / or short-circuit, as wasm.rs: (and a b) = a; if (result i32) b else
    ;; i32.const 0 end; (or a b) = a; if (result i32) i32.const 1 else b end.
    (if (or (eq op_id Kw.and) (eq op_id Kw.or))
        (block
          (call compile_expr cg (call nth_child node 1) o)
          (call put_byte o OP_IF)
          (call put_byte o VT_I32)
          (call label_push cg Label.if_else)
          (if (eq op_id Kw.and)
              (block
                (call compile_expr cg (call nth_child node 2) o)
                (call put_byte o OP_ELSE)
                (call emit_i32_const o 0))
              (block
                (call emit_i32_const o 1)
                (call put_byte o OP_ELSE)
                (call compile_expr cg (call nth_child node 2) o)))
          (call label_pop cg)
          (call put_byte o OP_END) (set! done true))
        (block))

    (if (not done)
        (block
          (let t:Ty (call node_type cg (call nth_child node 1)))
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_typed_binop o op_id t) (set! done true))
        (block)))




  (fn compile_let [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void (let name_node:(ptr compiler.Node) (call nth_child node 1)) (let val_node:(ptr compiler.Node) (call nth_child node 4)) (call compile_expr cg val_node o) (let idx:i32 (call find_local cg (call node_a name_node) (call node_b name_node))) (call emit_local_set o idx))




  (fn compile_set [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void (let name_node:(ptr compiler.Node) (call nth_child node 1)) (let val_node:(ptr compiler.Node) (call nth_child node 2)) (call compile_expr cg val_node o) (let idx:i32 (call find_local cg (call node_a name_node) (call node_b name_node))) (call emit_local_set o idx))




  (fn compile_call [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let fname_node:(ptr compiler.Node) (call nth_child node 1))
    (let arg:(ptr compiler.Node) (call node_next (call node_next (call first_child node))))
    (while (neq arg (ptr.null compiler.Node))
      (call compile_expr cg arg o)
      (set! arg (call node_next arg)))
    (let fidx:i32 (call find_function cg (call node_a fname_node) (call node_b fname_node)))
    (if (eq fidx -1)
        (block
          (mem.store32 44 (call node_a fname_node))
          (mem.store32 48 (call node_b fname_node))
          (call set_compile_error CgErr.undefined_function)
          (block))
        (call emit_call o (+ (get cg Cg.nimports) fidx))))




  (fn compile_stmt [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void (call compile_expr cg node o) (if (call is_void_node cg node) (block) (call put_byte o OP_DROP)))




  (fn compile_stmt_seq [cg:(ptr Cg) first:(ptr compiler.Node) o:(ptr Out)] -> void (let node:(ptr compiler.Node) first) (while (neq node (ptr.null compiler.Node)) (let nxt:(ptr compiler.Node) (call node_next node)) (if (eq nxt (ptr.null compiler.Node)) (call compile_expr cg node o) (call compile_stmt cg node o)) (set! node nxt)))




  (fn compile_all_stmts [cg:(ptr Cg) first:(ptr compiler.Node) o:(ptr Out)] -> void (let node:(ptr compiler.Node) first) (while (neq node (ptr.null compiler.Node)) (let nxt:(ptr compiler.Node) (call node_next node)) (call compile_stmt cg node o) (set! node nxt)))




  (fn compile_block [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void (call compile_stmt_seq cg (call node_next (call first_child node)) o))




  (fn compile_if [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let cond_node:(ptr compiler.Node) (call nth_child node 1))
    (let then_node:(ptr compiler.Node) (call nth_child node 2))
    (let else_node:(ptr compiler.Node) (call nth_child node 3))
    (call compile_expr cg cond_node o)
    (let void_then:bool (call is_void_node cg then_node))
    (let block_ty:i32 64)
    (if void_then (set! block_ty 64) (set! block_ty (call block_type_byte (call node_type cg then_node))))
    (call put_byte o OP_IF) (call put_byte o block_ty)
    (call label_push cg Label.if_else)
    (call compile_expr cg then_node o)
    (call put_byte o OP_ELSE)
    (call compile_expr cg else_node o)
    (call label_pop cg)
    (call put_byte o OP_END))



  ;; block { loop { cond; eqz; br_if 1; body; br 0 } }: break = br to the block,
  ;; continue = br to the loop header (wasm.rs Expr::While).
  (fn compile_while [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (call put_byte o OP_BLOCK)
    (call put_byte o BLOCK_EMPTY)
    (call put_byte o OP_LOOP)
    (call put_byte o BLOCK_EMPTY)
    (call label_push cg Label.loop_exit)
    (call label_push cg Label.loop_header)
    (call compile_expr cg (call nth_child node 1) o)
    (call put_byte o OP_I32_EQZ)
    (call put_byte o OP_BR_IF)
    (call put_u32 o 1)
    (call compile_all_stmts cg (call nth_child node 2) o)
    (call label_pop cg)
    (call label_pop cg)
    (call put_byte o OP_BR)
    (call put_u32 o 0)
    (call put_byte o OP_END)
    (call put_byte o OP_END))



  ;; var = start; block { loop { var > end -> br_if 1; block { body }; var += step; br 0 } }:
  ;; break = br to the outer block, continue = br to the end of the body block,
  ;; which falls into the step (wasm.rs Expr::Loop).
  (fn compile_loop [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let var_node:(ptr compiler.Node) (call nth_child node 1))
    (let var_idx:i32 (call find_local cg (call node_a var_node) (call node_b var_node)))
    (let end_idx:i32 (call find_hidden cg (call node_a var_node) (call node_b var_node) Ty.loop_end))
    (let step_idx:i32 (call find_hidden cg (call node_a var_node) (call node_b var_node) Ty.loop_step))
    ;; start, end, and step are each evaluated once, in that order
    (call compile_expr cg (call nth_child node 2) o)
    (call emit_local_set o var_idx)
    (call compile_expr cg (call nth_child node 3) o)
    (call emit_local_set o end_idx)
    (call compile_expr cg (call nth_child node 4) o)
    (call emit_local_set o step_idx)
    (call put_byte o OP_BLOCK)
    (call put_byte o BLOCK_EMPTY)
    (call put_byte o OP_LOOP)
    (call put_byte o BLOCK_EMPTY)
    (call label_push cg Label.loop_exit)
    (call label_push cg Label.loop_header)
    (call emit_local_get o var_idx)
    (call emit_local_get o end_idx)
    (call put_byte o OP_I32_GT_S)
    (call put_byte o OP_BR_IF)
    (call put_u32 o 1)
    (call put_byte o OP_BLOCK)
    (call put_byte o BLOCK_EMPTY)
    (call label_push cg Label.loop_body)
    (call compile_all_stmts cg (call nth_child node 5) o)
    (call label_pop cg)
    (call put_byte o OP_END)
    (call label_pop cg)
    (call label_pop cg)
    (call emit_local_get o var_idx)
    (call emit_local_get o step_idx)
    (call put_byte o OP_I32_ADD)
    (call emit_local_set o var_idx)
    (call put_byte o OP_BR)
    (call put_u32 o 0)
    (call put_byte o OP_END)
    (call put_byte o OP_END))



  (fn is_else_clause [cg:(ptr Cg) clause:(ptr compiler.Node)] -> bool
    (eq (call group_head_keyword cg clause) Kw.else))

  ;; (cond (c1 e...) ... (else e...)) as the nested ifs the Rust parser builds:
  ;; (if c1 (block e...) (if c2 (block e...) ... (block else...))).
  (fn compile_cond_from [cg:(ptr Cg) clause:(ptr compiler.Node) o:(ptr Out)] -> void
    (let head:(ptr compiler.Node) (call first_child clause))
    (if (call is_else_clause cg clause)
        (return (call compile_stmt_seq cg (call node_next head) o))
        (block))
    (let body_first:(ptr compiler.Node) (call node_next head))
    (call compile_expr cg head o)
    (let bt:i32 64)
    (if (call is_void_node cg (call last_child clause))
        (block)
        (set! bt (call block_type_byte (call body_type cg body_first))))
    (call put_byte o OP_IF)
    (call put_byte o bt)
    (call label_push cg Label.if_else)
    (call compile_stmt_seq cg body_first o)
    (call put_byte o OP_ELSE)
    (call compile_cond_from cg (call node_next clause) o)
    (call label_pop cg)
    (call put_byte o OP_END))




  ;; The body's expressions in order, contracts skipped; every value but a
  ;; non-void function's last is dropped.
  (fn compile_function_body [cg:(ptr Cg) entry:(ptr FnInfo) o:(ptr Out)] -> void
    (let ret_type:Ty (get entry FnInfo.ret))
    (let bchild:(ptr compiler.Node) (call nth_child (get entry FnInfo.node) 5))
    (while (neq bchild (ptr.null compiler.Node))
      (if (call is_contract_head cg bchild)
          (block)
          (block
            (let keep_value:bool (and (eq (call node_next bchild) (ptr.null compiler.Node)) (neq ret_type Ty.void)))
            (call compile_expr cg bchild o)
            (if (and (not keep_value) (not (call is_void_node cg bchild))) (call put_byte o OP_DROP) (block))))
      (set! bchild (call node_next bchild))))




  ;; ===== Module assembly =====

  ;; Appends the bytes src has written.
  (fn copy_out [dst:(ptr Out) src:(ptr Out)] -> void
    (loop i 0 (- (get src Out.pos) 1) 1
      (call put_byte dst (mem.load8 (+ (get src Out.base) i)))))

  ;; A size-prefixed copy of what sub has written (a function body).
  (fn emit_sized [o:(ptr Out) sub:(ptr Out)] -> void
    (call put_u32 o (get sub Out.pos))
    (call copy_out o sub))

  ;; A section: its id, its size, then the bytes sec has written.
  (fn emit_section [o:(ptr Out) id:i32 sec:(ptr Out)] -> void
    (call put_byte o id)
    (call emit_sized o sec))

  ;; A 4-byte little-endian word.
  (fn put_word [o:(ptr Out) v:i32] -> void
    (loop k 0 3 1 (call put_byte o (bitand (shr v (* k 8)) 255))))

  ;; A function type: 0x60, the parameter value types, the result types.
  (fn emit_func_type [o:(ptr Out) s:(ptr Sig)] -> void
    (call put_byte o FUNC_TYPE)
    (call put_u32 o (get s Sig.nparams))
    (loop i 0 (- (get s Sig.nparams) 1) 1 (call put_byte o (arr.get i32 (get s Sig.params) i)))
    (if (get s Sig.has_result)
        (block (call put_byte o 1) (call put_byte o (get s Sig.result)))
        (call put_byte o 0)))

  ;; A signature from a pattern of parameter types, i for i32 and l for i64,
  ;; and a result value type (0 for none).
  (fn sig_from [params:str result:i32] -> (ptr Sig)
    (let s:(ptr Sig) (new Sig))
    (let n:i32 (str.len params))
    (put s Sig.params (arr.new i32 (if (eq n 0) 1 n)))
    (loop i 0 (- n 1) 1
      (arr.set i32 (get s Sig.params) i (if (eq (mem.load8 (+ (str.ptr params) i)) 108) 126 127)))
    (put s Sig.nparams n)
    (put s Sig.has_result (neq result 0))
    (put s Sig.result result)
    s)

  ;; The types of the WASI functions (wasm.rs Wasi::sig).
  (fn wasi_sig [w:Wasi] -> (ptr Sig)
    (cond
      ((or (eq w Wasi.fd_write) (eq w Wasi.fd_read)) (call sig_from "iiii" 127))
      ((eq w Wasi.path_open) (call sig_from "iiiiillii" 127))
      ((eq w Wasi.fd_close) (call sig_from "i" 127))
      ((eq w Wasi.proc_exit) (call sig_from "i" 0))
      ((eq w Wasi.path_unlink_file) (call sig_from "iii" 127))
      ((eq w Wasi.clock_time_get) (call sig_from "ili" 127))
      ((eq w Wasi.thread_spawn) (call sig_from "i" 127))
      ;; random_get, args_sizes_get, args_get, environ_sizes_get, environ_get
      (else (call sig_from "ii" 127))))

  ;; The wasm type of a module function.
  (fn fn_sig [f:(ptr FnInfo)] -> (ptr Sig)
    (let s:(ptr Sig) (new Sig))
    (put s Sig.params (arr.new i32 16))
    (loop p 0 (- (get f FnInfo.nparams) 1) 1
      (arr.set i32 (get s Sig.params) p (call type_id_to_valtype (arr.get Ty (get f FnInfo.params) p))))
    (put s Sig.nparams (get f FnInfo.nparams))
    (put s Sig.has_result (neq (get f FnInfo.ret) Ty.void))
    (put s Sig.result (if (eq (get f FnInfo.ret) Ty.void) 0 (call type_id_to_valtype (get f FnInfo.ret))))
    s)

  ;; One function body: the locals (declared ones, the store guard's scratch,
  ;; and two I/O scratch locals if needed), the code, end.
  (fn emit_function [cg:(ptr Cg) entry:(ptr FnInfo) fc:(ptr Out)] -> void
    (let pcount:i32 (get entry FnInfo.nparams))
    (let total_locals:i32 (call collect_locals_for_function cg entry))
    (let extra:i32 (- total_locals pcount))
    (let uses_io:bool (call fn_uses_io cg (get entry FnInfo.node)))
    (call put_u32 fc (+ extra (if uses_io 2 1)))
    (loop l 0 (- extra 1) 1
      (call put_u32 fc 1)
      (call put_byte fc (call type_id_to_valtype (get (call local_at cg (+ pcount l)) Local.ty))))
    (call put_u32 fc 1) (call put_byte fc VT_I32)
    (if uses_io (block (call put_u32 fc 2) (call put_byte fc VT_I32)) (block))
    (put cg Cg.nlocals total_locals)
    (call compile_function_body cg entry fc)
    (call put_byte fc OP_END))

  ;; Compiles one import-free module (src_len bytes at src_ptr) to wasm. The
  ;; module goes to a fresh buffer whose address is stored in cell 60; returns
  ;; its length, or -1 with the first compile error in cell 4.
  (fn compile_module [src_ptr:i32 src_len:i32] -> i32
    (let _init:i32 (call init_keywords))
    ;; constants and enums are erased to literals and i32 first (consts.aipl)
    (let plain:(ptr buf.Buf) (call buf.make (+ src_len 64)))
    (if (not (call consts.expand (call str.bytes src_ptr src_len) plain (call buf.make 64)))
        (block (call set_compile_error CgErr.unknown_enum_member) (return -1))
        (block))
    (set! src_ptr (get (call buf.bytes plain) str.Bytes.addr))
    (let cg:(ptr Cg) (call new_cg src_ptr))
    (set! src_len (call buf.len plain))
    ;; Buffers are sized from the input: a token is at least one source byte
    ;; (12-byte records), an AST node is at most one per token (16 bytes).
    (let tok_buf:i32 (call cg_alloc (* (+ src_len 1) 12)))
    (let tok_cnt:i32 (call compiler.tokenize src_ptr src_len tok_buf))
    (let ast_buf:i32 (call cg_alloc (* (+ tok_cnt 2) 16)))
    (let root:(ptr compiler.Node) (call compiler.parse_ast tok_buf tok_cnt ast_buf))

    (call walk_module_prepass cg root)
    (let threaded:bool (call threaded cg))
    ;; threaded modules call workers through the table (wasm.rs worker_sig)
    (let worker_type:i32 0)
    (if threaded
        (block
          (put cg Cg.uses_refs true)
          (set! worker_type (call worker_sig_index cg)))
        (block))
    ;; Literals plus the heap start must fit in the initial 16 pages (wasm.rs STRING_DATA_LIMIT).
    (if (gt (call heap_start cg) 1048576) (call set_compile_error CgErr.too_many_literals) 0)
    (call collect_structs cg root)
    (let imports:i32 (get cg Cg.nimports))
    (let nfns:i32 (call collect_functions cg root))
    (put cg Cg.nfns nfns)
    (let nsigs:i32 (get cg Cg.nsigs))
    ;; a zero-argument main and no _start: an automatic _start (wasm.rs auto_start)
    (let main_idx:i32 (call find_function cg (- (str.ptr "main") src_ptr) 4))
    (let auto_start:bool (and (gte main_idx 0)
                              (and (eq (get (call func_entry_ptr cg main_idx) FnInfo.nparams) 0)
                                   (lt (call find_function cg (- (str.ptr "_start") src_ptr) 6) 0))))
    ;; generated functions after the module's: a threaded module's start
    ;; function and wasi_thread_start, then _start
    (let extra_fns:i32 (if threaded 2 0))
    (let n_fns:i32 (+ nfns (+ extra_fns (if auto_start 1 0))))

    ;; Output, section scratch, and per-function scratch share one capacity;
    ;; overrunning it is compile error 91.
    (let cap:i32 (+ (* src_len 4) 65536))
    (let out:i32 (call cg_alloc cap))
    (let scratch:i32 (call cg_alloc cap))
    (let fcode_scratch:i32 (call cg_alloc cap))
    (let o:(ptr Out) (call out_at out))
    (call advance o (call compiler.emit_header out))

    ;; Type (1): the WASI imports' types, the functions', the call_ref
    ;; signatures, a threaded module's two, and _start's
    (let sec:(ptr Out) (call out_at scratch))
    (call put_u32 sec (+ imports (+ nfns (+ nsigs (+ extra_fns (if auto_start 1 0))))))
    (loop w 0 12 1
      (if (neq (call get_wasi_index cg (enum.cast Wasi w)) -1) (call emit_func_type sec (call wasi_sig (enum.cast Wasi w))) (block)))
    (loop f 0 (- nfns 1) 1 (call emit_func_type sec (call fn_sig (call func_entry_ptr cg f))))
    (loop si 0 (- nsigs 1) 1 (call emit_func_type sec (arr.get (ptr Sig) (get cg Cg.sigs) si)))
    (if threaded
        (block
          (call emit_func_type sec (call sig_from "" 0))       ;; start function: [] -> []
          (call emit_func_type sec (call sig_from "ii" 0)))    ;; wasi_thread_start: [i32 i32] -> []
        (block))
    (if auto_start (call emit_func_type sec (call sig_from "" 0)) (block))
    (call emit_section o 1 sec)

    ;; Import (2): the WASI functions used, in the fixed order; a threaded
    ;; module also imports its shared memory
    (if (or (gt imports 0) threaded)
        (block
          (set! sec (call out_at scratch))
          (call put_u32 sec (if threaded (+ imports 1) imports))
          (let type_idx:i32 0)
          (loop w 0 12 1
            (let wv:Wasi (enum.cast Wasi w))
            (if (neq (call get_wasi_index cg wv) -1)
                (block
                  (call emit_name sec (if (eq wv Wasi.thread_spawn) "wasi" "wasi_snapshot_preview1"))
                  (call emit_name sec (call wasi_name wv))
                  (call put_byte sec 0)   ;; a function, of type
                  (call put_u32 sec type_idx)
                  (set! type_idx (+ type_idx 1)))
                (block)))
          ;; "env" "memory": shared, min 16 max 1024 pages (flags 3)
          (if threaded
              (block
                (call emit_name sec "env")
                (call emit_name sec "memory")
                (call put_byte sec 2) (call put_byte sec 3)
                (call put_u32 sec 16)
                (call put_u32 sec 1024))
              (block))
          (call emit_section o 2 sec))
        (block))

    ;; Function (3): each function's type index
    (set! sec (call out_at scratch))
    (call put_u32 sec n_fns)
    (loop f 0 (- nfns 1) 1 (call put_u32 sec (+ imports f)))
    (let generated_types:i32 (+ imports (+ nfns nsigs)))
    (if threaded
        (block (call put_u32 sec generated_types) (call put_u32 sec (+ generated_types 1)))
        (block))
    (if auto_start (call put_u32 sec (+ generated_types extra_fns)) (block))
    (call emit_section o 3 sec)

    ;; Table (4), only with function refs: one funcref table holding every
    ;; function, min = max = function count
    (if (get cg Cg.uses_refs)
        (block
          (set! sec (call out_at scratch))
          (call put_byte sec 1)     ;; one table
          (call put_byte sec 112)   ;; funcref
          (call put_byte sec 1)     ;; with a max
          (call put_u32 sec nfns)
          (call put_u32 sec nfns)
          (call emit_section o 4 sec))
        (block))

    ;; Memory (5): min 16, max 1024 pages (vm.rs MAX_PAGES). A threaded module
    ;; imports its memory and has a Global (6) instead: global 0, the runtime
    ;; scratch pointer, mutable i32 = 64
    (set! sec (call out_at scratch))
    (if threaded
        (block
          (call put_byte sec 1) (call put_byte sec 127) (call put_byte sec 1)
          (call emit_i32_const sec 64)
          (call put_byte sec 11)
          (call emit_section o 6 sec))
        (block
          (call put_byte sec 1)     ;; one memory
          (call put_byte sec 1)     ;; with a max
          (call put_u32 sec 16)
          (call put_u32 sec 1024)
          (call emit_section o 5 sec)))

    ;; Export (7): every function by name, the memory, wasi_thread_start, _start
    (set! sec (call out_at scratch))
    (call put_u32 sec (+ nfns (+ 1 (+ (if threaded 1 0) (if auto_start 1 0)))))
    (loop f 0 (- nfns 1) 1
      (let entry:(ptr FnInfo) (call func_entry_ptr cg f))
      (call put_u32 sec (get entry FnInfo.name_len))
      (loop k 0 (- (get entry FnInfo.name_len) 1) 1
        (call put_byte sec (mem.load8 (+ src_ptr (+ (get entry FnInfo.name_pos) k)))))
      (call put_byte sec 0)    ;; a function
      (call put_u32 sec (+ imports f)))
    (call emit_name sec "memory")
    (call put_byte sec 2) (call put_byte sec 0)   ;; memory 0
    (if threaded
        (block
          (call emit_name sec "wasi_thread_start")
          (call put_byte sec 0)
          (call put_u32 sec (+ imports (+ nfns 1))))
        (block))
    (if auto_start
        (block
          (call emit_name sec "_start")
          (call put_byte sec 0)
          (call put_u32 sec (+ imports (+ nfns extra_fns))))
        (block))
    (call emit_section o 7 sec)

    ;; Start (8), threaded only: the one-time initialisation function
    (if threaded
        (block
          (set! sec (call out_at scratch))
          (call put_u32 sec (+ imports nfns))
          (call emit_section o 8 sec))
        (block))

    ;; Element (9), only with function refs: one active segment at table
    ;; offset 0 listing every function in order
    (if (get cg Cg.uses_refs)
        (block
          (set! sec (call out_at scratch))
          (call put_byte sec 1) (call put_byte sec 0)
          (call emit_i32_const sec 0)
          (call put_byte sec 11)
          (call put_u32 sec nfns)
          (loop f 0 (- nfns 1) 1 (call put_u32 sec (+ imports f)))
          (call emit_section o 9 sec))
        (block))

    ;; Data Count (12), threaded only (memory.init needs it)
    (let has_strings:bool (gt (call buf.len (get cg Cg.blob)) 0))
    (if threaded
        (block
          (set! sec (call out_at scratch))
          (call put_u32 sec (if has_strings 2 1))
          (call emit_section o 12 sec))
        (block))

    ;; Code (10): the functions, then the generated ones
    (set! sec (call out_at scratch))
    (call put_u32 sec n_fns)
    (loop f 0 (- nfns 1) 1
      (let fc:(ptr Out) (call out_at fcode_scratch))
      (call emit_function cg (call func_entry_ptr cg f) fc)
      (if (gt (get fc Out.pos) cap) (call set_compile_error CgErr.output_full) 0)
      (call emit_sized sec fc))
    (if threaded
        (block
          (let fc:(ptr Out) (call out_at fcode_scratch))
          (call threaded_init_body fc (call buf.len (get cg Cg.blob)))
          (call emit_sized sec fc)
          (set! fc (call out_at fcode_scratch))
          (call thread_start_body fc (+ imports (+ nfns worker_type)))
          (call emit_sized sec fc))
        (block))
    (if auto_start
        (block
          ;; no locals; call main; drop a non-void result; end
          (let fc:(ptr Out) (call out_at fcode_scratch))
          (call put_byte fc 0)
          (call emit_call fc (+ imports main_idx))
          (if (neq (get (call func_entry_ptr cg main_idx) FnInfo.ret) Ty.void) (call put_byte fc OP_DROP) (block))
          (call put_byte fc OP_END)
          (call emit_sized sec fc))
        (block))
    (call emit_section o 10 sec)

    ;; Data (11): the heap cursor's initial value at address 0, and the string
    ;; literals at 1024 (both passive in a threaded module: its start
    ;; function copies them once)
    (set! sec (call out_at scratch))
    (call put_u32 sec (if has_strings 2 1))
    (if threaded
        (call put_byte sec 1)
        (block (call put_byte sec 0) (call emit_i32_const sec 0) (call put_byte sec 11)))
    (call put_u32 sec 4)
    (call put_word sec (call heap_start cg))
    (if has_strings
        (block
          (if threaded
              (call put_byte sec 1)
              (block (call put_byte sec 0) (call emit_i32_const sec 1024) (call put_byte sec 11)))
          (call put_u32 sec (call buf.len (get cg Cg.blob)))
          (loop k 0 (- (call buf.len (get cg Cg.blob)) 1) 1
            (call put_byte sec (mem.load8 (+ (get (get cg Cg.blob) buf.Buf.data) k)))))
        (block))
    (call emit_section o 11 sec)

    (if (gt (get o Out.pos) cap) (call set_compile_error CgErr.output_full) 0)
    (mem.store32 60 out)
    (if (call has_compile_error) -1 (get o Out.pos)))

;; ===== Threaded modules: generated functions (wasm.rs threaded_init_function, thread_start_function) =====

  ;; The start function body (no locals): the first instance copies the heap
  ;; cursor and the string literals into the shared memory, guarded by the
  ;; flag at 88. Returns the byte count.
  (fn threaded_init_body [o:(ptr Out) blob_len:i32] -> void
    (call put_byte o 0)
    (call emit_i32_const o 88)
    (call emit_i32_const o 0)
    (call emit_i32_const o 1)
    (call emit_atomic o ATOMIC_RMW_CMPXCHG)
    (call put_byte o OP_I32_EQZ)
    (call put_byte o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call emit_i32_const o 0)
    (call emit_i32_const o 0)
    (call emit_i32_const o 4)
    (call emit_memory_init o 0)
    (if (gt blob_len 0)
        (block
          (call emit_i32_const o 1024)
          (call emit_i32_const o 0)
          (call emit_i32_const o blob_len)
          (call emit_memory_init o 1))
        (block))
    (call put_byte o OP_END)
    (call put_byte o OP_END))



  ;; memory.init data_index, memory 0
  (fn emit_memory_init [o:(ptr Out) data_index:i32] -> void
    (call put_byte o OP_PREFIX_MISC)
    (call put_byte o MISC_MEMORY_INIT)
    (call put_u32 o data_index)
    (call put_byte o 0))




  ;; wasi_thread_start(tid, rec) body (no locals): allocate this thread's
  ;; 24-byte runtime scratch block, run rec.fn(rec.arg) through the table,
  ;; store the result, set done, and wake joiners.
  (fn thread_start_body [o:(ptr Out) worker_type:i32] -> void
    (call put_byte o 0)
    (call emit_i32_const o 0)
    (call emit_i32_const o 24)
    (call emit_rmw_add o)
    (call put_byte o OP_GLOBAL_SET) ;; global.set 0
    (call put_byte o 0)
    (call emit_grow_to_cursor o)
    (call emit_local_get o 1)
    (call emit_local_get o 1)
    (call emit_memop_offset o OP_I32_LOAD 2 12)
    (call emit_local_get o 1)
    (call emit_memop_offset o OP_I32_LOAD 2 8)
    (call put_byte o OP_CALL_INDIRECT)
    (call put_u32 o worker_type)
    (call put_byte o 0)
    (call emit_memop_offset o OP_I32_STORE 2 4)
    (call emit_local_get o 1)
    (call emit_i32_const o 1)
    (call emit_atomic o ATOMIC_STORE) ;; i32.atomic.store
    (call emit_local_get o 1)
    (call emit_i32_const o -1)
    (call emit_atomic o ATOMIC_NOTIFY) ;; memory.atomic.notify
    (call put_byte o OP_DROP)
    (call put_byte o OP_END))



    ;; ===== Harnesses =====
  (fn test_signatures_and_locals [] -> i32
    (let _kw_init:i32 (call init_keywords))
    (let text:str "(module test_mod (fn add [a:i32 b:i32] -> i32 (+ a b)) (fn compute [x:i32] -> i32 (let y:i32 (call add x 5)) (let z:i32 0) (loop i 0 9 1 (set! z (+ z i))) (+ y z)))")
    (let src:i32 (str.ptr text))
    (let tok:i32 (mem.alloc (* 12 (+ (str.len text) 1))))
    (let n:i32 (call compiler.tokenize src (str.len text) tok))
    (let ast:i32 (mem.alloc (* 16 (+ n 2))))
    (let root:(ptr compiler.Node) (call compiler.parse_ast tok n ast))
    (let cg:(ptr Cg) (call new_cg src))
    (let func_count:i32 (call collect_functions cg root))
    (put cg Cg.nfns func_count)
    (let e0:(ptr FnInfo) (call func_entry_ptr cg 0))
    (let e0_pcount:i32 (get e0 FnInfo.nparams))
    (let e0_ret:Ty (get e0 FnInfo.ret))
    (let e1:(ptr FnInfo) (call func_entry_ptr cg 1))
    (let local_count:i32 (call collect_locals_for_function cg e1))
    ;; compute's locals: x, y, z, i, and the loop's hidden end and step
    (if (and (eq func_count 2) (and (eq e0_pcount 2) (and (eq e0_ret Ty.i32) (eq local_count 6))))
        1
        0))

  ;; Compiles `text`: the module length if it compiled without error and
  ;; starts with the wasm magic and version, else -1. Byte-for-byte
  ;; agreement with the Rust backend is checked by tests/test_selfhost.rs.
  (fn compiles [text:str] -> i32
    (let len:i32 (call compile_module (str.ptr text) (str.len text)))
    (if (or (lte len 0) (call has_compile_error)) (return -1) (block))
    (let out:i32 (mem.load32 60))
    (if (and (eq (mem.load32 out) 1836278016) (eq (mem.load32 (+ out 4)) 1)) len -1))

  (fn test_compile_add [] -> i32
    (call compiles "(module add (fn add [a:i32 b:i32] -> i32 (+ a b)))"))

  (fn test_compile_compute [] -> i32
    (call compiles "(module compute (fn add [a:i32 b:i32] -> i32 (+ a b)) (fn compute [x:i32] -> i32 (let y:i32 (call add x 5)) (let z:i32 0) (loop i 0 9 1 (set! z (+ z i))) (+ y z)))"))

  (fn test_compile_store [] -> i32
    (call compiles "(module store (fn add [a:i32 b:i32] -> i32 (mem.store32 a b) (mem.load32 a)))"))

  ;; Group runner for `aipl test` / test_suite.aipl
  (fn run_codegen_tests [] -> i32
    (let passed:i32 0)
    (if (eq (call test_signatures_and_locals) 1) (set! passed (+ passed 1)) (block))
    (if (gt (call test_compile_add) 0) (set! passed (+ passed 1)) (block))
    (if (gt (call test_compile_compute) 0) (set! passed (+ passed 1)) (block))
    (if (gt (call test_compile_store) 0) (set! passed (+ passed 1)) (block))
    passed)
)
