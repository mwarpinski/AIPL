    (let ok_group:i32 (call nth_child node 2))
    (let err_group:i32 (call nth_child node 3))
    (let scratch:i32 locals_count)
    (let off:i32 0)
    (set! off (+ off (call compile_expr src_ptr expr_node (+ out_ptr off) locals_base locals_count func_table_base func_count)))
    (set! off (+ off (call emit_local_set (+ out_ptr off) scratch)))
    (set! off (+ off (call emit_local_get (+ out_ptr off) scratch)))
    (set! off (+ off (call emit_memop (+ out_ptr off) 40 2)))
    (mem.store8 (+ out_ptr off) 69) (set! off (+ off 1))
    (let ok_last:i32 (call last_child ok_group))
    (let is_void:bool (call is_void_node src_ptr ok_last func_table_base func_count))
    (let block_ty:i32 64)
    (if is_void (set! block_ty 64) (set! block_ty (call block_type_byte (call node_type src_ptr ok_last locals_base locals_count func_table_base func_count))))
    (mem.store8 (+ out_ptr off) 4)
    (mem.store8 (+ out_ptr (+ off 1)) block_ty)
    (set! off (+ off 2))
    (call label_push 0)
    (let ok_var_node:i32 (call nth_child ok_group 1))
    (let ok_var_idx:i32 (call find_local locals_base locals_count src_ptr (call node_a ok_var_node) (call node_b ok_var_node)))
    (if (neq ok_var_idx -1)
        (block
          (set! off (+ off (call emit_local_get (+ out_ptr off) scratch)))
          (set! off (+ off (call emit_memop_offset (+ out_ptr off) 40 2 4)))
          (set! off (+ off (call emit_local_set (+ out_ptr off) ok_var_idx)))
          0)
        0)
    (let ok_body_first:i32 (call node_next (call node_next (call node_a ok_group))))
    (set! off (+ off (call compile_stmt_seq src_ptr ok_body_first (+ out_ptr off) locals_base locals_count func_table_base func_count)))
    (mem.store8 (+ out_ptr off) 5) (set! off (+ off 1))
    (let err_var_node:i32 (call nth_child err_group 1))
    (let err_var_idx:i32 (call find_local locals_base locals_count src_ptr (call node_a err_var_node) (call node_b err_var_node)))
    (if (neq err_var_idx -1)
        (block
          (set! off (+ off (call emit_local_get (+ out_ptr off) scratch)))
          (set! off (+ off (call emit_memop_offset (+ out_ptr off) 40 2 4)))
          (set! off (+ off (call emit_local_set (+ out_ptr off) err_var_idx)))
          0)
        0)
    (let err_body_first:i32 (call node_next (call node_next (call node_a err_group))))
    (set! off (+ off (call compile_stmt_seq src_ptr err_body_first (+ out_ptr off) locals_base locals_count func_table_base func_count)))
    (call label_pop)
    (mem.store8 (+ out_ptr off) 11) (set! off (+ off 1))
    off)

  ;; Emit errno to result helper
  ;; The address of runtime cell `cell` (64..88), as wasm.rs emit_rt: the fixed
  ;; cell, or in a threaded module global 0 (this thread's scratch block) plus
  ;; the cell's offset.
  (fn emit_rt [ptr:i32 cell:i32] -> i32
    (if (call threaded)
        (block
          (let off:i32 (call emit_byte ptr 35)) ;; global.get 0
          (set! off (+ off (call emit_byte (+ ptr off) 0)))
          (if (neq cell 64)
              (block
                (set! off (+ off (call emit_i32_const (+ ptr off) (- cell 64))))
                (set! off (+ off (call emit_byte (+ ptr off) 106))))
              (block))
          off)
        (call emit_i32_const ptr cell)))

  (fn emit_errno_to_result [out_ptr:i32 out_cell:i32] -> i32
    (let off:i32 0)
    (mem.store8 (+ out_ptr off) 4)
    (mem.store8 (+ out_ptr (+ off 1)) 127)
    (set! off (+ off 2))
    (set! off (+ off (call emit_i32_const (+ out_ptr off) -1)))
    (mem.store8 (+ out_ptr off) 5)
    (set! off (+ off 1))
    (if (gte out_cell 0)
        (block
          (set! off (+ off (call emit_rt (+ out_ptr off) out_cell)))
          (set! off (+ off (call emit_memop (+ out_ptr off) 40 2))))
        (set! off (+ off (call emit_i32_const (+ out_ptr off) 0))))
    (mem.store8 (+ out_ptr off) 11)
    (set! off (+ off 1))
    off)

  (fn compile_op [src_ptr:i32 op_id:i32 node:i32 out_ptr:i32 locals_base:i32 locals_count:i32 func_table_base:i32 func_count:i32] -> i32
    (let import_cnt:i32 (mem.load32 32))
    (let io_a:i32 (+ locals_count 1))
    (let io_b:i32 (+ locals_count 2))
    (let res:i32 -1)

    (if (eq op_id 9)
        (block (let n1:i32 (call compile_expr src_ptr (call nth_child node 1) out_ptr locals_base locals_count func_table_base func_count)) (set! res (+ n1 (call emit_memop (+ out_ptr n1) 45 0))))
        (block))
    (if (eq op_id 10)
        (block (let n1:i32 (call compile_expr src_ptr (call nth_child node 1) out_ptr locals_base locals_count func_table_base func_count)) (set! res (+ n1 (call emit_memop (+ out_ptr n1) 40 2))))
        (block))
    (if (eq op_id 11)
        (block (let n1:i32 (call compile_expr src_ptr (call nth_child node 1) out_ptr locals_base locals_count func_table_base func_count)) (set! res (+ n1 (call emit_memop (+ out_ptr n1) 41 3))))
        (block))
    (if (eq op_id 12)
        (block (let n1:i32 (call compile_expr src_ptr (call nth_child node 1) out_ptr locals_base locals_count func_table_base func_count)) (let g:i32 (call emit_store_guard (+ out_ptr n1) locals_count)) (let n2:i32 (call compile_expr src_ptr (call nth_child node 2) (+ out_ptr (+ n1 g)) locals_base locals_count func_table_base func_count)) (set! res (+ (+ n1 (+ g n2)) (call emit_memop (+ out_ptr (+ n1 (+ g n2))) 58 0))))
        (block))
    (if (eq op_id 13)
