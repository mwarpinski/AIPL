;; AIPL Self-Hosted Code Generator: generic S-expression tree (from
;; compiler.tokenize + compiler.parse_ast) -> real WebAssembly bytes.
;;
;; Scope matches src/compiler/wasm.rs byte-for-byte.

(module codegen
  (import alloc)
  (import compiler)
  (import consts)
  (import str)
  (import buf)
  (import map)
  (import parser)
  (import printer)
  (import float)
  (import vec)
  (import origins)
  (import places)

  ;; ===== Generic byte-span comparison =====
  (fn sym_eq [cg:(ptr Cg) pos:i32 len:i32 lit_ptr:i32 lit_len:i32] -> bool
    (unsafe (when (neq len lit_len) (return false))
    (for i 0 len
      (when (neq (mem.load8 (+ (get cg Cg.src) (+ pos i))) (mem.load8 (+ lit_ptr i))) (return false)))
    true))

  ;; ===== Node accessors (see compiler.aipl for the tree layout) =====
  (fn node_kind [node:(ptr compiler.Node)] -> compiler.Kind
    (if (eq node (ptr.null compiler.Node)) compiler.Kind.none (get node compiler.Node.kind)))
  ;; An atom's value: an integer literal's value, or the source offset of a
  ;; symbol, string, or i64/float literal (compiler.aipl). A group's
  ;; children start at first_child.
  (fn node_a [node:(ptr compiler.Node)] -> i32 (if (eq node (ptr.null compiler.Node)) 0 (get node compiler.Node.a)))
  ;; An int literal's value (its low 32 bits).
  (fn int_node_value [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (call compiler.int_value (get cg Cg.src) (call node_a node) (call node_b node)))
  (fn node_b [node:(ptr compiler.Node)] -> i32 (if (eq node (ptr.null compiler.Node)) 0 (get node compiler.Node.b)))
  (fn node_next [node:(ptr compiler.Node)] -> (ptr compiler.Node)
    (if (eq node (ptr.null compiler.Node)) node (get node compiler.Node.next)))
  (fn first_child [group:(ptr compiler.Node)] -> (ptr compiler.Node)
    (if (eq group (ptr.null compiler.Node)) group (get group compiler.Node.first)))

  (fn nth_child [group:(ptr compiler.Node) n:i32] -> (ptr compiler.Node)
    (req (gte n 0))
    (let cur:(ptr compiler.Node) (call first_child group))
    (let i:i32 0)
    (while (lt i n)
      (set! cur (call node_next cur))
      (set! i (+ i 1)))
    cur)

  ;; ===== The compile =====
  ;; What every compile function needs, passed as one value: the source text,
  ;; the locals of the function being compiled, and the module's functions.
  ;; (The tables are still raw memory; docs/design/CODEGEN_REWRITE.md CR6.)
  (struct Cg [src:i32 locals:(arr (ptr Local)) nlocals:i32 fns:(arr (ptr FnInfo)) nfns:i32
              structs:(arr (ptr StructInfo)) nstructs:i32
              unions:(arr (ptr UnionInfo)) nunions:i32
              wasi:(arr i32) nimports:i32 labels:(arr Label) nlabels:i32
              uses_refs:bool sigs:(arr (ptr Sig)) nsigs:i32
              strs:(arr (ptr StrLit)) nstrs:i32 blob:(ptr buf.Buf) newline:i32
              uses_checks:bool checks_base:i32 ens_block:bool src_len:i32
              places:(ptr places.Places) scratch:i32 groups:(ptr (vec.Vec (ptr Group))) has_values:bool
              results:(ptr (vec.Vec (ptr StructInfo)))
              may_free:(arr bool) proven:(ptr (vec.Vec (ptr compiler.Node))) versioning:bool
              max_pages:i32])

  ;; A string literal's spelling (a span of the source; pos -1 for the
  ;; newline sys.print reserves) and the address of its interned bytes. The
  ;; blob holds every distinct literal as [len u32 LE][bytes], in first-use
  ;; order; it becomes the data segment at 1024, so an address is 1028 + the
  ;; offset of the bytes in the blob.
  (struct StrLit [pos:i32 len:i32 addr:i32])

  ;; A call_ref signature as wasm sees it: parameter and result value-type
  ;; bytes (so (fn [bool] -> i32) and (fn [i32] -> i32) coincide; a value
  ;; struct is several).
  (struct Sig [nparams:i32 params:(arr i32) nresults:i32 results:(arr i32)])

  ;; The WASI functions a module may import, in the fixed import order of
  ;; wasm.rs enum Wasi.
  (enum Wasi [(none -1) fd_write fd_read path_open fd_close proc_exit path_unlink_file
              args_sizes_get args_get environ_sizes_get environ_get thread_spawn
              clock_time_get random_get fd_readdir path_filestat_get
              net_listen net_accept net_recv net_send net_close sys_chmod])

  ;; How many WASI functions there are (enum Wasi, none aside), AIPL's own
  ;; aipl_net_v1 and aipl_sys_v1 among them.
  (const NWASI:i32 21)

  ;; A struct of the module and its layout (checker.rs get_field_offset):
  ;; fields in declaration order, each aligned to its alignment (a scalar's
  ;; is its size, a value struct's its largest field's). A value struct
  ;; (`value`, AIPL_SPEC.md 4.E) is also its scalars, flattened: `width` of
  ;; them, with their types and offsets (flat_ty, flat_off). Laid out on
  ;; first use (`laid`), since a field may hold a struct declared later.
  (struct StructInfo [name_pos:i32 name_len:i32 size:i32 fields:(arr (ptr Field)) nfields:i32
                      node:(ptr compiler.Node) value:bool laid:bool align:i32 width:i32
                      flat_ty:(arr Ty) flat_off:(arr i32) union_of:(ptr UnionInfo) result:bool])
  ;; A field: a value struct one (ty Ty.value) names its struct (vs) and
  ;; starts at scalar `slot` of its struct's.
  (struct Field [name_pos:i32 name_len:i32 offset:i32 ty:Ty vs:(ptr StructInfo) slot:i32])

  ;; A union of the module (checker.rs variant_layout): each variant's cell
  ;; holds its index (the tag) at offset 0 and its fields from offset 4,
  ;; laid out like a struct's.
  ;; A union held by value (checker.rs SumLayout: value) is described for
  ;; the rest of the compile as a value struct of its slots (vs: the tag,
  ;; then the slots its variants share by kind), each variant's scalars
  ;; going to the slots in its `slots` (nslots of them).
  (struct UnionInfo [name_pos:i32 name_len:i32 variants:(arr (ptr VariantInfo)) nvariants:i32
                     value:bool vs:(ptr StructInfo)])
  (struct VariantInfo [name_pos:i32 name_len:i32 size:i32 fields:(arr (ptr Field)) nfields:i32
                       node:(ptr compiler.Node) slots:(arr i32) nslots:i32 kinds:(ptr (vec.Vec Ty))])

  ;; A local of the function being compiled (parameters first): its name (a
  ;; span of the source) and type. A loop's hidden end and step locals carry
  ;; the loop variable's name and the type loop_end / loop_step. `from` says
  ;; where its type is written, for a result's payload types (Desc); `bound`
  ;; marks a match_result binder already typed (binder_types). A value
  ;; struct local (ty Ty.value) names its struct (vs); `slot` is its first
  ;; wasm local (assign_slots), a value struct being one per scalar.
  (struct Local [name_pos:i32 name_len:i32 ty:Ty from:(ptr Desc) bound:bool vs:(ptr StructInfo) slot:i32])

  ;; Where a type can be read off the source: a type node (`expr` false), or
  ;; an expression of that type (`expr` true). A null Desc, or a null node,
  ;; is unknown, read as i32 (wasm.rs result_sides).
  (struct Desc [node:(ptr compiler.Node) expr:bool])

  ;; A function of the module: its name (a span of the source), parameter
  ;; and result types (and value structs: ret_vs, pvs), wasm index, and
  ;; definition.
  (struct FnInfo [name_pos:i32 name_len:i32 nparams:i32 ret:Ty index:i32
                  node:(ptr compiler.Node) params:(arr Ty) ret_vs:(ptr StructInfo) pvs:(arr (ptr StructInfo))])

  ;; A scratch group of locals holding a value struct (wasm.rs value_groups):
  ;; an if, match, match_result, or with that yields one (spill false), or
  ;; a value read from or stored to where it is computed (spill true).
  (struct Group [node:(ptr compiler.Node) spill:bool ty:Ty vs:(ptr StructInfo) slot:i32])

  (fn new_cg [src:i32] -> (ptr Cg)
    (let cg:(ptr Cg) (new Cg (call alloc.forever) [src:src
                                                   locals:(arr.new (ptr Local) (call alloc.forever) 64)
                                                   nlocals:0
                                                   fns:(arr.new (ptr FnInfo) (call alloc.forever) 64)
                                                   nfns:0
                                                   structs:(arr.new (ptr StructInfo) (call alloc.forever) 16)
                                                   nstructs:0
                                                   unions:(arr.new (ptr UnionInfo) (call alloc.forever) 16)
                                                   nunions:0
                                                   wasi:(arr.new i32 (call alloc.forever) NWASI)
                                                   nimports:(zero i32)
                                                   labels:(zero (arr Label))
                                                   nlabels:(zero i32)
                                                   uses_refs:(zero bool)
                                                   sigs:(zero (arr (ptr Sig)))
                                                   nsigs:(zero i32)
                                                   strs:(zero (arr (ptr StrLit)))
                                                   nstrs:(zero i32)
                                                   blob:(zero (ptr buf.Buf))
                                                   newline:(zero i32)
                                                   uses_checks:(zero bool)
                                                   checks_base:(zero i32)
                                                   ens_block:(zero bool)
                                                   src_len:(zero i32)
                                                   places:(zero (ptr places.Places))
                                                   scratch:(zero i32)
                                                   groups:(zero (ptr (vec.Vec (ptr Group))))
                                                   has_values:(zero bool)
                                                   results:(zero (ptr (vec.Vec (ptr StructInfo))))
                                                   may_free:(zero (arr bool))
                                                   proven:(zero (ptr (vec.Vec (ptr compiler.Node))))
                                                   versioning:(zero bool)
                                                   max_pages:(zero i32)]))
    (for w 0 NWASI (arr.set i32 (get cg Cg.wasi) w -1))
    (put cg Cg.nimports 0)
    (put cg Cg.labels (arr.new Label (call alloc.forever) 255))
    (put cg Cg.nlabels 0)
    (put cg Cg.uses_refs false)
    (put cg Cg.uses_checks false)
    (put cg Cg.checks_base 0)
    (put cg Cg.ens_block false)
    (put cg Cg.src_len 0)
    (put cg Cg.sigs (arr.new (ptr Sig) (call alloc.forever) 8))
    (put cg Cg.nsigs 0)
    (put cg Cg.strs (arr.new (ptr StrLit) (call alloc.forever) 256))
    (put cg Cg.nstrs 0)
    (put cg Cg.blob (call buf.make (call alloc.default) 4096))
    (put cg Cg.newline 0)
    (put cg Cg.max_pages MAX_PAGES)
    (put cg Cg.scratch 0)
    (put cg Cg.has_values false)
    (put cg Cg.results (call (vec.make (ptr StructInfo)) (call alloc.default) 8))
    (put cg Cg.groups (call (vec.make (ptr Group)) (call alloc.default) 16))
    (put cg Cg.may_free (arr.new bool (call alloc.forever) 1))
    (put cg Cg.proven (call (vec.make (ptr compiler.Node)) (call alloc.default) 8))
    (put cg Cg.versioning true)
    cg)

  ;; ===== Runtime memory cells (AIPL_SPEC.md 7.9) =====
  ;; The compile's state is in Cg. These cells remain:
  ;;   mem[4]  = compile error code (0 = none; read by the host)
  ;;   mem[16] = keyword map (Keywords)
  ;;   mem[44], mem[48] = callee name span after compile error 1452 (read by the host)
  ;;   mem[60] = compiled module output pointer (read by the host)

  ;; The structured instructions around the code being compiled, innermost
  ;; last, so break and continue can compute their branch depth (wasm.rs
  ;; Label): an if/else, the block a loop's break leaves, the loop a while's
  ;; continue restarts, and the block around a loop body that a loop's
  ;; continue leaves (falling into the step).
  (enum Label [if_else loop_exit loop_header loop_body])

  ;; The stack grows as needed, as wasm.rs's Vec does (a fixed 255 refused
  ;; a 259-branch cond, then crashed when its callers popped what was
  ;; never pushed).
  (fn label_push [cg:(ptr Cg) l:Label] -> i32
    (let n:i32 (get cg Cg.nlabels))
    (when (gte n (arr.len (get cg Cg.labels)))
          (let bigger:(arr Label) (arr.new Label (call alloc.forever) (* 2 n)))
          (for i 0 n (arr.set Label bigger i (arr.get Label (get cg Cg.labels) i)))
          (put cg Cg.labels bigger))
    (arr.set Label (get cg Cg.labels) n l)
    (put cg Cg.nlabels (+ n 1))
    0)
  (fn label_pop [cg:(ptr Cg)] -> i32
    (put cg Cg.nlabels (- (get cg Cg.nlabels) 1))
    0)
  ;; Branch depth to the innermost label a or b (compile error 101 if none).
  (fn label_depth [cg:(ptr Cg) a:Label b:Label] -> i32
    (let n:i32 (get cg Cg.nlabels))
    (for d 0 n
      (let l:Label (arr.get Label (get cg Cg.labels) (- (- n 1) d)))
      (when (or (eq l a) (eq l b)) (return d)))
    (call set_compile_error CgErr.jump_outside_loop)
    0)
  ;; String literals are placed at 1024; the heap starts at the first 8-aligned
  ;; address after them (wasm.rs heap_start_after), and stores below it trap.
  (fn heap_start [cg:(ptr Cg)] -> i32 (bitand (+ 1031 (call buf.len (get cg Cg.blob))) -8))

  ;; Idempotent: allocates the tables on first call, and clears error flags.
  ;; Builds the keyword map once (cell 16) and clears the error flag (cell 4);
  ;; everything else a compile needs is in its Cg.
  (fn codegen_init [] -> i32
    (unsafe (when (eq (mem.load32 16) 0) (mem.store32 16 (ptr.addr (call new_keywords))))
    (mem.store32 4 0)
    0))

  ;; ===== Keywords =====
  ;; Every word with a meaning of its own: ops (0-86), forms (100-115), and
  ;; type names (200-209); none for any other symbol. The values are the ids
  ;; the code generator has always used.
  (enum Kw [(none -1) (add 0) (sub 1) (mul 2) (div 3) (xor 4) (shl 5) (shr 6) (bitand 7) (bitor 8) (mem_load8 9) (mem_load32 10) (mem_load64 11) (mem_store8 12) (mem_store32 13) (mem_store64 14) (eq 15) (neq 16) (lt 17) (lte 18) (gt 19) (gte 20) (and 21) (or 22) (not 23) (mem_load8_s 24) (mem_load16_u 25) (mem_load16_s 26) (mem_store16 27) (arr_gen 28) (str_len 30) (str_ptr 31) (sys_print 32) (sys_exit 33) (fs_open 34) (fs_read 35) (fs_write 36) (fs_close 37) (fs_delete 38) (rem 39) (divu 40) (remu 41) (shru 42) (mem_alloc 43) (mem_grow 44) (i64_extend_s 45) (i64_extend_u 46) (i32_wrap 47) (ok 48) (err 49) (get 51) (put 52) (sizeof 53) (arr_get 55) (arr_set 56) (f64_convert_i64_s 57) (i64_trunc_f64_s 58) (f64_reinterpret_i64 59) (i64_reinterpret_f64 60) (ptr_null 61) (ptr_cast 62) (ptr_addr 63) (arr_null 64) (arr_cast 65) (arr_addr 66) (arr_len 67) (ref 68) (call_ref 69) (return 70) (break 71) (continue 72) (args_sizes 73) (args_get 74) (env_sizes 75) (env_get 76) (thread_spawn 77) (thread_join 78) (atomic_add 79) (atomic_cas 80) (atomic_lock 81) (atomic_unlock 82) (sys_time 83) (sys_monotonic 84) (sys_random 85) (f64_sqrt 86) (ltu 87) (lteu 88) (gtu 89) (gteu 90) (checked_add 91) (checked_sub 92) (checked_mul 93) (fs_opendir 94) (fs_readdir 95) (fs_stat 96) (ptr_make 97) (arr_make 98) (ptr_gen 99) (let 100) (set 101) (if 102) (loop 103) (while 104) (call 105) (block 106) (req 107) (ens 108) (inv 109) (module 110) (fn 111) (match_result 112) (struct 113) (cond 114) (else 115) (union 116) (match 117) (make 118) (with 119) (ty_i32 200) (ty_i64 201) (ty_f32 202) (ty_f64 203) (ty_bool 204) (ty_void 205) (ty_str 206) (ty_result 207) (ty_ptr 208) (ty_arr 209) (ty_u8 210) (ty_i8 211) (ty_u16 212) (ty_i16 213) (f32_demote 300) (f64_promote 301) (f32_convert_i32_s 302) (f32_convert_i64_s 303) (f64_convert_i32_s 304) (i32_trunc_f32_s 305) (i32_trunc_f64_s 306) (i64_trunc_f32_s 307) (f32_reinterpret_i32 308) (i32_reinterpret_f32 309) (net_listen 310) (net_accept 311) (net_recv 312) (net_send 313) (net_close 314) (when 315) (fs_chmod 316)])
  (import alloc)

  ;; The keyword map, at cell 16: keyword text -> Kw, plus one scratch slice
  ;; so that a lookup allocates nothing.
  (struct Keywords [map:(ptr (map.Map str.Bytes Kw))])

  (fn keywords [] -> (ptr Keywords) (unsafe (ptr.cast Keywords (mem.load32 16))))

  (fn new_keywords [] -> (ptr Keywords)
    (unsafe (let ks:(ptr Keywords) (new Keywords (call alloc.forever) [map:(call (map.make str.Bytes Kw) (call alloc.default) 256)]))
    ks))

  (fn reg [m:(ptr (map.Map str.Bytes Kw)) word:str k:Kw] -> void
    (call (map.set str.Bytes Kw) m (call str.from_str word) k))

  ;; Fills the keyword map once (it also runs codegen_init, every time).
  (fn init_keywords [] -> i32
    (let _init:i32 (call codegen_init))
    (let m:(ptr (map.Map str.Bytes Kw)) (get (call keywords) Keywords.map))
    (when (gt (call (map.count str.Bytes Kw) m) 0) (return 0))
    (call reg m "+" Kw.add)
    (call reg m "-" Kw.sub)
    (call reg m "*" Kw.mul)
    (call reg m "/" Kw.div)
    (call reg m "^" Kw.xor)
    (call reg m "shl" Kw.shl)
    (call reg m "shr" Kw.shr)
    (call reg m "bitand" Kw.bitand)
    (call reg m "bitor" Kw.bitor)
    (call reg m "mem.load8" Kw.mem_load8)
    (call reg m "mem.load32" Kw.mem_load32)
    (call reg m "mem.load64" Kw.mem_load64)
    (call reg m "mem.store8" Kw.mem_store8)
    (call reg m "mem.load8_s" Kw.mem_load8_s)
    (call reg m "mem.load16_u" Kw.mem_load16_u)
    (call reg m "mem.load16_s" Kw.mem_load16_s)
    (call reg m "mem.store16" Kw.mem_store16)
    (call reg m "mem.store32" Kw.mem_store32)
    (call reg m "mem.store64" Kw.mem_store64)
    (call reg m "eq" Kw.eq)
    (call reg m "neq" Kw.neq)
    (call reg m "lt" Kw.lt)
    (call reg m "lte" Kw.lte)
    (call reg m "gt" Kw.gt)
    (call reg m "gte" Kw.gte)
    (call reg m "and" Kw.and)
    (call reg m "or" Kw.or)
    (call reg m "not" Kw.not)
    (call reg m "str.len" Kw.str_len)
    (call reg m "str.ptr" Kw.str_ptr)
    (call reg m "sys.print" Kw.sys_print)
    (call reg m "sys.exit" Kw.sys_exit)
    (call reg m "fs.open" Kw.fs_open)
    (call reg m "fs.read" Kw.fs_read)
    (call reg m "fs.write" Kw.fs_write)
    (call reg m "fs.close" Kw.fs_close)
    (call reg m "fs.delete" Kw.fs_delete)
    (call reg m "fs.opendir" Kw.fs_opendir)
    (call reg m "fs.readdir" Kw.fs_readdir)
    (call reg m "fs.stat" Kw.fs_stat)
    (call reg m "net.listen" Kw.net_listen)
    (call reg m "net.accept" Kw.net_accept)
    (call reg m "net.recv" Kw.net_recv)
    (call reg m "net.send" Kw.net_send)
    (call reg m "net.close" Kw.net_close)
    (call reg m "fs.chmod" Kw.fs_chmod)
    (call reg m "%" Kw.rem)
    (call reg m "divu" Kw.divu)
    (call reg m "remu" Kw.remu)
    (call reg m "shru" Kw.shru)
    (call reg m "mem.alloc" Kw.mem_alloc)
    (call reg m "mem.grow" Kw.mem_grow)
    (call reg m "i64.extend_s" Kw.i64_extend_s)
    (call reg m "i64.extend_u" Kw.i64_extend_u)
    (call reg m "i32.wrap" Kw.i32_wrap)
    (call reg m "ok" Kw.ok)
    (call reg m "err" Kw.err)
    (call reg m "get" Kw.get)
    (call reg m "put" Kw.put)
    (call reg m "sizeof" Kw.sizeof)
    (call reg m "arr.get" Kw.arr_get)
    (call reg m "arr.set" Kw.arr_set)
    (call reg m "f64.convert_i64_s" Kw.f64_convert_i64_s)
    (call reg m "f32.demote" Kw.f32_demote)
    (call reg m "f64.promote" Kw.f64_promote)
    (call reg m "f32.convert_i32_s" Kw.f32_convert_i32_s)
    (call reg m "f32.convert_i64_s" Kw.f32_convert_i64_s)
    (call reg m "f64.convert_i32_s" Kw.f64_convert_i32_s)
    (call reg m "i32.trunc_f32_s" Kw.i32_trunc_f32_s)
    (call reg m "i32.trunc_f64_s" Kw.i32_trunc_f64_s)
    (call reg m "i64.trunc_f32_s" Kw.i64_trunc_f32_s)
    (call reg m "f32.reinterpret_i32" Kw.f32_reinterpret_i32)
    (call reg m "i32.reinterpret_f32" Kw.i32_reinterpret_f32)
    (call reg m "i64.trunc_f64_s" Kw.i64_trunc_f64_s)
    (call reg m "f64.reinterpret_i64" Kw.f64_reinterpret_i64)
    (call reg m "i64.reinterpret_f64" Kw.i64_reinterpret_f64)
    (call reg m "ptr.null" Kw.ptr_null)
    (call reg m "ptr.cast" Kw.ptr_cast)
    (call reg m "ptr.make" Kw.ptr_make)
    (call reg m "arr.make" Kw.arr_make)
    (call reg m "ptr.gen" Kw.ptr_gen)
    (call reg m "arr.gen" Kw.arr_gen)
    (call reg m "ptr.addr" Kw.ptr_addr)
    (call reg m "arr.null" Kw.arr_null)
    (call reg m "arr.cast" Kw.arr_cast)
    (call reg m "arr.addr" Kw.arr_addr)
    (call reg m "arr.len" Kw.arr_len)
    (call reg m "ref" Kw.ref)
    (call reg m "call_ref" Kw.call_ref)
    (call reg m "return" Kw.return)
    (call reg m "break" Kw.break)
    (call reg m "continue" Kw.continue)
    (call reg m "args.sizes" Kw.args_sizes)
    (call reg m "args.get" Kw.args_get)
    (call reg m "env.sizes" Kw.env_sizes)
    (call reg m "env.get" Kw.env_get)
    (call reg m "thread.spawn" Kw.thread_spawn)
    (call reg m "thread.join" Kw.thread_join)
    (call reg m "atomic.add" Kw.atomic_add)
    (call reg m "atomic.cas" Kw.atomic_cas)
    (call reg m "atomic.lock" Kw.atomic_lock)
    (call reg m "atomic.unlock" Kw.atomic_unlock)
    (call reg m "sys.time" Kw.sys_time)
    (call reg m "sys.monotonic" Kw.sys_monotonic)
    (call reg m "sys.random" Kw.sys_random)
    (call reg m "f64.sqrt" Kw.f64_sqrt)
    (call reg m "ltu" Kw.ltu)
    (call reg m "lteu" Kw.lteu)
    (call reg m "gtu" Kw.gtu)
    (call reg m "gteu" Kw.gteu)
    (call reg m "checked.add" Kw.checked_add)
    (call reg m "checked.sub" Kw.checked_sub)
    (call reg m "checked.mul" Kw.checked_mul)
    (call reg m "let" Kw.let)
    (call reg m "set!" Kw.set)
    (call reg m "if" Kw.if)
    (call reg m "when" Kw.when)
    (call reg m "counted_loop" Kw.loop)
    (call reg m "while" Kw.while)
    (call reg m "call" Kw.call)
    (call reg m "block" Kw.block)
    ;; (unsafe e...) compiles as a block; the (unsafe) clause, as an empty one
    (call reg m "unsafe" Kw.block)
    ;; the (no_leak) clause compiles to nothing, as (unsafe) does
    (call reg m "no_leak" Kw.block)
    (call reg m "req" Kw.req)
    (call reg m "ens" Kw.ens)
    (call reg m "inv" Kw.inv)
    (call reg m "module" Kw.module)
    (call reg m "fn" Kw.fn)
    (call reg m "match_result" Kw.match_result)
    (call reg m "union" Kw.union)
    (call reg m "match" Kw.match)
    (call reg m "make" Kw.make)
    (call reg m "with" Kw.with)
    (call reg m "struct" Kw.struct)
    (call reg m "cond" Kw.cond)
    (call reg m "else" Kw.else)
    (call reg m "i32" Kw.ty_i32)
    (call reg m "i64" Kw.ty_i64)
    (call reg m "f32" Kw.ty_f32)
    (call reg m "f64" Kw.ty_f64)
    (call reg m "bool" Kw.ty_bool)
    (call reg m "void" Kw.ty_void)
    (call reg m "str" Kw.ty_str)
    (call reg m "result" Kw.ty_result)
    (call reg m "ptr" Kw.ty_ptr)
    (call reg m "arr" Kw.ty_arr)
    (call reg m "u8" Kw.ty_u8)
    (call reg m "i8" Kw.ty_i8)
    (call reg m "u16" Kw.ty_u16)
    (call reg m "i16" Kw.ty_i16)
    0)

  ;; An operator (as opposed to a form, a type name, or none): ids 0-99.
  (fn is_op [k:Kw] -> bool
    (or (and (gte (enum.ord k) 0) (lt (enum.ord k) 100)) (call is_conversion k)))

  ;; The f32 conversions, Kw 300-309, in wasm.rs order.
  (fn is_conversion [k:Kw] -> bool
    (and (gte (enum.ord k) 300) (lte (enum.ord k) 309)))

  ;; return, break, continue: statements that jump.
  (fn is_jump [k:Kw] -> bool
    (or (eq k Kw.return) (or (eq k Kw.break) (eq k Kw.continue))))

  ;; Arithmetic and bitwise ops, whose type is their operands' type.
  (fn is_arith [k:Kw] -> bool
    (or (or (eq k Kw.add) (or (eq k Kw.sub) (or (eq k Kw.mul) (or (eq k Kw.div) (eq k Kw.xor)))))
        (or (or (eq k Kw.shl) (or (eq k Kw.shr) (or (eq k Kw.bitand) (eq k Kw.bitor))))
            (or (or (eq k Kw.rem) (or (eq k Kw.divu) (or (eq k Kw.remu) (eq k Kw.shru))))
                (call is_checked k)))))

  ;; checked.add / checked.sub / checked.mul: arithmetic that traps on overflow.
  (fn is_checked [k:Kw] -> bool
    (or (eq k Kw.checked_add) (or (eq k Kw.checked_sub) (eq k Kw.checked_mul))))

  ;; Comparisons and logic, which yield bool.
  (fn is_compare [k:Kw] -> bool
    (or (or (eq k Kw.eq) (or (eq k Kw.neq) (or (eq k Kw.lt) (or (eq k Kw.lte) (or (eq k Kw.gt) (eq k Kw.gte))))))
        (or (or (eq k Kw.and) (or (eq k Kw.or) (eq k Kw.not)))
            (or (eq k Kw.ltu) (or (eq k Kw.lteu) (or (eq k Kw.gtu) (eq k Kw.gteu)))))))

  ;; The WASI function behind args.sizes / args.get / env.sizes / env.get, or none.
  (fn proc_wasi [k:Kw] -> Wasi
    (cond
      ((eq k Kw.args_sizes) Wasi.args_sizes_get)
      ((eq k Kw.args_get) Wasi.args_get)
      ((eq k Kw.env_sizes) Wasi.environ_sizes_get)
      ((eq k Kw.env_get) Wasi.environ_get)
      (else Wasi.none)))

  ;; The keyword spelled by len bytes at src_ptr + pos, or Kw.none.
  (fn classify_keyword [cg:(ptr Cg) pos:i32 len:i32] -> Kw
    (let ks:(ptr Keywords) (call keywords))
    (let key:str.Bytes (unsafe (call str.bytes (+ (get cg Cg.src) pos) len)))
    (call (map.get_or str.Bytes Kw) (get ks Keywords.map) key Kw.none))

;; ===== Types =====
  ;; A value's static type, as expr_type in wasm.rs computes it. bool, str,
  ;; results, pointers, arrays, and function refs are i32 in wasm; loop_end
  ;; and loop_step are the hidden locals holding a loop's bound and step.
  ;; The values are the ids codegen has always stored in its tables.
  (enum Ty [(none -1) (i32 200) i64 f32 f64 bool void str result ptr arr fn loop_end loop_step ck_a ck_b ck_r union value u8 i8 u16 i16])

  ;; The type a type keyword names, or Ty.none.
  (fn ty_of_kw [k:Kw] -> Ty
    (cond
      ((eq k Kw.ty_i32) Ty.i32)
      ((eq k Kw.ty_i64) Ty.i64)
      ((eq k Kw.ty_f32) Ty.f32)
      ((eq k Kw.ty_f64) Ty.f64)
      ((eq k Kw.ty_bool) Ty.bool)
      ((eq k Kw.ty_void) Ty.void)
      ((eq k Kw.ty_str) Ty.str)
      ((eq k Kw.ty_result) Ty.result)
      ((eq k Kw.ty_ptr) Ty.ptr)
      ((eq k Kw.ty_arr) Ty.arr)
      ((eq k Kw.ty_u8) Ty.u8)
      ((eq k Kw.ty_i8) Ty.i8)
      ((eq k Kw.ty_u16) Ty.u16)
      ((eq k Kw.ty_i16) Ty.i16)
      (else Ty.none)))

  ;; The type a type node names: a scalar or union name, or a (result T E),
  ;; (ptr S), (arr T), or (fn [..] -> r) group. Anything else is compile
  ;; error 98.
  (fn type_node_id [cg:(ptr Cg) node:(ptr compiler.Node)] -> Ty
    (let t:Ty Ty.none)
    (if (eq (call node_kind node) compiler.Kind.symbol)
        (block
          (set! t (call ty_of_kw (call classify_keyword cg (call node_a node) (call node_b node))))
          (let un:(ptr UnionInfo) (if (eq t Ty.none) (call find_union cg (call node_a node) (call node_b node)) (ptr.null UnionInfo)))
          (when (neq un (ptr.null UnionInfo))
              (set! t (if (get un UnionInfo.value) Ty.value Ty.union)))
          (when (and (eq t Ty.none) (neq (call type_node_struct cg node) (ptr.null StructInfo)))
              (set! t Ty.value)))
        (when (eq (call node_kind node) compiler.Kind.paren)
              (let head:Kw (call group_head_keyword cg node))
              (when (or (eq head Kw.ty_result) (or (eq head Kw.ty_ptr) (eq head Kw.ty_arr))) (set! t (call ty_of_kw head)))
              ;; a result held by value (AIPL_SPEC.md 4.F)
              (when (and (eq head Kw.ty_result) (neq (call result_info cg (call desc node false)) (ptr.null StructInfo))) (set! t Ty.value))
              (when (eq head Kw.fn) (set! t Ty.fn))))
    (if (eq t Ty.none)
        (block (call set_compile_error CgErr.unlowerable_type) Ty.i32)
        t))

;; The value struct a type node names (laid out), or null: only a value
  ;; struct is named bare (a struct behind a pointer is (ptr S)).
  (fn type_node_struct [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr StructInfo)
    (when (eq (call group_head_keyword cg node) Kw.ty_result) (return (call result_info cg (call desc node false))))
    (when (neq (call node_kind node) compiler.Kind.symbol) (return (ptr.null StructInfo)))
    ;; a union held by value is described as one
    (let un:(ptr UnionInfo) (call find_union cg (call node_a node) (call node_b node)))
    (when (and (neq un (ptr.null UnionInfo)) (get un UnionInfo.value)) (return (get un UnionInfo.vs)))
    (let si:(ptr StructInfo) (call find_struct cg (call node_a node) (call node_b node)))
    (when (or (eq si (ptr.null StructInfo)) (not (get si StructInfo.value))) (return (ptr.null StructInfo)))
    (call layout_struct cg si)
    si)

  ;; A value of type t (and value struct vs, for Ty.value) in memory: its
  ;; size, its alignment, and how many wasm values it is (wasm.rs width).
  (fn ty_size [t:Ty vs:(ptr StructInfo)] -> i32
    (if (and (eq t Ty.value) (neq vs (ptr.null StructInfo))) (get vs StructInfo.size) (call type_size t)))
  (fn ty_align [t:Ty vs:(ptr StructInfo)] -> i32
    (if (and (eq t Ty.value) (neq vs (ptr.null StructInfo))) (get vs StructInfo.align) (call type_size t)))
  (fn width [t:Ty vs:(ptr StructInfo)] -> i32
    (cond
      ((and (eq t Ty.value) (neq vs (ptr.null StructInfo))) (get vs StructInfo.width))
      ((eq t Ty.void) 0)
      (else 1)))

  ;; The wasm value type byte: 0x7f i32, 0x7e i64, 0x7d f32, 0x7c f64.
  (fn type_id_to_valtype [t:Ty] -> i32
    (cond
      ((eq t Ty.i64) 126)
      ;; pointers and arrays: the address and the generation (GENERATIONS_PLAN.md)
      ((or (eq t Ty.ptr) (eq t Ty.arr)) 126)
      ;; checked arithmetic's hidden operand and result locals
      ((or (eq t Ty.ck_a) (or (eq t Ty.ck_b) (eq t Ty.ck_r))) 126)
      ((eq t Ty.f32) 125)
      ((eq t Ty.f64) 124)
      ((eq t Ty.void) (call set_compile_error CgErr.unlowerable_type) 127)
      ((eq t Ty.none) (call set_compile_error CgErr.unlowerable_type) 127)
      (else 127)))

  ;; Block type byte for a value of this type: 0x40 (empty) for void.
  (fn block_type_byte [t:Ty] -> i32
    (if (eq t Ty.void) 64 (call type_id_to_valtype t)))

  ;; Scalars that can live in a struct field or array element.
  (fn is_memory_type [t:Ty] -> bool
    (not (or (or (eq t Ty.void) (or (eq t Ty.result) (or (eq t Ty.none) (or (eq t Ty.loop_end) (eq t Ty.loop_step)))))
             (or (eq t Ty.ck_a) (or (eq t Ty.ck_b) (eq t Ty.ck_r))))))
  ;; Element type of arr.new/get/set: a memory scalar, else compile error 95.
  ;; (A result, held by value or not, is never in memory: compile error 95.)
  (fn elem_type_id [cg:(ptr Cg) node:(ptr compiler.Node)] -> Ty
    (let t:Ty (call type_node_id cg node))
    (if (and (call is_memory_type t) (neq (call group_head_keyword cg node) Kw.ty_result)) t (block (call set_compile_error CgErr.not_a_memory_type) Ty.i32)))
  (fn type_size [t:Ty] -> i32
    (cond
      ((or (or (eq t Ty.i64) (eq t Ty.f64)) (or (eq t Ty.ptr) (eq t Ty.arr))) 8)
      ((or (eq t Ty.u8) (eq t Ty.i8)) 1)
      ((or (eq t Ty.u16) (eq t Ty.i16)) 2)
      (else 4)))
  ;; Whether t is a storage type (u8, i8, u16, i16): read as an i32.
  (fn is_narrow [t:Ty] -> bool (or (or (eq t Ty.u8) (eq t Ty.i8)) (or (eq t Ty.u16) (eq t Ty.i16))))
  (fn value_of [t:Ty] -> Ty (if (call is_narrow t) Ty.i32 t))
  (fn mem_align [t:Ty] -> i32 (cond ((eq (call type_size t) 8) 3) ((eq (call type_size t) 2) 1) ((eq (call type_size t) 1) 0) (else 2)))
  (fn load_opcode [t:Ty] -> i32 (cond
                                  ((or (eq t Ty.i64) (or (eq t Ty.ptr) (eq t Ty.arr))) 41)
                                  ((eq t Ty.u8) 45) ((eq t Ty.i8) 44) ((eq t Ty.u16) 47) ((eq t Ty.i16) 46)
                                  ((eq t Ty.f32) 42)
                                  ((eq t Ty.f64) 43)
                                  (else 40)))
  (fn store_opcode [t:Ty] -> i32 (cond
                                   ((or (eq t Ty.i64) (or (eq t Ty.ptr) (eq t Ty.arr))) 55)
                                   ((or (eq t Ty.u8) (eq t Ty.i8)) 58) ((or (eq t Ty.u16) (eq t Ty.i16)) 59)
                                   ((eq t Ty.f32) 56)
                                   ((eq t Ty.f64) 57)
                                   (else 54)))

  ;; ===== Function table =====
  (fn func_entry_ptr [cg:(ptr Cg) idx:i32] -> (ptr FnInfo)
    (arr.get (ptr FnInfo) (get cg Cg.fns) idx))

  ;; Records every (fn ...) of the module, in order; returns the count.
  (fn collect_functions [cg:(ptr Cg) root:(ptr compiler.Node)] -> i32
    (let count:i32 0)
    (let child:(ptr compiler.Node) (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (when (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.fn))
            (let fname_node:(ptr compiler.Node) (call nth_child child 1))
            (let params_node:(ptr compiler.Node) (call nth_child child 2))
            (let f:(ptr FnInfo) (new FnInfo (call alloc.forever) [name_pos:(call node_a fname_node)
                                                                  name_len:(call node_b fname_node)
                                                                  nparams:(zero i32)
                                                                  ret:(call type_node_id cg (call nth_child child 4))
                                                                  index:(zero i32)
                                                                  node:(zero (ptr compiler.Node))
                                                                  params:(zero (arr Ty))
                                                                  ret_vs:(call type_node_struct cg (call nth_child child 4))
                                                                  pvs:(zero (arr (ptr StructInfo)))]))
            (put f FnInfo.index count)
            (put f FnInfo.node child)
            ;; room for every parameter: name : type, three items each
            (let np:i32 1)
            (let pc:(ptr compiler.Node) (call first_child params_node))
            (while (neq pc (ptr.null compiler.Node)) (set! np (+ np 1)) (set! pc (call node_next pc)))
            (put f FnInfo.params (arr.new Ty (call alloc.forever) np))
            (put f FnInfo.pvs (arr.new (ptr StructInfo) (call alloc.forever) np))
            (let pcount:i32 0)
            (let pchild:(ptr compiler.Node) (call first_child params_node))
            (while (neq pchild (ptr.null compiler.Node))
              (let ptype_node:(ptr compiler.Node) (call node_next (call node_next pchild)))
              (arr.set Ty (get f FnInfo.params) pcount (call type_node_id cg ptype_node))
              (arr.set (ptr StructInfo) (get f FnInfo.pvs) pcount (call type_node_struct cg ptype_node))
              (set! pcount (+ pcount 1))
              (set! pchild (call node_next ptype_node)))
            (put f FnInfo.nparams pcount)
            (put cg Cg.fns (call (room (ptr FnInfo)) (get cg Cg.fns) count))
            (arr.set (ptr FnInfo) (get cg Cg.fns) count f)
            (set! count (+ count 1)))
      (set! child (call node_next child)))
    count)

  ;; Exact name match, as in the checker: `a.f` never resolves to a bare `f`.
  (fn find_function [cg:(ptr Cg) name_ptr:i32 name_len:i32] -> i32
    (for i 0 (get cg Cg.nfns)
      (let entry:(ptr FnInfo) (call func_entry_ptr cg i))
      (when (call sym_eq cg name_ptr name_len (+ (get cg Cg.src) (get entry FnInfo.name_pos)) (get entry FnInfo.name_len))
          (return i)))
    -1)

  ;; ===== Local variable table =====
  (fn local_at [cg:(ptr Cg) idx:i32] -> (ptr Local)
    (arr.get (ptr Local) (get cg Cg.locals) idx))

  (fn find_local [cg:(ptr Cg) name_ptr:i32 name_len:i32] -> i32
    (for i 0 (get cg Cg.nlocals)
      (let l:(ptr Local) (call local_at cg i))
      (when (call sym_eq cg name_ptr name_len (+ (get cg Cg.src) (get l Local.name_pos)) (get l Local.name_len))
          (return i)))
    -1)

  ;; Appends a local.
  (fn add_local [cg:(ptr Cg) name_ptr:i32 name_len:i32 ty:Ty vs:(ptr StructInfo)] -> void
    (let count:i32 (get cg Cg.nlocals))
    (let l:(ptr Local) (new Local (call alloc.forever) [name_pos:name_ptr
                                                        name_len:name_len
                                                        ty:ty
                                                        from:(zero (ptr Desc))
                                                        bound:(zero bool)
                                                        vs:vs
                                                        slot:(zero i32)]))
    (put cg Cg.locals (call (room (ptr Local)) (get cg Cg.locals) count))
    (arr.set (ptr Local) (get cg Cg.locals) count l)
    (put cg Cg.nlocals (+ count 1)))

  (fn add_local_if_new [cg:(ptr Cg) name_ptr:i32 name_len:i32 ty:Ty vs:(ptr StructInfo)] -> i32
    (when (eq (call find_local cg name_ptr name_len) -1) (call add_local cg name_ptr name_len ty vs))
    0)

  ;; The first wasm local of the local named so (-1 if there is none).
  (fn local_slot [cg:(ptr Cg) name_ptr:i32 name_len:i32] -> i32
    (call slot_of cg (call find_local cg name_ptr name_len)))

  (fn slot_of [cg:(ptr Cg) idx:i32] -> i32
    (if (lt idx 0) idx (get (call local_at cg idx) Local.slot)))

  ;; The local named by a symbol node: its first wasm local, and how many.
  (fn node_slot [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (call local_slot cg (call node_a node) (call node_b node)))

  ;; Numbers the wasm locals of the function's locals, in table order: a
  ;; value struct is one per scalar. Returns how many there are.
  (fn assign_slots [cg:(ptr Cg)] -> i32
    (let n:i32 0)
    (for i 0 (get cg Cg.nlocals)
      (let l:(ptr Local) (call local_at cg i))
      (put l Local.slot n)
      (set! n (+ n (call local_width l))))
    n)

  (fn local_width [l:(ptr Local)] -> i32
    (if (eq (get l Local.ty) Ty.value) (call width Ty.value (get l Local.vs)) 1))

  ;; A loop's hidden end / step local (wasm.rs `i#end` / `i#step`), added once
  ;; per name like any local. Lookups by name find the variable itself,
  ;; which is always added first.
  (fn find_hidden [cg:(ptr Cg) name_ptr:i32 name_len:i32 marker:Ty] -> i32
    (for i 0 (get cg Cg.nlocals)
      (let l:(ptr Local) (call local_at cg i))
      (when (and (eq (get l Local.ty) marker)
               (call sym_eq cg name_ptr name_len (+ (get cg Cg.src) (get l Local.name_pos)) (get l Local.name_len)))
          (return i)))
    -1)

  (fn add_hidden_if_new [cg:(ptr Cg) name_ptr:i32 name_len:i32 marker:Ty] -> i32
    (when (lt (call find_hidden cg name_ptr name_len marker) 0) (call add_local cg name_ptr name_len marker (ptr.null StructInfo)))
    0)

  (fn collect_locals_walk [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (if (neq (call node_kind node) compiler.Kind.paren)
        0
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (cond
            ((eq kw Kw.let) (let name_node:(ptr compiler.Node) (call nth_child node 1))
                (let type_node:(ptr compiler.Node) (call nth_child node 3))
                (let type_id:Ty (call type_node_id cg type_node))
                (call add_local_if_new cg (call node_a name_node) (call node_b name_node) type_id (call type_node_struct cg type_node))
                (call note_type_node cg name_node type_node)
                0)
            ((eq kw Kw.loop) (let var_node:(ptr compiler.Node) (call nth_child node 1))
                    (call add_local_if_new cg (call node_a var_node) (call node_b var_node) Ty.i32 (ptr.null StructInfo))
                    (call add_hidden_if_new cg (call node_a var_node) (call node_b var_node) Ty.loop_end)
                    (call add_hidden_if_new cg (call node_a var_node) (call node_b var_node) Ty.loop_step))
            ((eq kw Kw.match_result) (let ok_group:(ptr compiler.Node) (call nth_child node 2))
                        (let err_group:(ptr compiler.Node) (call nth_child node 3))
                        (let ok_var:(ptr compiler.Node) (call nth_child ok_group 1))
                        (let err_var:(ptr compiler.Node) (call nth_child err_group 1))
                        (call add_local_if_new cg (call node_a ok_var) (call node_b ok_var) Ty.i32 (ptr.null StructInfo))
                        (call add_local_if_new cg (call node_a err_var) (call node_b err_var) Ty.i32 (ptr.null StructInfo)))
            ;; every union arm's binders, typed as the variant's fields (wasm.rs collect_lets)
            ((eq kw Kw.match)
             (let arm:(ptr compiler.Node) (call nth_child node 2))
             (while (neq arm (ptr.null compiler.Node))
               (let binders:(ptr compiler.Node) (call node_next (call first_child arm)))
               (let v:(ptr VariantInfo) (call arm_variant cg arm))
               (when (and (eq (call node_kind binders) compiler.Kind.bracket) (neq v (ptr.null VariantInfo)))
                     (let b:(ptr compiler.Node) (call first_child binders))
                     (let k:i32 0)
                     (while (and (neq b (ptr.null compiler.Node)) (lt k (get v VariantInfo.nfields)))
                       (if (call is_wildcard cg b)
                           0
                           (block
                             (let f:(ptr Field) (arr.get (ptr Field) (get v VariantInfo.fields) k))
                             (call add_local_if_new cg (call node_a b) (call node_b b) (get f Field.ty) (get f Field.vs))))
                       (set! k (+ k 1))
                       (set! b (call node_next b))))
               (set! arm (call node_next arm)))
             0)
            ;; checked arithmetic: three hidden i64 locals (wasm.rs CHECKED_LOCALS)
            ((call is_checked kw)
             (call add_hidden_if_new cg 0 0 Ty.ck_a)
             (call add_hidden_if_new cg 0 0 Ty.ck_b)
             (call add_hidden_if_new cg 0 0 Ty.ck_r))
            (else 0))
          (let child:(ptr compiler.Node) (call first_child node))
          (while (neq child (ptr.null compiler.Node)) (let _w:i32 (call collect_locals_walk cg child)) (set! child (call node_next child)))
          0)))

  ;; The first declaration of a name says where its type is written.
  (fn note_type_node [cg:(ptr Cg) name_node:(ptr compiler.Node) type_node:(ptr compiler.Node)] -> void
    (let l:(ptr Local) (call local_at cg (call find_local cg (call node_a name_node) (call node_b name_node))))
    (when (eq (get l Local.from) (ptr.null Desc)) (put l Local.from (call desc type_node false))))

  (fn desc [node:(ptr compiler.Node) expr:bool] -> (ptr Desc)
    (let d:(ptr Desc) (new Desc (call alloc.forever) [node:node expr:expr]))
    d)

  (fn desc_ty [cg:(ptr Cg) d:(ptr Desc)] -> Ty
    (cond
      ((eq d (ptr.null Desc)) Ty.i32)
      ((eq (get d Desc.node) (ptr.null compiler.Node)) Ty.i32)
      ((get d Desc.expr) (call node_type cg (get d Desc.node)))
      (else (call type_node_id cg (get d Desc.node)))))

  ;; The value struct a Desc describes, or null.
  (fn desc_struct [cg:(ptr Cg) d:(ptr Desc)] -> (ptr StructInfo)
    (cond
      ((eq d (ptr.null Desc)) (ptr.null StructInfo))
      ((eq (get d Desc.node) (ptr.null compiler.Node)) (ptr.null StructInfo))
      ((get d Desc.expr) (call node_struct cg (get d Desc.node)))
      (else (call type_node_struct cg (get d Desc.node)))))

  ;; Where the ok (side 0) or err (side 1) payload type of the result `d`
  ;; describes is written (wasm.rs type_in on a result): a (result T E)
  ;; node's T or E, an ok/err's payload or its `:T`, or the type of
  ;; whatever a name, call, or branching form stands for.
  (fn result_side [cg:(ptr Cg) d:(ptr Desc) side:i32] -> (ptr Desc)
    (when (eq d (ptr.null Desc)) (return d))
    (let node:(ptr compiler.Node) (get d Desc.node))
    (when (eq node (ptr.null compiler.Node)) (return (ptr.null Desc)))
    (when (not (get d Desc.expr))
        (return (if (and (eq (call node_kind node) compiler.Kind.paren) (eq (call group_head_keyword cg node) Kw.ty_result))
                    (call desc (call nth_child node (+ 1 side)) false)
                    (ptr.null Desc))))
    (when (eq (call node_kind node) compiler.Kind.symbol)
          (let idx:i32 (call find_local cg (call node_a node) (call node_b node)))
          (return (if (eq idx -1) (ptr.null Desc) (call result_side cg (get (call local_at cg idx) Local.from) side))))
    (when (neq (call node_kind node) compiler.Kind.paren) (return (ptr.null Desc)))
    (let kw:Kw (call group_head_keyword cg node))
    (let typed:bool (eq (call node_kind (call nth_child node 1)) compiler.Kind.colon))
    (cond
      ;; (ok v) / (ok:E v), (err e) / (err:T e): the payload on its own side
      ((or (eq kw Kw.ok) (eq kw Kw.err))
       (if (eq side (if (eq kw Kw.ok) 0 1))
           (call desc (call result_payload node) true)
           (if typed (call desc (call nth_child node 2) false) (ptr.null Desc))))
      ((eq kw Kw.call)
       (let fname:(ptr compiler.Node) (call nth_child node 1))
       (let fidx:i32 (call find_function cg (call node_a fname) (call node_b fname)))
       (if (eq fidx -1)
           (ptr.null Desc)
           (call result_side cg (call desc (call nth_child (get (call func_entry_ptr cg fidx) FnInfo.node) 4) false) side)))
      ((eq kw Kw.call_ref) (call result_side cg (call desc (call nth_child (call nth_child node 1) 3) false) side))
      ((eq kw Kw.if) (call result_side cg (call desc (call if_typed cg node) true) side))
      ((eq kw Kw.block) (call result_side cg (call desc (call last_of (call node_next (call first_child node))) true) side))
      ((eq kw Kw.cond)
       (call result_side cg (call desc (call last_of (call cond_typed cg node)) true) side))
      ((eq kw Kw.match) (call result_side cg (call desc (call last_of (call match_typed cg node)) true) side))
      ((eq kw Kw.match_result)
       (call result_side cg (call desc (call last_of (call mr_typed cg node)) true) side))
      (else (ptr.null Desc))))

  ;; Types each match_result binder as its payload (wasm.rs binder_types),
  ;; once every local is known: the matched expression's type, in source
  ;; order, the first match_result of a name deciding.
  (fn binder_types [cg:(ptr Cg) node:(ptr compiler.Node)] -> void
    (when (neq (call node_kind node) compiler.Kind.paren) (return))
    (when (eq (call group_head_keyword cg node) Kw.match_result)
          (let scrutinee:(ptr Desc) (call desc (call nth_child node 1) true))
          (for side 0 2
            (let var:(ptr compiler.Node) (call nth_child (call nth_child node (+ 2 side)) 1))
            (let l:(ptr Local) (call local_at cg (call find_local cg (call node_a var) (call node_b var))))
            (when (not (get l Local.bound))
                  (let from:(ptr Desc) (call result_side cg scrutinee side))
                  (put l Local.bound true)
                  (put l Local.from from)
                  (put l Local.ty (call desc_ty cg from))
                  (put l Local.vs (call desc_struct cg from)))))
    (let child:(ptr compiler.Node) (call first_child node))
    (while (neq child (ptr.null compiler.Node))
      (call binder_types cg child)
      (set! child (call node_next child))))

  ;; Any body item may be an atom (a bare number, name, or string), which
  ;; has no head: check the kind first.
  (fn is_contract_head [cg:(ptr Cg) group:(ptr compiler.Node)] -> bool
    (when (neq (call node_kind group) compiler.Kind.paren) (return false))
    (let head:(ptr compiler.Node) (call first_child group))
    (if (neq (call node_kind head) compiler.Kind.symbol)
        false
        (block
          (let kw:Kw (call classify_keyword cg (call node_a head) (call node_b head)))
          (or (eq kw Kw.req) (or (eq kw Kw.ens) (eq kw Kw.inv))))))

  ;; Collects the function's locals into cg (parameters first, then every
  ;; let, loop variable and its hidden end and step, and match_result
  ;; variable, in a pre-order walk); returns the count.
  (fn collect_locals_for_function [cg:(ptr Cg) entry:(ptr FnInfo)] -> i32
    (put cg Cg.nlocals 0)
    (let fndef_group:(ptr compiler.Node) (get entry FnInfo.node))
    (let pchild:(ptr compiler.Node) (call first_child (call nth_child fndef_group 2)))
    (while (neq pchild (ptr.null compiler.Node))
      (let type_node:(ptr compiler.Node) (call node_next (call node_next pchild)))
      (call add_local_if_new cg (call node_a pchild) (call node_b pchild) (call type_node_id cg type_node) (call type_node_struct cg type_node))
      (call note_type_node cg pchild type_node)
      (set! pchild (call node_next type_node)))
    (let bchild:(ptr compiler.Node) (call nth_child fndef_group 5))
    (while (neq bchild (ptr.null compiler.Node))
      (if (call is_contract_head cg bchild) 0 (call collect_locals_walk cg bchild))
      (set! bchild (call node_next bchild)))
    ;; a contract's lets too, after the body's, in source order (wasm.rs
    ;; walk_expr): a contract is an expression, and a block in it may bind
    (set! bchild (call nth_child fndef_group 5))
    (while (neq bchild (ptr.null compiler.Node))
      (if (neq (call contract_kind cg bchild) Kw.none) (call collect_contract_lets cg bchild) 0)
      (set! bchild (call node_next bchild)))
    (set! bchild (call nth_child fndef_group 5))
    (while (neq bchild (ptr.null compiler.Node))
      (when (not (call is_contract_head cg bchild)) (call binder_types cg bchild))
      (set! bchild (call node_next bchild)))
    ;; a function with ens keeps its result in res (wasm.rs), unless a let named it
    (if (and (call has_ens cg fndef_group) (neq (get entry FnInfo.ret) Ty.void))
        (call add_local_if_new cg (- (str.ptr "res") (get cg Cg.src)) 3 (get entry FnInfo.ret) (get entry FnInfo.ret_vs))
        0)
    (get cg Cg.nlocals))

  ;; The lets in node, a contract, in source order (wasm.rs walk_expr): only
  ;; its lets, since its binders (a match_result on res) are typed by what
  ;; they match, not known here, and need no local unless used.
  (fn collect_contract_lets [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (if (neq (call node_kind node) compiler.Kind.paren)
        0
        (block
          (when (eq (call group_head_keyword cg node) Kw.let)
                (let name_node:(ptr compiler.Node) (call nth_child node 1))
                (let type_node:(ptr compiler.Node) (call nth_child node 3))
                (call add_local_if_new cg (call node_a name_node) (call node_b name_node) (call type_node_id cg type_node) (call type_node_struct cg type_node))
                (call note_type_node cg name_node type_node))
          (let c:(ptr compiler.Node) (call first_child node))
          (while (neq c (ptr.null compiler.Node))
            (call collect_contract_lets cg c)
            (set! c (call node_next c)))
          0)))

  ;; The contract kind of a body item: Kw.req, Kw.ens, Kw.inv, or Kw.none.
  (fn contract_kind [cg:(ptr Cg) item:(ptr compiler.Node)] -> Kw
    (when (not (call is_contract_head cg item)) (return Kw.none))
    (let kw:Kw (call group_head_keyword cg item))
    (if (or (eq kw Kw.req) (or (eq kw Kw.ens) (eq kw Kw.inv))) kw Kw.none))

  ;; Whether the function checks something on return: an ens, or an inv
  ;; (checked on entry and on return).
  (fn has_ens [cg:(ptr Cg) fndef_group:(ptr compiler.Node)] -> bool
    (let item:(ptr compiler.Node) (call nth_child fndef_group 5))
    (while (neq item (ptr.null compiler.Node))
      (when (or (eq (call contract_kind cg item) Kw.ens) (eq (call contract_kind cg item) Kw.inv)) (return true))
      (set! item (call node_next item)))
    false)

  ;; ===== WebAssembly encoding =====
  ;; Opcodes (the 0xFC and 0xFE prefixes take a second, LEB128 opcode),
  ;; block types, and value types, as the binary format spells them.
  ;; The memory maximum, in 64 KiB pages: 2 GiB, where every address is
  ;; still a non-negative i32 (vm.rs MAX_PAGES).
  (const MAX_PAGES:i32 32768)
  ;; The most functions a module may have (compile error 92 past it).
  ;; xs, or a copy of it twice as long when index n does not fit: the
  ;; compiler's tables grow as wasm.rs's vectors do.
  (fn (room T) [xs:(arr T) n:i32] -> (arr T)
    (when (lt n (arr.len xs)) (return xs))
    (let bigger:(arr T) (arr.new T (call alloc.forever) (* 2 (+ n 1))))
    (for i 0 (arr.len xs) (arr.set T bigger i (arr.get T xs i)))
    bigger)
  (const OP_UNREACHABLE:i32 0)
  (const OP_BLOCK:i32 2)
  (const OP_LOOP:i32 3)
  (const OP_IF:i32 4)
  (const OP_ELSE:i32 5)
  (const OP_END:i32 11)
  (const OP_BR:i32 12)
  (const OP_BR_IF:i32 13)
  (const OP_RETURN:i32 15)
  (const OP_CALL:i32 16)
  (const OP_DROP:i32 26)
  (const OP_LOCAL_GET:i32 32)
  (const OP_LOCAL_SET:i32 33)
  (const OP_LOCAL_TEE:i32 34)
  (const OP_GLOBAL_GET:i32 35)
  (const OP_GLOBAL_SET:i32 36)
  (const OP_I32_LOAD:i32 40)
  (const OP_I64_LOAD:i32 41)
  (const OP_F32_LOAD:i32 42)
  (const OP_F64_LOAD:i32 43)
  (const OP_I32_LOAD8_U:i32 45)
  (const OP_I32_STORE:i32 54)
  (const OP_I64_STORE:i32 55)
  (const OP_F32_STORE:i32 56)
  (const OP_F64_STORE:i32 57)
  (const OP_I32_STORE8:i32 58)
  (const OP_MEMORY_SIZE:i32 63)
  (const OP_MEMORY_GROW:i32 64)
  (const OP_I32_CONST:i32 65)
  (const OP_I64_CONST:i32 66)
  (const OP_I64_OR:i32 132)
  (const OP_I64_SHL:i32 134)
  (const OP_I64_SHR_U:i32 136)
  (const OP_F64_CONST:i32 68)
  (const OP_F32_CONST:i32 67)
  (const OP_I32_EQZ:i32 69)
  (const OP_I32_EQ:i32 70)
  (const OP_I32_NE:i32 71)
  (const OP_I32_LT_S:i32 72)
  (const OP_I32_LT_U:i32 73)
  (const OP_I32_GT_S:i32 74)
  (const OP_I32_GT_U:i32 75)
  (const OP_I32_GE_U:i32 79)
  (const OP_I32_DIV_U:i32 110)
  (const OP_I32_REM_U:i32 112)
  (const OP_I64_LT_U:i32 84)
  (const OP_I64_DIV_U:i32 128)
  (const OP_I64_REM_U:i32 130)
  (const OP_I32_ADD:i32 106)
  (const OP_I32_SUB:i32 107)
  (const OP_I32_MUL:i32 108)
  (const OP_I32_AND:i32 113)
  (const OP_I32_OR:i32 114)
  (const OP_I32_SHL:i32 116)
  (const OP_I32_DIV_S:i32 109)
  (const OP_I32_SHR_U:i32 118)
  (const OP_I64_NE:i32 82)
  (const OP_I64_LT_S:i32 83)
  (const OP_I64_GE_U:i32 90)
  (const OP_I64_ADD:i32 124)
  (const OP_I64_SUB:i32 125)
  (const OP_I64_MUL:i32 126)
  (const OP_I64_DIV_S:i32 127)
  (const OP_I64_AND:i32 131)
  (const OP_I64_XOR:i32 133)
  (const OP_I64_REINTERPRET_F64:i32 189)
  (const OP_F64_REINTERPRET_I64:i32 191)
  (const OP_PREFIX_MISC:i32 252)
  (const OP_I32_WRAP_I64:i32 167)
  (const OP_F64_SQRT:i32 159)
  (const OP_I64_EXTEND_I32_S:i32 172)
  (const OP_I64_EXTEND_I32_U:i32 173)
  (const OP_I64_TRUNC_F64_S:i32 176)
  (const OP_F64_CONVERT_I64_S:i32 185)
  (const OP_CALL_INDIRECT:i32 17)
  (const MISC_MEMORY_INIT:i32 8)
  (const OP_PREFIX_ATOMIC:i32 254)
  (const ATOMIC_NOTIFY:i32 0)
  (const ATOMIC_WAIT32:i32 1)
  (const ATOMIC_LOAD:i32 16)
  (const ATOMIC_STORE:i32 23)
  (const ATOMIC_RMW_ADD:i32 30)
  (const ATOMIC_RMW_XCHG:i32 65)
  (const ATOMIC_RMW_CMPXCHG:i32 72)
  (const BLOCK_EMPTY:i32 64)
  (const VT_I32:i32 127)
  (const VT_I64:i32 126)
  (const VT_F32:i32 125)
  (const VT_F64:i32 124)
  (const FUNC_TYPE:i32 96)

  ;; ===== Output =====
  ;; A cursor writing bytes forward from base. Emitters append at pos.
  ;; lines: a function body's line table as it is written (null elsewhere).
  (struct Out [base:i32 pos:i32 lines:(ptr Lines)])

  (fn out_at [addr:i32] -> (ptr Out)
    (let o:(ptr Out) (new Out (call alloc.forever) [base:addr pos:0 lines:(ptr.null Lines)]))
    o)

  ;; ===== Line table (docs/design/LINES_PLAN.md; wasm.rs Body) =====

  ;; From offset `at` in a function's body, its code is at file:line:col.
  (struct LEntry [at:i32 file:str.Bytes line:i32 col:i32])

  ;; A body's line table as it is written: the offsets in the source of the
  ;; expressions being compiled (innermost last), and the entries so far.
  (struct Lines [places:(ptr places.Places) at:(ptr (vec.Vec i32)) entries:(ptr (vec.Vec (ptr LEntry)))])

  ;; A function's entries, for the section.
  (struct FnLines [index:i32 entries:(ptr (vec.Vec (ptr LEntry)))])

  (fn new_lines [p:(ptr places.Places)] -> (ptr Lines)
    (let ls:(ptr Lines) (new Lines (call alloc.forever) [places:p
                                                         at:(call (vec.make i32) (call alloc.default) 32)
                                                         entries:(call (vec.make (ptr LEntry)) (call alloc.default) 32)]))
    ls)

  ;; Whether a frame can point at the opcode: a call, one that can trap, or
  ;; an `if` (wasmtime reports `if c unreachable end`, a check's trap, at the
  ;; `if`).
  (fn traps_or_calls [code:i32] -> bool
    (or (eq code 0) (or (eq code 4) (or (eq code 16) (or (eq code 17)
      (or (and (gte code 40) (lte code 62)) (or (and (gte code 109) (lte code 112))
      (or (and (gte code 127) (lte code 130)) (or (and (gte code 168) (lte code 177))
      (or (eq code 252) (eq code 254)))))))))))

  ;; An opcode; first, in a body, the position of the expression it belongs
  ;; to if a frame can point at it and the last entry has another.
  (fn put_op [o:(ptr Out) code:i32] -> void
    (let ls:(ptr Lines) (get o Out.lines))
    (when (and (neq ls (ptr.null Lines)) (call traps_or_calls code)) (call mark ls (get o Out.pos)))
    (call put_byte o code))

  ;; Whether fi is a printer formatting generates: its name starts with
  ;; show.debug. (formats.rs debug_functions).
  (fn is_debug_fn [cg:(ptr Cg) fi:(ptr FnInfo)] -> bool
    (unsafe (call str.starts_with (call str.bytes (+ (get cg Cg.src) (get fi FnInfo.name_pos)) (get fi FnInfo.name_len)) (call str.from_str "show.debug."))))

  (fn mark [ls:(ptr Lines) at:i32] -> void
    (let stack:(ptr (vec.Vec i32)) (get ls Lines.at))
    (let n:i32 (call (vec.len i32) stack))
    (when (eq n 0) (return))
    (let p:(ptr places.Place) (call places.place (get ls Lines.places) (call (vec.at i32) stack (- n 1))))
    (let es:(ptr (vec.Vec (ptr LEntry))) (get ls Lines.entries))
    (let m:i32 (call (vec.len (ptr LEntry)) es))
    (when (gt m 0)
          (let last:(ptr LEntry) (call (vec.at (ptr LEntry)) es (- m 1)))
          (when (and (eq (get last LEntry.line) (get p places.Place.line))
                   (and (eq (get last LEntry.col) (get p places.Place.col))
                        (call str.bytes_eq (get last LEntry.file) (get p places.Place.file))))
              (return)))
    (let e:(ptr LEntry) (new LEntry (call alloc.forever) [at:at
                                                          file:(get p places.Place.file)
                                                          line:(get p places.Place.line)
                                                          col:(get p places.Place.col)]))
    (call (vec.push (ptr LEntry)) es e))

  ;; The expression at source offset `at` is being compiled / is done.
  (fn at_push [o:(ptr Out) at:i32] -> void
    (when (neq (get o Out.lines) (ptr.null Lines)) (call (vec.push i32) (get (get o Out.lines) Lines.at) at)))
  (fn at_pop [o:(ptr Out)] -> void
    (when (neq (get o Out.lines) (ptr.null Lines)) (let _at:i32 (call (vec.pop i32) (get (get o Out.lines) Lines.at)))))

  ;; The aipl.lines section's contents (wasm.rs encode_lines): file names in
  ;; first-use order, then each function's entries, offsets and lines as
  ;; deltas.
  (fn emit_lines [sec:(ptr Out) fns:(ptr (vec.Vec (ptr FnLines)))] -> void
    (let files:(ptr (vec.Vec str.Bytes)) (call (vec.make str.Bytes) (call alloc.default) 8))
    (for f 0 (call (vec.len (ptr FnLines)) fns)
      (let es:(ptr (vec.Vec (ptr LEntry))) (get (call (vec.at (ptr FnLines)) fns f) FnLines.entries))
      (for k 0 (call (vec.len (ptr LEntry)) es)
        (let name:str.Bytes (get (call (vec.at (ptr LEntry)) es k) LEntry.file))
        (when (lt (call file_index files name) 0) (call (vec.push str.Bytes) files name))))
    (call put_u32 sec (call (vec.len str.Bytes) files))
    (for i 0 (call (vec.len str.Bytes) files)
      (let name:str.Bytes (call (vec.at str.Bytes) files i))
      (call put_u32 sec (get name str.Bytes.len))
      (for k 0 (get name str.Bytes.len) (call put_byte sec (call str.byte_at name k))))
    (call put_u32 sec (call (vec.len (ptr FnLines)) fns))
    (for f 0 (call (vec.len (ptr FnLines)) fns)
      (let fl:(ptr FnLines) (call (vec.at (ptr FnLines)) fns f))
      (let es:(ptr (vec.Vec (ptr LEntry))) (get fl FnLines.entries))
      (call put_u32 sec (get fl FnLines.index))
      (call put_u32 sec (call (vec.len (ptr LEntry)) es))
      (let off:i32 0)
      (let line:i32 0)
      (for k 0 (call (vec.len (ptr LEntry)) es)
        (let e:(ptr LEntry) (call (vec.at (ptr LEntry)) es k))
        (call put_u32 sec (- (get e LEntry.at) off))
        (call put_u32 sec (call file_index files (get e LEntry.file)))
        (call put_s32 sec (- (get e LEntry.line) line))
        (call put_u32 sec (get e LEntry.col))
        (set! off (get e LEntry.at))
        (set! line (get e LEntry.line)))))

  (fn file_index [files:(ptr (vec.Vec str.Bytes)) name:str.Bytes] -> i32
    (for i 0 (call (vec.len str.Bytes) files)
      (when (call str.bytes_eq (call (vec.at str.Bytes) files i) name) (return i)))
    -1)

  ;; The address of the next byte, for code that still writes at an address
  ;; and returns a count (advance by it).
  (fn cursor [o:(ptr Out)] -> i32 (+ (get o Out.base) (get o Out.pos)))
  (fn advance [o:(ptr Out) n:i32] -> void (put o Out.pos (+ (get o Out.pos) n)))

  (fn put_byte [o:(ptr Out) b:i32] -> void
    (unsafe (mem.store8 (call cursor o) b)
    (put o Out.pos (+ (get o Out.pos) 1))))

  ;; LEB128 immediates.
  (fn put_u32 [o:(ptr Out) v:i32] -> void (call advance o (call compiler.encode_u32 (call cursor o) v)))
  (fn put_s32 [o:(ptr Out) v:i32] -> void (call advance o (call encode_s32 (call cursor o) v)))
  (fn put_s64 [o:(ptr Out) v:i64] -> void (call advance o (call encode_s64 (call cursor o) v)))

  ;; ===== Low-level WASM instruction emitters =====
  (fn encode_s32 [ptr:i32 val:i32] -> i32
    (unsafe (let bytes_written:i32 0)
    (let value:i32 val)
    (let more:bool true)
    (while more
      (let byte_val:i32 (bitand value 127))
      (set! value (shr value 7))
      (let sign_bit:i32 (bitand byte_val 64))
      (let done_now:bool false)
      (if (and (eq value 0) (eq sign_bit 0))
          (set! done_now true)
          (if (and (eq value -1) (neq sign_bit 0))
              (set! done_now true)
              (set! done_now false)))
      (let byte_out:i32 byte_val)
      (if done_now (set! byte_out byte_val) (set! byte_out (bitor byte_val 128)))
      (mem.store8 (+ ptr bytes_written) byte_out)
      (set! bytes_written (+ bytes_written 1))
      (if done_now (set! more false) (set! more true)))
    bytes_written))

;; Value of an `i64` literal token such as `-7i64`. Digits accumulate
  ;; negatively so that -9223372036854775808i64 does not overflow.
  (fn parse_i64_literal [cg:(ptr Cg) pos:i32 len:i32] -> i64
    (unsafe (let c0:i32 (mem.load8 (+ (get cg Cg.src) pos)))
    (let neg:bool (eq c0 45))
    (let i:i32 (if (or neg (eq c0 43)) 1 0))
    (let v:i64 0i64)
    (while (lt i (- len 3))
      (set! v (- (* v 10i64) (i64.extend_s (- (mem.load8 (+ (get cg Cg.src) (+ pos i))) 48))))
      (set! i (+ i 1)))
    (if neg v (- 0i64 v))))

  ;; Signed LEB128 of a 64-bit value (the i64.const immediate).
  (fn encode_s64 [ptr:i32 val:i64] -> i32
    (unsafe (let v:i64 val)
    (let n:i32 0)
    (let more:bool true)
    (while more
      (let b:i32 (i32.wrap (bitand v 127i64)))
      (set! v (shr v 7i64))
      (if (or (and (eq v 0i64) (eq (bitand b 64) 0)) (and (eq v -1i64) (neq (bitand b 64) 0)))
          (set! more false)
          (set! b (bitor b 128)))
      (mem.store8 (+ ptr n) b)
      (set! n (+ n 1)))
    n))

  ;; f64.const for a decimal literal such as -2.5 or 1.5e3: the nearest
  ;; double, as Rust's parse::<f64> gives it (std/float).
  (fn emit_f64_literal [o:(ptr Out) cg:(ptr Cg) pos:i32 len:i32] -> void
    (unsafe (let v:f64 (call float.from_decimal (+ (get cg Cg.src) pos) len))
    (let bits:i64 (i64.reinterpret_f64 v))
    (call put_op o OP_F64_CONST)
    (for b 0 8
      (call put_byte o (i32.wrap (bitand (shru bits (i64.extend_u (* b 8))) 255i64))))))

  ;; `1.5f32`: the nearest f64, then the nearest f32 (wasm.rs: `f as f32`).
  (fn emit_f32_literal [o:(ptr Out) cg:(ptr Cg) pos:i32 len:i32] -> void
    (unsafe (let v:f64 (call float.from_decimal (+ (get cg Cg.src) pos) (- len 3)))
    (let bits:i32 (call f32_bits (i64.reinterpret_f64 v)))
    (call put_op o OP_F32_CONST)
    (for b 0 4
      (call put_byte o (bitand (shru bits (* b 8)) 255)))))

  ;; The f32 nearest a double (its bits d), ties to even, as IEEE 754 (and
  ;; f32.demote_f64) round, in integer arithmetic: the compiler is built by
  ;; compilers that have no f32 ops. A double too large is infinity, too
  ;; small zero (or a subnormal f32), with the sign kept; a NaN stays one.
  (fn f32_bits [d:i64] -> i32
    (let sign:i64 (shl (shru d 63i64) 31i64))
    (let e:i64 (bitand (shru d 52i64) 2047i64))
    (let frac:i64 (bitand d 4503599627370495i64))
    (cond
      ((eq e 2047i64)
       (i32.wrap (bitor sign (bitor 2139095040i64 (if (eq frac 0i64) 0i64 (bitor 4194304i64 (shru frac 29i64)))))))
      ((eq e 0i64) (i32.wrap sign))
      (else
       ;; the value is m * 2^(e-1075), m 53 bits; the f32 exponent is fe
       (let m:i64 (bitor frac 4503599627370496i64))
       (let fe:i64 (- e 896i64))
       ;; keep 24 bits (normal), or fewer down to 2^-149 (subnormal)
       (let drop:i64 (if (gte fe 1i64) 29i64 (- 30i64 fe)))
       (when (gt drop 54i64) (return (i32.wrap sign)))
       (let q:i64 (shru m drop))
       (let rest:i64 (bitand m (- (shl 1i64 drop) 1i64)))
       (let half:i64 (shl 1i64 (- drop 1i64)))
       (when (or (gt rest half) (and (eq rest half) (eq (bitand q 1i64) 1i64))) (set! q (+ q 1i64)))
       ;; a normal one: the exponent, plus the significand without its
       ;; leading bit (a carry out of it raises the exponent)
       (let mag:i64 (if (gte fe 1i64) (+ (shl fe 23i64) (- q 8388608i64)) q))
       (i32.wrap (bitor sign (if (gte mag 2139095040i64) 2139095040i64 mag))))))




  ;; After the heap cursor is bumped: grow memory to cover it if needed, with
  ;; no locals and no net stack effect (wasm.rs emit_grow_to_cursor).
;; A 0xFE-prefixed atomic instruction with align 2, offset 0.
  (fn emit_atomic [o:(ptr Out) op:i32] -> void
    (call put_op o OP_PREFIX_ATOMIC)
    (call put_u32 o op)
    (call put_byte o 2)
    (call put_byte o 0))




  ;; With a condition on the stack: if it holds, unreachable.
  (fn emit_trap_if [o:(ptr Out)] -> void
    (call put_op o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call put_op o OP_UNREACHABLE)
    (call put_op o OP_END))




  ;; Rounds the i32 on the stack up to a multiple of 8 (wasm.rs emit_round8):
  ;; every allocation size is, so every block is 8-aligned.
  (fn emit_round8 [o:(ptr Out)] -> void
    (call emit_i32_const o 7)
    (call put_op o OP_I32_ADD)
    (call emit_i32_const o -8)
    (call put_op o OP_I32_AND))



  ;; The directory fd for the path in locals (ptr, len), as wasm.rs
  ;; emit_path_dir: "/..." resolves in fd 4 (the host's "/") with the slash
  ;; dropped, anything else in fd 3 (the working directory).
  (fn emit_path_dir [o:(ptr Out) ptr_l:i32 len_l:i32] -> void
    (call emit_local_get o ptr_l)
    (call emit_memop o OP_I32_LOAD8_U 0) ;; i32.load8_u
    (call emit_i32_const o 47)
    (call put_op o OP_I32_EQ)
    (call put_op o OP_IF)
    (call put_byte o VT_I32)
    (call emit_local_get o ptr_l)
    (call emit_i32_const o 1)
    (call put_op o OP_I32_ADD)
    (call emit_local_set o ptr_l)
    (call emit_local_get o len_l)
    (call emit_i32_const o 1)
    (call put_op o OP_I32_SUB)
    (call emit_local_set o len_l)
    (call emit_i32_const o 4)
    (call put_op o OP_ELSE)
    (call emit_i32_const o 3)
    (call put_op o OP_END))




    ;; i32.atomic.rmw.add with align 2, offset 0: [addr] [n] -> [old]. Every
  ;; allocation claims its block with one of these on the cursor at address 0.
  (fn emit_rmw_add [o:(ptr Out)] -> void
    (call put_op o OP_PREFIX_ATOMIC)
    (call put_byte o ATOMIC_RMW_ADD)
    (call put_byte o 2)
    (call put_byte o 0))




  (fn emit_grow_to_cursor [o:(ptr Out)] -> void
    (call emit_i32_const o 0)
    (call emit_memop o OP_I32_LOAD 2)
    (call emit_size_bytes o)
    (call put_op o OP_I32_GT_U)
    (call put_op o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call emit_i32_const o 0)
    (call emit_memop o OP_I32_LOAD 2)
    (call emit_size_bytes o)
    (call put_op o OP_I32_SUB)
    (call emit_i32_const o 65535)
    (call put_op o OP_I32_ADD)
    (call emit_i32_const o 16)
    (call put_op o OP_I32_SHR_U)
    (call put_op o OP_MEMORY_GROW)
    (call put_byte o 0)
    (call put_op o OP_DROP)
    (call put_op o OP_END))



  ;; emit_grow_to_cursor for mem.alloc, which calls $aipl_oom (index oom)
  ;; when memory cannot grow to hold the block (wasm.rs emit_grow_or_stop).
  (fn emit_grow_or_stop [o:(ptr Out) oom:i32] -> void
    (call emit_i32_const o 0)
    (call emit_memop o OP_I32_LOAD 2)
    (call emit_size_bytes o)
    (call put_op o OP_I32_GT_U)
    (call put_op o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call emit_i32_const o 0)
    (call emit_memop o OP_I32_LOAD 2)
    (call emit_size_bytes o)
    (call put_op o OP_I32_SUB)
    (call emit_i32_const o 65535)
    (call put_op o OP_I32_ADD)
    (call emit_i32_const o 16)
    (call put_op o OP_I32_SHR_U)
    (call put_op o OP_MEMORY_GROW)
    (call put_byte o 0)
    (call emit_i32_const o -1)
    (call put_op o OP_I32_EQ)
    (call put_op o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call put_op o OP_CALL)
    (call put_u32 o oom)
    (call put_op o OP_UNREACHABLE)
    (call put_op o OP_END)
    (call put_op o OP_END))

  ;; memory.size; i32.const 16; i32.shl -> memory size in bytes
  (fn emit_size_bytes [o:(ptr Out)] -> void
    (call put_op o OP_MEMORY_SIZE)
    (call put_byte o 0)
    (call emit_i32_const o 16)
    (call put_op o OP_I32_SHL))




  (fn emit_i32_const [o:(ptr Out) val:i32] -> void
    (call put_op o OP_I32_CONST)
    (call put_s32 o val))




  (fn emit_local_get [o:(ptr Out) idx:i32] -> void
    (call put_op o OP_LOCAL_GET)
    (call put_u32 o idx))




  (fn emit_local_set [o:(ptr Out) idx:i32] -> void
    (call put_op o OP_LOCAL_SET)
    (call put_u32 o idx))




  (fn emit_local_tee [o:(ptr Out) idx:i32] -> void
    (call put_op o OP_LOCAL_TEE)
    (call put_u32 o idx))

  (fn emit_call [o:(ptr Out) idx:i32] -> void
    (call put_op o OP_CALL)
    (call put_u32 o idx))




  (fn emit_memop [o:(ptr Out) opcode:i32 align:i32] -> void
    (call put_op o opcode)
    (call put_byte o align)
    (call put_byte o 0))




  (fn emit_store_guard [cg:(ptr Cg) o:(ptr Out) scratch_idx:i32] -> void
    (call put_op o OP_LOCAL_TEE)
    (call put_u32 o scratch_idx)
    (call emit_local_get o scratch_idx)
    (call emit_i32_const o 4)
    (call put_op o OP_I32_LT_U)
    ;; two checks, each its own if (wasm.rs emit_write_address_check)
    (call put_op o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call put_op o OP_UNREACHABLE)
    (call put_op o OP_END)
    (call emit_local_get o scratch_idx)
    (call emit_i32_const o 64)
    (call put_op o OP_I32_SUB)
    (call emit_i32_const o (- (call heap_start cg) 64))
    (call put_op o OP_I32_LT_U)
    (call put_op o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call put_op o OP_UNREACHABLE)
    (call put_op o OP_END))

  ;; The bounds check of arr.get/arr.set (wasm.rs emit_bounds_check): with
  ;; [array index] on the stack, fails through $aipl_oob unless index <
  ;; length, unsigned; leaves [array index]. The array goes in the store
  ;; guard's scratch local, the index in the one after it. The `unreachable`
  ;; after the call (which never returns) tells wasmtime nothing is live
  ;; past it.
  ;; With a pointer or array (an i64) on the stack: if it is null, $aipl_null's
  ;; message and a trap; if its generation is not the word 8 bytes before
  ;; the object, $aipl_uaf's, unless it is unchecked (ptr.cast). Leaves the
  ;; i32 address (wasm.rs emit_null_check).
  (fn emit_null_check [cg:(ptr Cg) o:(ptr Out)] -> void
    (let a:i32 (get cg Cg.scratch))
    (let fat:i32 (+ a 2))
    (call emit_local_tee o fat)
    (call put_op o OP_I32_WRAP_I64)
    (call emit_local_tee o a)
    (call put_op o OP_I32_EQZ)
    (call put_op o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call emit_call o (+ (get cg Cg.checks_base) 5))
    (call put_op o OP_UNREACHABLE)
    (call put_op o OP_END)
    (call emit_local_get o a)
    (call emit_i32_const o 8)
    (call put_op o OP_I32_SUB)
    (call emit_memop o OP_I32_LOAD 2)
    (call emit_pointer_gen o fat)
    (call put_op o OP_I32_NE)
    (call put_op o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call emit_pointer_gen o fat)
    (call emit_i32_const o -1)
    (call put_op o OP_I32_NE)
    (call put_op o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call emit_call o (+ (get cg Cg.checks_base) 6))
    (call put_op o OP_UNREACHABLE)
    (call put_op o OP_END)
    (call put_op o OP_END)
    (call emit_local_get o a))

  ;; The generation of the pointer in local fat: its high half.
  (fn emit_pointer_gen [o:(ptr Out) fat:i32] -> void
    (call emit_local_get o fat)
    (call put_op o OP_I64_CONST) (call put_s64 o 32i64)
    (call put_op o OP_I64_SHR_U)
    (call put_op o OP_I32_WRAP_I64))

  (fn emit_bounds_check [cg:(ptr Cg) o:(ptr Out)] -> void
    (let a:i32 (get cg Cg.scratch))
    (let i:i32 (+ a 1))
    (call emit_local_set o i)
    (call emit_local_tee o a)
    (call emit_local_get o i)
    (call emit_local_get o a)
    (call emit_i32_const o 4)
    (call put_op o OP_I32_SUB)
    (call emit_memop o OP_I32_LOAD 2)
    (call put_op o OP_I32_GE_U)
    (call put_op o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call emit_local_get o i)
    (call emit_local_get o a)
    (call emit_call o (+ (get cg Cg.checks_base) 1))
    (call put_op o OP_UNREACHABLE)
    (call put_op o OP_END)
    (call emit_local_get o i))



  ;; Opcode for a binary arithmetic/comparison op on operands of type t, as
  ;; arith_instruction / compare_instruction in wasm.rs; -1 if unsupported.
  (fn binop_opcode [op_id:Kw t:Ty] -> i32
    (cond
      ((eq t Ty.i32) (cond
                    ((eq op_id Kw.add) 106)
                    ((eq op_id Kw.sub) 107)
                    ((eq op_id Kw.mul) 108)
                    ((eq op_id Kw.div) 109)
                    ((eq op_id Kw.xor) 115)
                    ((eq op_id Kw.shl) 116)
                    ((eq op_id Kw.shr) 117)
                    ((eq op_id Kw.bitand) 113)
                    ((eq op_id Kw.bitor) 114)
                    ((eq op_id Kw.eq) 70)
                    ((eq op_id Kw.neq) 71)
                    ((eq op_id Kw.lt) 72)
                    ((eq op_id Kw.lte) 76)
                    ((eq op_id Kw.gt) 74)
                    ((eq op_id Kw.gte) 78)
                    ((eq op_id Kw.rem) 111)
                    ((eq op_id Kw.divu) 110)
                    ((eq op_id Kw.remu) 112)
                    ((eq op_id Kw.shru) 118)
                    ((eq op_id Kw.ltu) 73)
                    ((eq op_id Kw.lteu) 77)
                    ((eq op_id Kw.gtu) 75)
                    ((eq op_id Kw.gteu) 79)
                    (else -1)))
      ((eq t Ty.i64) (cond
                    ((eq op_id Kw.add) 124)
                    ((eq op_id Kw.sub) 125)
                    ((eq op_id Kw.mul) 126)
                    ((eq op_id Kw.div) 127)
                    ((eq op_id Kw.xor) 133)
                    ((eq op_id Kw.shl) 134)
                    ((eq op_id Kw.shr) 135)
                    ((eq op_id Kw.bitand) 131)
                    ((eq op_id Kw.bitor) 132)
                    ((eq op_id Kw.eq) 81)
                    ((eq op_id Kw.neq) 82)
                    ((eq op_id Kw.lt) 83)
                    ((eq op_id Kw.lte) 87)
                    ((eq op_id Kw.gt) 85)
                    ((eq op_id Kw.gte) 89)
                    ((eq op_id Kw.rem) 129)
                    ((eq op_id Kw.divu) 128)
                    ((eq op_id Kw.remu) 130)
                    ((eq op_id Kw.shru) 136)
                    ((eq op_id Kw.ltu) 84)
                    ((eq op_id Kw.lteu) 88)
                    ((eq op_id Kw.gtu) 86)
                    ((eq op_id Kw.gteu) 90)
                    (else -1)))
      ((eq t Ty.f32) (cond
                    ((eq op_id Kw.add) 146)
                    ((eq op_id Kw.sub) 147)
                    ((eq op_id Kw.mul) 148)
                    ((eq op_id Kw.div) 149)
                    ((eq op_id Kw.eq) 91)
                    ((eq op_id Kw.neq) 92)
                    ((eq op_id Kw.lt) 93)
                    ((eq op_id Kw.lte) 95)
                    ((eq op_id Kw.gt) 94)
                    ((eq op_id Kw.gte) 96)
                    (else -1)))
      ((eq t Ty.f64) (cond
                    ((eq op_id Kw.add) 160)
                    ((eq op_id Kw.sub) 161)
                    ((eq op_id Kw.mul) 162)
                    ((eq op_id Kw.div) 163)
                    ((eq op_id Kw.eq) 97)
                    ((eq op_id Kw.neq) 98)
                    ((eq op_id Kw.lt) 99)
                    ((eq op_id Kw.lte) 101)
                    ((eq op_id Kw.gt) 100)
                    ((eq op_id Kw.gte) 102)
                    (else -1)))
      ((or (eq t Ty.bool) (or (eq t Ty.str) (eq t Ty.fn))) (if (eq op_id Kw.eq) 70 (if (eq op_id Kw.neq) 71 -1)))
      ;; pointers and arrays: address and generation (a cast of 0 is null)
      ((or (eq t Ty.ptr) (eq t Ty.arr)) (if (eq op_id Kw.eq) 81 (if (eq op_id Kw.neq) 82 -1)))
      (else -1)))

  ;; and / or are i32.and / i32.or whatever the operands; others go through
  ;; binop_opcode with the first operand's type. Unsupported: compile error 99.
  (fn emit_typed_binop [o:(ptr Out) op_id:Kw t:Ty] -> void
    (cond
      ((eq op_id Kw.and) (call put_op o OP_I32_AND))
      ((eq op_id Kw.or) (call put_op o OP_I32_OR))
      (else
       (let opc:i32 (call binop_opcode op_id t))
       (if (eq opc -1)
           (block (call set_compile_error CgErr.no_instruction_for_type) (block))
           (call put_op o opc)))))




  (fn emit_memop_offset [o:(ptr Out) opcode:i32 align:i32 offset:i32] -> void
    (call put_op o opcode)
    (call put_byte o align)
    (call put_u32 o offset))




  ;; ===== Voidness classification =====
  (fn is_void_op [k:Kw] -> bool
    (or (eq k Kw.atomic_lock) (or (eq k Kw.atomic_unlock)
    (or (eq k Kw.return) (or (eq k Kw.break) (or (eq k Kw.continue)
    (or (eq k Kw.mem_store8) (or (eq k Kw.mem_store32) (or (eq k Kw.mem_store64) (or (eq k Kw.mem_store16)
    (or (eq k Kw.sys_print) (or (eq k Kw.sys_exit) (or (eq k Kw.put) (eq k Kw.arr_set))))))))))))))

  (fn last_child [group:(ptr compiler.Node)] -> (ptr compiler.Node)
    (let cur:(ptr compiler.Node) (call first_child group))
    (while (neq (call node_next cur) (ptr.null compiler.Node))
      (set! cur (call node_next cur)))
    cur)

  ;; -1 unless group is a (...) whose head is a symbol. Checks the kinds itself
  ;; so any caller is safe: an atom has no children.
  (fn group_head_keyword [cg:(ptr Cg) group:(ptr compiler.Node)] -> Kw
    (when (neq (call node_kind group) compiler.Kind.paren) (return Kw.none))
    (let head:(ptr compiler.Node) (call first_child group))
    (if (neq (call node_kind head) compiler.Kind.symbol)
        Kw.none
        (call classify_keyword cg (call node_a head) (call node_b head))))

  (fn is_void_call [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (let fname:(ptr compiler.Node) (call nth_child node 1))
    (let fidx:i32 (call find_function cg (call node_a fname) (call node_b fname)))
    (if (eq fidx -1)
        false
        (eq (get (call func_entry_ptr cg fidx) FnInfo.ret) Ty.void)))

  (fn is_void_node [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (if (neq (call node_kind node) compiler.Kind.paren)
        false
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (let res:bool false)
          (when (eq kw Kw.let) (set! res true))
          (when (eq kw Kw.set) (set! res true))
          (when (eq kw Kw.loop) (set! res true))
          (when (eq kw Kw.while) (set! res true))
          (when (eq kw Kw.struct) (set! res true))
          (when (eq kw Kw.match_result) (set! res (call is_void_node cg (call last_of (call mr_typed cg node)))))
          (when (eq kw Kw.match)
                (let last:(ptr compiler.Node) (call last_of (call match_typed cg node)))
                (set! res (or (eq last (ptr.null compiler.Node)) (call is_void_node cg last))))
          ;; an empty (block) is void, like Expr::Block([]) in wasm.rs
          (when (eq kw Kw.block) (set! res (or (eq (call node_next (call first_child node)) (ptr.null compiler.Node)) (call is_void_node cg (call last_child node)))))
          (when (eq kw Kw.if) (set! res (and (call is_void_node cg (call nth_child node 2)) (call is_void_node cg (call nth_child node 3)))))
          ;; (when c body...) has no value
          (when (eq kw Kw.when) (set! res true))
          (when (eq kw Kw.call) (set! res (call is_void_call cg node)))
          (when (call is_op kw) (set! res (call is_void_op kw)))
          (when (eq kw Kw.cond)
                (let all_void:bool true)
                (let clause:(ptr compiler.Node) (call nth_child node 1))
                (while (neq clause (ptr.null compiler.Node))
                  (when (not (call is_void_node cg (call last_child clause))) (set! all_void false))
                  (set! clause (call node_next clause)))
                (set! res all_void))
          ;; call_ref is void when its signature returns void (after the generic op rule)
          (when (eq kw Kw.call_ref) (set! res (eq (call type_node_id cg (call nth_child (call nth_child node 1) 3)) Ty.void)))
          res)))

  ;; ===== Struct table & resolution =====
  ;; Index of the last `target` byte in the span, or -1.
  (fn find_last_char [cg:(ptr Cg) pos:i32 len:i32 target:i32] -> i32
    (unsafe (let found:i32 -1)
    (for i 0 len
      (when (eq (mem.load8 (+ (get cg Cg.src) (+ pos i))) target) (set! found i)))
    found))

  ;; Records every (struct ...) of the module, its name and whether it is a
  ;; value struct (marked (value)); returns the count. The table grows as
  ;; structs are added. Laid out later (layout_struct), once every struct
  ;; and union is known.
  (fn register_structs [cg:(ptr Cg) root:(ptr compiler.Node)] -> i32
    (let scount:i32 0)
    (let child:(ptr compiler.Node) (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (when (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.struct))
            (let sname_node:(ptr compiler.Node) (call nth_child child 1))
            (let si:(ptr StructInfo) (new StructInfo (call alloc.forever) [name_pos:(call node_a sname_node)
                                                                           name_len:(call node_b sname_node)
                                                                           size:(zero i32)
                                                                           fields:(arr.new (ptr Field) (call alloc.forever) 8)
                                                                           nfields:(zero i32)
                                                                           node:child
                                                                           value:(zero bool)
                                                                           laid:(zero bool)
                                                                           align:(zero i32)
                                                                           width:(zero i32)
                                                                           flat_ty:(zero (arr Ty))
                                                                           flat_off:(zero (arr i32))
                                                                           union_of:(zero (ptr UnionInfo))
                                                                           result:(zero bool)]))
            (let mark:(ptr compiler.Node) (call nth_child child 3))
            (put si StructInfo.value (and (neq mark (ptr.null compiler.Node))
                                          (and (eq (call node_kind mark) compiler.Kind.paren)
                                               (call sym_eq cg (call node_a (call first_child mark)) (call node_b (call first_child mark)) (str.ptr "value") 5))))
            (put si StructInfo.flat_ty (arr.new Ty (call alloc.forever) 8))
            (put si StructInfo.flat_off (arr.new i32 (call alloc.forever) 8))
            (when (get si StructInfo.value) (put cg Cg.has_values true))
            (put cg Cg.structs (call (room (ptr StructInfo)) (get cg Cg.structs) scount))
            (arr.set (ptr StructInfo) (get cg Cg.structs) scount si)
            (set! scount (+ scount 1)))
      (set! child (call node_next child)))
    (put cg Cg.nstructs scount)
    scount)

  ;; Lays out every struct not laid out yet.
  (fn collect_structs [cg:(ptr Cg) root:(ptr compiler.Node)] -> i32
    (for i 0 (get cg Cg.nstructs)
      (call layout_struct cg (arr.get (ptr StructInfo) (get cg Cg.structs) i)))
    (get cg Cg.nstructs))

  ;; A struct's layout (checker.rs type_size_and_align): fields in order,
  ;; each aligned to its alignment, the size rounded up to the largest. A
  ;; value struct's scalars are flattened too.
  (fn layout_struct [cg:(ptr Cg) si:(ptr StructInfo)] -> void
    (when (get si StructInfo.laid) (return))
    (put si StructInfo.laid true)
    (let cur_offset:i32 0)
    (let max_align:i32 1)
    (let fcount:i32 0)
    (let nflat:i32 0)
    (let fchild:(ptr compiler.Node) (call first_child (call nth_child (get si StructInfo.node) 2)))
    (while (neq fchild (ptr.null compiler.Node))
      (let type_node:(ptr compiler.Node) (call node_next (call node_next fchild)))
      (let f:(ptr Field) (call new_field cg fchild type_node))
      (let fsize:i32 (call ty_size (get f Field.ty) (get f Field.vs)))
      (let falign:i32 (call ty_align (get f Field.ty) (get f Field.vs)))
      (when (gt falign max_align) (set! max_align falign))
      (set! cur_offset (bitand (+ cur_offset (- falign 1)) (- 0 falign)))
      (put f Field.offset cur_offset)
      (put f Field.slot nflat)
      (when (get si StructInfo.value) (set! nflat (call flatten_into si nflat f)))
      (put si StructInfo.fields (call (room (ptr Field)) (get si StructInfo.fields) fcount))
      (arr.set (ptr Field) (get si StructInfo.fields) fcount f)
      (set! cur_offset (+ cur_offset fsize))
      (set! fcount (+ fcount 1))
      (if (neq type_node (ptr.null compiler.Node))
          (set! fchild (call node_next type_node))
          (set! fchild (ptr.null compiler.Node))))
    (put si StructInfo.size (bitand (+ cur_offset (- max_align 1)) (- 0 max_align)))
    (put si StructInfo.align max_align)
    (put si StructInfo.width nflat)
    (put si StructInfo.nfields fcount))

  ;; A field named by fchild, of the type type_node names (not yet placed).
  ;; A type that cannot be in memory is compile error 95.
  (fn new_field [cg:(ptr Cg) fchild:(ptr compiler.Node) type_node:(ptr compiler.Node)] -> (ptr Field)
    (let ftype:Ty (call type_node_id cg type_node))
    (if (and (call is_memory_type ftype) (neq (call group_head_keyword cg type_node) Kw.ty_result)) 0 (call set_compile_error CgErr.not_a_memory_type))
    (let f:(ptr Field) (new Field (call alloc.forever) [name_pos:(call node_a fchild)
                                                        name_len:(call node_b fchild)
                                                        offset:(zero i32)
                                                        ty:ftype
                                                        vs:(if (eq ftype Ty.value) (call type_node_struct cg type_node) (ptr.null StructInfo))
                                                        slot:(zero i32)]))
    f)

  ;; Appends field f's scalars (at its offset) to value struct si's, from
  ;; the nflat-th; returns the new count. Past 8: compile error 94 (the
  ;; checker allows 8).
  (fn flatten_into [si:(ptr StructInfo) nflat:i32 f:(ptr Field)] -> i32
    (let n:i32 nflat)
    (let vs:(ptr StructInfo) (get f Field.vs))
    (if (and (eq (get f Field.ty) Ty.value) (neq vs (ptr.null StructInfo)))
        (for k 0 (get vs StructInfo.width)
          (call flat_push si n (arr.get Ty (get vs StructInfo.flat_ty) k) (+ (get f Field.offset) (arr.get i32 (get vs StructInfo.flat_off) k)))
          (set! n (+ n 1)))
        (block
          (call flat_push si n (get f Field.ty) (get f Field.offset))
          (set! n (+ n 1))))
    n)

  (fn flat_push [si:(ptr StructInfo) k:i32 t:Ty off:i32] -> void
    (when (gte k 8) (call set_compile_error CgErr.table_full) (return))
    (arr.set Ty (get si StructInfo.flat_ty) k t)
    (arr.set i32 (get si StructInfo.flat_off) k off))

  ;; The struct with this name, or null.
  (fn find_struct [cg:(ptr Cg) s_pos:i32 s_len:i32] -> (ptr StructInfo)
    (for i 0 (get cg Cg.nstructs)
      (let si:(ptr StructInfo) (arr.get (ptr StructInfo) (get cg Cg.structs) i))
      (when (call sym_eq cg s_pos s_len (+ (get cg Cg.src) (get si StructInfo.name_pos)) (get si StructInfo.name_len))
          (return si)))
    (ptr.null StructInfo))

  ;; Field S.f (the first field of that name, as in checker.rs), or null.
  (fn find_field [cg:(ptr Cg) s_pos:i32 s_len:i32 f_pos:i32 f_len:i32] -> (ptr Field)
    (let si:(ptr StructInfo) (call find_struct cg s_pos s_len))
    (when (eq si (ptr.null StructInfo)) (return (ptr.null Field)))
    (for fj 0 (get si StructInfo.nfields)
      (let f:(ptr Field) (arr.get (ptr Field) (get si StructInfo.fields) fj))
      (when (call sym_eq cg f_pos f_len (+ (get cg Cg.src) (get f Field.name_pos)) (get f Field.name_len))
          (return f)))
    (ptr.null Field))

  ;; Records every (union ...) of the module with its variants' layouts.
  ;; Names first, so a field may have the type of any union.
  (fn collect_unions [cg:(ptr Cg) root:(ptr compiler.Node)] -> i32
    (let ucount:i32 0)
    (let child:(ptr compiler.Node) (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (when (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.union))
            (let name_node:(ptr compiler.Node) (call nth_child child 1))
            (let u:(ptr UnionInfo) (new UnionInfo (call alloc.forever) [name_pos:(call node_a name_node)
                                                                        name_len:(call node_b name_node)
                                                                        variants:(arr.new (ptr VariantInfo) (call alloc.forever) 8)
                                                                        nvariants:0
                                                                        value:(zero bool)
                                                                        vs:(zero (ptr StructInfo))]))
            (put cg Cg.unions (call (room (ptr UnionInfo)) (get cg Cg.unions) ucount))
            (arr.set (ptr UnionInfo) (get cg Cg.unions) ucount u)
            (set! ucount (+ ucount 1)))
      (set! child (call node_next child)))
    (put cg Cg.nunions ucount)
    (let ui:i32 0)
    (set! child (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (when (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.union))
            (let u:(ptr UnionInfo) (arr.get (ptr UnionInfo) (get cg Cg.unions) ui))
            (let vcount:i32 0)
            (let vnode:(ptr compiler.Node) (call first_child (call nth_child child 2)))
            (while (neq vnode (ptr.null compiler.Node))
              (let v:(ptr VariantInfo) (new VariantInfo (call alloc.forever) [name_pos:(call node_a (call first_child vnode))
                                                                              name_len:(call node_b (call first_child vnode))
                                                                              size:(zero i32)
                                                                              fields:(zero (arr (ptr Field)))
                                                                              nfields:(zero i32)
                                                                              node:vnode
                                                                              slots:(zero (arr i32))
                                                                              nslots:(zero i32)
                                                                              kinds:(zero (ptr (vec.Vec Ty)))]))
              (put u UnionInfo.variants (call (room (ptr VariantInfo)) (get u UnionInfo.variants) vcount))
              (arr.set (ptr VariantInfo) (get u UnionInfo.variants) vcount v)
              (set! vcount (+ vcount 1))
              (set! vnode (call node_next vnode)))
            (put u UnionInfo.nvariants vcount)
            (set! ui (+ ui 1)))
      (set! child (call node_next child)))
    ;; which unions are values, then every variant's fields (whose types
    ;; that decides)
    (call decide_unions cg)
    (for i 0 ucount
      (let u:(ptr UnionInfo) (arr.get (ptr UnionInfo) (get cg Cg.unions) i))
      (for k 0 (get u UnionInfo.nvariants)
        (call layout_variant cg (arr.get (ptr VariantInfo) (get u UnionInfo.variants) k))))
    ucount)

  ;; A variant's fields and their layout in a cell (a union held by
  ;; address): from offset 4, each aligned to its alignment; the size rounded
  ;; up to the largest (at least 4, the tag's).
  (fn layout_variant [cg:(ptr Cg) v:(ptr VariantInfo)] -> void
    (let name_node:(ptr compiler.Node) (call first_child (get v VariantInfo.node)))
    (put v VariantInfo.fields (arr.new (ptr Field) (call alloc.forever) 8))
    (let cur_offset:i32 4)
    (let max_align:i32 4)
    (let fcount:i32 0)
    (let fchild:(ptr compiler.Node) (call node_next name_node))
    (while (neq fchild (ptr.null compiler.Node))
      (let type_node:(ptr compiler.Node) (call node_next (call node_next fchild)))
      (let f:(ptr Field) (call new_field cg fchild type_node))
      (let fsize:i32 (call ty_size (get f Field.ty) (get f Field.vs)))
      (let falign:i32 (call ty_align (get f Field.ty) (get f Field.vs)))
      (when (gt falign max_align) (set! max_align falign))
      (set! cur_offset (bitand (+ cur_offset (- falign 1)) (- 0 falign)))
      (put f Field.offset cur_offset)
      (put v VariantInfo.fields (call (room (ptr Field)) (get v VariantInfo.fields) fcount))
      (arr.set (ptr Field) (get v VariantInfo.fields) fcount f)
      (set! cur_offset (+ cur_offset fsize))
      (set! fcount (+ fcount 1))
      (set! fchild (call node_next type_node)))
    (put v VariantInfo.size (bitand (+ cur_offset (- max_align 1)) (- 0 max_align)))
    (put v VariantInfo.nfields fcount))

  ;; ===== Unions held by value (checker.rs union_layouts, sum_layout) =====
  ;; A union is a value unless it contains itself (through unions it
  ;; holds), or it needs more than 8 slots, counting the
  ;; unions it holds that are values as their slots and the others as one
  ;; (each union is decided after the unions it holds).
  (fn decide_unions [cg:(ptr Cg)] -> void
    (let n:i32 (get cg Cg.nunions))
    (let cand:(arr bool) (arr.new bool (call alloc.forever) (+ n 1)))
    (let decided:(arr bool) (arr.new bool (call alloc.forever) (+ n 1)))
    (for i 0 n
      (let u:(ptr UnionInfo) (call union_at cg i))
      (arr.set bool cand i (not (call reaches_itself cg u))))
    (for i 0 n
      (when (arr.get bool cand i) (call decide_union cg cand decided (call union_at cg i)))))

  ;; u after the candidates it holds: a value if it fits.
  (fn decide_union [cg:(ptr Cg) cand:(arr bool) decided:(arr bool) u:(ptr UnionInfo)] -> void
    (let ui:i32 (call union_index cg u))
    (when (arr.get bool decided ui) (return))
    (arr.set bool decided ui true)
    (let held:(ptr (vec.Vec (ptr UnionInfo))) (call (vec.make (ptr UnionInfo)) (call alloc.default) 4))
    (call push_held cg u held)
    (for k 0 (call (vec.len (ptr UnionInfo)) held)
      (let w:(ptr UnionInfo) (call (vec.at (ptr UnionInfo)) held k))
      (when (arr.get bool cand (call union_index cg w)) (call decide_union cg cand decided w)))
    (when (lte (call union_width cg u) 8) (call build_union cg u)))

;; ===== Results held by value (checker.rs result_layout) =====
  ;; (result T E) is held by value unless a side is a str or it needs more
  ;; than 8 slots: two variants, ok and err, sharing slots as a union's do.
  ;; Described, like a union, by a StructInfo of its slots (result true),
  ;; its two variants' maps in union_of; one per pair of sides' slot kinds.
  (fn result_info [cg:(ptr Cg) d:(ptr Desc)] -> (ptr StructInfo)
    (when (eq d (ptr.null Desc)) (return (ptr.null StructInfo)))
    (let ok:(ptr Desc) (call result_side cg d 0))
    (let er:(ptr Desc) (call result_side cg d 1))
    (let ot:Ty (call desc_ty cg ok))
    (let et:Ty (call desc_ty cg er))
    (let ok_k:(ptr (vec.Vec Ty)) (call desc_kinds cg ok ot))
    (let er_k:(ptr (vec.Vec Ty)) (call desc_kinds cg er et))
    (let rs:(ptr (vec.Vec (ptr StructInfo))) (get cg Cg.results))
    (for i 0 (call (vec.len (ptr StructInfo)) rs)
      (let si:(ptr StructInfo) (call (vec.at (ptr StructInfo)) rs i))
      (let vs:(arr (ptr VariantInfo)) (get (get si StructInfo.union_of) UnionInfo.variants))
      (when (and (call same_kinds (get (arr.get (ptr VariantInfo) vs 0) VariantInfo.kinds) ok_k)
               (call same_kinds (get (arr.get (ptr VariantInfo) vs 1) VariantInfo.kinds) er_k))
          (return si)))
    (let n:i32 1)
    (for k 0 4 (set! n (+ n (call max_i32 (call count_kind ok_k (call kind_at k)) (call count_kind er_k (call kind_at k))))))
    (when (gt n 8) (return (ptr.null StructInfo)))
    (put cg Cg.has_values true)
    (let si:(ptr StructInfo) (call build_sum cg ok_k er_k))
    (call (vec.push (ptr StructInfo)) rs si)
    si)

  (fn max_i32 [a:i32 b:i32] -> i32 (if (gt a b) a b))

  (fn count_kind [ks:(ptr (vec.Vec Ty)) kind:Ty] -> i32
    (let c:i32 0)
    (for j 0 (call (vec.len Ty) ks) (when (eq (call (vec.at Ty) ks j) kind) (set! c (+ c 1))))
    c)

  (fn same_kinds [a:(ptr (vec.Vec Ty)) b:(ptr (vec.Vec Ty))] -> bool
    (when (neq (call (vec.len Ty) a) (call (vec.len Ty) b)) (return false))
    (for j 0 (call (vec.len Ty) a) (when (neq (call (vec.at Ty) a j) (call (vec.at Ty) b j)) (return false)))
    true)

  ;; The slot kinds of a value of type t, described where d says.
  (fn desc_kinds [cg:(ptr Cg) d:(ptr Desc) t:Ty] -> (ptr (vec.Vec Ty))
    (let out:(ptr (vec.Vec Ty)) (call (vec.make Ty) (call alloc.default) 8))
    (let vs:(ptr StructInfo) (if (eq t Ty.value) (call desc_struct cg d) (ptr.null StructInfo)))
    (if (neq vs (ptr.null StructInfo))
        (for k 0 (get vs StructInfo.width) (call (vec.push Ty) out (call slot_kind (arr.get Ty (get vs StructInfo.flat_ty) k))))
        (call (vec.push Ty) out (call slot_kind t)))
    out)

  ;; The StructInfo of a result's slots, its sides' kinds ok_k and er_k
  ;; (checker.rs sum_layout).
  (fn build_sum [cg:(ptr Cg) ok_k:(ptr (vec.Vec Ty)) er_k:(ptr (vec.Vec Ty))] -> (ptr StructInfo)
    (let si:(ptr StructInfo) (new StructInfo (call alloc.forever) [name_pos:(zero i32)
                                                                   name_len:(zero i32)
                                                                   size:(zero i32)
                                                                   fields:(zero (arr (ptr Field)))
                                                                   nfields:(zero i32)
                                                                   node:(zero (ptr compiler.Node))
                                                                   value:true
                                                                   laid:true
                                                                   align:(zero i32)
                                                                   width:(zero i32)
                                                                   flat_ty:(zero (arr Ty))
                                                                   flat_off:(zero (arr i32))
                                                                   union_of:(zero (ptr UnionInfo))
                                                                   result:true]))
    (put si StructInfo.fields (arr.new (ptr Field) (call alloc.forever) 1))
    (put si StructInfo.flat_ty (arr.new Ty (call alloc.forever) 8))
    (put si StructInfo.flat_off (arr.new i32 (call alloc.forever) 8))
    (let base:(arr i32) (arr.new i32 (call alloc.forever) 4))
    (let n:i32 1)
    (arr.set Ty (get si StructInfo.flat_ty) 0 Ty.i32)
    (for k 0 4
      (arr.set i32 base k n)
      (for q 1 (+ (call max_i32 (call count_kind ok_k (call kind_at k)) (call count_kind er_k (call kind_at k))) 1)
        (arr.set Ty (get si StructInfo.flat_ty) n (call kind_at k))
        (set! n (+ n 1))))
    (let off:i32 0)
    (let align:i32 4)
    (for k 0 n
      (let a:i32 (call type_size (arr.get Ty (get si StructInfo.flat_ty) k)))
      (when (gt a align) (set! align a))
      (set! off (bitand (+ off (- a 1)) (- 0 a)))
      (arr.set i32 (get si StructInfo.flat_off) k off)
      (set! off (+ off a)))
    (put si StructInfo.width n)
    (put si StructInfo.align align)
    (put si StructInfo.size (bitand (+ off (- align 1)) (- 0 align)))
    (let u:(ptr UnionInfo) (new UnionInfo (call alloc.forever) [name_pos:(zero i32)
                                                                name_len:(zero i32)
                                                                variants:(arr.new (ptr VariantInfo) (call alloc.forever) 2)
                                                                nvariants:2
                                                                value:true
                                                                vs:si]))
    (arr.set (ptr VariantInfo) (get u UnionInfo.variants) 0 (call side_slots ok_k base))
    (arr.set (ptr VariantInfo) (get u UnionInfo.variants) 1 (call side_slots er_k base))
    (put si StructInfo.union_of u)
    si)

  ;; A side's scalars to the next free slot of their kind.
  (fn side_slots [ks:(ptr (vec.Vec Ty)) base:(arr i32)] -> (ptr VariantInfo)
    (let v:(ptr VariantInfo) (new VariantInfo (call alloc.forever) [name_pos:(zero i32)
                                                                    name_len:(zero i32)
                                                                    size:(zero i32)
                                                                    fields:(zero (arr (ptr Field)))
                                                                    nfields:(zero i32)
                                                                    node:(zero (ptr compiler.Node))
                                                                    slots:(zero (arr i32))
                                                                    nslots:(zero i32)
                                                                    kinds:ks]))
    (let used:(arr i32) (arr.new i32 (call alloc.forever) 4))
    (put v VariantInfo.slots (arr.new i32 (call alloc.forever) (+ (call (vec.len Ty) ks) 1)))
    (put v VariantInfo.nslots (call (vec.len Ty) ks))
    (for j 0 (call (vec.len Ty) ks)
      (let kind:Ty (call (vec.at Ty) ks j))
      (let ki:i32 (cond ((eq kind Ty.i32) 0) ((eq kind Ty.f32) 1) ((eq kind Ty.i64) 2) (else 3)))
      (arr.set i32 (get v VariantInfo.slots) j (+ (arr.get i32 base ki) (arr.get i32 used ki)))
      (arr.set i32 used ki (+ (arr.get i32 used ki) 1)))
    v)

  (fn union_at [cg:(ptr Cg) i:i32] -> (ptr UnionInfo) (arr.get (ptr UnionInfo) (get cg Cg.unions) i))

  (fn union_index [cg:(ptr Cg) u:(ptr UnionInfo)] -> i32
    (for i 0 (get cg Cg.nunions) (when (eq (call union_at cg i) u) (return i)))
    -1)

  ;; Each field's type node of variant v, in order, to f (with the type node).
  (fn variant_types [v:(ptr VariantInfo)] -> (ptr (vec.Vec (ptr compiler.Node)))
    (let out:(ptr (vec.Vec (ptr compiler.Node))) (call (vec.make (ptr compiler.Node)) (call alloc.default) 4))
    (let fchild:(ptr compiler.Node) (call node_next (call first_child (get v VariantInfo.node))))
    (while (neq fchild (ptr.null compiler.Node))
      (let t:(ptr compiler.Node) (call node_next (call node_next fchild)))
      (call (vec.push (ptr compiler.Node)) out t)
      (set! fchild (if (eq t (ptr.null compiler.Node)) t (call node_next t))))
    out)

  ;; The union a type node names (a symbol), or null.
  (fn type_node_union [cg:(ptr Cg) t:(ptr compiler.Node)] -> (ptr UnionInfo)
    (when (neq (call node_kind t) compiler.Kind.symbol) (return (ptr.null UnionInfo)))
    (call find_union cg (call node_a t) (call node_b t)))

  ;; Whether u reaches itself through the unions its variants hold.
  (fn reaches_itself [cg:(ptr Cg) u:(ptr UnionInfo)] -> bool
    (let seen:(arr bool) (arr.new bool (call alloc.forever) (+ (get cg Cg.nunions) 1)))
    (let todo:(ptr (vec.Vec (ptr UnionInfo))) (call (vec.make (ptr UnionInfo)) (call alloc.default) 8))
    (call push_held cg u todo)
    (while (gt (call (vec.len (ptr UnionInfo)) todo) 0)
      (let w:(ptr UnionInfo) (call (vec.pop (ptr UnionInfo)) todo))
      (when (eq w u) (return true))
      (let wi:i32 (call union_index cg w))
      (when (not (arr.get bool seen wi)) (arr.set bool seen wi true) (call push_held cg w todo)))
    false)

  (fn push_held [cg:(ptr Cg) u:(ptr UnionInfo) todo:(ptr (vec.Vec (ptr UnionInfo)))] -> void
    (for k 0 (get u UnionInfo.nvariants)
      (let ts:(ptr (vec.Vec (ptr compiler.Node))) (call variant_types (arr.get (ptr VariantInfo) (get u UnionInfo.variants) k)))
      (for j 0 (call (vec.len (ptr compiler.Node)) ts)
        (let w:(ptr UnionInfo) (call type_node_union cg (call (vec.at (ptr compiler.Node)) ts j)))
        (when (neq w (ptr.null UnionInfo)) (call (vec.push (ptr UnionInfo)) todo w)))))

  ;; The slot kinds a field of type node t takes, appended to out: a value
  ;; struct's scalars, a union's slots if it is decided a value, else one
  ;; (Ty.i32 for every 4-byte scalar but f32).
  (fn field_kinds [cg:(ptr Cg) t:(ptr compiler.Node) out:(ptr (vec.Vec Ty))] -> void
    (let w:(ptr UnionInfo) (call type_node_union cg t))
    (when (and (neq w (ptr.null UnionInfo)) (get w UnionInfo.value))
          (call (vec.push Ty) out Ty.i32)
          (for k 0 4
            (let kind:Ty (call kind_at k))
            (for q 1 (+ (call kind_count cg w kind) 1) (call (vec.push Ty) out kind)))
          (return))
    (let vs:(ptr StructInfo) (call type_node_struct cg t))
    (when (neq vs (ptr.null StructInfo))
          (for k 0 (get vs StructInfo.width) (call (vec.push Ty) out (call slot_kind (arr.get Ty (get vs StructInfo.flat_ty) k))))
          (return))
    (call (vec.push Ty) out (call slot_kind (if (neq w (ptr.null UnionInfo)) Ty.i32 (call type_node_id cg t)))))

  ;; checker.rs slot_kind, and the kinds in slot order.
  (fn slot_kind [t:Ty] -> Ty
    (cond ((or (eq t Ty.i64) (or (eq t Ty.ptr) (eq t Ty.arr))) Ty.i64) ((eq t Ty.f32) Ty.f32) ((eq t Ty.f64) Ty.f64) (else Ty.i32)))
  (fn kind_at [k:i32] -> Ty (cond ((eq k 0) Ty.i32) ((eq k 1) Ty.f32) ((eq k 2) Ty.i64) (else Ty.f64)))

  ;; The scalar kinds of variant v's fields, in order.
  (fn variant_kinds [cg:(ptr Cg) v:(ptr VariantInfo)] -> (ptr (vec.Vec Ty))
    (let out:(ptr (vec.Vec Ty)) (call (vec.make Ty) (call alloc.default) 8))
    (let ts:(ptr (vec.Vec (ptr compiler.Node))) (call variant_types v))
    (for j 0 (call (vec.len (ptr compiler.Node)) ts)
      (call field_kinds cg (call (vec.at (ptr compiler.Node)) ts j) out))
    out)

  ;; How many slots of `kind` union u needs: the most any variant uses.
  (fn kind_count [cg:(ptr Cg) u:(ptr UnionInfo) kind:Ty] -> i32
    (let most:i32 0)
    (for k 0 (get u UnionInfo.nvariants)
      (let ks:(ptr (vec.Vec Ty)) (call variant_kinds cg (arr.get (ptr VariantInfo) (get u UnionInfo.variants) k)))
      (let c:i32 0)
      (for j 0 (call (vec.len Ty) ks) (when (eq (call (vec.at Ty) ks j) kind) (set! c (+ c 1))))
      (when (gt c most) (set! most c)))
    most)

  ;; u's slots: the tag and every kind's.
  (fn union_width [cg:(ptr Cg) u:(ptr UnionInfo)] -> i32
    (let n:i32 1)
    (for k 0 4 (set! n (+ n (call kind_count cg u (call kind_at k)))))
    n)

  ;; u's layout as a value (checker.rs sum_layout): its slots (the tag, then
  ;; each kind's), their offsets, and each variant's map.
  (fn build_union [cg:(ptr Cg) u:(ptr UnionInfo)] -> void
    (when (get u UnionInfo.value) (return))
    (put cg Cg.has_values true)
    (let si:(ptr StructInfo) (new StructInfo (call alloc.forever) [name_pos:(get u UnionInfo.name_pos)
                                                                   name_len:(get u UnionInfo.name_len)
                                                                   size:(zero i32)
                                                                   fields:(zero (arr (ptr Field)))
                                                                   nfields:(zero i32)
                                                                   node:(zero (ptr compiler.Node))
                                                                   value:true
                                                                   laid:true
                                                                   align:(zero i32)
                                                                   width:(zero i32)
                                                                   flat_ty:(zero (arr Ty))
                                                                   flat_off:(zero (arr i32))
                                                                   union_of:u
                                                                   result:(zero bool)]))
    (put si StructInfo.fields (arr.new (ptr Field) (call alloc.forever) 1))
    (put si StructInfo.nfields 0)
    (put si StructInfo.flat_ty (arr.new Ty (call alloc.forever) 8))
    (put si StructInfo.flat_off (arr.new i32 (call alloc.forever) 8))
    (let base:(arr i32) (arr.new i32 (call alloc.forever) 4))
    (let n:i32 1)
    (arr.set Ty (get si StructInfo.flat_ty) 0 Ty.i32)
    (for k 0 4
      (arr.set i32 base k n)
      (for q 1 (+ (call kind_count cg u (call kind_at k)) 1)
        (when (lt n 8) (arr.set Ty (get si StructInfo.flat_ty) n (call kind_at k)))
        (set! n (+ n 1))))
    ;; offsets: each slot aligned to its size
    (let off:i32 0)
    (let align:i32 4)
    (for k 0 n
      (let a:i32 (call type_size (arr.get Ty (get si StructInfo.flat_ty) k)))
      (when (gt a align) (set! align a))
      (set! off (bitand (+ off (- a 1)) (- 0 a)))
      (arr.set i32 (get si StructInfo.flat_off) k off)
      (set! off (+ off a)))
    (put si StructInfo.width n)
    (put si StructInfo.align align)
    (put si StructInfo.size (bitand (+ off (- align 1)) (- 0 align)))
    ;; each variant's scalars, to the next free slot of their kind
    (for k 0 (get u UnionInfo.nvariants)
      (let v:(ptr VariantInfo) (arr.get (ptr VariantInfo) (get u UnionInfo.variants) k))
      (let ks:(ptr (vec.Vec Ty)) (call variant_kinds cg v))
      (let used:(arr i32) (arr.new i32 (call alloc.forever) 4))
      (put v VariantInfo.slots (arr.new i32 (call alloc.forever) (+ (call (vec.len Ty) ks) 1)))
      (put v VariantInfo.nslots (call (vec.len Ty) ks))
      (for j 0 (call (vec.len Ty) ks)
        (let kind:Ty (call (vec.at Ty) ks j))
        (let ki:i32 (cond ((eq kind Ty.i32) 0) ((eq kind Ty.f32) 1) ((eq kind Ty.i64) 2) (else 3)))
        (arr.set i32 (get v VariantInfo.slots) j (+ (arr.get i32 base ki) (arr.get i32 used ki)))
        (arr.set i32 used ki (+ (arr.get i32 used ki) 1))))
    (put u UnionInfo.vs si)
    (put u UnionInfo.value true))

  ;; The union with this name, or null.
  (fn find_union [cg:(ptr Cg) pos:i32 len:i32] -> (ptr UnionInfo)
    (for i 0 (get cg Cg.nunions)
      (let u:(ptr UnionInfo) (arr.get (ptr UnionInfo) (get cg Cg.unions) i))
      (when (call sym_eq cg pos len (+ (get cg Cg.src) (get u UnionInfo.name_pos)) (get u UnionInfo.name_len))
          (return u)))
    (ptr.null UnionInfo))

  ;; The index of variant U.v, spelled by the symbol node `target`, in its
  ;; union (-1 if there is none).
  (fn variant_index [cg:(ptr Cg) target:(ptr compiler.Node)] -> i32
    (when (neq (call node_kind target) compiler.Kind.symbol) (return -1))
    (let pos:i32 (call node_a target))
    (let len:i32 (call node_b target))
    (let dot:i32 (call find_last_char cg pos len 46))
    (when (lt dot 0) (return -1))
    (let u:(ptr UnionInfo) (call find_union cg pos dot))
    (when (eq u (ptr.null UnionInfo)) (return -1))
    (for i 0 (get u UnionInfo.nvariants)
      (let v:(ptr VariantInfo) (arr.get (ptr VariantInfo) (get u UnionInfo.variants) i))
      (when (call sym_eq cg (+ pos (+ dot 1)) (- len (+ dot 1)) (+ (get cg Cg.src) (get v VariantInfo.name_pos)) (get v VariantInfo.name_len))
          (return i)))
    -1)

  ;; Variant U.v spelled by `target`, or null.
  (fn find_variant [cg:(ptr Cg) target:(ptr compiler.Node)] -> (ptr VariantInfo)
    (let i:i32 (call variant_index cg target))
    (when (lt i 0) (return (ptr.null VariantInfo)))
    (let dot:i32 (call find_last_char cg (call node_a target) (call node_b target) 46))
    (arr.get (ptr VariantInfo) (get (call find_union cg (call node_a target) dot) UnionInfo.variants) i))

  ;; The variant a match arm (U.v [binders] body...) names; null for an enum
  ;; arm (its head a number after consts.aipl) or the else arm.
  (fn arm_variant [cg:(ptr Cg) arm:(ptr compiler.Node)] -> (ptr VariantInfo)
    (when (neq (call node_kind arm) compiler.Kind.paren) (return (ptr.null VariantInfo)))
    (call find_variant cg (call first_child arm)))

  ;; A binder written `_`: the field is not read.
  (fn is_wildcard [cg:(ptr Cg) b:(ptr compiler.Node)] -> bool
    (and (eq (call node_kind b) compiler.Kind.symbol) (call sym_eq cg (call node_a b) (call node_b b) (str.ptr "_") 1)))

  ;; The first expression of a match arm's body: after its head and, for a
  ;; union arm, its [binders].
  (fn arm_body [arm:(ptr compiler.Node)] -> (ptr compiler.Node)
    (when (eq arm (ptr.null compiler.Node)) (return arm))
    (let b:(ptr compiler.Node) (call node_next (call first_child arm)))
    (if (eq (call node_kind b) compiler.Kind.bracket) (call node_next b) b))

  ;; Whether node n always leaves its branch: a return, break, or continue,
  ;; a block ending in one, or an if whose branches both do (checker.rs
  ;; diverges). Such a branch takes the other branches' type.
  (fn diverges_node [cg:(ptr Cg) n:(ptr compiler.Node)] -> bool
    (when (or (eq n (ptr.null compiler.Node)) (neq (call node_kind n) compiler.Kind.paren)) (return false))
    (let kw:Kw (call group_head_keyword cg n))
    (cond
      ((call is_jump kw) true)
      ((eq kw Kw.block) (call body_diverges_node cg (call node_next (call first_child n))))
      ((eq kw Kw.if) (and (call diverges_node cg (call nth_child n 2)) (call diverges_node cg (call nth_child n 3))))
      (else false)))

  ;; Whether the body starting at `first` ends in an expression that always leaves.
  (fn body_diverges_node [cg:(ptr Cg) first:(ptr compiler.Node)] -> bool
    (call diverges_node cg (call last_of first)))

  ;; Whether node n ends in a jump of its own (checker.rs ends_in_jump).
  (fn ends_jump_node [cg:(ptr Cg) n:(ptr compiler.Node)] -> bool
    (when (or (eq n (ptr.null compiler.Node)) (neq (call node_kind n) compiler.Kind.paren)) (return false))
    (let kw:Kw (call group_head_keyword cg n))
    (cond
      ((call is_jump kw) true)
      ((eq kw Kw.block) (call ends_jump_node cg (call last_of (call node_next (call first_child n)))))
      (else false)))

  ;; After a branch whose value a block wants: unreachable if it always
  ;; leaves without a jump of its own (wasm.rs seal).
  (fn seal_node [cg:(ptr Cg) n:(ptr compiler.Node) valued:bool o:(ptr Out)] -> void
    (when (and valued (and (call diverges_node cg n) (not (call ends_jump_node cg n)))) (call put_op o OP_UNREACHABLE)))
  (fn seal_body [cg:(ptr Cg) first:(ptr compiler.Node) valued:bool o:(ptr Out)] -> void
    (call seal_node cg (call last_of first) valued o))

  ;; Whether every clause from this one on always leaves (the nested if
  ;; src/parser.rs makes there diverges).
  (fn clauses_diverge [cg:(ptr Cg) from:(ptr compiler.Node)] -> bool
    (let clause:(ptr compiler.Node) from)
    (while (neq clause (ptr.null compiler.Node))
      (let b:(ptr compiler.Node) (call node_next (call first_child clause)))
      (when (call is_else_clause cg clause) (return (call body_diverges_node cg b)))
      (when (not (call body_diverges_node cg b)) (return false))
      (set! clause (call node_next clause)))
    false)

  ;; The branch of an if whose type is the if's: then, unless it always leaves.
  (fn if_typed [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr compiler.Node)
    (let t:(ptr compiler.Node) (call nth_child node 2))
    (if (call diverges_node cg t) (call nth_child node 3) t))

  ;; The body (its first expression) whose type is a cond's: the first
  ;; clause's that does not always leave, else the last clause's (the nested
  ;; ifs src/parser.rs makes of it, typed as wasm.rs types them).
  (fn cond_typed [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr compiler.Node)
    (call clause_typed cg (call nth_child node 1)))

  ;; The same from one clause on: the nested if made at that clause.
  (fn clause_typed [cg:(ptr Cg) from:(ptr compiler.Node)] -> (ptr compiler.Node)
    (let clause:(ptr compiler.Node) from)
    (let last:(ptr compiler.Node) (ptr.null compiler.Node))
    (while (neq clause (ptr.null compiler.Node))
      (let b:(ptr compiler.Node) (call node_next (call first_child clause)))
      (when (not (call body_diverges_node cg b)) (return b))
      (set! last b)
      (set! clause (call node_next clause)))
    last)

  ;; The arm body whose type is a match's: the first that does not always
  ;; leave, else the first (wasm.rs match_type_body).
  (fn match_typed [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr compiler.Node)
    (let arm:(ptr compiler.Node) (call nth_child node 2))
    (while (neq arm (ptr.null compiler.Node))
      (when (not (call body_diverges_node cg (call arm_body arm))) (return (call arm_body arm)))
      (set! arm (call node_next arm)))
    (call arm_body (call nth_child node 2)))

  ;; The arm body whose type is a match_result's: ok's, unless it always leaves.
  (fn mr_typed [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr compiler.Node)
    (let ok:(ptr compiler.Node) (call node_next (call node_next (call first_child (call nth_child node 2)))))
    (if (call body_diverges_node cg ok) (call node_next (call node_next (call first_child (call nth_child node 3)))) ok))

  ;; The last of a list of nodes starting at `first` (null if empty).
  (fn last_of [first:(ptr compiler.Node)] -> (ptr compiler.Node)
    (when (eq first (ptr.null compiler.Node)) (return first))
    (let cur:(ptr compiler.Node) first)
    (while (neq (call node_next cur) (ptr.null compiler.Node)) (set! cur (call node_next cur)))
    cur)

  (fn get_struct_size [cg:(ptr Cg) s_pos:i32 s_len:i32] -> i32
    (let si:(ptr StructInfo) (call find_struct cg s_pos s_len))
    (if (eq si (ptr.null StructInfo)) (block (call set_compile_error CgErr.unknown_struct_or_field) 0) (get si StructInfo.size)))

  (fn get_field_offset [cg:(ptr Cg) s_pos:i32 s_len:i32 f_pos:i32 f_len:i32] -> i32
    (let f:(ptr Field) (call find_field cg s_pos s_len f_pos f_len))
    (if (eq f (ptr.null Field)) (block (call set_compile_error CgErr.unknown_struct_or_field) 0) (get f Field.offset)))

  ;; The type of field S.f, or Ty.none if unknown.
  (fn get_field_type [cg:(ptr Cg) s_pos:i32 s_len:i32 f_pos:i32 f_len:i32] -> Ty
    (let f:(ptr Field) (call find_field cg s_pos s_len f_pos f_len))
    (if (eq f (ptr.null Field)) Ty.none (get f Field.ty)))

  ;; A bool read from memory is normalised to 0/1 (i32.const 0; i32.ne), as in wasm.rs normalize_bool.
  (fn emit_normalize_bool [o:(ptr Out)] -> void
    (call emit_i32_const o 0)
    (call put_op o OP_I32_NE))




  ;; ===== Compile error signaling =====
  ;; Compile errors (AIPL_SPEC.md 6.4). The host reads the number from cell 4,
  ;; so the values are fixed.
  (enum CgErr [(memory_cap 90)            ;; mem.grow refused: more than 32768 pages
               (output_full 91)           ;; output or a function body passed 4 * src_len + 64 KiB
               (too_many_functions 92)    ;; unused since 2026-10-26: the tables grow
               (too_many_locals 93)       ;; unused since 2026-10-26: the tables grow
               (table_full 94)            ;; more than 8 scalars in a value (the checker allows 8)
               (not_a_memory_type 95)     ;; a field or element type that is not a scalar
               (unknown_struct_or_field 96)
               (no_value_group 97)        ;; a value struct with no scratch group (a codegen bug)
               (unlowerable_type 98)
               (no_instruction_for_type 99) ;; e.g. % on f64, + on str
               (too_deeply_nested 100)    ;; unused since 2026-10-19: the label stack grows
               (jump_outside_loop 101)
               (too_many_literals 768)
               (unknown_symbol 971)
               (unknown_enum_member 974)
               (unknown_variant 975)      ;; make or match names no variant of a union
               (unknown_form 987)
               (empty_expression 999)
               (undefined_function 1452)])

  ;; Records the first error only: later errors are usually consequences of it.
  (fn set_compile_error [e:CgErr] -> i32
    (unsafe (when (eq (mem.load32 4) 0) (mem.store32 4 (enum.ord e)))
    0))

  (fn has_compile_error [] -> bool
    (unsafe (neq (mem.load32 4) 0)))

  ;; mem.alloc that grows linear memory to cover the new block. mem.alloc only
  ;; moves the cursor; without this a large compile walks off the end of
  ;; memory. Sets compile error 90 if the 32768-page cap would be exceeded.
  ;; Sizes compare unsigned: 32768 pages is 2^31 bytes.
  (fn cg_alloc [n:i32] -> i32
    (unsafe (let p:i32 (mem.alloc n))
    (let end:i32 (mem.load32 0))
    (let have:i32 (* (mem.grow 0) 65536))
    (if (gtu end have)
        (if (eq (mem.grow (+ (/ (- end have) 65536) 1)) -1)
            (call set_compile_error CgErr.memory_cap)
            0)
        0)
    p))

  (fn alloc_src [len:i32] -> i32
    (mem.alloc len))

  ;; ===== String Interning =====
  ;; The address of the literal spelled by this span, or -1 if not interned.
  (fn find_interned_string [cg:(ptr Cg) pos:i32 len:i32] -> i32
    (for i 0 (get cg Cg.nstrs)
      (let e:(ptr StrLit) (arr.get (ptr StrLit) (get cg Cg.strs) i))
      (when (and (neq (get e StrLit.pos) -1) (call sym_eq cg pos len (+ (get cg Cg.src) (get e StrLit.pos)) (get e StrLit.len)))
          (return (get e StrLit.addr))))
    -1)

  ;; The address of interned bytes equal to the n bytes at `bytes`, or -1.
  (fn find_interned_content [cg:(ptr Cg) bytes:i32 n:i32] -> i32
    (unsafe (let blob:i32 (get (get cg Cg.blob) buf.Buf.data))
    (let off:i32 0)
    (let end:i32 (call buf.len (get cg Cg.blob)))
    (while (lt off end)
      (let k:i32 (mem.load32 (+ blob off)))
      (when (and (eq k n) (call bytes_equal (+ blob (+ off 4)) bytes n))
          (return (+ 1028 off)))
      (set! off (+ off (+ 4 k))))
    -1))

  (fn bytes_equal [a:i32 b:i32 n:i32] -> bool
    (unsafe (for i 0 n
      (when (neq (mem.load8 (+ a i)) (mem.load8 (+ b i))) (return false)))
    true))

  (fn add_str_entry [cg:(ptr Cg) pos:i32 len:i32 addr:i32] -> void
    ;; a full table doubles
    (let n:i32 (get cg Cg.nstrs))
    (when (eq n (arr.len (get cg Cg.strs)))
          (let bigger:(arr (ptr StrLit)) (arr.new (ptr StrLit) (call alloc.forever) (* n 2)))
          (for i 0 n
            (arr.set (ptr StrLit) bigger i (arr.get (ptr StrLit) (get cg Cg.strs) i)))
          (put cg Cg.strs bigger))
    (let e:(ptr StrLit) (new StrLit (call alloc.forever) [pos:pos len:len addr:addr]))
    (arr.set (ptr StrLit) (get cg Cg.strs) (get cg Cg.nstrs) e)
    (put cg Cg.nstrs (+ (get cg Cg.nstrs) 1)))

  ;; Appends [len u32 LE][bytes] to the blob; returns the bytes' address.
  ;; The literals and the heap start must fit in the initial 16 pages, as
  ;; wasm.rs string_layout requires: past that, compile error 768.
  (fn append_to_blob [cg:(ptr Cg) bytes:i32 n:i32] -> i32
    (unsafe (let blob:(ptr buf.Buf) (get cg Cg.blob))
    (let addr:i32 (+ 1028 (call buf.len blob)))
    (call buf.push_byte blob (bitand n 255))
    (call buf.push_byte blob (bitand (shr n 8) 255))
    (call buf.push_byte blob (bitand (shr n 16) 255))
    (call buf.push_byte blob (bitand (shr n 24) 255))
    (for i 0 n (call buf.push_byte blob (mem.load8 (+ bytes i))))
    (if (gt (call heap_start cg) 1048576) (call set_compile_error CgErr.too_many_literals) 0)
    addr))

  ;; Interns the literal spelled by this span (escapes decoded) by content,
  ;; as wasm.rs string_layout does; returns its address.
  (fn intern_string [cg:(ptr Cg) pos:i32 len:i32] -> i32
    (unsafe (let existing:i32 (call find_interned_string cg pos len))
    (when (neq existing -1) (return existing))
    (let text:(ptr buf.Buf) (call buf.make (call alloc.default) (+ len 1)))
    (let i:i32 0)
    (while (lt i len)
      (let b:i32 (mem.load8 (+ (get cg Cg.src) (+ pos i))))
      (if (and (eq b 92) (lt (+ i 1) len))
          (block
            (let nb:i32 (mem.load8 (+ (get cg Cg.src) (+ pos (+ i 1)))))
            (call buf.push_byte text
                  (cond
                    ((eq nb 110) 10)
                    ((eq nb 116) 9)
                    ((eq nb 114) 13)
                    ((eq nb 48) 0)
                    (else nb)))
            (set! i (+ i 2)))
          (block
            (call buf.push_byte text b)
            (set! i (+ i 1)))))
    ;; another spelling of the same text (or the reserved newline) shares it
    (let data:i32 (get text buf.Buf.data))
    (let addr:i32 (call find_interned_content cg data (call buf.len text)))
    (when (eq addr -1) (set! addr (call append_to_blob cg data (call buf.len text))))
    (call add_str_entry cg pos len addr)
    addr))

  ;; The newline sys.print writes after each argument, interned once.
  (fn intern_newline [cg:(ptr Cg)] -> i32
    (unsafe (when (eq (get cg Cg.newline) 0)
          (let nl:i32 (mem.alloc 8))
          (mem.store8 nl 10)
          (let addr:i32 (call append_to_blob cg nl 1))
          (call add_str_entry cg -1 1 addr)
          (put cg Cg.newline addr))
    (get cg Cg.newline)))

  ;; A wasm name: its length (LEB128), then its bytes. Returns the byte count.
  (fn emit_name [o:(ptr Out) s:str] -> void
    (unsafe (call put_u32 o (str.len s))
    (for i 0 (str.len s)
      (call put_byte o (mem.load8 (+ (str.ptr s) i))))))




  ;; The import name of WASI function w (the order of wasm.rs Wasi).
  ;; The import name of a WASI function.
  (fn wasi_name [w:Wasi] -> str
    (cond
      ((eq w Wasi.fd_write) "fd_write")
      ((eq w Wasi.fd_read) "fd_read")
      ((eq w Wasi.path_open) "path_open")
      ((eq w Wasi.fd_close) "fd_close")
      ((eq w Wasi.proc_exit) "proc_exit")
      ((eq w Wasi.path_unlink_file) "path_unlink_file")
      ((eq w Wasi.args_sizes_get) "args_sizes_get")
      ((eq w Wasi.args_get) "args_get")
      ((eq w Wasi.environ_sizes_get) "environ_sizes_get")
      ((eq w Wasi.environ_get) "environ_get")
      ((eq w Wasi.thread_spawn) "thread-spawn")
      ((eq w Wasi.clock_time_get) "clock_time_get")
      ((eq w Wasi.fd_readdir) "fd_readdir")
      ((eq w Wasi.path_filestat_get) "path_filestat_get")
      ((eq w Wasi.net_listen) "listen")
      ((eq w Wasi.net_accept) "accept")
      ((eq w Wasi.net_recv) "recv")
      ((eq w Wasi.net_send) "send")
      ((eq w Wasi.net_close) "close")
      ((eq w Wasi.sys_chmod) "chmod")
      (else "random_get")))

  ;; The import module of WASI function w (wasm.rs Wasi::module).
  (fn wasi_module [w:Wasi] -> str
    (cond
      ((eq w Wasi.thread_spawn) "wasi")
      ((call is_net_wasi w) "aipl_net_v1")
      ((eq w Wasi.sys_chmod) "aipl_sys_v1")
      (else "wasi_snapshot_preview1")))

  (fn is_net_wasi [w:Wasi] -> bool
    (or (or (eq w Wasi.net_listen) (eq w Wasi.net_accept))
        (or (or (eq w Wasi.net_recv) (eq w Wasi.net_send)) (eq w Wasi.net_close))))

  ;; The operations that call an AIPL host import (aipl_net_v1's and
  ;; aipl_sys_v1's), which gives the result itself, and the import each calls.
  (fn is_host_kw [k:Kw] -> bool
    (or (or (or (eq k Kw.net_listen) (eq k Kw.net_accept))
            (or (or (eq k Kw.net_recv) (eq k Kw.net_send)) (eq k Kw.net_close)))
        (eq k Kw.fs_chmod)))
  (fn host_wasi [k:Kw] -> Wasi
    (cond
      ((eq k Kw.net_listen) Wasi.net_listen)
      ((eq k Kw.net_accept) Wasi.net_accept)
      ((eq k Kw.net_recv) Wasi.net_recv)
      ((eq k Kw.net_send) Wasi.net_send)
      ((eq k Kw.fs_chmod) Wasi.sys_chmod)
      (else Wasi.net_close)))

  ;; ===== WASI Import Detection =====
  ;; Cg.wasi holds, per WASI function, -1 (unused), 1 while marking it used,
  ;; then its function index (imports come first, in the fixed order).
  (fn mark_wasi_used [cg:(ptr Cg) w:Wasi] -> i32
    (arr.set i32 (get cg Cg.wasi) (enum.ord w) 1)
    0)

  (fn finalize_wasi_indices [cg:(ptr Cg)] -> i32
    (let count:i32 0)
    (for i 0 NWASI
      (if (eq (arr.get i32 (get cg Cg.wasi) i) 1)
          (block
            (arr.set i32 (get cg Cg.wasi) i count)
            (set! count (+ count 1)))
          (arr.set i32 (get cg Cg.wasi) i -1)))
    (put cg Cg.nimports count)
    count)

  (fn get_wasi_index [cg:(ptr Cg) w:Wasi] -> i32
    (arr.get i32 (get cg Cg.wasi) (enum.ord w)))

  ;; A module that uses thread.spawn is threaded (wasm.rs `threaded`).
  (fn threaded [cg:(ptr Cg)] -> bool
    (neq (call get_wasi_index cg Wasi.thread_spawn) -1))

  ;; ===== AST Walker for WASI & Strings =====
  (fn walk_ast_for_wasi [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (let kind:compiler.Kind (call node_kind node))
    (if (eq kind compiler.Kind.paren)
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (cond
            ((or (eq kw Kw.ok) (eq kw Kw.err)) (put cg Cg.has_values true) 0)
            ((eq kw Kw.sys_print) (call mark_wasi_used cg Wasi.fd_write) 0)
            ((eq kw Kw.sys_exit) (call mark_wasi_used cg Wasi.proc_exit) 0)
            ((eq kw Kw.fs_open) (call mark_wasi_used cg Wasi.path_open) 0)
            ((eq kw Kw.fs_read) (call mark_wasi_used cg Wasi.fd_read) 0)
            ((eq kw Kw.fs_write) (call mark_wasi_used cg Wasi.fd_write) 0)
            ((eq kw Kw.fs_close) (call mark_wasi_used cg Wasi.fd_close) 0)
            ((eq kw Kw.fs_delete) (call mark_wasi_used cg Wasi.path_unlink_file) 0)
            ((eq kw Kw.fs_opendir) (call mark_wasi_used cg Wasi.path_open) 0)
            ((eq kw Kw.fs_readdir) (call mark_wasi_used cg Wasi.fd_readdir) 0)
            ((eq kw Kw.fs_stat) (call mark_wasi_used cg Wasi.path_filestat_get) 0)
            ((eq kw Kw.args_sizes) (call mark_wasi_used cg Wasi.args_sizes_get) 0)
            ((eq kw Kw.args_get) (call mark_wasi_used cg Wasi.args_get) 0)
            ((eq kw Kw.env_sizes) (call mark_wasi_used cg Wasi.environ_sizes_get) 0)
            ((eq kw Kw.env_get) (call mark_wasi_used cg Wasi.environ_get) 0)
            ((eq kw Kw.thread_spawn) (call mark_wasi_used cg Wasi.thread_spawn) 0)
            ((or (eq kw Kw.sys_time) (eq kw Kw.sys_monotonic)) (call mark_wasi_used cg Wasi.clock_time_get) 0)
            ((eq kw Kw.sys_random) (call mark_wasi_used cg Wasi.random_get) 0)
            ((call is_host_kw kw) (call mark_wasi_used cg (call host_wasi kw)) 0)
            ;; an array index, req, or ens: the module needs the check helpers
            ((or (or (eq kw Kw.arr_get) (eq kw Kw.arr_set)) (or (eq kw Kw.req) (or (eq kw Kw.ens) (eq kw Kw.inv)))) (put cg Cg.uses_checks true) 0)
            ;; and a struct access or arr.len (the null check)
            ((or (eq kw Kw.get) (or (eq kw Kw.put) (eq kw Kw.arr_len))) (put cg Cg.uses_checks true) 0)
            ;; and mem.alloc, which stops with $aipl_oom when memory cannot grow
            ((eq kw Kw.mem_alloc) (put cg Cg.uses_checks true) 0)
            (else 0))
          (let child:(ptr compiler.Node) (call first_child node))
          (while (neq child (ptr.null compiler.Node)) (call walk_ast_for_wasi cg child) (set! child (call node_next child)))
          0)
        0))

  (fn walk_ast_for_strings [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (let kind:compiler.Kind (call node_kind node))
    (if (eq kind compiler.Kind.string)
        (call intern_string cg (call node_a node) (call node_b node))
        (if (eq kind compiler.Kind.paren)
            (block
              (let child:(ptr compiler.Node) (call first_child node))
              (while (neq child (ptr.null compiler.Node)) (call walk_ast_for_strings cg child) (set! child (call node_next child)))
              0)
            0)))

  ;; Encodes a (fn [..] -> r) type node as [nparams, valtypes..., nresults, result]
  ;; at out (wasm-level, so (fn [bool] -> i32) and (fn [i32] -> i32) coincide).
  ;; The wasm signature of a (fn [..] -> r) type node.
  ;; A (fn [params] -> r) type node's signature: a value struct is its
  ;; scalars (at most 8 each).
  (fn encode_sig [cg:(ptr Cg) sig:(ptr compiler.Node)] -> (ptr Sig)
    (let out:(ptr Sig) (call new_sig))
    (let p:(ptr compiler.Node) (call first_child (call nth_child sig 1)))
    (while (neq p (ptr.null compiler.Node))
      (call sig_add_param out (call type_node_id cg p) (call type_node_struct cg p))
      (set! p (call node_next p)))
    (let r:(ptr compiler.Node) (call nth_child sig 3))
    (call sig_set_result out (call type_node_id cg r) (call type_node_struct cg r))
    out)

  (fn new_sig [] -> (ptr Sig)
    (let s:(ptr Sig) (new Sig (call alloc.forever) [nparams:(zero i32)
                                                    params:(arr.new i32 (call alloc.forever) 128)
                                                    nresults:(zero i32)
                                                    results:(zero (arr i32))]))
    (put s Sig.nparams 0)
    (put s Sig.results (arr.new i32 (call alloc.forever) 8))
    (put s Sig.nresults 0)
    s)

  ;; A parameter of type t (struct vs): its value types appended.
  (fn sig_add_param [s:(ptr Sig) t:Ty vs:(ptr StructInfo)] -> void
    (for k 0 (call width t vs)
      (let n:i32 (get s Sig.nparams))
      (put s Sig.params (call (room i32) (get s Sig.params) n))
      (arr.set i32 (get s Sig.params) n (call scalar_valtype t vs k))
      (put s Sig.nparams (+ n 1))))

  ;; The result of type t (struct vs): none for void, else its value types.
  (fn sig_set_result [s:(ptr Sig) t:Ty vs:(ptr StructInfo)] -> void
    (put s Sig.nresults 0)
    (for k 0 (call width t vs)
      (when (lt k 8) (arr.set i32 (get s Sig.results) k (call scalar_valtype t vs k)))
      (put s Sig.nresults (+ k 1))))

  ;; The value type of scalar k of a value of type t (struct vs).
  (fn scalar_valtype [t:Ty vs:(ptr StructInfo) k:i32] -> i32
    (if (eq t Ty.value)
        (call type_id_to_valtype (arr.get Ty (get vs StructInfo.flat_ty) k))
        (call type_id_to_valtype t)))

  (fn sig_eq [a:(ptr Sig) b:(ptr Sig)] -> bool
    (when (or (neq (get a Sig.nparams) (get b Sig.nparams)) (neq (get a Sig.nresults) (get b Sig.nresults)))
        (return false))
    (for i 0 (get a Sig.nparams)
      (when (neq (arr.get i32 (get a Sig.params) i) (arr.get i32 (get b Sig.params) i)) (return false)))
    (for i 0 (get a Sig.nresults)
      (when (neq (arr.get i32 (get a Sig.results) i) (arr.get i32 (get b Sig.results) i)) (return false)))
    true)

  ;; The index of a signature among the module's call_ref signatures, adding
  ;; it if new.
  (fn add_sig [cg:(ptr Cg) s:(ptr Sig)] -> i32
    (let count:i32 (get cg Cg.nsigs))
    (for i 0 count
      (when (call sig_eq (arr.get (ptr Sig) (get cg Cg.sigs) i) s) (return i)))
    (put cg Cg.sigs (call (room (ptr Sig)) (get cg Cg.sigs) count))
    (arr.set (ptr Sig) (get cg Cg.sigs) count s)
    (put cg Cg.nsigs (+ count 1))
    count)

  ;; Index of the signature of a call_ref's type node, adding it if new.
  (fn sig_index [cg:(ptr Cg) sig:(ptr compiler.Node)] -> i32
    (call add_sig cg (call encode_sig cg sig)))

  ;; Threaded modules call workers through the table as (fn [i32] -> i32);
  ;; registered after the walk, as wasm.rs appends it. Returns its index.
  (fn worker_sig_index [cg:(ptr Cg)] -> i32
    (call add_sig cg (call sig_from "i" 127)))

  ;; Marks the module as using function refs and collects call_ref signatures
  ;; in source order, as wasm.rs walk_module does.
  (fn walk_ast_for_refs [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (if (eq (call node_kind node) compiler.Kind.paren)
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (when (or (eq kw Kw.ref) (eq kw Kw.call_ref)) (put cg Cg.uses_refs true))
          (if (eq kw Kw.call_ref) (call sig_index cg (call nth_child node 1)) 0)
          (let child:(ptr compiler.Node) (call first_child node))
          (while (neq child (ptr.null compiler.Node))
            (call walk_ast_for_refs cg child)
            (set! child (call node_next child)))
          0)
        0))

  ;; Whether node n is the symbol spelled s.
  (fn node_is [cg:(ptr Cg) n:(ptr compiler.Node) s:str] -> bool
    (unsafe (and (eq (call node_kind n) compiler.Kind.symbol) (call sym_eq cg (call node_a n) (call node_b n) (str.ptr s) (str.len s)))))

  ;; What a compiler-made _start does with main's value (wasm.rs
  ;; start_entry, is_result_main): 0 if there is no such _start, or main
  ;; returns void; 1 if it returns i32, the status; 2 if it returns
  ;; (result i32 str) (the checker allows no other result for main).
  (fn start_kind [cg:(ptr Cg) root:(ptr compiler.Node)] -> i32
    (let main:(ptr compiler.Node) (ptr.null compiler.Node))
    (let item:(ptr compiler.Node) (call node_next (call node_next (call first_child root))))
    (while (neq item (ptr.null compiler.Node))
      (when (and (eq (call node_kind item) compiler.Kind.paren) (eq (call group_head_keyword cg item) Kw.fn))
        (let name:(ptr compiler.Node) (call nth_child item 1))
        (when (call node_is cg name "_start") (return 0))
        (when (and (call node_is cg name "main") (eq (call first_child (call nth_child item 2)) (ptr.null compiler.Node)))
          (set! main item)))
      (set! item (call node_next item)))
    (when (eq main (ptr.null compiler.Node)) (return 0))
    (let ret:(ptr compiler.Node) (call nth_child main 4))
    (cond ((call node_is cg ret "i32") 1)
          ((eq (call group_head_keyword cg ret) Kw.ty_result) 2)
          (else 0)))

  (fn walk_module_prepass [cg:(ptr Cg) root:(ptr compiler.Node)] -> i32
    ;; Pass 1: WASI detection
    (let child:(ptr compiler.Node) (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (when (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.fn))
            (let bchild:(ptr compiler.Node) (call nth_child child 5))
            (while (neq bchild (ptr.null compiler.Node))
              (call walk_ast_for_wasi cg bchild)
              (set! bchild (call node_next bchild))))
      (set! child (call node_next child)))
    (let sk:i32 (call start_kind cg root))
    (if (gt sk 0) (call mark_wasi_used cg Wasi.proc_exit) 0)
    (if (eq sk 2) (call mark_wasi_used cg Wasi.fd_write) 0)

    (call finalize_wasi_indices cg)

    ;; Pass 2: Intern newline if sys.print is present and fd_write used, or
    ;; _start may write a result main's err
    (if (or (and (neq (call get_wasi_index cg Wasi.fd_write) -1) (call ast_uses_sys_print cg root)) (eq sk 2))
        (block (call intern_newline cg) 0)
        0)

    ;; Pass 3: Intern string literals
    (set! child (call node_next (call node_next (call first_child root))))
    (while (neq child (ptr.null compiler.Node))
      (when (and (eq (call node_kind child) compiler.Kind.paren) (eq (call group_head_keyword cg child) Kw.fn))
            (let bchild:(ptr compiler.Node) (call nth_child child 5))
            (while (neq bchild (ptr.null compiler.Node))
              (call walk_ast_for_strings cg bchild)
              (call walk_ast_for_refs cg bchild)
              (set! bchild (call node_next bchild))))
      (set! child (call node_next child)))
    0)

  (fn ast_uses_sys_print [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (if (neq (call node_kind node) compiler.Kind.paren)
        false
        (block
          (let kw:Kw (call group_head_keyword cg node))
          (if (eq kw Kw.sys_print)
              true
              (block
                (let child:(ptr compiler.Node) (call first_child node))
                (let found:bool false)
                (while (neq child (ptr.null compiler.Node))
                  (when (call ast_uses_sys_print cg child)
                      (set! found true))
                  (set! child (call node_next child)))
                found)))))

  ;; Ops whose lowering uses the two extra scratch locals (wasm.rs
  ;; fn_uses_io): the WASI ops, arr.new, thread.spawn, and the atomics that
  ;; wait or compare.
  (fn needs_io_scratch [k:Kw] -> bool
    (cond
      ((or (eq k Kw.sys_print) (or (eq k Kw.sys_exit) (or (eq k Kw.fs_open) (or (eq k Kw.fs_read)
          (or (eq k Kw.fs_write) (or (eq k Kw.fs_close) (eq k Kw.fs_delete))))))) true)
      ((or (eq k Kw.fs_opendir) (or (eq k Kw.fs_readdir) (eq k Kw.fs_stat))) true)
      ((or (eq k Kw.args_sizes) (or (eq k Kw.args_get) (or (eq k Kw.env_sizes) (or (eq k Kw.env_get) (eq k Kw.thread_spawn))))) true)
      ((or (eq k Kw.atomic_cas) (or (eq k Kw.atomic_lock) (eq k Kw.atomic_unlock))) true)
      ((call is_host_kw k) true)
      (else (or (eq k Kw.sys_time) (or (eq k Kw.sys_monotonic) (eq k Kw.sys_random))))))

  ;; Check if function uses I/O ops
  (fn ast_uses_io [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (if (neq (call node_kind node) compiler.Kind.paren)
        false
        (block
          (if (call needs_io_scratch (call group_head_keyword cg node))
              true
              (block
                (let child:(ptr compiler.Node) (call first_child node))
                (let found:bool false)
                (while (neq child (ptr.null compiler.Node))
                  (when (call ast_uses_io cg child)
                      (set! found true))
                  (set! child (call node_next child)))
                found)))))

  (fn fn_uses_io [cg:(ptr Cg) fndef_group:(ptr compiler.Node)] -> bool
    (let bchild:(ptr compiler.Node) (call nth_child fndef_group 5))
    (let found:bool false)
    (while (neq bchild (ptr.null compiler.Node))
      (when (call ast_uses_io cg bchild)
          (set! found true))
      (set! bchild (call node_next bchild)))
    found)

  ;; (ok:E v) / (err:T e), a result held by value (AIPL_SPEC.md 4.F; wasm.rs
  ;; compile_value_result): into its group, the tag, the payload's scalars in
  ;; their slots, zero in the others; then the group pushed.
  (fn compile_value_result [cg:(ptr Cg) node:(ptr compiler.Node) tag:i32 o:(ptr Out)] -> void
    (let vs:(ptr StructInfo) (call node_struct cg node))
    ;; wider than the checker allows
    (when (eq vs (ptr.null StructInfo)) (call set_compile_error CgErr.table_full) (return))
    (let g:i32 (call group_slot cg node false))
    (let v:(ptr VariantInfo) (arr.get (ptr VariantInfo) (get (get vs StructInfo.union_of) UnionInfo.variants) tag))
    (call emit_i32_const o tag)
    (call emit_local_set o g)
    (call compile_expr cg (call result_payload node) o)
    (let n:i32 (get v VariantInfo.nslots))
    (for q 1 (+ n 1) (call emit_local_set o (+ g (arr.get i32 (get v VariantInfo.slots) (- n q)))))
    (for slot 1 (get vs StructInfo.width)
      (when (not (call uses_slot v slot))
            (call emit_zero o (arr.get Ty (get vs StructInfo.flat_ty) slot))
            (call emit_local_set o (+ g slot))))
    (call emit_get_slots o g (get vs StructInfo.width)))

  ;; Payload of (ok v) / (err e), skipping the `: T` of (ok:T v) / (err:T e).
  (fn result_payload [node:(ptr compiler.Node)] -> (ptr compiler.Node)
    (if (eq (call node_kind (call nth_child node 1)) compiler.Kind.colon)
        (call nth_child node 3)
        (call nth_child node 1)))

  ;; ===== Static expression types (mirrors expr_type in wasm.rs) =====
  (fn node_type [cg:(ptr Cg) node:(ptr compiler.Node)] -> Ty
    (let kind:compiler.Kind (call node_kind node))
    (let res:Ty Ty.i32)
    (when (eq kind compiler.Kind.bool) (set! res Ty.bool))
    (when (eq kind compiler.Kind.string) (set! res Ty.str))
    (when (eq kind compiler.Kind.int64) (set! res Ty.i64))
    (when (eq kind compiler.Kind.float) (set! res Ty.f64))
    (when (eq kind compiler.Kind.float32) (set! res Ty.f32))
    (when (eq kind compiler.Kind.symbol)
          (let idx:i32 (call find_local cg (call node_a node) (call node_b node)))
          (when (neq idx -1) (set! res (get (call local_at cg idx) Local.ty))))
    (when (eq kind compiler.Kind.paren) (set! res (call group_type cg node)))
    res)

  ;; Type of the last expression of a body starting at `first` (void if empty).
  (fn body_type [cg:(ptr Cg) first:(ptr compiler.Node)] -> Ty
    (if (eq first (ptr.null compiler.Node))
        Ty.void
        (block
          (let cur:(ptr compiler.Node) first)
          (while (neq (call node_next cur) (ptr.null compiler.Node)) (set! cur (call node_next cur)))
          (call node_type cg cur))))

  (fn group_type [cg:(ptr Cg) node:(ptr compiler.Node)] -> Ty
    (let kw:Kw (call group_head_keyword cg node))
    (let res:Ty Ty.i32)
    ;; let, set!, loop, while, put, arr.set, stores, sys.print, sys.exit
    (when (or (eq kw Kw.let) (or (eq kw Kw.set) (or (eq kw Kw.loop) (or (eq kw Kw.while) (or (eq kw Kw.put) (eq kw Kw.arr_set))))))
        (set! res Ty.void))
    (when (or (eq kw Kw.mem_store8) (or (eq kw Kw.mem_store32) (or (eq kw Kw.mem_store64) (or (eq kw Kw.mem_store16) (or (eq kw Kw.sys_print) (eq kw Kw.sys_exit)))))) (set! res Ty.void))
    ;; return, break, continue are statements
    (when (call is_jump kw) (set! res Ty.void))
    ;; cond: the type of its first clause's body (the desugared if's then branch)
    (when (eq kw Kw.cond) (set! res (call body_type cg (call cond_typed cg node))))
    (when (eq kw Kw.if) (set! res (call node_type cg (call if_typed cg node))))
    (when (eq kw Kw.when) (set! res Ty.void))
    (when (eq kw Kw.block) (set! res (call body_type cg (call node_next (call first_child node)))))
    (when (eq kw Kw.match_result) (set! res (call body_type cg (call mr_typed cg node))))
    ;; match: its first arm's type (wasm.rs match_type_body); make: a union
    (when (eq kw Kw.match) (set! res (call body_type cg (call match_typed cg node))))
    ;; make: a union, or a value struct (with: one too)
    (when (eq kw Kw.make) (set! res (if (neq (call make_struct cg node) (ptr.null StructInfo)) Ty.value Ty.union)))
    (when (eq kw Kw.with) (set! res Ty.value))
    (when (eq kw Kw.call)
          (let fname:(ptr compiler.Node) (call nth_child node 1))
          (let fidx:i32 (call find_function cg (call node_a fname) (call node_b fname)))
          (when (neq fidx -1) (set! res (get (call func_entry_ptr cg fidx) FnInfo.ret))))
    ;; ok / err: a result (its cell's address)
    (when (or (eq kw Kw.ok) (eq kw Kw.err))
        (set! res (if (neq (call result_info cg (call desc node true)) (ptr.null StructInfo)) Ty.value Ty.result)))
    ;; get: its last field's type (a path names several), as is an arr.get's with a path
    (when (or (eq kw Kw.get) (and (eq kw Kw.arr_get) (neq (call nth_child node 4) (ptr.null compiler.Node))))
          (let sf_node:(ptr compiler.Node) (call last_child node))
          (let sf_pos:i32 (call node_a sf_node))
          (let sf_len:i32 (call node_b sf_node))
          (let dot_idx:i32 (call find_last_char cg sf_pos sf_len 46))
          (let ft:Ty (call get_field_type cg sf_pos dot_idx (+ sf_pos (+ dot_idx 1)) (- sf_len (+ dot_idx 1))))
          (when (neq ft Ty.none) (set! res (call value_of ft))))
    (when (and (eq kw Kw.arr_get) (eq (call nth_child node 4) (ptr.null compiler.Node))) (set! res (call value_of (call type_node_id cg (call nth_child node 1)))))
    ;; arithmetic and bitwise: the first operand's type
    (when (call is_arith kw)
        (set! res (call node_type cg (call nth_child node 1))))
    ;; comparisons and logic
    (when (call is_compare kw) (set! res Ty.bool))
    ;; mem.load64, i64.extend_s, i64.extend_u, i64.trunc_f64_s, i64.reinterpret_f64
    (when (or (eq kw Kw.mem_load64) (or (eq kw Kw.i64_extend_s) (or (eq kw Kw.i64_extend_u) (or (eq kw Kw.i64_trunc_f64_s) (eq kw Kw.i64_reinterpret_f64))))) (set! res Ty.i64))
    (when (eq kw Kw.ref) (set! res Ty.fn))
    ;; sys.time / sys.monotonic -> i64
    (when (or (eq kw Kw.sys_time) (eq kw Kw.sys_monotonic)) (set! res Ty.i64))
    ;; atomic.cas -> bool; atomic.lock / unlock are statements
    (when (eq kw Kw.atomic_cas) (set! res Ty.bool))
    (when (or (eq kw Kw.atomic_lock) (eq kw Kw.atomic_unlock)) (set! res Ty.void))
    (when (eq kw Kw.call_ref) (set! res (call type_node_id cg (call nth_child (call nth_child node 1) 3))))
    ;; new, ptr.null, ptr.cast -> (ptr S); arr.new, arr.null, arr.cast -> (arr T)
    (when (or (eq kw Kw.ptr_null) (or (eq kw Kw.ptr_cast) (eq kw Kw.ptr_make))) (set! res Ty.ptr))
    (when (or (eq kw Kw.arr_null) (or (eq kw Kw.arr_cast) (eq kw Kw.arr_make))) (set! res Ty.arr))
    ;; f64.convert_i64_s, f64.reinterpret_i64, f64.sqrt
    (when (or (eq kw Kw.f64_convert_i64_s) (or (eq kw Kw.f64_reinterpret_i64) (eq kw Kw.f64_sqrt))) (set! res Ty.f64))
    ;; the f32 conversions (checker.rs conversion)
    (when (call is_conversion kw) (set! res (call conversion_type kw)))
    res)

  (fn conversion_type [kw:Kw] -> Ty
    (cond
      ((or (eq kw Kw.f32_demote) (or (eq kw Kw.f32_convert_i32_s) (or (eq kw Kw.f32_convert_i64_s) (eq kw Kw.f32_reinterpret_i32)))) Ty.f32)
      ((or (eq kw Kw.f64_promote) (eq kw Kw.f64_convert_i32_s)) Ty.f64)
      ((eq kw Kw.i64_trunc_f32_s) Ty.i64)
      (else Ty.i32)))

  ;; Its wasm opcode: f32.demote_f64 0xB6, f64.promote_f32 0xBB,
  ;; f32.convert_i32_s 0xB2, f32.convert_i64_s 0xB4, f64.convert_i32_s 0xB7,
  ;; i32.trunc_f32_s 0xA8, i32.trunc_f64_s 0xAA, i64.trunc_f32_s 0xAE,
  ;; f32.reinterpret_i32 0xBE, i32.reinterpret_f32 0xBC.
  (fn conversion_opcode [kw:Kw] -> i32
    (cond
      ((eq kw Kw.f32_demote) 182) ((eq kw Kw.f64_promote) 187)
      ((eq kw Kw.f32_convert_i32_s) 178) ((eq kw Kw.f32_convert_i64_s) 180)
      ((eq kw Kw.f64_convert_i32_s) 183) ((eq kw Kw.i32_trunc_f32_s) 168)
      ((eq kw Kw.i32_trunc_f64_s) 170) ((eq kw Kw.i64_trunc_f32_s) 174)
      ((eq kw Kw.f32_reinterpret_i32) 190) (else 188)))

;; The value struct an expression of type Ty.value is (wasm.rs expr_type
  ;; gives it as Type::Struct): null for any other.
  (fn node_struct [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr StructInfo)
    (let kind:compiler.Kind (call node_kind node))
    (when (eq kind compiler.Kind.symbol)
          (let idx:i32 (call find_local cg (call node_a node) (call node_b node)))
          (when (eq idx -1) (return (ptr.null StructInfo)))
          (let l:(ptr Local) (call local_at cg idx))
          (return (if (eq (get l Local.ty) Ty.value) (get l Local.vs) (ptr.null StructInfo))))
    (when (neq kind compiler.Kind.paren) (return (ptr.null StructInfo)))
    (let kw:Kw (call group_head_keyword cg node))
    (cond
      ((eq kw Kw.if) (call node_struct cg (call if_typed cg node)))
      ((eq kw Kw.block) (call body_struct cg (call node_next (call first_child node))))
      ((eq kw Kw.cond) (call body_struct cg (call cond_typed cg node)))
      ((eq kw Kw.match_result) (call body_struct cg (call mr_typed cg node)))
      ((eq kw Kw.match) (call body_struct cg (call match_typed cg node)))
      ((eq kw Kw.make) (call make_struct cg node))
      ((or (eq kw Kw.ok) (eq kw Kw.err)) (call result_info cg (call desc node true)))
      ((eq kw Kw.with) (call ref_struct cg (call nth_child node 2)))
      ((or (eq kw Kw.get) (and (eq kw Kw.arr_get) (neq (call nth_child node 4) (ptr.null compiler.Node))))
       (let f:(ptr Field) (call ref_field cg (call last_child node)))
       (if (eq f (ptr.null Field)) (ptr.null StructInfo) (get f Field.vs)))
      ((eq kw Kw.arr_get) (call type_node_struct cg (call nth_child node 1)))
      ((eq kw Kw.call)
       (let fname:(ptr compiler.Node) (call nth_child node 1))
       (let fidx:i32 (call find_function cg (call node_a fname) (call node_b fname)))
       (if (eq fidx -1) (ptr.null StructInfo) (get (call func_entry_ptr cg fidx) FnInfo.ret_vs)))
      ((eq kw Kw.call_ref) (call type_node_struct cg (call nth_child (call nth_child node 1) 3)))
      (else (ptr.null StructInfo))))

  ;; The value struct of the last expression of a body (null if empty).
  (fn body_struct [cg:(ptr Cg) first:(ptr compiler.Node)] -> (ptr StructInfo)
    (let last:(ptr compiler.Node) (call last_of first))
    (if (eq last (ptr.null compiler.Node)) (ptr.null StructInfo) (call node_struct cg last)))

  ;; The value struct a (make S args...) builds, or null for a union's
  ;; (make U.v args...).
  ;; What a make builds by value: a value struct, or a union held by value
  ;; (as its StructInfo); null for a union held by address.
  (fn make_struct [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr StructInfo)
    (let rs:(ptr StructInfo) (call record_struct cg node))
    (when (neq rs (ptr.null StructInfo)) (return rs))
    (let u:(ptr UnionInfo) (call make_union cg node))
    (if (eq u (ptr.null UnionInfo)) (ptr.null StructInfo) (get u UnionInfo.vs)))

  ;; The union held by value a (make U.v ...) builds, or null.
  (fn make_union [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr UnionInfo)
    (let target:(ptr compiler.Node) (call nth_child node 1))
    (when (neq (call node_kind target) compiler.Kind.symbol) (return (ptr.null UnionInfo)))
    (let dot:i32 (call find_last_char cg (call node_a target) (call node_b target) 46))
    (when (lt dot 0) (return (ptr.null UnionInfo)))
    (let u:(ptr UnionInfo) (call find_union cg (call node_a target) dot))
    (if (and (neq u (ptr.null UnionInfo)) (get u UnionInfo.value)) u (ptr.null UnionInfo)))

  (fn record_struct [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr StructInfo)
    (call type_node_struct cg (call nth_child node 1)))

  ;; Field S.f, spelled by the symbol node sf (the last dot splits), or null.
  (fn ref_field [cg:(ptr Cg) sf:(ptr compiler.Node)] -> (ptr Field)
    (let pos:i32 (call node_a sf))
    (let len:i32 (call node_b sf))
    (let dot:i32 (call find_last_char cg pos len 46))
    (when (lt dot 0) (return (ptr.null Field)))
    (call find_field cg pos dot (+ pos (+ dot 1)) (- len (+ dot 1))))

  ;; The struct S of S.f, spelled by sf (laid out), or null.
  (fn ref_struct [cg:(ptr Cg) sf:(ptr compiler.Node)] -> (ptr StructInfo)
    (let dot:i32 (call find_last_char cg (call node_a sf) (call node_b sf) 46))
    (when (lt dot 0) (return (ptr.null StructInfo)))
    (let si:(ptr StructInfo) (call find_struct cg (call node_a sf) dot))
    (when (eq si (ptr.null StructInfo)) (return si))
    (call layout_struct cg si)
    si)

  ;; (A module with no value struct has no value: no type is worked out.)
  (fn is_value_node [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (and (get cg Cg.has_values) (eq (call node_type cg node) Ty.value)))

  ;; How many wasm values a non-void expression leaves: 1, or a value
  ;; struct's scalars.
  (fn value_width [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (if (call is_value_node cg node) (call width Ty.value (call node_struct cg node)) 1))

  ;; How many wasm values an expression leaves (none for void).
  (fn node_width [cg:(ptr Cg) node:(ptr compiler.Node)] -> i32
    (let t:Ty (call node_type cg node))
    (call width t (if (eq t Ty.value) (call node_struct cg node) (ptr.null StructInfo))))

;; ===== Value structs (AIPL_SPEC.md 4.E; wasm.rs, docs/design/VALUES_PLAN.md V2) =====
  ;; A value struct is its fields' scalars, flattened in declaration order:
  ;; a local or parameter is that many wasm locals, a result that many
  ;; results. It is never a block's result: an if or match that yields one
  ;; stores it in a group of scratch locals (after every other local, found
  ;; by groups_walk) and pushes them after its end; so do `with` and a field
  ;; read from a value that is computed. In memory it is moved one scalar at
  ;; a time: a load pushes each from the address in the scratch local; a
  ;; store spills the value to a group first, then stores each from there.

  ;; Where a value field ends up after a put's or arr.set's path: its type,
  ;; struct, and offset from where the path starts.
  (struct Target [ty:Ty vs:(ptr StructInfo) offset:i32])

  ;; Follows the path symbols (S.f ...) from `first` up to (not including)
  ;; `stop`, starting from a value of type t (struct vs) at offset off.
  (fn follow_path [cg:(ptr Cg) first:(ptr compiler.Node) stop:(ptr compiler.Node) t:Ty vs:(ptr StructInfo) off:i32] -> (ptr Target)
    (let tg:(ptr Target) (new Target (call alloc.forever) [ty:t vs:vs offset:off]))
    (let step:(ptr compiler.Node) first)
    (while (and (neq step stop) (neq step (ptr.null compiler.Node)))
      (let f:(ptr Field) (call ref_field cg step))
      (if (eq f (ptr.null Field))
          (block (call set_compile_error CgErr.unknown_struct_or_field) (block))
          (block
            (put tg Target.ty (get f Field.ty))
            (put tg Target.vs (get f Field.vs))
            (put tg Target.offset (+ (get tg Target.offset) (get f Field.offset)))))
      (set! step (call node_next step)))
    tg)

  ;; (put p S.f [T.g ...] val): what it writes, from the struct's start.
  (fn put_target [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr Target)
    (call follow_path cg (call nth_child node 2) (call last_child node) Ty.i32 (ptr.null StructInfo) 0))

  ;; (arr.set T a i [S.f ...] val): what it writes, from the element's start.
  (fn arr_set_target [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr Target)
    (let elem:(ptr compiler.Node) (call nth_child node 1))
    (call follow_path cg (call nth_child node 4) (call last_child node) (call elem_type_id cg elem) (call type_node_struct cg elem) 0))

  ;; The groups of the function being compiled, found in source order (its
  ;; body, then its req and ens conditions), as wasm.rs value_groups.
  (fn add_group [cg:(ptr Cg) node:(ptr compiler.Node) spill:bool vs:(ptr StructInfo)] -> void
    (let g:(ptr Group) (new Group (call alloc.forever) [node:node
                                                        spill:spill
                                                        ty:Ty.value
                                                        vs:vs
                                                        slot:(zero i32)]))
    (call (vec.push (ptr Group)) (get cg Cg.groups) g))

  ;; The first local of node's group (spill: its spill group); a missing
  ;; one is compile error 97.
  (fn group_slot [cg:(ptr Cg) node:(ptr compiler.Node) spill:bool] -> i32
    (let gs:(ptr (vec.Vec (ptr Group))) (get cg Cg.groups))
    (for i 0 (call (vec.len (ptr Group)) gs)
      (let g:(ptr Group) (call (vec.at (ptr Group)) gs i))
      (when (and (eq (get g Group.node) node) (eq (get g Group.spill) spill)) (return (get g Group.slot))))
    (call set_compile_error CgErr.no_value_group)
    0)

  ;; Walks an expression for the groups it needs. `into`: it is a branch's
  ;; or body's last expression whose value goes into its parent's group.
  (fn groups_walk [cg:(ptr Cg) node:(ptr compiler.Node) into:bool] -> void
    (when (neq (call node_kind node) compiler.Kind.paren) (return))
    (let kw:Kw (call group_head_keyword cg node))
    (cond
      ((eq kw Kw.if)
       (let v:bool (call is_value_node cg (call if_typed cg node)))
       (when (and v (not into)) (call add_group cg node false (call node_struct cg (call if_typed cg node))))
       (call groups_walk cg (call nth_child node 1) false)
       (call groups_walk cg (call nth_child node 2) v)
       (call groups_walk cg (call nth_child node 3) v))
      ;; (when c body...): as the if it reads as, of no value
      ((eq kw Kw.when)
       (call groups_walk cg (call nth_child node 1) false)
       (call groups_body cg (call nth_child node 2) false))
      ;; the nested ifs src/parser.rs makes of it: one group at most, the outer if's
      ((eq kw Kw.cond)
       (let v:bool (call is_value_node cg node))
       (when (and v (not into)) (call add_group cg node false (call node_struct cg node)))
       (let clause:(ptr compiler.Node) (call nth_child node 1))
       (while (neq clause (ptr.null compiler.Node))
         (when (not (call is_else_clause cg clause)) (call groups_walk cg (call first_child clause) false))
         (call groups_body cg (call node_next (call first_child clause)) v)
         (set! clause (call node_next clause))))
      ((eq kw Kw.block) (call groups_body cg (call node_next (call first_child node)) into))
      ((eq kw Kw.match)
       (let v:bool (call is_value_node cg node))
       (when (and v (not into)) (call add_group cg node false (call node_struct cg node)))
       ;; a union by value matched where it is computed spills
       (let sv:(ptr compiler.Node) (call nth_child node 1))
       (when (and (neq (call matched_union cg sv) (ptr.null UnionInfo)) (neq (call node_kind sv) compiler.Kind.symbol))
           (call add_group cg sv true (call node_struct cg sv)))
       (call groups_walk cg (call nth_child node 1) false)
       (let arm:(ptr compiler.Node) (call nth_child node 2))
       (while (neq arm (ptr.null compiler.Node))
         (call groups_body cg (call arm_body arm) v)
         (set! arm (call node_next arm))))
      ((eq kw Kw.match_result)
       (let v:bool (call is_value_node cg node))
       (when (and v (not into)) (call add_group cg node false (call node_struct cg node)))
       ;; a result by value matched where it is computed spills
       (let rv:(ptr compiler.Node) (call nth_child node 1))
       (when (and (call is_value_node cg rv) (neq (call node_kind rv) compiler.Kind.symbol))
           (call add_group cg rv true (call node_struct cg rv)))
       (call groups_walk cg (call nth_child node 1) false)
       (call groups_body cg (call node_next (call node_next (call first_child (call nth_child node 2)))) v)
       (call groups_body cg (call node_next (call node_next (call first_child (call nth_child node 3)))) v))
      ((and (or (eq kw Kw.ok) (eq kw Kw.err)) (call is_value_node cg node))
       (call add_group cg node false (call node_struct cg node))
       (call groups_walk cg (call result_payload node) false))
      ((and (eq kw Kw.make) (neq (call make_union cg node) (ptr.null UnionInfo)))
       (call add_group cg node false (get (call make_union cg node) UnionInfo.vs))
       (let a:(ptr compiler.Node) (call nth_child node 2))
       (while (neq a (ptr.null compiler.Node))
         (call groups_walk cg a false)
         (set! a (call node_next a))))
      ((eq kw Kw.with)
       (call add_group cg node false (call ref_struct cg (call nth_child node 2)))
       (call groups_walk cg (call nth_child node 1) false)
       (call groups_walk cg (call nth_child node 3) false))
      ;; a read from a value: the root of the chain spills unless it is in place
      ((call reads_value cg node)
       (let rt:(ptr Root) (call find_root cg node))
       (let root:(ptr compiler.Node) (get rt Root.node))
       (cond
         ((eq (get rt Root.kind) RootKind.computed)
          (call add_group cg root true (call node_struct cg root))
          (call groups_walk cg root false))
         ((eq (get rt Root.kind) RootKind.field) (call groups_walk cg (call nth_child root 1) false))
         ((eq (get rt Root.kind) RootKind.element)
          (call groups_walk cg (call nth_child root 2) false)
          (call groups_walk cg (call nth_child root 3) false))
         (else (block))))
      (else
       ;; a value struct stored to memory goes through its spill group
       (call groups_stored cg node kw)
       (let child:(ptr compiler.Node) (call node_next (call first_child node)))
       (while (neq child (ptr.null compiler.Node))
         (call groups_walk cg child false)
         (set! child (call node_next child))))))

  ;; A body's expressions; its last one `into`.
  (fn groups_body [cg:(ptr Cg) first:(ptr compiler.Node) into:bool] -> void
    (let e:(ptr compiler.Node) first)
    (while (neq e (ptr.null compiler.Node))
      (call groups_walk cg e (and into (eq (call node_next e) (ptr.null compiler.Node))))
      (set! e (call node_next e))))

  ;; The spill groups of the value structs `node` stores (wasm.rs
  ;; stored_values): a put's or arr.set's value whose target is one, an ok's
  ;; or err's, a union make's fields that are (in order).
  (fn groups_stored [cg:(ptr Cg) node:(ptr compiler.Node) kw:Kw] -> void
    (cond
      ((or (eq kw Kw.put) (eq kw Kw.arr_set))
       (let tg:(ptr Target) (if (eq kw Kw.put) (call put_target cg node) (call arr_set_target cg node)))
       (when (eq (get tg Target.ty) Ty.value) (call add_group cg (call last_child node) true (get tg Target.vs))))
      ((or (eq kw Kw.ok) (eq kw Kw.err))
       (let payload:(ptr compiler.Node) (call result_payload node))
       (when (call is_value_node cg payload) (call add_group cg payload true (call node_struct cg payload))))
      ((and (eq kw Kw.make) (eq (call make_struct cg node) (ptr.null StructInfo)))
       (let arg:(ptr compiler.Node) (call nth_child node 2))
       (while (neq arg (ptr.null compiler.Node))
         (when (call is_value_node cg arg) (call add_group cg arg true (call node_struct cg arg)))
         (set! arg (call node_next arg))))
      (else (block))))

;; A read names fields after what it reads from: (get e S.f ...) after e,
  ;; (arr.get T a i S.f ...) after the element. src/parser.rs makes a get
  ;; of each, nested, all at the read's position, as the printer writes
  ;; them; a program as written (driver.aipl) keeps the path. The first
  ;; field named, and the last (whose type the read has): null for an
  ;; arr.get with none.
  (fn first_ref [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr compiler.Node)
    (call nth_child node (if (eq (call group_head_keyword cg node) Kw.get) 2 4)))

  (fn last_ref [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr compiler.Node)
    (if (eq (call first_ref cg node) (ptr.null compiler.Node)) (ptr.null compiler.Node) (call last_child node)))

  ;; Whether node reads a field of a value struct (what it reads from is a
  ;; value, as the checker makes it): a get whose last field is one's, an
  ;; arr.get with a path.
  (fn reads_value [cg:(ptr Cg) node:(ptr compiler.Node)] -> bool
    (when (not (get cg Cg.has_values)) (return false))
    (let kw:Kw (call group_head_keyword cg node))
    (when (eq kw Kw.arr_get) (return (neq (call nth_child node 4) (ptr.null compiler.Node))))
    (when (neq kw Kw.get) (return false))
    (let si:(ptr StructInfo) (call ref_struct cg (call last_child node)))
    (and (neq si (ptr.null StructInfo)) (get si StructInfo.value)))

  ;; Where a chain of reads from values starts (wasm.rs value_chain): a
  ;; local; a field of a struct behind a pointer (a get's first field, from
  ;; nth 1); an array element (an arr.get's, from nth 1-3); or anything
  ;; else, computed. slot and off: the first scalar and the offset of the
  ;; value read, from the root's start.
  (enum RootKind [local field element computed])
  (struct Root [kind:RootKind node:(ptr compiler.Node) slot:i32 off:i32])

  (fn find_root [cg:(ptr Cg) node:(ptr compiler.Node)] -> (ptr Root)
    (let rt:(ptr Root) (new Root (call alloc.forever) [kind:(zero RootKind)
                                                       node:(zero (ptr compiler.Node))
                                                       slot:0
                                                       off:0]))
    (let cur:(ptr compiler.Node) node)
    (let found:bool false)
    (while (and (not found) (call reads_value cg cur))
      ;; each field cur names read from a value is a step; a get's first
      ;; may read from a struct behind a pointer instead: the root
      (let kw:Kw (call group_head_keyword cg cur))
      (let first:(ptr compiler.Node) (call first_ref cg cur))
      (let fs:(ptr StructInfo) (call ref_struct cg first))
      (let from_ptr:bool (and (eq kw Kw.get) (and (neq fs (ptr.null StructInfo)) (not (get fs StructInfo.value)))))
      (let r:(ptr compiler.Node) first)
      (while (neq r (ptr.null compiler.Node))
        (when (not (and from_ptr (eq r first))) (call add_step cg rt r))
        (set! r (call node_next r)))
      (cond
        (from_ptr (put rt Root.kind RootKind.field) (put rt Root.node cur) (set! found true))
        ((eq kw Kw.arr_get) (put rt Root.kind RootKind.element) (put rt Root.node cur) (set! found true))
        (else (set! cur (call nth_child cur 1)))))
    (when found (return rt))
    ;; cur reads from no value: a local, a get from a pointer, an element, or computed
    (let ckw:Kw (call group_head_keyword cg cur))
    (put rt Root.node cur)
    (put rt Root.kind (cond
                        ((eq (call node_kind cur) compiler.Kind.symbol) RootKind.local)
                        ((eq ckw Kw.get) RootKind.field)
                        ((eq ckw Kw.arr_get) RootKind.element)
                        (else RootKind.computed)))
    rt)

  (fn add_step [cg:(ptr Cg) rt:(ptr Root) r:(ptr compiler.Node)] -> void
    (let f:(ptr Field) (call ref_field cg r))
    (if (eq f (ptr.null Field))
        (block (call set_compile_error CgErr.unknown_struct_or_field) (block))
        (block
          (put rt Root.slot (+ (get rt Root.slot) (get f Field.slot)))
          (put rt Root.off (+ (get rt Root.off) (get f Field.offset))))))

  ;; Finds the function's groups and numbers their locals from `base`;
  ;; returns how many locals they are. value_return: the body's last
  ;; expression goes into res (a function with ens returning a value).
  (fn collect_groups [cg:(ptr Cg) entry:(ptr FnInfo) value_return:bool base:i32] -> i32
    (call (vec.clear (ptr Group)) (get cg Cg.groups))
    (when (not (get cg Cg.has_values)) (return 0))
    (let item:(ptr compiler.Node) (call nth_child (get entry FnInfo.node) 5))
    (while (neq item (ptr.null compiler.Node))
      (when (not (call is_contract_head cg item)) (call groups_walk cg item (and value_return (eq (call node_next item) (ptr.null compiler.Node)))))
      (set! item (call node_next item)))
    (set! item (call nth_child (get entry FnInfo.node) 5))
    (while (neq item (ptr.null compiler.Node))
      (when (neq (call contract_kind cg item) Kw.none) (call groups_walk cg (call nth_child item 1) false))
      (set! item (call node_next item)))
    (let gs:(ptr (vec.Vec (ptr Group))) (get cg Cg.groups))
    (let n:i32 0)
    (for i 0 (call (vec.len (ptr Group)) gs)
      (let g:(ptr Group) (call (vec.at (ptr Group)) gs i))
      (put g Group.slot (+ base n))
      (set! n (+ n (call width Ty.value (get g Group.vs)))))
    n)

  (fn emit_get_slots [o:(ptr Out) base:i32 n:i32] -> void
    (for k 0 n (call emit_local_get o (+ base k))))

  ;; The last scalar first: it is on top.
  (fn emit_set_slots [o:(ptr Out) base:i32 n:i32] -> void
    (for k 1 (+ n 1) (call emit_local_set o (- (+ base n) k))))

  ;; Drops what an expression of width n leaves (at least one value).
  (fn emit_drops [o:(ptr Out) n:i32] -> void
    (for k 1 (+ (if (lt n 1) 1 n) 1) (call put_op o OP_DROP)))

  ;; The scalars of value struct vs (or the one scalar of type t), loaded
  ;; from `offset` bytes past the address in the scratch local; a bool is
  ;; normalised.
  (fn emit_load_scalars [cg:(ptr Cg) o:(ptr Out) t:Ty vs:(ptr StructInfo) offset:i32] -> void
    (if (eq t Ty.value)
        (for k 0 (get vs StructInfo.width)
          (call emit_load_scalar cg o (arr.get Ty (get vs StructInfo.flat_ty) k) (+ offset (arr.get i32 (get vs StructInfo.flat_off) k))))
        (call emit_load_scalar cg o t offset)))

  (fn emit_load_scalar [cg:(ptr Cg) o:(ptr Out) t:Ty offset:i32] -> void
    (call emit_local_get o (get cg Cg.scratch))
    (call emit_memop_offset o (call load_opcode t) (call mem_align t) offset)
    (when (eq t Ty.bool) (call emit_normalize_bool o)))

  ;; With an address on the stack: stores the value struct vs that `val`
  ;; computes there, `offset` bytes on. The value goes to its spill group
  ;; (its scalars arrive at once), then the address to the scratch local
  ;; (only now: computing the value may use it), then each scalar is stored.
  (fn emit_store_value [cg:(ptr Cg) o:(ptr Out) vs:(ptr StructInfo) offset:i32 val:(ptr compiler.Node)] -> void
    (let g:i32 (call group_slot cg val true))
    (let n:i32 (get vs StructInfo.width))
    (call compile_expr cg val o)
    (call emit_set_slots o g n)
    (call emit_local_set o (get cg Cg.scratch))
    (for k 0 n
      (let t:Ty (arr.get Ty (get vs StructInfo.flat_ty) k))
      (call emit_local_get o (get cg Cg.scratch))
      (call emit_local_get o (+ g k))
      (call emit_memop_offset o (call store_opcode t) (call mem_align t) (+ offset (arr.get i32 (get vs StructInfo.flat_off) k)))))

  ;; arr.get's and arr.set's element address: the array (null-checked), the
  ;; index (bounds-checked), times the element's size, added.
  (fn emit_element_address [cg:(ptr Cg) o:(ptr Out) elem:(ptr compiler.Node) arr_node:(ptr compiler.Node) idx_node:(ptr compiler.Node)] -> void
    (let etype:Ty (call elem_type_id cg elem))
    (call compile_pointer cg arr_node o)
    (call compile_expr cg idx_node o)
    (call emit_bounds_check cg o)
    (call emit_i32_const o (call ty_size etype (call type_node_struct cg elem)))
    (call put_op o OP_I32_MUL)
    (call put_op o OP_I32_ADD))

  ;; A read from a value, (get v V.f) or a chain of them: from the locals of
  ;; a variable, from memory for a value in a struct's field or an array
  ;; element, else from the root's spill group.
  (fn compile_value_read [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let top:(ptr Field) (call ref_field cg (call last_ref cg node)))
    (when (eq top (ptr.null Field)) (call set_compile_error CgErr.unknown_struct_or_field) (return))
    (let t:Ty (get top Field.ty))
    (let vs:(ptr StructInfo) (get top Field.vs))
    (let n:i32 (call width t vs))
    (let rt:(ptr Root) (call find_root cg node))
    (let root:(ptr compiler.Node) (get rt Root.node))
    (let slot:i32 (get rt Root.slot))
    (let off:i32 (get rt Root.off))
    (let kind:RootKind (get rt Root.kind))
    (cond
      ((eq kind RootKind.local)
       (call emit_get_slots o (+ (call node_slot cg root) slot) n))
      ((eq kind RootKind.field)
       (let rf:(ptr Field) (call ref_field cg (call nth_child root 2)))
       (call compile_pointer cg (call nth_child root 1) o)
       (call emit_local_set o (get cg Cg.scratch))
       (call emit_load_scalars cg o t vs (+ (get rf Field.offset) off)))
      ((eq kind RootKind.element)
       (call emit_element_address cg o (call nth_child root 1) (call nth_child root 2) (call nth_child root 3))
       (call emit_local_set o (get cg Cg.scratch))
       (call emit_load_scalars cg o t vs off))
      (else
       (let g:i32 (call group_slot cg root true))
       (call compile_expr cg root o)
       (call emit_set_slots o g (call value_width cg root))
       (call emit_get_slots o (+ g slot) n))))

  ;; Compiles `node`, a value struct, into the locals from `base`: the
  ;; branches of an if, cond, or match, and a block's last expression, go
  ;; there directly; anything else is pushed and stored.
  (fn compile_into [cg:(ptr Cg) node:(ptr compiler.Node) base:i32 o:(ptr Out)] -> void
    (call at_push o (get node compiler.Node.pos))
    (let kw:Kw (call group_head_keyword cg node))
    (cond
      ((eq kw Kw.if)
       (call compile_expr cg (call nth_child node 1) o)
       (call put_op o OP_IF) (call put_byte o BLOCK_EMPTY)
       (call label_push cg Label.if_else)
       (call compile_into cg (call nth_child node 2) base o)
       (call put_op o OP_ELSE)
       (call compile_into cg (call nth_child node 3) base o)
       (call label_pop cg)
       (call put_op o OP_END))
      ((eq kw Kw.cond) (call compile_cond_into cg (call nth_child node 1) base o))
      ((and (eq kw Kw.block) (neq (call node_next (call first_child node)) (ptr.null compiler.Node)))
       (call compile_body_into cg (call node_next (call first_child node)) base o))
      ((eq kw Kw.match) (call compile_match cg node base o))
      ((eq kw Kw.match_result) (call compile_match_result cg node base o))
      (else
       (call compile_expr cg node o)
       (call emit_set_slots o base (call node_width cg node))))
    (call at_pop o))

  ;; A body whose last expression goes into the locals from `base`.
  (fn compile_body_into [cg:(ptr Cg) first:(ptr compiler.Node) base:i32 o:(ptr Out)] -> void
    (let e:(ptr compiler.Node) first)
    (while (neq e (ptr.null compiler.Node))
      (if (eq (call node_next e) (ptr.null compiler.Node))
          (call compile_into cg e base o)
          (call compile_stmt cg e o))
      (set! e (call node_next e))))

  ;; compile_cond_from, into the locals from `base`.
  (fn compile_cond_into [cg:(ptr Cg) clause:(ptr compiler.Node) base:i32 o:(ptr Out)] -> void
    (let head:(ptr compiler.Node) (call first_child clause))
    (when (call is_else_clause cg clause)
        (return (call compile_body_into cg (call node_next head) base o)))
    (call at_push o (get clause compiler.Node.pos))
    (call compile_expr cg head o)
    (call put_op o OP_IF) (call put_byte o BLOCK_EMPTY)
    (call label_push cg Label.if_else)
    (call compile_body_into cg (call node_next head) base o)
    (call put_op o OP_ELSE)
    (call compile_cond_into cg (call node_next clause) base o)
    (call label_pop cg)
    (call put_op o OP_END)
    (call at_pop o))

  ;; ===== Expression / statement codegen =====
  ;; Compiles one expression, its position the innermost one while it is
  ;; compiled (for the line table).
  (fn compile_expr [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (when (eq node (ptr.null compiler.Node)) (call compile_expr_at cg node o) (return))
    (call at_push o (get node compiler.Node.pos))
    (call compile_expr_at cg node o)
    (call at_pop o))

  (fn compile_expr_at [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (when (eq node (ptr.null compiler.Node)) (call set_compile_error CgErr.empty_expression) (return))
    (let kind:compiler.Kind (call node_kind node))
    (cond
      ((eq kind compiler.Kind.int) (call emit_i32_const o (call int_node_value cg node)))
      ((eq kind compiler.Kind.bool) (call emit_i32_const o (call node_a node)))
      ((eq kind compiler.Kind.int64)
       (call put_op o OP_I64_CONST)
       (call put_s64 o (call parse_i64_literal cg (call node_a node) (call node_b node))))
      ((eq kind compiler.Kind.float) (call emit_f64_literal o cg (call node_a node) (call node_b node)))
      ((eq kind compiler.Kind.float32) (call emit_f32_literal o cg (call node_a node) (call node_b node)))
      ((eq kind compiler.Kind.string)
       (call emit_i32_const o (call find_interned_string cg (call node_a node) (call node_b node))))
      ((eq kind compiler.Kind.symbol)
       (let idx:i32 (call find_local cg (call node_a node) (call node_b node)))
       (if (eq idx -1)
           (block (call set_compile_error CgErr.unknown_symbol) (call emit_i32_const o 0))
           (call emit_get_slots o (call slot_of cg idx) (call local_width (call local_at cg idx)))))
      (else (call compile_group cg node o))))




  (fn compile_group [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let kw:Kw (call group_head_keyword cg node))
    (cond
      ((eq kw Kw.let) (call compile_let cg node o))
      ((eq kw Kw.set) (call compile_set cg node o))
      ((eq kw Kw.if) (call compile_valued cg node o))
      ((eq kw Kw.when) (call compile_when cg node o))
      ((eq kw Kw.loop) (call compile_loop_node cg node o))
      ((eq kw Kw.while) (call compile_loop_node cg node o))
      ((eq kw Kw.call) (call compile_call cg node o))
      ((eq kw Kw.block) (call compile_block cg node o))
      ((eq kw Kw.match_result) (call compile_valued cg node o))
      ((eq kw Kw.match) (call compile_valued cg node o))
      ((eq kw Kw.make) (call compile_make cg node o))
      ((eq kw Kw.with) (call compile_with cg node o))
      ((eq kw Kw.cond) (call compile_valued cg node o))
      ((neq kw Kw.none) (call compile_op cg kw node o))
      (else (call set_compile_error CgErr.unknown_form) (call emit_i32_const o 0))))




;; An if, cond, match, or match_result: one that yields a value struct
  ;; goes into its group, then pushes it.
  (fn compile_valued [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let kw:Kw (call group_head_keyword cg node))
    (if (call is_value_node cg node)
        (block
          (let g:i32 (call group_slot cg node false))
          (call compile_into cg node g o)
          (call emit_get_slots o g (call value_width cg node)))
        (cond
          ((eq kw Kw.if) (call compile_if cg node o))
          ((eq kw Kw.cond) (call compile_cond_from cg (call nth_child node 1) o))
          ((eq kw Kw.match) (call compile_match cg node -1 o))
          (else (call compile_match_result cg node -1 o)))))

  ;; (with v S.f x): v into its group, x over the field's locals, pushed.
  (fn compile_with [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let g:i32 (call group_slot cg node false))
    (let vs:(ptr StructInfo) (call ref_struct cg (call nth_child node 2)))
    (let f:(ptr Field) (call ref_field cg (call nth_child node 2)))
    (when (or (eq vs (ptr.null StructInfo)) (eq f (ptr.null Field))) (call set_compile_error CgErr.unknown_struct_or_field) (return))
    (let n:i32 (get vs StructInfo.width))
    (call compile_expr cg (call nth_child node 1) o)
    (call emit_set_slots o g n)
    (call compile_expr cg (call nth_child node 3) o)
    (call emit_set_slots o (+ g (get f Field.slot)) (call width (get f Field.ty) (get f Field.vs)))
    (call emit_get_slots o g n))

  ;; (match_result r (ok v ...) (err e ...)) (wasm.rs compile_match_result):
  ;; the result's tag picks the arm; its binder is its side's slots. With
  ;; dest (a local, else -1), a value struct result goes into the locals
  ;; from there (compile_into) and the if yields nothing.
  (fn compile_match_result [cg:(ptr Cg) node:(ptr compiler.Node) dest:i32 o:(ptr Out)] -> void
    (let expr_node:(ptr compiler.Node) (call nth_child node 1))
    (let ok_group:(ptr compiler.Node) (call nth_child node 2))
    (let err_group:(ptr compiler.Node) (call nth_child node 3))
    ;; a result is held by value: its tag and binders from its slots (a
    ;; variable's own locals, else its spill group)
    (let rvs:(ptr StructInfo) (call node_struct cg expr_node))
    (when (eq rvs (ptr.null StructInfo)) (call set_compile_error CgErr.table_full) (return))
    (let base:i32 0)
    (if (eq (call node_kind expr_node) compiler.Kind.symbol)
        (set! base (call node_slot cg expr_node))
        (block
          (set! base (call group_slot cg expr_node true))
          (call compile_expr cg expr_node o)
          (call emit_set_slots o base (get rvs StructInfo.width))))
    (call emit_local_get o base)
    (call put_op o OP_I32_EQZ)
    (let ok_last:(ptr compiler.Node) (call last_of (call mr_typed cg node)))
    (let is_void:bool (call is_void_node cg ok_last))
    (let block_ty:i32 64)
    (if (or is_void (gte dest 0)) (set! block_ty 64) (set! block_ty (call block_type_byte (call node_type cg ok_last))))
    (call put_op o OP_IF) (call put_byte o block_ty)
    (call label_push cg Label.if_else)
    (call slot_binder cg o (call nth_child ok_group 1) rvs 0 base)
    (call compile_arm_seq cg (call node_next (call node_next (call first_child ok_group))) dest o)
    (call seal_body cg (call node_next (call node_next (call first_child ok_group))) (and (neq block_ty 64) (lt dest 0)) o)
    (call put_op o OP_ELSE)
    (call slot_binder cg o (call nth_child err_group 1) rvs 1 base)
    (call compile_arm_seq cg (call node_next (call node_next (call first_child err_group))) dest o)
    (call seal_body cg (call node_next (call node_next (call first_child err_group))) (and (neq block_ty 64) (lt dest 0)) o)
    (call label_pop cg)
    (call put_op o OP_END))

  ;; A match_result binder of a result by value (described by rvs), side 0
  ;; (ok) or 1 (err), from the slots from `base`.
  (fn slot_binder [cg:(ptr Cg) o:(ptr Out) var:(ptr compiler.Node) rvs:(ptr StructInfo) side:i32 base:i32] -> void
    (let idx:i32 (call find_local cg (call node_a var) (call node_b var)))
    (when (eq idx -1) (return))
    (let v:(ptr VariantInfo) (arr.get (ptr VariantInfo) (get (get rvs StructInfo.union_of) UnionInfo.variants) side))
    (for q 0 (get v VariantInfo.nslots) (call emit_local_get o (+ base (arr.get i32 (get v VariantInfo.slots) q))))
    (call emit_set_slots o (call slot_of cg idx) (get v VariantInfo.nslots)))

  ;; A match_result arm's body: its last expression left as the if's value,
  ;; or into dest (if not -1).
  (fn compile_arm_seq [cg:(ptr Cg) first:(ptr compiler.Node) dest:i32 o:(ptr Out)] -> void
    (if (gte dest 0)
        (call compile_body_into cg first dest o)
        (call compile_stmt_seq cg first o)))



  ;; (make U.v args...) (wasm.rs compile_make): claim the variant's cell
  ;; before evaluating the fields, push its address once per store plus once
  ;; for the result, then store the tag and each field.
  ;; (make S args...) of a value struct: its fields' scalars, in order.
  (fn compile_make [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let target:(ptr compiler.Node) (call nth_child node 1))
    (let mu:(ptr UnionInfo) (call make_union cg node))
    (when (neq mu (ptr.null UnionInfo)) (call compile_value_make cg node mu o) (return))
    (when (neq (call record_struct cg node) (ptr.null StructInfo))
          (let a:(ptr compiler.Node) (call node_next target))
          (while (neq a (ptr.null compiler.Node))
            (call compile_expr cg a o)
            (set! a (call node_next a)))
          (return))
    ;; a union is a value (AIPL_SPEC.md 4.J): an unknown variant
    (call set_compile_error CgErr.unknown_variant)
    (call emit_i32_const o 0))

  ;; (make U.v args...), a union (a value; wasm.rs
  ;; compile_value_make): into its group, the tag, each field's scalars in
  ;; their slots, zero in the slots v does not use; then the group pushed.
  (fn compile_value_make [cg:(ptr Cg) node:(ptr compiler.Node) u:(ptr UnionInfo) o:(ptr Out)] -> void
    (let target:(ptr compiler.Node) (call nth_child node 1))
    (let g:i32 (call group_slot cg node false))
    (let v:(ptr VariantInfo) (call find_variant cg target))
    (when (eq v (ptr.null VariantInfo)) (call set_compile_error CgErr.unknown_variant) (return))
    (let vs:(ptr StructInfo) (get u UnionInfo.vs))
    (call emit_i32_const o (call variant_index cg target))
    (call emit_local_set o g)
    (let at:i32 0)
    (let arg:(ptr compiler.Node) (call node_next target))
    (for k 0 (get v VariantInfo.nfields)
      (let f:(ptr Field) (arr.get (ptr Field) (get v VariantInfo.fields) k))
      (call compile_expr cg arg o)
      (let w:i32 (call width (get f Field.ty) (get f Field.vs)))
      (for q 1 (+ w 1) (call emit_local_set o (+ g (arr.get i32 (get v VariantInfo.slots) (- (+ at w) q)))))
      (set! at (+ at w))
      (set! arg (call node_next arg)))
    (for slot 1 (get vs StructInfo.width)
      (when (not (call uses_slot v slot))
            (call emit_zero o (arr.get Ty (get vs StructInfo.flat_ty) slot))
            (call emit_local_set o (+ g slot))))
    (call emit_get_slots o g (get vs StructInfo.width)))

  (fn uses_slot [v:(ptr VariantInfo) slot:i32] -> bool
    (for j 0 (get v VariantInfo.nslots) (when (eq (arr.get i32 (get v VariantInfo.slots) j) slot) (return true)))
    false)

  ;; A zero of scalar type t (wasm.rs emit_zero).
  (fn emit_zero [o:(ptr Out) t:Ty] -> void
    (cond
      ((eq t Ty.i64) (call put_op o OP_I64_CONST) (call put_s64 o 0i64))
      ((eq t Ty.f32) (call put_op o OP_F32_CONST) (for b 1 5 (call put_byte o 0)))
      ((eq t Ty.f64) (call put_op o OP_F64_CONST) (for b 1 9 (call put_byte o 0)))
      (else (call emit_i32_const o 0))))

  ;; The union held by value an expression is, or null.
  (fn matched_union [cg:(ptr Cg) e:(ptr compiler.Node)] -> (ptr UnionInfo)
    (when (not (call is_value_node cg e)) (return (ptr.null UnionInfo)))
    (let vs:(ptr StructInfo) (call node_struct cg e))
    (if (or (eq vs (ptr.null StructInfo)) (get vs StructInfo.result)) (ptr.null UnionInfo) (get vs StructInfo.union_of)))

  ;; (match v arms...) of a union held by value (wasm.rs compile_match): the
  ;; tag and the binders from its slots (a variable's own locals, else its
  ;; spill group).
  (fn compile_value_match [cg:(ptr Cg) node:(ptr compiler.Node) u:(ptr UnionInfo) block_ty:i32 dest:i32 o:(ptr Out)] -> void
    (let sv:(ptr compiler.Node) (call nth_child node 1))
    (let width:i32 (get (get u UnionInfo.vs) StructInfo.width))
    (let base:i32 0)
    (if (eq (call node_kind sv) compiler.Kind.symbol)
        (set! base (call node_slot cg sv))
        (block
          (set! base (call group_slot cg sv true))
          (call compile_expr cg sv o)
          (call emit_set_slots o base width)))
    (let arm:(ptr compiler.Node) (call nth_child node 2))
    (let opened:i32 0)
    (let has_else:bool false)
    (while (neq arm (ptr.null compiler.Node))
      (let head:(ptr compiler.Node) (call first_child arm))
      (if (eq (call group_head_keyword cg arm) Kw.else)
          (block
            (set! has_else true)
            (call compile_arm_body cg (call arm_body arm) block_ty dest o))
          (block
            (let v:(ptr VariantInfo) (call find_variant cg head))
            (when (eq v (ptr.null VariantInfo)) (call set_compile_error CgErr.unknown_variant) (return))
            (call emit_local_get o base)
            (call emit_i32_const o (call variant_index cg head))
            (call put_op o OP_I32_EQ)
            (call put_op o OP_IF)
            (call put_byte o block_ty)
            (call label_push cg Label.if_else)
            (set! opened (+ opened 1))
            (let binders:(ptr compiler.Node) (call node_next head))
            (let b:(ptr compiler.Node) (if (eq (call node_kind binders) compiler.Kind.bracket) (call first_child binders) (ptr.null compiler.Node)))
            (let at:i32 0)
            (for k 0 (get v VariantInfo.nfields)
              (let f:(ptr Field) (arr.get (ptr Field) (get v VariantInfo.fields) k))
              (let w:i32 (call width (get f Field.ty) (get f Field.vs)))
              (when (and (neq b (ptr.null compiler.Node)) (not (call is_wildcard cg b)))
                    (for q 0 w (call emit_local_get o (+ base (arr.get i32 (get v VariantInfo.slots) (+ at q)))))
                    (call emit_set_slots o (call node_slot cg b) w))
              (set! at (+ at w))
              (when (neq b (ptr.null compiler.Node)) (set! b (call node_next b))))
            (call compile_arm_body cg (call arm_body arm) block_ty dest o)
            (call put_op o OP_ELSE)))
      (set! arm (call node_next arm)))
    (when (not has_else) (call put_op o OP_UNREACHABLE))
    (for k 1 (+ opened 1)
      (call label_pop cg)
      (call put_op o OP_END)))

  ;; (match v arms... [(else ...)]) (wasm.rs compile_match): v goes to the
  ;; scratch local; each arm tests it in turn in an if/else chain (a union
  ;; arm the tag at offset 0, an enum arm, whose head consts.aipl made a
  ;; number, the value) and a union arm first loads its binders. The chain
  ;; ends in the else body or `unreachable`.
  ;; With dest (a local, else -1), a value struct result goes into the
  ;; locals from there (compile_into) and the ifs yield nothing.
  (fn compile_match [cg:(ptr Cg) node:(ptr compiler.Node) dest:i32 o:(ptr Out)] -> void
    (let scratch:i32 (get cg Cg.scratch))
    (let first_arm:(ptr compiler.Node) (call nth_child node 2))
    (let last:(ptr compiler.Node) (call last_of (call match_typed cg node)))
    (let block_ty:i32 BLOCK_EMPTY)
    (when (not (or (or (eq last (ptr.null compiler.Node)) (gte dest 0)) (call is_void_node cg last))) (set! block_ty (call block_type_byte (call node_type cg last))))
    (let mu:(ptr UnionInfo) (call matched_union cg (call nth_child node 1)))
    (when (neq mu (ptr.null UnionInfo)) (call compile_value_match cg node mu block_ty dest o) (return))
    (call compile_expr cg (call nth_child node 1) o)
    (call emit_local_set o scratch)
    (let arm:(ptr compiler.Node) first_arm)
    (let opened:i32 0)
    (let has_else:bool false)
    (while (neq arm (ptr.null compiler.Node))
      (let head:(ptr compiler.Node) (call first_child arm))
      (if (eq (call group_head_keyword cg arm) Kw.else)
          (block
            (set! has_else true)
            (call compile_arm_body cg (call arm_body arm) block_ty dest o))
          (block
            (call emit_local_get o scratch)
            ;; an enum member, a number by now (a union's arms are
            ;; compile_value_match's)
            (if (eq (call node_kind head) compiler.Kind.int)
                (call emit_i32_const o (call int_node_value cg head))
                (block (call set_compile_error CgErr.unknown_variant) (call emit_i32_const o 0)))
            (call put_op o OP_I32_EQ)
            (call put_op o OP_IF)
            (call put_byte o block_ty)
            (call label_push cg Label.if_else)
            (set! opened (+ opened 1))
            (call compile_arm_body cg (call arm_body arm) block_ty dest o)
            (call put_op o OP_ELSE)))
      (set! arm (call node_next arm)))
    (when (not has_else) (call put_op o OP_UNREACHABLE))
    (for k 1 (+ opened 1)
      (call label_pop cg)
      (call put_op o OP_END)))

  ;; An arm's body: every expression but a valued match's last is a
  ;; statement; with dest (not -1), the last goes into the locals from there.
  (fn compile_arm_body [cg:(ptr Cg) first:(ptr compiler.Node) block_ty:i32 dest:i32 o:(ptr Out)] -> void
    (cond
      ((gte dest 0) (call compile_body_into cg first dest o))
      ((eq block_ty BLOCK_EMPTY) (call compile_all_stmts cg first o))
      (else (call compile_stmt_seq cg first o) (call seal_body cg first true o))))

  ;; The address of runtime cell `cell` (64-87): the cell itself, or in a
  ;; threaded module the same offset in this thread's block (global 0).
  (fn emit_rt [cg:(ptr Cg) o:(ptr Out) cell:i32] -> void
    (if (call threaded cg)
        (block
          (call put_op o OP_GLOBAL_GET) ;; global.get 0
          (call put_byte o 0)
          (when (neq cell 64)
                (call emit_i32_const o (- cell 64))
                (call put_op o OP_I32_ADD)))
        (call emit_i32_const o cell)))




  ;; With a WASI errno on the stack: minus it if it is non-zero, else the i32
  ;; at out_cell (or 0 without one); held in the index scratch local
  ;; (wasm.rs emit_errno_to_result).
  (fn emit_errno_to_result [cg:(ptr Cg) o:(ptr Out) out_cell:i32] -> void
    (let e:i32 (+ (get cg Cg.scratch) 1))
    (call emit_local_tee o e)
    (call put_op o OP_IF) (call put_byte o VT_I32)
    (call emit_i32_const o 0)
    (call emit_local_get o e)
    (call put_op o OP_I32_SUB)
    (call put_op o OP_ELSE)
    (if (gte out_cell 0)
        (block
          (call emit_rt cg o out_cell)
          (call emit_memop o OP_I32_LOAD 2))
        (call emit_i32_const o 0))
    (call put_op o OP_END))



;; With a condition on the stack: if it holds, trap with "integer overflow"
  ;; (i32.div_s of MIN by -1, which wasm defines to trap with that reason).
  (fn emit_overflow_trap_if [o:(ptr Out)] -> void
    (call put_op o OP_IF) (call put_byte o BLOCK_EMPTY)
    (call emit_i32_const o -2147483648)
    (call emit_i32_const o -1)
    (call put_op o OP_I32_DIV_S)
    (call put_op o OP_DROP)
    (call put_op o OP_END))

  ;; checked.add/sub/mul (wasm.rs compile_checked): the operation, then a trap
  ;; if it overflowed. i32: computed exactly in i64, trapped unless it fits.
  ;; i64 add/sub: the sign test; i64 mul: r / a must be b when a != 0. Both
  ;; operands are evaluated before the hidden locals are written.
  (fn compile_checked [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out) op:Kw] -> void
    (let a:i32 (call slot_of cg (call find_hidden cg 0 0 Ty.ck_a)))
    (let b:i32 (call slot_of cg (call find_hidden cg 0 0 Ty.ck_b)))
    (let r:i32 (call slot_of cg (call find_hidden cg 0 0 Ty.ck_r)))
    (let wide_op:i32 (cond ((eq op Kw.checked_add) OP_I64_ADD) ((eq op Kw.checked_sub) OP_I64_SUB) (else OP_I64_MUL)))
    (when (eq (call node_type cg (call nth_child node 1)) Ty.i32)
          (call compile_expr cg (call nth_child node 1) o)
          (call put_op o OP_I64_EXTEND_I32_S)
          (call compile_expr cg (call nth_child node 2) o)
          (call put_op o OP_I64_EXTEND_I32_S)
          (call put_op o wide_op)
          (call emit_local_tee o r)
          (call put_op o OP_I64_CONST) (call put_s64 o 2147483648i64)
          (call put_op o OP_I64_ADD)
          (call put_op o OP_I64_CONST) (call put_s64 o 4294967296i64)
          (call put_op o OP_I64_GE_U)
          (call emit_overflow_trap_if o)
          (call emit_local_get o r)
          (call put_op o OP_I32_WRAP_I64)
          (return))
    (call compile_expr cg (call nth_child node 1) o)
    (call compile_expr cg (call nth_child node 2) o)
    (call emit_local_set o b)
    (call emit_local_set o a)
    (call emit_local_get o a)
    (call emit_local_get o b)
    (call put_op o wide_op)
    (call emit_local_set o r)
    (if (eq op Kw.checked_mul)
        (block
          (call emit_local_get o a)
          (call put_op o OP_I64_CONST) (call put_s64 o 0i64)
          (call put_op o OP_I64_NE)
          (call put_op o OP_IF) (call put_byte o BLOCK_EMPTY)
          (call emit_local_get o r)
          (call emit_local_get o a)
          (call put_op o OP_I64_DIV_S)
          (call emit_local_get o b)
          (call put_op o OP_I64_NE)
          (call emit_overflow_trap_if o)
          (call put_op o OP_END))
        (block
          ;; add: (a ^ r) & (b ^ r) < 0; sub: (a ^ b) & (a ^ r) < 0
          (let add:bool (eq op Kw.checked_add))
          (call emit_local_get o a)
          (call emit_local_get o (if add r b))
          (call put_op o OP_I64_XOR)
          (call emit_local_get o (if add b a))
          (call emit_local_get o r)
          (call put_op o OP_I64_XOR)
          (call put_op o OP_I64_AND)
          (call put_op o OP_I64_CONST) (call put_s64 o 0i64)
          (call put_op o OP_I64_LT_S)
          (call emit_overflow_trap_if o)))
    (call emit_local_get o r))

  (fn compile_op [cg:(ptr Cg) op_id:Kw node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let import_cnt:i32 (get cg Cg.nimports))
    (let io_a:i32 (+ (get cg Cg.scratch) 3))
    (let io_b:i32 (+ (get cg Cg.scratch) 4))
    (let done:bool false)
    (when (call is_checked op_id) (call compile_checked cg node o op_id) (set! done true))

    (when (eq op_id Kw.mem_load8) (call compile_expr cg (call nth_child node 1) o) (call emit_memop o OP_I32_LOAD8_U 0) (set! done true))
    (when (eq op_id Kw.mem_load32) (call compile_expr cg (call nth_child node 1) o) (call emit_memop o OP_I32_LOAD 2) (set! done true))
    (when (eq op_id Kw.mem_load64) (call compile_expr cg (call nth_child node 1) o) (call emit_memop o OP_I64_LOAD 3) (set! done true))
    (when (eq op_id Kw.mem_store8) (call compile_expr cg (call nth_child node 1) o) (call emit_store_guard cg o (get cg Cg.scratch)) (call compile_expr cg (call nth_child node 2) o) (call emit_memop o OP_I32_STORE8 0) (set! done true))
    (when (eq op_id Kw.mem_load8_s) (call compile_expr cg (call nth_child node 1) o) (call emit_memop o 44 0) (set! done true))
    (when (eq op_id Kw.mem_load16_u) (call compile_expr cg (call nth_child node 1) o) (call emit_memop o 47 1) (set! done true))
    (when (eq op_id Kw.mem_load16_s) (call compile_expr cg (call nth_child node 1) o) (call emit_memop o 46 1) (set! done true))
    (when (eq op_id Kw.mem_store16) (call compile_expr cg (call nth_child node 1) o) (call emit_store_guard cg o (get cg Cg.scratch)) (call compile_expr cg (call nth_child node 2) o) (call emit_memop o 59 1) (set! done true))
    (when (eq op_id Kw.mem_store32) (call compile_expr cg (call nth_child node 1) o) (call emit_store_guard cg o (get cg Cg.scratch)) (call compile_expr cg (call nth_child node 2) o) (call emit_memop o OP_I32_STORE 2) (set! done true))
    (when (eq op_id Kw.mem_store64) (call compile_expr cg (call nth_child node 1) o) (call emit_store_guard cg o (get cg Cg.scratch)) (call compile_expr cg (call nth_child node 2) o) (call emit_memop o OP_I64_STORE 3) (set! done true))
    (when (eq op_id Kw.not) (call compile_expr cg (call nth_child node 1) o) (call put_op o OP_I32_EQZ) (set! done true))
    (when (eq op_id Kw.str_len)
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_i32_const o 4)
          (call put_op o OP_I32_SUB)
          (call emit_memop o OP_I32_LOAD 2)
          (set! done true))
    (when (eq op_id Kw.str_ptr) (call compile_expr cg (call nth_child node 1) o) (set! done true))
    (when (eq op_id Kw.sys_print)
          (let arg:(ptr compiler.Node) (call node_next (call first_child node)))
          (while (neq arg (ptr.null compiler.Node))
            (call compile_expr cg arg o)
            (call emit_local_set o (get cg Cg.scratch))
            ;; iov0 = { ptr, len }
            (call emit_rt cg o 64)
            (call emit_local_get o (get cg Cg.scratch))
            (call emit_memop o OP_I32_STORE 2)
            (call emit_rt cg o 68)
            (call emit_local_get o (get cg Cg.scratch))
            (call emit_i32_const o 4)
            (call put_op o OP_I32_SUB) ;; sub
            (call emit_memop o OP_I32_LOAD 2) ;; load
            (call emit_memop o OP_I32_STORE 2)
            ;; iov1 = { "\n", 1 }
            (let nl_addr:i32 (get cg Cg.newline))
            (call emit_rt cg o 72)
            (call emit_i32_const o nl_addr)
            (call emit_memop o OP_I32_STORE 2)
            (call emit_rt cg o 76)
            (call emit_i32_const o 1)
            (call emit_memop o OP_I32_STORE 2)
            ;; Call fd_write (1, iovs=64, iovs_len=1, nwritten=80)
            (call emit_i32_const o 1)
            (call emit_rt cg o 64)
            (call emit_i32_const o 1)
            (call emit_rt cg o 80)
            (call emit_call o (call get_wasi_index cg Wasi.fd_write))
            (call put_op o OP_DROP) ;; drop
            ;; Call fd_write (1, iovs=72, iovs_len=1, nwritten=80)
            (call emit_i32_const o 1)
            (call emit_rt cg o 72)
            (call emit_i32_const o 1)
            (call emit_rt cg o 80)
            (call emit_call o (call get_wasi_index cg Wasi.fd_write))
            (call put_op o OP_DROP) ;; drop
            
            (set! arg (call node_next arg)))
          (set! done true))
    (when (eq op_id Kw.sys_exit)
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_call o (call get_wasi_index cg Wasi.proc_exit)) (set! done true))
    (when (eq op_id Kw.fs_open)
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call compile_expr cg (call nth_child node 3) o)
          (call emit_local_set o io_b)
          (call emit_local_set o io_a)
          (call emit_local_set o (get cg Cg.scratch))
          (call emit_path_dir o (get cg Cg.scratch) io_a)
          ;; dirflags = 0
          (call emit_i32_const o 0)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_local_get o io_a)
          ;; oflags
          (call emit_local_get o io_b)
          (call put_op o OP_IF) (call put_byte o VT_I32) ;; if(i32)
          (call emit_i32_const o 9) ;; CREAT|TRUNC (1|8 = 9)
          (call put_op o OP_ELSE)
          (call emit_i32_const o 0)
          (call put_op o OP_END)
          ;; fs_rights_base (i64)
          (call emit_local_get o io_b)
          (call put_op o OP_IF) (call put_byte o VT_I64) ;; if(i64)
          (call put_op o OP_I64_CONST) ;; i64.const 66 (2|64 = 66)
          (call put_s32 o 66)
          (call put_op o OP_ELSE)
          (call put_op o OP_I64_CONST) ;; i64.const 2
          (call put_s32 o 2)
          (call put_op o OP_END)
          ;; fs_rights_inheriting (i64) = 0
          (call put_op o OP_I64_CONST) ;; i64.const 0
          (call put_s32 o 0)
          ;; fdflags = 0
          (call emit_i32_const o 0)
          ;; out_fd cell RT_OPENED_FD = 84
          (call emit_rt cg o 84)
          (call emit_call o (call get_wasi_index cg Wasi.path_open))
          (call emit_errno_to_result cg o 84)
          (set! done true))
    (when (eq op_id Kw.fs_opendir)
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_local_set o io_a)
          (call emit_local_set o (get cg Cg.scratch))
          (call emit_path_dir o (get cg Cg.scratch) io_a)
          (call emit_i32_const o 0) ;; dirflags
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_local_get o io_a)
          (call emit_i32_const o 2) ;; oflags DIRECTORY
          (call put_op o OP_I64_CONST) (call put_s32 o 16384) ;; rights: FD_READDIR
          (call put_op o OP_I64_CONST) (call put_s32 o 0)
          (call emit_i32_const o 0) ;; fdflags
          (call emit_rt cg o 84)
          (call emit_call o (call get_wasi_index cg Wasi.path_open))
          (call emit_errno_to_result cg o 84)
          (set! done true))
    (when (eq op_id Kw.fs_readdir)
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call compile_expr cg (call nth_child node 3) o)
          (call compile_expr cg (call nth_child node 4) o)
          (call emit_rt cg o 80)
          (call emit_call o (call get_wasi_index cg Wasi.fd_readdir))
          (call emit_errno_to_result cg o 80)
          (set! done true))
    (when (eq op_id Kw.fs_stat)
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call compile_expr cg (call nth_child node 3) o)
          (call emit_local_set o io_b)
          (call emit_local_set o io_a)
          (call emit_local_set o (get cg Cg.scratch))
          (call emit_path_dir o (get cg Cg.scratch) io_a)
          (call emit_i32_const o 1)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_local_get o io_a)
          (call emit_local_get o io_b)
          (call emit_call o (call get_wasi_index cg Wasi.path_filestat_get))
          (call emit_errno_to_result cg o -1)
          (set! done true))
    (when (eq op_id Kw.fs_chmod)
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call compile_expr cg (call nth_child node 3) o)
          (call emit_local_set o io_b)
          (call emit_local_set o io_a)
          (call emit_local_set o (get cg Cg.scratch))
          (call emit_path_dir o (get cg Cg.scratch) io_a)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_local_get o io_a)
          (call emit_local_get o io_b)
          (call emit_call o (call get_wasi_index cg Wasi.sys_chmod))
          (set! done true))
    (when (eq op_id Kw.fs_read)
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call compile_expr cg (call nth_child node 3) o)
          (call emit_local_set o io_b)
          (call emit_local_set o io_a)
          (call emit_local_set o (get cg Cg.scratch))
          ;; iov0: RT_IOV0_BUF = 64
          (call emit_rt cg o 64)
          (call emit_local_get o io_a)
          (call emit_memop o OP_I32_STORE 2)
          ;; iov0: RT_IOV0_LEN = 68
          (call emit_rt cg o 68)
          (call emit_local_get o io_b)
          (call emit_memop o OP_I32_STORE 2)
          ;; call fd_read(fd, iovs=64, iovs_len=1, nread=80)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_rt cg o 64)
          (call emit_i32_const o 1)
          (call emit_rt cg o 80)
          (call emit_call o (call get_wasi_index cg Wasi.fd_read))
          (call emit_errno_to_result cg o 80)
          (set! done true))
    (when (eq op_id Kw.fs_write)
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call compile_expr cg (call nth_child node 3) o)
          (call emit_local_set o io_b)
          (call emit_local_set o io_a)
          (call emit_local_set o (get cg Cg.scratch))
          ;; iov0: RT_IOV0_BUF = 64
          (call emit_rt cg o 64)
          (call emit_local_get o io_a)
          (call emit_memop o OP_I32_STORE 2)
          ;; iov0: RT_IOV0_LEN = 68
          (call emit_rt cg o 68)
          (call emit_local_get o io_b)
          (call emit_memop o OP_I32_STORE 2)
          ;; call fd_write(fd, iovs=64, iovs_len=1, nwritten=80)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_rt cg o 64)
          (call emit_i32_const o 1)
          (call emit_rt cg o 80)
          (call emit_call o (call get_wasi_index cg Wasi.fd_write))
          (call emit_errno_to_result cg o 80)
          (set! done true))
    (when (eq op_id Kw.fs_close)
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_call o (call get_wasi_index cg Wasi.fd_close))
          (call emit_errno_to_result cg o -1)
          (set! done true))
    (when (neq (call proc_wasi op_id) Wasi.none)
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_call o (call get_wasi_index cg (call proc_wasi op_id)))
          (call emit_errno_to_result cg o -1)
          (set! done true))
    (when (eq op_id Kw.fs_delete)
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_local_set o io_a)
          (call emit_local_set o (get cg Cg.scratch))
          (call emit_path_dir o (get cg Cg.scratch) io_a)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_local_get o io_a)
          (call emit_call o (call get_wasi_index cg Wasi.path_unlink_file))
          (call emit_errno_to_result cg o -1)
          (set! done true))
    (when (eq op_id Kw.mem_alloc)
          (call emit_i32_const o 0)
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_round8 o)
          (call emit_rmw_add o)
          (call emit_grow_or_stop o (+ (get cg Cg.checks_base) 7))
          (set! done true))
    (when (eq op_id Kw.mem_grow)
          (call compile_expr cg (call nth_child node 1) o)
          (call put_op o OP_MEMORY_GROW)
          (call put_byte o 0)
          (set! done true))
    (when (eq op_id Kw.i64_extend_s) (call compile_expr cg (call nth_child node 1) o) (call put_op o OP_I64_EXTEND_I32_S) (set! done true))
    (when (eq op_id Kw.i64_extend_u) (call compile_expr cg (call nth_child node 1) o) (call put_op o OP_I64_EXTEND_I32_U) (set! done true))
    (when (eq op_id Kw.i32_wrap) (call compile_expr cg (call nth_child node 1) o) (call put_op o OP_I32_WRAP_I64) (set! done true))
    (when (eq op_id Kw.f64_convert_i64_s) (call compile_expr cg (call nth_child node 1) o) (call put_op o OP_F64_CONVERT_I64_S) (set! done true))
    (when (call is_conversion op_id) (call compile_expr cg (call nth_child node 1) o) (call put_op o (call conversion_opcode op_id)) (set! done true))
    (when (eq op_id Kw.f64_sqrt) (call compile_expr cg (call nth_child node 1) o) (call put_op o OP_F64_SQRT) (set! done true))
    (when (eq op_id Kw.i64_trunc_f64_s) (call compile_expr cg (call nth_child node 1) o) (call put_op o OP_I64_TRUNC_F64_S) (set! done true))
    (when (eq op_id Kw.f64_reinterpret_i64) (call compile_expr cg (call nth_child node 1) o) (call put_op o OP_F64_REINTERPRET_I64) (set! done true))
    (when (eq op_id Kw.i64_reinterpret_f64) (call compile_expr cg (call nth_child node 1) o) (call put_op o OP_I64_REINTERPRET_F64) (set! done true))
    (when (or (eq op_id Kw.ptr_null) (eq op_id Kw.arr_null)) (call put_op o OP_I64_CONST) (call put_s64 o 0i64) (set! done true))
    (when (or (eq op_id Kw.ptr_cast) (eq op_id Kw.arr_cast))
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_local_tee o (get cg Cg.scratch))
          (call put_op o OP_I32_EQZ)
          (call put_op o OP_IF) (call put_byte o VT_I64)
          (call put_op o OP_I64_CONST) (call put_s64 o 0i64)
          (call put_op o OP_ELSE)
          (call emit_local_get o (get cg Cg.scratch))
          (call put_op o OP_I64_EXTEND_I32_U)
          (call put_op o OP_I64_CONST) (call put_s64 o -4294967296i64)
          (call put_op o OP_I64_OR)
          (call put_op o OP_END)
          (set! done true))
    (when (or (eq op_id Kw.ptr_make) (eq op_id Kw.arr_make))
          (call compile_expr cg (call nth_child node 2) o)
          (call put_op o OP_I64_EXTEND_I32_U)
          (call compile_expr cg (call nth_child node 3) o)
          (call put_op o OP_I64_EXTEND_I32_U)
          (call put_op o OP_I64_CONST) (call put_s64 o 32i64)
          (call put_op o OP_I64_SHL)
          (call put_op o OP_I64_OR)
          (set! done true))
    (when (or (eq op_id Kw.ptr_addr) (eq op_id Kw.arr_addr)) (call compile_expr cg (call nth_child node 1) o) (call put_op o OP_I32_WRAP_I64) (set! done true))
    (when (or (eq op_id Kw.ptr_gen) (eq op_id Kw.arr_gen))
          (call compile_expr cg (call nth_child node 1) o)
          (call put_op o OP_I64_CONST) (call put_s64 o 32i64)
          (call put_op o OP_I64_SHR_U)
          (call put_op o OP_I32_WRAP_I64)
          (set! done true))
    (when (eq op_id Kw.arr_len)
          (call compile_pointer cg (call nth_child node 1) o)
          (call emit_i32_const o 4)
          (call put_op o OP_I32_SUB)
          (call emit_memop o OP_I32_LOAD 2) (set! done true))
    (when (eq op_id Kw.ref)
          (let fname:(ptr compiler.Node) (call nth_child node 1))
          (let fidx:i32 (call find_function cg (call node_a fname) (call node_b fname)))
          (if (eq fidx -1) (call set_compile_error CgErr.undefined_function) 0)
          (call emit_i32_const o fidx) (set! done true))
    (when (eq op_id Kw.call_ref)
          (let arg:(ptr compiler.Node) (call nth_child node 3))
          (while (neq arg (ptr.null compiler.Node))
            (call compile_expr cg arg o)
            (set! arg (call node_next arg)))
          (call compile_expr cg (call nth_child node 2) o)
          (call put_op o OP_CALL_INDIRECT)
          (let tidx:i32 (+ (get cg Cg.nimports) (+ (get cg Cg.nfns) (call sig_index cg (call nth_child node 1)))))
          (call put_u32 o tidx)
          (call put_byte o 0)
          (set! done true))
    (when (eq op_id Kw.return)
          (when (neq (call nth_child node 1) (ptr.null compiler.Node))
                (call compile_expr cg (call nth_child node 1) o)
                ;; with ens, a value struct waits in res (the body's block yields nothing)
                (when (and (get cg Cg.ens_block) (call is_value_node cg (call nth_child node 1)))
                    (call emit_set_slots o (call local_slot cg (- (str.ptr "res") (get cg Cg.src)) 3) (call value_width cg (call nth_child node 1)))))
          (if (get cg Cg.ens_block)
              ;; to the end of the function's body block, where ens is checked
              (block (call put_op o OP_BR) (call put_u32 o (- (get cg Cg.nlabels) 1)))
              (call put_op o OP_RETURN))
          (set! done true))
    (when (eq op_id Kw.break)
          (call put_op o OP_BR)
          (call put_u32 o (call label_depth cg Label.loop_exit Label.loop_exit)) (set! done true))
    (when (eq op_id Kw.continue)
          (call put_op o OP_BR)
          (call put_u32 o (call label_depth cg Label.loop_header Label.loop_body)) (set! done true))
    (when (eq op_id Kw.ok) (call compile_value_result cg node 0 o) (set! done true))
    (when (eq op_id Kw.err) (call compile_value_result cg node 1 o) (set! done true))
    (when (eq op_id Kw.get)
          (let ptr_node:(ptr compiler.Node) (call nth_child node 1))
          (let sf_node:(ptr compiler.Node) (call last_child node))
          (let sf_pos:i32 (call node_a sf_node))
          (let sf_len:i32 (call node_b sf_node))
          (let dot_idx:i32 (call find_last_char cg sf_pos sf_len 46))
          (let f_offset:i32 (call get_field_offset cg sf_pos dot_idx (+ sf_pos (+ dot_idx 1)) (- sf_len (+ dot_idx 1))))
          (let ftype:Ty (call get_field_type cg sf_pos dot_idx (+ sf_pos (+ dot_idx 1)) (- sf_len (+ dot_idx 1))))
          ;; from a value struct (a path included), or of one: a value read
          (when (or (eq ftype Ty.value) (call reads_value cg node)) (call compile_value_read cg node o) (return))
          (call compile_pointer cg ptr_node o)
          (call emit_memop_offset o (call load_opcode ftype) (call mem_align ftype) f_offset)
          (when (eq ftype Ty.bool)
              (call emit_normalize_bool o))
          (set! done true))
    (when (eq op_id Kw.put)
          (let ptr_node:(ptr compiler.Node) (call nth_child node 1))
          (let sf_node:(ptr compiler.Node) (call nth_child node 2))
          (let val_node:(ptr compiler.Node) (call nth_child node 3))
          (let sf_pos:i32 (call node_a sf_node))
          (let sf_len:i32 (call node_b sf_node))
          (let dot_idx:i32 (call find_last_char cg sf_pos sf_len 46))
          (let f_offset:i32 (call get_field_offset cg sf_pos dot_idx (+ sf_pos (+ dot_idx 1)) (- sf_len (+ dot_idx 1))))
          ;; a path: one field of the value held inline, further on
          (let tg:(ptr Target) (call put_target cg node))
          (let ftype:Ty (get tg Target.ty))
          (set! f_offset (get tg Target.offset))
          (set! val_node (call last_child node))
          (call compile_pointer cg ptr_node o)
          (call emit_store_guard cg o (get cg Cg.scratch))
          (when (eq ftype Ty.value) (call emit_store_value cg o (get tg Target.vs) f_offset val_node) (return))
          (call compile_expr cg val_node o)
          (call emit_memop_offset o (call store_opcode ftype) (call mem_align ftype) f_offset)
          (set! done true))
    (when (eq op_id Kw.sizeof)
          (let snode:(ptr compiler.Node) (call nth_child node 1))
          (let is_struct:bool (and (eq (call node_kind snode) compiler.Kind.symbol)
                                   (and (eq (call ty_of_kw (call classify_keyword cg (call node_a snode) (call node_b snode))) Ty.none)
                                        (eq (call find_union cg (call node_a snode) (call node_b snode)) (ptr.null UnionInfo)))))
          (let size:i32 (if is_struct
                            (call get_struct_size cg (call node_a snode) (call node_b snode))
                            (call ty_size (call elem_type_id cg snode) (call type_node_struct cg snode))))
          (call emit_i32_const o size) (set! done true))
    (when (eq op_id Kw.arr_get)
          (let etype:Ty (call elem_type_id cg (call nth_child node 1)))
          ;; a path: a read from the element
          (when (neq (call nth_child node 4) (ptr.null compiler.Node)) (call compile_value_read cg node o) (return))
          (call emit_element_address cg o (call nth_child node 1) (call nth_child node 2) (call nth_child node 3))
          (when (eq etype Ty.value)
                (call emit_local_set o (get cg Cg.scratch))
                (call emit_load_scalars cg o etype (call type_node_struct cg (call nth_child node 1)) 0)
                (return))
          (call emit_memop o (call load_opcode etype) (call mem_align etype))
          (when (eq etype Ty.bool)
              (call emit_normalize_bool o))
          (set! done true))
    (when (eq op_id Kw.arr_set)
          (let etype:Ty (call elem_type_id cg (call nth_child node 1)))
          (let val_node:(ptr compiler.Node) (call last_child node))
          (call emit_element_address cg o (call nth_child node 1) (call nth_child node 2) (call nth_child node 3))
          (call emit_store_guard cg o (get cg Cg.scratch))
          ;; a path: one field of the element, further on
          (let tg:(ptr Target) (call arr_set_target cg node))
          (when (eq (get tg Target.ty) Ty.value) (call emit_store_value cg o (get tg Target.vs) (get tg Target.offset) val_node) (return))
          (call compile_expr cg val_node o)
          (when (neq (call nth_child node 4) val_node)
                (call emit_memop_offset o (call store_opcode (get tg Target.ty)) (call mem_align (get tg Target.ty)) (get tg Target.offset))
                (return))
          (call emit_memop o (call store_opcode etype) (call mem_align etype))
          (set! done true))

    (when (eq op_id Kw.atomic_add)
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_store_guard cg o (get cg Cg.scratch))
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_atomic o ATOMIC_RMW_ADD)
          (set! done true))
    (when (eq op_id Kw.atomic_cas)
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_store_guard cg o (get cg Cg.scratch))
          (call compile_expr cg (call nth_child node 2) o)
          (call compile_expr cg (call nth_child node 3) o)
          (call emit_local_set o io_b)
          (call emit_local_set o io_a)
          (call emit_local_get o io_a)
          (call emit_local_get o io_b)
          (call emit_atomic o ATOMIC_RMW_CMPXCHG)
          (call emit_local_get o io_a)
          (call put_op o OP_I32_EQ)
          (set! done true))
    (when (eq op_id Kw.atomic_lock)
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_store_guard cg o (get cg Cg.scratch))
          (call emit_local_set o io_a)
          (call put_op o OP_BLOCK)
          (call put_byte o BLOCK_EMPTY)
          (call put_op o OP_LOOP)
          (call put_byte o BLOCK_EMPTY)
          (call emit_local_get o io_a)
          (call emit_i32_const o 0)
          (call emit_i32_const o 1)
          (call emit_atomic o ATOMIC_RMW_CMPXCHG)
          (call put_op o OP_LOCAL_TEE)
          (call put_u32 o io_b)
          (call put_op o OP_I32_EQZ)
          (call put_op o OP_BR_IF)
          (call put_byte o 1)
          (call emit_local_get o io_b)
          (call emit_i32_const o 1)
          (call put_op o OP_I32_NE)
          (call emit_trap_if o)
          (call emit_local_get o io_a)
          (call emit_i32_const o 1)
          (call put_op o OP_I64_CONST) (call put_s64 o -1i64)
          (call emit_atomic o ATOMIC_WAIT32)
          (call put_op o OP_DROP)
          (call put_op o OP_BR)
          (call put_byte o 0)
          (call put_op o OP_END)
          (call put_op o OP_END)
          (set! done true))
    (when (eq op_id Kw.atomic_unlock)
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_store_guard cg o (get cg Cg.scratch))
          (call put_op o OP_LOCAL_TEE)
          (call put_u32 o io_a)
          (call emit_i32_const o 0)
          (call emit_atomic o ATOMIC_RMW_XCHG)
          (call emit_i32_const o 1)
          (call put_op o OP_I32_NE)
          (call emit_trap_if o)
          (call emit_local_get o io_a)
          (call emit_i32_const o -1)
          (call emit_atomic o ATOMIC_NOTIFY)
          (call put_op o OP_DROP)
          (set! done true))
    (when (eq op_id Kw.thread_spawn)
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_local_set o io_b)
          (call emit_local_set o io_a)
          (call emit_i32_const o 0)
          (call emit_i32_const o 16)
          (call emit_rmw_add o)
          (call emit_local_set o (get cg Cg.scratch))
          (call emit_grow_to_cursor o)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_i32_const o 0)
          (call emit_memop_offset o OP_I32_STORE 2 0)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_i32_const o 0)
          (call emit_memop_offset o OP_I32_STORE 2 4)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_local_get o io_a)
          (call emit_memop_offset o OP_I32_STORE 2 8)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_local_get o io_b)
          (call emit_memop_offset o OP_I32_STORE 2 12)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_call o (call get_wasi_index cg Wasi.thread_spawn))
          (call emit_i32_const o 0)
          (call put_op o OP_I32_LT_S)
          (call emit_trap_if o)
          (call emit_local_get o (get cg Cg.scratch))
          (set! done true))
    (when (eq op_id Kw.thread_join)
          (call compile_expr cg (call nth_child node 1) o)
          (call emit_local_set o (get cg Cg.scratch))
          (call put_op o OP_BLOCK)
          (call put_byte o BLOCK_EMPTY)
          (call put_op o OP_LOOP)
          (call put_byte o BLOCK_EMPTY)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_atomic o ATOMIC_LOAD)
          (call put_op o OP_BR_IF)
          (call put_byte o 1)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_i32_const o 0)
          (call put_op o OP_I64_CONST) (call put_s64 o -1i64)
          (call emit_atomic o ATOMIC_WAIT32)
          (call put_op o OP_DROP)
          (call put_op o OP_BR)
          (call put_byte o 0)
          (call put_op o OP_END)
          (call put_op o OP_END)
          (call emit_local_get o (get cg Cg.scratch))
          (call emit_memop_offset o OP_I32_LOAD 2 4)
          (set! done true))

    (when (or (eq op_id Kw.sys_time) (eq op_id Kw.sys_monotonic))
          (call emit_i32_const o (if (eq op_id Kw.sys_time) 0 1))
          (call put_op o OP_I64_CONST)
          (call put_byte o 1)
          (call emit_rt cg o 80)
          (call emit_call o (call get_wasi_index cg Wasi.clock_time_get))
          (call emit_trap_if o)
          (call emit_rt cg o 80)
          (call emit_memop o OP_I64_LOAD 3)
          (set! done true))
    ;; aipl_net_v1 gives the result itself (a handle, a count, -1 or -2), and
    ;; so does aipl_sys_v1 (0, or minus an errno)
    (when (and (call is_host_kw op_id) (neq op_id Kw.fs_chmod))
          (let k:i32 1)
          (while (neq (call nth_child node k) (ptr.null compiler.Node))
            (call compile_expr cg (call nth_child node k) o)
            (set! k (+ k 1)))
          (call emit_call o (call get_wasi_index cg (call host_wasi op_id)))
          (set! done true))
    (when (eq op_id Kw.sys_random)
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_call o (call get_wasi_index cg Wasi.random_get))
          (call emit_errno_to_result cg o -1)
          (set! done true))

    ;; and / or short-circuit, as wasm.rs: (and a b) = a; if (result i32) b else
    ;; i32.const 0 end; (or a b) = a; if (result i32) i32.const 1 else b end.
    (when (or (eq op_id Kw.and) (eq op_id Kw.or))
          (call compile_expr cg (call nth_child node 1) o)
          (call put_op o OP_IF)
          (call put_byte o VT_I32)
          (call label_push cg Label.if_else)
          (if (eq op_id Kw.and)
              (block
                (call compile_expr cg (call nth_child node 2) o)
                (call put_op o OP_ELSE)
                (call emit_i32_const o 0))
              (block
                (call emit_i32_const o 1)
                (call put_op o OP_ELSE)
                (call compile_expr cg (call nth_child node 2) o)))
          (call label_pop cg)
          (call put_op o OP_END) (set! done true))

    (when (not done)
          (let t:Ty (call node_type cg (call nth_child node 1)))
          (call compile_expr cg (call nth_child node 1) o)
          (call compile_expr cg (call nth_child node 2) o)
          (call emit_typed_binop o op_id t) (set! done true)))




  (fn compile_let [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void (call compile_assign cg (call nth_child node 1) (call nth_child node 4) o))




  (fn compile_set [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void (call compile_assign cg (call nth_child node 1) (call nth_child node 2) o))

  ;; The value into the named local's slots (one per scalar of a value struct).
  (fn compile_assign [cg:(ptr Cg) name_node:(ptr compiler.Node) val_node:(ptr compiler.Node) o:(ptr Out)] -> void
    (call compile_expr cg val_node o)
    (let n:i32 (call value_width cg val_node))
    (call emit_set_slots o (call node_slot cg name_node) (if (lt n 1) 1 n)))




  (fn compile_call [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (unsafe (let fname_node:(ptr compiler.Node) (call nth_child node 1))
    (let arg:(ptr compiler.Node) (call node_next (call node_next (call first_child node))))
    (while (neq arg (ptr.null compiler.Node))
      (call compile_expr cg arg o)
      (set! arg (call node_next arg)))
    (let fidx:i32 (call find_function cg (call node_a fname_node) (call node_b fname_node)))
    (if (eq fidx -1)
        (block
          (mem.store32 44 (call node_a fname_node))
          (mem.store32 48 (call node_b fname_node))
          (call set_compile_error CgErr.undefined_function)
          (block))
        (call emit_call o (+ (get cg Cg.nimports) fidx)))))




  (fn compile_stmt [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void (call compile_expr cg node o) (when (not (call is_void_node cg node)) (call emit_drops o (call value_width cg node))))




  (fn compile_stmt_seq [cg:(ptr Cg) first:(ptr compiler.Node) o:(ptr Out)] -> void (let node:(ptr compiler.Node) first) (while (neq node (ptr.null compiler.Node)) (let nxt:(ptr compiler.Node) (call node_next node)) (if (eq nxt (ptr.null compiler.Node)) (call compile_expr cg node o) (call compile_stmt cg node o)) (set! node nxt)))




  (fn compile_all_stmts [cg:(ptr Cg) first:(ptr compiler.Node) o:(ptr Out)] -> void (let node:(ptr compiler.Node) first) (while (neq node (ptr.null compiler.Node)) (let nxt:(ptr compiler.Node) (call node_next node)) (call compile_stmt cg node o) (set! node nxt)))




  (fn compile_block [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void (call compile_stmt_seq cg (call node_next (call first_child node)) o))




  ;; (when c body...): what compile_if emits for (if c (block body... (block)) (block)),
  ;; the tree src/parser.rs reads it into: the condition, an if of no value, the body
  ;; as a block's statements, and an empty else, each branch at the when's
  ;; position (compile_expr's at_push), so the bytes and the line table match.
  (fn compile_when [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (call compile_expr cg (call nth_child node 1) o)
    (call put_op o OP_IF) (call put_byte o 64)
    (call label_push cg Label.if_else)
    (call at_push o (get node compiler.Node.pos))
    ;; every expression of the body a statement, then the empty block the
    ;; parsers end the body with (src/parser.rs "when")
    (call compile_all_stmts cg (call nth_child node 2) o)
    (call at_push o (get node compiler.Node.pos))
    (call at_pop o)
    (call at_pop o)
    (call put_op o OP_ELSE)
    (call at_push o (get node compiler.Node.pos))
    (call at_pop o)
    (call label_pop cg)
    (call put_op o OP_END))

  (fn compile_if [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let cond_node:(ptr compiler.Node) (call nth_child node 1))
    (let then_node:(ptr compiler.Node) (call nth_child node 2))
    (let else_node:(ptr compiler.Node) (call nth_child node 3))
    (call compile_expr cg cond_node o)
    ;; the block's type is the branch's that does not always leave
    (let typed:(ptr compiler.Node) (call if_typed cg node))
    (let block_ty:i32 64)
    (if (call is_void_node cg typed) (set! block_ty 64) (set! block_ty (call block_type_byte (call node_type cg typed))))
    (call put_op o OP_IF) (call put_byte o block_ty)
    (call label_push cg Label.if_else)
    (call compile_expr cg then_node o)
    (call seal_node cg then_node (neq block_ty 64) o)
    (call put_op o OP_ELSE)
    (call compile_expr cg else_node o)
    (call seal_node cg else_node (neq block_ty 64) o)
    (call label_pop cg)
    (call put_op o OP_END))



  ;; block { loop { cond; eqz; br_if 1; body; br 0 } }: break = br to the block,
  ;; continue = br to the loop header (wasm.rs Expr::While).
  ;; ===== Checks once per loop (wasm.rs compile_pointer,
  ;; functions_that_may_free, loop_invariant_pointers, compile_versioned_loop) =====

  ;; A pointer or array operand, compiled and checked (emit_null_check),
  ;; leaving its address; a variable an enclosing versioned loop has checked
  ;; is only unwrapped.
  (fn compile_pointer [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (call compile_expr cg node o)
    (if (and (eq (call node_kind node) compiler.Kind.symbol) (call is_proven cg node))
        (block
          (call put_op o OP_I32_WRAP_I64)
          (call emit_local_tee o (get cg Cg.scratch)))
        (call emit_null_check cg o)))

  (fn same_name [cg:(ptr Cg) a:(ptr compiler.Node) b:(ptr compiler.Node)] -> bool
    (call sym_eq cg (call node_a a) (call node_b a) (+ (get cg Cg.src) (call node_a b)) (call node_b b)))

  (fn names_contain [cg:(ptr Cg) names:(ptr (vec.Vec (ptr compiler.Node))) n:(ptr compiler.Node)] -> bool
    (for i 0 (call (vec.len (ptr compiler.Node)) names)
      (when (call same_name cg (call (vec.at (ptr compiler.Node)) names i) n) (return true)))
    false)

  (fn is_proven [cg:(ptr Cg) n:(ptr compiler.Node)] -> bool
    (call names_contain cg (get cg Cg.proven) n))

  ;; Whether name a sorts before name b, byte by byte (Rust's String order).
  (fn name_before [cg:(ptr Cg) a:(ptr compiler.Node) b:(ptr compiler.Node)] -> bool
    (unsafe (let la:i32 (call node_b a))
    (let lb:i32 (call node_b b))
    (let n:i32 (if (lt la lb) la lb))
    (for i 0 n
      (let x:i32 (mem.load8 (+ (get cg Cg.src) (+ (call node_a a) i))))
      (let y:i32 (mem.load8 (+ (get cg Cg.src) (+ (call node_a b) i))))
      (when (neq x y) (return (lt x y))))
    (lt la lb)))

  ;; Inserts n into the sorted names.
  (fn insert_sorted [cg:(ptr Cg) names:(ptr (vec.Vec (ptr compiler.Node))) n:(ptr compiler.Node)] -> void
    (call (vec.push (ptr compiler.Node)) names n)
    (let i:i32 (- (call (vec.len (ptr compiler.Node)) names) 1))
    (while (and (gt i 0) (call name_before cg n (call (vec.at (ptr compiler.Node)) names (- i 1))))
      (call (vec.set (ptr compiler.Node)) names i (call (vec.at (ptr compiler.Node)) names (- i 1)))
      (set! i (- i 1)))
    (call (vec.set (ptr compiler.Node)) names i n))

  ;; An unchecked operation that can change memory other than through a
  ;; checked access; raw loads cannot (wasm.rs may_write_memory).
  (fn writes_memory [k:Kw] -> bool
    (cond
      ((or (or (eq k Kw.mem_store8) (eq k Kw.mem_store16)) (or (eq k Kw.mem_store32) (eq k Kw.mem_store64))) true)
      ((or (eq k Kw.atomic_add) (or (eq k Kw.atomic_cas) (or (eq k Kw.atomic_lock) (eq k Kw.atomic_unlock)))) true)
      ((or (eq k Kw.thread_spawn) (eq k Kw.thread_join)) true)
      ((or (eq k Kw.fs_open) (or (eq k Kw.fs_read) (or (eq k Kw.fs_write) (eq k Kw.fs_delete)))) true)
      ((or (eq k Kw.fs_opendir) (or (eq k Kw.fs_readdir) (eq k Kw.fs_stat))) true)
      ((or (eq k Kw.args_sizes) (or (eq k Kw.args_get) (or (eq k Kw.env_sizes) (eq k Kw.env_get)))) true)
      ((call is_host_kw k) true)
      (else (eq k Kw.sys_random))))

  ;; Whether node writes memory itself or calls through a reference; the
  ;; functions it calls go to calls (-1 for one not in the module).
  (fn scan_effects [cg:(ptr Cg) node:(ptr compiler.Node) calls:(ptr (vec.Vec i32))] -> bool
    (when (neq (call node_kind node) compiler.Kind.paren) (return false))
    (let kw:Kw (call group_head_keyword cg node))
    (let hit:bool (or (call writes_memory kw) (eq kw Kw.call_ref)))
    (when (eq kw Kw.call)
          (let callee:(ptr compiler.Node) (call nth_child node 1))
          (call (vec.push i32) calls (call find_function cg (call node_a callee) (call node_b callee))))
    (let child:(ptr compiler.Node) (call first_child node))
    (while (neq child (ptr.null compiler.Node))
      (when (call scan_effects cg child calls) (set! hit true))
      (set! child (call node_next child)))
    hit)

  ;; The functions that may free memory (wasm.rs functions_that_may_free):
  ;; those that write memory themselves, call through a reference, or call
  ;; one that may.
  (fn compute_may_free [cg:(ptr Cg)] -> void
    (let n:i32 (get cg Cg.nfns))
    (let may:(arr bool) (arr.new bool (call alloc.forever) (if (gt n 0) n 1)))
    (let callees:(arr (ptr (vec.Vec i32))) (arr.new (ptr (vec.Vec i32)) (call alloc.forever) (if (gt n 0) n 1)))
    (for i 0 n
      (let calls:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 8))
      (arr.set bool may i (call scan_effects cg (get (call func_entry_ptr cg i) FnInfo.node) calls))
      (arr.set (ptr (vec.Vec i32)) callees i calls))
    (let changed:bool true)
    (while changed
      (set! changed false)
      (for i 0 n
        (when (not (arr.get bool may i))
              (let calls:(ptr (vec.Vec i32)) (arr.get (ptr (vec.Vec i32)) callees i))
              (for j 0 (call (vec.len i32) calls)
                (let c:i32 (call (vec.at i32) calls j))
                (when (and (not (arr.get bool may i)) (or (lt c 0) (arr.get bool may c))) (arr.set bool may i true) (set! changed true))))))
    (put cg Cg.may_free may))

  (fn push_symbol [names:(ptr (vec.Vec (ptr compiler.Node))) n:(ptr compiler.Node)] -> void
    (when (eq (call node_kind n) compiler.Kind.symbol) (call (vec.push (ptr compiler.Node)) names n)))

  ;; Walks a loop: whether anything in it may free memory; the variables it
  ;; accesses directly to used, those it assigns or binds to assigned.
  (fn loop_scan [cg:(ptr Cg) node:(ptr compiler.Node) used:(ptr (vec.Vec (ptr compiler.Node))) assigned:(ptr (vec.Vec (ptr compiler.Node)))] -> bool
    (when (neq (call node_kind node) compiler.Kind.paren) (return false))
    (let kw:Kw (call group_head_keyword cg node))
    (let barrier:bool false)
    (cond
      ((or (call writes_memory kw) (eq kw Kw.call_ref)) (set! barrier true))
      ((eq kw Kw.call)
       (let callee:(ptr compiler.Node) (call nth_child node 1))
       (let f:i32 (call find_function cg (call node_a callee) (call node_b callee)))
       (when (or (lt f 0) (arr.get bool (get cg Cg.may_free) f)) (set! barrier true)))
      ((or (eq kw Kw.let) (or (eq kw Kw.set) (eq kw Kw.loop))) (call push_symbol assigned (call nth_child node 1)))
      ((eq kw Kw.match_result)
       (call push_symbol assigned (call nth_child (call nth_child node 2) 1))
       (call push_symbol assigned (call nth_child (call nth_child node 3) 1)))
      ((eq kw Kw.match)
       (let arm:(ptr compiler.Node) (call nth_child node 2))
       (while (neq arm (ptr.null compiler.Node))
         (let binders:(ptr compiler.Node) (call node_next (call first_child arm)))
         (when (eq (call node_kind binders) compiler.Kind.bracket)
               (let b:(ptr compiler.Node) (call first_child binders))
               (while (neq b (ptr.null compiler.Node)) (call push_symbol assigned b) (set! b (call node_next b))))
         (set! arm (call node_next arm))))
      ((or (eq kw Kw.get) (or (eq kw Kw.put) (eq kw Kw.arr_len))) (call push_symbol used (call nth_child node 1)))
      ((or (eq kw Kw.arr_get) (eq kw Kw.arr_set)) (call push_symbol used (call nth_child node 2)))
      (else (block)))
    (let child:(ptr compiler.Node) (call first_child node))
    (while (neq child (ptr.null compiler.Node))
      (when (call loop_scan cg child used assigned) (set! barrier true))
      (set! child (call node_next child)))
    barrier)

  ;; The pointer and array variables a loop accesses directly and never
  ;; assigns, sorted by name, when nothing in it can free memory; not those
  ;; already checked (wasm.rs loop_invariant_pointers).
  (fn loop_invariant_pointers [cg:(ptr Cg) lp:(ptr compiler.Node)] -> (ptr (vec.Vec (ptr compiler.Node)))
    (let used:(ptr (vec.Vec (ptr compiler.Node))) (call (vec.make (ptr compiler.Node)) (call alloc.default) 8))
    (let assigned:(ptr (vec.Vec (ptr compiler.Node))) (call (vec.make (ptr compiler.Node)) (call alloc.default) 8))
    (let out:(ptr (vec.Vec (ptr compiler.Node))) (call (vec.make (ptr compiler.Node)) (call alloc.default) 4))
    (when (call loop_scan cg lp used assigned) (return out))
    (for i 0 (call (vec.len (ptr compiler.Node)) used)
      (let u:(ptr compiler.Node) (call (vec.at (ptr compiler.Node)) used i))
      (let idx:i32 (call find_local cg (call node_a u) (call node_b u)))
      (when (and (gte idx 0)
               (and (or (eq (get (call local_at cg idx) Local.ty) Ty.ptr) (eq (get (call local_at cg idx) Local.ty) Ty.arr))
                    (and (not (call names_contain cg assigned u))
                         (and (not (call is_proven cg u)) (not (call names_contain cg out u))))))
          (call insert_sorted cg out u)))
    out)

  ;; A while or loop: versioned when it has invariant pointers (and this is
  ;; not inside a slow copy), else as is (wasm.rs compile_versioned_loop).
  (fn compile_loop_node [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let names:(ptr (vec.Vec (ptr compiler.Node))) (call loop_invariant_pointers cg node))
    (if (and (get cg Cg.versioning) (gt (call (vec.len (ptr compiler.Node)) names) 0))
        (call compile_versioned_loop cg node names o)
        (if (eq (call group_head_keyword cg node) Kw.loop)
            (call compile_loop cg node o)
            (call compile_while cg node o))))

  ;; If every name is non-null and live (or unchecked) when the loop starts,
  ;; a copy whose accesses to them skip the checks; else the loop as usual.
  (fn compile_versioned_loop [cg:(ptr Cg) node:(ptr compiler.Node) names:(ptr (vec.Vec (ptr compiler.Node))) o:(ptr Out)] -> void
    (let a:i32 (get cg Cg.scratch))
    (let fat:i32 (+ a 2))
    (for k 0 (call (vec.len (ptr compiler.Node)) names)
      (call emit_local_get o (call node_slot cg (call (vec.at (ptr compiler.Node)) names k)))
      (call emit_local_tee o fat)
      (call put_op o OP_I32_WRAP_I64)
      (call emit_local_tee o a)
      (call put_op o OP_I32_EQZ)
      (call put_op o OP_IF) (call put_byte o VT_I32)
      (call emit_i32_const o 0)
      (call put_op o OP_ELSE)
      (call emit_local_get o a)
      (call emit_i32_const o 8)
      (call put_op o OP_I32_SUB)
      (call emit_memop o OP_I32_LOAD 2)
      (call emit_pointer_gen o fat)
      (call put_op o OP_I32_EQ)
      (call emit_pointer_gen o fat)
      (call emit_i32_const o -1)
      (call put_op o OP_I32_EQ)
      (call put_op o OP_I32_OR)
      (call put_op o OP_END)
      (when (gt k 0) (call put_op o OP_I32_AND)))
    (call put_op o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (let _l:i32 (call label_push cg Label.if_else))
    (let proven:(ptr (vec.Vec (ptr compiler.Node))) (get cg Cg.proven))
    (let before:i32 (call (vec.len (ptr compiler.Node)) proven))
    (for k 0 (call (vec.len (ptr compiler.Node)) names)
      (call (vec.push (ptr compiler.Node)) proven (call (vec.at (ptr compiler.Node)) names k)))
    (call compile_loop_node cg node o)
    (call (vec.truncate (ptr compiler.Node)) proven before)
    (call put_op o OP_ELSE)
    (let was:bool (get cg Cg.versioning))
    (put cg Cg.versioning false)
    (call compile_loop_node cg node o)
    (put cg Cg.versioning was)
    (let _p:i32 (call label_pop cg))
    (call put_op o OP_END))

  (fn compile_while [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (call put_op o OP_BLOCK)
    (call put_byte o BLOCK_EMPTY)
    (call put_op o OP_LOOP)
    (call put_byte o BLOCK_EMPTY)
    (call label_push cg Label.loop_exit)
    (call label_push cg Label.loop_header)
    (call compile_expr cg (call nth_child node 1) o)
    (call put_op o OP_I32_EQZ)
    (call put_op o OP_BR_IF)
    (call put_u32 o 1)
    (call compile_all_stmts cg (call nth_child node 2) o)
    (call label_pop cg)
    (call label_pop cg)
    (call put_op o OP_BR)
    (call put_u32 o 0)
    (call put_op o OP_END)
    (call put_op o OP_END))



  ;; var = start; block { loop { var > end -> br_if 1; block { body }; var += step; br 0 } }:
  ;; break = br to the outer block, continue = br to the end of the body block,
  ;; which falls into the step (wasm.rs Expr::Loop).
  (fn compile_loop [cg:(ptr Cg) node:(ptr compiler.Node) o:(ptr Out)] -> void
    (let var_node:(ptr compiler.Node) (call nth_child node 1))
    (let var_idx:i32 (call node_slot cg var_node))
    (let end_idx:i32 (call slot_of cg (call find_hidden cg (call node_a var_node) (call node_b var_node) Ty.loop_end)))
    (let step_idx:i32 (call slot_of cg (call find_hidden cg (call node_a var_node) (call node_b var_node) Ty.loop_step)))
    ;; start, end, and step are each evaluated once, in that order
    (call compile_expr cg (call nth_child node 2) o)
    (call emit_local_set o var_idx)
    (call compile_expr cg (call nth_child node 3) o)
    (call emit_local_set o end_idx)
    (call compile_expr cg (call nth_child node 4) o)
    (call emit_local_set o step_idx)
    (call put_op o OP_BLOCK)
    (call put_byte o BLOCK_EMPTY)
    (call put_op o OP_LOOP)
    (call put_byte o BLOCK_EMPTY)
    (call label_push cg Label.loop_exit)
    (call label_push cg Label.loop_header)
    (call emit_local_get o var_idx)
    (call emit_local_get o end_idx)
    (call put_op o OP_I32_GT_S)
    (call put_op o OP_BR_IF)
    (call put_u32 o 1)
    (call put_op o OP_BLOCK)
    (call put_byte o BLOCK_EMPTY)
    (call label_push cg Label.loop_body)
    (call compile_all_stmts cg (call nth_child node 5) o)
    (call label_pop cg)
    (call put_op o OP_END)
    (call label_pop cg)
    (call label_pop cg)
    (call emit_local_get o var_idx)
    (call emit_local_get o step_idx)
    (call put_op o OP_I32_ADD)
    (call emit_local_set o var_idx)
    (call put_op o OP_BR)
    (call put_u32 o 0)
    (call put_op o OP_END)
    (call put_op o OP_END))



  (fn is_else_clause [cg:(ptr Cg) clause:(ptr compiler.Node)] -> bool
    (eq (call group_head_keyword cg clause) Kw.else))

  ;; (cond (c1 e...) ... (else e...)) as the nested ifs the Rust parser builds:
  ;; (if c1 (block e...) (if c2 (block e...) ... (block else...))).
  (fn compile_cond_from [cg:(ptr Cg) clause:(ptr compiler.Node) o:(ptr Out)] -> void
    (let head:(ptr compiler.Node) (call first_child clause))
    (when (call is_else_clause cg clause)
        (return (call compile_stmt_seq cg (call node_next head) o)))
    ;; src/parser.rs rewrites each clause as an if at the clause: its code is
    ;; at the clause, as there (the line table)
    (call at_push o (get clause compiler.Node.pos))
    (let body_first:(ptr compiler.Node) (call node_next head))
    (call compile_expr cg head o)
    (let bt:i32 64)
    (let typed:(ptr compiler.Node) (call clause_typed cg clause))
    (when (not (call is_void_node cg (call last_of typed))) (set! bt (call block_type_byte (call body_type cg typed))))
    (call put_op o OP_IF)
    (call put_byte o bt)
    (call label_push cg Label.if_else)
    (call compile_stmt_seq cg body_first o)
    (call seal_body cg body_first (neq bt 64) o)
    (call put_op o OP_ELSE)
    (let rest:(ptr compiler.Node) (call node_next clause))
    (call compile_cond_from cg rest o)
    (when (and (neq bt 64) (neq rest (ptr.null compiler.Node)))
        (if (call is_else_clause cg rest)
            (call seal_body cg (call node_next (call first_child rest)) true o)
            (when (call clauses_diverge cg rest) (call put_op o OP_UNREACHABLE))))
    (call label_pop cg)
    (call put_op o OP_END)
    (call at_pop o))




  ;; The body's expressions in order, contracts skipped; every value but a
  ;; non-void function's last is dropped.
  ;; Every req is checked first; with ens, the body is a block whose end
  ;; (where return branches to) stores the result in res and checks every
  ;; ens (wasm.rs).
  (fn compile_function_body [cg:(ptr Cg) entry:(ptr FnInfo) o:(ptr Out)] -> void
    (let ret_type:Ty (get entry FnInfo.ret))
    (let fnode:(ptr compiler.Node) (get entry FnInfo.node))
    (let ens:bool (call has_ens cg fnode))
    ;; with ens, a value struct result goes into res, so the block yields nothing
    (let value_return:bool (and ens (eq ret_type Ty.value)))
    (let res:i32 (call local_slot cg (- (str.ptr "res") (get cg Cg.src)) 3))
    (call emit_contract_checks cg entry o Kw.req)
    (put cg Cg.ens_block ens)
    (if ens
        (block
          (call put_op o OP_BLOCK)
          (call put_byte o (if value_return BLOCK_EMPTY (call block_type_byte ret_type)))
          (call label_push cg Label.if_else))
        0)
    (let bchild:(ptr compiler.Node) (call nth_child fnode 5))
    (while (neq bchild (ptr.null compiler.Node))
      (when (not (call is_contract_head cg bchild))
            (let last:bool (eq (call node_next bchild) (ptr.null compiler.Node)))
            (let keep_value:bool (and last (neq ret_type Ty.void)))
            (if (and last value_return)
                (call compile_into cg bchild res o)
                (block
                  (call compile_expr cg bchild o)
                  (when (and (not keep_value) (not (call is_void_node cg bchild))) (call emit_drops o (call value_width cg bchild))))))
      (set! bchild (call node_next bchild)))
    (when ens
          (call label_pop cg)
          (call put_op o OP_END)
          (when (and (neq ret_type Ty.void) (not value_return)) (call emit_local_set o res))
          (call emit_contract_checks cg entry o Kw.ens)
          (when (neq ret_type Ty.void) (call emit_get_slots o res (call width ret_type (get entry FnInfo.ret_vs)))))
    (put cg Cg.ens_block false))

  ;; ===== Compiled contracts (wasm.rs contract_messages, emit_contract_check) =====

  ;; One piece of a contract failure's message after its fixed text: text
  ;; (interned at addr), or a local's value shown as the VM shows it.
  (enum ItemKind [text int long bool_ addr])
  (struct Item [kind:ItemKind addr:i32 len:i32 local:i32])
  (struct Msg [addr:i32 len:i32 items:(arr (ptr Item)) n:i32])

  ;; Interns bytes (not a source spelling) into the literal blob.
  (fn intern_raw [cg:(ptr Cg) data:i32 len:i32] -> i32
    (let found:i32 (call find_interned_content cg data len))
    (when (neq found -1) (return found))
    (call append_to_blob cg data len))

  (fn add_item [cg:(ptr Cg) m:(ptr Msg) kind:ItemKind b:(ptr buf.Buf) local:i32] -> void
    (let it:(ptr Item) (new Item (call alloc.forever) [kind:kind
                                                       addr:(zero i32)
                                                       len:(zero i32)
                                                       local:local]))
    (when (eq kind ItemKind.text)
          (put it Item.addr (call intern_raw cg (get b buf.Buf.data) (call buf.len b)))
          (put it Item.len (call buf.len b)))
    (if (eq kind ItemKind.bool_)
        (block (call intern_raw cg (str.ptr "true") 4) (call intern_raw cg (str.ptr "false") 5) 0)
        0)
    (arr.set (ptr Item) (get m Msg.items) (get m Msg.n) it)
    (put m Msg.n (+ (get m Msg.n) 1)))

;; The first wasm local of parameter k: after the scalars of those before.
  (fn param_slot [f:(ptr FnInfo) k:i32] -> i32
    (let n:i32 0)
    (for p 0 k
      (set! n (+ n (call width (arr.get Ty (get f FnInfo.params) p) (arr.get (ptr StructInfo) (get f FnInfo.pvs) p)))))
    n)

  ;; How the VM shows a value of type t, if compiled code can show it the
  ;; same way (wasm.rs shown_as); ItemKind.text for "it cannot".
  (fn shown_as [t:Ty] -> ItemKind
    (cond
      ((or (eq t Ty.i32) (or (eq t Ty.union) (eq t Ty.fn))) ItemKind.int)
      ((eq t Ty.i64) ItemKind.long)
      ((or (eq t Ty.ptr) (eq t Ty.arr)) ItemKind.addr)
      ((eq t Ty.bool) ItemKind.bool_)
      (else ItemKind.text)))

  ;; " with " before the first value shown, ", " before the others.
  (fn item_head [m:(ptr Msg) name_ptr:i32 name_len:i32] -> (ptr buf.Buf)
    (unsafe (let b:(ptr buf.Buf) (call buf.make (call alloc.default) (+ name_len 12)))
    (call buf.push_str b (if (eq (get m Msg.n) 0) " with " ", "))
    (call buf.push_bytes b (call str.bytes name_ptr name_len))
    b))

  (fn add_value [cg:(ptr Cg) m:(ptr Msg) name_ptr:i32 name_len:i32 kind:ItemKind local:i32] -> void
    (let b:(ptr buf.Buf) (call item_head m name_ptr name_len))
    (call buf.push_str b " = ")
    (call add_item cg m ItemKind.text b 0)
    (call add_item cg m kind b local)
    (when (eq kind ItemKind.long) (let sfx:(ptr buf.Buf) (call buf.make (call alloc.default) 4)) (call buf.push_str sfx "i64") (call add_item cg m ItemKind.text sfx 0)))

  ;; The bytes of the expression starting at offset at of the source: up to
  ;; its closing bracket, or for an atom the next space or bracket.
  (fn expr_text_len [cg:(ptr Cg) at:i32] -> i32
    (unsafe (let src:i32 (get cg Cg.src))
    (let lim:i32 (get cg Cg.src_len))
    (let i:i32 at)
    (let depth:i32 0)
    (let fin:bool false)
    (while (and (not fin) (lt i lim))
      (let c:i32 (mem.load8 (+ src i)))
      (cond
        ((eq c 34)
         (set! i (+ i 1))
         (while (and (lt i lim) (neq (mem.load8 (+ src i)) 34))
           (set! i (+ i (if (eq (mem.load8 (+ src i)) 92) 2 1))))
         (set! i (+ i 1))
         (set! fin (eq depth 0)))
        ((eq c 59) (while (and (lt i lim) (neq (mem.load8 (+ src i)) 10)) (set! i (+ i 1))))
        ((or (eq c 40) (eq c 91)) (set! depth (+ depth 1)) (set! i (+ i 1)))
        ((or (eq c 41) (eq c 93))
         (if (eq depth 0)
             (set! fin true)
             (block (set! depth (- depth 1)) (set! i (+ i 1)) (set! fin (eq depth 0)))))
        ((and (eq depth 0) (or (eq c 32) (or (eq c 9) (or (eq c 10) (eq c 13))))) (set! fin true))
        (else (set! i (+ i 1)))))
    (- i at)))

  ;; The failure message of contract `c` of function `entry` (an inv's on
  ;; return when `exit`, else on entry), its texts interned in the order
  ;; wasm.rs string_layout interns them.
  (fn contract_msg [cg:(ptr Cg) entry:(ptr FnInfo) c:(ptr compiler.Node) exit:bool] -> (ptr Msg)
    (unsafe (let src:i32 (get cg Cg.src))
    (let ck:Kw (call contract_kind cg c))
    (let is_ens:bool (or (eq ck Kw.ens) (and (eq ck Kw.inv) exit)))
    (let t:(ptr buf.Buf) (call buf.make (call alloc.default) 128))
    (call buf.push_str t (cond
                           ((eq ck Kw.ens) "Post-condition failed in '")
                           ((eq ck Kw.req) "Pre-condition failed in '")
                           (exit "Exit invariant failed in '")
                           (else "Entry invariant failed in '")))
    (call buf.push_bytes t (call str.bytes (+ src (get entry FnInfo.name_pos)) (get entry FnInfo.name_len)))
    (call buf.push_str t (cond ((eq ck Kw.ens) "': (ens ") ((eq ck Kw.req) "': (req ") (else "': (inv ")))
    (let e:(ptr compiler.Node) (call nth_child c 1))
    (let at:i32 (get e compiler.Node.pos))
    (call printer.print_expr t (call parser.parse_expr_text (+ src at) (call expr_text_len cg at)))
    (call buf.push_str t ")")
    (let m:(ptr Msg) (new Msg (call alloc.forever) [addr:(call intern_raw cg (get t buf.Buf.data) (call buf.len t))
                                                    len:(call buf.len t)
                                                    items:(zero (arr (ptr Item)))
                                                    n:(zero i32)]))
    (let np:i32 (get entry FnInfo.nparams))
    (put m Msg.items (arr.new (ptr Item) (call alloc.forever) (+ (* 3 (+ np 1)) 1)))
    (put m Msg.n 0)
    (let pchild:(ptr compiler.Node) (call first_child (call nth_child (get entry FnInfo.node) 2)))
    (let k:i32 0)
    (while (neq pchild (ptr.null compiler.Node))
      (let kind:ItemKind (call shown_as (arr.get Ty (get entry FnInfo.params) k)))
      (when (neq kind ItemKind.text)
          (call add_value cg m (+ src (call node_a pchild)) (call node_b pchild) kind (call param_slot entry k)))
      (set! k (+ k 1))
      (set! pchild (call node_next (call node_next (call node_next pchild)))))
    (when is_ens
          (let ret:Ty (get entry FnInfo.ret))
          (let rkind:ItemKind (call shown_as ret))
          (cond
            ((eq ret Ty.void)
             (let b:(ptr buf.Buf) (call item_head m (str.ptr "res") 3))
             (call buf.push_str b " = void")
             (call add_item cg m ItemKind.text b 0))
            ((neq rkind ItemKind.text)
             (call add_value cg m (str.ptr "res") 3 rkind (call local_slot cg (- (str.ptr "res") src) 3)))
            (else (block))))
    m))

  ;; Interns every contract message's texts, function by function (wasm.rs
  ;; string_layout, after the literals).
  (fn intern_contract_texts [cg:(ptr Cg)] -> void
    (for f 0 (get cg Cg.nfns)
      (let entry:(ptr FnInfo) (call func_entry_ptr cg f))
      (let item:(ptr compiler.Node) (call nth_child (get entry FnInfo.node) 5))
      (while (neq item (ptr.null compiler.Node))
        (if (neq (call contract_kind cg item) Kw.none) (block (call contract_msg cg entry item false) 0) 0)
        (if (eq (call contract_kind cg item) Kw.inv) (block (call contract_msg cg entry item true) 0) 0)
        (set! item (call node_next item)))))

  ;; The checks of every contract of kind `kind` (req or ens) of the
  ;; function, in order (wasm.rs emit_contract_check): unless the condition
  ;; holds, write the message to fresh memory and trap.
  (fn emit_contract_checks [cg:(ptr Cg) entry:(ptr FnInfo) o:(ptr Out) kind:Kw] -> void
    (let base:i32 (get cg Cg.checks_base))
    (let item:(ptr compiler.Node) (call nth_child (get entry FnInfo.node) 5))
    (while (neq item (ptr.null compiler.Node))
      (when (or (eq (call contract_kind cg item) kind) (eq (call contract_kind cg item) Kw.inv))
            (let m:(ptr Msg) (call contract_msg cg entry item (eq kind Kw.ens)))
            (let max:i32 (get m Msg.len))
            (for j 0 (get m Msg.n)
              (let it:(ptr Item) (arr.get (ptr Item) (get m Msg.items) j))
              (set! max (+ max (cond
                                 ((eq (get it Item.kind) ItemKind.text) (get it Item.len))
                                 ((eq (get it Item.kind) ItemKind.bool_) 5)
                                 (else 24)))))
            ;; the condition and its failure code are at the condition
            (call at_push o (get (call nth_child item 1) compiler.Node.pos))
            (call compile_expr cg (call nth_child item 1) o)
            (call put_op o OP_I32_EQZ)
            (call put_op o OP_IF) (call put_byte o BLOCK_EMPTY)
            (call emit_i32_const o (get m Msg.addr))
            (call emit_i32_const o (get m Msg.len))
            (call emit_i32_const o max)
            (call emit_call o (+ base 3))
            (for j 0 (get m Msg.n)
              (let it:(ptr Item) (arr.get (ptr Item) (get m Msg.items) j))
              (let ik:ItemKind (get it Item.kind))
              (cond
                ((eq ik ItemKind.text)
                 (call emit_i32_const o (get it Item.addr))
                 (call emit_i32_const o (get it Item.len))
                 (call emit_call o (+ base 2)))
                ((eq ik ItemKind.int)
                 (call emit_local_get o (get it Item.local))
                 (call put_op o OP_I64_EXTEND_I32_S)
                 (call emit_call o base))
                ((eq ik ItemKind.long)
                 (call emit_local_get o (get it Item.local))
                 (call emit_call o base))
                ((eq ik ItemKind.addr)
                 (call emit_local_get o (get it Item.local))
                 (call put_op o OP_I32_WRAP_I64)
                 (call put_op o OP_I64_EXTEND_I32_U)
                 (call emit_call o base))
                (else
                 ;; "true" or "false": address, then length
                 (call emit_bool_pick o (get it Item.local) (call intern_raw cg (str.ptr "true") 4) (call intern_raw cg (str.ptr "false") 5))
                 (call emit_bool_pick o (get it Item.local) 4 5)
                 (call emit_call o (+ base 2)))))
            (call emit_call o (+ base 4))
            (call put_op o OP_UNREACHABLE)
            (call put_op o OP_END)
            (call at_pop o))
      (set! item (call node_next item))))

  ;; local ? a : b, as an if with an i32 result.
  (fn emit_bool_pick [o:(ptr Out) local:i32 a:i32 b:i32] -> void
    (call emit_local_get o local)
    (call put_op o OP_IF) (call put_byte o VT_I32)
    (call emit_i32_const o a)
    (call put_op o OP_ELSE)
    (call emit_i32_const o b)
    (call put_op o OP_END))




  ;; ===== Module assembly =====

  ;; Appends the bytes src has written.
  (fn copy_out [dst:(ptr Out) src:(ptr Out)] -> void
    (unsafe (for i 0 (get src Out.pos)
      (call put_byte dst (mem.load8 (+ (get src Out.base) i))))))

  ;; A size-prefixed copy of what sub has written (a function body).
  (fn emit_sized [o:(ptr Out) sub:(ptr Out)] -> void
    (call put_u32 o (get sub Out.pos))
    (call copy_out o sub))

  ;; A section: its id, its size, then the bytes sec has written.
  (fn emit_section [o:(ptr Out) id:i32 sec:(ptr Out)] -> void
    (call put_byte o id)
    (call emit_sized o sec))

  ;; A 4-byte little-endian word.
  (fn put_word [o:(ptr Out) v:i32] -> void
    (for k 0 4 (call put_byte o (bitand (shr v (* k 8)) 255))))

  ;; A function type: 0x60, the parameter value types, the result types.
  (fn emit_func_type [o:(ptr Out) s:(ptr Sig)] -> void
    (call put_byte o FUNC_TYPE)
    (call put_u32 o (get s Sig.nparams))
    (for i 0 (get s Sig.nparams) (call put_byte o (arr.get i32 (get s Sig.params) i)))
    (call put_u32 o (get s Sig.nresults))
    (for i 0 (get s Sig.nresults) (call put_byte o (arr.get i32 (get s Sig.results) i))))

  ;; A signature from a pattern of parameter types, i for i32 and l for i64,
  ;; and a result value type (0 for none).
  (fn sig_from [params:str result:i32] -> (ptr Sig)
    (unsafe (let s:(ptr Sig) (new Sig (call alloc.forever) [nparams:(zero i32)
                                                            params:(zero (arr i32))
                                                            nresults:(zero i32)
                                                            results:(zero (arr i32))]))
    (let n:i32 (str.len params))
    (put s Sig.params (arr.new i32 (call alloc.forever) (if (eq n 0) 1 n)))
    (for i 0 n
      (arr.set i32 (get s Sig.params) i (if (eq (mem.load8 (+ (str.ptr params) i)) 108) 126 127)))
    (put s Sig.nparams n)
    (put s Sig.results (arr.new i32 (call alloc.forever) 1))
    (arr.set i32 (get s Sig.results) 0 result)
    (put s Sig.nresults (if (eq result 0) 0 1))
    s))

  ;; The types of the WASI functions (wasm.rs Wasi::sig).
  (fn wasi_sig [w:Wasi] -> (ptr Sig)
    (cond
      ((or (eq w Wasi.fd_write) (eq w Wasi.fd_read)) (call sig_from "iiii" 127))
      ((eq w Wasi.path_open) (call sig_from "iiiiillii" 127))
      ((eq w Wasi.fd_close) (call sig_from "i" 127))
      ((eq w Wasi.proc_exit) (call sig_from "i" 0))
      ((eq w Wasi.path_unlink_file) (call sig_from "iii" 127))
      ((eq w Wasi.clock_time_get) (call sig_from "ili" 127))
      ((eq w Wasi.thread_spawn) (call sig_from "i" 127))
      ((eq w Wasi.fd_readdir) (call sig_from "iiili" 127))
      ((eq w Wasi.path_filestat_get) (call sig_from "iiiii" 127))
      ((or (eq w Wasi.net_listen) (or (eq w Wasi.net_recv) (eq w Wasi.net_send))) (call sig_from "iii" 127))
      ((eq w Wasi.sys_chmod) (call sig_from "iiii" 127))
      ((or (eq w Wasi.net_accept) (eq w Wasi.net_close)) (call sig_from "i" 127))
      ;; random_get, args_sizes_get, args_get, environ_sizes_get, environ_get
      (else (call sig_from "ii" 127))))

  ;; The wasm type of a module function.
  (fn fn_sig [f:(ptr FnInfo)] -> (ptr Sig)
    (let s:(ptr Sig) (call new_sig))
    (for p 0 (get f FnInfo.nparams)
      (call sig_add_param s (arr.get Ty (get f FnInfo.params) p) (arr.get (ptr StructInfo) (get f FnInfo.pvs) p)))
    (call sig_set_result s (get f FnInfo.ret) (get f FnInfo.ret_vs))
    s)

  ;; One function body: the locals (declared ones, the store guard's and
  ;; bounds check's two scratch locals, two I/O scratch locals if needed,
  ;; and the value struct groups), the code, end.
  (fn emit_function [cg:(ptr Cg) entry:(ptr FnInfo) fc:(ptr Out)] -> void
    (let pcount:i32 (get entry FnInfo.nparams))
    (let total_locals:i32 (call collect_locals_for_function cg entry))
    (put cg Cg.nlocals total_locals)
    (call (vec.clear (ptr compiler.Node)) (get cg Cg.proven))
    (put cg Cg.versioning true)
    (let nslots:i32 (call assign_slots cg))
    (put cg Cg.scratch nslots)
    (let pslots:i32 (if (lt pcount total_locals) (get (call local_at cg pcount) Local.slot) nslots))
    (let uses_io:bool (call fn_uses_io cg (get entry FnInfo.node)))
    ;; value struct groups: after every other local (wasm.rs value_groups)
    (let value_return:bool (and (call has_ens cg (get entry FnInfo.node)) (eq (get entry FnInfo.ret) Ty.value)))
    (let ngroup:i32 (call collect_groups cg entry value_return (+ nslots (if uses_io 5 3))))
    ;; one entry per local (per scalar of a value struct), the two scratch
    ;; locals, the i64 one a generation check uses, the two I/O ones, the
    ;; groups' locals
    (call put_u32 fc (+ (- nslots pslots) (+ (if uses_io 3 2) ngroup)))
    (for l pcount total_locals
      (call emit_local_entries fc (get (call local_at cg l) Local.ty) (get (call local_at cg l) Local.vs)))
    (call put_u32 fc 2) (call put_byte fc VT_I32)
    (call put_u32 fc 1) (call put_byte fc VT_I64)
    (when uses_io (call put_u32 fc 2) (call put_byte fc VT_I32))
    (let gs:(ptr (vec.Vec (ptr Group))) (get cg Cg.groups))
    (for i 0 (call (vec.len (ptr Group)) gs)
      (call emit_local_entries fc Ty.value (get (call (vec.at (ptr Group)) gs i) Group.vs)))
    (call compile_function_body cg entry fc)
    (call put_op fc OP_END))

  ;; A local's declaration entries: (1, type) for a scalar, one per scalar
  ;; for a value struct.
  (fn emit_local_entries [fc:(ptr Out) t:Ty vs:(ptr StructInfo)] -> void
    (if (eq t Ty.value)
        (for k 0 (get vs StructInfo.width)
          (call put_u32 fc 1)
          (call put_byte fc (call type_id_to_valtype (arr.get Ty (get vs StructInfo.flat_ty) k))))
        (block
          (call put_u32 fc 1)
          (call put_byte fc (call type_id_to_valtype t)))))

  ;; Compiles one import-free module (src_len bytes at src_ptr) to wasm. The
  ;; module goes to a fresh buffer whose address is stored in cell 60; returns
  ;; its length, or -1 with the first compile error in cell 4.
  ;; One file's text; the line table names no file.
  (fn compile_module [src_ptr:i32 src_len:i32] -> i32
    (call compile_named src_ptr src_len 0 0))

  ;; One file's text, named (name_ptr, name_len) in the line table.
  (fn compile_named [src_ptr:i32 src_len:i32 name_ptr:i32 name_len:i32] -> i32
    (unsafe (call compile_at src_ptr src_len (call places.single (call str.bytes name_ptr name_len) (call str.bytes src_ptr src_len)) MAX_PAGES)))

  ;; The flat program the resolver (orig) and the generics pass (gen)
  ;; printed: the line table names the files they read.
  (fn compile_mapped [src_ptr:i32 src_len:i32 gen:(ptr origins.Origins) orig:(ptr origins.Origins) max_pages:i32] -> i32 (pub)
    (call compile_at src_ptr src_len (call places.mapped gen orig) max_pages))

  ;; The same for a program whose formatting forms were lowered (low maps
  ;; the lowered text back to the program the generics pass printed).
  (fn compile_lowered [src_ptr:i32 src_len:i32 gen:(ptr origins.Origins) orig:(ptr origins.Origins) low:(ptr origins.Origins) max_pages:i32] -> i32 (pub)
    (call compile_at src_ptr src_len (call places.lowered gen orig low) max_pages))

  ;; max_pages: memory's declared maximum (wasm.rs compile_limited; at most
  ;; MAX_PAGES, which --max-memory may only lower).
  (fn compile_at [src_ptr:i32 src_len:i32 where:(ptr places.Places) max_pages:i32] -> i32
    (unsafe (let _init:i32 (call init_keywords))
    ;; constants and enums are erased to literals and i32 first (consts.aipl)
    (let plain:(ptr buf.Buf) (call buf.make (call alloc.default) (+ src_len 64)))
    (when (not (call consts.expand (call str.bytes src_ptr src_len) plain (call buf.make (call alloc.default) 64) (get where places.Places.consts))) (call set_compile_error CgErr.unknown_enum_member) (return -1))
    (set! src_ptr (call str.addr (call buf.bytes plain)))
    (let cg:(ptr Cg) (call new_cg src_ptr))
    (put cg Cg.places where)
    (put cg Cg.max_pages (if (lt max_pages MAX_PAGES) max_pages MAX_PAGES))
    (set! src_len (call buf.len plain))
    (put cg Cg.src_len src_len)
    ;; Buffers are sized from the input: a token is at least one source byte
    ;; (a Token record each), an AST node is at most one per token.
    (let tok_buf:i32 (call cg_alloc (* (+ (call compiler.count_tokens src_ptr src_len) 1) (sizeof compiler.Token))))
    (let tok_cnt:i32 (call compiler.strip_marks src_ptr tok_buf (call compiler.tokenize src_ptr src_len tok_buf)))
    (let ast_buf:i32 (call cg_alloc (* (+ tok_cnt 2) (sizeof compiler.Node))))
    (let root:(ptr compiler.Node) (call compiler.parse_ast tok_buf tok_cnt ast_buf))

    ;; the structs and unions first: a call_ref signature may name them
    (call register_structs cg root)
    (call collect_unions cg root)
    (call collect_structs cg root)
    (call walk_module_prepass cg root)
    (let threaded:bool (call threaded cg))
    ;; threaded modules call workers through the table (wasm.rs worker_sig)
    (let worker_type:i32 0)
    (when threaded
          (put cg Cg.uses_refs true)
          (set! worker_type (call worker_sig_index cg)))
    ;; Literals plus the heap start must fit in the initial 16 pages (wasm.rs STRING_DATA_LIMIT).
    (if (gt (call heap_start cg) 1048576) (call set_compile_error CgErr.too_many_literals) 0)
    (let imports:i32 (get cg Cg.nimports))
    (let nfns:i32 (call collect_functions cg root))
    (put cg Cg.nfns nfns)
    (call compute_may_free cg)
    (let nsigs:i32 (get cg Cg.nsigs))
    ;; a zero-argument main and no _start: an automatic _start (wasm.rs auto_start)
    (let main_idx:i32 (call find_function cg (- (str.ptr "main") src_ptr) 4))
    (let auto_start:bool (and (gte main_idx 0)
                              (and (eq (get (call func_entry_ptr cg main_idx) FnInfo.nparams) 0)
                                   (lt (call find_function cg (- (str.ptr "_start") src_ptr) 6) 0))))
    ;; generated functions after the module's: a threaded module's start
    ;; function and wasi_thread_start, then _start
    (let extra_fns:i32 (if threaded 2 0))
    ;; then, in a module with compiled checks, the eight check helpers
    ;; (wasm.rs check_functions)
    (let uses_checks:bool (get cg Cg.uses_checks))
    (let before_checks:i32 (+ extra_fns (if auto_start 1 0)))
    (put cg Cg.checks_base (+ imports (+ nfns before_checks)))
    (let n_fns:i32 (+ nfns (+ before_checks (if uses_checks 8 0))))
    ;; the contract messages go into the literals after the program's own
    (call intern_contract_texts cg)
    (if (gt (call heap_start cg) 1048576) (call set_compile_error CgErr.too_many_literals) 0)

    ;; Output, section scratch, and per-function scratch share one capacity;
    ;; overrunning it is compile error 91.
    (let cap:i32 (+ (* src_len 4) 65536))
    (let out:i32 (call cg_alloc cap))
    (let scratch:i32 (call cg_alloc cap))
    (let fcode_scratch:i32 (call cg_alloc cap))
    (let o:(ptr Out) (call out_at out))
    (call advance o (call compiler.emit_header out))

    ;; Type (1): the WASI imports' types, the functions', the call_ref
    ;; signatures, a threaded module's two, and _start's
    (let sec:(ptr Out) (call out_at scratch))
    (call put_u32 sec (+ imports (+ nfns (+ nsigs (+ before_checks (if uses_checks 8 0))))))
    (for w 0 NWASI
      (when (neq (call get_wasi_index cg (enum.cast Wasi w)) -1) (call emit_func_type sec (call wasi_sig (enum.cast Wasi w)))))
    (for f 0 nfns (call emit_func_type sec (call fn_sig (call func_entry_ptr cg f))))
    (for si 0 nsigs (call emit_func_type sec (arr.get (ptr Sig) (get cg Cg.sigs) si)))
    (when threaded
          (call emit_func_type sec (call sig_from "" 0))       ;; start function: [] -> []
          (call emit_func_type sec (call sig_from "ii" 0)))
    (when auto_start (call emit_func_type sec (call sig_from "" 0)))
    (when uses_checks
          (call emit_func_type sec (call sig_from "il" 127))    ;; $aipl_dec: [i32 i64] -> [i32]
          (call emit_func_type sec (call sig_from "ii" 0))      ;; $aipl_oob: [i32 i32] -> []
          (call emit_func_type sec (call sig_from "iii" 127))   ;; $aipl_text: [i32 i32 i32] -> [i32]
          (call emit_func_type sec (call sig_from "iii" 127))   ;; $aipl_begin: [i32 i32 i32] -> [i32]
          (call emit_func_type sec (call sig_from "i" 0))       ;; $aipl_end: [i32] -> []
          (call emit_func_type sec (call sig_from "" 0))        ;; $aipl_null: [] -> []
          (call emit_func_type sec (call sig_from "" 0))        ;; $aipl_uaf: [] -> []
          (call emit_func_type sec (call sig_from "" 0)))       ;; $aipl_oom: [] -> []
    (call emit_section o 1 sec)

    ;; Import (2): the WASI functions used, in the fixed order; a threaded
    ;; module also imports its shared memory
    (when (or (gt imports 0) threaded)
          (set! sec (call out_at scratch))
          (call put_u32 sec (if threaded (+ imports 1) imports))
          (let type_idx:i32 0)
          (for w 0 NWASI
            (let wv:Wasi (enum.cast Wasi w))
            (when (neq (call get_wasi_index cg wv) -1)
                  (call emit_name sec (call wasi_module wv))
                  (call emit_name sec (call wasi_name wv))
                  (call put_byte sec 0)   ;; a function, of type
                  (call put_u32 sec type_idx)
                  (set! type_idx (+ type_idx 1))))
          ;; "env" "memory": shared, min 16 max 32768 pages (flags 3)
          (when threaded
                (call emit_name sec "env")
                (call emit_name sec "memory")
                (call put_byte sec 2) (call put_byte sec 3)
                (call put_u32 sec 16)
                (call put_u32 sec (get cg Cg.max_pages)))
          (call emit_section o 2 sec))

    ;; Function (3): each function's type index
    (set! sec (call out_at scratch))
    (call put_u32 sec n_fns)
    (for f 0 nfns (call put_u32 sec (+ imports f)))
    (let generated_types:i32 (+ imports (+ nfns nsigs)))
    (when threaded (call put_u32 sec generated_types) (call put_u32 sec (+ generated_types 1)))
    (when auto_start (call put_u32 sec (+ generated_types extra_fns)))
    (when uses_checks
        (for k 0 8 (call put_u32 sec (+ generated_types (+ before_checks k)))))
    (call emit_section o 3 sec)

    ;; Table (4), only with function refs: one funcref table holding every
    ;; function, min = max = function count
    (when (get cg Cg.uses_refs)
          (set! sec (call out_at scratch))
          (call put_byte sec 1)     ;; one table
          (call put_byte sec 112)   ;; funcref
          (call put_byte sec 1)     ;; with a max
          (call put_u32 sec nfns)
          (call put_u32 sec nfns)
          (call emit_section o 4 sec))

    ;; Memory (5): min 16, max 32768 pages (vm.rs MAX_PAGES). A threaded module
    ;; imports its memory and has a Global (6) instead: global 0, the runtime
    ;; scratch pointer, mutable i32 = 64
    (set! sec (call out_at scratch))
    (if threaded
        (block
          (call put_byte sec 1) (call put_byte sec 127) (call put_byte sec 1)
          (call emit_i32_const sec 64)
          (call put_byte sec 11)
          (call emit_section o 6 sec))
        (block
          (call put_byte sec 1)     ;; one memory
          (call put_byte sec 1)     ;; with a max
          (call put_u32 sec 16)
          (call put_u32 sec (get cg Cg.max_pages))
          (call emit_section o 5 sec)))

    ;; Export (7): every function by name, the memory, wasi_thread_start, _start
    (set! sec (call out_at scratch))
    (call put_u32 sec (+ nfns (+ 1 (+ (if threaded 1 0) (if auto_start 1 0)))))
    (for f 0 nfns
      (let entry:(ptr FnInfo) (call func_entry_ptr cg f))
      (call put_u32 sec (get entry FnInfo.name_len))
      (for k 0 (get entry FnInfo.name_len)
        (call put_byte sec (mem.load8 (+ src_ptr (+ (get entry FnInfo.name_pos) k)))))
      (call put_byte sec 0)    ;; a function
      (call put_u32 sec (+ imports f)))
    (call emit_name sec "memory")
    (call put_byte sec 2) (call put_byte sec 0)   ;; memory 0
    (when threaded
          (call emit_name sec "wasi_thread_start")
          (call put_byte sec 0)
          (call put_u32 sec (+ imports (+ nfns 1))))
    (when auto_start
          (call emit_name sec "_start")
          (call put_byte sec 0)
          (call put_u32 sec (+ imports (+ nfns extra_fns))))
    (call emit_section o 7 sec)

    ;; Start (8), threaded only: the one-time initialisation function
    (when threaded
          (set! sec (call out_at scratch))
          (call put_u32 sec (+ imports nfns))
          (call emit_section o 8 sec))

    ;; Element (9), only with function refs: one active segment at table
    ;; offset 0 listing every function in order
    (when (get cg Cg.uses_refs)
          (set! sec (call out_at scratch))
          (call put_byte sec 1) (call put_byte sec 0)
          (call emit_i32_const sec 0)
          (call put_byte sec 11)
          (call put_u32 sec nfns)
          (for f 0 nfns (call put_u32 sec (+ imports f)))
          (call emit_section o 9 sec))

    ;; Data Count (12), threaded only (memory.init needs it)
    (let has_strings:bool (gt (call buf.len (get cg Cg.blob)) 0))
    (when threaded
          (set! sec (call out_at scratch))
          (call put_u32 sec (if has_strings 2 1))
          (call emit_section o 12 sec))

    ;; Code (10): the functions, then the generated ones
    (set! sec (call out_at scratch))
    (call put_u32 sec n_fns)
    (let fn_lines:(ptr (vec.Vec (ptr FnLines))) (call (vec.make (ptr FnLines)) (call alloc.default) (+ nfns 1)))
    (for f 0 nfns
      (let fc:(ptr Out) (call out_at fcode_scratch))
      ;; a printer formatting generates (show.debug.*) has no positions (wasm.rs Body.quiet)
      (let quiet:bool (call is_debug_fn cg (call func_entry_ptr cg f)))
      (put fc Out.lines (if quiet (ptr.null Lines) (call new_lines (get cg Cg.places))))
      (call at_push fc (get (get (call func_entry_ptr cg f) FnInfo.node) compiler.Node.pos))
      (call emit_function cg (call func_entry_ptr cg f) fc)
      (when (not quiet)
            (let fl:(ptr FnLines) (new FnLines (call alloc.forever) [index:(+ imports f)
                                                                     entries:(get (get fc Out.lines) Lines.entries)]))
            (when (gt (call (vec.len (ptr LEntry)) (get fl FnLines.entries)) 0) (call (vec.push (ptr FnLines)) fn_lines fl)))
      (if (gt (get fc Out.pos) cap) (call set_compile_error CgErr.output_full) 0)
      (call emit_sized sec fc))
    (when threaded
          (let fc:(ptr Out) (call out_at fcode_scratch))
          (call threaded_init_body fc (call buf.len (get cg Cg.blob)))
          (call emit_sized sec fc)
          (set! fc (call out_at fcode_scratch))
          (call thread_start_body fc (+ imports (+ nfns worker_type)))
          (call emit_sized sec fc))
    (when auto_start
          ;; call main; its value is the exit status (wasm.rs auto_start): an
          ;; i32 is proc_exit'ed unless it is 0; a (result i32 str)'s ok
          ;; likewise, and its err written to fd 2 with a newline, then
          ;; proc_exit(1); anything else dropped; end
          (let fc:(ptr Out) (call out_at fcode_scratch))
          (let main_fn:(ptr FnInfo) (call func_entry_ptr cg main_idx))
          (let kind:i32 (call start_kind cg root))
          (cond ((eq kind 2) (call put_u32 fc 1) (call put_u32 fc 2) (call put_byte fc 127))
                ((eq kind 1) (call put_u32 fc 1) (call put_u32 fc 1) (call put_byte fc 127))
                (else (call put_byte fc 0)))
          (call emit_call fc (+ imports main_idx))
          (when (eq kind 2)
            ;; [tag, slot]: tag 0 is ok, its slot the status; else the slot
            ;; is err's str, written to fd 2 as sys.print writes
            (call emit_local_set fc 1)
            (call put_op fc OP_IF)
            (call put_byte fc BLOCK_EMPTY)
            (call emit_rt cg fc 64)
            (call emit_local_get fc 1)
            (call emit_memop fc OP_I32_STORE 2)
            (call emit_rt cg fc 68)
            (call emit_local_get fc 1)
            (call emit_i32_const fc 4)
            (call put_op fc OP_I32_SUB)
            (call emit_memop fc OP_I32_LOAD 2)
            (call emit_memop fc OP_I32_STORE 2)
            (call emit_rt cg fc 72)
            (call emit_i32_const fc (get cg Cg.newline))
            (call emit_memop fc OP_I32_STORE 2)
            (call emit_rt cg fc 76)
            (call emit_i32_const fc 1)
            (call emit_memop fc OP_I32_STORE 2)
            (for k 0 2
              (call emit_i32_const fc 2)
              (call emit_rt cg fc (if (eq k 0) 64 72))
              (call emit_i32_const fc 1)
              (call emit_rt cg fc 80)
              (call emit_call fc (call get_wasi_index cg Wasi.fd_write))
              (call put_op fc OP_DROP))
            (call emit_i32_const fc 1)
            (call emit_call fc (call get_wasi_index cg Wasi.proc_exit))
            (call put_op fc OP_END)
            (call emit_local_get fc 1))
          (if (gt kind 0)
              (block
                (call emit_local_tee fc 0)
                (call put_op fc OP_IF)
                (call put_byte fc BLOCK_EMPTY)
                (call emit_local_get fc 0)
                (call emit_call fc (call get_wasi_index cg Wasi.proc_exit))
                (call put_op fc OP_END))
              (for k 1 (+ (call width (get main_fn FnInfo.ret) (get main_fn FnInfo.ret_vs)) 1) (call put_op fc OP_DROP)))
          (call put_op fc OP_END)
          (call emit_sized sec fc))
    (when uses_checks
        (for k 0 8
          (let fc:(ptr Out) (call out_at fcode_scratch))
          (call check_body fc k (get cg Cg.checks_base) (get cg Cg.max_pages))
          (call emit_sized sec fc)))
    (call emit_section o 10 sec)

    ;; Data (11): the heap cursor's initial value at address 0, and the string
    ;; literals at 1024 (both passive in a threaded module: its start
    ;; function copies them once)
    (set! sec (call out_at scratch))
    (call put_u32 sec (if has_strings 2 1))
    (if threaded
        (call put_byte sec 1)
        (block (call put_byte sec 0) (call emit_i32_const sec 0) (call put_byte sec 11)))
    (call put_u32 sec 4)
    (call put_word sec (call heap_start cg))
    (when has_strings
          (if threaded
              (call put_byte sec 1)
              (block (call put_byte sec 0) (call emit_i32_const sec 1024) (call put_byte sec 11)))
          (call put_u32 sec (call buf.len (get cg Cg.blob)))
          (for k 0 (call buf.len (get cg Cg.blob))
            (call put_byte sec (mem.load8 (+ (get (get cg Cg.blob) buf.Buf.data) k)))))
    (call emit_section o 11 sec)

    ;; Name (custom section 0, last): every function's name, so a trap can
    ;; say where it happened (wasm.rs); the generated ones as wasm.rs names them
    (let fnames:(ptr Out) (call out_at fcode_scratch))
    (call put_u32 fnames (+ nfns (+ extra_fns (+ (if auto_start 1 0) (if uses_checks 8 0)))))
    (for f 0 nfns
      (let fentry:(ptr FnInfo) (call func_entry_ptr cg f))
      (call put_u32 fnames (+ imports f))
      (call put_u32 fnames (get fentry FnInfo.name_len))
      (for k 0 (get fentry FnInfo.name_len)
        (call put_byte fnames (mem.load8 (+ src_ptr (+ (get fentry FnInfo.name_pos) k))))))
    (when threaded
          (call put_u32 fnames (+ imports nfns)) (call emit_name fnames "aipl.init")
          (call put_u32 fnames (+ imports (+ nfns 1))) (call emit_name fnames "wasi_thread_start"))
    (when auto_start (call put_u32 fnames (+ imports (+ nfns extra_fns))) (call emit_name fnames "_start"))
    (when uses_checks
          (let cb:i32 (get cg Cg.checks_base))
          (call put_u32 fnames cb) (call emit_name fnames "aipl.dec")
          (call put_u32 fnames (+ cb 1)) (call emit_name fnames "aipl.oob")
          (call put_u32 fnames (+ cb 2)) (call emit_name fnames "aipl.text")
          (call put_u32 fnames (+ cb 3)) (call emit_name fnames "aipl.begin")
          (call put_u32 fnames (+ cb 4)) (call emit_name fnames "aipl.end")
          (call put_u32 fnames (+ cb 5)) (call emit_name fnames "aipl.null")
          (call put_u32 fnames (+ cb 6)) (call emit_name fnames "aipl.uaf")
          (call put_u32 fnames (+ cb 7)) (call emit_name fnames "aipl.oom"))
    (set! sec (call out_at scratch))
    (call emit_name sec "name")
    (call put_byte sec 1)
    (call emit_sized sec fnames)
    (call emit_section o 0 sec)
    ;; where each call and trapping instruction is in the source
    (when (gt (call (vec.len (ptr FnLines)) fn_lines) 0)
          (set! sec (call out_at scratch))
          (call emit_name sec "aipl.lines")
          (call emit_lines sec fn_lines)
          (call emit_section o 0 sec))

    (if (gt (get o Out.pos) cap) (call set_compile_error CgErr.output_full) 0)
    (mem.store32 60 out)
    (if (call has_compile_error) -1 (get o Out.pos))))

;; ===== Threaded modules: generated functions (wasm.rs threaded_init_function, thread_start_function) =====

  ;; The start function body (no locals): the first instance copies the heap
  ;; cursor and the string literals into the shared memory, guarded by the
  ;; flag at 88. Returns the byte count.
  (fn threaded_init_body [o:(ptr Out) blob_len:i32] -> void
    (call put_byte o 0)
    (call emit_i32_const o 88)
    (call emit_i32_const o 0)
    (call emit_i32_const o 1)
    (call emit_atomic o ATOMIC_RMW_CMPXCHG)
    (call put_op o OP_I32_EQZ)
    (call put_op o OP_IF)
    (call put_byte o BLOCK_EMPTY)
    (call emit_i32_const o 0)
    (call emit_i32_const o 0)
    (call emit_i32_const o 4)
    (call emit_memory_init o 0)
    (when (gt blob_len 0)
          (call emit_i32_const o 1024)
          (call emit_i32_const o 0)
          (call emit_i32_const o blob_len)
          (call emit_memory_init o 1))
    (call put_op o OP_END)
    (call put_op o OP_END))



  ;; memory.init data_index, memory 0
  (fn emit_memory_init [o:(ptr Out) data_index:i32] -> void
    (call put_op o OP_PREFIX_MISC)
    (call put_byte o MISC_MEMORY_INIT)
    (call put_u32 o data_index)
    (call put_byte o 0))




  ;; wasi_thread_start(tid, rec) body (no locals): allocate this thread's
  ;; 24-byte runtime scratch block, run rec.fn(rec.arg) through the table,
  ;; store the result, set done, and wake joiners.
  (fn thread_start_body [o:(ptr Out) worker_type:i32] -> void
    (call put_byte o 0)
    (call emit_i32_const o 0)
    (call emit_i32_const o 24)
    (call emit_rmw_add o)
    (call put_op o OP_GLOBAL_SET) ;; global.set 0
    (call put_byte o 0)
    (call emit_grow_to_cursor o)
    (call emit_local_get o 1)
    (call emit_local_get o 1)
    (call emit_memop_offset o OP_I32_LOAD 2 12)
    (call emit_local_get o 1)
    (call emit_memop_offset o OP_I32_LOAD 2 8)
    (call put_op o OP_CALL_INDIRECT)
    (call put_u32 o worker_type)
    (call put_byte o 0)
    (call emit_memop_offset o OP_I32_STORE 2 4)
    (call emit_local_get o 1)
    (call emit_i32_const o 1)
    (call emit_atomic o ATOMIC_STORE) ;; i32.atomic.store
    (call emit_local_get o 1)
    (call emit_i32_const o -1)
    (call emit_atomic o ATOMIC_NOTIFY) ;; memory.atomic.notify
    (call put_op o OP_DROP)
    (call put_op o OP_END))



    ;; ===== Harnesses =====
  (fn test_signatures_and_locals [] -> i32
    (let _kw_init:i32 (call init_keywords))
    (let text:str "(module test_mod (fn add [a:i32 b:i32] -> i32 (+ a b)) (fn compute [x:i32] -> i32 (let y:i32 (call add x 5)) (let z:i32 0) (counted_loop i 0 9 1 (set! z (+ z i))) (+ y z)))")
    (let src:i32 (str.ptr text))
    (let tok:i32 (mem.alloc (* (sizeof compiler.Token) (+ (str.len text) 1))))
    (let n:i32 (call compiler.tokenize src (str.len text) tok))
    (let ast:i32 (mem.alloc (* (sizeof compiler.Node) (+ n 2))))
    (let root:(ptr compiler.Node) (call compiler.parse_ast tok n ast))
    (let cg:(ptr Cg) (call new_cg src))
    (let func_count:i32 (call collect_functions cg root))
    (put cg Cg.nfns func_count)
    (let e0:(ptr FnInfo) (call func_entry_ptr cg 0))
    (let e0_pcount:i32 (get e0 FnInfo.nparams))
    (let e0_ret:Ty (get e0 FnInfo.ret))
    (let e1:(ptr FnInfo) (call func_entry_ptr cg 1))
    (let local_count:i32 (call collect_locals_for_function cg e1))
    ;; compute's locals: x, y, z, i, and the loop's hidden end and step
    (if (and (eq func_count 2) (and (eq e0_pcount 2) (and (eq e0_ret Ty.i32) (eq local_count 6))))
        1
        0))

  ;; Compiles `text`: the module length if it compiled without error and
  ;; starts with the wasm magic and version, else -1. Byte-for-byte
  ;; agreement with the Rust backend is checked by tests/test_selfhost.rs.
  (fn compiles [text:str] -> i32
    (unsafe (let len:i32 (call compile_module (str.ptr text) (str.len text)))
    (when (or (lte len 0) (call has_compile_error)) (return -1))
    (let out:i32 (mem.load32 60))
    (if (and (eq (mem.load32 out) 1836278016) (eq (mem.load32 (+ out 4)) 1)) len -1)))

  (fn test_compile_add [] -> i32
    (call compiles "(module add (fn add [a:i32 b:i32] -> i32 (+ a b)))"))

  (fn test_compile_compute [] -> i32
    (call compiles "(module compute (fn add [a:i32 b:i32] -> i32 (+ a b)) (fn compute [x:i32] -> i32 (let y:i32 (call add x 5)) (let z:i32 0) (counted_loop i 0 9 1 (set! z (+ z i))) (+ y z)))"))

  (fn test_compile_store [] -> i32
    (call compiles "(module store (fn add [a:i32 b:i32] -> i32 (mem.store32 a b) (mem.load32 a)))"))

  ;; Group runner for `aipl test` / test_suite.aipl
  (fn run_codegen_tests [] -> i32 (pub)
    (let passed:i32 0)
    (when (eq (call test_signatures_and_locals) 1) (set! passed (+ passed 1)))
    (when (gt (call test_compile_add) 0) (set! passed (+ passed 1)))
    (when (gt (call test_compile_compute) 0) (set! passed (+ passed 1)))
    (when (gt (call test_compile_store) 0) (set! passed (+ passed 1)))
    passed)


;; ===== Bounds-failure helpers (wasm.rs oob_functions) =====
  ;; A compiled check's message goes in the reserved runtime block at 128,
  ;; its address and length in cells 92 and 96 (AIPL_SPEC.md 7.9).
  (const RT_FAIL_TEXT:i32 128)

  ;; Writes text t at the address local `at_local` holds (or, if it is -1,
  ;; at `at`), eight bytes per i64.store, the last chunk zero-padded
  ;; (wasm.rs emit_text_store).
  (fn emit_text_store [o:(ptr Out) at_local:i32 at:i32 t:str] -> void
    (unsafe (let n:i32 (str.len t))
    (let p:i32 (str.ptr t))
    (let k:i32 0)
    (while (lt k n)
      (let word:i64 0i64)
      (for j 0 8
        (when (lt (+ k j) n)
            (set! word (bitor word (shl (i64.extend_u (mem.load8 (+ p (+ k j)))) (i64.extend_u (* j 8)))))))
      (if (gte at_local 0) (call emit_local_get o at_local) (call emit_i32_const o at))
      (call put_op o OP_I64_CONST)
      (call put_s64 o word)
      (call put_op o OP_I64_STORE)
      (call put_byte o 0)
      (call put_u32 o k)
      (set! k (+ k 8)))))

  ;; Check helper k of the eight (wasm.rs check_functions); base is $aipl_dec's index.
  (fn check_body [o:(ptr Out) k:i32 base:i32 max_pages:i32] -> void
    (cond
      ((eq k 0) (call dec_body o))
      ((eq k 1) (call oob_body o base))
      ((eq k 2) (call text_body o))
      ((eq k 3) (call begin_body o (+ base 2)))
      ((eq k 4) (call end_body o))
      ((eq k 5) (call fixed_text_body o "Null pointer dereference"))
      ((eq k 6) (call fixed_text_body o "Use after free"))
      (else (call fixed_text_body o (call oom_text max_pages)))))

  ;; What a program says when memory cannot grow to hold a mem.alloc, its
  ;; limit in MiB (wasm.rs oom_text).
  (fn oom_text [max_pages:i32] -> str
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 48))
    (call buf.push_str b "Out of memory: the limit is ")
    (call buf.push_int b (/ (if (gt max_pages 32768) 32768 max_pages) 16))
    (call buf.push_str b " MiB")
    (call buf.to_str b))

  ;; $aipl_null() / $aipl_uaf() / $aipl_oom(): the text at RT_FAIL_TEXT, its
  ;; address and length in cells 92 and 96, then a trap (wasm.rs NULL_TEXT,
  ;; UAF_TEXT, oom_text).
  (fn fixed_text_body [o:(ptr Out) text:str] -> void
    (call put_u32 o 0)
    (call emit_text_store o -1 RT_FAIL_TEXT text)
    (call emit_i32_const o 92) (call emit_i32_const o RT_FAIL_TEXT) (call emit_memop o OP_I32_STORE 2)
    (call emit_i32_const o 96) (call emit_i32_const o (str.len text)) (call emit_memop o OP_I32_STORE 2)
    (call put_op o OP_UNREACHABLE)
    (call put_op o OP_END))

  ;; $aipl_dec(at, v:i64) -> end: v in signed decimal at `at`; the address after it.
  (fn dec_body [o:(ptr Out)] -> void
    (call put_u32 o 2) (call put_u32 o 1) (call put_byte o VT_I64) (call put_u32 o 1) (call put_byte o VT_I32)   ;; t:i64 end
    (call emit_local_get o 1) (call emit_i64_zero o) (call put_op o OP_I64_LT_S)
    (call put_op o OP_IF) (call put_byte o BLOCK_EMPTY)
    (call emit_local_get o 0) (call emit_i32_const o 45) (call emit_memop o OP_I32_STORE8 0)
    (call emit_local_get o 0) (call emit_i32_const o 1) (call put_op o OP_I32_ADD) (call emit_local_set o 0)
    (call emit_i64_zero o) (call emit_local_get o 1) (call put_op o OP_I64_SUB) (call emit_local_set o 1)
    (call put_op o OP_END)
    ;; count the digits
    (call emit_local_get o 1) (call emit_local_set o 2)
    (call emit_local_get o 0) (call emit_i32_const o 1) (call put_op o OP_I32_ADD) (call emit_local_set o 3)
    (call put_op o OP_BLOCK) (call put_byte o BLOCK_EMPTY)
    (call put_op o OP_LOOP) (call put_byte o BLOCK_EMPTY)
    (call emit_local_get o 2) (call emit_i64_ten o) (call put_op o OP_I64_LT_U)
    (call put_op o OP_BR_IF) (call put_u32 o 1)
    (call emit_local_get o 2) (call emit_i64_ten o) (call put_op o OP_I64_DIV_U) (call emit_local_set o 2)
    (call emit_local_get o 3) (call emit_i32_const o 1) (call put_op o OP_I32_ADD) (call emit_local_set o 3)
    (call put_op o OP_BR) (call put_u32 o 0)
    (call put_op o OP_END)
    (call put_op o OP_END)
    ;; write them last to first
    (call emit_local_get o 3) (call emit_local_set o 0)
    (call put_op o OP_LOOP) (call put_byte o BLOCK_EMPTY)
    (call emit_local_get o 0) (call emit_i32_const o 1) (call put_op o OP_I32_SUB) (call emit_local_tee o 0)
    (call emit_local_get o 1) (call emit_i64_ten o) (call put_op o OP_I64_REM_U) (call put_op o OP_I32_WRAP_I64)
    (call emit_i32_const o 48) (call put_op o OP_I32_ADD) (call emit_memop o OP_I32_STORE8 0)
    (call emit_local_get o 1) (call emit_i64_ten o) (call put_op o OP_I64_DIV_U) (call emit_local_tee o 1)
    (call emit_i64_zero o) (call put_op o OP_I64_NE)
    (call put_op o OP_BR_IF) (call put_u32 o 0)
    (call put_op o OP_END)
    (call emit_local_get o 3)
    (call put_op o OP_END))

  (fn emit_i64_zero [o:(ptr Out)] -> void (call put_op o OP_I64_CONST) (call put_s64 o 0i64))
  (fn emit_i64_ten [o:(ptr Out)] -> void (call put_op o OP_I64_CONST) (call put_s64 o 10i64))

  ;; $aipl_oob(index, array): the VM's message at RT_FAIL_TEXT, its address
  ;; and length in cells 92 and 96, then a trap.
  (fn oob_body [o:(ptr Out) dec_fn:i32] -> void
    (let prefix:str "Array index out of bounds: index ")
    (let middle:str " for array of length ")
    (call put_u32 o 1) (call put_u32 o 1) (call put_byte o VT_I32)   ;; at
    (call emit_text_store o -1 RT_FAIL_TEXT prefix)
    (call emit_i32_const o (+ RT_FAIL_TEXT (str.len prefix)))
    (call emit_local_get o 0) (call put_op o OP_I64_EXTEND_I32_S)
    (call emit_call o dec_fn) (call emit_local_set o 2)
    (call emit_text_store o 2 0 middle)
    (call emit_local_get o 2) (call emit_i32_const o (str.len middle)) (call put_op o OP_I32_ADD)
    (call emit_local_get o 1) (call emit_i32_const o 4) (call put_op o OP_I32_SUB) (call emit_memop o OP_I32_LOAD 2)
    (call put_op o OP_I64_EXTEND_I32_S)
    (call emit_call o dec_fn) (call emit_local_set o 2)
    (call emit_i32_const o 92) (call emit_i32_const o RT_FAIL_TEXT) (call emit_memop o OP_I32_STORE 2)
    (call emit_i32_const o 96) (call emit_local_get o 2) (call emit_i32_const o RT_FAIL_TEXT) (call put_op o OP_I32_SUB)
    (call emit_memop o OP_I32_STORE 2)
    (call put_op o OP_UNREACHABLE)
    (call put_op o OP_END))

  ;; $aipl_text(at, addr, len) -> end: copies len bytes from addr to at.
  (fn text_body [o:(ptr Out)] -> void
    (call put_u32 o 0)
    (call put_op o OP_BLOCK) (call put_byte o BLOCK_EMPTY)
    (call put_op o OP_LOOP) (call put_byte o BLOCK_EMPTY)
    (call emit_local_get o 2) (call put_op o OP_I32_EQZ)
    (call put_op o OP_BR_IF) (call put_u32 o 1)
    (call emit_local_get o 0) (call emit_local_get o 1) (call emit_memop o OP_I32_LOAD8_U 0) (call emit_memop o OP_I32_STORE8 0)
    (for k 0 2 (call emit_local_get o k) (call emit_i32_const o 1) (call put_op o OP_I32_ADD) (call emit_local_set o k))
    (call emit_local_get o 2) (call emit_i32_const o 1) (call put_op o OP_I32_SUB) (call emit_local_set o 2)
    (call put_op o OP_BR) (call put_u32 o 0)
    (call put_op o OP_END)
    (call put_op o OP_END)
    (call emit_local_get o 0)
    (call put_op o OP_END))

  ;; $aipl_begin(addr, len, max) -> end: a message of at most max bytes at
  ;; the heap cursor (memory grown to hold it), its address in cell 92,
  ;; starting with the len bytes at addr.
  (fn begin_body [o:(ptr Out) text_fn:i32] -> void
    (call put_u32 o 1) (call put_u32 o 2) (call put_byte o VT_I32)   ;; at pages
    (call emit_i32_const o 0) (call emit_memop o OP_I32_LOAD 2) (call emit_local_set o 3)
    (call emit_local_get o 3) (call emit_local_get o 2) (call put_op o OP_I32_ADD)
    (call emit_i32_const o 65535) (call put_op o OP_I32_ADD)
    (call emit_i32_const o 16) (call put_op o OP_I32_SHR_U)
    (call put_op o OP_MEMORY_SIZE) (call put_byte o 0)
    (call put_op o OP_I32_SUB) (call emit_local_tee o 4)
    (call emit_i32_const o 0) (call put_op o OP_I32_GT_S)
    (call put_op o OP_IF) (call put_byte o BLOCK_EMPTY)
    (call emit_local_get o 4) (call put_op o OP_MEMORY_GROW) (call put_byte o 0) (call put_op o OP_DROP)
    (call put_op o OP_END)
    (call emit_i32_const o 92) (call emit_local_get o 3) (call emit_memop o OP_I32_STORE 2)
    (call emit_local_get o 3) (call emit_local_get o 0) (call emit_local_get o 1)
    (call emit_call o text_fn)
    (call put_op o OP_END))

  ;; $aipl_end(end): the message's length in cell 96, then a trap.
  (fn end_body [o:(ptr Out)] -> void
    (call put_u32 o 0)
    (call emit_i32_const o 96) (call emit_local_get o 0)
    (call emit_i32_const o 92) (call emit_memop o OP_I32_LOAD 2)
    (call put_op o OP_I32_SUB) (call emit_memop o OP_I32_STORE 2)
    (call put_op o OP_UNREACHABLE)
    (call put_op o OP_END))
)
