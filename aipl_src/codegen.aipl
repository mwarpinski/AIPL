    (let e1:i32 (call func_entry_ptr (mem.load32 20) 1))
    (let e1_pcount:i32 (mem.load32 (+ e1 8)))
    (let e1_ret:i32 (mem.load32 (+ e1 12)))
    (let local_count:i32 (call collect_locals_for_function src e1 (mem.load32 24)))
    (let l0_name:i32 (mem.load8 (+ src (mem.load32 (+ (mem.load32 24) 0)))))
    (let l1_name:i32 (mem.load8 (+ src (mem.load32 (+ (+ (mem.load32 24) 12) 0)))))
    (let l2_name:i32 (mem.load8 (+ src (mem.load32 (+ (+ (mem.load32 24) 24) 0)))))
    (let l3_name:i32 (mem.load8 (+ src (mem.load32 (+ (+ (mem.load32 24) 36) 0)))))
