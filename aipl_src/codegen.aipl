  ;; ===== Low-level WASM instruction emitters =====

  (fn encode_s32 [ptr:i32 val:i32] -> i32
    (let bytes_written:i32 0)
    (let value:i32 val)
    (let more:bool true)
    (while more
      (let byte_val:i32 (bitand value 127))
      (set! value (shr value 7))
      (let sign_bit:i32 (bitand byte_val 64))
      (let done_now:bool false)
      (if (and (eq value 0) (eq sign_bit 0))
          (set! done_now true)
          (if (and (eq value -1) (neq sign_bit 0))
              (set! done_now true)
              (set! done_now false)))
      (let byte_out:i32 byte_val)
      (if done_now (set! byte_out byte_val) (set! byte_out (bitor byte_val 128)))
      (mem.store8 (+ ptr bytes_written) byte_out)
      (set! bytes_written (+ bytes_written 1))
      (if done_now (set! more false) (set! more true)))
    bytes_written)

  (fn emit_byte [ptr:i32 b:i32] -> i32
    (mem.store8 ptr b)
    1)

  (fn emit_i32_const [ptr:i32 val:i32] -> i32
    (mem.store8 ptr 65)
    (+ 1 (call encode_s32 (+ ptr 1) val)))

  (fn emit_local_get [ptr:i32 idx:i32] -> i32
    (mem.store8 ptr 32)
    (+ 1 (call compiler.encode_u32 (+ ptr 1) idx)))

  (fn emit_local_set [ptr:i32 idx:i32] -> i32
    (mem.store8 ptr 33)
    (+ 1 (call compiler.encode_u32 (+ ptr 1) idx)))

  (fn emit_call [ptr:i32 idx:i32] -> i32
    (mem.store8 ptr 16)
    (+ 1 (call compiler.encode_u32 (+ ptr 1) idx)))

  (fn emit_memop [ptr:i32 opcode:i32 align:i32] -> i32
    (mem.store8 ptr opcode)
    (mem.store8 (+ ptr 1) align)
    (mem.store8 (+ ptr 2) 0)
    3)

  ;; Runtime memory-layout guard emitted before every store, byte-for-byte the
  ;; same sequence src/compiler/wasm.rs emits (emit_write_address_check):
  ;;   local.tee s ; local.get s ; i32.const 4 ; i32.lt_u
  ;;   local.get s ; i32.const 64 ; i32.sub ; i32.const 960 ; i32.lt_u
  ;;   i32.or ; if (empty) ; unreachable ; end
  ;; Traps if the address on the stack is in bytes 0-3 (heap cursor) or
  ;; 64-1023 (reserved). The address stays on the stack for the store.
  ;; scratch_idx is the extra i32 local every function body declares; its
  ;; index equals the total local count (params + lets + loop vars).
  (fn emit_store_guard [ptr:i32 scratch_idx:i32] -> i32
    (let off:i32 0)
    (set! off (+ off (call emit_byte (+ ptr off) 34)))                  ;; local.tee
    (set! off (+ off (call compiler.encode_u32 (+ ptr off) scratch_idx)))
    (set! off (+ off (call emit_local_get (+ ptr off) scratch_idx)))
    (set! off (+ off (call emit_i32_const (+ ptr off) 4)))
    (set! off (+ off (call emit_byte (+ ptr off) 73)))                  ;; i32.lt_u
    (set! off (+ off (call emit_local_get (+ ptr off) scratch_idx)))
    (set! off (+ off (call emit_i32_const (+ ptr off) 64)))
    (set! off (+ off (call emit_byte (+ ptr off) 107)))                 ;; i32.sub
    (set! off (+ off (call emit_i32_const (+ ptr off) 960)))
    (set! off (+ off (call emit_byte (+ ptr off) 73)))                  ;; i32.lt_u
    (set! off (+ off (call emit_byte (+ ptr off) 114)))                 ;; i32.or
    (set! off (+ off (call emit_byte (+ ptr off) 4)))                   ;; if
    (set! off (+ off (call emit_byte (+ ptr off) 64)))                  ;; blocktype: empty
    (set! off (+ off (call emit_byte (+ ptr off) 0)))                   ;; unreachable
    (set! off (+ off (call emit_byte (+ ptr off) 11)))                  ;; end
    off)

  ;; Maps an operator id (0-23, from classify_keyword) to its real wasm
  ;; opcode byte, matching src/compiler/wasm.rs exactly. Memory ops are
  ;; handled by the caller via emit_memop instead (they need a memarg).
  (fn emit_binop [ptr:i32 op_id:i32] -> i32
    (if (eq op_id 0) (call emit_byte ptr 106)
    (if (eq op_id 1) (call emit_byte ptr 107)
    (if (eq op_id 2) (call emit_byte ptr 108)
    (if (eq op_id 3) (call emit_byte ptr 109)
    (if (eq op_id 4) (call emit_byte ptr 115)
    (if (eq op_id 5) (call emit_byte ptr 116)
    (if (eq op_id 6) (call emit_byte ptr 117)
    (if (eq op_id 7) (call emit_byte ptr 113)
    (if (eq op_id 8) (call emit_byte ptr 114)
    (if (eq op_id 15) (call emit_byte ptr 70)
    (if (eq op_id 16) (call emit_byte ptr 71)
    (if (eq op_id 17) (call emit_byte ptr 72)
    (if (eq op_id 18) (call emit_byte ptr 76)
    (if (eq op_id 19) (call emit_byte ptr 74)
    (if (eq op_id 20) (call emit_byte ptr 78)
    (if (eq op_id 21) (call emit_byte ptr 113)
    (if (eq op_id 22) (call emit_byte ptr 114)
    (if (eq op_id 23) (call emit_byte ptr 69)
    -1)))))))))))))))))))

  ;; ===== Voidness classification (mirrors wasm.rs's is_void_expr, fixed
  ;; version - both branches of an if must be void for the if itself to be
  ;; void; a call is void iff the target function's return type is void) =====

  (fn is_void_op [op_id:i32] -> bool
    (or (eq op_id 12) (or (eq op_id 13) (eq op_id 14))))

  (fn last_child [group:i32] -> i32
    (let cur:i32 (call node_a group))
    (let done:bool false)
    (while (not done)
      (let nxt:i32 (call node_next cur))
      (if (eq nxt 0)
          (block (set! done true) 0)
          (block (set! cur nxt) 0)))
    cur)

  (fn group_head_keyword [src_ptr:i32 group:i32] -> i32
    (let head:i32 (call node_a group))
    (if (neq (call node_kind head) 6)
        -1
        (call classify_keyword src_ptr (call node_a head) (call node_b head))))

  (fn is_void_call [src_ptr:i32 node:i32 func_table_base:i32 func_count:i32] -> bool
    (let fname:i32 (call nth_child node 1))
    (let fidx:i32 (call find_function src_ptr func_table_base func_count (call node_a fname) (call node_b fname)))
    (if (eq fidx -1)
        false
        (eq (mem.load32 (+ (call func_entry_ptr func_table_base fidx) 12)) 205)))

  (fn is_void_node [src_ptr:i32 node:i32 func_table_base:i32 func_count:i32] -> bool
    (if (neq (call node_kind node) 20)
        false
        (block
          (let kw:i32 (call group_head_keyword src_ptr node))
          (if (eq kw 100) true
          (if (eq kw 101) true
          (if (eq kw 103) true
          (if (eq kw 104) true
          (if (eq kw 106)
              (call is_void_node src_ptr (call last_child node) func_table_base func_count)
              (if (eq kw 102)
                  (and (call is_void_node src_ptr (call nth_child node 2) func_table_base func_count)
                       (call is_void_node src_ptr (call nth_child node 3) func_table_base func_count))
                  (if (eq kw 105)
                      (call is_void_call src_ptr node func_table_base func_count)
                      (if (gte kw 0)
                          (call is_void_op kw)
                          false)))))))))))


  ;; ===== Compile error signaling =====
  ;; No exception mechanism exists, so an unsupported construct sets a flag
  ;; at runtime cell mem[4] rather than propagating a Result through every
  ;; call site; the top-level entry point checks it once at the end. Bytes
  ;; still get emitted at the error site so byte-offset bookkeeping stays
  ;; consistent, but the caller must discard the whole output once the flag
  ;; is set - it is never a valid program.
  (fn set_compile_error [] -> i32
    (mem.store32 4 1)
    0)

  (fn has_compile_error [] -> bool
    (neq (mem.load32 4) 0))

  ;; ===== Expression / statement codegen =====

  (fn compile_expr [src_ptr:i32 node:i32 out_ptr:i32 locals_base:i32 locals_count:i32 func_table_base:i32 func_count:i32] -> i32
    (let kind:i32 (call node_kind node))
    (if (eq kind 7) (call emit_i32_const out_ptr (call node_a node))
    (if (eq kind 8) (call emit_i32_const out_ptr (call node_a node))
    (if (eq kind 9) (call emit_i32_const out_ptr 0)
    (if (eq kind 6)
        (block
          (let idx:i32 (call find_local locals_base locals_count src_ptr (call node_a node) (call node_b node)))
          (if (eq idx -1)
              (block (let _e:i32 (call set_compile_error)) (call emit_i32_const out_ptr 0))
              (call emit_local_get out_ptr idx)))
        (call compile_group src_ptr node out_ptr locals_base locals_count func_table_base func_count))))))

  (fn compile_group [src_ptr:i32 node:i32 out_ptr:i32 locals_base:i32 locals_count:i32 func_table_base:i32 func_count:i32] -> i32
    (let kw:i32 (call group_head_keyword src_ptr node))
    (if (eq kw 100) (call compile_let src_ptr node out_ptr locals_base locals_count func_table_base func_count)
    (if (eq kw 101) (call compile_set src_ptr node out_ptr locals_base locals_count func_table_base func_count)
    (if (eq kw 102) (call compile_if src_ptr node out_ptr locals_base locals_count func_table_base func_count)
    (if (eq kw 103) (call compile_loop src_ptr node out_ptr locals_base locals_count func_table_base func_count)
    (if (eq kw 104) (call compile_while src_ptr node out_ptr locals_base locals_count func_table_base func_count)
    (if (eq kw 105) (call compile_call src_ptr node out_ptr locals_base locals_count func_table_base func_count)
    (if (eq kw 106) (call compile_block src_ptr node out_ptr locals_base locals_count func_table_base func_count)
    (if (gte kw 0)
        (call compile_op src_ptr kw node out_ptr locals_base locals_count func_table_base func_count)
