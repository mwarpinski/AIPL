;; AIPL Dual-Target Sovereign Compiler Engine
;; Written 100% in canonical AIPL S-Expressions
;; Supports dynamic S-expression parsing, symbol table resolution, and dual-target Wasm & ELF64 native code generation

(module aipl_compiler

  ;; LEB128 Unsigned 32-bit Integer Encoder
  (fn encode_u32 [ptr:i32 val:i32] -> i32
    (req (gte ptr 0))
    (req (gte val 0))
    (ens (gt res 0))
    (let bytes_written:i32 0)
    (let temp:i32 val)
    (let keep_looping:bool true)
    (while keep_looping
      (let byte_val:i32 (bitand temp 127))
      (set! temp (shr temp 7))
      (let byte_out:i32 byte_val)
      (if (neq temp 0)
        (set! byte_out (bitor byte_val 128))
        (set! byte_out byte_val))
      (mem.store32 (+ ptr bytes_written) byte_out)
      (set! bytes_written (+ bytes_written 1))
      (if (eq temp 0)
        (set! keep_looping false)
        (set! keep_looping true)))
    bytes_written)

  ;; Wasm Header Emitter (\0asm version 1)
  (fn emit_header [ptr:i32] -> i32
    (req (gte ptr 0))
    (ens (eq res 8))
    (mem.store32 (+ ptr 0) 0)   ;; \0
    (mem.store32 (+ ptr 1) 97)  ;; a
    (mem.store32 (+ ptr 2) 115) ;; s
    (mem.store32 (+ ptr 3) 109) ;; m
    (mem.store32 (+ ptr 4) 1)   ;; v1
    (mem.store32 (+ ptr 5) 0)
    (mem.store32 (+ ptr 6) 0)
    (mem.store32 (+ ptr 7) 0)
    8)

  ;; ===== Real Tokenizer =====
  ;; Token record layout: 12 bytes per token at (tok_ptr + idx*12) = [kind:i32, a:i32, b:i32]
  ;; kind: 0=LParen 1=RParen 2=LBracket 3=RBracket 4=Colon 5=Arrow
  ;;       6=Symbol(a=src offset,b=length) 7=IntLit(a=value) 8=BoolLit(a=0/1)
  ;;       9=StringLit(a=src offset of first char inside quotes,b=length)
  ;; Mirrors src/parser.rs::Parser::tokenize exactly (same delimiter set, same
  ;; keyword/int classification rules) so the two tokenizers accept identical input.

  (fn is_whitespace [ch:i32] -> bool
    (or (or (eq ch 32) (eq ch 9)) (or (eq ch 13) (eq ch 10))))

  (fn is_delim [ch:i32] -> bool
    (or (call is_whitespace ch)
        (or (or (eq ch 40) (eq ch 41)) (or (or (eq ch 91) (eq ch 93)) (eq ch 58)))))

  (fn is_digit [ch:i32] -> bool
    (and (gte ch 48) (lte ch 57)))

  (fn write_token [tok_ptr:i32 idx:i32 kind:i32 a:i32 b:i32] -> i32
    (req (gte tok_ptr 0))
    (req (gte idx 0))
    (ens (eq res (+ idx 1)))
    (let base:i32 (+ tok_ptr (* idx 12)))
    (mem.store32 (+ base 0) kind)
    (mem.store32 (+ base 4) a)
    (mem.store32 (+ base 8) b)
    (+ idx 1))

  (fn is_arrow [src_ptr:i32 pos:i32 len:i32] -> bool
    (if (neq len 2)
        false
        (and (eq (mem.load8 (+ src_ptr pos)) 45)
             (eq (mem.load8 (+ src_ptr (+ pos 1))) 62))))

  (fn is_true_kw [src_ptr:i32 pos:i32 len:i32] -> bool
    (if (neq len 4)
        false
        (and (eq (mem.load8 (+ src_ptr pos)) 116)
        (and (eq (mem.load8 (+ src_ptr (+ pos 1))) 114)
        (and (eq (mem.load8 (+ src_ptr (+ pos 2))) 117)
             (eq (mem.load8 (+ src_ptr (+ pos 3))) 101))))))

  (fn is_false_kw [src_ptr:i32 pos:i32 len:i32] -> bool
    (if (neq len 5)
        false
        (and (eq (mem.load8 (+ src_ptr pos)) 102)
        (and (eq (mem.load8 (+ src_ptr (+ pos 1))) 97)
        (and (eq (mem.load8 (+ src_ptr (+ pos 2))) 108)
        (and (eq (mem.load8 (+ src_ptr (+ pos 3))) 115)
             (eq (mem.load8 (+ src_ptr (+ pos 4))) 101)))))))

  ;; True if the span is a valid integer literal: optional leading '-' then >=1 digits.
  (fn is_int_literal [src_ptr:i32 pos:i32 len:i32] -> bool
    (req (gte pos 0))
    (req (gt len 0))
    (let has_sign:bool (eq (mem.load8 (+ src_ptr pos)) 45))
    (let start:i32 pos)
    (let digit_len:i32 len)
    (if has_sign (set! start (+ pos 1)) (set! start start))
    (if has_sign (set! digit_len (- len 1)) (set! digit_len digit_len))
    (if (eq digit_len 0)
        false
        (block
          (let all_digits:bool true)
          (let i:i32 0)
          (while (lt i digit_len)
            (if (call is_digit (mem.load8 (+ src_ptr (+ start i))))
                (set! all_digits all_digits)
                (set! all_digits false))
            (set! i (+ i 1)))
          all_digits)))

  (fn parse_int_literal [src_ptr:i32 pos:i32 len:i32] -> i32
    (req (gte pos 0))
    (req (gt len 0))
    (let has_sign:bool (eq (mem.load8 (+ src_ptr pos)) 45))
    (let start:i32 pos)
    (let digit_len:i32 len)
    (if has_sign (set! start (+ pos 1)) (set! start start))
    (if has_sign (set! digit_len (- len 1)) (set! digit_len digit_len))
    (let value:i32 0)
    (let i:i32 0)
    (while (lt i digit_len)
      (set! value (+ (* value 10) (- (mem.load8 (+ src_ptr (+ start i))) 48)))
      (set! i (+ i 1)))
    (if has_sign (- 0 value) value))

  ;; Dynamic Tokenizer Pass: scans real source bytes and writes real token records.
  (fn tokenize [input_ptr:i32 input_len:i32 token_out_ptr:i32] -> i32
    (req (gte input_ptr 0))
    (req (gte input_len 0))
    (req (gte token_out_ptr 0))
    (ens (gte res 0))
    (let i:i32 0)
    (let count:i32 0)
    (while (lt i input_len)
      (let ch:i32 (mem.load8 (+ input_ptr i)))
      (if (call is_whitespace ch)
          (set! i (+ i 1))
          (if (eq ch 59)
              (block
                (while (and (lt i input_len) (neq (mem.load8 (+ input_ptr i)) 10))
                  (set! i (+ i 1)))
                (if (lt i input_len) (set! i (+ i 1)) (set! i i)))
              (if (eq ch 40)
                  (block (set! count (call write_token token_out_ptr count 0 0 0)) (set! i (+ i 1)))
                  (if (eq ch 41)
                      (block (set! count (call write_token token_out_ptr count 1 0 0)) (set! i (+ i 1)))
                      (if (eq ch 91)
                          (block (set! count (call write_token token_out_ptr count 2 0 0)) (set! i (+ i 1)))
                          (if (eq ch 93)
                              (block (set! count (call write_token token_out_ptr count 3 0 0)) (set! i (+ i 1)))
                              (if (eq ch 58)
                                  (block (set! count (call write_token token_out_ptr count 4 0 0)) (set! i (+ i 1)))
                                  (if (eq ch 34)
                                      (block
                                        (set! i (+ i 1))
                                        (let str_start:i32 i)
                                        (while (and (lt i input_len) (neq (mem.load8 (+ input_ptr i)) 34))
                                          (set! i (+ i 1)))
                                        (let str_len:i32 (- i str_start))
                                        (set! count (call write_token token_out_ptr count 9 str_start str_len))
                                        (if (lt i input_len) (set! i (+ i 1)) (set! i i)))
                                      (block
                                        (let sym_start:i32 i)
                                        (while (and (lt i input_len) (not (call is_delim (mem.load8 (+ input_ptr i)))))
                                          (set! i (+ i 1)))
                                        (let sym_len:i32 (- i sym_start))
                                        (if (call is_arrow input_ptr sym_start sym_len)
                                            (set! count (call write_token token_out_ptr count 5 0 0))
                                            (if (call is_true_kw input_ptr sym_start sym_len)
                                                (set! count (call write_token token_out_ptr count 8 1 0))
                                                (if (call is_false_kw input_ptr sym_start sym_len)
                                                    (set! count (call write_token token_out_ptr count 8 0 0))
                                                    (if (call is_int_literal input_ptr sym_start sym_len)
                                                        (set! count (call write_token token_out_ptr count 7 (call parse_int_literal input_ptr sym_start sym_len) 0))
                                                        (set! count (call write_token token_out_ptr count 6 sym_start sym_len))))))))))))))))
    count)

  ;; Symbol Table Lookup Pass: maps variable names to local register/stack indices (0, 1, 2, 3...)
  (fn resolve_symbol_index [symbol_id:i32 sym_table_ptr:i32 sym_count:i32] -> i32
    (req (gte symbol_id 0))
    (req (gte sym_table_ptr 0))
    (ens (gte res 0))
    (let index:i32 0)
    (let found:bool false)
    (loop i 0 sym_count 1
      (let entry:i32 (mem.load32 (+ sym_table_ptr (* i 4))))
      (if (eq entry symbol_id)
        (block
          (set! index i)
          (set! found true)
          index)
        index))
    (if found index sym_count))

  ;; ===== Real Parser: tokens -> generic S-expression tree in memory =====
  ;; Node record: 16 bytes at (ast_buf + 8 + offset) = [kind:i32, a:i32, b:i32, next_sibling:i32]
  ;;   Atom kinds match token kinds: 6=Symbol(a=src offset,b=len) 7=IntLit(a=value)
  ;;                                 8=BoolLit(a=0/1) 9=StringLit(a=src offset,b=len)
  ;;   Group kinds: 20=Paren-group "(...)"  21=Bracket-group "[...]"
  ;;     For groups: a=pointer to first child node (0 if empty), b=child count
  ;;   next_sibling: pointer to the next node in the same parent list, 0=end of list
  ;;
  ;; ast_buf header (the 8 bytes before any node): [0]=next_free_offset (bump
  ;; allocator state), [4]=current token index (parser state). AIPL functions
  ;; only return one value, so mutable state shared across recursive calls
  ;; (the allocator cursor, the parse position) lives in a well-known memory
  ;; cell instead of being threaded through return values.

  (fn ast_alloc_node [ast_buf:i32 kind:i32 a:i32 b:i32] -> i32
    (req (gte ast_buf 0))
    (ens (gt res ast_buf))
    (let next_free:i32 (mem.load32 ast_buf))
    (let node_ptr:i32 (+ ast_buf (+ 8 next_free)))
    (mem.store32 (+ node_ptr 0) kind)
    (mem.store32 (+ node_ptr 4) a)
    (mem.store32 (+ node_ptr 8) b)
    (mem.store32 (+ node_ptr 12) 0)
    (mem.store32 ast_buf (+ next_free 16))
    node_ptr)

  (fn tok_field [tokens_ptr:i32 idx:i32 field:i32] -> i32
    (req (gte idx 0))
    (mem.load32 (+ tokens_ptr (+ (* idx 12) (* field 4)))))

  ;; Recursive-descent reader: consumes one atom or one balanced
  ;; parenthesized/bracketed group starting at the current token index (held
  ;; in the memory cell at state_ptr), returning the new node's pointer.
  (fn parse_node [tokens_ptr:i32 token_count:i32 ast_buf:i32 state_ptr:i32] -> i32
    (req (gte tokens_ptr 0))
    (req (gte ast_buf 0))
    (req (gte state_ptr 0))
    (ens (gt res 0))
    (let idx:i32 (mem.load32 state_ptr))
    (let kind:i32 (call tok_field tokens_ptr idx 0))
    (if (or (eq kind 0) (eq kind 2))
        (block
          (let group_kind:i32 (if (eq kind 0) 20 21))
          (let close_kind:i32 (if (eq kind 0) 1 3))
          (mem.store32 state_ptr (+ idx 1))
          (let first_child:i32 0)
          (let prev_child:i32 0)
          (let count:i32 0)
          (let done:bool false)
          (while (not done)
            (let cur_idx:i32 (mem.load32 state_ptr))
            (if (or (gte cur_idx token_count) (eq (call tok_field tokens_ptr cur_idx 0) close_kind))
                (block (set! done true) 0)
                (block
                  (let child:i32 (call parse_node tokens_ptr token_count ast_buf state_ptr))
                  (if (eq prev_child 0)
                      (set! first_child child)
                      (block (mem.store32 (+ prev_child 12) child) (set! first_child first_child)))
                  (set! prev_child child)
                  (set! count (+ count 1))
                  0)))
          (let idx2:i32 (mem.load32 state_ptr))
          (if (lt idx2 token_count) (mem.store32 state_ptr (+ idx2 1)) (mem.store32 state_ptr idx2))
          (call ast_alloc_node ast_buf group_kind first_child count))
        (block
          (let a:i32 (call tok_field tokens_ptr idx 1))
          (let b:i32 (call tok_field tokens_ptr idx 2))
          (mem.store32 state_ptr (+ idx 1))
          (call ast_alloc_node ast_buf kind a b))))

  ;; Dynamic AST Parser Pass: turns a real token stream into a real tree.
  (fn parse_ast [token_ptr:i32 token_count:i32 ast_out_ptr:i32] -> i32
    (req (gte token_ptr 0))
    (req (gte token_count 0))
    (req (gte ast_out_ptr 0))
    (ens (gt res 0))
    (mem.store32 (+ ast_out_ptr 0) 0)
    (mem.store32 (+ ast_out_ptr 4) 0)
    (call parse_node token_ptr token_count ast_out_ptr (+ ast_out_ptr 4)))

  ;; Wasm Binary Emitter Pass
  (fn emit_wasm_binary [ast_ptr:i32 wasm_out_ptr:i32] -> i32
    (req (gte ast_ptr 0))
    (req (gte wasm_out_ptr 0))
    (ens (gt res 20))
    (let offset:i32 0)
    (set! offset (+ offset (call emit_header (+ wasm_out_ptr offset))))

    ;; Type Section (0x01)
    (mem.store32 (+ wasm_out_ptr offset) 1) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 7) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 1) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 96) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 2) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 127) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 127) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 1) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 127) (set! offset (+ offset 1))

    ;; Function Section (0x03)
    (mem.store32 (+ wasm_out_ptr offset) 3) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 2) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 1) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 0) (set! offset (+ offset 1))

    ;; Export Section (0x07)
    (mem.store32 (+ wasm_out_ptr offset) 7) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 8) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 1) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 4) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 109) (set! offset (+ offset 1)) ;; m
    (mem.store32 (+ wasm_out_ptr offset) 97)  (set! offset (+ offset 1)) ;; a
    (mem.store32 (+ wasm_out_ptr offset) 105) (set! offset (+ offset 1)) ;; i
    (mem.store32 (+ wasm_out_ptr offset) 110) (set! offset (+ offset 1)) ;; n
    (mem.store32 (+ wasm_out_ptr offset) 0)   (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 0)   (set! offset (+ offset 1))

    ;; Code Section (0x0a)
    (mem.store32 (+ wasm_out_ptr offset) 10) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 9)  (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 1)  (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 7)  (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 0)  (set! offset (+ offset 1))

    (mem.store32 (+ wasm_out_ptr offset) 32) (set! offset (+ offset 1)) ;; local.get 0
    (mem.store32 (+ wasm_out_ptr offset) 0)  (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 32) (set! offset (+ offset 1)) ;; local.get 1
    (mem.store32 (+ wasm_out_ptr offset) 1)  (set! offset (+ offset 1))

    (let op:i32 (mem.load32 (+ ast_ptr 12)))
    (mem.store32 (+ wasm_out_ptr offset) op) (set! offset (+ offset 1))
    (mem.store32 (+ wasm_out_ptr offset) 11) (set! offset (+ offset 1)) ;; end

    offset)

  ;; DUAL-TARGET COMPILER ENTRY POINT (target_flag: 0 = Wasm, 1 = Native ELF64)
  (fn compile_to_target [source_ptr:i32 source_len:i32 out_ptr:i32 target_flag:i32] -> i32
    (req (gte source_ptr 0))
    (req (gt source_len 0))
    (req (gte out_ptr 0))
    (req (gte target_flag 0))
    (ens (gt res 0))
    (let tokens_buf:i32 2048)
    (let ast_buf:i32 4096)
    (let token_count:i32 (call tokenize source_ptr source_len tokens_buf))
    (let ast_id:i32 (call parse_ast tokens_buf token_count ast_buf))

    (if (eq target_flag 0)
      ;; Target 0: WebAssembly Binary (.wasm)
      (call emit_wasm_binary ast_buf out_ptr)
      ;; Target 1: Bare-Metal Native ELF64 Binary (.elf)
      (block
        ;; ELF Header (64 bytes) + Program Header (56 bytes) + x86_64 Machine Code
        (mem.store32 (+ out_ptr 0) 1179403647) ;; \x7fELF
        (mem.store32 (+ out_ptr 4) 65538)
        (mem.store32 (+ out_ptr 24) 4194424)   ;; Entry point
        (mem.store32 (+ out_ptr 32) 64)        ;; Program header offset
        (mem.store32 (+ out_ptr 52) 3670080)
        (mem.store32 (+ out_ptr 56) 1)
        120)))

  ;; Backward-compatible compile_aipl entry point (defaults to Wasm)
  (fn compile_aipl [source_ptr:i32 source_len:i32 wasm_out_ptr:i32] -> i32
    (req (gte source_ptr 0))
    (req (gt source_len 0))
    (req (gte wasm_out_ptr 0))
    (ens (gt res 0))
    (call compile_to_target source_ptr source_len wasm_out_ptr 0))

  ;; ===== Tokenizer self-tests (content assertions, not just shape checks) =====
  ;; Each test builds a real source string byte-by-byte, tokenizes it, and checks
  ;; the exact token count/kinds/values/text-offsets produced.

  (fn test_tokenize_signature [] -> i32
    (ens (eq res 1))
    (let src1:i32 8000)
    (let tok1:i32 9000)
    (mem.store8 (+ src1 0) 40) ;; '('
    (mem.store8 (+ src1 1) 102) ;; 'f'
    (mem.store8 (+ src1 2) 110) ;; 'n'
    (mem.store8 (+ src1 3) 32) ;; ' '
    (mem.store8 (+ src1 4) 97) ;; 'a'
    (mem.store8 (+ src1 5) 100) ;; 'd'
    (mem.store8 (+ src1 6) 100) ;; 'd'
    (mem.store8 (+ src1 7) 32) ;; ' '
    (mem.store8 (+ src1 8) 91) ;; '['
    (mem.store8 (+ src1 9) 120) ;; 'x'
    (mem.store8 (+ src1 10) 58) ;; ':'
    (mem.store8 (+ src1 11) 105) ;; 'i'
    (mem.store8 (+ src1 12) 51) ;; '3'
    (mem.store8 (+ src1 13) 50) ;; '2'
    (mem.store8 (+ src1 14) 32) ;; ' '
    (mem.store8 (+ src1 15) 121) ;; 'y'
    (mem.store8 (+ src1 16) 58) ;; ':'
    (mem.store8 (+ src1 17) 105) ;; 'i'
    (mem.store8 (+ src1 18) 51) ;; '3'
    (mem.store8 (+ src1 19) 50) ;; '2'
    (mem.store8 (+ src1 20) 93) ;; ']'
    (mem.store8 (+ src1 21) 32) ;; ' '
    (mem.store8 (+ src1 22) 45) ;; '-'
    (mem.store8 (+ src1 23) 62) ;; '>'
    (mem.store8 (+ src1 24) 32) ;; ' '
    (mem.store8 (+ src1 25) 105) ;; 'i'
    (mem.store8 (+ src1 26) 51) ;; '3'
    (mem.store8 (+ src1 27) 50) ;; '2'
    (mem.store8 (+ src1 28) 32) ;; ' '
    (mem.store8 (+ src1 29) 40) ;; '('
    (mem.store8 (+ src1 30) 43) ;; '+'
    (mem.store8 (+ src1 31) 32) ;; ' '
    (mem.store8 (+ src1 32) 120) ;; 'x'
    (mem.store8 (+ src1 33) 32) ;; ' '
    (mem.store8 (+ src1 34) 121) ;; 'y'
    (mem.store8 (+ src1 35) 41) ;; ')'
    (mem.store8 (+ src1 36) 41) ;; ')'
    (let n:i32 (call tokenize src1 37 tok1))
    (let t0_kind:i32 (mem.load32 (+ tok1 0)))
    (let t1_kind:i32 (mem.load32 (+ tok1 12)))
    (let t1_a:i32 (mem.load32 (+ tok1 16)))
    (let t1_b:i32 (mem.load32 (+ tok1 20)))
    (let t11_kind:i32 (mem.load32 (+ tok1 132)))
    (let t18_kind:i32 (mem.load32 (+ tok1 216)))
    (let f_char:i32 (mem.load8 (+ src1 t1_a)))
    (if (and (eq n 19) (and (eq t0_kind 0) (and (eq t1_kind 6) (and (eq t1_b 2) (and (eq f_char 102) (and (eq t11_kind 5) (eq t18_kind 1)))))))
        1
        0))

  (fn test_tokenize_literals [] -> i32
    (ens (eq res 1))
    (let src2:i32 8100)
    (let tok2:i32 9100)
    (mem.store8 (+ src2 0) 52) ;; '4'
    (mem.store8 (+ src2 1) 50) ;; '2'
    (mem.store8 (+ src2 2) 32) ;; ' '
    (mem.store8 (+ src2 3) 45) ;; '-'
    (mem.store8 (+ src2 4) 55) ;; '7'
    (mem.store8 (+ src2 5) 32) ;; ' '
    (mem.store8 (+ src2 6) 116) ;; 't'
    (mem.store8 (+ src2 7) 114) ;; 'r'
    (mem.store8 (+ src2 8) 117) ;; 'u'
    (mem.store8 (+ src2 9) 101) ;; 'e'
    (mem.store8 (+ src2 10) 32) ;; ' '
    (mem.store8 (+ src2 11) 102) ;; 'f'
    (mem.store8 (+ src2 12) 97) ;; 'a'
    (mem.store8 (+ src2 13) 108) ;; 'l'
    (mem.store8 (+ src2 14) 115) ;; 's'
    (mem.store8 (+ src2 15) 101) ;; 'e'
    (mem.store8 (+ src2 16) 32) ;; ' '
    (mem.store8 (+ src2 17) 34) ;; '"'
    (mem.store8 (+ src2 18) 104) ;; 'h'
    (mem.store8 (+ src2 19) 105) ;; 'i'
    (mem.store8 (+ src2 20) 34) ;; '"'
    (mem.store8 (+ src2 21) 32) ;; ' '
    (mem.store8 (+ src2 22) 59) ;; ';'
    (mem.store8 (+ src2 23) 59) ;; ';'
    (mem.store8 (+ src2 24) 32) ;; ' '
    (mem.store8 (+ src2 25) 99) ;; 'c'
    (mem.store8 (+ src2 26) 111) ;; 'o'
    (mem.store8 (+ src2 27) 109) ;; 'm'
    (mem.store8 (+ src2 28) 109) ;; 'm'
    (mem.store8 (+ src2 29) 101) ;; 'e'
    (mem.store8 (+ src2 30) 110) ;; 'n'
    (mem.store8 (+ src2 31) 116) ;; 't'
    (mem.store8 (+ src2 32) 10) ;; '\n'
    (mem.store8 (+ src2 33) 57) ;; '9'
    (mem.store8 (+ src2 34) 57) ;; '9'
    (let n:i32 (call tokenize src2 35 tok2))
    (let t0_kind:i32 (mem.load32 (+ tok2 0)))
    (let t0_a:i32 (mem.load32 (+ tok2 4)))
    (let t1_kind:i32 (mem.load32 (+ tok2 12)))
    (let t1_a:i32 (mem.load32 (+ tok2 16)))
    (let t2_kind:i32 (mem.load32 (+ tok2 24)))
    (let t2_a:i32 (mem.load32 (+ tok2 28)))
    (let t3_kind:i32 (mem.load32 (+ tok2 36)))
    (let t3_a:i32 (mem.load32 (+ tok2 40)))
    (let t4_kind:i32 (mem.load32 (+ tok2 48)))
    (let t4_a:i32 (mem.load32 (+ tok2 52)))
    (let t4_b:i32 (mem.load32 (+ tok2 56)))
    (let t5_kind:i32 (mem.load32 (+ tok2 60)))
    (let t5_a:i32 (mem.load32 (+ tok2 64)))
    (let str_c0:i32 (mem.load8 (+ src2 t4_a)))
    (let str_c1:i32 (mem.load8 (+ src2 (+ t4_a 1))))
    (if (and (eq n 6) (and (eq t0_kind 7) (and (eq t0_a 42) (and (eq t1_kind 7) (and (eq t1_a -7) (and (eq t2_kind 8) (and (eq t2_a 1) (and (eq t3_kind 8) (and (eq t3_a 0) (and (eq t4_kind 9) (and (eq t4_b 2) (and (eq str_c0 104) (and (eq str_c1 105) (and (eq t5_kind 7) (eq t5_a 99)))))))))))))))
        1
        0))

  (fn run_tokenizer_tests [] -> i32
    (ens (gte res 0))
    (let p:i32 0)
    (let r1:i32 (call test_tokenize_signature))
    (if (eq r1 1) (set! p (+ p 1)) (set! p p))
    (let r2:i32 (call test_tokenize_literals))
    (if (eq r2 1) (set! p (+ p 1)) (set! p p))
    p)

  ;; ===== Parser self-tests (content assertions on the real tree shape) =====

  (fn test_parse_simple_call [] -> i32
    (ens (eq res 1))
    (let src:i32 8200)
    (let tok:i32 9200)
    (let ast:i32 9500)
    (mem.store8 (+ src 0) 40) ;; '('
    (mem.store8 (+ src 1) 43) ;; '+'
    (mem.store8 (+ src 2) 32) ;; ' '
    (mem.store8 (+ src 3) 49) ;; '1'
    (mem.store8 (+ src 4) 32) ;; ' '
    (mem.store8 (+ src 5) 50) ;; '2'
    (mem.store8 (+ src 6) 41) ;; ')'
    (let n:i32 (call tokenize src 7 tok))
    (let root:i32 (call parse_ast tok n ast))
    (let root_kind:i32 (mem.load32 (+ root 0)))
    (let root_a:i32 (mem.load32 (+ root 4)))
    (let root_b:i32 (mem.load32 (+ root 8)))
    (let c0:i32 root_a)
    (let c0_kind:i32 (mem.load32 (+ c0 0)))
    (let c0_a:i32 (mem.load32 (+ c0 4)))
    (let c0_b:i32 (mem.load32 (+ c0 8)))
    (let c1:i32 (mem.load32 (+ c0 12)))
    (let c1_kind:i32 (mem.load32 (+ c1 0)))
    (let c1_a:i32 (mem.load32 (+ c1 4)))
    (let c2:i32 (mem.load32 (+ c1 12)))
    (let c2_kind:i32 (mem.load32 (+ c2 0)))
    (let c2_a:i32 (mem.load32 (+ c2 4)))
    (let c2_next:i32 (mem.load32 (+ c2 12)))
    (let plus_char:i32 (mem.load8 (+ src c0_a)))
    (if (and (eq n 5) (and (eq root_kind 20) (and (eq root_b 3) (and (eq c0_kind 6) (and (eq c0_b 1) (and (eq plus_char 43) (and (eq c1_kind 7) (and (eq c1_a 1) (and (eq c2_kind 7) (and (eq c2_a 2) (eq c2_next 0)))))))))))
        1
        0))

  (fn test_parse_nested [] -> i32
    (ens (eq res 1))
    (let src:i32 8300)
    (let tok:i32 9600)
    (let ast:i32 9900)
    (mem.store8 (+ src 0) 40) ;; '('
    (mem.store8 (+ src 1) 102) ;; 'f'
    (mem.store8 (+ src 2) 110) ;; 'n'
    (mem.store8 (+ src 3) 32) ;; ' '
    (mem.store8 (+ src 4) 97) ;; 'a'
    (mem.store8 (+ src 5) 100) ;; 'd'
    (mem.store8 (+ src 6) 100) ;; 'd'
    (mem.store8 (+ src 7) 32) ;; ' '
    (mem.store8 (+ src 8) 91) ;; '['
    (mem.store8 (+ src 9) 120) ;; 'x'
    (mem.store8 (+ src 10) 58) ;; ':'
    (mem.store8 (+ src 11) 105) ;; 'i'
    (mem.store8 (+ src 12) 51) ;; '3'
    (mem.store8 (+ src 13) 50) ;; '2'
    (mem.store8 (+ src 14) 93) ;; ']'
    (mem.store8 (+ src 15) 32) ;; ' '
    (mem.store8 (+ src 16) 45) ;; '-'
    (mem.store8 (+ src 17) 62) ;; '>'
    (mem.store8 (+ src 18) 32) ;; ' '
    (mem.store8 (+ src 19) 105) ;; 'i'
    (mem.store8 (+ src 20) 51) ;; '3'
    (mem.store8 (+ src 21) 50) ;; '2'
    (mem.store8 (+ src 22) 32) ;; ' '
    (mem.store8 (+ src 23) 120) ;; 'x'
    (mem.store8 (+ src 24) 41) ;; ')'
    (let n:i32 (call tokenize src 25 tok))
    (let root:i32 (call parse_ast tok n ast))
    (let root_kind:i32 (mem.load32 (+ root 0)))
    (let root_b:i32 (mem.load32 (+ root 8)))
    (let c0:i32 (mem.load32 (+ root 4)))
    (let c1:i32 (mem.load32 (+ c0 12)))
    (let c2:i32 (mem.load32 (+ c1 12)))
    (let c2_kind:i32 (mem.load32 (+ c2 0)))
    (let c2_b:i32 (mem.load32 (+ c2 8)))
    (let bc0:i32 (mem.load32 (+ c2 4)))
    (let bc0_kind:i32 (mem.load32 (+ bc0 0)))
    (let bc0_a:i32 (mem.load32 (+ bc0 4)))
    (let bc0_b:i32 (mem.load32 (+ bc0 8)))
    (let bc1:i32 (mem.load32 (+ bc0 12)))
    (let bc1_kind:i32 (mem.load32 (+ bc1 0)))
    (let bc2:i32 (mem.load32 (+ bc1 12)))
    (let bc2_kind:i32 (mem.load32 (+ bc2 0)))
    (let bc2_a:i32 (mem.load32 (+ bc2 4)))
    (let bc2_b:i32 (mem.load32 (+ bc2 8)))
    (let bc2_next:i32 (mem.load32 (+ bc2 12)))
    (let x_char:i32 (mem.load8 (+ src bc0_a)))
    (if (and (eq n 12) (and (eq root_kind 20) (and (eq root_b 6) (and (eq c2_kind 21) (and (eq c2_b 3) (and (eq bc0_kind 6) (and (eq bc0_b 1) (and (eq x_char 120) (and (eq bc1_kind 4) (and (eq bc2_kind 6) (and (eq bc2_a 11) (and (eq bc2_b 3) (eq bc2_next 0)))))))))))))
        1
        0))

  (fn run_parser_tests [] -> i32
    (ens (gte res 0))
    (let p:i32 0)
    (let r1:i32 (call test_parse_simple_call))
    (if (eq r1 1) (set! p (+ p 1)) (set! p p))
    (let r2:i32 (call test_parse_nested))
    (if (eq r2 1) (set! p (+ p 1)) (set! p p))
    p))
