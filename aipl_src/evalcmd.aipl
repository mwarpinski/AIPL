;; aipl eval -e, in AIPL (src/evalexpr.rs is the Rust one): one or more
;; expressions, evaluated, and the last one's value printed with its type,
;; `49 : i32`.
;;
;;   aipl eval -e EXPRS [--with FILE] [--listen ADDR:PORT]... [--allow-run PROGRAM]...
;;                      [--max-memory SIZE] [-- ARGS...]
;;
;; The expressions become the body of a function, __eval, added at the end of
;; FILE's own module (so they may call its private functions; its main is not
;; run), or of an empty module; the standard modules they name are imported
;; for them. The wrapped module is checked with __eval returning void, which
;; gives the type of its last expression (driver.eval_type); the module is
;; then written again with __eval returning that type, a function __eval_print
;; that prints it with the formatting forms, and a _start calling that; it is
;; built as a native executable and run, its output and error kept apart, its
;; error with positions on the expressions' lines given as -e:LINE:COL. The
;; Rust command runs this in the VM; here every value is native (no `--wasm`).
(module evalcmd
  (import driver)
  (import native/native)
  (import stdpath)
  (import proc)
  (import fs)
  (import io)
  (import str)
  (import buf)
  (import alloc)
  (import option)
  (import os)
  (import vec)

  (fn usage [] -> i32
    (call io.eprintln "usage: aipl eval -e EXPRS [--with FILE] [--listen ADDR:PORT]... [--allow-run PROGRAM]... [--max-memory SIZE] [-- ARGS...]")
    2)

  (fn fail_bytes [prefix:str b:str.Bytes] -> i32
    (call io.write_str 2 "Error: ")
    (call io.write_str 2 prefix)
    (unsafe (fs.write 2 (call str.addr b) (get b str.Bytes.len)))
    (call io.eprintln "")
    1)

  (fn arg [i:i32] -> str.Bytes
    (call (option.unwrap_or str.Bytes) (call os.arg i) (call str.from_str "")))

  ;; ===== The wrapped module =====

  (fn is_space [c:i32] -> bool (or (eq c 32) (or (eq c 10) (or (eq c 9) (eq c 13)))))

  ;; The index of the first byte at or after i that is not white space.
  (fn skip_space [b:str.Bytes i:i32] -> i32
    (let n:i32 (get b str.Bytes.len))
    (while (and (lt i n) (call is_space (call str.byte_at b i))) (set! i (+ i 1)))
    i)

  ;; Whether b has `word` at i.
  (fn word_at [b:str.Bytes i:i32 word:str] -> bool
    (call str.is_at b i word))

  ;; The index of the ')' that closes the (module ...) form of `src`, or -1;
  ;; the module's name goes to `name` (src/evalexpr.rs module_form).
  (fn module_form [src:str.Bytes name:(ptr buf.Buf)] -> i32
    (let n:i32 (get src str.Bytes.len))
    (let i:i32 0)
    (let depth:i32 0)
    (let start:i32 -1)
    (while (lt i n)
      (let c:i32 (call str.byte_at src i))
      (cond
        ((eq c 59)
         (while (and (lt i n) (neq (call str.byte_at src i) 10)) (set! i (+ i 1))))
        ((eq c 34)
         (set! i (+ i 1))
         (while (and (lt i n) (neq (call str.byte_at src i) 34))
           (set! i (+ i (if (eq (call str.byte_at src i) 92) 2 1))))
         (set! i (+ i 1)))
        ((or (eq c 40) (eq c 91))
         (when (and (eq depth 0) (and (lt start 0) (call word_at src (call skip_space src (+ i 1)) "module")))
               (set! start i))
         (set! depth (+ depth 1))
         (set! i (+ i 1)))
        ((or (eq c 41) (eq c 93))
         (when (eq depth 0) (return -1))
         (set! depth (- depth 1))
         (when (and (eq depth 0) (gte start 0))
               ;; the name: the first word after `module`
               (let at:i32 (call skip_space src (+ (call skip_space src (+ start 1)) 6)))
               (let e:i32 at)
               (while (and (lt e n) (not (or (call is_space (call str.byte_at src e)) (or (eq (call str.byte_at src e) 40) (eq (call str.byte_at src e) 41)))))
                 (set! e (+ e 1)))
               (when (eq e at) (return -1))
               (call buf.push_bytes name (call str.slice src at (- e at)))
               (return i))
         (set! i (+ i 1)))
        (else (set! i (+ i 1)))))
    -1)

  (fn lower_ascii [c:i32] -> bool (and (gte c 97) (lte c 122)))
  (fn word_char [c:i32] -> bool (or (and (gte c 97) (lte c 122)) (or (and (gte c 65) (lte c 90)) (or (and (gte c 48) (lte c 57)) (eq c 95)))))

  ;; The standard modules `text` names, as `str` in `(call str.find ...)`, in
  ;; the order named (src/evalexpr.rs named_modules); `std_dir` holds them.
  (fn named_modules [text:str.Bytes std_dir:str.Bytes] -> (ptr (vec.Vec str.Bytes))
    (let out:(ptr (vec.Vec str.Bytes)) (call (vec.make str.Bytes) (call alloc.default) 8))
    (let n:i32 (get text str.Bytes.len))
    (let i:i32 0)
    (while (lt i n)
      (let c:i32 (call str.byte_at text i))
      (let starts:bool (and (call lower_ascii c)
                            (or (eq i 0) (not (or (call word_char (call str.byte_at text (- i 1))) (eq (call str.byte_at text (- i 1)) 46))))))
      (if (not starts)
          (set! i (+ i 1))
          (block
            (let s:i32 i)
            (while (and (lt i n) (call word_char (call str.byte_at text i))) (set! i (+ i 1)))
            (let word:str.Bytes (call str.slice text s (- i s)))
            (when (and (lt i n) (eq (call str.byte_at text i) 46))
                  (let have:bool false)
                  (for k 0 (call (vec.len str.Bytes) out)
                    (when (call str.bytes_eq (call (vec.at str.Bytes) out k) word) (set! have true)))
                  (when (not have)
                        (let path:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
                        (call buf.push_bytes path std_dir)
                        (call buf.push_bytes path word)
                        (call buf.push_str path ".aipl")
                        (when (match (call fs.info_path (call buf.bytes path))
                                ((option.Option fs.Info) some [_] true)
                                ((option.Option fs.Info) none false))
                              (call (vec.push str.Bytes) out word)))))))
    out)

  (fn push_import [b:(ptr buf.Buf) name:str.Bytes] -> void
    (call buf.push_str b "  (import ")
    (call buf.push_bytes b name)
    (call buf.push_str b ")\n"))

  (fn has_import [src:str.Bytes name:str.Bytes] -> bool
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 32))
    (call buf.push_str b "(import ")
    (call buf.push_bytes b name)
    (call buf.push_byte b 41)
    (call str.contains src (call buf.bytes b)))

  (fn count_newlines [b:str.Bytes] -> i32
    (let k:i32 0)
    (for i 0 (get b str.Bytes.len) (when (eq (call str.byte_at b i) 10) (set! k (+ k 1))))
    k)

  ;; Where the expressions sit in the wrapped module: their first line, how
  ;; many lines they take, and the columns before them on the first.
  (struct Place [path:str.Bytes line:i32 lines:i32 col:i32])

  ;; The wrapped module: `src` up to the module's last ')', the imports the
  ;; expressions need, `(fn __eval [] -> ret `, the expressions and ')', then
  ;; `extra` (more functions) and the rest of `src`. place is filled in.
  (fn wrap [src:str.Bytes close:i32 name:str.Bytes imports:(ptr buf.Buf) ret:str.Bytes exprs:str.Bytes extra:str.Bytes place:(ptr Place)] -> str.Bytes
    (let head:(ptr buf.Buf) (call buf.make (call alloc.default) 256))
    (call buf.push_bytes head (call str.slice src 0 close))
    (call buf.push_byte head 10)
    (call buf.push_bytes head (call buf.bytes imports))
    (call buf.push_str head "  (fn __eval [] -> ")
    (call buf.push_bytes head ret)
    (call buf.push_byte head 32)
    (let h:str.Bytes (call buf.bytes head))
    (put place Place.line (+ (call count_newlines h) 1))
    (put place Place.lines (+ (call count_newlines exprs) 1))
    (put place Place.col (- (get h str.Bytes.len) (+ (call str.rfind h (call str.from_str "\n")) 1)))
    (let all:(ptr buf.Buf) (call buf.make (call alloc.default) (+ (+ (get src str.Bytes.len) (get exprs str.Bytes.len)) 256)))
    (call buf.push_bytes all h)
    (call buf.push_bytes all exprs)
    (call buf.push_str all ")\n")
    (call buf.push_bytes all extra)
    (call buf.push_bytes all (call str.slice src close (- (get src str.Bytes.len) close)))
    (call buf.bytes all))

  ;; ===== Positions =====

  (fn digits [s:str.Bytes at:i32] -> i32
    (let k:i32 0)
    (while (and (lt (+ at k) (get s str.Bytes.len)) (and (gte (call str.byte_at s (+ at k)) 48) (lte (call str.byte_at s (+ at k)) 57)))
      (set! k (+ k 1)))
    k)

  (fn number [s:str.Bytes at:i32 n:i32] -> i32
    (call str.parse_int_or (call str.slice s at n) 0))

  ;; `text` with each `prefix` followed by L:C on the expressions' lines given
  ;; as -e:L:C (src/evalexpr.rs relocate, one prefix).
  (fn relocate_prefix [text:str.Bytes prefix:str.Bytes place:(ptr Place)] -> str.Bytes
    (let out:(ptr buf.Buf) (call buf.make (call alloc.default) (+ (get text str.Bytes.len) 16)))
    (let rest:str.Bytes text)
    (let more:bool true)
    (while more
      (let at:i32 (call str.find rest prefix))
      (if (lt at 0)
          (set! more false)
          (block
            (call buf.push_bytes out (call str.slice rest 0 at))
            (let after:str.Bytes (call str.slice rest (+ at (get prefix str.Bytes.len)) (- (get rest str.Bytes.len) (+ at (get prefix str.Bytes.len)))))
            (let nl:i32 (call digits after 0))
            (let nc:i32 0)
            (when (and (gt nl 0) (and (lt nl (get after str.Bytes.len)) (eq (call str.byte_at after nl) 58)))
                  (set! nc (call digits after (+ nl 1))))
            (let l:i32 (call number after 0 nl))
            (if (and (gt nc 0) (and (gte l (get place Place.line)) (lt l (+ (get place Place.line) (get place Place.lines)))))
                (block
                  (let c:i32 (call number after (+ nl 1) nc))
                  (let col:i32 (if (eq l (get place Place.line)) (if (gt c (get place Place.col)) (- c (get place Place.col)) 0) c))
                  (call buf.push_str out "-e:")
                  (call buf.push_int out (+ (- l (get place Place.line)) 1))
                  (call buf.push_byte out 58)
                  (call buf.push_int out col)
                  (set! rest (call str.slice after (+ nl (+ 1 nc)) (- (get after str.Bytes.len) (+ nl (+ 1 nc))))))
                (block
                  (call buf.push_bytes out prefix)
                  (set! rest after))))))
    (call buf.push_bytes out rest)
    (call buf.bytes out))

  ;; msg without the generated functions' frames and its trailing newlines,
  ;; positions on the expressions' lines given as -e:LINE:COL (src/evalexpr.rs
  ;; relocate).
  (fn relocate [msg:str.Bytes place:(ptr Place)] -> str.Bytes
    (let kept:(ptr buf.Buf) (call buf.make (call alloc.default) (+ (get msg str.Bytes.len) 1)))
    (let start:i32 0)
    (let n:i32 (get msg str.Bytes.len))
    (for i 0 n
      (when (or (eq (call str.byte_at msg i) 10) (eq i (- n 1)))
            (let line:str.Bytes (call str.slice msg start (+ (- i start) 1)))
            (set! start (+ i 1))
            (let t:str.Bytes (call str.trim_start line))
            (when (not (or (call str.starts_with t (call str.from_str "at __eval_print ")) (call str.starts_with t (call str.from_str "at _start "))))
                  (call buf.push_bytes kept line))))
    (let text:str.Bytes (call buf.bytes kept))
    (while (and (gt (get text str.Bytes.len) 0) (eq (call str.byte_at text (- (get text str.Bytes.len) 1)) 10))
      (set! text (call str.slice text 0 (- (get text str.Bytes.len) 1))))
    (let full:str.Bytes (get place Place.path))
    (let slash:i32 (call str.rfind full (call str.from_str "/")))
    (let short:str.Bytes (if (lt slash 0) full (call str.slice full (+ slash 1) (- (get full str.Bytes.len) (+ slash 1)))))
    (let p1:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (call buf.push_bytes p1 full)
    (call buf.push_str p1 ": ")
    (let p2:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (call buf.push_bytes p2 full)
    (call buf.push_byte p2 58)
    (let p3:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (call buf.push_bytes p3 short)
    (call buf.push_byte p3 58)
    (let out:str.Bytes (call relocate_prefix text (call buf.bytes p1) place))
    (set! out (call relocate_prefix out (call buf.bytes p2) place))
    (call relocate_prefix out (call buf.bytes p3) place))

  ;; ===== Running =====

  (fn temp_path [] -> str.Bytes
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (call buf.push_bytes b (call (option.unwrap_or str.Bytes) (call os.env "TMPDIR") (call str.from_str "/tmp")))
    (call buf.push_str b "/aipl-eval-")
    (call buf.push_unsigned b (sys.time) 10 false)
    (call buf.bytes b))

  ;; Everything the pipe `read` gives, added to `into`; `which` 0 the program's
  ;; output, 1 its error.
  (fn drain [ch:proc.Child into:(ptr buf.Buf) which:i32] -> void
    (while (gt (if (eq which 0) (call proc.read ch into 8192) (call proc.read_error ch into 8192)) 0) (block)))

  (fn write_bytes [fd:i32 b:str.Bytes] -> void
    (unsafe (let _w:i32 (fs.write fd (call str.addr b) (get b str.Bytes.len)))
    (block)))

  ;; aipl eval -e, its arguments from os.arg `first` on; the exit status.
  (fn command [first:i32] -> i32 (pub)
    (let have_exprs:bool false)
    (let exprs:str.Bytes (call str.from_str ""))
    (let have_with:bool false)
    (let with_path:str.Bytes (call str.from_str ""))
    (let grants:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (let max_pages:i32 32768)
    (let args_at:i32 -1)
    (let n:i32 (call os.arg_count))
    (let i:i32 first)
    (while (and (lt i n) (lt args_at 0))
      (let x:str.Bytes (call arg i))
      (cond
        ((or (call str.is x "-e") (call str.is x "--expr"))
         (when (gte (+ i 1) n) (return (call usage)))
         (set! have_exprs true)
         (set! exprs (call arg (+ i 1)))
         (set! i (+ i 1)))
        ((call str.is x "--with")
         (when (gte (+ i 1) n) (return (call usage)))
         (set! have_with true)
         (set! with_path (call arg (+ i 1)))
         (set! i (+ i 1)))
        ((call str.is x "--native") (block))
        ((call str.is x "--wasm")
         (return (call fail_bytes "this aipl runs expressions natively only: for --wasm use the Rust aipl: " x)))
        ((call str.is x "--listen")
         (when (gte (+ i 1) n) (return (call usage)))
         (when (not (call native.valid_grant (call arg (+ i 1))))
               (let m:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
               (call buf.push_str m "--listen ")
               (call buf.push_bytes m (call arg (+ i 1)))
               (call buf.push_str m ": expected ADDR:PORT, as 127.0.0.1:8080 or [::1]:8080")
               (return (call fail_bytes "" (call buf.bytes m))))
         (call buf.push_bytes grants (call arg (+ i 1)))
         (call buf.push_byte grants 10)
         (set! i (+ i 1)))
        ((call str.is x "--allow-run")
         (when (gte (+ i 1) n) (return (call usage)))
         (call buf.push_str grants "run:")
         (call buf.push_bytes grants (call arg (+ i 1)))
         (call buf.push_byte grants 10)
         (set! i (+ i 1)))
        ((call str.is x "--max-memory")
         (when (gte (+ i 1) n) (return (call usage)))
         (set! max_pages (call driver.memory_pages (call arg (+ i 1))))
         (when (lt max_pages 0)
               (let m:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
               (call buf.push_str m "--max-memory ")
               (call buf.push_bytes m (call arg (+ i 1)))
               (call buf.push_str m ": expected a size from 1M to 2G in whole 64K pages, as 512M")
               (return (call fail_bytes "" (call buf.bytes m))))
         (set! i (+ i 1)))
        ((call str.is x "--") (set! args_at (+ i 1)))
        (else (return (call usage))))
      (set! i (+ i 1)))
    (when (not have_exprs) (return (call usage)))

    ;; FILE's module, or an empty one
    (let place:(ptr Place) (new Place (call alloc.default) [path:(zero str.Bytes) line:0 lines:0 col:0]))
    (let src:str.Bytes (call str.from_str "(module eval)\n"))
    (if have_with
        (block
          (put place Place.path with_path)
          (set! src (match_result (call io.read_path with_path) (ok t t)
                      (err e (return (call fail_bytes "cannot read " with_path))))))
        (put place Place.path (call str.from_str "-e.aipl")))
    (let name:(ptr buf.Buf) (call buf.make (call alloc.default) 32))
    (let close:i32 (call module_form src name))
    (when (lt close 0)
          (let m:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
          (call buf.push_bytes m (get place Place.path))
          (call buf.push_str m ": no (module NAME ...) to evaluate in")
          (return (call fail_bytes "" (call buf.bytes m))))
    (let std_dir:str.Bytes (call stdpath.find))
    (let imports:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (when (not (call has_import src (call str.from_str "show"))) (call push_import imports (call str.from_str "show")))
    (let wanted:(ptr (vec.Vec str.Bytes)) (call named_modules exprs std_dir))
    (for k 0 (call (vec.len str.Bytes) wanted)
      (let m:str.Bytes (call (vec.at str.Bytes) wanted k))
      (when (and (not (call str.bytes_eq m (call buf.bytes name))) (and (not (call str.is m "show")) (not (call has_import src m))))
            (call push_import imports m)))

    ;; the type of the last expression, from the module with __eval returning void
    (let first_text:str.Bytes (call wrap src close (call buf.bytes name) imports (call str.from_str "void") exprs (call str.from_str "") place))
    (let res:(ptr driver.Out) (call driver.eval_type (get place Place.path) first_text std_dir))
    (when (neq (get res driver.Out.status) 0)
          (return (call fail_bytes "" (call relocate (unsafe (call str.bytes (get res driver.Out.addr) (get res driver.Out.len))) place))))
    (let ty:str.Bytes (unsafe (call str.bytes (get res driver.Out.addr) (get res driver.Out.len))))

    ;; the modules the type names are imported too
    (let named:(ptr (vec.Vec str.Bytes)) (call named_modules ty std_dir))
    (for k 0 (call (vec.len str.Bytes) named)
      (let m:str.Bytes (call (vec.at str.Bytes) named k))
      (when (and (not (call str.bytes_eq m (call buf.bytes name))) (and (not (call str.is m "show")) (not (call has_import src m))))
            (when (not (call str.contains (call buf.bytes imports) m)) (call push_import imports m))))

    ;; then written again: __eval returns it, __eval_print prints it, _start runs that
    (let is_void:bool (call str.is ty "void"))
    (let shown:bool (not (call str.starts_with ty (call str.from_str "(fn "))))
    (let extra:(ptr buf.Buf) (call buf.make (call alloc.default) 256))
    (call buf.push_str extra "  (fn __eval_print [] -> void (unsafe) ")
    (cond
      (is_void (call buf.push_str extra "(call __eval)"))
      (else
       (call buf.push_str extra "(let __v:")
       (call buf.push_bytes extra ty)
       (call buf.push_str extra " (call __eval)) (println \"")
       (call buf.push_str extra (if shown "{__v} : " "<value> : "))
       (call buf.push_bytes extra ty)
       (call buf.push_str extra "\")")))
    (call buf.push_str extra ")\n")
    (when (call str.contains src (call str.from_str "(fn _start "))
          (let m:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
          (call buf.push_bytes m (get place Place.path))
          (call buf.push_str m ": defines _start, and aipl eval runs the expressions as the program's _start: for this file's own start use the Rust aipl's VM")
          (return (call fail_bytes "" (call buf.bytes m))))
    (call buf.push_str extra "  (fn _start [] -> void (unsafe) (call __eval_print))\n")
    (let text:str.Bytes (call wrap src close (call buf.bytes name) imports (if is_void (call str.from_str "void") ty) exprs (call buf.bytes extra) place))
    (let built:(ptr driver.Out) (call driver.compile_text (get place Place.path) text std_dir max_pages))
    (let status:i32 (get built driver.Out.status))
    (when (or (eq status 1) (eq status 3))
          (return (call fail_bytes "" (call relocate (unsafe (call str.bytes (get built driver.Out.addr) (get built driver.Out.len))) place))))
    (when (eq status 2)
          (let m:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
          (call buf.push_str m "compile error ")
          (call buf.push_int m (get built driver.Out.len))
          (call buf.push_str m " (AIPL_SPEC.md 6.4)")
          (return (call fail_bytes "" (call buf.bytes m))))
    (let wasm:str.Bytes (unsafe (call str.bytes (get built driver.Out.addr) (get built driver.Out.len))))
    (let o:(ptr native.Output) (call native.compile_with wasm false (call buf.bytes grants) (call str.from_str "")))
    (when (not (get o native.Output.ok)) (return (call fail_bytes "native backend: " (get o native.Output.error))))

    (let exe:str.Bytes (call temp_path))
    (when (match_result (call io.write_path exe (get o native.Output.exe)) (ok w (neq w (get (get o native.Output.exe) str.Bytes.len))) (err e true))
          (let _gone:bool (match_result (call fs.remove_path exe) (ok d true) (err e2 false)))
          (return (call fail_bytes "cannot write " exe)))
    (when (match_result (call fs.chmod_path exe fs.PROGRAM) (ok d false) (err e true))
          (let _gone:bool (match_result (call fs.remove_path exe) (ok d true) (err e2 false)))
          (return (call fail_bytes "cannot make executable " exe)))
    (let c:(ptr proc.Command) (call proc.command_path (call alloc.default) exe))
    (when (gte args_at 0)
          (for j args_at n (call proc.arg_bytes c (call arg j))))
    (let out:(ptr buf.Buf) (call buf.make (call alloc.default) 256))
    (let err:(ptr buf.Buf) (call buf.make (call alloc.default) 256))
    ;; its output and then its error, each to the end (a program that fills the
    ;; pipe of its error before ending its output waits: not for an expression)
    (let code:i32 (match_result (call proc.spawn_with c proc.Stream.null proc.Stream.pipe proc.Stream.pipe)
                    (ok ch (block
                             (call drain ch out 0)
                             (call drain ch err 1)
                             (let s:i32 (call proc.wait ch))
                             (call proc.close ch)
                             (if (call proc.exited s) s 1)))
                    (err e -1)))
    (let _gone:bool (match_result (call fs.remove_path exe) (ok d true) (err e2 false)))
    (when (lt code 0) (return (call fail_bytes "cannot run the expressions: " (call str.from_str "the program could not be started (is this aipl built with --allow-run '*'?)"))))
    (call write_bytes 1 (call buf.bytes out))
    (when (gt (call buf.len err) 0)
          ;; the program is named as -e, not as the temporary file
          (let prefix:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
          (call buf.push_bytes prefix exe)
          (call buf.push_str prefix ": ")
          (let renamed:str.Bytes (call buf.bytes (call text_replace (call buf.bytes err) (call buf.bytes prefix) (call str.from_str "-e: "))))
          (call write_bytes 2 (call relocate renamed place))
          (call write_bytes 2 (call str.from_str "\n")))
    code)

  ;; b with each `from` replaced by `to`.
  (fn text_replace [b:str.Bytes from:str.Bytes to:str.Bytes] -> (ptr buf.Buf)
    (let out:(ptr buf.Buf) (call buf.make (call alloc.default) (+ (get b str.Bytes.len) 16)))
    (let rest:str.Bytes b)
    (let more:bool true)
    (while more
      (let at:i32 (call str.find rest from))
      (if (lt at 0)
          (set! more false)
          (block
            (call buf.push_bytes out (call str.slice rest 0 at))
            (call buf.push_bytes out to)
            (set! rest (call str.slice rest (+ at (get from str.Bytes.len)) (- (get rest str.Bytes.len) (+ at (get from str.Bytes.len))))))))
    (call buf.push_bytes out rest)
    out))
