;; arm64: an AArch64 machine-code encoder (native ARM64 backend task NA2,
;; docs/design/ARM64_PLAN.md). One function per instruction form the lowering
;; needs, each appending its one 32-bit little-endian word to a code buffer
;; (std/buf): every A64 instruction is four bytes.
;;
;; Registers are numbered as the hardware numbers them: x0-x30 (w0-w30 for 32
;; bits) are 0-30, and 31 is the stack pointer `sp` or the zero register `zr`,
;; whichever the instruction form means by it (the immediate forms of add and
;; sub, and the loads and stores, take sp; the others take zr). `sz` is the
;; operand size in bits, 32 or 64. A 32-bit write clears the register's upper
;; half. Operand order is the assembler's: destination first.
;;
;; Branches to labels take word offsets: the emitting function returns the
;; buffer position of the instruction, and `patch_b`, `patch_cond`, or
;; `patch_adr` point it at its target once that is known.
;;
;;   (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 256))
;;   (call arm64.add_rrr c 64 0 1 2)       ;; add x0, x1, x2
;;   (call arm64.movz c 64 3 4660 16)      ;; movz x3, #0x1234, lsl #16
;;   (call arm64.ret c)
(module arm64
  (import alloc) (import str)
  (import buf)
  (import vec)

  ;; (hi << 16) | lo: words with the high bit set, from decimal halves
  (fn w [hi:i32 lo:i32] -> i32 (bitor (shl hi 16) lo))

  ;; The instruction word `v`, little-endian.
  (fn emit [c:(ptr buf.Buf) v:i32] -> void (pub)
    (call buf.push_byte c (bitand v 255))
    (call buf.push_byte c (bitand (shru v 8) 255))
    (call buf.push_byte c (bitand (shru v 16) 255))
    (call buf.push_byte c (bitand (shru v 24) 255)))

  (fn sf [sz:i32] -> i32
    (req (or (eq sz 32) (eq sz 64)))
    (if (eq sz 64) (shl 1 31) 0))

  ;; a register field: 0-31
  (fn r [x:i32] -> i32
    (req (and (gte x 0) (lte x 31)))
    x)

  ;; ===== Condition codes (b.cond, csel, ccmp) =====
  (fn cc_eq [] -> i32 (pub) 0)  (fn cc_ne [] -> i32 (pub) 1)
  (fn cc_hs [] -> i32 (pub) 2)  (fn cc_lo [] -> i32 (pub) 3)
  (fn cc_mi [] -> i32 (pub) 4)  (fn cc_pl [] -> i32 (pub) 5)
  (fn cc_vs [] -> i32 (pub) 6)  (fn cc_vc [] -> i32 (pub) 7)
  (fn cc_hi [] -> i32 (pub) 8)  (fn cc_ls [] -> i32 (pub) 9)
  (fn cc_ge [] -> i32 (pub) 10) (fn cc_lt [] -> i32 (pub) 11)
  (fn cc_gt [] -> i32 (pub) 12) (fn cc_le [] -> i32 (pub) 13)
  (fn cc_al [] -> i32 (pub) 14)

  ;; The opposite condition (every pair differs in the low bit).
  (fn invert [cc:i32] -> i32 (pub)
    (req (and (gte cc 0) (lte cc 13)))
    (^ cc 1))

  ;; ===== Move wide =====

  ;; sf opc(2) 100101 hw imm16 rd: movn opc 0, movz opc 2, movk opc 3
  (fn move_wide [c:(ptr buf.Buf) sz:i32 opc:i32 rd:i32 imm16:i32 shift:i32] -> void
    (req (and (gte imm16 0) (lte imm16 65535)))
    (req (or (eq shift 0) (or (eq shift 16) (or (and (eq sz 64) (eq shift 32)) (and (eq sz 64) (eq shift 48))))))
    (call emit c (bitor (call sf sz)
                  (bitor (shl opc 29)
                   (bitor (shl 37 23)
                    (bitor (shl (shru shift 4) 21)
                     (bitor (shl imm16 5) (call r rd))))))))

  ;; movz rd, #imm16, lsl #shift (0, 16, 32, 48): the rest of rd is zero
  (fn movz [c:(ptr buf.Buf) sz:i32 rd:i32 imm16:i32 shift:i32] -> void (pub) (call move_wide c sz 2 rd imm16 shift))
  ;; movk: keeps the rest of rd
  (fn movk [c:(ptr buf.Buf) sz:i32 rd:i32 imm16:i32 shift:i32] -> void (pub) (call move_wide c sz 3 rd imm16 shift))
  ;; movn: rd = not (imm16 << shift)
  (fn movn [c:(ptr buf.Buf) sz:i32 rd:i32 imm16:i32 shift:i32] -> void (pub) (call move_wide c sz 0 rd imm16 shift))

  ;; The halfword `k` (0-3) of v.
  (fn half [v:i64 k:i32] -> i32 (i32.wrap (bitand (shru v (i64.extend_s (* 16 k))) 65535i64)))

  ;; rd = the constant v (for sz 32, its low 32 bits), in as few movz/movn and
  ;; movk as it takes: movz if more halfwords are zero than all ones, else movn.
  (fn mov_imm [c:(ptr buf.Buf) sz:i32 rd:i32 v:i64] -> void (pub)
    (let n:i32 (if (eq sz 64) 4 2))
    (let zeros:i32 0)
    (let ones:i32 0)
    (for k 0 n
      (when (eq (call half v k) 0) (set! zeros (+ zeros 1)))
      (when (eq (call half v k) 65535) (set! ones (+ ones 1))))
    (let fill:i32 (if (gt ones zeros) 65535 0))
    ;; the first halfword that is not `fill` starts the sequence
    (let first:i32 -1)
    (for k 0 n
      (when (and (lt first 0) (neq (call half v k) fill)) (set! first k)))
    (when (lt first 0)
          ;; all `fill`: movz #0 or movn #0 (all ones)
          (if (eq fill 0) (call movz c sz rd 0 0) (call movn c sz rd 0 0))
          (return))
    (if (eq fill 0)
        (call movz c sz rd (call half v first) (* 16 first))
        (call movn c sz rd (^ (call half v first) 65535) (* 16 first)))
    (for k (+ first 1) n
      (when (neq (call half v k) fill)
            (call movk c sz rd (call half v k) (* 16 k)))))

  ;; ===== Add and subtract =====

  ;; sf op S 01011 shift 0 rm imm6 rn rd; shifted register, no shift. rd, rn, rm
  ;; 31 is zr (the register forms never take sp).
  (fn addsub_rrr [c:(ptr buf.Buf) sz:i32 op:i32 s:i32 rd:i32 rn:i32 rm:i32] -> void
    (call emit c (bitor (call sf sz)
                  (bitor (shl op 30)
                   (bitor (shl s 29)
                    (bitor (shl 11 24)
                     (bitor (shl (call r rm) 16)
                      (bitor (shl (call r rn) 5) (call r rd)))))))))
  (fn add_rrr [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call addsub_rrr c sz 0 0 rd rn rm))
  (fn sub_rrr [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call addsub_rrr c sz 1 0 rd rn rm))
  (fn adds_rrr [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call addsub_rrr c sz 0 1 rd rn rm))
  (fn subs_rrr [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call addsub_rrr c sz 1 1 rd rn rm))
  ;; cmp rn, rm (subs zr, rn, rm), cmn
  (fn cmp_rr [c:(ptr buf.Buf) sz:i32 rn:i32 rm:i32] -> void (pub) (call addsub_rrr c sz 1 1 31 rn rm))
  (fn cmn_rr [c:(ptr buf.Buf) sz:i32 rn:i32 rm:i32] -> void (pub) (call addsub_rrr c sz 0 1 31 rn rm))
  ;; neg rd, rm (sub rd, zr, rm)
  (fn neg [c:(ptr buf.Buf) sz:i32 rd:i32 rm:i32] -> void (pub) (call addsub_rrr c sz 1 0 rd 31 rm))

  ;; sf op S 100010 sh imm12 rn rd: add or sub of a 12-bit immediate (shifted
  ;; left 12 if `lsl12`). rn 31 is sp; rd 31 is sp, or zr when S is set.
  (fn addsub_ri [c:(ptr buf.Buf) sz:i32 op:i32 s:i32 rd:i32 rn:i32 imm12:i32 lsl12:bool] -> void
    (req (and (gte imm12 0) (lte imm12 4095)))
    (call emit c (bitor (call sf sz)
                  (bitor (shl op 30)
                   (bitor (shl s 29)
                    (bitor (shl 34 23)
                     (bitor (shl (if lsl12 1 0) 22)
                      (bitor (shl imm12 10)
                       (bitor (shl (call r rn) 5) (call r rd))))))))))
  (fn add_ri [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 imm12:i32] -> void (pub) (call addsub_ri c sz 0 0 rd rn imm12 false))
  (fn sub_ri [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 imm12:i32] -> void (pub) (call addsub_ri c sz 1 0 rd rn imm12 false))
  (fn add_ri12 [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 imm12:i32] -> void (pub) (call addsub_ri c sz 0 0 rd rn imm12 true))
  (fn sub_ri12 [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 imm12:i32] -> void (pub) (call addsub_ri c sz 1 0 rd rn imm12 true))
  (fn adds_ri [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 imm12:i32] -> void (pub) (call addsub_ri c sz 0 1 rd rn imm12 false))
  (fn subs_ri [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 imm12:i32] -> void (pub) (call addsub_ri c sz 1 1 rd rn imm12 false))
  ;; cmp rn, #imm12 (subs zr, rn, #imm12)
  (fn cmp_ri [c:(ptr buf.Buf) sz:i32 rn:i32 imm12:i32] -> void (pub) (call addsub_ri c sz 1 1 31 rn imm12 false))
  ;; mov rd, rn where either is sp (add rd, rn, #0)
  (fn mov_sp [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32] -> void (pub) (call addsub_ri c sz 0 0 rd rn 0 false))

  ;; ===== Logical (shifted register, no shift) =====

  ;; sf opc(2) 01010 shift n rm imm6 rn rd: and 0, orr 1, eor 2, ands 3; n
  ;; inverts rm (bic, orn, eon, bics)
  (fn logic_rrr [c:(ptr buf.Buf) sz:i32 opc:i32 n:i32 rd:i32 rn:i32 rm:i32] -> void
    (call emit c (bitor (call sf sz)
                  (bitor (shl opc 29)
                   (bitor (shl 10 24)
                    (bitor (shl n 21)
                     (bitor (shl (call r rm) 16)
                      (bitor (shl (call r rn) 5) (call r rd)))))))))
  (fn and_rrr [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call logic_rrr c sz 0 0 rd rn rm))
  (fn orr_rrr [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call logic_rrr c sz 1 0 rd rn rm))
  (fn eor_rrr [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call logic_rrr c sz 2 0 rd rn rm))
  (fn ands_rrr [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call logic_rrr c sz 3 0 rd rn rm))
  (fn bic_rrr [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call logic_rrr c sz 0 1 rd rn rm))
  (fn orn_rrr [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call logic_rrr c sz 1 1 rd rn rm))
  (fn eon_rrr [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call logic_rrr c sz 2 1 rd rn rm))
  ;; tst rn, rm (ands zr, rn, rm)
  (fn tst_rr [c:(ptr buf.Buf) sz:i32 rn:i32 rm:i32] -> void (pub) (call logic_rrr c sz 3 0 31 rn rm))
  ;; mov rd, rm (orr rd, zr, rm); mvn rd, rm (orn rd, zr, rm)
  (fn mov_rr [c:(ptr buf.Buf) sz:i32 rd:i32 rm:i32] -> void (pub) (call logic_rrr c sz 1 0 rd 31 rm))
  (fn mvn [c:(ptr buf.Buf) sz:i32 rd:i32 rm:i32] -> void (pub) (call logic_rrr c sz 1 1 rd 31 rm))

  ;; ===== Multiply, divide, shift by register, count =====

  ;; sf 0 0 11010110 rm opcode(6) rn rd
  (fn dp2 [c:(ptr buf.Buf) sz:i32 opcode:i32 rd:i32 rn:i32 rm:i32] -> void
    (call emit c (bitor (call sf sz)
                  (bitor (shl 214 21)
                   (bitor (shl (call r rm) 16)
                    (bitor (shl opcode 10)
                     (bitor (shl (call r rn) 5) (call r rd))))))))
  (fn udiv [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call dp2 c sz 2 rd rn rm))
  (fn sdiv [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call dp2 c sz 3 rd rn rm))
  (fn lslv [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call dp2 c sz 8 rd rn rm))
  (fn lsrv [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call dp2 c sz 9 rd rn rm))
  (fn asrv [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call dp2 c sz 10 rd rn rm))
  (fn rorv [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call dp2 c sz 11 rd rn rm))

  ;; sf 00 11011 000 rm o0 ra rn rd: madd (rd = ra + rn * rm), msub (ra - rn * rm)
  (fn dp3 [c:(ptr buf.Buf) sz:i32 o0:i32 rd:i32 rn:i32 rm:i32 ra:i32] -> void
    (call emit c (bitor (call sf sz)
                  (bitor (shl 216 21)
                   (bitor (shl (call r rm) 16)
                    (bitor (shl o0 15)
                     (bitor (shl (call r ra) 10)
                      (bitor (shl (call r rn) 5) (call r rd)))))))))
  (fn madd [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32 ra:i32] -> void (pub) (call dp3 c sz 0 rd rn rm ra))
  (fn msub [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32 ra:i32] -> void (pub) (call dp3 c sz 1 rd rn rm ra))
  ;; mul rd, rn, rm (madd with zr)
  (fn mul [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32] -> void (pub) (call dp3 c sz 0 rd rn rm 31))

  ;; sf 1 0 11010110 00000 opcode rn rd: rbit 0, rev 2 (32) or 3 (64), clz 4
  (fn dp1 [c:(ptr buf.Buf) sz:i32 opcode:i32 rd:i32 rn:i32] -> void
    (call emit c (bitor (call sf sz)
                  (bitor (shl 726 21)
                   (bitor (shl opcode 10)
                    (bitor (shl (call r rn) 5) (call r rd)))))))
  (fn rbit [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32] -> void (pub) (call dp1 c sz 0 rd rn))
  (fn clz [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32] -> void (pub) (call dp1 c sz 4 rd rn))

  ;; ===== Bitfields: shifts and extensions by immediate =====

  ;; sf opc(2) 100110 n immr imms rn rd: sbfm 0, bfm 1, ubfm 2 (n = sf)
  (fn bitfield [c:(ptr buf.Buf) sz:i32 opc:i32 rd:i32 rn:i32 immr:i32 imms:i32] -> void
    (req (and (gte immr 0) (lt immr sz)))
    (req (and (gte imms 0) (lt imms sz)))
    (call emit c (bitor (call sf sz)
                  (bitor (shl opc 29)
                   (bitor (shl 38 23)
                    (bitor (shl (if (eq sz 64) 1 0) 22)
                     (bitor (shl immr 16)
                      (bitor (shl imms 10)
                       (bitor (shl (call r rn) 5) (call r rd))))))))))
  ;; lsl rd, rn, #sh (ubfm), lsr (ubfm), asr (sbfm), for 0 < sh < sz (lsr, asr: 0 <= sh)
  (fn lsl_ri [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 sh:i32] -> void (pub)
    (req (and (gt sh 0) (lt sh sz)))
    (call bitfield c sz 2 rd rn (- sz sh) (- (- sz 1) sh)))
  (fn lsr_ri [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 sh:i32] -> void (pub) (call bitfield c sz 2 rd rn sh (- sz 1)))
  (fn asr_ri [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 sh:i32] -> void (pub) (call bitfield c sz 0 rd rn sh (- sz 1)))
  ;; sign and zero extension of the low 8, 16, or (sxtw) 32 bits
  (fn sxtb [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32] -> void (pub) (call bitfield c sz 0 rd rn 0 7))
  (fn sxth [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32] -> void (pub) (call bitfield c sz 0 rd rn 0 15))
  (fn sxtw [c:(ptr buf.Buf) rd:i32 rn:i32] -> void (pub) (call bitfield c 64 0 rd rn 0 31))
  (fn uxtb [c:(ptr buf.Buf) rd:i32 rn:i32] -> void (pub) (call bitfield c 32 2 rd rn 0 7))
  (fn uxth [c:(ptr buf.Buf) rd:i32 rn:i32] -> void (pub) (call bitfield c 32 2 rd rn 0 15))

  ;; ===== Conditional select and compare =====

  ;; sf op 0 11010100 rm cond 0 o2 rn rd: csel (op 0, o2 0), csinc (0, 1), csinv (1, 0), csneg (1, 1)
  (fn csel_op [c:(ptr buf.Buf) sz:i32 op:i32 o2:i32 rd:i32 rn:i32 rm:i32 cc:i32] -> void
    (req (and (gte cc 0) (lte cc 15)))
    (call emit c (bitor (call sf sz)
                  (bitor (shl op 30)
                   (bitor (shl 212 21)
                    (bitor (shl (call r rm) 16)
                     (bitor (shl cc 12)
                      (bitor (shl o2 10)
                       (bitor (shl (call r rn) 5) (call r rd))))))))))
  (fn csel [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32 cc:i32] -> void (pub) (call csel_op c sz 0 0 rd rn rm cc))
  (fn csinc [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32 cc:i32] -> void (pub) (call csel_op c sz 0 1 rd rn rm cc))
  (fn csinv [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32 cc:i32] -> void (pub) (call csel_op c sz 1 0 rd rn rm cc))
  (fn csneg [c:(ptr buf.Buf) sz:i32 rd:i32 rn:i32 rm:i32 cc:i32] -> void (pub) (call csel_op c sz 1 1 rd rn rm cc))
  ;; cset rd, cc: 1 if the condition holds, else 0 (csinc rd, zr, zr, !cc)
  (fn cset [c:(ptr buf.Buf) sz:i32 rd:i32 cc:i32] -> void (pub) (call csel_op c sz 0 1 rd 31 31 (call invert cc)))

  ;; ccmp rn, rm|#imm5, #nzcv, cc: if the condition holds, compare as cmp does; else set the flags to nzcv
  (fn ccmp_rr [c:(ptr buf.Buf) sz:i32 rn:i32 rm:i32 nzcv:i32 cc:i32] -> void (pub)
    (req (and (gte nzcv 0) (lte nzcv 15)))
    (call emit c (bitor (call sf sz)
                  (bitor (shl 489 22)
                   (bitor (shl (call r rm) 16)
                    (bitor (shl cc 12)
                     (bitor (shl (call r rn) 5) nzcv)))))))
  (fn ccmp_ri [c:(ptr buf.Buf) sz:i32 rn:i32 imm5:i32 nzcv:i32 cc:i32] -> void (pub)
    (req (and (gte nzcv 0) (lte nzcv 15)))
    (req (and (gte imm5 0) (lte imm5 31)))
    (call emit c (bitor (call sf sz)
                  (bitor (shl 489 22)
                   (bitor (shl imm5 16)
                    (bitor (shl cc 12)
                     (bitor (shl 1 11)
                      (bitor (shl (call r rn) 5) nzcv))))))))

  ;; ===== Loads and stores =====

  ;; size(2) 111 v 01 opc(2) imm12 rn rt: base register plus an unsigned
  ;; offset, in units of the access size. rn 31 is sp.
  (fn mem_uimm [c:(ptr buf.Buf) size:i32 v:i32 opc:i32 rt:i32 rn:i32 imm12:i32] -> void
    (req (and (gte imm12 0) (lte imm12 4095)))
    (call emit c (bitor (shl size 30)
                  (bitor (shl 7 27)
                   (bitor (shl v 26)
                    (bitor (shl 1 24)
                     (bitor (shl opc 22)
                      (bitor (shl imm12 10)
                       (bitor (shl (call r rn) 5) (call r rt))))))))))
  ;; size(2) 111 v 00 opc(2) 0 imm9 00 rn rt: the unscaled offset, -256 to 255 bytes
  (fn mem_unscaled [c:(ptr buf.Buf) size:i32 v:i32 opc:i32 rt:i32 rn:i32 imm9:i32] -> void
    (req (and (gte imm9 -256) (lte imm9 255)))
    (call emit c (bitor (shl size 30)
                  (bitor (shl 7 27)
                   (bitor (shl v 26)
                    (bitor (shl opc 22)
                     (bitor (shl (bitand imm9 511) 12)
                      (bitor (shl (call r rn) 5) (call r rt)))))))))
  ;; size(2) 111 v 00 opc(2) 1 rm option s 10 rn rt: base plus a register, extended and
  ;; optionally scaled by the access size (s): option 2 uxtw, 3 lsl, 6 sxtw, 7 sxtx
  (fn mem_reg [c:(ptr buf.Buf) size:i32 v:i32 opc:i32 rt:i32 rn:i32 rm:i32 option:i32 scaled:bool] -> void
    (call emit c (bitor (shl size 30)
                  (bitor (shl 7 27)
                   (bitor (shl v 26)
                    (bitor (shl opc 22)
                     (bitor (shl 1 21)
                      (bitor (shl (call r rm) 16)
                       (bitor (shl option 13)
                        (bitor (shl (if scaled 1 0) 12)
                         (bitor (shl 2 10)
                          (bitor (shl (call r rn) 5) (call r rt)))))))))))))

  ;; the integer loads and stores: opc 0 stores, 1 loads zero-extended, 2 loads
  ;; sign-extended to 64 bits, 3 loads sign-extended to 32 bits; size 0 byte,
  ;; 1 halfword, 2 word, 3 doubleword.
  (fn str_x [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_uimm c 3 0 0 rt rn (/ off 8)))
  (fn ldr_x [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_uimm c 3 0 1 rt rn (/ off 8)))
  (fn str_w [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_uimm c 2 0 0 rt rn (/ off 4)))
  (fn ldr_w [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_uimm c 2 0 1 rt rn (/ off 4)))
  (fn strh [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_uimm c 1 0 0 rt rn (/ off 2)))
  (fn ldrh [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_uimm c 1 0 1 rt rn (/ off 2)))
  (fn strb [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_uimm c 0 0 0 rt rn off))
  (fn ldrb [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_uimm c 0 0 1 rt rn off))
  ;; ldrsb/ldrsh/ldrsw into x (sz 64) or (byte, half) w (sz 32)
  (fn ldrsb [c:(ptr buf.Buf) sz:i32 rt:i32 rn:i32 off:i32] -> void (pub) (call mem_uimm c 0 0 (if (eq sz 64) 2 3) rt rn off))
  (fn ldrsh [c:(ptr buf.Buf) sz:i32 rt:i32 rn:i32 off:i32] -> void (pub) (call mem_uimm c 1 0 (if (eq sz 64) 2 3) rt rn (/ off 2)))
  (fn ldrsw [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_uimm c 2 0 2 rt rn (/ off 4)))
  ;; the unscaled forms (ldur, stur, ...): any byte offset from -256 to 255
  (fn stur_x [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_unscaled c 3 0 0 rt rn off))
  (fn ldur_x [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_unscaled c 3 0 1 rt rn off))
  (fn stur_w [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_unscaled c 2 0 0 rt rn off))
  (fn ldur_w [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_unscaled c 2 0 1 rt rn off))
  ;; register offsets: [rn, rm, uxtw] (the 32-bit wasm address in rm, zero-extended)
  (fn ldr_x_uxtw [c:(ptr buf.Buf) rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 3 0 1 rt rn rm 2 false))
  (fn str_x_uxtw [c:(ptr buf.Buf) rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 3 0 0 rt rn rm 2 false))
  (fn ldr_w_uxtw [c:(ptr buf.Buf) rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 2 0 1 rt rn rm 2 false))
  (fn str_w_uxtw [c:(ptr buf.Buf) rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 2 0 0 rt rn rm 2 false))
  (fn ldrh_uxtw [c:(ptr buf.Buf) rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 1 0 1 rt rn rm 2 false))
  (fn strh_uxtw [c:(ptr buf.Buf) rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 1 0 0 rt rn rm 2 false))
  (fn ldrb_uxtw [c:(ptr buf.Buf) rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 0 0 1 rt rn rm 2 false))
  (fn strb_uxtw [c:(ptr buf.Buf) rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 0 0 0 rt rn rm 2 false))
  (fn ldrsb_uxtw [c:(ptr buf.Buf) sz:i32 rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 0 0 (if (eq sz 64) 2 3) rt rn rm 2 false))
  (fn ldrsh_uxtw [c:(ptr buf.Buf) sz:i32 rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 1 0 (if (eq sz 64) 2 3) rt rn rm 2 false))
  (fn ldrsw_uxtw [c:(ptr buf.Buf) rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 2 0 2 rt rn rm 2 false))
  ;; [rn, rm] with rm a 64-bit register (lsl #0)
  (fn ldr_x_reg [c:(ptr buf.Buf) rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 3 0 1 rt rn rm 3 false))
  (fn str_x_reg [c:(ptr buf.Buf) rt:i32 rn:i32 rm:i32] -> void (pub) (call mem_reg c 3 0 0 rt rn rm 3 false))

  ;; size(2) 111 v 00 opc(2) 0 imm9 idx(2) rn rt: with writeback, -256 to 255
  ;; bytes: idx 1 post-index (access [rn], then rn += imm9), 3 pre-index
  ;; (rn += imm9, then access [rn]). rn 31 is sp; rn must not be rt.
  (fn mem_writeback [c:(ptr buf.Buf) size:i32 opc:i32 rt:i32 rn:i32 imm9:i32 idx:i32] -> void
    (req (and (gte imm9 -256) (lte imm9 255)))
    (call emit c (bitor (shl size 30)
                  (bitor (shl 7 27)
                   (bitor (shl opc 22)
                    (bitor (shl (bitand imm9 511) 12)
                     (bitor (shl idx 10)
                      (bitor (shl (call r rn) 5) (call r rt)))))))))
  ;; str xt, [xn, #off]!  and  ldr xt, [xn], #off: push and pop on a stack
  (fn str_x_pre [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_writeback c 3 0 rt rn off 3))
  (fn ldr_x_pre [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_writeback c 3 1 rt rn off 3))
  (fn str_x_post [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_writeback c 3 0 rt rn off 1))
  (fn ldr_x_post [c:(ptr buf.Buf) rt:i32 rn:i32 off:i32] -> void (pub) (call mem_writeback c 3 1 rt rn off 1))

  ;; opc(2) 101 v 0 type(3) l imm7 rt2 rn rt: a pair of x registers; the offset
  ;; is a multiple of 8, -512 to 504. type 1 post-index, 2 offset, 3 pre-index.
  (fn pair [c:(ptr buf.Buf) kind:i32 l:i32 rt:i32 rt2:i32 rn:i32 off:i32] -> void
    (req (and (and (gte off -512) (lte off 504)) (eq (% off 8) 0)))
    (call emit c (bitor (shl 2 30)
                  (bitor (shl 5 27)
                   (bitor (shl kind 23)
                    (bitor (shl l 22)
                     (bitor (shl (bitand (/ off 8) 127) 15)
                      (bitor (shl (call r rt2) 10)
                       (bitor (shl (call r rn) 5) (call r rt))))))))))
  ;; stp rt, rt2, [rn, #off]; ldp; the pre-index ([rn, #off]!) and post-index ([rn], #off) forms
  (fn stp [c:(ptr buf.Buf) rt:i32 rt2:i32 rn:i32 off:i32] -> void (pub) (call pair c 2 0 rt rt2 rn off))
  (fn ldp [c:(ptr buf.Buf) rt:i32 rt2:i32 rn:i32 off:i32] -> void (pub) (call pair c 2 1 rt rt2 rn off))
  (fn stp_pre [c:(ptr buf.Buf) rt:i32 rt2:i32 rn:i32 off:i32] -> void (pub) (call pair c 3 0 rt rt2 rn off))
  (fn ldp_pre [c:(ptr buf.Buf) rt:i32 rt2:i32 rn:i32 off:i32] -> void (pub) (call pair c 3 1 rt rt2 rn off))
  (fn stp_post [c:(ptr buf.Buf) rt:i32 rt2:i32 rn:i32 off:i32] -> void (pub) (call pair c 1 0 rt rt2 rn off))
  (fn ldp_post [c:(ptr buf.Buf) rt:i32 rt2:i32 rn:i32 off:i32] -> void (pub) (call pair c 1 1 rt rt2 rn off))

  ;; ===== Atomics: acquire and release loads and stores, exclusive pairs =====

  ;; size(2) 001000 o2 l o1 rs o0 rt2 rn rt: the base register only (no offset)
  (fn excl [c:(ptr buf.Buf) sz:i32 base:i32 rs:i32 rn:i32 rt:i32] -> void
    (call emit c (bitor (if (eq sz 64) (call w 51200 0) (call w 34816 0))
                  (bitor base
                   (bitor (shl (call r rs) 16)
                    (bitor (shl (call r rn) 5) (call r rt)))))))
  ;; ldar rt, [rn]: a load that nothing after it can pass; stlr: a store that nothing before it can pass
  (fn ldar [c:(ptr buf.Buf) sz:i32 rt:i32 rn:i32] -> void (pub) (call excl c sz 14679040 0 rn rt))
  (fn stlr [c:(ptr buf.Buf) sz:i32 rt:i32 rn:i32] -> void (pub) (call excl c sz 10484736 0 rn rt))
  ;; ldaxr rt, [rn]: load acquire and open an exclusive access; stlxr rs, rt, [rn]: store
  ;; release if the access is still exclusive (rs = 0), else rs = 1
  (fn ldaxr [c:(ptr buf.Buf) sz:i32 rt:i32 rn:i32] -> void (pub) (call excl c sz 6290432 0 rn rt))
  (fn stlxr [c:(ptr buf.Buf) sz:i32 rs:i32 rt:i32 rn:i32] -> void (pub) (call excl c sz 64512 rs rn rt))
  (fn clrex [c:(ptr buf.Buf)] -> void (pub) (call emit c (call w 54531 16223)))

  ;; ===== Floating point (scalar): s0-s31 and d0-d31 are the low 32 and 64 bits of v0-v31 =====

  ;; `ft` is the format: 0 single (s), 1 double (d).
  (fn ftype [ft:i32] -> i32
    (req (or (eq ft 0) (eq ft 1)))
    (shl ft 22))

  ;; fmov between a general and a floating-point register, same width: to the
  ;; floating-point register (fmov d0, x0 / s0, w0), or back (fmov x0, d0 / w0, s0).
  (fn fmov_to_fp [c:(ptr buf.Buf) ft:i32 fd:i32 rn:i32] -> void (pub)
    (call emit c (bitor (if (eq ft 1) (call w 40551 0) (call w 7719 0))
                  (bitor (shl (call r rn) 5) (call r fd)))))
  (fn fmov_from_fp [c:(ptr buf.Buf) ft:i32 rd:i32 fn_:i32] -> void (pub)
    (call emit c (bitor (if (eq ft 1) (call w 40550 0) (call w 7718 0))
                  (bitor (shl (call r fn_) 5) (call r rd)))))

  ;; 0 0 0 11110 type 1 rm opcode 10 rn rd: fmul 0, fdiv 1, fadd 2, fsub 3, fmax 4, fmin 5
  (fn fp2 [c:(ptr buf.Buf) ft:i32 opcode:i32 fd:i32 fn_:i32 fm:i32] -> void
    (call emit c (bitor (call w 7712 2048)
                  (bitor (call ftype ft)
                   (bitor (shl (call r fm) 16)
                    (bitor (shl opcode 12)
                     (bitor (shl (call r fn_) 5) (call r fd))))))))
  (fn fmul [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32 fm:i32] -> void (pub) (call fp2 c ft 0 fd fn_ fm))
  (fn fdiv [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32 fm:i32] -> void (pub) (call fp2 c ft 1 fd fn_ fm))
  (fn fadd [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32 fm:i32] -> void (pub) (call fp2 c ft 2 fd fn_ fm))
  (fn fsub [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32 fm:i32] -> void (pub) (call fp2 c ft 3 fd fn_ fm))
  (fn fmax [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32 fm:i32] -> void (pub) (call fp2 c ft 4 fd fn_ fm))
  (fn fmin [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32 fm:i32] -> void (pub) (call fp2 c ft 5 fd fn_ fm))

  ;; 0 0 0 11110 type 1 opcode(6) 10000 rn rd: fmov 0, fabs 1, fneg 2, fsqrt 3,
  ;; frintn 8 (round to nearest, ties to even), frintp 9 (up), frintm 10 (down), frintz 11 (toward zero)
  (fn fp1 [c:(ptr buf.Buf) ft:i32 opcode:i32 fd:i32 fn_:i32] -> void
    (call emit c (bitor (call w 7712 16384)
                  (bitor (call ftype ft)
                   (bitor (shl opcode 15)
                    (bitor (shl (call r fn_) 5) (call r fd)))))))
  (fn fmov_rr [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32] -> void (pub) (call fp1 c ft 0 fd fn_))
  (fn fabs [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32] -> void (pub) (call fp1 c ft 1 fd fn_))
  (fn fneg [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32] -> void (pub) (call fp1 c ft 2 fd fn_))
  (fn fsqrt [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32] -> void (pub) (call fp1 c ft 3 fd fn_))
  (fn frintn [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32] -> void (pub) (call fp1 c ft 8 fd fn_))
  (fn frintp [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32] -> void (pub) (call fp1 c ft 9 fd fn_))
  (fn frintm [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32] -> void (pub) (call fp1 c ft 10 fd fn_))
  (fn frintz [c:(ptr buf.Buf) ft:i32 fd:i32 fn_:i32] -> void (pub) (call fp1 c ft 11 fd fn_))
  ;; fcvt dd, sn (single to double, exact) and fcvt sd, dn (double to single, rounded)
  (fn fcvt_to_double [c:(ptr buf.Buf) fd:i32 fn_:i32] -> void (pub)
    (call emit c (bitor (call w 7714 49152) (bitor (shl (call r fn_) 5) (call r fd)))))
  (fn fcvt_to_single [c:(ptr buf.Buf) fd:i32 fn_:i32] -> void (pub)
    (call emit c (bitor (call w 7778 16384) (bitor (shl (call r fn_) 5) (call r fd)))))

  ;; fcmp fn, fm: sets the flags (unordered, a NaN: C and V set, N and Z clear)
  (fn fcmp [c:(ptr buf.Buf) ft:i32 fn_:i32 fm:i32] -> void (pub)
    (call emit c (bitor (call w 7712 8192)
                  (bitor (call ftype ft)
                   (bitor (shl (call r fm) 16) (shl (call r fn_) 5))))))

  ;; the conversions between a floating-point value of format ft and an integer of
  ;; size sz: fcvtzs / fcvtzu truncate toward zero and saturate (a NaN gives 0);
  ;; scvtf / ucvtf read the integer as signed / unsigned
  (fn fcvtzs [c:(ptr buf.Buf) sz:i32 ft:i32 rd:i32 fn_:i32] -> void (pub)
    (call emit c (bitor (call sf sz) (bitor (call w 7736 0) (bitor (call ftype ft) (bitor (shl (call r fn_) 5) (call r rd)))))))
  (fn fcvtzu [c:(ptr buf.Buf) sz:i32 ft:i32 rd:i32 fn_:i32] -> void (pub)
    (call emit c (bitor (call sf sz) (bitor (call w 7737 0) (bitor (call ftype ft) (bitor (shl (call r fn_) 5) (call r rd)))))))
  (fn scvtf [c:(ptr buf.Buf) sz:i32 ft:i32 fd:i32 rn:i32] -> void (pub)
    (call emit c (bitor (call sf sz) (bitor (call w 7714 0) (bitor (call ftype ft) (bitor (shl (call r rn) 5) (call r fd)))))))
  (fn ucvtf [c:(ptr buf.Buf) sz:i32 ft:i32 fd:i32 rn:i32] -> void (pub)
    (call emit c (bitor (call sf sz) (bitor (call w 7715 0) (bitor (call ftype ft) (bitor (shl (call r rn) 5) (call r fd)))))))

  ;; ===== Branches =====
  ;; The instruction at buffer position `at`, and the bits of it a patch sets.
  (fn word_at [c:(ptr buf.Buf) at:i32] -> i32
    (req (and (gte at 0) (lte (+ at 4) (call buf.len c))))
    (unsafe (mem.load32 (+ (get c buf.Buf.data) at))))

  (fn set_word [c:(ptr buf.Buf) at:i32 v:i32] -> void
    (unsafe (let p:i32 (+ (get c buf.Buf.data) at))
    (for k 0 4
      (mem.store8 (+ p k) (bitand (shru v (* 8 k)) 255)))))

  ;; b and bl take a 26-bit word offset (imm26); the instruction is emitted
  ;; with offset 0 and its position returned, for patch_b.
  (fn b [c:(ptr buf.Buf)] -> i32 (pub)
    (let at:i32 (call buf.len c))
    (call emit c (call w 5120 0))
    at)
  (fn bl [c:(ptr buf.Buf)] -> i32 (pub)
    (let at:i32 (call buf.len c))
    (call emit c (call w 37888 0))
    at)

  ;; Points the b or bl at buffer position `at` to position `target`, forward or backward.
  (fn patch_b [c:(ptr buf.Buf) at:i32 target:i32] -> void (pub)
    (req (eq (% (- target at) 4) 0))
    (req (and (gte (/ (- target at) 4) -33554432) (lte (/ (- target at) 4) 33554431)))
    (let off:i32 (/ (- target at) 4))
    (call set_word c at (bitor (bitand (call word_at c at) -67108864) (bitand off 67108863))))

  ;; b target for a target already in the buffer
  (fn b_to [c:(ptr buf.Buf) target:i32] -> void (pub)
    (call patch_b c (call b c) target))

  ;; b.cond, cbz, cbnz take a 19-bit word offset (imm19, bits 5-23): emitted
  ;; with offset 0, the position returned, for patch_cond.
  (fn b_cond [c:(ptr buf.Buf) cc:i32] -> i32 (pub)
    (req (and (gte cc 0) (lte cc 15)))
    (let at:i32 (call buf.len c))
    (call emit c (bitor (call w 21504 0) cc))
    at)
  ;; sf 011010 op imm19 rt: cbz op 0, cbnz op 1
  (fn cbz [c:(ptr buf.Buf) sz:i32 rt:i32] -> i32 (pub)
    (let at:i32 (call buf.len c))
    (call emit c (bitor (call sf sz) (bitor (call w 13312 0) (call r rt))))
    at)
  (fn cbnz [c:(ptr buf.Buf) sz:i32 rt:i32] -> i32 (pub)
    (let at:i32 (call buf.len c))
    (call emit c (bitor (call sf sz) (bitor (call w 13568 0) (call r rt))))
    at)
  (fn patch_cond [c:(ptr buf.Buf) at:i32 target:i32] -> void (pub)
    (req (eq (% (- target at) 4) 0))
    (req (and (gte (/ (- target at) 4) -262144) (lte (/ (- target at) 4) 262143)))
    (let off:i32 (/ (- target at) 4))
    (call set_word c at (bitor (bitand (call word_at c at) -16777185) (shl (bitand off 524287) 5))))

  ;; adr rd, label: rd = the address of buffer position `target` (relative to
  ;; the instruction): emitted with offset 0, patched by patch_adr (a byte
  ;; offset of 21 bits, immlo in bits 29-30 and immhi in bits 5-23).
  (fn adr [c:(ptr buf.Buf) rd:i32] -> i32 (pub)
    (let at:i32 (call buf.len c))
    (call emit c (bitor (call w 4096 0) (call r rd)))
    at)
  (fn patch_adr [c:(ptr buf.Buf) at:i32 target:i32] -> void (pub)
    (req (and (gte (- target at) -1048576) (lte (- target at) 1048575)))
    (let off:i32 (- target at))
    (call set_word c at (bitor (bitand (call word_at c at) -1627389921)
                          (bitor (shl (bitand off 3) 29) (shl (bitand (shru off 2) 524287) 5)))))

  ;; br rn, blr rn (call), ret (through x30, or rn)
  (fn br [c:(ptr buf.Buf) rn:i32] -> void (pub) (call emit c (bitor (call w 54815 0) (shl (call r rn) 5))))
  (fn blr [c:(ptr buf.Buf) rn:i32] -> void (pub) (call emit c (bitor (call w 54847 0) (shl (call r rn) 5))))
  (fn ret_r [c:(ptr buf.Buf) rn:i32] -> void (pub) (call emit c (bitor (call w 54879 0) (shl (call r rn) 5))))
  (fn ret [c:(ptr buf.Buf)] -> void (pub) (call ret_r c 30))

  ;; ===== System =====

  ;; svc #imm16: the system call (the number in x8, arguments in x0-x5, the result in x0)
  (fn svc [c:(ptr buf.Buf) imm16:i32] -> void (pub)
    (req (and (gte imm16 0) (lte imm16 65535)))
    (call emit c (bitor (call w 54272 1) (shl imm16 5))))
  ;; brk #imm16: a breakpoint trap; udf #imm16: the permanently undefined instruction
  (fn brk [c:(ptr buf.Buf) imm16:i32] -> void (pub)
    (req (and (gte imm16 0) (lte imm16 65535)))
    (call emit c (bitor (call w 54304 0) (shl imm16 5))))
  (fn udf [c:(ptr buf.Buf) imm16:i32] -> void (pub)
    (req (and (gte imm16 0) (lte imm16 65535)))
    (call emit c imm16))
  (fn nop [c:(ptr buf.Buf)] -> void (pub) (call emit c (call w 54531 8223)))
  ;; dmb ish (a full barrier among the cores), isb
  (fn dmb_ish [c:(ptr buf.Buf)] -> void (pub) (call emit c (call w 54531 15295)))
  (fn isb [c:(ptr buf.Buf)] -> void (pub) (call emit c (call w 54531 16351)))

  ;; ===== Self-tests =====

  ;; The buffer as lowercase hex, eight digits per instruction, no separators,
  ;; each word as it is written in the assembler's output (most significant
  ;; digit first), so a vector reads like an assembler listing.
  (fn hex [c:(ptr buf.Buf)] -> str.Bytes
    (unsafe (let out:(ptr buf.Buf) (call buf.make (call alloc.default) (+ 2 (* 2 (call buf.len c)))))
    (for k 0 (/ (call buf.len c) 4)
      (let v:i32 (mem.load32 (+ (get c buf.Buf.data) (* 4 k))))
      (for d 0 8
        (call buf.push_byte out (call hex_digit (bitand (shru v (- 28 (* 4 d))) 15)))))
    (call buf.bytes out)))

  (fn hex_digit [d:i32] -> i32 (if (lt d 10) (+ 48 d) (+ 87 d)))

  ;; 1 if the buffer holds exactly `expected` (hex), else prints both and 0.
  (fn check [name:str c:(ptr buf.Buf) expected:str] -> i32
    (unsafe (let got:str.Bytes (call hex c))
    (if (call str.bytes_eq got (call str.from_str expected))
        1
        (block
          (sys.print "arm64 test failed:" name "got:")
          (call buf.clear c)
          (call buf.push_bytes c got)
          (call buf.push_byte c 10)
          (call buf.push_str c "want:")
          (call buf.push_byte c 10)
          (call buf.push_str c expected)
          (call buf.push_byte c 10)
          (fs.write 1 (get c buf.Buf.data) (call buf.len c))
          0))))

  ;; ARM64_TESTS_BEGIN
  ;; Test vectors are the output of Apple's assembler (clang -arch arm64, on a
  ;; Mac, read back with otool) for the same instruction sequences, pasted in
  ;; as hex; they are never produced by this encoder (python3
  ;; tools/arm64_vectors.py regenerates this whole region). Each loop covers every
  ;; register x0-x30. q(r) = (7r + 3) mod 31 pairs each register with a
  ;; different one, so every register also appears in the other operands.
  (fn q [r:i32] -> i32 (% (+ (* r 7) 3) 31))

  (fn test_moves [] -> i32
    (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 65536))
    (for i 0 31
      (call movz c 64 i (* (% i 31) 1000) (* (% i 4) 16))
      (call movk c 64 (call q i) (+ (* (% i 31) 1000) 7) (* (% i 4) 16))
      (call movn c 64 (call q (call q i)) (+ (* (% i 31) 1000) 3) (* (% i 4) 16))
      (call movz c 64 i 65535 0)
      (call movz c 32 i (* (% i 31) 1000) (* (% i 2) 16))
      (call movk c 32 (call q i) (+ (* (% i 31) 1000) 7) (* (% i 2) 16))
      (call movn c 32 (call q (call q i)) (+ (* (% i 31) 1000) 3) (* (% i 2) 16))
      (call movz c 32 i 65535 0)
      (call mov_imm c 64 i 0i64)
      (call mov_imm c 64 i 1i64)
      (call mov_imm c 64 i 65535i64)
      (call mov_imm c 64 i 65536i64)
      (call mov_imm c 64 i 4294967295i64)
      (call mov_imm c 64 i -1i64)
      (call mov_imm c 64 i -2i64)
      (call mov_imm c 64 i -65536i64)
      (call mov_imm c 64 i -65537i64)
      (call mov_imm c 64 i 305419896i64)
      (call mov_imm c 64 i 81985529216486895i64)
      (call mov_imm c 64 i -81985529216486896i64)
      (call mov_imm c 64 i 4886718345i64)
      (call mov_imm c 64 i 281470681808895i64)
      (call mov_imm c 64 i -281470681808896i64)
      (call mov_imm c 64 i 281474976776192i64)
      (call mov_imm c 64 i 281474976710656i64)
      (call mov_imm c 32 i 0i64)
      (call mov_imm c 32 i 1i64)
      (call mov_imm c 32 i 65535i64)
      (call mov_imm c 32 i 65536i64)
      (call mov_imm c 32 i 4294967295i64)
      (call mov_imm c 32 i -1i64)
      (call mov_imm c 32 i -2i64)
      (call mov_imm c 32 i -65536i64)
      (call mov_imm c 32 i -65537i64)
      (call mov_imm c 32 i 305419896i64))
    (call check "moves" c ""))

  (fn test_alu_reg [] -> i32
    (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 65536))
    (for i 0 31
      (call add_rrr c 64 i (call q i) (call q (call q i)))
      (call add_rrr c 32 (call q i) i (call q (call q i)))
