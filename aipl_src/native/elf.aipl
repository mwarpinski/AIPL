;; elf: writes a Linux x86-64 or AArch64 executable (ELF64, statically linked,
;; no libc) around machine code and data (native backend task NE4,
;; docs/design/NATIVE_BACKEND_PLAN.md; the AArch64 form is NA3,
;; docs/design/ARM64_PLAN.md).
;;
;; Layout (all page-aligned; 4 KiB pages for x86-64, 64 KiB for AArch64, whose
;; Linux kernels use 4, 16, or 64 KiB pages: segments on 64 KiB boundaries load
;; on every one):
;;   file 0x0000          ELF header + 4 program headers, loaded read-only at
;;                        base_vaddr (0x400000): the first segment maps file
;;                        offset 0, as Rosetta 2 requires
;;   file 0x1000          data, loaded read+write at data_vaddr (0x401000),
;;                        followed in memory by `bss` zero bytes
;;   file code_offset     code, loaded read+execute at code_vaddr
;; The data comes first so its address is fixed before the code is
;; generated: code refers to data by absolute address (it fits in 32 bits),
;; and needs no relocation however long the code turns out (on AArch64,
;; where the address is built with movz and movk, it fits in 32 bits too).
;;
;;   (let exe:(ptr buf.Buf) (call elf.image code entry data bss))          ;; x86-64
;;   (let exe:(ptr buf.Buf) (call elf.image_arm64 code entry data bss))    ;; AArch64
(module elf
  (import alloc)
  (import str)
  (import buf)

  (struct Layout [data_vaddr:i32 data_offset:i32 (read code_vaddr:i32) code_offset:i32] (pub))

  (fn page [] -> i32 4096)
  (fn page_arm64 [] -> i32 (pub) 65536)
  (fn base_vaddr [] -> i32 4194304)   ;; 0x400000, the conventional start
  (fn data_vaddr [] -> i32 (pub) 4198400)   ;; 0x401000
  (fn data_vaddr_arm64 [] -> i32 (pub) 4259840)   ;; 0x410000

  ;; n rounded up to a multiple of `page` (a power of two)
  (fn align_to [n:i32 page:i32] -> i32
    (req (gte n 0))
    (bitand (+ n (- page 1)) (- 0 page)))

  (fn align_page [n:i32] -> i32 (call align_to n 4096))

  ;; Where the segments land for `data_len` bytes of data and `bss` zero
  ;; bytes after them. The code starts on the first page past both (past
  ;; data_vaddr's page when both are empty, so the segments never share an
  ;; address; Linux maps nothing for an empty segment).
  (fn layout [data_len:i32 bss:i32] -> (ptr Layout) (pub)
    (call layout_for 4096 data_len bss))

  ;; layout on pages of 64 KiB
  (fn layout_arm64 [data_len:i32 bss:i32] -> (ptr Layout) (pub)
    (call layout_for 65536 data_len bss))

  (fn layout_for [page:i32 data_len:i32 bss:i32] -> (ptr Layout)
    (req (and (gte data_len 0) (gte bss 0)))
    (let vaddr:i32 (+ (call base_vaddr) page))
    (let l:(ptr Layout) (new Layout (call alloc.forever) [data_vaddr:vaddr
                                                          data_offset:page
                                                          code_vaddr:(zero i32)
                                                          code_offset:(call align_to (+ page data_len) page)]))
    (let total:i32 (+ data_len bss))
    (put l Layout.code_vaddr (call align_to (+ vaddr (if (eq total 0) 1 total)) page))
    l)

  ;; ===== Little-endian fields =====

  (fn u8 [b:(ptr buf.Buf) v:i32] -> void (call buf.push_byte b (bitand v 255)))
  (fn u16 [b:(ptr buf.Buf) v:i32] -> void (call u8 b v) (call u8 b (shru v 8)))
  (fn u32 [b:(ptr buf.Buf) v:i32] -> void (call u16 b v) (call u16 b (shru v 16)))
  ;; a non-negative i32 as a u64
  (fn u64 [b:(ptr buf.Buf) v:i32] -> void
    (req (gte v 0))
    (call u32 b v)
    (call u32 b 0))

  ;; One program header. flags: 4 read, 2 write, 1 execute.
  (fn phdr [b:(ptr buf.Buf) type:i32 flags:i32 offset:i32 vaddr:i32 filesz:i32 memsz:i32 align:i32] -> void
    (call u32 b type)
    (call u32 b flags)
    (call u64 b offset)
    (call u64 b vaddr)
    (call u64 b vaddr)    ;; physical address: unused, same as virtual by convention
    (call u64 b filesz)
    (call u64 b memsz)
    (call u64 b align))

  ;; The executable: `code` runs from byte `entry` of the code; `data` is
  ;; loaded at data_vaddr with `bss` zero bytes after it.
  (fn image [code:str.Bytes entry:i32 data:str.Bytes bss:i32] -> (ptr buf.Buf) (pub)
    (call image_for 62 4096 code entry data bss))

  ;; the AArch64 executable: machine 183, segments on 64 KiB boundaries
  (fn image_arm64 [code:str.Bytes entry:i32 data:str.Bytes bss:i32] -> (ptr buf.Buf) (pub)
    (call image_for 183 65536 code entry data bss))

  (fn image_for [machine:i32 page:i32 code:str.Bytes entry:i32 data:str.Bytes bss:i32] -> (ptr buf.Buf)
    (req (and (gte entry 0) (lt entry (get code str.Bytes.len))))
    (let dlen:i32 (get data str.Bytes.len))
    (let clen:i32 (get code str.Bytes.len))
    (let l:(ptr Layout) (call layout_for page dlen bss))
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) (+ (get l Layout.code_offset) clen)))
    ;; ELF header: identification (64-bit, little-endian, version 1, System V)
    (call u8 b 127) (call buf.push_str b "ELF")
    (call u8 b 2) (call u8 b 1) (call u8 b 1) (call u8 b 0)
    (for i 1 9 (call u8 b 0))
    (call u16 b 2)                                     ;; e_type: executable
    (call u16 b machine)                               ;; e_machine: 62 x86-64, 183 AArch64
    (call u32 b 1)                                     ;; e_version
    (call u64 b (+ (get l Layout.code_vaddr) entry))   ;; e_entry
    (call u64 b 64)                                    ;; e_phoff: right after this header
    (call u64 b 0)                                     ;; e_shoff: no section headers
    (call u32 b 0)                                     ;; e_flags
    (call u16 b 64)                                    ;; e_ehsize
    (call u16 b 56)                                    ;; e_phentsize
    (call u16 b 4)                                     ;; e_phnum
    (call u16 b 64)                                    ;; e_shentsize
    (call u16 b 0)                                     ;; e_shnum
    (call u16 b 0)                                     ;; e_shstrndx
    ;; the headers: read; data: read+write; code: read+execute; the stack: read+write, not executable
    (call phdr b 1 4 0 (call base_vaddr) 288 288 page)   ;; 64 + 4 * 56 bytes
    (call phdr b 1 6 (get l Layout.data_offset) (get l Layout.data_vaddr) dlen (+ dlen bss) page)
    (call phdr b 1 5 (get l Layout.code_offset) (get l Layout.code_vaddr) clen clen page)
    (call phdr b 1685382481 6 0 0 0 0 16)              ;; PT_GNU_STACK (0x6474e551)
    (call pad_to b (get l Layout.data_offset))
    (call buf.push_bytes b data)
    (call pad_to b (get l Layout.code_offset))
    (call buf.push_bytes b code)
    b)

  (fn pad_to [b:(ptr buf.Buf) n:i32] -> void
    (req (lte (call buf.len b) n))
    (while (lt (call buf.len b) n) (call u8 b 0)))

  ;; ===== Self-tests =====

  (fn at8 [b:(ptr buf.Buf) i:i32] -> i32 (unsafe (mem.load8 (+ (get b buf.Buf.data) i))))
  (fn at32 [b:(ptr buf.Buf) i:i32] -> i32
    (bitor (call at8 b i) (bitor (shl (call at8 b (+ i 1)) 8) (bitor (shl (call at8 b (+ i 2)) 16) (shl (call at8 b (+ i 3)) 24)))))

  ;; Pass count; test_suite.aipl expects 4.
  (fn run_elf_tests [] -> i32 (pub)
    (let p:i32 0)
    ;; layout: 10 bytes of data and 5000 of bss push the code two pages on
    (let l:(ptr Layout) (call layout 10 5000))
    (when (and (eq (get l Layout.code_offset) 8192) (eq (get l Layout.code_vaddr) (+ (call data_vaddr) 8192)))
        (set! p (+ p 1)))
    ;; a whole page of data moves the code a further page in the file
    (let l2:(ptr Layout) (call layout 4096 0))
    (when (and (eq (get l2 Layout.code_offset) 8192) (eq (get l2 Layout.code_vaddr) (+ (call data_vaddr) 4096)))
        (set! p (+ p 1)))
    ;; the header: magic, entry = code page + 2, the data and code at their offsets
    (let code:(ptr buf.Buf) (call buf.make (call alloc.default) 4))
    (call u8 code 144) (call u8 code 144) (call u8 code 195)  ;; nop nop ret
    (let data:(ptr buf.Buf) (call buf.make (call alloc.default) 4))
    (call buf.push_str data "hi")
    (let b:(ptr buf.Buf) (call image (call buf.bytes code) 2 (call buf.bytes data) 0))
    (when (and (eq (call at32 b 0) 1179403647)                       ;; 7f 'E' 'L' 'F'
             (and (eq (call at32 b 24) (+ (call data_vaddr) 4098))
                  (and (eq (call at8 b 4096) 104)
                       (and (eq (call at8 b 8194) 195) (eq (call buf.len b) 8195)))))
        (set! p (+ p 1)))
    ;; program headers (at 64, 56 bytes each): type and permissions; the
    ;; headers read-only from file offset 0, data read+write, code
    ;; read+execute, stack read+write and never executable
    (when (and (and (eq (call at32 b 64) 1) (eq (call at32 b 68) 4))
             (and (and (eq (call at32 b 72) 0) (eq (call at32 b 80) (call base_vaddr)))
                  (and (and (eq (call at32 b 120) 1) (eq (call at32 b 124) 6))
                       (and (and (eq (call at32 b 176) 1) (eq (call at32 b 180) 5))
                            (and (eq (call at32 b 232) 1685382481) (eq (call at32 b 236) 6))))))
        (set! p (+ p 1)))
    p)

  ;; Pass count: 4. The AArch64 form: segments on 64 KiB boundaries, machine 183.
  (fn run_elf_arm64_tests [] -> i32 (pub)
    (let p:i32 0)
    ;; 10 bytes of data and 70000 of bss push the code two 64 KiB pages on
    (let l:(ptr Layout) (call layout_arm64 10 70000))
    (when (and (eq (get l Layout.data_offset) 65536)
             (and (eq (get l Layout.code_offset) 131072) (eq (get l Layout.code_vaddr) (+ (call data_vaddr_arm64) 131072))))
        (set! p (+ p 1)))
    ;; a whole 64 KiB of data moves the code one page on in the file and in memory
    (let l2:(ptr Layout) (call layout_arm64 65536 0))
    (when (and (eq (get l2 Layout.code_offset) 131072) (eq (get l2 Layout.code_vaddr) (+ (call data_vaddr_arm64) 65536)))
        (set! p (+ p 1)))
    (let code:(ptr buf.Buf) (call buf.make (call alloc.default) 8))
    (call u32 code 0)
    (call u32 code 0)
    (let data:(ptr buf.Buf) (call buf.make (call alloc.default) 4))
    (call buf.push_str data "hi")
    (let b:(ptr buf.Buf) (call image_arm64 (call buf.bytes code) 4 (call buf.bytes data) 0))
    ;; ELF magic, machine 183, entry = the code's page + 4, data at 64 KiB, code at 128 KiB
    (when (and (eq (call at32 b 0) 1179403647)
             (and (eq (call at8 b 18) 183)
                  (and (eq (call at32 b 24) (+ (call data_vaddr_arm64) 65540))
                       (and (eq (call at8 b 65536) 104) (eq (call buf.len b) 131080)))))
        (set! p (+ p 1)))
    ;; the headers read-only from file offset 0, and every segment aligned to 64 KiB
    (when (and (and (eq (call at32 b 64) 1) (eq (call at32 b 68) 4))
             (and (and (eq (call at32 b 72) 0) (eq (call at32 b 80) (call base_vaddr)))
                  (and (and (eq (call at32 b 112) 65536) (eq (call at32 b 120) 1))
                       (and (eq (call at32 b 168) 65536) (eq (call at32 b 224) 65536)))))
        (set! p (+ p 1)))
    p)
)
