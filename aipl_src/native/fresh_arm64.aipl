;; fresh_arm64: the host of an executable built with `aipl compile --exe --serve ADDR:PORT`
;; (docs/design/NET_PLAN.md, mode B, step 4) for AArch64 Linux: a fresh instance of the program per
;; connection, as aipl-run --serve-fresh gives (src/bin/aipl_run.rs serve_fresh), and fresh.aipl's
;; counterpart for x86-64, which states what it does in full:
;;   - the host listens on the address fixed when the executable was compiled, then, for each connection,
;;     starts a copy of itself (clone(SIGCHLD): memory is copied as it is written) that has the
;;     connection as its standard input and a pipe as its standard output, closes everything else of the
;;     host's, and goes on with start-up, so the program runs from the beginning;
;;   - the host reads the pipe to its end (at most `cap` bytes kept), waits for the copy, and sends what it
;;     wrote if it exited with status 0, and otherwise (another status, a trap, a signal, or more
;;     output than it keeps) a plain 500; then it shuts the connection down and closes it;
;;   - one connection at a time, until the process is ended or, with a limit fixed when the executable
;;     was compiled, until it has answered that many; an executable compiled `temporary` removes
;;     itself (unlinkat of argv[0]) as it starts.
;; AArch64's system calls: socket 198, setsockopt 208, bind 200, listen 201, accept4 242, pipe2 59, clone
;; 220, dup3 24, wait4 260, mmap 222, sendto 206, shutdown 210, unlinkat 35, read 63, write 64, close 57.
(module fresh_arm64
  (import alloc)
  (import str)
  (import buf)
  (import vec)
  (import arm64)
  (import runtime_arm64)
  (import lower_arm64)
  (import wasi_arm64)
  (import backtrace_arm64)
  (import sockets_arm64)

  ;; The most output kept for one answer: 64 MiB, as aipl-run keeps.
  (fn cap [] -> i32 67108864)

  ;; The host's frame on the stack: the pipe's two descriptors, the child, its wait status, the output
  ;; buffer, whether the output was too long, setsockopt's 1, and the connections left to answer.
  (fn pipe_r [] -> i32 0) (fn pipe_w [] -> i32 4) (fn pid [] -> i32 8)
  (fn wstatus [] -> i32 16) (fn out [] -> i32 24) (fn over [] -> i32 32)
  (fn one [] -> i32 40) (fn left [] -> i32 48) (fn frame [] -> i32 64)

  ;; What Linux's strerror says for the errors a listen meets, as Rust's io::Error prints them
  ;; (aipl-run's message); others are "os error N".
  (struct Why [errno:i32 text:i32 len:i32] (value))

  (fn why [l:(ptr lower_arm64.L) errno:i32 text:str] -> Why
    (make Why [errno:errno text:(call lower_arm64.data_text l text) len:(str.len text)]))

  (fn imm [c:(ptr buf.Buf) rd:i32 v:i32] -> void
    (call wasi_arm64.imm c rd v))

  (fn syscall [c:(ptr buf.Buf) n:i32] -> void
    (call runtime_arm64.emit_syscall c n))

  ;; close(the descriptor in register `r`)
  (fn emit_close_reg [c:(ptr buf.Buf) r:i32] -> void
    (call arm64.mov_rr c 64 0 r)
    (call syscall c 57))

  ;; close(the 32-bit descriptor in the frame slot `slot`)
  (fn emit_close_slot [c:(ptr buf.Buf) slot:i32] -> void
    (call arm64.ldr_w c 0 31 slot)
    (call syscall c 57))

  ;; Jumps back to `at` while x0 is -EINTR (a signal interrupted the call).
  (fn emit_again [c:(ptr buf.Buf) at:i32] -> void
    (call imm c 4 -4)
    (call arm64.cmp_rr c 64 0 4)
    (call arm64.patch_cond c (call arm64.b_cond c (call arm64.cc_eq)) at))

  ;; dup3(old, new, 0), except where they are the same descriptor (dup3 refuses that)
  (fn emit_dup [c:(ptr buf.Buf) old:i32 new:i32] -> void
    (call arm64.mov_rr c 64 0 old)
    (call imm c 1 new)
    (call arm64.cmp_rr c 64 0 1)
    (let same:i32 (call arm64.b_cond c (call arm64.cc_eq)))
    (call imm c 2 0)
    (call syscall c 24)
    (call arm64.patch_cond c same (call buf.len c)))

  ;; `g`: the address to listen on; `t` the texts a trap says it with (argv[0] and the separator); `at` is
  ;; the grant as written, for the message when the address cannot be listened on. `requests`: how many
  ;; connections to answer before exiting with status 0 (none: -1); `temporary`: remove this
  ;; executable's own file as it starts. Registers: x20 the listening socket, x21 the connection, x22
  ;; the bytes of output, x23 the output buffer, x24 the bytes left to send.
  (fn emit_host [l:(ptr lower_arm64.L) t:(ptr backtrace_arm64.Texts) g:sockets_arm64.Grant at:str.Bytes requests:i32 temporary:bool] -> void (pub)
    (let c:(ptr buf.Buf) (get l lower_arm64.L.code))
    (let refused:(ptr (vec.Vec i32)) (call wasi_arm64.new_list))
    ;; the socket address, built now: sockaddr_in (16 bytes) or sockaddr_in6 (28), the port in network order
    (let v4:bool (eq (get g sockets_arm64.Grant.len) 4))
    (let sa:(ptr buf.Buf) (call buf.make (call alloc.default) 28))
    (let port:i32 (get g sockets_arm64.Grant.port))
    (call buf.push_byte sa (if v4 2 10))
    (call buf.push_byte sa 0)
    (call buf.push_byte sa (bitand (shru port 8) 255))
    (call buf.push_byte sa (bitand port 255))
    (when (not v4) (for k 0 4 (call buf.push_byte sa 0)))
    (for k 0 (get g sockets_arm64.Grant.len) (call buf.push_byte sa (arr.get u8 (get g sockets_arm64.Grant.addr) k)))
    (if v4 (for k 0 8 (call buf.push_byte sa 0)) (for k 0 4 (call buf.push_byte sa 0)))
    (let sa_addr:i32 (call lower_arm64.data_bytes l (call buf.bytes sa)))
    (let sa_len:i32 (call buf.len sa))
    (let failed_text:str "HTTP/1.1 500 Internal Server Error\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\nContent-Length: 22\r\n\r\nInternal Server Error\n")
    (let failed:i32 (call lower_arm64.data_text l failed_text))
    ;; why an answer past `cap` was not sent (src/net.rs FRESH_TOO_LONG)
    (let too_long_text:str "the answer is more than 64 MiB, the most a fresh instance may write: sent 500 Internal Server Error\n")
    (let too_long:i32 (call lower_arm64.data_text l too_long_text))
    (call arm64.sub_ri c 64 31 31 (call frame))
    (when temporary
          ;; unlinkat(AT_FDCWD, argv[0], 0), if there is one
          (call imm c 9 (get t backtrace_arm64.Texts.sp_cell))
          (call arm64.ldr_x c 9 9 0)
          (call arm64.ldr_x c 10 9 0)
          (let nameless:i32 (call arm64.cbz c 64 10))
          (call arm64.ldr_x c 1 9 8)
          (call imm c 0 -100)
          (call imm c 2 0)
          (call syscall c 35)
          (call arm64.patch_cond c nameless (call buf.len c)))
    ;; socket(family, SOCK_STREAM | SOCK_CLOEXEC, 0)
    (call imm c 0 (if v4 2 10))
    (call imm c 1 524289)
    (call imm c 2 0)
    (call syscall c 198)
    (call arm64.cmp_ri c 64 0 0)
    (call (vec.push i32) refused (call arm64.b_cond c (call arm64.cc_lt)))
    (call arm64.mov_rr c 64 20 0)
    ;; setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &1, 4), as Rust's bind does
    (call imm c 9 1)
    (call arm64.str_w c 9 31 (call one))
    (call arm64.mov_rr c 64 0 20)
    (call imm c 1 1)
    (call imm c 2 2)
    (call arm64.add_ri c 64 3 31 (call one))
    (call imm c 4 4)
    (call syscall c 208)
    (call arm64.cmp_ri c 64 0 0)
    (call (vec.push i32) refused (call arm64.b_cond c (call arm64.cc_lt)))
    ;; bind(fd, address, size); listen(fd, 128)
    (call arm64.mov_rr c 64 0 20)
    (call imm c 1 sa_addr)
    (call imm c 2 sa_len)
    (call syscall c 200)
    (call arm64.cmp_ri c 64 0 0)
    (call (vec.push i32) refused (call arm64.b_cond c (call arm64.cc_lt)))
    (call arm64.mov_rr c 64 0 20)
    (call imm c 1 128)
    (call syscall c 201)
    (call arm64.cmp_ri c 64 0 0)
    (call (vec.push i32) refused (call arm64.b_cond c (call arm64.cc_lt)))
    ;; the output buffer: mmap(0, cap, RW, PRIVATE|ANONYMOUS|NORESERVE, -1, 0)
    (call imm c 0 0)
    (call imm c 1 (call cap))
    (call imm c 2 3)
    (call imm c 3 16418)
    (call imm c 4 -1)
    (call imm c 5 0)
    (call syscall c 222)
    (call imm c 9 -4096)
    (call arm64.cmp_rr c 64 0 9)
    (call (vec.push i32) refused (call arm64.b_cond c (call arm64.cc_hi)))
    (call arm64.str_x c 0 31 (call out))
    ;; a limit: the connections still to answer; none to answer is the end
    (when (gte requests 0)
          (call imm c 9 requests)
          (call arm64.str_w c 9 31 (call left)))
    (when (eq requests 0) (call runtime_arm64.emit_exit c 0))
    ;; the next connection: accept4(fd, 0, 0, SOCK_CLOEXEC); an error is passed over, as aipl-run passes
    ;; over a failed accept
    (let next:i32 (call buf.len c))
    (call arm64.mov_rr c 64 0 20)
    (call imm c 1 0)
    (call imm c 2 0)
    (call imm c 3 524288)
    (call syscall c 242)
    (call arm64.cmp_ri c 64 0 0)
    (call arm64.patch_cond c (call arm64.b_cond c (call arm64.cc_lt)) next)
    (call arm64.mov_rr c 64 21 0)
    ;; pipe2(fds, O_CLOEXEC), then clone(SIGCHLD); either failing drops the connection
    (let drop:(ptr (vec.Vec i32)) (call wasi_arm64.new_list))
    (let drop_b:(ptr (vec.Vec i32)) (call wasi_arm64.new_list))
    (call arm64.add_ri c 64 0 31 (call pipe_r))
    (call imm c 1 524288)
    (call syscall c 59)
    (call arm64.cmp_ri c 64 0 0)
    (call (vec.push i32) drop (call arm64.b_cond c (call arm64.cc_lt)))
    (call imm c 0 17)
    (call imm c 1 0)
    (call imm c 2 0)
    (call imm c 3 0)
    (call imm c 4 0)
    (call syscall c 220)
    (call arm64.cmp_ri c 64 0 0)
    (let forked:i32 (call arm64.b_cond c (call arm64.cc_ge)))
    (call emit_close_slot c (call pipe_r))
    (call emit_close_slot c (call pipe_w))
    (call (vec.push i32) drop_b (call arm64.b c))
    (call arm64.patch_cond c forked (call buf.len c))
    (let parent:i32 (call arm64.b_cond c (call arm64.cc_ne)))
    ;; the child: the connection is its standard input, the pipe its standard output (dup3 leaves both
    ;; without close-on-exec); the rest of the host's descriptors closed; then the program starts
    (call emit_dup c 21 0)
    (call arm64.ldr_w c 9 31 (call pipe_w))
    (call emit_dup c 9 1)
    (call emit_close_reg c 20)
    (call emit_close_reg c 21)
    (call emit_close_slot c (call pipe_r))
    (call emit_close_slot c (call pipe_w))
    (call arm64.add_ri c 64 31 31 (call frame))
    (let child:i32 (call arm64.b c))
    ;; the host: read what the child writes until it closes its end
    (call arm64.patch_cond c parent (call buf.len c))
    (call arm64.str_x c 0 31 (call pid))
    (call emit_close_slot c (call pipe_w))
    (call imm c 22 0)
    (call arm64.str_w c 22 31 (call over))
    (let more:i32 (call buf.len c))
    (call arm64.ldr_x c 23 31 (call out))
    (call arm64.ldr_w c 0 31 (call pipe_r))
    (call imm c 9 (call cap))
    (call arm64.cmp_rr c 64 22 9)
    (let full:i32 (call arm64.b_cond c (call arm64.cc_hs)))
    (call arm64.add_rrr c 64 1 23 22)
    (call arm64.sub_rrr c 64 2 9 22)
    (call syscall c 63)
    (call emit_again c more)
    (call arm64.cmp_ri c 64 0 0)
    (let ended:i32 (call arm64.b_cond c (call arm64.cc_le)))
    (call arm64.add_rrr c 64 22 22 0)
    (call arm64.b_to c more)
    ;; past `cap`: what follows is read and dropped, and the answer is 500
    (call arm64.patch_cond c full (call buf.len c))
    (call imm c 9 1)
    (call arm64.str_w c 9 31 (call over))
    (call arm64.mov_rr c 64 1 23)
    (call imm c 2 65536)
    (call syscall c 63)
    (call emit_again c more)
    (call arm64.cmp_ri c 64 0 0)
    (call arm64.patch_cond c (call arm64.b_cond c (call arm64.cc_gt)) more)
    (call arm64.patch_cond c ended (call buf.len c))
    (call emit_close_slot c (call pipe_r))
    ;; wait4(child, &status, 0, 0); a failed wait counts as a failed child
    (call imm c 9 -1)
    (call arm64.str_w c 9 31 (call wstatus))
    (let wait:i32 (call buf.len c))
    (call arm64.ldr_x c 0 31 (call pid))
    (call arm64.add_ri c 64 1 31 (call wstatus))
    (call imm c 2 0)
    (call imm c 3 0)
    (call syscall c 260)
    (call emit_again c wait)
    ;; status 0 (exited with 0) and all of it kept: send it; else the 500
    (call arm64.ldr_w c 9 31 (call wstatus))
    (call arm64.ldr_w c 10 31 (call over))
    (call arm64.orr_rrr c 32 9 9 10)
    (let send:i32 (call arm64.cbz c 32 9))
    ;; more than it keeps: said on standard error
    (let kept:i32 (call arm64.cbz c 32 10))
    (call runtime_arm64.emit_write c 2 too_long (str.len too_long_text))
    (call arm64.patch_cond c kept (call buf.len c))
    (call imm c 23 failed)
    (call imm c 22 (str.len failed_text))
    (call arm64.patch_cond c send (call buf.len c))
    ;; send all x22 bytes at x23: sendto(conn, p, n, MSG_NOSIGNAL, 0, 0)
    (let sending:i32 (call buf.len c))
    (call arm64.cmp_ri c 64 22 0)
    (let sent:i32 (call arm64.b_cond c (call arm64.cc_le)))
    (call arm64.mov_rr c 64 0 21)
    (call arm64.mov_rr c 64 1 23)
    (call arm64.mov_rr c 64 2 22)
    (call imm c 3 16384)
    (call imm c 4 0)
    (call imm c 5 0)
    (call syscall c 206)
    (call emit_again c sending)
    (call arm64.cmp_ri c 64 0 0)
    (let lost:i32 (call arm64.b_cond c (call arm64.cc_le)))
    (call arm64.add_rrr c 64 23 23 0)
    (call arm64.sub_rrr c 64 22 22 0)
    (call arm64.b_to c sending)
    (call arm64.patch_cond c sent (call buf.len c))
    (call arm64.patch_cond c lost (call buf.len c))
    (call wasi_arm64.patch_all c drop)
    (for q 0 (call (vec.len i32) drop_b)
      (call arm64.patch_b c (call (vec.at i32) drop_b q) (call buf.len c)))
    ;; shutdown(conn, SHUT_RDWR); close(conn); the next connection
    (call arm64.mov_rr c 64 0 21)
    (call imm c 1 2)
    (call syscall c 210)
    (call emit_close_reg c 21)
    (if (gte requests 0)
        (block
          (call arm64.ldr_w c 9 31 (call left))
          (call arm64.sub_ri c 32 9 9 1)
          (call arm64.str_w c 9 31 (call left))
          (call arm64.patch_cond c (call arm64.cbnz c 32 9) next)
          (call runtime_arm64.emit_exit c 0))
        (call arm64.b_to c next))
    ;; refused: `<argv[0]>: cannot listen on ADDR:PORT: <why> (os error N)`, exit 1; the errno in x25
    (call wasi_arm64.patch_all c refused)
    (call arm64.neg c 64 25 0)
    (call backtrace_arm64.write_argv0 c t)
    (let head:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (call buf.push_str head "cannot listen on ")
    (call buf.push_bytes head at)
    (call buf.push_str head ": ")
    (call runtime_arm64.emit_write c 2 (call lower_arm64.data_bytes l (call buf.bytes head)) (call buf.len head))
    (let whys:(arr Why) (arr.new Why (call alloc.default) 4))
    (arr.set Why whys 0 (call why l 98 "Address already in use"))
    (arr.set Why whys 1 (call why l 13 "Permission denied"))
    (arr.set Why whys 2 (call why l 99 "Cannot assign requested address"))
    (arr.set Why whys 3 (call why l 12 "Cannot allocate memory"))
    (let told:(ptr (vec.Vec i32)) (call wasi_arm64.new_list))
    (for k 0 (arr.len whys)
      (let w:Why (arr.get Why whys k))
      (call arm64.cmp_ri c 32 25 (get w Why.errno))
      (let other:i32 (call arm64.b_cond c (call arm64.cc_ne)))
      (call runtime_arm64.emit_write c 2 (get w Why.text) (get w Why.len))
      (call (vec.push i32) told (call arm64.b c))
      (call arm64.patch_cond c other (call buf.len c)))
    (let code:str " (os error ")
    (let anon:i32 (call lower_arm64.data_text l "os error "))
    (call runtime_arm64.emit_write c 2 anon 9)
    (call backtrace_arm64.write_decimal c 25)
    (let end:i32 (call lower_arm64.data_text l "\n"))
    (call runtime_arm64.emit_write c 2 end 1)
    (call runtime_arm64.emit_exit c 1)
    (for q 0 (call (vec.len i32) told)
      (call arm64.patch_b c (call (vec.at i32) told q) (call buf.len c)))
    (call runtime_arm64.emit_write c 2 (call lower_arm64.data_text l code) (str.len code))
    (call backtrace_arm64.write_decimal c 25)
    (call runtime_arm64.emit_write c 2 (call lower_arm64.data_text l ")\n") 2)
    (call runtime_arm64.emit_exit c 1)
    (call arm64.patch_b c child (call buf.len c)))
)
