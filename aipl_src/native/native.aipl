;; native: wasm bytes in, a Linux x86-64 executable out (native backend,
;; docs/design/NATIVE_BACKEND_PLAN.md, from NE5). The driver reaches it with
;; `(import native/native)`.
;;
;;   (let out:(ptr native.Output) (call native.compile wasm_bytes))
;;   (if (get out native.Output.ok) ... (get out native.Output.error))
;;
;; Code layout: the trap routine at offset 0, the start-up code (the ELF
;; entry point), one stub per imported function, then every defined
;; function in index order. Data (loaded at elf.data_vaddr): trap reasons,
;; the argv[0] and memory-size cells (8 bytes each), separators, then each
;; active data segment's bytes, which start-up copies into linear memory.
;;
;; Linear memory: start-up reserves 8 GiB (mmap with no access, so it
;; costs address space, not memory: every 32-bit address plus every
;; offset falls inside), makes the minimum usable (mprotect), and points
;; r15 at it; memory.grow makes more usable, up to the module's maximum.
;; An access outside the usable part faults, and the SIGSEGV handler turns
;; the fault into the out-of-bounds trap (runtime.emit_fault_handler).
;;
;; Threads (NE15): a threaded module imports a shared memory, keeps its
;; heap and literals in passive data that its start function copies in
;; (memory.init, once, behind an atomic flag), and imports
;; `wasi.thread-spawn`. Start-up runs the start function; thread-spawn
;; maps a stack (with the new thread's globals block at its low end),
;; clones a thread there whose FS base is that block, and the thread runs
;; the start function and `wasi_thread_start(tid, arg)`, then exits. A
;; thread that traps or calls proc_exit ends the process (exit_group), as
;; under aipl-run.
;; The start-up stub calls the module's `_start` export and exits with
;; status 0, as `aipl-run` does when `_start` returns.
(module native
  (import alloc)
  (import str)
  (import buf)
  (import vec)
  (import wasm_reader)
  (import x64)
  (import elf)
  (import runtime)
  (import lower)
  (import wasi)
  (import sockets)
  (import fresh)
  (import ip)
  (import option)

  ;; The result: the executable, or why there is none. addr and len are
  ;; exe's bytes when ok, else error's, as plain numbers for the Rust host
  ;; (src/native.rs), which reads them at offsets 0, 4, and 8 whatever a
  ;; view looks like.
  (struct Output [(read addr:i32) (read len:i32) (read ok:bool) (read error:str.Bytes) (read exe:str.Bytes)] (pub))

  (fn failure [msg:str.Bytes] -> (ptr Output)
    (unsafe (let o:(ptr Output) (new Output (call alloc.forever) [addr:(call str.addr msg)
                                                                  len:(get msg str.Bytes.len)
                                                                  ok:false
                                                                  error:msg
                                                                  exe:(call str.bytes 0 0)]))
    o))

  ;; The export named `name` of kind function, or -1.
  (fn export_func [w:(ptr wasm_reader.Wasm) name:str] -> i32
    (let want:str.Bytes (call str.from_str name))
    (let found:i32 -1)
    (for i 0 (call (vec.len (ptr wasm_reader.Export)) (get w wasm_reader.Wasm.exports))
      (let e:(ptr wasm_reader.Export) (call (vec.at (ptr wasm_reader.Export)) (get w wasm_reader.Wasm.exports) i))
      (when (and (eq (get e wasm_reader.Export.kind) 0) (call str.bytes_eq (get e wasm_reader.Export.name) want))
          (set! found (get e wasm_reader.Export.index))))
    found)

  ;; The code for imported function `imp`, called with the internal
  ;; convention (arguments on the stack above the return address).
  ;; Imports a task has not reached yet are an error naming them.
  ;; What thread-spawn needs: the functions a new thread runs and its
  ;; globals' initial values.
  (struct Threads [start_fn:i32 thread_start:i32 tid_cell:i32 globals:(ptr (vec.Vec (ptr wasm_reader.Global)))])

  ;; The stack each spawned thread gets (address space; pages appear on use).
  (fn thread_stack [] -> i32 8388608)

  ;; mprotect(base, 4096, PROT_NONE): the lowest page of a stack faults, so
  ;; nothing that gets past the stack check writes over the memory below.
  ;; Clobbers rax rcx rdx rsi rdi r11.
  (fn emit_guard_page [c:(ptr buf.Buf) base:i32] -> void
    (call x64.mov_rr c 64 7 base)
    (call x64.mov_ri32 c 6 4096)
    (call x64.alu_rr c 32 (call x64.op_xor) 2 2)
    (call x64.mov_ri32 c 0 10)
    (call x64.syscall c))

  ;; The stack limit sits this far above a stack's low end: room for the
  ;; deepest frame's operand stack, the host routines (fd_read and fd_write
  ;; take 64 KiB), and the trap routines, so running out of stack traps
  ;; with "call stack exhausted" instead of faulting.
  (fn stack_margin [] -> i32 262144)

  (fn import_stub [l:(ptr lower.L) wr:(ptr wasi.W) sk:(ptr sockets.N) th:(ptr Threads) imp:(ptr wasm_reader.Import)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let name:str.Bytes (get imp wasm_reader.Import.name))
    (cond
      ;; proc_exit(code): exit_group with the argument, never returns. As
      ;; under wasmtime, a status outside 0..125 (unsigned) is an error
      ;; (shells reserve 126 and up), reported with exit status 134.
      ((call str.bytes_eq name (call str.from_str "proc_exit"))
       (let bad:(ptr lower.Reason) (call lower.reason l "exit with invalid exit status outside of [0..126)"))
       ;; not a trap under wasmtime: no call chain
       (put bad lower.Reason.frames false)
       (call x64.load c 32 7 (call x64.mem 4 8))
       (call x64.alu_ri c 32 (call x64.op_cmp) 7 126)
       (call lower.emit_trap_if l (call x64.cc_ae) bad)
       (call x64.mov_ri32 c 0 (call runtime.sys_exit_group))
       (call x64.syscall c)
       (call x64.ud2 c))
      ((and (call str.bytes_eq (get imp wasm_reader.Import.module) (call str.from_str "aipl_net_v1"))
            (call sockets.emit_import l sk name))
       (block))
      ((and (call str.bytes_eq (get imp wasm_reader.Import.module) (call str.from_str "aipl_sys_v1"))
            (call wasi.emit_sys_import l wr name))
       (block))
      ((call wasi.emit_import l wr name) (block))
      ((and (call str.bytes_eq (get imp wasm_reader.Import.module) (call str.from_str "wasi"))
            (call str.bytes_eq name (call str.from_str "thread-spawn")))
       (call emit_thread_spawn l th))
      (else
       (when (get l lower.L.failed) (return))
       (put l lower.L.failed true)
       (call buf.push_str (get l lower.L.msg) "import not supported natively yet: ")
       (call buf.push_bytes (get l lower.L.msg) (get imp wasm_reader.Import.module))
       (call buf.push_byte (get l lower.L.msg) 46)
       (call buf.push_bytes (get l lower.L.msg) name))))

  ;; thread-spawn(start_arg) -> tid (positive), or -1 if no thread could be
  ;; made. The new thread's stack top holds [tid][start_arg], which are
  ;; wasi_thread_start's arguments as pushed by a caller.
  (fn emit_thread_spawn [l:(ptr lower.L) th:(ptr Threads)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let rbx:i32 3) (let r12:i32 12) (let r13:i32 13)
    (call x64.load c 32 r12 (call x64.mem 4 8))
    ;; tid = fetch-and-add on the counter (starts at 1, as aipl-run's)
    (call x64.mov_ri32 c 1 (get th Threads.tid_cell))
    (call x64.mov_ri32 c 0 1)
    (call x64.lock c)
    (call x64.xadd c 32 (call x64.mem 1 0) 0)
    (call x64.mov_rr c 32 r13 0)
    ;; the stack: mmap(0, size, RW, PRIVATE|ANONYMOUS|NORESERVE|STACK, -1, 0)
    (call x64.alu_rr c 32 (call x64.op_xor) 7 7)
    (call x64.mov_ri32 c 6 (call thread_stack))
    (call x64.mov_ri32 c 2 3)
    (call x64.mov_ri32 c 10 147490)
    (call x64.mov_ri64 c 8 -1i64)
    (call x64.alu_rr c 32 (call x64.op_xor) 9 9)
    (call x64.mov_ri32 c 0 9)
    (call x64.syscall c)
    (call x64.alu_ri c 64 (call x64.op_cmp) 0 -4096)
    (let no_stack:i32 (call x64.jcc c (call x64.cc_a)))
    (call x64.mov_rr c 64 rbx 0)
    (call emit_guard_page c rbx)
    (call x64.alu_ri c 64 (call x64.op_add) rbx 4096)
    ;; the thread's globals at the low end, above the guard page, with their
    ;; initial values
    (let gs:(ptr (vec.Vec (ptr wasm_reader.Global))) (get th Threads.globals))
    (for i 0 (call (vec.len (ptr wasm_reader.Global)) gs)
      (call x64.mov_ri64 c 0 (get (call (vec.at (ptr wasm_reader.Global)) gs i) wasm_reader.Global.init))
      (call x64.store c 64 (call x64.mem rbx (* 8 i)) 0))
    ;; and its stack limit, after them (then its results area, far below
    ;; where its stack can reach)
    (call x64.lea c 64 0 (call x64.mem rbx (call stack_margin)))
    (call x64.store c 64 (call x64.mem rbx (get l lower.L.stack_limit_off)) 0)
    ;; [tid][start_arg] at the top, the stack pointer below them
    (call x64.lea c 64 6 (call x64.mem rbx (- (call thread_stack) 4096)))
    (call x64.store c 64 (call x64.mem 6 -8) r13)
    (call x64.store c 64 (call x64.mem 6 -16) r12)
    (call x64.alu_ri c 64 (call x64.op_sub) 6 16)
    ;; clone(VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|SETTLS, stack, 0, 0, tls = globals)
    (call x64.mov_ri32 c 7 855808)
    (call x64.alu_rr c 32 (call x64.op_xor) 2 2)
    (call x64.alu_rr c 32 (call x64.op_xor) 10 10)
    (call x64.mov_rr c 64 8 rbx)
    (call x64.mov_ri32 c 0 56)
    (call x64.syscall c)
    (call x64.test_rr c 64 0 0)
    (let failed:i32 (call x64.jcc c (call x64.cc_s)))
    (let child:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.mov_rr c 32 0 r13)
    (call x64.ret c)
    (call x64.patch_rel32 c failed (call buf.len c))
    (call x64.patch_rel32 c no_stack (call buf.len c))
    (call x64.mov_ri32 c 0 -1)
    (call x64.ret c)
    ;; the new thread: its own instance's start function, then the work;
    ;; then it exits (exit: this thread only)
    (call x64.patch_rel32 c child (call buf.len c))
    (when (gte (get th Threads.start_fn) 0) (call lower.emit_call l (get th Threads.start_fn)))
    ;; wasi_thread_start(tid, start_arg) takes them in registers (lower.arg_reg)
    (call x64.load c 64 7 (call x64.mem 4 8))
    (call x64.load c 64 6 (call x64.mem 4 0))
    (call lower.emit_call l (get th Threads.thread_start))
    (call x64.alu_rr c 32 (call x64.op_xor) 7 7)
    (call x64.mov_ri32 c 0 60)
    (call x64.syscall c)
    (call x64.ud2 c))

  ;; The main thread moves to its own stack, the size of a spawned thread's,
  ;; so the depth at which a program runs out of stack is the same on every
  ;; machine (the initial stack's size is the user's ulimit), and its limit
  ;; goes in the globals block. If the stack cannot be mapped, the limit
  ;; stays 0: no check, as before.
  (fn emit_main_stack [l:(ptr lower.L) globals_block:i32] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    ;; mmap(0, size, RW, PRIVATE|ANONYMOUS|NORESERVE|STACK, -1, 0)
    (call x64.alu_rr c 32 (call x64.op_xor) 7 7)
    (call x64.mov_ri32 c 6 (call thread_stack))
    (call x64.mov_ri32 c 2 3)
    (call x64.mov_ri32 c 10 147490)
    (call x64.mov_ri64 c 8 -1i64)
    (call x64.alu_rr c 32 (call x64.op_xor) 9 9)
    (call x64.mov_ri32 c 0 9)
    (call x64.syscall c)
    (call x64.alu_ri c 64 (call x64.op_cmp) 0 -4096)
    (let no_stack:i32 (call x64.jcc c (call x64.cc_a)))
    (call x64.mov_rr c 64 3 0)
    (call emit_guard_page c 3)
    (call x64.mov_rr c 64 0 3)
    (call x64.mov_ri32 c 1 globals_block)
    (call x64.lea c 64 2 (call x64.mem 0 (+ (call stack_margin) 4096)))
    (call x64.store c 64 (call x64.mem 1 (get l lower.L.stack_limit_off)) 2)
    (call x64.lea c 64 4 (call x64.mem 0 (call thread_stack)))
    (call x64.patch_rel32 c no_stack (call buf.len c)))

  (fn imports_thread_spawn [l:(ptr lower.L)] -> bool
    (for i 0 (call lower.n_fimports l)
      (let imp:(ptr wasm_reader.Import) (call (vec.at (ptr wasm_reader.Import)) (get l lower.L.fimports) i))
      (when (call str.bytes_eq (get imp wasm_reader.Import.name) (call str.from_str "thread-spawn")) (return true)))
    false)

  ;; The module's memory: its own, or the one it imports; null if none.
  (fn memory_limits [w:(ptr wasm_reader.Wasm)] -> (ptr wasm_reader.Limits)
    (let mems:(ptr (vec.Vec (ptr wasm_reader.Limits))) (get w wasm_reader.Wasm.memories))
    (when (gt (call (vec.len (ptr wasm_reader.Limits)) mems) 0) (return (call (vec.at (ptr wasm_reader.Limits)) mems 0)))
    (for i 0 (call (vec.len (ptr wasm_reader.Import)) (get w wasm_reader.Wasm.imports))
      (let imp:(ptr wasm_reader.Import) (call (vec.at (ptr wasm_reader.Import)) (get w wasm_reader.Wasm.imports) i))
      (when (eq (get imp wasm_reader.Import.kind) 2) (return (get imp wasm_reader.Import.limits))))
    (ptr.null wasm_reader.Limits))

  ;; The reason a module's memory or data cannot be translated, or "" if
  ;; it can (one memory, its own or imported, with a maximum of at most
  ;; 32768 pages, 2 GiB, and active data segments that fit its initial size).
  (fn memory_problem [w:(ptr wasm_reader.Wasm)] -> str
    (let lim:(ptr wasm_reader.Limits) (call memory_limits w))
    (when (eq lim (ptr.null wasm_reader.Limits)) (return ""))
    (when (not (get lim wasm_reader.Limits.has_max)) (return "a memory without a maximum size"))
    (when (gt (get lim wasm_reader.Limits.max) 32768) (return "a memory maximum above 32768 pages (2 GiB)"))
    (let datas:(ptr (vec.Vec (ptr wasm_reader.Data))) (get w wasm_reader.Wasm.datas))
    (for i 0 (call (vec.len (ptr wasm_reader.Data)) datas)
      (let d:(ptr wasm_reader.Data) (call (vec.at (ptr wasm_reader.Data)) datas i))
      (when (and (not (get d wasm_reader.Data.passive)) (or (lt (get d wasm_reader.Data.offset) 0)
              (gt (+ (get d wasm_reader.Data.offset) (get d wasm_reader.Data.len)) (* 65536 (get lim wasm_reader.Limits.min)))))
          (return "a data segment outside the initial memory")))
    "")

  ;; Start-up's memory set-up (see the header). Traps if the system refuses.
  (fn emit_memory_setup [l:(ptr lower.L) w:(ptr wasm_reader.Wasm) base_cell:i32] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let lim:(ptr wasm_reader.Limits) (call memory_limits w))
    (let initial:i32 (* 65536 (get lim wasm_reader.Limits.min)))
    (let refused:(ptr lower.Reason) (call lower.reason l "cannot reserve linear memory"))
    ;; mmap(0, 8 GiB, PROT_NONE, MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE, -1, 0)
    (call x64.alu_rr c 32 (call x64.op_xor) 7 7)
    (call x64.mov_ri64 c 6 8589934592i64)
    (call x64.alu_rr c 32 (call x64.op_xor) 2 2)
    (call x64.mov_ri32 c 10 16418)
    (call x64.mov_ri64 c 8 -1i64)
    (call x64.alu_rr c 32 (call x64.op_xor) 9 9)
    (call x64.mov_ri32 c 0 9)
    (call x64.syscall c)
    ;; errors are -4095..-1
    (call x64.alu_ri c 64 (call x64.op_cmp) 0 -4096)
    (call lower.emit_trap_if l (call x64.cc_a) refused)
    (call x64.mov_rr c 64 15 0)
    ;; the base, for the fault handler
    (call x64.mov_ri32 c 1 base_cell)
    (call x64.store c 64 (call x64.mem 1 0) 15)
    ;; mprotect(base, initial bytes, PROT_READ|PROT_WRITE)
    (call x64.mov_rr c 64 7 15)
    (call x64.mov_ri32 c 6 initial)
    (call x64.mov_ri32 c 2 3)
    (call x64.mov_ri32 c 0 10)
    (call x64.syscall c)
    (call x64.test_rr c 64 0 0)
    (call lower.emit_trap_if l (call x64.cc_ne) refused)
    ;; the size cell
    (call x64.mov_ri32 c 1 (get l lower.L.mem_cell))
    (call x64.mov_ri32 c 0 initial)
    (call x64.store c 64 (call x64.mem 1 0) 0)
    ;; the active data segments: rep movsb from the data segment
    (let datas:(ptr (vec.Vec (ptr wasm_reader.Data))) (get w wasm_reader.Wasm.datas))
    (for i 0 (call (vec.len (ptr wasm_reader.Data)) datas)
      (let d:(ptr wasm_reader.Data) (call (vec.at (ptr wasm_reader.Data)) datas i))
      (let src:i32 (call (vec.at i32) (get l lower.L.seg_addrs) i))
      (when (and (not (get d wasm_reader.Data.passive)) (gt (get d wasm_reader.Data.len) 0))
            (call x64.lea c 64 7 (call x64.mem 15 (get d wasm_reader.Data.offset)))
            (call x64.mov_ri32 c 6 src)
            (call x64.mov_ri32 c 1 (get d wasm_reader.Data.len))
            (call x64.rep_movsb c))))

  ;; The region trap routine's texts, as wasmtime words them.
  (fn region_texts [l:(ptr lower.L)] -> (ptr runtime.RegionTexts)
    (let t:(ptr runtime.RegionTexts) (new runtime.RegionTexts (call alloc.forever) [oob:(zero i32)
                                                                                    oob_len:(zero i32)
                                                                                    al4:(zero i32)
                                                                                    al4_len:(zero i32)
                                                                                    al8:(zero i32)
                                                                                    al8_len:(zero i32)
                                                                                    mid:(zero i32)
                                                                                    mid_len:(zero i32)
                                                                                    tail:(zero i32)
                                                                                    tail_len:(zero i32)]))
    (let oob:str "Pointer out of bounds: Region { start: ")
    (let al4:str "Pointer not aligned to 4: Region { start: ")
    (let al8:str "Pointer not aligned to 8: Region { start: ")
    (let mid:str ", len: ")
    (let tail:str " }\n")
    (put t runtime.RegionTexts.oob (call lower.data_text l oob))
    (put t runtime.RegionTexts.oob_len (str.len oob))
    (put t runtime.RegionTexts.al4 (call lower.data_text l al4))
    (put t runtime.RegionTexts.al4_len (str.len al4))
    (put t runtime.RegionTexts.al8 (call lower.data_text l al8))
    (put t runtime.RegionTexts.al8_len (str.len al8))
    (put t runtime.RegionTexts.mid (call lower.data_text l mid))
    (put t runtime.RegionTexts.mid_len (str.len mid))
    (put t runtime.RegionTexts.tail (call lower.data_text l tail))
    (put t runtime.RegionTexts.tail_len (str.len tail))
    t)

  (fn compile [wasm:str.Bytes] -> (ptr Output)
    (call compile_with wasm false (call str.from_str "") (call str.from_str "")))

  ;; Whether `g` is a grant: ADDR:PORT, as std/ip reads it (src/net.rs
  ;; parse_grant reads the same).
  (fn valid_grant [g:str.Bytes] -> bool (pub)
    (call (option.is_some ip.Endpoint) (call ip.parse_endpoint g)))

  ;; The grants in `text`, one ADDR:PORT a line (`flag`: `--listen` or
  ;; `--serve`; std/ip's parse_endpoint); null, with the message in
  ;; `problem`, for a line that is not one.
  (fn grants [flag:str text:str.Bytes problem:(ptr buf.Buf)] -> (ptr (vec.Vec sockets.Grant))
    (let out:(ptr (vec.Vec sockets.Grant)) (call (vec.make sockets.Grant) (call alloc.default) 4))
    (let start:i32 0)
    (let n:i32 (get text str.Bytes.len))
    (for i 0 (+ n 1)
      (when (or (eq i n) (eq (call str.byte_at text i) 10))
        (let line:str.Bytes (call str.slice text start (- i start)))
        (set! start (+ i 1))
        (when (gt (get line str.Bytes.len) 0)
          (match (call ip.parse_endpoint line)
            ((option.Option ip.Endpoint) some [e]
             (let a:ip.Addr (get e ip.Endpoint.addr))
             (let bytes:(arr u8) (arr.new u8 (call alloc.forever) 16))
             (for k 0 (call ip.len a) (arr.set u8 bytes k (call ip.byte_at a k)))
             (call (vec.push sockets.Grant) out (make sockets.Grant [len:(call ip.len a)
                                                                     port:(get e ip.Endpoint.port)
                                                                     addr:bytes])))
            ((option.Option ip.Endpoint) none
             (call buf.push_str problem flag)
             (call buf.push_byte problem 32)
             (call buf.push_bytes problem line)
             (call buf.push_str problem ": expected ADDR:PORT, as 127.0.0.1:8080 or [::1]:8080")
             (return (ptr.null (vec.Vec sockets.Grant))))))))
    out)

  ;; `sandbox`: the program may use only the working directory (no `/`
  ;; preopen), as `aipl-run --sandbox` / `aipl compile --exe --sandbox`.
  ;; `listen`: the addresses and ports it may listen on, one ADDR:PORT a
  ;; line, fixed in the executable (`--listen`). `serve`: empty, or the
  ;; ADDR:PORT the executable serves on, a fresh copy of the program per
  ;; connection (`--serve`, fresh.aipl).
  (fn compile_with [wasm:str.Bytes sandbox:bool listen:str.Bytes serve:str.Bytes] -> (ptr Output) (pub)
    (let problem:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (let granted:(ptr (vec.Vec sockets.Grant)) (call grants "--listen" listen problem))
    (when (eq granted (ptr.null (vec.Vec sockets.Grant))) (return (call failure (call buf.bytes problem))))
    (let served:(ptr (vec.Vec sockets.Grant)) (call grants "--serve" serve problem))
    (when (eq served (ptr.null (vec.Vec sockets.Grant))) (return (call failure (call buf.bytes problem))))
    (let serving:bool (gt (call (vec.len sockets.Grant) served) 0))
    (unsafe (let w:(ptr wasm_reader.Wasm) (call wasm_reader.decode wasm))
    (when (not (get w wasm_reader.Wasm.ok)) (return (call failure (get w wasm_reader.Wasm.error))))
    (let mem_problem:str (call memory_problem w))
    (when (gt (str.len mem_problem) 0) (return (call failure (call str.from_str mem_problem))))
    (let entry_fn:i32 (call export_func w "_start"))
    (when (lt entry_fn 0) (return (call failure (call str.from_str "the module has no _start export"))))
    (let l:(ptr lower.L) (call lower.make w))
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let nimports:i32 (call lower.n_fimports l))
    (let nfuncs:i32 (+ nimports (call (vec.len i32) (get w wasm_reader.Wasm.funcs))))
    (let starts:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) (+ nfuncs 1)))
    (let data:(ptr buf.Buf) (get l lower.L.data))
    ;; data: the argv[0] cell, then the trap routine's separators
    (let argv0_cell:i32 (call lower.data_text l ""))
    (for k 1 9 (call buf.push_byte data 0))
    (put l lower.L.mem_cell (call lower.data_text l ""))
    (for k 1 9 (call buf.push_byte data 0))
    (let lim:(ptr wasm_reader.Limits) (call memory_limits w))
    (let has_memory:bool (neq lim (ptr.null wasm_reader.Limits)))
    (when has_memory
          (put l lower.L.mem_max (get lim wasm_reader.Limits.max))
          (put l lower.L.shared (get lim wasm_reader.Limits.shared)))
    ;; every data segment's bytes (memory.init needs passive ones' addresses)
    (let datas:(ptr (vec.Vec (ptr wasm_reader.Data))) (get w wasm_reader.Wasm.datas))
    (for i 0 (call (vec.len (ptr wasm_reader.Data)) datas)
      (let d:(ptr wasm_reader.Data) (call (vec.at (ptr wasm_reader.Data)) datas i))
      (call (vec.push i32) (get l lower.L.seg_addrs) (call lower.data_bytes l (call str.bytes (get d wasm_reader.Data.addr) (get d wasm_reader.Data.len))))
      (call (vec.push i32) (get l lower.L.seg_lens) (get d wasm_reader.Data.len)))
    ;; the main thread's globals block (8 bytes each, initial values, then
    ;; the stack limit: lower.L.stack_limit_off, then the results area:
    ;; lower.results_off), and the thread-id counter (starts at 1)
    (let gs:(ptr (vec.Vec (ptr wasm_reader.Global))) (get w wasm_reader.Wasm.globals))
    (let gb:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (for i 0 (call (vec.len (ptr wasm_reader.Global)) gs)
      (let v:i64 (get (call (vec.at (ptr wasm_reader.Global)) gs i) wasm_reader.Global.init))
      (for k 0 8 (call buf.push_byte gb (i32.wrap (bitand (shru v (i64.extend_s (* 8 k))) 255i64)))))
    (put l lower.L.stack_limit_off (call buf.len gb))
    (for k 0 (+ (+ 7 (call lower.results_size)) 1) (call buf.push_byte gb 0))
    (let globals_block:i32 (call lower.data_bytes l (call buf.bytes gb)))
    (let th:(ptr Threads) (new Threads (call alloc.forever) [start_fn:(get w wasm_reader.Wasm.start)
                                                             thread_start:(call export_func w "wasi_thread_start")
                                                             tid_cell:(zero i32)
                                                             globals:(zero (ptr (vec.Vec (ptr wasm_reader.Global))))]))
    (when (and (lt (get th Threads.thread_start) 0) (call imports_thread_spawn l))
        (return (call failure (call str.from_str "a module importing thread-spawn must export wasi_thread_start"))))
    (when (and serving (call imports_thread_spawn l))
        (return (call failure (call str.from_str "a threaded module cannot be served a fresh instance per connection yet"))))
    (put th Threads.globals gs)
    (put th Threads.tid_cell (call lower.data_text l ""))
    (call buf.push_byte data 1)
    (for k 1 8 (call buf.push_byte data 0))
    (let sep:i32 (call lower.data_text l ": "))
    (let nl:i32 (call lower.data_text l "\n"))
    (let wr:(ptr wasi.W) (call wasi.make l sandbox))
    (let sk:(ptr sockets.N) (call sockets.make l granted))
    (let table_problem:str (call reserve_table l w))
    (when (gt (str.len table_problem) 0) (return (call failure (call str.from_str table_problem))))
    (let texts:(ptr runtime.RegionTexts) (call region_texts l))
    (put l lower.L.trap_routine (call buf.len c))
    (call runtime.emit_trap_routine c argv0_cell sep nl)
    ;; the call-chain routine, and the cell that will point at its table
    (let chain_cell:i32 (call lower.data_text l ""))
    (for k 1 9 (call buf.push_byte data 0))
    (let ct:(ptr runtime.ChainTexts) (new runtime.ChainTexts (call alloc.forever) [at:(call lower.data_text l "  at ")
                                                                                   dots:(call lower.data_text l "  ... ")
                                                                                   more:(call lower.data_text l " more\n")
                                                                                   open:(call lower.data_text l " (")
                                                                                   colon:(call lower.data_text l ":")
                                                                                   close:(call lower.data_text l ")")
                                                                                   positions:(call lower.data_text l "")]))
    (for k 1 13 (call buf.push_byte data 0))
    (put l lower.L.backtrace_routine (call buf.len c))
    (call runtime.emit_backtrace_routine c argv0_cell sep nl ct chain_cell)
    (let unreachable_at:i32 (call buf.len c))
    (call lower.emit_unreachable_routine l)
    (put l lower.L.unreachable_routine unreachable_at)
    (put wr wasi.W.region_routine (call buf.len c))
    (call runtime.emit_region_trap_routine c argv0_cell sep texts)
    ;; the memory fault handler, and the cell holding the memory's base
    (let base_cell:i32 (call lower.data_text l ""))
    (for k 1 9 (call buf.push_byte data 0))
    (let oob:(ptr lower.Reason) (call lower.reason l "wasm trap: out of bounds memory access"))
    (let handler:i32 (call buf.len c))
    (call runtime.emit_fault_handler c base_cell (get oob lower.Reason.addr) (get oob lower.Reason.len) (get l lower.L.backtrace_routine))
    (let restorer:i32 (call buf.len c))
    (call runtime.emit_sigreturn c)
    ;; start-up: save argv[0] (the initial stack is argc, argv[0], ...), set
    ;; up linear memory, call _start, then exit 0
    (let entry:i32 (call buf.len c))
    (call x64.load c 64 0 (call x64.mem 4 8))
    (call x64.mov_ri32 c 1 argv0_cell)
    (call x64.store c 64 (call x64.mem 1 0) 0)
    (call wasi.emit_capture_args l wr)
    (call wasi.emit_preopens l wr sandbox)
    ;; the main thread's FS base: its globals block (arch_prctl ARCH_SET_FS)
    (call x64.mov_ri32 c 7 4098)
    (call x64.mov_ri32 c 6 globals_block)
    (call x64.mov_ri32 c 0 158)
    (call x64.syscall c)
    (call emit_main_stack l globals_block)
    (when has_memory (call emit_memory_setup l w base_cell) (call runtime.emit_install_fault_handler c handler restorer))
    ;; --serve: the host forks a copy per connection here, which goes on
    (when serving (call fresh.emit_host l (call (vec.at sockets.Grant) served 0) serve argv0_cell sep))
    (when (gte (get w wasm_reader.Wasm.start) 0) (call lower.emit_call l (get w wasm_reader.Wasm.start)))
    (call lower.emit_call l entry_fn)
    (call runtime.emit_exit c 0)
    (for i 0 nimports
      (call (vec.push i32) starts (call buf.len c))
      (call import_stub l wr sk th (call (vec.at (ptr wasm_reader.Import)) (get l lower.L.fimports) i)))
    (for i nimports nfuncs
      (when (get l lower.L.failed) (break))
      (call (vec.push i32) starts (call buf.len c))
      (call lower.function l w i (call (vec.at (ptr wasm_reader.Body)) (get w wasm_reader.Wasm.code) (- i nimports))))
    (when (get l lower.L.failed) (return (call failure (call buf.bytes (get l lower.L.msg)))))
    (let code_end:i32 (call buf.len c))
    (let chain:(ptr Chain) (call reserve_chain_table l w nimports nfuncs chain_cell))
    (let positions:i32 (call reserve_position_table l w (get ct runtime.ChainTexts.positions)))
    ;; every call now knows where its target starts
    (for i 0 (call (vec.len (ptr lower.Fixup)) (get l lower.L.fixups))
      (let f:(ptr lower.Fixup) (call (vec.at (ptr lower.Fixup)) (get l lower.L.fixups) i))
      (call x64.patch_rel32 c (get f lower.Fixup.at) (call (vec.at i32) starts (get f lower.Fixup.func))))
    (call fill_table l w starts)
    (call fill_chain_table l chain starts code_end)
    (call fill_position_table l positions)
    (let o:(ptr Output) (new Output (call alloc.forever) [addr:(zero i32)
                                                          len:(zero i32)
                                                          ok:(zero bool)
                                                          error:(zero str.Bytes)
                                                          exe:(zero str.Bytes)]))
    (let exe:str.Bytes (call buf.bytes (call elf.image (call buf.bytes c) entry (call buf.bytes data) 0)))
    (put o Output.addr (call str.addr exe))
    (put o Output.len (get exe str.Bytes.len))
    (put o Output.ok true)
    (put o Output.error (call str.bytes 0 0))
    (put o Output.exe exe)
    o))

;; ===== The call chain's function table (runtime.emit_backtrace_routine) =====

  ;; The table's place in the data, and which functions it covers.
  (struct Chain [addr:i32 first:i32 last:i32 names:(arr i32) lens:(arr i32)])

  ;; Whether a function's frame is shown in a call chain: it has a name, and
  ;; is not generated (aipl-run's call_chain rule).
  (fn shown [n:str.Bytes] -> bool
    (unsafe (let len:i32 (get n str.Bytes.len))
    (and (gt len 0)
         (not (or (and (gte len 5) (call str.bytes_eq (call str.bytes (call str.addr n) 5) (call str.from_str "aipl.")))
                  (or (call str.bytes_eq n (call str.from_str "_start")) (call str.bytes_eq n (call str.from_str "wasi_thread_start"))))))))

  ;; Puts each defined function's name, and room for the table, in the data,
  ;; and points `cell` at it. The entries are filled once the code's address
  ;; is known (fill_chain_table): the data must be complete before then.
  (fn reserve_chain_table [l:(ptr lower.L) w:(ptr wasm_reader.Wasm) nimports:i32 nfuncs:i32 cell:i32] -> (ptr Chain)
    (unsafe (let ch:(ptr Chain) (new Chain (call alloc.forever) [addr:(zero i32)
                                                                 first:nimports
                                                                 last:(- nfuncs 1)
                                                                 names:(arr.new i32 (call alloc.forever) (+ nfuncs 1))
                                                                 lens:(arr.new i32 (call alloc.forever) (+ nfuncs 1))]))
    (let ns:(ptr (vec.Vec (ptr wasm_reader.FnName))) (get w wasm_reader.Wasm.names))
    (for k 0 (call (vec.len (ptr wasm_reader.FnName)) ns)
      (let fn_name:(ptr wasm_reader.FnName) (call (vec.at (ptr wasm_reader.FnName)) ns k))
      (let i:i32 (get fn_name wasm_reader.FnName.index))
      (when (and (gte i nimports) (and (lt i nfuncs) (call shown (get fn_name wasm_reader.FnName.name))))
            (arr.set i32 (get ch Chain.names) i (call lower.data_bytes l (get fn_name wasm_reader.FnName.name)))
            (arr.set i32 (get ch Chain.lens) i (get (get fn_name wasm_reader.FnName.name) str.Bytes.len))))
    (let n:i32 (- nfuncs nimports))
    (let zeros:(ptr buf.Buf) (call buf.make (call alloc.default) (+ (* 16 n) 8)))
    (for k 1 (+ (* 16 n) 1) (call buf.push_byte zeros 0))
    ;; entries hold 32-bit words: keep them 4-aligned
    (while (neq (bitand (call buf.len (get l lower.L.data)) 3) 0) (call buf.push_byte (get l lower.L.data) 0))
    (put ch Chain.addr (call lower.data_bytes l (call buf.bytes zeros)))
    (let cell_at:i32 (+ (get (get l lower.L.data) buf.Buf.data) (- cell (call elf.data_vaddr))))
    (mem.store32 cell_at (get ch Chain.addr))
    (mem.store32 (+ cell_at 4) n)
    ch))

  ;; Fills the entries: each defined function's code [start, end) and name.
  (fn fill_chain_table [l:(ptr lower.L) ch:(ptr Chain) starts:(ptr (vec.Vec i32)) code_end:i32] -> void
    (unsafe (let data:(ptr buf.Buf) (get l lower.L.data))
    (let code_vaddr:i32 (get (call elf.layout (call buf.len data) 0) elf.Layout.code_vaddr))
    (let base:i32 (+ (get data buf.Buf.data) (- (get ch Chain.addr) (call elf.data_vaddr))))
    (for i (get ch Chain.first) (+ (get ch Chain.last) 1)
      (let entry:i32 (+ base (* 16 (- i (get ch Chain.first)))))
      (let end:i32 (if (lt i (get ch Chain.last)) (call (vec.at i32) starts (+ i 1)) code_end))
      (mem.store32 entry (+ code_vaddr (call (vec.at i32) starts i)))
      (mem.store32 (+ entry 4) (+ code_vaddr end))
      (mem.store32 (+ entry 8) (arr.get i32 (get ch Chain.names) i))
      (mem.store32 (+ entry 12) (arr.get i32 (get ch Chain.lens) i)))))

  ;; Puts the line table's file names and room for the position entries in
  ;; the data, and points `cell` at them: [entries, count, files], files
  ;; being [address length] per name. Returns the entries' data address;
  ;; fill_position_table fills them once the code's address is known.
  (fn reserve_position_table [l:(ptr lower.L) w:(ptr wasm_reader.Wasm) cell:i32] -> i32
    (unsafe (let data:(ptr buf.Buf) (get l lower.L.data))
    (let names:(ptr (vec.Vec str.Bytes)) (get w wasm_reader.Wasm.line_files))
    (let nfiles:i32 (call (vec.len str.Bytes) names))
    (let addrs:(arr i32) (arr.new i32 (call alloc.forever) (+ nfiles 1)))
    (for k 0 nfiles (arr.set i32 addrs k (call lower.data_bytes l (call (vec.at str.Bytes) names k))))
    (while (neq (bitand (call buf.len data) 3) 0) (call buf.push_byte data 0))
    (let files:i32 (call lower.data_text l ""))
    (for k 0 nfiles
      (call push_word data (arr.get i32 addrs k))
      (call push_word data (get (call (vec.at str.Bytes) names k) str.Bytes.len)))
    (let n:i32 (call (vec.len (ptr lower.NPos)) (get l lower.L.positions)))
    (let entries:i32 (call lower.data_text l ""))
    (for k 1 (+ (* 16 n) 1) (call buf.push_byte data 0))
    (let cell_at:i32 (+ (get data buf.Buf.data) (- cell (call elf.data_vaddr))))
    (mem.store32 cell_at entries)
    (mem.store32 (+ cell_at 4) n)
    (mem.store32 (+ cell_at 8) files)
    entries))

  (fn push_word [b:(ptr buf.Buf) v:i32] -> void
    (for k 0 4 (call buf.push_byte b (bitand (shr v (* 8 k)) 255))))

  (fn fill_position_table [l:(ptr lower.L) entries:i32] -> void
    (unsafe (let data:(ptr buf.Buf) (get l lower.L.data))
    (let code_vaddr:i32 (get (call elf.layout (call buf.len data) 0) elf.Layout.code_vaddr))
    (let base:i32 (+ (get data buf.Buf.data) (- entries (call elf.data_vaddr))))
    (let ps:(ptr (vec.Vec (ptr lower.NPos))) (get l lower.L.positions))
    (for k 0 (call (vec.len (ptr lower.NPos)) ps)
      (let p:(ptr lower.NPos) (call (vec.at (ptr lower.NPos)) ps k))
      (let at:i32 (+ base (* 16 k)))
      (mem.store32 at (+ code_vaddr (get p lower.NPos.code)))
      (mem.store32 (+ at 4) (get p lower.NPos.file))
      (mem.store32 (+ at 8) (get p lower.NPos.line))
      (mem.store32 (+ at 12) (get p lower.NPos.col)))))

  ;; Reserves the table's entries in the data (empty: address 0, type -1);
  ;; "" or the reason the table cannot be translated.
  (fn reserve_table [l:(ptr lower.L) w:(ptr wasm_reader.Wasm)] -> str
    (let tables:(ptr (vec.Vec (ptr wasm_reader.Table))) (get w wasm_reader.Wasm.tables))
    (let n:i32 (call (vec.len (ptr wasm_reader.Table)) tables))
    (when (eq n 0) (return ""))
    (when (gt n 1) (return "more than one table"))
    (let size:i32 (get (get (call (vec.at (ptr wasm_reader.Table)) tables 0) wasm_reader.Table.limits) wasm_reader.Limits.min))
    (when (gt size 65536) (return "a table with more than 65536 entries"))
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) (+ 16 (* 16 size))))
    (for i 1 (+ size 1)
      (for k 1 9 (call buf.push_byte b 0))
      (for k 1 5 (call buf.push_byte b 255))
      (for k 1 5 (call buf.push_byte b 0)))
    ;; 16-aligned in the data, for tidy entries
    (let data:(ptr buf.Buf) (get l lower.L.data))
    (while (neq (bitand (call buf.len data) 15) 0) (call buf.push_byte data 0))
    (put l lower.L.table_addr (call lower.data_bytes l (call buf.bytes b)))
    (put l lower.L.table_size size)
    (let elems:(ptr (vec.Vec (ptr wasm_reader.Elem))) (get w wasm_reader.Wasm.elems))
    (for i 0 (call (vec.len (ptr wasm_reader.Elem)) elems)
      (let e:(ptr wasm_reader.Elem) (call (vec.at (ptr wasm_reader.Elem)) elems i))
      (when (gt (+ (get e wasm_reader.Elem.offset) (call (vec.len i32) (get e wasm_reader.Elem.funcs))) size)
          (return "an element segment outside the table"))
      ;; call_indirect passes arguments as defined functions take them; an
      ;; import's routine takes them on the stack (AIPL never puts one in
      ;; a table: references are to its own functions)
      (for k 0 (call (vec.len i32) (get e wasm_reader.Elem.funcs))
        (when (lt (call (vec.at i32) (get e wasm_reader.Elem.funcs) k) (call lower.n_fimports l))
            (return "a table entry that is an imported function"))))
    "")

  ;; Writes each element segment's functions into the table: code address
  ;; (now that the layout is known) and canonical type.
  (fn fill_table [l:(ptr lower.L) w:(ptr wasm_reader.Wasm) starts:(ptr (vec.Vec i32))] -> void
    (unsafe (when (eq (get l lower.L.table_size) 0) (return))
    (let data:(ptr buf.Buf) (get l lower.L.data))
    (let code_vaddr:i32 (get (call elf.layout (call buf.len data) 0) elf.Layout.code_vaddr))
    (let base:i32 (+ (get data buf.Buf.data) (- (get l lower.L.table_addr) (call elf.data_vaddr))))
    (let elems:(ptr (vec.Vec (ptr wasm_reader.Elem))) (get w wasm_reader.Wasm.elems))
    (for i 0 (call (vec.len (ptr wasm_reader.Elem)) elems)
      (let e:(ptr wasm_reader.Elem) (call (vec.at (ptr wasm_reader.Elem)) elems i))
      (let funcs:(ptr (vec.Vec i32)) (get e wasm_reader.Elem.funcs))
      (for k 0 (call (vec.len i32) funcs)
        (let f:i32 (call (vec.at i32) funcs k))
        (let entry:i32 (+ base (* 16 (+ (get e wasm_reader.Elem.offset) k))))
        (mem.store32 entry (+ code_vaddr (call (vec.at i32) starts f)))
        (mem.store32 (+ entry 4) 0)
        (let ti:i32 (call type_index_of l w f))
        (mem.store32 (+ entry 8) (call (vec.at i32) (get l lower.L.canon_types) ti))))))

  ;; The type index of function `f` (imports first).
  (fn type_index_of [l:(ptr lower.L) w:(ptr wasm_reader.Wasm) f:i32] -> i32
    (let ni:i32 (call lower.n_fimports l))
    (if (lt f ni)
        (get (call (vec.at (ptr wasm_reader.Import)) (get l lower.L.fimports) f) wasm_reader.Import.type_index)
        (call (vec.at i32) (get w wasm_reader.Wasm.funcs) (- f ni))))

  ;; For hosts (tests, the driver): compile the `len` bytes at `addr`.
  ;; Returns the Output's address.
  (fn compile_at [addr:i32 len:i32] -> (ptr Output)
    (unsafe (call compile (call str.bytes addr len))))

  ;; compile_at with sandbox (only the working directory).
  (fn compile_sandboxed_at [addr:i32 len:i32] -> (ptr Output)
    (unsafe (call compile_with (call str.bytes addr len) true (call str.from_str "") (call str.from_str ""))))

  ;; compile_at with sandbox (non-zero: only the working directory), the
  ;; `glen` bytes at `gaddr`: the --listen grants, one ADDR:PORT a line,
  ;; and the `slen` at `saddr`: the --serve address, or none.
  (fn compile_full_at [addr:i32 len:i32 sandbox:i32 gaddr:i32 glen:i32 saddr:i32 slen:i32] -> (ptr Output)
    (unsafe (call compile_with (call str.bytes addr len) (neq sandbox 0) (call str.bytes gaddr glen) (call str.bytes saddr slen))))

  (fn host_alloc [n:i32] -> i32 (mem.alloc n))
)
