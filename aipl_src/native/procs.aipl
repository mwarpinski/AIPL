    (for k 0 3
      (call x64.load c 32 (call rax) (call x64.mem (call rsp) (call f_stdio)))
      (when (gt k 0) (call x64.shift_ri c 32 (call x64.sh_shr) (call rax) (* 2 k)))
      (call x64.alu_ri c 32 (call x64.op_and) (call rax) 3)
      (call x64.alu_ri c 32 (call x64.op_cmp) (call rax) 1)
      (let skip:i32 (call x64.jcc c (call x64.cc_ne)))
      (call x64.lea c 64 (call rdi) (call x64.mem (call rsp) (* 8 k)))
      (call x64.mov_ri32 c (call rsi) 524288)
      (call x64.mov_ri32 c (call rax) 293)
      (call x64.syscall c)
      (call x64.test_rr c 64 (call rax) (call rax))
      (call (vec.push i32) failed (call x64.jcc c (call x64.cc_s)))
      (call x64.patch_rel32 c skip (call buf.len c)))
    (call x64.lea c 64 (call rdi) (call x64.mem (call rsp) (call f_status)))
    (call x64.mov_ri32 c (call rsi) 524288)
    (call x64.mov_ri32 c (call rax) 293)
    (call x64.syscall c)
    (call x64.test_rr c 64 (call rax) (call rax))
    (call (vec.push i32) failed (call x64.jcc c (call x64.cc_s)))
    ;; fork: the child is 0
