    (call x64.alu_rr c 32 (call x64.op_xor) (call r10) (call r10))
    (call x64.mov_ri32 c (call rax) 61)
    (call x64.syscall c)
    (call emit_close_slot c (+ (call f_in) 4))
    (call emit_close_slot c (call f_out))
    (call emit_close_slot c (call f_err))
    (call x64.load c 32 (call rax) (call x64.mem (call rsp) (call f_word)))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rcx) (call rcx))
    (call x64.alu_rr c 64 (call x64.op_sub) (call rcx) (call rax))
    (call x64.mov_rr c 64 (call rax) (call rcx))
    (call wasi.emit_negated_errno l w)
    (call x64.alu_ri c 64 (call x64.op_add) (call rsp) (call frame))
    (call x64.ret c)
    ;; started: the slot, and the parent's ends marked as pipes this program opened
