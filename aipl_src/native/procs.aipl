    (call x64.alu_ri c 32 (call x64.op_and) (call rcx) 3)
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rcx) 3)
    (call (vec.push i32) invalid (call x64.jcc c (call x64.cc_e)))
    (call x64.mov_rr c 32 (call rcx) (call rax))
    (call x64.shift_ri c 32 (call x64.sh_shr) (call rcx) 2)
    (call x64.alu_ri c 32 (call x64.op_and) (call rcx) 3)
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rcx) 3)
    (call (vec.push i32) invalid (call x64.jcc c (call x64.cc_e)))
