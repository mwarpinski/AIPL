  ;; stream(p, which) -> a pipe's handle, -1, or -8.
  (fn emit_stream [l:(ptr lower.L) n:(ptr N)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let bad:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 3))
    (let none:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 4))
    (call arg c 2 0 (call r12))
    (call arg c 2 1 (call r13))
    (call emit_process c n bad)
    (call x64.alu_ri c 32 (call x64.op_cmp) (call r13) 2)
    (call (vec.push i32) none (call x64.jcc c (call x64.cc_a)))
    (call x64.load c 32 (call rdi) (call x64.mem_index (call rbx) (call r13) 4 12))
    (call x64.test_rr c 32 (call rdi) (call rdi))
    (call (vec.push i32) none (call x64.jcc c (call x64.cc_s)))
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rdi) (call slots))
    (call (vec.push i32) none (call x64.jcc c (call x64.cc_ae)))
    (call x64.mov_ri32 c (call rcx) (get n N.pipes))
    (call x64.load8u c (call rax) (call x64.mem_index (call rcx) (call rdi) 1 0))
    (call x64.test_rr c 32 (call rax) (call rax))
    (call (vec.push i32) none (call x64.jcc c (call x64.cc_e)))
    (call x64.mov_rr c 32 (call rax) (call rdi))
