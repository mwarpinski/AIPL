;; procs: AIPL's own process operations, the `aipl_sys_v1` imports spawn,
;; stream, read, write, close, wait, and exec (docs/design/SYS_PLAN.md D3), as
;; native routines over Linux system calls. Called as wasi.aipl's routines
;; are: arguments pushed in order, one 8-byte slot each, the result in rax;
;; every register but rbp, rsp, and r15 (the linear memory base) may be
;; clobbered.
;;
;; Behaviour follows src/sys.rs, which the VM and aipl-run use:
;;   - spawn(path, len, args, args_len, stdio) -> a process handle, or minus
;;     an errno: -21 for a path or arguments outside memory, -1 (too big) for
;;     more than `max_args` bytes of both, -76 unless the path is one a
;;     grant fixed when the executable was compiled names (`--allow-run`;
;;     "*" names any), -28 for a stdio outside the three fields' values, -33
;;     with no process slot free; else the errno of what failed, as WASI
;;     numbers it. The program is started with fork and execve; a pipe that
;;     closes when execve succeeds tells the parent why it did not, as Rust's
;;     Command does, so a missing program is -44 here too.
;;   - stream(p, which) -> a pipe's handle, -1 if that stream is not a pipe,
;;     -8 for a process that is not the program's.
;;   - read(h, buf, max), write(h, buf, len) -> bytes moved, or minus an
;;     errno (-8: not a pipe opened here, or the wrong way round); a write
;;     to a program that has gone is -64, not SIGPIPE (the signal is ignored
;;     for the call).
;;   - close(h) -> 0, or -8: a pipe (the input's closing ends the program's
;;     input), or a process (let go of, still running).
;;   - wait(p) -> the exit status, or 256 plus the signal that ended the
;;     program; the same on a second wait.
;;   - exec(path, len, args, args_len): execve; returns only minus an errno.
;; A pipe's handle is its Linux descriptor (checked against a table), a
;; process's is `proc_base` plus its slot in a table of `nprocs`.
(module procs
  (import alloc)
  (import str)
  (import buf)
  (import vec)
  (import x64)
  (import lower)
  (import wasi)

  ;; Data addresses the routines use: the grants (a count, then for each a
  ;; length and 256 bytes), a byte per descriptor below `slots` (1 for the
  ;; read end of a pipe this program opened, 2 for the write end), and the
  ;; process table, `entry` bytes each: state (0 free, 1 started, 2 waited),
  ;; pid, status, and the three pipe descriptors (-1 where none).
  (struct N [grants:i32 pipes:i32 table:i32] (pub))

  (fn slots [] -> i32 1024)
  (fn nprocs [] -> i32 64)
  (fn proc_base [] -> i32 1024)
  (fn entry [] -> i32 32)
  (fn grant_size [] -> i32 260)
  ;; the longest program path a grant may name, and the most bytes of path
  ;; and arguments together (src/sys.rs checks the same)
  (fn max_grant [] -> i32 (pub) 256)
  (fn max_args [] -> i32 65536)

  ;; Registers (x64.aipl numbering)
  (fn rax [] -> i32 0) (fn rcx [] -> i32 1) (fn rdx [] -> i32 2) (fn rbx [] -> i32 3)
  (fn rsp [] -> i32 4) (fn rsi [] -> i32 6) (fn rdi [] -> i32 7)
  (fn r8 [] -> i32 8) (fn r9 [] -> i32 9) (fn r10 [] -> i32 10) (fn r11 [] -> i32 11)
  (fn r12 [] -> i32 12) (fn r13 [] -> i32 13) (fn r14 [] -> i32 14) (fn r15 [] -> i32 15)

  (fn push_u32 [b:(ptr buf.Buf) v:i32] -> void
    (call buf.push_byte b (bitand v 255))
    (call buf.push_byte b (bitand (shru v 8) 255))
    (call buf.push_byte b (bitand (shru v 16) 255))
    (call buf.push_byte b (bitand (shru v 24) 255)))

  ;; The data: the grants (each at most `max_grant` bytes; native.aipl checks).
  (fn make [l:(ptr lower.L) runs:(ptr (vec.Vec str.Bytes))] -> (ptr N) (pub)
    (let n:(ptr N) (new N (call alloc.forever) [grants:(zero i32) pipes:(zero i32) table:(zero i32)]))
    (let g:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (let count:i32 (call (vec.len str.Bytes) runs))
    (call push_u32 g count)
    (for k 0 count
      (let p:str.Bytes (call (vec.at str.Bytes) runs k))
      (call push_u32 g (get p str.Bytes.len))
      (for i 0 (call max_grant)
        (call buf.push_byte g (if (lt i (get p str.Bytes.len)) (call str.byte_at p i) 0))))
    (put n N.grants (call lower.data_bytes l (call buf.bytes g)))
    (let t:(ptr buf.Buf) (call buf.make (call alloc.default) (call slots)))
    (for i 0 (call slots) (call buf.push_byte t 0))
    (put n N.pipes (call lower.data_bytes l (call buf.bytes t)))
    (let pt:(ptr buf.Buf) (call buf.make (call alloc.default) (* (call nprocs) (call entry))))
    (for i 0 (* (call nprocs) (call entry)) (call buf.push_byte pt 0))
    (put n N.table (call lower.data_bytes l (call buf.bytes pt)))
    n)

  ;; reg = argument i (of n), 32 bits, at routine entry (rsp unchanged).
  (fn arg [c:(ptr buf.Buf) n:i32 i:i32 reg:i32] -> void
    (call x64.load c 32 reg (call x64.mem (call rsp) (+ 8 (* 8 (- (- n 1) i))))))

  (fn patch_all [c:(ptr buf.Buf) at:(ptr (vec.Vec i32))] -> void
    (for k 0 (call (vec.len i32) at)
      (call x64.patch_rel32 c (call (vec.at i32) at k) (call buf.len c))))

  (fn emit_return [c:(ptr buf.Buf) v:i32] -> void
    (call x64.mov_ri32 c (call rax) v)
    (call x64.ret c))

  ;; Jumps to `fail` unless [addr, addr + len) is inside linear memory
  ;; (registers holding zero-extended values). Clobbers r10 r11.
  (fn emit_in_memory [l:(ptr lower.L) addr:i32 len:i32 fail:(ptr (vec.Vec i32))] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call x64.mov_rr c 64 (call r11) addr)
    (call x64.alu_rr c 64 (call x64.op_add) (call r11) len)
    (call lower.load_mem_size l (call r10))
    (call x64.alu_rr c 64 (call x64.op_cmp) (call r11) (call r10))
    (call (vec.push i32) fail (call x64.jcc c (call x64.cc_a))))

  ;; Jumps to `fail` if the path (r13 bytes) and the arguments (r9 bytes)
  ;; together pass `max_args`. Clobbers rax.
  (fn emit_not_too_big [c:(ptr buf.Buf) fail:(ptr (vec.Vec i32))] -> void
    (call x64.lea c 64 (call rax) (call x64.mem_index (call r13) (call r9) 1 0))
    (call x64.alu_ri c 64 (call x64.op_cmp) (call rax) (call max_args))
    (call (vec.push i32) fail (call x64.jcc c (call x64.cc_a))))

  ;; Jumps to `fail` unless the path (rsi = its host address, r13 its length)
  ;; is one a grant names ("*" names any). Clobbers rax rbx rcx rdx r8.
  (fn emit_granted [c:(ptr buf.Buf) n:(ptr N) fail:(ptr (vec.Vec i32))] -> void
    (let granted:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 3))
    (let skip:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (call x64.mov_ri32 c (call rbx) (get n N.grants))
    (call x64.load c 32 (call rcx) (call x64.mem (call rbx) 0))
    (call x64.alu_ri c 64 (call x64.op_add) (call rbx) 4)
    (let next:i32 (call buf.len c))
    (call x64.test_rr c 32 (call rcx) (call rcx))
    (call (vec.push i32) fail (call x64.jcc c (call x64.cc_e)))
    (call x64.load c 32 (call rdx) (call x64.mem (call rbx) 0))
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rdx) 1)
    (let not_star:i32 (call x64.jcc c (call x64.cc_ne)))
    (call x64.load8u c (call rax) (call x64.mem (call rbx) 4))
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rax) 42)
    (call (vec.push i32) granted (call x64.jcc c (call x64.cc_e)))
    (call x64.patch_rel32 c not_star (call buf.len c))
    (call x64.alu_rr c 32 (call x64.op_cmp) (call rdx) (call r13))
    (call (vec.push i32) skip (call x64.jcc c (call x64.cc_ne)))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
    (let byte:i32 (call buf.len c))
    (call x64.alu_rr c 32 (call x64.op_cmp) (call rdx) (call r13))
    (call (vec.push i32) granted (call x64.jcc c (call x64.cc_ae)))
    (call x64.load8u c (call rax) (call x64.mem_index (call rsi) (call rdx) 1 0))
    (call x64.load8u c (call r8) (call x64.mem_index (call rbx) (call rdx) 1 4))
    (call x64.alu_rr c 32 (call x64.op_cmp) (call rax) (call r8))
    (call (vec.push i32) skip (call x64.jcc c (call x64.cc_ne)))
    (call x64.alu_ri c 32 (call x64.op_add) (call rdx) 1)
    (call x64.patch_rel32 c (call x64.jmp c) byte)
    (call patch_all c skip)
    (call x64.alu_ri c 64 (call x64.op_add) (call rbx) (call grant_size))
    (call x64.alu_ri c 32 (call x64.op_sub) (call rcx) 1)
    (call x64.patch_rel32 c (call x64.jmp c) next)
    (call patch_all c granted))

  ;; rbx = the address of process slot (r12 - proc_base), or a jump to `bad`
  ;; if r12 is not a process of this program. Clobbers rax rcx.
  (fn emit_process [c:(ptr buf.Buf) n:(ptr N) bad:(ptr (vec.Vec i32))] -> void
    (call x64.mov_rr c 32 (call rax) (call r12))
    (call x64.alu_ri c 32 (call x64.op_sub) (call rax) (call proc_base))
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rax) (call nprocs))
    (call (vec.push i32) bad (call x64.jcc c (call x64.cc_ae)))
    (call x64.shift_ri c 32 (call x64.sh_shl) (call rax) 5)
    (call x64.mov_ri32 c (call rbx) (get n N.table))
    (call x64.alu_rr c 64 (call x64.op_add) (call rbx) (call rax))
    (call x64.load c 32 (call rax) (call x64.mem (call rbx) 0))
    (call x64.test_rr c 32 (call rax) (call rax))
    (call (vec.push i32) bad (call x64.jcc c (call x64.cc_e))))

  ;; Jumps to `bad` unless the descriptor in h is a pipe opened here of kind
  ;; `mark` (1 read, 2 write). Clobbers rax rcx.
  (fn emit_is_pipe [c:(ptr buf.Buf) n:(ptr N) h:i32 mark:i32 bad:(ptr (vec.Vec i32))] -> void
    (call x64.alu_ri c 32 (call x64.op_cmp) h (call slots))
    (call (vec.push i32) bad (call x64.jcc c (call x64.cc_ae)))
    (call x64.mov_ri32 c (call rcx) (get n N.pipes))
    (call x64.load8u c (call rax) (call x64.mem_index (call rcx) h 1 0))
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rax) mark)
    (call (vec.push i32) bad (call x64.jcc c (call x64.cc_ne))))

  ;; Replaces this process with the program: r12 = the path's guest address,
  ;; r13 = its length, r14 = the arguments block's guest address, r9 = its
  ;; length (all in memory, and together at most max_args). The NUL-ended
  ;; path, the block (with a zero byte after it), and the argv table are built
  ;; on the stack; the environment is the one the process started with. Falls
  ;; through only if execve failed, with -errno in rax and rsp as it was
  ;; (kept in r10). Clobbers everything but r10, r15, and rbp.
  (fn emit_execve [l:(ptr lower.L) w:(ptr wasi.W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call x64.mov_rr c 64 (call r10) (call rsp))
    ;; rdx = the words: the zero bytes in the block, and one more if it does not end in one
    (call x64.lea c 64 (call rsi) (call x64.mem_index (call r15) (call r14) 1 0))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rcx) (call rcx))
    (let count:i32 (call buf.len c))
    (call x64.alu_rr c 32 (call x64.op_cmp) (call rcx) (call r9))
    (let counted:i32 (call x64.jcc c (call x64.cc_ae)))
    (call x64.load8u c (call rax) (call x64.mem_index (call rsi) (call rcx) 1 0))
    (call x64.test_rr c 32 (call rax) (call rax))
    (let nonzero:i32 (call x64.jcc c (call x64.cc_ne)))
    (call x64.alu_ri c 32 (call x64.op_add) (call rdx) 1)
    (call x64.patch_rel32 c nonzero (call buf.len c))
    (call x64.alu_ri c 32 (call x64.op_add) (call rcx) 1)
    (call x64.patch_rel32 c (call x64.jmp c) count)
    (call x64.patch_rel32 c counted (call buf.len c))
    (call x64.test_rr c 32 (call r9) (call r9))
    (let empty:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.load8u c (call rax) (call x64.mem_index (call rsi) (call r9) 1 -1))
    (call x64.test_rr c 32 (call rax) (call rax))
    (let ended:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_ri c 32 (call x64.op_add) (call rdx) 1)
    (call x64.patch_rel32 c empty (call buf.len c))
    (call x64.patch_rel32 c ended (call buf.len c))
    ;; r8 = the argv table's size, (words + 1) * 8 rounded to 16; rax = the strings'
    (call x64.mov_rr c 64 (call r8) (call rdx))
    (call x64.shift_ri c 64 (call x64.sh_shl) (call r8) 3)
    (call x64.alu_ri c 64 (call x64.op_add) (call r8) 23)
    (call x64.alu_ri c 64 (call x64.op_and) (call r8) -16)
    (call x64.lea c 64 (call rax) (call x64.mem_index (call r13) (call r9) 1 17))
    (call x64.alu_ri c 64 (call x64.op_and) (call rax) -16)
    (call x64.alu_rr c 64 (call x64.op_sub) (call rsp) (call rax))
    (call x64.alu_rr c 64 (call x64.op_sub) (call rsp) (call r8))
    ;; rbx = the path's copy, after the table
    (call x64.lea c 64 (call rbx) (call x64.mem_index (call rsp) (call r8) 1 0))
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.lea c 64 (call rsi) (call x64.mem_index (call r15) (call r12) 1 0))
    (call x64.mov_rr c 64 (call rcx) (call r13))
    (call x64.rep_movsb c)
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.store8 c (call x64.mem (call rdi) 0) (call rax))
    (call x64.alu_ri c 64 (call x64.op_add) (call rdi) 1)
    ;; r12 = the block's copy, then its zero byte
    (call x64.mov_rr c 64 (call r12) (call rdi))
    (call x64.lea c 64 (call rsi) (call x64.mem_index (call r15) (call r14) 1 0))
    (call x64.mov_rr c 64 (call rcx) (call r9))
    (call x64.rep_movsb c)
    (call x64.store8 c (call x64.mem (call rdi) 0) (call rax))
    ;; the table: a pointer to each word
    (call x64.mov_rr c 64 (call rdi) (call rsp))
    (call x64.mov_rr c 64 (call rsi) (call r12))
    (call x64.mov_rr c 64 (call rcx) (call rdx))
    (let top:i32 (call buf.len c))
    (call x64.test_rr c 64 (call rcx) (call rcx))
    (let table_done:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.store c 64 (call x64.mem (call rdi) 0) (call rsi))
    (call x64.alu_ri c 64 (call x64.op_add) (call rdi) 8)
    (let scan:i32 (call buf.len c))
    (call x64.load8u c (call rax) (call x64.mem (call rsi) 0))
    (call x64.alu_ri c 64 (call x64.op_add) (call rsi) 1)
    (call x64.test_rr c 32 (call rax) (call rax))
    (call x64.patch_rel32 c (call x64.jcc c (call x64.cc_ne)) scan)
    (call x64.alu_ri c 64 (call x64.op_sub) (call rcx) 1)
    (call x64.patch_rel32 c (call x64.jmp c) top)
    (call x64.patch_rel32 c table_done (call buf.len c))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.store c 64 (call x64.mem (call rdi) 0) (call rax))
    ;; execve(path, argv, envp)
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_rr c 64 (call rsi) (call rsp))
    (call x64.mov_ri32 c (call rcx) (call wasi.env_cell w))
    (call x64.load c 64 (call rdx) (call x64.mem (call rcx) 0))
    (call x64.mov_ri32 c (call rax) 59)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call rsp) (call r10)))

  ;; spawn's frame, on the stack: the pipes' descriptors (a pipe's read end
  ;; at its offset, the write end 4 after), the error pipe, and words
  (fn f_in [] -> i32 0) (fn f_out [] -> i32 8) (fn f_err [] -> i32 16) (fn f_status [] -> i32 24)
  (fn f_stdio [] -> i32 32) (fn f_slot [] -> i32 36) (fn f_pid [] -> i32 40) (fn f_word [] -> i32 44) (fn f_alen [] -> i32 48)
  (fn frame [] -> i32 64)

  ;; Closes the descriptor held at frame offset `at` if it is open, and marks it -1.
  (fn emit_close_slot [c:(ptr buf.Buf) at:i32] -> void
    (call x64.load c 32 (call rdi) (call x64.mem (call rsp) at))
    (call x64.test_rr c 32 (call rdi) (call rdi))
    (let none:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (call x64.mov_ri32 c (call rax) -1)
    (call x64.store c 32 (call x64.mem (call rsp) at) (call rax))
    (call x64.patch_rel32 c none (call buf.len c)))

  ;; In the child: the stream `k`'s redirection, by the field of stdio.
  (fn emit_redirect [l:(ptr lower.L) k:i32 child_end:i32] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let done:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 3))
    (call x64.load c 32 (call rax) (call x64.mem (call rsp) (call f_stdio)))
    (when (gt k 0) (call x64.shift_ri c 32 (call x64.sh_shr) (call rax) (* 2 k)))
    (call x64.alu_ri c 32 (call x64.op_and) (call rax) 3)
    ;; 0: the parent's
    (call x64.test_rr c 32 (call rax) (call rax))
    (call (vec.push i32) done (call x64.jcc c (call x64.cc_e)))
    ;; 1: the pipe's end
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rax) 1)
    (let not_pipe:i32 (call x64.jcc c (call x64.cc_ne)))
    (call x64.load c 32 (call rdi) (call x64.mem (call rsp) child_end))
    (call x64.mov_ri32 c (call rsi) k)
    (call x64.mov_ri32 c (call rax) 33)
    (call x64.syscall c)
    (call (vec.push i32) done (call x64.jmp c))
    (call x64.patch_rel32 c not_pipe (call buf.len c))
    ;; 2: the null device
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rax) 2)
    (let not_null:i32 (call x64.jcc c (call x64.cc_ne)))
    (call x64.mov_ri32 c (call rdi) (call lower.data_text l "/dev/null"))
    (call buf.push_byte (get l lower.L.data) 0)
    (call x64.mov_ri32 c (call rsi) 2)
    (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
    (call x64.mov_ri32 c (call rax) 2)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call r8) (call rax))
    (call x64.mov_rr c 64 (call rdi) (call rax))
    (call x64.mov_ri32 c (call rsi) k)
    (call x64.mov_ri32 c (call rax) 33)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call rdi) (call r8))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (call (vec.push i32) done (call x64.jmp c))
    (call x64.patch_rel32 c not_null (call buf.len c))
    ;; 3 (the error only): the output's
    (call x64.mov_ri32 c (call rdi) 1)
    (call x64.mov_ri32 c (call rsi) 2)
    (call x64.mov_ri32 c (call rax) 33)
    (call x64.syscall c)
    (call patch_all c done))

  ;; spawn(path, len, args, args_len, stdio) -> a process handle, or minus an errno.
  (fn emit_spawn [l:(ptr lower.L) n:(ptr N) w:(ptr wasi.W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let fault:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 4))
    (let toobig:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (let denied:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (let invalid:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 4))
    (let nofree:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (let failed:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 8))
    (call arg c 5 0 (call r12))
    (call arg c 5 1 (call r13))
    (call arg c 5 2 (call r14))
    (call arg c 5 3 (call r9))
    (call arg c 5 4 (call r8))
    (call x64.alu_ri c 64 (call x64.op_sub) (call rsp) (call frame))
    (call x64.mov_ri32 c (call rax) -1)
    (for k 0 8 (call x64.store c 32 (call x64.mem (call rsp) (* 4 k)) (call rax)))
    (call x64.store c 32 (call x64.mem (call rsp) (call f_stdio)) (call r8))
    (call x64.store c 32 (call x64.mem (call rsp) (call f_alen)) (call r9))
    (call emit_in_memory l (call r12) (call r13) fault)
    (call emit_in_memory l (call r14) (call r9) fault)
    (call emit_not_too_big c toobig)
    (call x64.lea c 64 (call rsi) (call x64.mem_index (call r15) (call r12) 1 0))
    (call emit_granted c n denied)
    ;; stdio: no bit above the three fields, and neither input nor output is 3
    (call x64.load c 32 (call rax) (call x64.mem (call rsp) (call f_stdio)))
    (call x64.mov_rr c 32 (call rcx) (call rax))
    (call x64.shift_ri c 32 (call x64.sh_shr) (call rcx) 6)
    (call x64.test_rr c 32 (call rcx) (call rcx))
    (call (vec.push i32) invalid (call x64.jcc c (call x64.cc_ne)))
