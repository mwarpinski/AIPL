    (call x64.store c 32 (call x64.mem (call rsp) (call f_word)) (call rax))
    (let again:i32 (call buf.len c))
    (call x64.load c 32 (call rdi) (call x64.mem (call rsp) (call f_status)))
    (call x64.lea c 64 (call rsi) (call x64.mem (call rsp) (call f_word)))
