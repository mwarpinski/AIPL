    (let find:i32 (call buf.len c))
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rdx) (call nprocs))
    (call (vec.push i32) nofree (call x64.jcc c (call x64.cc_ae)))
    (call x64.mov_rr c 32 (call rcx) (call rdx))
    (call x64.shift_ri c 32 (call x64.sh_shl) (call rcx) 5)
    (call x64.load c 32 (call rax) (call x64.mem_index (call rbx) (call rcx) 1 0))
    (call x64.test_rr c 32 (call rax) (call rax))
    (let found:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_ri c 32 (call x64.op_add) (call rdx) 1)
    (call x64.patch_rel32 c (call x64.jmp c) find)
    (call x64.patch_rel32 c found (call buf.len c))
    (call x64.store c 32 (call x64.mem (call rsp) (call f_slot)) (call rdx))
