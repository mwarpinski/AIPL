    (call emit_return c -1)
    (call patch_all c bad)
    (call emit_return c -8))

  ;; read(h, buf, max) -> bytes read, 0 at the end, or minus an errno.
  ;; write(h, buf, len) -> bytes written, or minus an errno.
  (fn emit_transfer [l:(ptr lower.L) n:(ptr N) w:(ptr wasi.W) sending:bool] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let fault:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (let bad:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 3))
    (let failed:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (call arg c 3 0 (call r12))
    (call arg c 3 1 (call r13))
    (call arg c 3 2 (call r14))
    (call emit_in_memory l (call r13) (call r14) fault)
    (call emit_is_pipe c n (call r12) (if sending 2 1) bad)
    (if sending
        (block
          ;; SIGPIPE is ignored for the write, as Rust's runtime ignores it: a
          ;; program that has gone is an error, not the end of this one
          (call x64.alu_ri c 64 (call x64.op_sub) (call rsp) 64)
          (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
          (for k 0 8 (call x64.store c 64 (call x64.mem (call rsp) (* 8 k)) (call rax)))
          (call x64.mov_ri32 c (call rax) 1)
          (call x64.store c 64 (call x64.mem (call rsp) 0) (call rax))
          (call x64.mov_ri32 c (call rdi) 13)
          (call x64.mov_rr c 64 (call rsi) (call rsp))
          (call x64.lea c 64 (call rdx) (call x64.mem (call rsp) 32))
          (call x64.mov_ri32 c (call r10) 8)
          (call x64.mov_ri32 c (call rax) 13)
          (call x64.syscall c)
          (call x64.mov_rr c 64 (call rdi) (call r12))
          (call x64.lea c 64 (call rsi) (call x64.mem_index (call r15) (call r13) 1 0))
          (call x64.mov_rr c 64 (call rdx) (call r14))
          (call x64.mov_ri32 c (call rax) 1)
          (call x64.syscall c)
          (call x64.mov_rr c 64 (call rbx) (call rax))
          (call x64.mov_ri32 c (call rdi) 13)
          (call x64.lea c 64 (call rsi) (call x64.mem (call rsp) 32))
          (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
          (call x64.mov_ri32 c (call r10) 8)
          (call x64.mov_ri32 c (call rax) 13)
          (call x64.syscall c)
          (call x64.mov_rr c 64 (call rax) (call rbx))
          (call x64.alu_ri c 64 (call x64.op_add) (call rsp) 64))
        (block
          (call x64.mov_rr c 64 (call rdi) (call r12))
          (call x64.lea c 64 (call rsi) (call x64.mem_index (call r15) (call r13) 1 0))
          (call x64.mov_rr c 64 (call rdx) (call r14))
          (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
          (call x64.syscall c)))
    (call x64.test_rr c 64 (call rax) (call rax))
    (call (vec.push i32) failed (call x64.jcc c (call x64.cc_s)))
    (call x64.ret c)
    (call patch_all c failed)
    (call wasi.emit_negated_errno l w)
    (call x64.ret c)
    (call patch_all c fault)
    (call emit_return c -21)
    (call patch_all c bad)
    (call emit_return c -8))

  ;; close(h) -> 0, or -8.
  (fn emit_close [l:(ptr lower.L) n:(ptr N)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let bad:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 4))
    (call arg c 1 0 (call r12))
    (call x64.alu_ri c 32 (call x64.op_cmp) (call r12) (call proc_base))
    (let process:i32 (call x64.jcc c (call x64.cc_ae)))
    ;; a pipe: it must be one opened here (either way round)
    (call x64.mov_ri32 c (call rcx) (get n N.pipes))
    (call x64.load8u c (call rax) (call x64.mem_index (call rcx) (call r12) 1 0))
    (call x64.test_rr c 32 (call rax) (call rax))
    (call (vec.push i32) bad (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.store8 c (call x64.mem_index (call rcx) (call r12) 1 0) (call rax))
    ;; the processes that named it forget it, so a descriptor made later with
    ;; its number is not taken for it
    (call x64.mov_ri32 c (call rbx) (get n N.table))
    (call x64.mov_ri32 c (call rdx) (call nprocs))
    (let each:i32 (call buf.len c))
    (for k 0 3
      (call x64.load c 32 (call rax) (call x64.mem (call rbx) (+ 12 (* 4 k))))
      (call x64.alu_rr c 32 (call x64.op_cmp) (call rax) (call r12))
      (let other:i32 (call x64.jcc c (call x64.cc_ne)))
      (call x64.mov_ri32 c (call rax) -1)
      (call x64.store c 32 (call x64.mem (call rbx) (+ 12 (* 4 k))) (call rax))
      (call x64.patch_rel32 c other (call buf.len c)))
    (call x64.alu_ri c 64 (call x64.op_add) (call rbx) (call entry))
    (call x64.alu_ri c 32 (call x64.op_sub) (call rdx) 1)
    (call x64.patch_rel32 c (call x64.jcc c (call x64.cc_ne)) each)
    (call x64.mov_rr c 64 (call rdi) (call r12))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (call emit_return c 0)
