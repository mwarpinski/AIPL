    (call x64.patch_rel32 c process (call buf.len c))
    (call emit_process c n bad)
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.store c 32 (call x64.mem (call rbx) 0) (call rax))
    (call emit_return c 0)
    (call patch_all c bad)
    (call emit_return c -8))

  ;; wait(p) -> the exit status, or 256 plus the signal; the same again.
  (fn emit_wait [l:(ptr lower.L) n:(ptr N) w:(ptr wasi.W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let bad:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 3))
    (call arg c 1 0 (call r12))
    (call emit_process c n bad)
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rax) 2)
    (let running:i32 (call x64.jcc c (call x64.cc_ne)))
    (call x64.load c 32 (call rax) (call x64.mem (call rbx) 8))
    (call x64.ret c)
    (call x64.patch_rel32 c running (call buf.len c))
    (call x64.alu_ri c 64 (call x64.op_sub) (call rsp) 16)
    (let again:i32 (call buf.len c))
    (call x64.load c 32 (call rdi) (call x64.mem (call rbx) 4))
    (call x64.mov_rr c 64 (call rsi) (call rsp))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
    (call x64.alu_rr c 32 (call x64.op_xor) (call r10) (call r10))
    (call x64.mov_ri32 c (call rax) 61)
    (call x64.syscall c)
    (call x64.alu_ri c 64 (call x64.op_cmp) (call rax) -4)
    (call x64.patch_rel32 c (call x64.jcc c (call x64.cc_e)) again)
    (call x64.test_rr c 64 (call rax) (call rax))
    (let werr:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.load c 32 (call rax) (call x64.mem (call rsp) 0))
    (call x64.mov_rr c 32 (call rcx) (call rax))
    (call x64.alu_ri c 32 (call x64.op_and) (call rcx) 127)
    (let signaled:i32 (call x64.jcc c (call x64.cc_ne)))
    (call x64.shift_ri c 32 (call x64.sh_shr) (call rax) 8)
    (call x64.alu_ri c 32 (call x64.op_and) (call rax) 255)
    (let have:i32 (call x64.jmp c))
    (call x64.patch_rel32 c signaled (call buf.len c))
    (call x64.lea c 64 (call rax) (call x64.mem (call rcx) 256))
    (call x64.patch_rel32 c have (call buf.len c))
    (call x64.store c 32 (call x64.mem (call rbx) 8) (call rax))
    (call x64.mov_ri32 c (call rcx) 2)
    (call x64.store c 32 (call x64.mem (call rbx) 0) (call rcx))
    (call x64.alu_ri c 64 (call x64.op_add) (call rsp) 16)
    (call x64.ret c)
    (call x64.patch_rel32 c werr (call buf.len c))
    (call x64.alu_ri c 64 (call x64.op_add) (call rsp) 16)
    (call wasi.emit_negated_errno l w)
    (call x64.ret c)
    (call patch_all c bad)
    (call emit_return c -8))

  ;; exec(path, len, args, args_len): minus an errno, as it returns only on failure.
  (fn emit_exec [l:(ptr lower.L) n:(ptr N) w:(ptr wasi.W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let fault:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 3))
    (let toobig:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (let denied:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (call arg c 4 0 (call r12))
    (call arg c 4 1 (call r13))
    (call arg c 4 2 (call r14))
    (call arg c 4 3 (call r9))
    (call emit_in_memory l (call r12) (call r13) fault)
    (call emit_in_memory l (call r14) (call r9) fault)
    (call emit_not_too_big c toobig)
    (call x64.lea c 64 (call rsi) (call x64.mem_index (call r15) (call r12) 1 0))
    (call emit_granted c n denied)
    (call emit_execve l w)
    (call wasi.emit_negated_errno l w)
    (call x64.ret c)
    (call patch_all c fault)
    (call emit_return c -21)
    (call patch_all c toobig)
    (call emit_return c -1)
    (call patch_all c denied)
    (call emit_return c -76))

  ;; Emits the routine for aipl_sys_v1 import `name`; false if it is not one of these.
  (fn emit_import [l:(ptr lower.L) n:(ptr N) w:(ptr wasi.W) name:str.Bytes] -> bool (pub)
    (cond
      ((call is name "spawn") (call emit_spawn l n w) true)
      ((call is name "stream") (call emit_stream l n) true)
      ((call is name "read") (call emit_transfer l n w false) true)
      ((call is name "write") (call emit_transfer l n w true) true)
      ((call is name "close") (call emit_close l n) true)
      ((call is name "wait") (call emit_wait l n w) true)
      ((call is name "exec") (call emit_exec l n w) true)
      (else false)))

  (fn is [name:str.Bytes want:str] -> bool
    (call str.bytes_eq name (call str.from_str want)))
)
