    (call x64.load c 32 (call rdx) (call x64.mem (call rsp) (call f_slot)))
    (call x64.shift_ri c 32 (call x64.sh_shl) (call rdx) 5)
    (call x64.mov_ri32 c (call rbx) (get n N.table))
    (call x64.alu_rr c 64 (call x64.op_add) (call rbx) (call rdx))
    (call x64.mov_ri32 c (call rax) 1)
    (call x64.store c 32 (call x64.mem (call rbx) 0) (call rax))
    (call x64.load c 32 (call rax) (call x64.mem (call rsp) (call f_pid)))
    (call x64.store c 32 (call x64.mem (call rbx) 4) (call rax))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.store c 32 (call x64.mem (call rbx) 8) (call rax))
    (for k 0 3
      ;; the parent's end: the input's write end, or the output's and error's read end
      (let at:i32 (+ (* 8 k) (if (eq k 0) 4 0)))
      (let mark:i32 (if (eq k 0) 2 1))
