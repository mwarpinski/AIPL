      (call x64.store c 32 (call x64.mem (call rbx) (+ 12 (* 4 k))) (call rdi))
      (call x64.test_rr c 32 (call rdi) (call rdi))
      (let next_a:i32 (call x64.jcc c (call x64.cc_s)))
      (call x64.alu_ri c 32 (call x64.op_cmp) (call rdi) (call slots))
      (let fits:i32 (call x64.jcc c (call x64.cc_b)))
      (call x64.mov_ri32 c (call rax) 3)
      (call x64.syscall c)
      (call x64.mov_ri32 c (call rax) -1)
      (call x64.store c 32 (call x64.mem (call rbx) (+ 12 (* 4 k))) (call rax))
      (let next_b:i32 (call x64.jmp c))
