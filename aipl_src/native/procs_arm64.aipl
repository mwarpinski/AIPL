;; procs_arm64: AIPL's own process operations, the `aipl_sys_v1` imports spawn, stream,
;; read, write, close, wait, and exec (docs/design/SYS_PLAN.md D3), as AArch64 routines over
;; Linux system calls (native ARM64 backend, docs/design/ARM64_PLAN.md): procs.aipl's
;; counterpart for x86-64, and behaving as it does (and as src/sys.rs does, which the VM and
;; aipl-run use; the header of procs.aipl states each operation's results).
;;
;; Called as wasi_arm64.aipl's routines are: the arguments on the value stack, a result in x0
;; (a handle, a count, or minus an errno), the routine saving sp in x27 and the return address
;; in x26 (wasi_arm64.prologue). A routine keeps its parameters in x19-x25.
;;
;; What differs from x86-64: AArch64 Linux has no fork and no dup2, so a program is started
;; with clone(SIGCHLD) and the streams moved with dup3 (which refuses to move a descriptor onto
;; itself, as dup2 does not, so that case is skipped); pipe2 is 59, wait4 260, execve 221.
(module procs_arm64
  (import alloc)
  (import str)
  (import buf)
  (import vec)
  (import arm64)
  (import runtime_arm64)
  (import lower_arm64)
  (import wasi_arm64)

  ;; Data addresses the routines use: the grants (a count, then for each a length and 256
  ;; bytes), a byte per descriptor below `slots` (1 for the read end of a pipe this program
  ;; opened, 2 for the write end), the process table, `entry` bytes each (state: 0 free, 1
  ;; started, 2 waited; pid; status; and the three pipe descriptors, -1 where none), and the
  ;; cell holding the stack pointer as the process started (its environment follows argv).
  (struct N [grants:i32 pipes:i32 table:i32 sp_cell:i32] (pub))

  (fn slots [] -> i32 1024)
  (fn nprocs [] -> i32 64)
  (fn proc_base [] -> i32 1024)
  (fn entry [] -> i32 32)
  (fn grant_size [] -> i32 260)
  ;; the longest program path a grant may name, and the most bytes of path and arguments
  ;; together (src/sys.rs checks the same)
  (fn max_grant [] -> i32 (pub) 256)
  (fn max_args [] -> i32 65536)

  (fn push_u32 [b:(ptr buf.Buf) v:i32] -> void
    (call buf.push_byte b (bitand v 255))
    (call buf.push_byte b (bitand (shru v 8) 255))
    (call buf.push_byte b (bitand (shru v 16) 255))
    (call buf.push_byte b (bitand (shru v 24) 255)))

  ;; The data: the grants (each at most `max_grant` bytes; the caller checks).
  (fn make [l:(ptr lower_arm64.L) runs:(ptr (vec.Vec str.Bytes)) sp_cell:i32] -> (ptr N) (pub)
    (let n:(ptr N) (new N (call alloc.forever) [grants:(zero i32) pipes:(zero i32) table:(zero i32) sp_cell:sp_cell]))
    (let g:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (let count:i32 (call (vec.len str.Bytes) runs))
    (call push_u32 g count)
    (for k 0 count
      (let p:str.Bytes (call (vec.at str.Bytes) runs k))
      (call push_u32 g (get p str.Bytes.len))
      (for i 0 (call max_grant)
        (call buf.push_byte g (if (lt i (get p str.Bytes.len)) (call str.byte_at p i) 0))))
    (put n N.grants (call lower_arm64.data_bytes l (call buf.bytes g)))
    (let t:(ptr buf.Buf) (call buf.make (call alloc.default) (call slots)))
    (for i 0 (call slots) (call buf.push_byte t 0))
    (put n N.pipes (call lower_arm64.data_bytes l (call buf.bytes t)))
    (let pt:(ptr buf.Buf) (call buf.make (call alloc.default) (* (call nprocs) (call entry))))
    (for i 0 (* (call nprocs) (call entry)) (call buf.push_byte pt 0))
    (put n N.table (call lower_arm64.data_bytes l (call buf.bytes pt)))
    n)

  (fn imm [c:(ptr buf.Buf) rd:i32 v:i32] -> void
    (call wasi_arm64.imm c rd v))

  (fn new_list [] -> (ptr (vec.Vec i32))
    (call wasi_arm64.new_list))

  (fn patch_all [c:(ptr buf.Buf) at:(ptr (vec.Vec i32))] -> void
    (call wasi_arm64.patch_all c at))

  ;; Jumps to `fail` if the path (x20 bytes) and the arguments (x22 bytes) together pass
  ;; `max_args` (clobbers x9 and x10)
  (fn emit_not_too_big [c:(ptr buf.Buf) fail:(ptr (vec.Vec i32))] -> void
    (call arm64.add_rrr c 64 9 20 22)
    (call imm c 10 (call max_args))
    (call arm64.cmp_rr c 64 9 10)
    (call (vec.push i32) fail (call arm64.b_cond c (call arm64.cc_hi))))

  ;; Jumps to `fail` unless the path (x1 = its host address, x20 its length) is one a grant
  ;; names ("*" names any). Clobbers x2-x7 and x9.
  (fn emit_granted [c:(ptr buf.Buf) n:(ptr N) fail:(ptr (vec.Vec i32))] -> void
    (let granted:(ptr (vec.Vec i32)) (call new_list))
    (let skip:(ptr (vec.Vec i32)) (call new_list))
    (call imm c 3 (get n N.grants))
    (call arm64.ldr_w c 2 3 0)
    (call arm64.add_ri c 64 3 3 4)
    (let next:i32 (call buf.len c))
    (call (vec.push i32) fail (call arm64.cbz c 32 2))
    (call arm64.ldr_w c 4 3 0)
    (call arm64.cmp_ri c 32 4 1)
    (let not_star:i32 (call arm64.b_cond c (call arm64.cc_ne)))
    (call arm64.ldrb c 5 3 4)
    (call arm64.cmp_ri c 32 5 42)
    (call (vec.push i32) granted (call arm64.b_cond c (call arm64.cc_eq)))
    (call arm64.patch_cond c not_star (call buf.len c))
    (call arm64.cmp_rr c 32 4 20)
    (call (vec.push i32) skip (call arm64.b_cond c (call arm64.cc_ne)))
    (call imm c 9 0)
    (let byte:i32 (call buf.len c))
    (call arm64.cmp_rr c 32 9 20)
    (call (vec.push i32) granted (call arm64.b_cond c (call arm64.cc_hs)))
    (call arm64.ldrb_uxtw c 5 1 9)
    (call arm64.add_ri c 64 6 3 4)
    (call arm64.ldrb_uxtw c 7 6 9)
    (call arm64.cmp_rr c 32 5 7)
    (call (vec.push i32) skip (call arm64.b_cond c (call arm64.cc_ne)))
    (call arm64.add_ri c 32 9 9 1)
    (call arm64.b_to c byte)
    (call patch_all c skip)
    (call arm64.add_ri c 64 3 3 (call grant_size))
    (call arm64.sub_ri c 32 2 2 1)
    (call arm64.b_to c next)
    (call patch_all c granted))

  ;; x20 = the address of process slot (x19 - proc_base), or a jump to `bad` if x19 is not a
  ;; process of this program. Clobbers x9-x11.
  (fn emit_process [c:(ptr buf.Buf) n:(ptr N) bad:(ptr (vec.Vec i32))] -> void
    (call arm64.sub_ri c 32 9 19 (call proc_base))
    (call arm64.cmp_ri c 32 9 (call nprocs))
    (call (vec.push i32) bad (call arm64.b_cond c (call arm64.cc_hs)))
    (call arm64.lsl_ri c 64 9 9 5)
    (call imm c 20 (get n N.table))
    (call arm64.add_rrr c 64 20 20 9)
    (call arm64.ldr_w c 10 20 0)
    (call (vec.push i32) bad (call arm64.cbz c 32 10)))

  ;; Jumps to `bad` unless the descriptor in x(h) is a pipe opened here of kind `mark` (1 read,
  ;; 2 write). Clobbers x9 and x10.
  (fn emit_is_pipe [c:(ptr buf.Buf) n:(ptr N) h:i32 mark:i32 bad:(ptr (vec.Vec i32))] -> void
    (call arm64.cmp_ri c 32 h (call slots))
    (call (vec.push i32) bad (call arm64.b_cond c (call arm64.cc_hs)))
    (call imm c 9 (get n N.pipes))
    (call arm64.ldrb_uxtw c 10 9 h)
    (call arm64.cmp_ri c 32 10 mark)
    (call (vec.push i32) bad (call arm64.b_cond c (call arm64.cc_ne))))

  ;; Replaces this process with the program: x19 = the path's guest address, x20 = its length,
  ;; x21 = the arguments block's guest address, x22 = its length (all in memory, and together
  ;; at most max_args). The NUL-ended path, the block (with a zero byte after it), and the argv
  ;; table are built on the stack; the environment is the one the process started with. Falls
  ;; through only if execve failed, with -errno in x0 and sp as it was (saved in x25). Clobbers
  ;; x0-x15 and x25.
  (fn emit_execve [c:(ptr buf.Buf) n:(ptr N)] -> void
    (call arm64.mov_sp c 64 25 31)
    ;; x2 = the words: the zero bytes in the block, and one more if it does not end in one
    (call arm64.add_rrr c 64 1 28 21)
    (call imm c 2 0)
    (call imm c 3 0)
    (let count:i32 (call buf.len c))
    (call arm64.cmp_rr c 64 3 22)
    (let counted:i32 (call arm64.b_cond c (call arm64.cc_hs)))
    (call arm64.ldrb_uxtw c 4 1 3)
    (let nonzero:i32 (call arm64.cbnz c 32 4))
    (call arm64.add_ri c 64 2 2 1)
    (call arm64.patch_cond c nonzero (call buf.len c))
    (call arm64.add_ri c 64 3 3 1)
    (call arm64.b_to c count)
    (call arm64.patch_cond c counted (call buf.len c))
    (let empty:i32 (call arm64.cbz c 64 22))
    (call arm64.sub_ri c 64 4 22 1)
    (call arm64.ldrb_uxtw c 4 1 4)
    (let ended:i32 (call arm64.cbz c 32 4))
    (call arm64.add_ri c 64 2 2 1)
    (call arm64.patch_cond c empty (call buf.len c))
    (call arm64.patch_cond c ended (call buf.len c))
    ;; x5 = the argv table's size, (words + 1) * 8 rounded to 16; x6 = the strings'
    (call arm64.lsl_ri c 64 5 2 3)
    (call arm64.add_ri c 64 5 5 23)
    (call arm64.lsr_ri c 64 5 5 4)
    (call arm64.lsl_ri c 64 5 5 4)
    (call arm64.add_rrr c 64 6 20 22)
    (call arm64.add_ri c 64 6 6 17)
    (call arm64.lsr_ri c 64 6 6 4)
    (call arm64.lsl_ri c 64 6 6 4)
    (call arm64.mov_sp c 64 7 31)
    (call arm64.sub_rrr c 64 7 7 6)
    (call arm64.sub_rrr c 64 7 7 5)
    (call arm64.mov_sp c 64 31 7)
    ;; x10 = the path's copy, after the table, and a zero after it; x12 = the block's copy
    (call arm64.add_rrr c 64 10 7 5)
    (call arm64.add_rrr c 64 11 28 19)
    (call wasi_arm64.copy_bytes c 10 11 20)
    (call arm64.strb_uxtw c 31 10 20)
    (call arm64.add_rrr c 64 12 10 20)
    (call arm64.add_ri c 64 12 12 1)
    (call arm64.add_rrr c 64 11 28 21)
    (call wasi_arm64.copy_bytes c 12 11 22)
    (call arm64.strb_uxtw c 31 12 22)
    ;; the table: a pointer to each word (x13 = the next entry, x14 = the next word)
    (call arm64.mov_rr c 64 13 7)
    (call arm64.mov_rr c 64 14 12)
    (let top:i32 (call buf.len c))
    (let table_done:i32 (call arm64.cbz c 64 2))
    (call arm64.str_x_post c 14 13 8)
    (call imm c 9 0)
    (let scan:i32 (call buf.len c))
    (call arm64.ldrb_uxtw c 3 14 9)
    (call arm64.add_ri c 64 9 9 1)
    (call arm64.patch_cond c (call arm64.cbnz c 32 3) scan)
    (call arm64.add_rrr c 64 14 14 9)
    (call arm64.sub_ri c 64 2 2 1)
    (call arm64.b_to c top)
    (call arm64.patch_cond c table_done (call buf.len c))
    (call arm64.str_x c 31 13 0)
    ;; execve(path, argv, envp), the environment after argv in the stack the process began with:
    ;; envp = sp0 + 8 * argc + 16
    (call imm c 9 (get n N.sp_cell))
    (call arm64.ldr_x c 9 9 0)
    (call arm64.ldr_x c 2 9 0)
    (call arm64.lsl_ri c 64 2 2 3)
    (call arm64.add_rrr c 64 2 2 9)
    (call arm64.add_ri c 64 2 2 16)
    (call arm64.mov_rr c 64 0 10)
    (call arm64.mov_sp c 64 1 31)
    (call runtime_arm64.emit_syscall c 221)
    (call arm64.mov_sp c 64 31 25))

  ;; spawn's frame, on the stack: the pipes' descriptors (a pipe's read end at its offset, the
  ;; write end 4 after), the error pipe, and words
  (fn f_in [] -> i32 0) (fn f_out [] -> i32 8) (fn f_err [] -> i32 16) (fn f_status [] -> i32 24)
  (fn f_stdio [] -> i32 32) (fn f_slot [] -> i32 36) (fn f_pid [] -> i32 40) (fn f_word [] -> i32 44) (fn f_alen [] -> i32 48)
  (fn frame [] -> i32 64)

  ;; Closes the descriptor held at frame offset `at` if it is open, and marks it -1.
  (fn emit_close_slot [c:(ptr buf.Buf) at:i32] -> void
    (call arm64.ldr_w c 0 31 at)
    (call arm64.cmp_ri c 32 0 0)
    (let none:i32 (call arm64.b_cond c (call arm64.cc_lt)))
    (call runtime_arm64.emit_syscall c 57)
    (call imm c 9 -1)
    (call arm64.str_w c 9 31 at)
    (call arm64.patch_cond c none (call buf.len c)))

  ;; In the child: the stream `k`'s redirection, by the field of stdio.
  (fn emit_redirect [l:(ptr lower_arm64.L) k:i32 child_end:i32] -> void
    (let c:(ptr buf.Buf) (get l lower_arm64.L.code))
    (let done:(ptr (vec.Vec i32)) (call new_list))
    (let done_b:(ptr (vec.Vec i32)) (call new_list))
    (call arm64.ldr_w c 10 31 (call f_stdio))
    (when (gt k 0) (call arm64.lsr_ri c 32 10 10 (* 2 k)))
    (call imm c 9 3)
    (call arm64.and_rrr c 32 10 10 9)
    ;; 0: the parent's
    (call (vec.push i32) done (call arm64.cbz c 32 10))
    ;; 1: the pipe's end (dup3 refuses to move a descriptor onto itself)
    (call arm64.cmp_ri c 32 10 1)
    (let not_pipe:i32 (call arm64.b_cond c (call arm64.cc_ne)))
    (call arm64.ldr_w c 0 31 child_end)
    (call imm c 1 k)
    (call arm64.cmp_rr c 32 0 1)
    (call (vec.push i32) done (call arm64.b_cond c (call arm64.cc_eq)))
    (call imm c 2 0)
    (call runtime_arm64.emit_syscall c 24)
    (call (vec.push i32) done_b (call arm64.b c))
    (call arm64.patch_cond c not_pipe (call buf.len c))
    ;; 2: the null device, opened read-write, moved onto the stream, and closed
    (call arm64.cmp_ri c 32 10 2)
    (let not_null:i32 (call arm64.b_cond c (call arm64.cc_ne)))
    (call imm c 0 -100)
    (call imm c 1 (call lower_arm64.data_text l "/dev/null"))
    (call buf.push_byte (get l lower_arm64.L.data) 0)
    (call imm c 2 2)
    (call imm c 3 0)
    (call runtime_arm64.emit_syscall c 56)
    (call arm64.mov_rr c 64 11 0)
    (call imm c 1 k)
    (call arm64.cmp_rr c 32 0 1)
    (let same:i32 (call arm64.b_cond c (call arm64.cc_eq)))
    (call imm c 2 0)
    (call runtime_arm64.emit_syscall c 24)
    (call arm64.mov_rr c 64 0 11)
    (call runtime_arm64.emit_syscall c 57)
    (call arm64.patch_cond c same (call buf.len c))
    (call (vec.push i32) done_b (call arm64.b c))
    (call arm64.patch_cond c not_null (call buf.len c))
    ;; 3 (the error only): the output's
    (call imm c 0 1)
    (call imm c 1 2)
    (call imm c 2 0)
    (call runtime_arm64.emit_syscall c 24)
    (call patch_all c done)
    (for q 0 (call (vec.len i32) done_b)
      (call arm64.patch_b c (call (vec.at i32) done_b q) (call buf.len c))))

  ;; spawn(path, len, args, args_len, stdio) -> a process handle, or minus an errno.
  (fn emit_spawn [l:(ptr lower_arm64.L) n:(ptr N) w:(ptr wasi_arm64.W)] -> void
    (let c:(ptr buf.Buf) (get l lower_arm64.L.code))
    (let fault:(ptr (vec.Vec i32)) (call new_list))
    (let toobig:(ptr (vec.Vec i32)) (call new_list))
    (let denied:(ptr (vec.Vec i32)) (call new_list))
    (let invalid:(ptr (vec.Vec i32)) (call new_list))
    (let nofree:(ptr (vec.Vec i32)) (call new_list))
    (let failed:(ptr (vec.Vec i32)) (call new_list))
    (call wasi_arm64.prologue c)
    (call wasi_arm64.arg_w c 5 0 19)
    (call wasi_arm64.arg_w c 5 1 20)
    (call wasi_arm64.arg_w c 5 2 21)
    (call wasi_arm64.arg_w c 5 3 22)
    (call wasi_arm64.arg_w c 5 4 23)
    (call arm64.sub_ri c 64 31 31 (call frame))
    (call imm c 9 -1)
    (for k 0 8 (call arm64.str_w c 9 31 (* 4 k)))
    (call arm64.str_w c 23 31 (call f_stdio))
    (call arm64.str_w c 22 31 (call f_alen))
    (call wasi_arm64.check c w 19 20 fault)
    (call wasi_arm64.check c w 21 22 fault)
    (call emit_not_too_big c toobig)
    (call arm64.add_rrr c 64 1 28 19)
    (call emit_granted c n denied)
    ;; stdio: no bit above the three fields, and neither input nor output is 3
    (call arm64.lsr_ri c 32 9 23 6)
    (call (vec.push i32) invalid (call arm64.cbnz c 32 9))
    (call imm c 10 3)
    (call arm64.and_rrr c 32 9 23 10)
    (call arm64.cmp_ri c 32 9 3)
    (call (vec.push i32) invalid (call arm64.b_cond c (call arm64.cc_eq)))
    (call arm64.lsr_ri c 32 9 23 2)
    (call arm64.and_rrr c 32 9 9 10)
    (call arm64.cmp_ri c 32 9 3)
    (call (vec.push i32) invalid (call arm64.b_cond c (call arm64.cc_eq)))
    ;; a free slot in the process table
    (call imm c 9 (get n N.table))
    (call imm c 24 0)
    (let find:i32 (call buf.len c))
    (call arm64.cmp_ri c 32 24 (call nprocs))
    (call (vec.push i32) nofree (call arm64.b_cond c (call arm64.cc_hs)))
    (call arm64.lsl_ri c 32 10 24 5)
    (call arm64.ldr_w_uxtw c 11 9 10)
    (let found:i32 (call arm64.cbz c 32 11))
    (call arm64.add_ri c 32 24 24 1)
    (call arm64.b_to c find)
    (call arm64.patch_cond c found (call buf.len c))
    (call arm64.str_w c 24 31 (call f_slot))
    ;; the pipes the fields ask for (a field of 1), then the error pipe
    (for k 0 3
      (if (gt k 0) (call arm64.lsr_ri c 32 9 23 (* 2 k)) (call arm64.mov_rr c 32 9 23))
      (call imm c 10 3)
      (call arm64.and_rrr c 32 9 9 10)
      (call arm64.cmp_ri c 32 9 1)
      (let skip:i32 (call arm64.b_cond c (call arm64.cc_ne)))
      (call arm64.add_ri c 64 0 31 (* 8 k))
      (call imm c 1 524288)
      (call runtime_arm64.emit_syscall c 59)
      (call arm64.cmp_ri c 64 0 0)
      (call (vec.push i32) failed (call arm64.b_cond c (call arm64.cc_lt)))
      (call arm64.patch_cond c skip (call buf.len c)))
    (call arm64.add_ri c 64 0 31 (call f_status))
    (call imm c 1 524288)
    (call runtime_arm64.emit_syscall c 59)
    (call arm64.cmp_ri c 64 0 0)
    (call (vec.push i32) failed (call arm64.b_cond c (call arm64.cc_lt)))
    ;; clone(SIGCHLD): a copy of this process; the child sees 0
    (call imm c 0 17)
    (call imm c 1 0)
    (call imm c 2 0)
    (call imm c 3 0)
    (call imm c 4 0)
    (call runtime_arm64.emit_syscall c 220)
    (call arm64.cmp_ri c 64 0 0)
    (call (vec.push i32) failed (call arm64.b_cond c (call arm64.cc_lt)))
    (let child:i32 (call arm64.b_cond c (call arm64.cc_eq)))
    ;; the parent: the program's ends go, and the error pipe says whether execve worked
    (call arm64.str_w c 0 31 (call f_pid))
    (call emit_close_slot c (call f_in))
    (call emit_close_slot c (+ (call f_out) 4))
    (call emit_close_slot c (+ (call f_err) 4))
    (call emit_close_slot c (+ (call f_status) 4))
    (call arm64.str_w c 31 31 (call f_word))
    (let again:i32 (call buf.len c))
    (call arm64.ldr_w c 0 31 (call f_status))
    (call arm64.add_ri c 64 1 31 (call f_word))
    (call imm c 2 4)
    (call runtime_arm64.emit_syscall c 63)
    (call imm c 4 -4)
    (call arm64.cmp_rr c 64 0 4)
    (call arm64.patch_cond c (call arm64.b_cond c (call arm64.cc_eq)) again)
    (call arm64.mov_rr c 64 25 0)
    (call emit_close_slot c (call f_status))
    (call arm64.cmp_ri c 64 25 4)
    (let launched:i32 (call arm64.b_cond c (call arm64.cc_ne)))
    ;; execve failed: reap the child, give back the pipes, and say why
    (call arm64.ldr_w c 0 31 (call f_pid))
    (call imm c 1 0)
    (call imm c 2 0)
    (call imm c 3 0)
    (call runtime_arm64.emit_syscall c 260)
    (call emit_close_slot c (+ (call f_in) 4))
    (call emit_close_slot c (call f_out))
    (call emit_close_slot c (call f_err))
    (call arm64.ldr_w c 0 31 (call f_word))
    (call arm64.neg c 64 0 0)
    (call wasi_arm64.ret_negated c w)
    ;; started: the slot, and the parent's ends marked as pipes this program opened
    (call arm64.patch_cond c launched (call buf.len c))
    (call arm64.ldr_w c 24 31 (call f_slot))
    (call arm64.lsl_ri c 64 10 24 5)
    (call imm c 9 (get n N.table))
    (call arm64.add_rrr c 64 9 9 10)
    (call imm c 11 1)
    (call arm64.str_w c 11 9 0)
    (call arm64.ldr_w c 11 31 (call f_pid))
    (call arm64.str_w c 11 9 4)
    (call arm64.str_w c 31 9 8)
    (for k 0 3
      ;; the parent's end: the input's write end, or the output's and error's read end
      (let at:i32 (+ (* 8 k) (if (eq k 0) 4 0)))
      (let mark:i32 (if (eq k 0) 2 1))
      (call arm64.ldr_w c 0 31 at)
      (call arm64.str_w c 0 9 (+ 12 (* 4 k)))
      (call arm64.cmp_ri c 32 0 0)
      (let next_a:i32 (call arm64.b_cond c (call arm64.cc_lt)))
      (call arm64.cmp_ri c 32 0 (call slots))
      (let fits:i32 (call arm64.b_cond c (call arm64.cc_lo)))
      (call runtime_arm64.emit_syscall c 57)
      (call imm c 11 -1)
      (call arm64.str_w c 11 9 (+ 12 (* 4 k)))
      (let next_b:i32 (call arm64.b c))
      (call arm64.patch_cond c fits (call buf.len c))
      (call imm c 10 (get n N.pipes))
      (call imm c 11 mark)
      (call arm64.strb_uxtw c 11 10 0)
      (call arm64.patch_cond c next_a (call buf.len c))
      (call arm64.patch_b c next_b (call buf.len c)))
    (call arm64.add_ri c 64 0 24 (call proc_base))
    (call wasi_arm64.ret_x0 c)
    ;; the child: the streams, then the program; if execve returns, the error pipe gets the errno
    (call arm64.patch_cond c child (call buf.len c))
    (call emit_redirect l 0 (call f_in))
    (call emit_redirect l 1 (+ (call f_out) 4))
    (call emit_redirect l 2 (+ (call f_err) 4))
    (call emit_execve c n)
    (call arm64.neg c 64 9 0)
    (call arm64.str_w c 9 31 (call f_word))
    (call arm64.ldr_w c 0 31 (+ (call f_status) 4))
    (call arm64.add_ri c 64 1 31 (call f_word))
    (call imm c 2 4)
    (call runtime_arm64.emit_syscall c 64)
    (call imm c 0 127)
    (call runtime_arm64.emit_syscall c 93)
    (call arm64.brk c 0)
    ;; a pipe, or the clone, failed: the descriptors made go, and the errno comes back
    (call patch_all c failed)
    (call arm64.str_w c 0 31 (call f_word))
    (for k 0 8 (call emit_close_slot c (* 4 k)))
    (call arm64.ldrsw c 0 31 (call f_word))
    (call wasi_arm64.ret_negated c w)
    (call patch_all c fault)
    (call wasi_arm64.ret_errno c -21)
    (call patch_all c toobig)
    (call wasi_arm64.ret_errno c -1)
    (call patch_all c denied)
    (call wasi_arm64.ret_errno c -76)
    (call patch_all c invalid)
    (call wasi_arm64.ret_errno c -28)
    (call patch_all c nofree)
    (call wasi_arm64.ret_errno c -33))

  ;; stream(p, which) -> a pipe's handle, -1, or -8.
  (fn emit_stream [c:(ptr buf.Buf) n:(ptr N)] -> void
    (let bad:(ptr (vec.Vec i32)) (call new_list))
    (let none:(ptr (vec.Vec i32)) (call new_list))
    (call wasi_arm64.prologue c)
    (call wasi_arm64.arg_w c 2 0 19)
    (call wasi_arm64.arg_w c 2 1 21)
    (call emit_process c n bad)
    (call arm64.cmp_ri c 32 21 2)
    (call (vec.push i32) none (call arm64.b_cond c (call arm64.cc_hi)))
    (call arm64.lsl_ri c 64 9 21 2)
    (call arm64.add_rrr c 64 9 9 20)
    (call arm64.ldr_w c 0 9 12)
    (call arm64.cmp_ri c 32 0 0)
    (call (vec.push i32) none (call arm64.b_cond c (call arm64.cc_lt)))
    (call arm64.cmp_ri c 32 0 (call slots))
    (call (vec.push i32) none (call arm64.b_cond c (call arm64.cc_hs)))
    (call imm c 9 (get n N.pipes))
    (call arm64.ldrb_uxtw c 10 9 0)
    (call (vec.push i32) none (call arm64.cbz c 32 10))
    (call wasi_arm64.ret_x0 c)
    (call patch_all c none)
    (call wasi_arm64.ret_errno c -1)
    (call patch_all c bad)
    (call wasi_arm64.ret_errno c -8))

  ;; read(h, buf, max) -> bytes read, 0 at the end, or minus an errno.
  ;; write(h, buf, len) -> bytes written, or minus an errno.
  (fn emit_transfer [c:(ptr buf.Buf) n:(ptr N) w:(ptr wasi_arm64.W) sending:bool] -> void
    (let fault:(ptr (vec.Vec i32)) (call new_list))
    (let bad:(ptr (vec.Vec i32)) (call new_list))
    (call wasi_arm64.prologue c)
    (call wasi_arm64.arg_w c 3 0 19)
    (call wasi_arm64.arg_w c 3 1 20)
    (call wasi_arm64.arg_w c 3 2 22)
    (call wasi_arm64.check c w 20 22 fault)
    (call emit_is_pipe c n 19 (if sending 2 1) bad)
    (call arm64.add_rrr c 64 21 28 20)
    (if sending
        (block
          ;; SIGPIPE is ignored for the write, as Rust's runtime ignores it: a program that has
          ;; gone is an error, not the end of this one. rt_sigaction(SIGPIPE, {SIG_IGN}, old)
          (call arm64.sub_ri c 64 31 31 64)
          (for k 0 8 (call arm64.str_x c 31 31 (* 8 k)))
          (call imm c 9 1)
          (call arm64.str_x c 9 31 0)
          (call imm c 0 13)
          (call arm64.mov_sp c 64 1 31)
          (call arm64.add_ri c 64 2 31 32)
          (call imm c 3 8)
          (call runtime_arm64.emit_syscall c 134)
          (call arm64.mov_rr c 64 0 19)
          (call arm64.mov_rr c 64 1 21)
          (call arm64.mov_rr c 64 2 22)
          (call runtime_arm64.emit_syscall c 64)
          (call arm64.mov_rr c 64 25 0)
          (call imm c 0 13)
          (call arm64.add_ri c 64 1 31 32)
          (call imm c 2 0)
          (call imm c 3 8)
          (call runtime_arm64.emit_syscall c 134)
          (call arm64.mov_rr c 64 0 25))
        (block
          (call arm64.mov_rr c 64 0 19)
          (call arm64.mov_rr c 64 1 21)
          (call arm64.mov_rr c 64 2 22)
          (call runtime_arm64.emit_syscall c 63)))
    (call arm64.cmp_ri c 64 0 0)
    (let failed:i32 (call arm64.b_cond c (call arm64.cc_lt)))
    (call wasi_arm64.ret_x0 c)
    (call arm64.patch_cond c failed (call buf.len c))
    (call wasi_arm64.ret_negated c w)
    (call patch_all c fault)
    (call wasi_arm64.ret_errno c -21)
    (call patch_all c bad)
    (call wasi_arm64.ret_errno c -8))

  ;; close(h) -> 0, or -8.
  (fn emit_close [c:(ptr buf.Buf) n:(ptr N)] -> void
    (let bad:(ptr (vec.Vec i32)) (call new_list))
    (call wasi_arm64.prologue c)
    (call wasi_arm64.arg_w c 1 0 19)
    (call arm64.cmp_ri c 32 19 (call proc_base))
    (let process:i32 (call arm64.b_cond c (call arm64.cc_hs)))
    ;; a pipe: it must be one opened here (either way round)
    (call imm c 9 (get n N.pipes))
    (call arm64.ldrb_uxtw c 10 9 19)
    (call (vec.push i32) bad (call arm64.cbz c 32 10))
    (call arm64.strb_uxtw c 31 9 19)
    ;; the processes that named it forget it, so a descriptor made later with its number is not
    ;; taken for it
    (call imm c 11 (get n N.table))
    (call imm c 12 (call nprocs))
    (call imm c 13 -1)
    (let each:i32 (call buf.len c))
    (for k 0 3
      (call arm64.ldr_w c 10 11 (+ 12 (* 4 k)))
      (call arm64.cmp_rr c 32 10 19)
      (let other:i32 (call arm64.b_cond c (call arm64.cc_ne)))
      (call arm64.str_w c 13 11 (+ 12 (* 4 k)))
      (call arm64.patch_cond c other (call buf.len c)))
    (call arm64.add_ri c 64 11 11 (call entry))
    (call arm64.sub_ri c 32 12 12 1)
    (call arm64.patch_cond c (call arm64.cbnz c 32 12) each)
    (call arm64.mov_rr c 64 0 19)
    (call runtime_arm64.emit_syscall c 57)
    (call wasi_arm64.ret_errno c 0)
    ;; a process: let go of it
    (call arm64.patch_cond c process (call buf.len c))
    (call emit_process c n bad)
    (call arm64.str_w c 31 20 0)
    (call wasi_arm64.ret_errno c 0)
    (call patch_all c bad)
    (call wasi_arm64.ret_errno c -8))

  ;; wait(p) -> the exit status, or 256 plus the signal; the same again.
  (fn emit_wait [c:(ptr buf.Buf) n:(ptr N) w:(ptr wasi_arm64.W)] -> void
    (let bad:(ptr (vec.Vec i32)) (call new_list))
    (call wasi_arm64.prologue c)
    (call wasi_arm64.arg_w c 1 0 19)
    (call emit_process c n bad)
    (call arm64.cmp_ri c 32 10 2)
    (let running:i32 (call arm64.b_cond c (call arm64.cc_ne)))
    (call arm64.ldr_w c 0 20 8)
    (call wasi_arm64.ret_x0 c)
    (call arm64.patch_cond c running (call buf.len c))
    (call arm64.sub_ri c 64 31 31 16)
    (let again:i32 (call buf.len c))
    (call arm64.ldr_w c 0 20 4)
    (call arm64.mov_sp c 64 1 31)
    (call imm c 2 0)
    (call imm c 3 0)
    (call runtime_arm64.emit_syscall c 260)
    (call imm c 4 -4)
    (call arm64.cmp_rr c 64 0 4)
    (call arm64.patch_cond c (call arm64.b_cond c (call arm64.cc_eq)) again)
    (call arm64.cmp_ri c 64 0 0)
    (let werr:i32 (call arm64.b_cond c (call arm64.cc_lt)))
    (call arm64.ldr_w c 0 31 0)
    (call imm c 9 127)
    (call arm64.and_rrr c 32 9 0 9)
    (let signaled:i32 (call arm64.cbnz c 32 9))
    (call arm64.lsr_ri c 32 0 0 8)
    (call imm c 10 255)
    (call arm64.and_rrr c 32 0 0 10)
    (let have:i32 (call arm64.b c))
    (call arm64.patch_cond c signaled (call buf.len c))
    (call arm64.add_ri c 64 0 9 256)
    (call arm64.patch_b c have (call buf.len c))
    (call arm64.str_w c 0 20 8)
    (call imm c 11 2)
    (call arm64.str_w c 11 20 0)
    (call wasi_arm64.ret_x0 c)
    (call arm64.patch_cond c werr (call buf.len c))
    (call wasi_arm64.ret_negated c w)
    (call patch_all c bad)
    (call wasi_arm64.ret_errno c -8))

  ;; exec(path, len, args, args_len): minus an errno, as it returns only on failure.
  (fn emit_exec [c:(ptr buf.Buf) n:(ptr N) w:(ptr wasi_arm64.W)] -> void
    (let fault:(ptr (vec.Vec i32)) (call new_list))
    (let toobig:(ptr (vec.Vec i32)) (call new_list))
    (let denied:(ptr (vec.Vec i32)) (call new_list))
    (call wasi_arm64.prologue c)
    (call wasi_arm64.arg_w c 4 0 19)
    (call wasi_arm64.arg_w c 4 1 20)
    (call wasi_arm64.arg_w c 4 2 21)
    (call wasi_arm64.arg_w c 4 3 22)
    (call wasi_arm64.check c w 19 20 fault)
    (call wasi_arm64.check c w 21 22 fault)
    (call emit_not_too_big c toobig)
    (call arm64.add_rrr c 64 1 28 19)
    (call emit_granted c n denied)
    (call emit_execve c n)
    (call wasi_arm64.ret_negated c w)
    (call patch_all c fault)
    (call wasi_arm64.ret_errno c -21)
    (call patch_all c toobig)
    (call wasi_arm64.ret_errno c -1)
    (call patch_all c denied)
    (call wasi_arm64.ret_errno c -76))

  ;; Emits the routine for aipl_sys_v1 import `name`; false if it is not one of these.
  (fn emit_import [l:(ptr lower_arm64.L) n:(ptr N) w:(ptr wasi_arm64.W) name:str.Bytes] -> bool (pub)
    (let c:(ptr buf.Buf) (get l lower_arm64.L.code))
    (cond
      ((call is name "spawn") (call emit_spawn l n w) true)
      ((call is name "stream") (call emit_stream c n) true)
      ((call is name "read") (call emit_transfer c n w false) true)
      ((call is name "write") (call emit_transfer c n w true) true)
      ((call is name "close") (call emit_close c n) true)
      ((call is name "wait") (call emit_wait c n w) true)
      ((call is name "exec") (call emit_exec c n w) true)
      (else false)))

  (fn is [name:str.Bytes want:str] -> bool
    (call str.bytes_eq name (call str.from_str want)))
)
