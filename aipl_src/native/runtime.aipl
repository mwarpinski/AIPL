;; runtime: the machine code every native executable carries around the
;; program itself (native backend task NE4 onward, docs/design/NATIVE_BACKEND_PLAN.md).
;; For now: Linux system calls and the first executable, which prints a
;; line and exits. Later tasks add start-up (arguments, linear memory),
;; traps, and the WASI functions on top of these system calls.
;;
;; Linux x86-64 system calls: number in rax, arguments in rdi rsi rdx r10
;; r8 r9, result in rax (negative errno on failure); rcx and r11 are
;; clobbered.
(module runtime
  (import alloc)
  (import str)
  (import buf)
  (import x64)
  (import elf)

  (fn sys_write [] -> i32 1)
  (fn sys_exit_group [] -> i32 231)

  ;; Register numbers (x64.aipl order) of the system-call arguments.
  (fn rax [] -> i32 0)
  (fn rdi [] -> i32 7)
  (fn rsi [] -> i32 6)
  (fn rdx [] -> i32 2)
  (fn rcx [] -> i32 1)

  ;; write(fd, addr, len) with constant arguments; the result stays in rax.
  (fn emit_write [c:(ptr buf.Buf) fd:i32 addr:i32 len:i32] -> void
    (call x64.mov_ri32 c (call rdi) fd)
    (call x64.mov_ri32 c (call rsi) addr)
    (call x64.mov_ri32 c (call rdx) len)
    (call x64.mov_ri32 c (call rax) (call sys_write))
    (call x64.syscall c))

  ;; exit_group(status): ends every thread of the process; does not return.
  (fn emit_exit [c:(ptr buf.Buf) status:i32] -> void
    (call x64.mov_ri32 c (call rdi) status)
    (call x64.mov_ri32 c (call rax) (call sys_exit_group))
    (call x64.syscall c)
    (call x64.ud2 c))

  ;; The trap routine (NE6): prints `<argv[0]>: <reason>` and a newline to
  ;; stderr and exits with status 134, the line `aipl-run` prints. Jump to it
  ;; with the reason's address in rsi and its length in edx. `argv0_cell` is
  ;; the data address where start-up saved argv[0] (0 if there was none, in
  ;; which case only the reason is printed); `sep` is ": " and `nl` "\n" in
  ;; the data. Never returns; clobbers everything.
  (fn emit_trap_routine [c:(ptr buf.Buf) argv0_cell:i32 sep:i32 nl:i32] -> void
    (let r12:i32 12) (let r13:i32 13)
    (call x64.mov_rr c 64 r12 (call rsi))
    (call x64.mov_rr c 32 r13 (call rdx))
    (call emit_write_argv0 c argv0_cell sep)
    (call emit_write_regs c r12 r13)
    (call emit_write c 2 nl 1)
    (call emit_exit c 134))

  ;; The texts the call chain needs, as data addresses: "  at ", "  ... ",
  ;; and " more\n".
  ;; The call chain's texts, and the cell of the position table
  ;; ([entries, count, files]: native.aipl reserve_position_table).
  (struct ChainTexts [at:i32 dots:i32 more:i32 open:i32 colon:i32 close:i32 positions:i32])

  ;; The trap routine with the call chain, the lines aipl-run prints
  ;; (src/bin/aipl_run.rs call_chain): `call` it from the trap's place with
  ;; the reason's address in rsi and length in edx. Prints `<argv[0]>:
  ;; <reason>`, then "  at NAME" for each frame whose function has a name to
  ;; show, innermost first, at most 32, then "  ... N more"; exits with 134.
  ;; The frames are found through the frame pointers (every function's
  ;; prologue pushes rbp, so [rbp] is the caller's rbp and [rbp+8] the
  ;; return address); the walk ends at an address outside every function.
  ;; `table_cell` is the data address of [table address, entry count], each
  ;; entry [start end name_addr name_len] (32-bit, by start address; name_len
  ;; 0 for a function not shown). Never returns; clobbers everything.
  (fn emit_backtrace_routine [c:(ptr buf.Buf) argv0_cell:i32 sep:i32 nl:i32 t:(ptr ChainTexts) table_cell:i32] -> void
    (let rbx:i32 3) (let rcx:i32 1) (let rbp:i32 5)
    (let r12:i32 12) (let r13:i32 13) (let r14:i32 14) (let r15:i32 15)
    (call x64.pop c r14)                                  ;; where the trap is
    (call x64.mov_rr c 64 r12 (call rsi))
    (call x64.mov_rr c 32 r13 (call rdx))
    (call emit_write_argv0 c argv0_cell sep)
    (call emit_write_regs c r12 r13)
    (call emit_write c 2 nl 1)
    ;; r12: an address in the current frame's function; r13: that frame's
    ;; rbp; r14: frames shown; r15: frames not shown past the limit
    (call x64.mov_rr c 64 r12 r14)
    (call x64.mov_rr c 64 r13 rbp)
    (call x64.alu_rr c 32 (call x64.op_xor) r14 r14)
    (call x64.alu_rr c 32 (call x64.op_xor) r15 r15)
    (let frame:i32 (call buf.len c))
    ;; the entry with start <= address - 1 < end (a return address may be
    ;; the first byte after its function)
    (call x64.lea c 64 (call rax) (call x64.mem r12 -1))
    (call x64.mov_ri32 c rcx table_cell)
    (call x64.load c 32 rbx (call x64.mem rcx 0))
    (call x64.load c 32 rcx (call x64.mem rcx 4))
    (let scan:i32 (call buf.len c))
    (call x64.test_rr c 32 rcx rcx)
    (let done:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.load c 32 (call rdx) (call x64.mem rbx 0))
    (call x64.alu_rr c 32 (call x64.op_cmp) (call rax) (call rdx))
    (let before:i32 (call x64.jcc c (call x64.cc_b)))
    (call x64.load c 32 (call rdx) (call x64.mem rbx 4))
    (call x64.alu_rr c 32 (call x64.op_cmp) (call rax) (call rdx))
    (let found:i32 (call x64.jcc c (call x64.cc_b)))
    (call x64.patch_rel32 c before (call buf.len c))
    (call x64.alu_ri c 64 (call x64.op_add) rbx 16)
    (call x64.alu_ri c 32 (call x64.op_sub) rcx 1)
    (call x64.patch_rel32 c (call x64.jmp c) scan)
    ;; found: shown (name_len > 0), or counted past the limit
    (call x64.patch_rel32 c found (call buf.len c))
    (call x64.load c 32 (call rdx) (call x64.mem rbx 12))
    (call x64.test_rr c 32 (call rdx) (call rdx))
    (let hidden:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_ri c 32 (call x64.op_cmp) r14 32)
    (let over:i32 (call x64.jcc c (call x64.cc_ae)))
    (call emit_write c 2 (get t ChainTexts.at) 5)
    (call x64.load c 32 (call rsi) (call x64.mem rbx 8))
    (call x64.load c 32 (call rdx) (call x64.mem rbx 12))
    (call x64.mov_ri32 c (call rdi) 2)
    (call x64.mov_ri32 c (call rax) (call sys_write))
    (call x64.syscall c)
    (call emit_position c t)
    (call emit_write c 2 nl 1)
    (call x64.alu_ri c 32 (call x64.op_add) r14 1)
    (let shown:i32 (call x64.jmp c))
    (call x64.patch_rel32 c over (call buf.len c))
    (call x64.alu_ri c 32 (call x64.op_add) r15 1)
    ;; on to the caller's frame
    (call x64.patch_rel32 c hidden (call buf.len c))
    (call x64.patch_rel32 c shown (call buf.len c))
    (call x64.load c 64 r12 (call x64.mem r13 8))
    (call x64.load c 64 r13 (call x64.mem r13 0))
    (call x64.patch_rel32 c (call x64.jmp c) frame)
    ;; past the last frame
    (call x64.patch_rel32 c done (call buf.len c))
    (call x64.test_rr c 32 r15 r15)
    (let none:i32 (call x64.jcc c (call x64.cc_e)))
    (call emit_write c 2 (get t ChainTexts.dots) 6)
    (call emit_write_decimal c r15)
    (call emit_write c 2 (get t ChainTexts.more) 6)
    (call x64.patch_rel32 c none (call buf.len c))
    (call emit_exit c 134))

  ;; Writes argv[0] and ": " to stderr, or nothing if there is no argv[0].
  ;; Clobbers rax rbx rcx rdx rsi rdi r11.
  (fn emit_write_argv0 [c:(ptr buf.Buf) argv0_cell:i32 sep:i32] -> void
    (let rbx:i32 3)
    (call x64.mov_ri32 c (call rax) argv0_cell)
    (call x64.load c 64 rbx (call x64.mem (call rax) 0))
    (call x64.test_rr c 64 rbx rbx)
    (let no_name:i32 (call x64.jcc c (call x64.cc_e)))
    ;; edx = strlen(argv[0])
    (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
    (let top:i32 (call buf.len c))
    (call x64.load8u c (call rax) (call x64.mem_index rbx (call rdx) 1 0))
    (call x64.test_rr c 32 (call rax) (call rax))
    (let done:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_ri c 32 (call x64.op_add) (call rdx) 1)
    (call x64.patch_rel32 c (call x64.jmp c) top)
    (call x64.patch_rel32 c done (call buf.len c))
    (call emit_write_regs c rbx (call rdx))
    (call emit_write c 2 sep 2)
    (call x64.patch_rel32 c no_name (call buf.len c)))

  ;; The region trap routine (NE10): a WASI function was given a bad
  ;; pointer. Prints what wasmtime prints, `<argv[0]>: Pointer out of bounds:
  ;; Region { start: S, len: L }` (or `Pointer not aligned to N: ...`), and
  ;; exits with 134. Jump to it with start in esi, len in edx, and in eax 0
  ;; (out of bounds) or the alignment (4 or 8). `texts` are the data
  ;; addresses of: the three prefixes (out of bounds, align 4, align 8), ", len: ",
  ;; and " }\n", with their lengths.
  (struct RegionTexts [oob:i32 oob_len:i32 al4:i32 al4_len:i32 al8:i32 al8_len:i32
                       mid:i32 mid_len:i32 tail:i32 tail_len:i32])

  (fn emit_region_trap_routine [c:(ptr buf.Buf) argv0_cell:i32 sep:i32 t:(ptr RegionTexts)] -> void
    (let r12:i32 12) (let r13:i32 13) (let r14:i32 14)
    (call x64.mov_rr c 32 r12 (call rsi))
    (call x64.mov_rr c 32 r13 (call rdx))
    (call x64.mov_rr c 32 r14 (call rax))
    (call emit_write_argv0 c argv0_cell sep)
    (call x64.test_rr c 32 r14 r14)
    (let not_oob:i32 (call x64.jcc c (call x64.cc_ne)))
    (call emit_write c 2 (get t RegionTexts.oob) (get t RegionTexts.oob_len))
    (let j1:i32 (call x64.jmp c))
    (call x64.patch_rel32 c not_oob (call buf.len c))
    (call x64.alu_ri c 32 (call x64.op_cmp) r14 4)
    (let not4:i32 (call x64.jcc c (call x64.cc_ne)))
    (call emit_write c 2 (get t RegionTexts.al4) (get t RegionTexts.al4_len))
    (let j2:i32 (call x64.jmp c))
    (call x64.patch_rel32 c not4 (call buf.len c))
    (call emit_write c 2 (get t RegionTexts.al8) (get t RegionTexts.al8_len))
    (call x64.patch_rel32 c j1 (call buf.len c))
    (call x64.patch_rel32 c j2 (call buf.len c))
    (call emit_write_decimal c r12)
    (call emit_write c 2 (get t RegionTexts.mid) (get t RegionTexts.mid_len))
    (call emit_write_decimal c r13)
    (call emit_write c 2 (get t RegionTexts.tail) (get t RegionTexts.tail_len))
    (call emit_exit c 134))

  ;; Writes the unsigned value in register `reg` to stderr in decimal, from a
  ;; buffer on the stack. Clobbers rax rcx rdx rsi rdi r9 r11.
  (fn emit_write_decimal [c:(ptr buf.Buf) reg:i32] -> void
    (let r9:i32 9)
    (call x64.alu_ri c 64 (call x64.op_sub) 4 32)
    (call x64.mov_rr c 64 (call rax) reg)
    (call x64.lea c 64 r9 (call x64.mem 4 32))
    (call x64.mov_ri32 c 1 10)
    (let top:i32 (call buf.len c))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
    (call x64.div_r c 64 1)
    (call x64.alu_ri c 32 (call x64.op_add) (call rdx) 48)
    (call x64.alu_ri c 64 (call x64.op_sub) r9 1)
    (call x64.store8 c (call x64.mem r9 0) (call rdx))
    (call x64.test_rr c 64 (call rax) (call rax))
    (call x64.patch_rel32 c (call x64.jcc c (call x64.cc_ne)) top)
    (call x64.mov_rr c 64 (call rsi) r9)
    (call x64.lea c 64 (call rdx) (call x64.mem 4 32))
    (call x64.alu_rr c 64 (call x64.op_sub) (call rdx) r9)
    (call x64.mov_ri32 c (call rdi) 2)
    (call x64.mov_ri32 c (call rax) (call sys_write))
    (call x64.syscall c)
    (call x64.alu_ri c 64 (call x64.op_add) 4 32))

  ;; " (file:line:col)" for the frame whose address is in r12, as aipl-run
  ;; prints it: the last position entry at or before r12 - 1 (entries are by
  ;; address, each 16 bytes: [address file line col]), unless it has no
  ;; file. Clobbers rax rbx rcx rdx rsi rdi r9 r11.
  (fn emit_position [c:(ptr buf.Buf) t:(ptr ChainTexts)] -> void
    (let rbx:i32 3) (let r12:i32 12)
    (call x64.lea c 64 (call rax) (call x64.mem r12 -1))
    (call x64.mov_ri32 c (call rcx) (get t ChainTexts.positions))
    (call x64.load c 32 rbx (call x64.mem (call rcx) 0))
    (call x64.load c 32 (call rcx) (call x64.mem (call rcx) 4))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
    (let scan:i32 (call buf.len c))
    (call x64.test_rr c 32 (call rcx) (call rcx))
    (let ended:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.load c 32 (call rsi) (call x64.mem rbx 0))
    (call x64.alu_rr c 64 (call x64.op_cmp) (call rax) (call rsi))
    (let past:i32 (call x64.jcc c (call x64.cc_b)))
    (call x64.mov_rr c 64 (call rdx) rbx)
    (call x64.alu_ri c 64 (call x64.op_add) rbx 16)
    (call x64.alu_ri c 32 (call x64.op_sub) (call rcx) 1)
    (call x64.patch_rel32 c (call x64.jmp c) scan)
    (call x64.patch_rel32 c ended (call buf.len c))
    (call x64.patch_rel32 c past (call buf.len c))
    ;; none found, or one without a file
    (call x64.test_rr c 64 (call rdx) (call rdx))
    (let none:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.load c 32 (call rax) (call x64.mem (call rdx) 4))
    (call x64.test_rr c 32 (call rax) (call rax))
    (let no_file:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.mov_rr c 64 rbx (call rdx))
    (call emit_write c 2 (get t ChainTexts.open) 2)
    ;; the file's name: files table entry [address length]
    (call x64.mov_ri32 c (call rcx) (get t ChainTexts.positions))
    (call x64.load c 32 (call rcx) (call x64.mem (call rcx) 8))
    (call x64.load c 32 (call rax) (call x64.mem rbx 4))
    (call x64.lea c 64 (call rcx) (call x64.mem_index (call rcx) (call rax) 8 0))
    (call x64.load c 32 (call rsi) (call x64.mem (call rcx) 0))
    (call x64.load c 32 (call rdx) (call x64.mem (call rcx) 4))
    (call emit_write_regs c (call rsi) (call rdx))
    (call emit_write c 2 (get t ChainTexts.colon) 1)
    (call x64.load c 32 (call rax) (call x64.mem rbx 8))
    (call emit_write_decimal c (call rax))
    (call emit_write c 2 (get t ChainTexts.colon) 1)
    (call x64.load c 32 (call rax) (call x64.mem rbx 12))
    (call emit_write_decimal c (call rax))
    (call emit_write c 2 (get t ChainTexts.close) 1)
    (call x64.patch_rel32 c none (call buf.len c))
    (call x64.patch_rel32 c no_file (call buf.len c)))

  ;; write(2, addr, len) with the address and length in registers.
  (fn emit_write_regs [c:(ptr buf.Buf) addr:i32 len:i32] -> void
    (call x64.mov_rr c 64 (call rsi) addr)
    (call x64.mov_rr c 64 (call rdx) len)
    (call x64.mov_ri32 c (call rdi) 2)
    (call x64.mov_ri32 c (call rax) (call sys_write))
    (call x64.syscall c))

  ;; The first native executable (NE4): writes "hello from native AIPL\n" to
  ;; stdout and exits with status 7.
  (fn hello_exe [] -> (ptr str.Bytes)
    (let data:(ptr buf.Buf) (call buf.make (call alloc.default) 32))
    (call buf.push_str data "hello from native AIPL")
    (call buf.push_byte data 10)
    (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (call emit_write c 1 (call elf.data_vaddr) (call buf.len data))
    (call emit_exit c 7)
    (call buf.bytes (call elf.image (call buf.bytes c) 0 (call buf.bytes data) 0)))
)
