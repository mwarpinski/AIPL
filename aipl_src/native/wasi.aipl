;; wasi: the WASI preview1 functions AIPL programs import, as native
;; routines over Linux system calls (native backend, NE10-NE11,
;; docs/design/NATIVE_BACKEND_PLAN.md). Each routine is called like any translated
;; function (lower.aipl): arguments pushed in order, one 8-byte slot each,
;; result in rax (a WASI errno: 0 for success). Routines may clobber every
;; register except rbp, rsp, and r15 (the linear memory base).
;;
;; Behaviour follows wasmtime's, which aipl-run uses:
;;   - A pointer the program passes is checked before use: out of bounds
;;     traps with `Pointer out of bounds: Region { start: S, len: L }`, then a
;;     misaligned out-parameter with `Pointer not aligned to N: ...` (the
;;     region trap routine, runtime.emit_region_trap_routine).
;;   - Linux errors become WASI errnos through a table (errno_table).
;;   - WASI file descriptors are indices into fd_table, whose entries are
;;     Linux descriptors (-1 when closed): 0-2 are stdio, 3 the working
;;     directory, 4 `/` (not with --sandbox); path_open takes the lowest free
;;     index, as wasmtime does. Closing 0-2 frees the index but keeps the
;;     process's own stdio open (wasmtime's host keeps them too), so a trap
;;     message still reaches stderr.
;;   - File access (NE11): a path resolves beneath its directory descriptor
;;     (openat2 with RESOLVE_BENEATH): the kernel refuses `..` escapes,
;;     absolute paths, and symlinks leading out, as wasmtime's preopens do.
;;     openat2 is Linux 5.6's, and Rosetta 2 and some container profiles
;;     lack it (ENOSYS, or EPERM from a seccomp filter): a program built
;;     without --sandbox then opens with plain openat, losing nothing (it
;;     has `/` as fd 4 anyway); a --sandbox program, whose point is the
;;     confinement, says at start that it needs openat2 and exits 1.
(module wasi
  (import alloc)
  (import str)
  (import buf)
  (import vec)
  (import x64)
  (import lower)

  ;; Data addresses and code positions the routines need.
  (struct W [(pub region_routine:i32) fd_table:i32 errno_table:i32
             argc_cell:i32 argv_cell:i32 envc_cell:i32 envp_cell:i32 sandbox:bool] (pub))

  (fn fd_slots [] -> i32 64)

  ;; Registers (x64.aipl numbering)
  (fn rax [] -> i32 0) (fn rcx [] -> i32 1) (fn rdx [] -> i32 2) (fn rbx [] -> i32 3)
  (fn rsp [] -> i32 4) (fn rsi [] -> i32 6) (fn rdi [] -> i32 7)
  (fn r8 [] -> i32 8) (fn r9 [] -> i32 9) (fn r10 [] -> i32 10) (fn r11 [] -> i32 11)
  (fn r12 [] -> i32 12) (fn r13 [] -> i32 13) (fn r14 [] -> i32 14) (fn r15 [] -> i32 15)

  ;; ===== Data =====

  ;; The data the routines use: the fd table (stdio open) and the errno table.
  (fn make [l:(ptr lower.L) sandbox:bool] -> (ptr W) (pub)
    (let w:(ptr W) (new W (call alloc.forever) [region_routine:-1
                                                fd_table:(zero i32)
                                                errno_table:(zero i32)
                                                argc_cell:(zero i32)
                                                argv_cell:(zero i32)
                                                envc_cell:(zero i32)
                                                envp_cell:(zero i32)
                                                sandbox:sandbox]))
    (let fds:(ptr buf.Buf) (call buf.make (call alloc.default) 256))
    (for i 0 (call fd_slots)
      (call push_u32 fds (if (lte i 2) i -1)))
    (put w W.fd_table (call lower.data_bytes l (call buf.bytes fds)))
    (put w W.errno_table (call lower.data_bytes l (call buf.bytes (call errno_bytes))))
    (put w W.argc_cell (call cell l))
    (put w W.argv_cell (call cell l))
    (put w W.envc_cell (call cell l))
    (put w W.envp_cell (call cell l))
    w)

  (fn cell [l:(ptr lower.L)] -> i32
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 8))
    (for k 1 9 (call buf.push_byte b 0))
    (call lower.data_bytes l (call buf.bytes b)))

  (fn push_u32 [b:(ptr buf.Buf) v:i32] -> void
    (call buf.push_byte b (bitand v 255))
    (call buf.push_byte b (bitand (shru v 8) 255))
    (call buf.push_byte b (bitand (shru v 16) 255))
    (call buf.push_byte b (bitand (shru v 24) 255)))

  ;; Linux errno (0-63) -> WASI errno; anything unlisted is EIO (29). EXDEV
  ;; (18) comes only from openat2's RESOLVE_BENEATH refusing a path that
  ;; leaves its directory, which wasmtime reports as EPERM (63), so it is
  ;; 63 here (src/vm.rs wasi_errno alike).
  (fn errno_bytes [] -> (ptr buf.Buf)
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (for e 0 64
      (call buf.push_byte b
        (cond ((eq e 0) 0)
              ((eq e 1) 63)  ((eq e 2) 44)  ((eq e 4) 27)  ((eq e 5) 29)  ((eq e 9) 8)
              ((eq e 11) 6)  ((eq e 12) 48) ((eq e 13) 2)  ((eq e 14) 21) ((eq e 16) 10)
              ((eq e 17) 20) ((eq e 18) 63) ((eq e 20) 54) ((eq e 21) 31) ((eq e 22) 28)
              ((eq e 24) 33) ((eq e 27) 22) ((eq e 28) 51) ((eq e 29) 70) ((eq e 30) 69)
              ((eq e 32) 64) ((eq e 36) 37) ((eq e 39) 55) ((eq e 40) 32)
              (else 29))))
    b)

  ;; ===== Building blocks =====

  ;; reg = argument i (of n), 32 or 64 bits, at routine entry (rsp unchanged).
  (fn arg [c:(ptr buf.Buf) sz:i32 n:i32 i:i32 reg:i32] -> void
    (call x64.load c sz reg (call x64.mem (call rsp) (+ 8 (* 8 (- (- n 1) i))))))

  ;; Checks the guest region [addr, addr + len) (registers holding
  ;; zero-extended values; not rax rcx rdx rsi r10 r11): traps out of bounds,
  ;; then, for align > 1, misaligned. Clobbers rcx r10 r11.
  (fn emit_guest_check [l:(ptr lower.L) w:(ptr W) addr:i32 len:i32 align:i32] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call x64.mov_rr c 64 (call r11) addr)
    (call x64.alu_rr c 64 (call x64.op_add) (call r11) len)
    (call lower.load_mem_size l (call r10))
    (call x64.alu_rr c 64 (call x64.op_cmp) (call r11) (call r10))
    (let in_bounds:i32 (call x64.jcc c (call x64.cc_be)))
    (call emit_region_trap l w addr len 0)
    (call x64.patch_rel32 c in_bounds (call buf.len c))
    (when (gt align 1)
          (call x64.test_ri c 32 addr (- align 1))
          (let aligned:i32 (call x64.jcc c (call x64.cc_e)))
          (call emit_region_trap l w addr len align)
          (call x64.patch_rel32 c aligned (call buf.len c))))

  (fn emit_region_trap [l:(ptr lower.L) w:(ptr W) addr:i32 len:i32 kind:i32] -> void
    (req (gte (get w W.region_routine) 0))
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call x64.mov_rr c 32 (call rsi) addr)
    (call x64.mov_rr c 32 (call rdx) len)
    (call x64.mov_ri32 c (call rax) kind)
    (call x64.patch_rel32 c (call x64.jmp c) (get w W.region_routine)))

  ;; With a Linux result (-errno) in rax: returns the WASI errno.
  (fn emit_errno_return [l:(ptr lower.L) w:(ptr W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call x64.mov_rr c 64 (call rcx) (call rax))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.alu_rr c 64 (call x64.op_sub) (call rax) (call rcx))
    (call x64.alu_ri c 64 (call x64.op_cmp) (call rax) 64)
    (let unlisted:i32 (call x64.jcc c (call x64.cc_ae)))
    (call x64.mov_ri32 c (call rcx) (get w W.errno_table))
    (call x64.load8u c (call rax) (call x64.mem_index (call rcx) (call rax) 1 0))
    (call x64.ret c)
    (call x64.patch_rel32 c unlisted (call buf.len c))
    (call x64.mov_ri32 c (call rax) 29)
    (call x64.ret c))

  (fn emit_return_errno [c:(ptr buf.Buf) errno:i32] -> void
    (call x64.mov_ri32 c (call rax) errno)
    (call x64.ret c))

  ;; out = the Linux descriptor for WASI descriptor `fd` (both registers,
  ;; may be the same; not rcx). Jumps whose positions are added to `badf`
  ;; go to the routine's EBADF return.
  (fn emit_fd_lookup [l:(ptr lower.L) w:(ptr W) fd:i32 out:i32 badf:(ptr (vec.Vec i32))] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call x64.alu_ri c 32 (call x64.op_cmp) fd (call fd_slots))
    (call (vec.push i32) badf (call x64.jcc c (call x64.cc_ae)))
    (call x64.mov_ri32 c (call rcx) (get w W.fd_table))
    (call x64.load c 32 out (call x64.mem_index (call rcx) fd 4 0))
    (call x64.test_rr c 32 out out)
    (call (vec.push i32) badf (call x64.jcc c (call x64.cc_s))))

  (fn patch_all [c:(ptr buf.Buf) at:(ptr (vec.Vec i32))] -> void
    (for k 0 (call (vec.len i32) at)
      (call x64.patch_rel32 c (call (vec.at i32) at k) (call buf.len c))))

  ;; rdx = strlen of the NUL-terminated string at rsi (host address).
  ;; Clobbers rax.
  (fn emit_strlen [c:(ptr buf.Buf)] -> void
    (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
    (let top:i32 (call buf.len c))
    (call x64.load8u c (call rax) (call x64.mem_index (call rsi) (call rdx) 1 0))
    (call x64.test_rr c 32 (call rax) (call rax))
    (let done:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_ri c 64 (call x64.op_add) (call rdx) 1)
    (call x64.patch_rel32 c (call x64.jmp c) top)
    (call x64.patch_rel32 c done (call buf.len c)))

  ;; ===== The routines =====

  ;; fd_write / fd_read(fd, iovs, iovs_len, n_ptr) -> errno. Writes each
  ;; iovec in full (retrying short writes); reads stop at end of input or
  ;; the first short read. *n_ptr = bytes transferred. A read into a buffer
  ;; outside memory behaves as wasmtime's, which reads first and copies
  ;; after: nothing read is not an error; otherwise it traps with the bytes
  ;; read as the region's length (read here into a stack buffer of up to
  ;; 64 KiB, the most one pipe read returns).
  (fn emit_fd_rw [l:(ptr lower.L) w:(ptr W) reading:bool] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let badf:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 4))
    (let errs:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (let done:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 4))
    (call arg c 32 4 0 (call r12))
    (call emit_fd_lookup l w (call r12) (call r12) badf)
    (call arg c 32 4 1 (call r13))
    (call arg c 32 4 2 (call r14))
    (call x64.mov_rr c 64 (call r9) (call r14))
    (call x64.shift_ri c 64 (call x64.sh_shl) (call r9) 3)
    (call emit_guest_check l w (call r13) (call r9) 4)
    (call x64.alu_rr c 32 (call x64.op_xor) (call rbx) (call rbx))
    ;; each iovec: [buf:u32 len:u32]
    (let next_iov:i32 (call buf.len c))
    (call x64.test_rr c 64 (call r14) (call r14))
    (call (vec.push i32) done (call x64.jcc c (call x64.cc_e)))
    (call x64.load c 32 (call r8) (call x64.mem_index (call r15) (call r13) 1 0))
    (call x64.load c 32 (call r9) (call x64.mem_index (call r15) (call r13) 1 4))
    (if reading (call emit_read_outside_memory l w errs done) (call emit_guest_check l w (call r8) (call r9) 1))
    (let more:i32 (call buf.len c))
    (call x64.test_rr c 64 (call r9) (call r9))
    (let iov_done:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.mov_rr c 64 (call rdi) (call r12))
    (call x64.lea c 64 (call rsi) (call x64.mem_index (call r15) (call r8) 1 0))
    (call x64.mov_rr c 64 (call rdx) (call r9))
    (call x64.mov_ri32 c (call rax) (if reading 0 1))
    (call x64.syscall c)
    (call x64.test_rr c 64 (call rax) (call rax))
    (call (vec.push i32) errs (call x64.jcc c (call x64.cc_s)))
    ;; nothing transferred: end of input, or a write that made no progress
    (call (vec.push i32) done (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_rr c 64 (call x64.op_add) (call rbx) (call rax))
    (call x64.alu_rr c 64 (call x64.op_add) (call r8) (call rax))
    (call x64.alu_rr c 64 (call x64.op_sub) (call r9) (call rax))
    (when reading
          (call x64.test_rr c 64 (call r9) (call r9))
          (call (vec.push i32) done (call x64.jcc c (call x64.cc_ne))))
    (call x64.patch_rel32 c (call x64.jmp c) more)
    (call x64.patch_rel32 c iov_done (call buf.len c))
    (call x64.alu_ri c 64 (call x64.op_add) (call r13) 8)
    (call x64.alu_ri c 64 (call x64.op_sub) (call r14) 1)
    (call x64.patch_rel32 c (call x64.jmp c) next_iov)
    (call patch_all c done)
    (call arg c 32 4 3 (call r8))
    (call x64.mov_ri32 c (call r9) 4)
    (call emit_guest_check l w (call r8) (call r9) 4)
    (call x64.store c 32 (call x64.mem_index (call r15) (call r8) 1 0) (call rbx))
    (call emit_return_errno c 0)
    (call patch_all c errs)
    ;; reading a directory: wasmtime's directory handles cannot be read, so
    ;; it gives EBADF where Linux gives EISDIR (src/vm.rs FsRead alike)
    (when reading
          (call x64.alu_ri c 64 (call x64.op_cmp) (call rax) -21)
          (let not_dir:i32 (call x64.jcc c (call x64.cc_ne)))
          (call emit_return_errno c 8)
          (call x64.patch_rel32 c not_dir (call buf.len c)))
    (call emit_errno_return l w)
    (call patch_all c badf)
    (call emit_return_errno c 8))

  ;; For fd_read: if the buffer (r8, r9 bytes) is outside memory, reads into
  ;; the stack instead (fd in r12): end of input jumps to `done`, an error
  ;; to `errs`, anything read traps. In bounds, falls through.
  (fn emit_read_outside_memory [l:(ptr lower.L) w:(ptr W) errs:(ptr (vec.Vec i32)) done:(ptr (vec.Vec i32))] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call x64.mov_rr c 64 (call r11) (call r8))
    (call x64.alu_rr c 64 (call x64.op_add) (call r11) (call r9))
    (call lower.load_mem_size l (call r10))
    (call x64.alu_rr c 64 (call x64.op_cmp) (call r11) (call r10))
    (let in_bounds:i32 (call x64.jcc c (call x64.cc_be)))
    (call x64.mov_rr c 64 (call rdx) (call r9))
    (call x64.alu_ri c 64 (call x64.op_cmp) (call rdx) 65536)
    (let small:i32 (call x64.jcc c (call x64.cc_be)))
    (call x64.mov_ri32 c (call rdx) 65536)
    (call x64.patch_rel32 c small (call buf.len c))
    (call x64.alu_ri c 64 (call x64.op_sub) (call rsp) 65536)
    (call x64.mov_rr c 64 (call rsi) (call rsp))
    (call x64.mov_rr c 64 (call rdi) (call r12))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.syscall c)
    (call x64.alu_ri c 64 (call x64.op_add) (call rsp) 65536)
    (call x64.test_rr c 64 (call rax) (call rax))
    (call (vec.push i32) errs (call x64.jcc c (call x64.cc_s)))
    (call (vec.push i32) done (call x64.jcc c (call x64.cc_e)))
    (call emit_region_trap l w (call r8) (call rax) 0)
    (call x64.patch_rel32 c in_bounds (call buf.len c)))

  ;; fd_close(fd) -> errno. WASI 0-2 only free their slot (see the header).
  (fn emit_fd_close [l:(ptr lower.L) w:(ptr W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let badf:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (call arg c 32 1 0 (call r12))
    (call emit_fd_lookup l w (call r12) (call rdi) badf)
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.alu_ri c 32 (call x64.op_cmp) (call r12) 2)
    (let stdio:i32 (call x64.jcc c (call x64.cc_be)))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (call x64.patch_rel32 c stdio (call buf.len c))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let failed:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.mov_ri32 c (call rcx) (get w W.fd_table))
    (call x64.mov_ri32 c (call rax) -1)
    (call x64.store c 32 (call x64.mem_index (call rcx) (call r12) 4 0) (call rax))
    (call emit_return_errno c 0)
    (call x64.patch_rel32 c failed (call buf.len c))
    (call emit_errno_return l w)
    (call patch_all c badf)
    (call emit_return_errno c 8))

  ;; args_sizes_get / environ_sizes_get(count_ptr, size_ptr) -> errno. The
  ;; size (every string with its NUL) is written before the count, as
  ;; wasmtime does.
  (fn emit_strings_sizes [l:(ptr lower.L) w:(ptr W) count_cell:i32 array_cell:i32] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call load_list c count_cell array_cell)
    (call x64.alu_rr c 32 (call x64.op_xor) (call r13) (call r13))
    (call x64.alu_rr c 32 (call x64.op_xor) (call r14) (call r14))
    (let top:i32 (call buf.len c))
    (call x64.alu_rr c 64 (call x64.op_cmp) (call r14) (call rbx))
    (let done:i32 (call x64.jcc c (call x64.cc_ae)))
    (call x64.load c 64 (call rsi) (call x64.mem_index (call r12) (call r14) 8 0))
    (call emit_strlen c)
    (call x64.lea c 64 (call r13) (call x64.mem_index (call r13) (call rdx) 1 1))
    (call x64.alu_ri c 64 (call x64.op_add) (call r14) 1)
    (call x64.patch_rel32 c (call x64.jmp c) top)
    (call x64.patch_rel32 c done (call buf.len c))
    (call x64.mov_ri32 c (call r9) 4)
    (call arg c 32 2 1 (call r8))
    (call emit_guest_check l w (call r8) (call r9) 4)
    (call x64.store c 32 (call x64.mem_index (call r15) (call r8) 1 0) (call r13))
    (call arg c 32 2 0 (call r8))
    (call emit_guest_check l w (call r8) (call r9) 4)
    (call x64.store c 32 (call x64.mem_index (call r15) (call r8) 1 0) (call rbx))
    (call emit_return_errno c 0))

  ;; rbx = the count, r12 = the host array of string pointers.
  (fn load_list [c:(ptr buf.Buf) count_cell:i32 array_cell:i32] -> void
    (call x64.mov_ri32 c (call rcx) count_cell)
    (call x64.load c 64 (call rbx) (call x64.mem (call rcx) 0))
    (call x64.mov_ri32 c (call rcx) array_cell)
    (call x64.load c 64 (call r12) (call x64.mem (call rcx) 0)))

  ;; args_get / environ_get(ptrs, buf) -> errno: each string with its NUL
  ;; into buf, one after another, and its guest address into ptrs[i].
  (fn emit_strings_get [l:(ptr lower.L) w:(ptr W) count_cell:i32 array_cell:i32] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call load_list c count_cell array_cell)
    (call x64.alu_rr c 32 (call x64.op_xor) (call r14) (call r14))
    (call arg c 32 2 1 (call r13))
    (let top:i32 (call buf.len c))
    (call x64.alu_rr c 64 (call x64.op_cmp) (call r14) (call rbx))
    (let done:i32 (call x64.jcc c (call x64.cc_ae)))
    (call x64.load c 64 (call rsi) (call x64.mem_index (call r12) (call r14) 8 0))
    (call emit_strlen c)
    (call x64.lea c 64 (call r9) (call x64.mem (call rdx) 1))
    (call emit_guest_check l w (call r13) (call r9) 1)
    (call x64.lea c 64 (call rdi) (call x64.mem_index (call r15) (call r13) 1 0))
    (call x64.mov_rr c 64 (call rcx) (call r9))
    (call x64.rep_movsb c)
    (call arg c 32 2 0 (call r8))
    (call x64.lea c 64 (call r8) (call x64.mem_index (call r8) (call r14) 4 0))
    (call x64.mov_ri32 c (call r9) 4)
    (call emit_guest_check l w (call r8) (call r9) 4)
    (call x64.store c 32 (call x64.mem_index (call r15) (call r8) 1 0) (call r13))
    (call x64.lea c 64 (call r13) (call x64.mem_index (call r13) (call rdx) 1 1))
    (call x64.alu_ri c 64 (call x64.op_add) (call r14) 1)
    (call x64.patch_rel32 c (call x64.jmp c) top)
    (call x64.patch_rel32 c done (call buf.len c))
    (call emit_return_errno c 0))

  ;; clock_time_get(id, precision:i64, time_ptr) -> errno: nanoseconds from
  ;; clock_gettime (WASI's clock ids 0-3 are Linux's).
  (fn emit_clock_time_get [l:(ptr lower.L) w:(ptr W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call arg c 32 3 0 (call rdi))
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rdi) 3)
    (let bad_id:i32 (call x64.jcc c (call x64.cc_a)))
    (call x64.alu_ri c 64 (call x64.op_sub) (call rsp) 16)
    (call x64.mov_rr c 64 (call rsi) (call rsp))
    (call x64.mov_ri32 c (call rax) 228)
    (call x64.syscall c)
    (call x64.load c 64 (call rbx) (call x64.mem (call rsp) 0))
    (call x64.load c 64 (call rdx) (call x64.mem (call rsp) 8))
    (call x64.alu_ri c 64 (call x64.op_add) (call rsp) 16)
    (call x64.test_rr c 64 (call rax) (call rax))
    (let failed:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.mov_ri64 c (call rcx) 1000000000i64)
    (call x64.imul_rr c 64 (call rbx) (call rcx))
    (call x64.alu_rr c 64 (call x64.op_add) (call rbx) (call rdx))
    (call arg c 32 3 2 (call r8))
    (call x64.mov_ri32 c (call r9) 8)
    (call emit_guest_check l w (call r8) (call r9) 8)
    (call x64.store c 64 (call x64.mem_index (call r15) (call r8) 1 0) (call rbx))
    (call emit_return_errno c 0)
    (call x64.patch_rel32 c failed (call buf.len c))
    (call emit_errno_return l w)
    (call x64.patch_rel32 c bad_id (call buf.len c))
    (call emit_return_errno c 28))

  ;; random_get(buf, len) -> errno, from getrandom.
  (fn emit_random_get [l:(ptr lower.L) w:(ptr W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call arg c 32 2 0 (call r8))
    (call arg c 32 2 1 (call r9))
    (call emit_guest_check l w (call r8) (call r9) 1)
    (let top:i32 (call buf.len c))
    (call x64.test_rr c 64 (call r9) (call r9))
    (let done:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.lea c 64 (call rdi) (call x64.mem_index (call r15) (call r8) 1 0))
    (call x64.mov_rr c 64 (call rsi) (call r9))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
    (call x64.mov_ri32 c (call rax) 318)
    (call x64.syscall c)
    (call x64.test_rr c 64 (call rax) (call rax))
    (let failed:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.alu_rr c 64 (call x64.op_add) (call r8) (call rax))
    (call x64.alu_rr c 64 (call x64.op_sub) (call r9) (call rax))
    (call x64.patch_rel32 c (call x64.jmp c) top)
    (call x64.patch_rel32 c done (call buf.len c))
    (call emit_return_errno c 0)
    (call x64.patch_rel32 c failed (call buf.len c))
    (call emit_errno_return l w))

  ;; Start-up: saves argc, argv, the environment and its count. Expects rsp
  ;; as the kernel left it (argc, argv[0..argc], NULL, envp..., NULL).
  (fn emit_capture_args [l:(ptr lower.L) w:(ptr W)] -> void (pub)
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call x64.load c 64 (call rax) (call x64.mem (call rsp) 0))
    (call x64.mov_ri32 c (call rcx) (get w W.argc_cell))
    (call x64.store c 64 (call x64.mem (call rcx) 0) (call rax))
    (call x64.lea c 64 (call rdx) (call x64.mem (call rsp) 8))
    (call x64.mov_ri32 c (call rcx) (get w W.argv_cell))
    (call x64.store c 64 (call x64.mem (call rcx) 0) (call rdx))
    (call x64.lea c 64 (call rsi) (call x64.mem_index (call rsp) (call rax) 8 16))
    (call x64.mov_ri32 c (call rcx) (get w W.envp_cell))
    (call x64.store c 64 (call x64.mem (call rcx) 0) (call rsi))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
    (let top:i32 (call buf.len c))
    (call x64.load c 64 (call rax) (call x64.mem_index (call rsi) (call rdx) 8 0))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let done:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_ri c 64 (call x64.op_add) (call rdx) 1)
    (call x64.patch_rel32 c (call x64.jmp c) top)
    (call x64.patch_rel32 c done (call buf.len c))
    (call x64.mov_ri32 c (call rcx) (get w W.envc_cell))
    (call x64.store c 64 (call x64.mem (call rcx) 0) (call rdx)))

  ;; ===== Files (NE11) =====

  ;; Copies the guest path (r13 = address, r14 = length, checked) to the
  ;; stack as a NUL-terminated string; rsp then points at it. The caller
  ;; must restore rsp from r12, where the old rsp is saved. Clobbers rcx rsi
  ;; rdi.
  (fn emit_path_to_stack [l:(ptr lower.L) w:(ptr W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call x64.mov_rr c 64 (call r12) (call rsp))
    (call emit_copy_path l w))

  ;; emit_path_to_stack without saving rsp: for a second path, copied below
  ;; the first, with r12 already holding the routine's own rsp.
  (fn emit_copy_path [l:(ptr lower.L) w:(ptr W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    ;; room for the path, its NUL, and alignment: (len + 16) & ~15
    (call x64.lea c 64 (call rcx) (call x64.mem (call r14) 16))
    (call x64.alu_ri c 64 (call x64.op_and) (call rcx) -16)
    (call x64.alu_rr c 64 (call x64.op_sub) (call rsp) (call rcx))
    (call x64.mov_rr c 64 (call rdi) (call rsp))
    (call x64.lea c 64 (call rsi) (call x64.mem_index (call r15) (call r13) 1 0))
    (call x64.mov_rr c 64 (call rcx) (call r14))
    (call x64.rep_movsb c)
    (call x64.alu_rr c 32 (call x64.op_xor) (call rcx) (call rcx))
    (call x64.store8 c (call x64.mem (call rdi) 0) (call rcx)))

  ;; openat2(rdi = dir fd, rsi = path, {flags, mode, resolve beneath}) with
  ;; the open flags in rdx; mode 0o666 when creating (openat2 refuses a
  ;; mode otherwise). Result in rax. Clobbers rcx r11 r10 (and rdx, with
  ;; fallback). With `fallback`, a kernel without openat2 (ENOSYS: before
  ;; Linux 5.6, Rosetta 2) or a seccomp profile that refuses it (EPERM) gets
  ;; the same open as plain openat, without the confinement.
  (fn emit_openat2 [c:(ptr buf.Buf) fallback:bool] -> void
    ;; struct open_how { u64 flags; u64 mode; u64 resolve } on the stack;
    ;; resolve = RESOLVE_BENEATH (8) | RESOLVE_NO_MAGICLINKS (2)
    (call x64.alu_ri c 64 (call x64.op_sub) (call rsp) 32)
    (call x64.store c 64 (call x64.mem (call rsp) 0) (call rdx))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.test_ri c 32 (call rdx) 64)
    (let no_create:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.mov_ri32 c (call rax) 438)
    (call x64.patch_rel32 c no_create (call buf.len c))
    (call x64.store c 64 (call x64.mem (call rsp) 8) (call rax))
    (call x64.mov_ri32 c (call rax) 10)
    (call x64.store c 64 (call x64.mem (call rsp) 16) (call rax))
    (call x64.mov_rr c 64 (call rdx) (call rsp))
    (call x64.mov_ri32 c (call r10) 24)
    (call x64.mov_ri32 c (call rax) 437)
    (call x64.syscall c)
    (when fallback
      (call x64.alu_ri c 64 (call x64.op_cmp) (call rax) -38)
      (let enosys:i32 (call x64.jcc c (call x64.cc_e)))
      (call x64.alu_ri c 64 (call x64.op_cmp) (call rax) -1)
      (let eperm:i32 (call x64.jcc c (call x64.cc_e)))
      (let done:i32 (call x64.jmp c))
      (call x64.patch_rel32 c enosys (call buf.len c))
      (call x64.patch_rel32 c eperm (call buf.len c))
      ;; openat(rdi = dir fd, rsi = path, rdx = flags, r10 = mode): the
      ;; flags and mode already stored in the open_how struct
      (call x64.load c 64 (call rdx) (call x64.mem (call rsp) 0))
      (call x64.load c 64 (call r10) (call x64.mem (call rsp) 8))
      (call x64.mov_ri32 c (call rax) 257)
      (call x64.syscall c)
      (call x64.patch_rel32 c done (call buf.len c)))
    (call x64.alu_ri c 64 (call x64.op_add) (call rsp) 32))

  ;; path_open(dirfd, dirflags, path, path_len, oflags, rights_base:i64,
  ;; rights_inheriting:i64, fdflags, fd_out) -> errno
  (fn emit_path_open [l:(ptr lower.L) w:(ptr W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let badf:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (call arg c 32 9 0 (call rbx))
    (call emit_fd_lookup l w (call rbx) (call rbx) badf)
    (call arg c 32 9 2 (call r13))
    (call arg c 32 9 3 (call r14))
    (call emit_guest_check l w (call r13) (call r14) 1)
    ;; Linux flags in r8: O_CLOEXEC; O_RDWR with the write right (1 << 6)
    (call x64.mov_ri32 c (call r8) 524288)
    (call arg c 64 9 5 (call rax))
    (call x64.test_ri c 32 (call rax) 64)
    (let read_only:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_ri c 32 (call x64.op_or) (call r8) 2)
    (call x64.patch_rel32 c read_only (call buf.len c))
    ;; oflags: CREAT 1 -> 0x40, DIRECTORY 2 -> 0x10000, EXCL 4 -> 0x80, TRUNC 8 -> 0x200
    (call arg c 32 9 4 (call rax))
    (call map_flag c (call rax) 1 64)
    (call map_flag c (call rax) 2 65536)
    (call map_flag c (call rax) 4 128)
    (call map_flag c (call rax) 8 512)
    ;; fdflags: APPEND 1 -> 0x400
    (call arg c 32 9 7 (call rax))
    (call map_flag c (call rax) 1 1024)
    ;; dirflags without SYMLINK_FOLLOW (1): O_NOFOLLOW
    (call arg c 32 9 1 (call rax))
    (call x64.test_ri c 32 (call rax) 1)
    (let follow:i32 (call x64.jcc c (call x64.cc_ne)))
    (call x64.alu_ri c 32 (call x64.op_or) (call r8) 131072)
    (call x64.patch_rel32 c follow (call buf.len c))
    (call emit_path_to_stack l w)
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_rr c 64 (call rsi) (call rsp))
    (call x64.mov_rr c 64 (call rdx) (call r8))
    (call emit_openat2 c (not (get w W.sandbox)))
    (call x64.mov_rr c 64 (call rsp) (call r12))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let failed:i32 (call x64.jcc c (call x64.cc_s)))
    ;; the lowest free WASI descriptor
    (call x64.mov_rr c 64 (call r13) (call rax))
    (call x64.mov_ri32 c (call rcx) (get w W.fd_table))
    (call x64.alu_rr c 32 (call x64.op_xor) (call r14) (call r14))
    (let top:i32 (call buf.len c))
    (call x64.alu_ri c 32 (call x64.op_cmp) (call r14) (call fd_slots))
    (let full:i32 (call x64.jcc c (call x64.cc_ae)))
    (call x64.load c 32 (call rax) (call x64.mem_index (call rcx) (call r14) 4 0))
    (call x64.test_rr c 32 (call rax) (call rax))
    (let found:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.alu_ri c 32 (call x64.op_add) (call r14) 1)
    (call x64.patch_rel32 c (call x64.jmp c) top)
    (call x64.patch_rel32 c found (call buf.len c))
    ;; claim it atomically (threads may open files at once): -1 -> the fd,
    ;; or keep looking if another thread took it first
    (call x64.mov_ri32 c (call rax) -1)
    (call x64.lock c)
    (call x64.cmpxchg c 32 (call x64.mem_index (call rcx) (call r14) 4 0) (call r13))
    (let claimed:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_ri c 32 (call x64.op_add) (call r14) 1)
    (call x64.patch_rel32 c (call x64.jmp c) top)
    (call x64.patch_rel32 c claimed (call buf.len c))
    (call arg c 32 9 8 (call r8))
    (call x64.mov_ri32 c (call r9) 4)
    (call emit_guest_check l w (call r8) (call r9) 4)
    (call x64.store c 32 (call x64.mem_index (call r15) (call r8) 1 0) (call r14))
    (call emit_return_errno c 0)
    ;; no free descriptor: close the file again, EMFILE
    (call x64.patch_rel32 c full (call buf.len c))
    (call x64.mov_rr c 64 (call rdi) (call r13))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (call emit_return_errno c 33)
    (call x64.patch_rel32 c failed (call buf.len c))
    ;; O_DIRECTORY | O_NOFOLLOW on a symbolic link: Linux says ENOTDIR,
    ;; wasmtime, which does not follow the link, ELOOP (32). readlinkat
    ;; succeeds only on a link, so it tells the two apart.
    (let plain:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (call x64.alu_ri c 64 (call x64.op_cmp) (call rax) -20)
    (call (vec.push i32) plain (call x64.jcc c (call x64.cc_ne)))
    (call x64.mov_rr c 32 (call rcx) (call r8))
    (call x64.alu_ri c 32 (call x64.op_and) (call rcx) 196608)
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rcx) 196608)
    (call (vec.push i32) plain (call x64.jcc c (call x64.cc_ne)))
    (call x64.mov_rr c 64 (call r9) (call rax))
    (call emit_path_to_stack l w)
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_rr c 64 (call rsi) (call rsp))
    (call x64.alu_ri c 64 (call x64.op_sub) (call rsp) 16)
    (call x64.mov_rr c 64 (call rdx) (call rsp))
    (call x64.mov_ri32 c (call r10) 1)
    (call x64.mov_ri32 c (call rax) 267)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call rsp) (call r12))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let not_link:i32 (call x64.jcc c (call x64.cc_s)))
    (call emit_return_errno c 32)
    (call x64.patch_rel32 c not_link (call buf.len c))
    (call x64.mov_rr c 64 (call rax) (call r9))
    (call patch_all c plain)
    (call emit_errno_return l w)
    (call patch_all c badf)
    (call emit_return_errno c 8))

  ;; rcx = to if rax = from (for mapping a Linux file type to WASI's).
  (fn map_value [c:(ptr buf.Buf) from:i32 to:i32] -> void
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rax) from)
    (let other:i32 (call x64.jcc c (call x64.cc_ne)))
    (call x64.mov_ri32 c (call rcx) to)
    (call x64.patch_rel32 c other (call buf.len c)))

  ;; rcx = n, or less if fewer bytes are left: min(n, r14 - r12) (n a
  ;; register, or an immediate when reg is -1).
  (fn emit_room [c:(ptr buf.Buf) reg:i32 imm:i32] -> void
    (call x64.mov_rr c 64 (call rcx) (call r14))
    (call x64.alu_rr c 64 (call x64.op_sub) (call rcx) (call r12))
    (if (lt reg 0) (call x64.alu_ri c 64 (call x64.op_cmp) (call rcx) imm) (call x64.alu_rr c 64 (call x64.op_cmp) (call rcx) reg))
    (let fits:i32 (call x64.jcc c (call x64.cc_be)))
    (if (lt reg 0) (call x64.mov_ri32 c (call rcx) imm) (call x64.mov_rr c 64 (call rcx) reg))
    (call x64.patch_rel32 c fits (call buf.len c)))

  ;; fd_readdir(fd, buf, buf_len, cookie:i64, bufused_ptr) -> errno. The
  ;; directory is read from `cookie` (lseek to a d_off getdents64 gave, 0 for
  ;; the start); each Linux dirent becomes a WASI one (d_next = d_off, d_ino,
  ;; d_namlen, d_type), the last cut off when the buffer is full, as WASI
  ;; allows. Registers: rbx the Linux fd, r13/r14 the buffer and its length,
  ;; r12 the bytes used, r8 a batch's length, r10 the offset in it, r11 a
  ;; name's length; rsp+0 the batch (4096 bytes), rsp+4096 a WASI header.
  (fn emit_fd_readdir [l:(ptr lower.L) w:(ptr W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let badf:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (call arg c 32 5 0 (call rbx))
    (call emit_fd_lookup l w (call rbx) (call rbx) badf)
    (call arg c 32 5 1 (call r13))
    (call arg c 32 5 2 (call r14))
    (call emit_guest_check l w (call r13) (call r14) 1)
    (call arg c 32 5 4 (call r9))
    (call x64.mov_ri32 c (call r8) 4)
    (call emit_guest_check l w (call r9) (call r8) 4)
    ;; lseek(fd, cookie, SEEK_SET)
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call arg c 64 5 3 (call rsi))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
    (call x64.mov_ri32 c (call rax) 8)
    (call x64.syscall c)
    (call x64.test_rr c 64 (call rax) (call rax))
    (let seek_failed:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.alu_rr c 32 (call x64.op_xor) (call r12) (call r12))
    (call x64.alu_ri c 64 (call x64.op_sub) (call rsp) 4128)
    ;; a batch: getdents64(fd, rsp, 4096); 0 is the end of the directory
    (let batch:i32 (call buf.len c))
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_rr c 64 (call rsi) (call rsp))
    (call x64.mov_ri32 c (call rdx) 4096)
    (call x64.mov_ri32 c (call rax) 217)
    (call x64.syscall c)
    (call x64.test_rr c 64 (call rax) (call rax))
    (let read_failed:i32 (call x64.jcc c (call x64.cc_s)))
    (let at_end:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.mov_rr c 64 (call r8) (call rax))
    (call x64.alu_rr c 32 (call x64.op_xor) (call r10) (call r10))
    ;; each entry of the batch
    (let entry:i32 (call buf.len c))
    (call x64.alu_rr c 64 (call x64.op_cmp) (call r10) (call r8))
    (call x64.patch_rel32 c (call x64.jcc c (call x64.cc_ae)) batch)
    (call x64.lea c 64 (call rsi) (call x64.mem_index (call rsp) (call r10) 1 19))
    (call emit_strlen c)
    (call x64.mov_rr c 64 (call r11) (call rdx))
    ;; the WASI header: d_next, d_ino, d_namlen, d_type, 3 zero bytes
    (call x64.load c 64 (call rax) (call x64.mem_index (call rsp) (call r10) 1 8))
    (call x64.store c 64 (call x64.mem (call rsp) 4096) (call rax))
    (call x64.load c 64 (call rax) (call x64.mem_index (call rsp) (call r10) 1 0))
    (call x64.store c 64 (call x64.mem (call rsp) 4104) (call rax))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.store c 64 (call x64.mem (call rsp) 4112) (call rax))
    (call x64.store c 32 (call x64.mem (call rsp) 4112) (call r11))
    ;; Linux DT_* to WASI's filetype
    (call x64.load8u c (call rax) (call x64.mem_index (call rsp) (call r10) 1 18))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rcx) (call rcx))
    (call map_value c 4 3) (call map_value c 8 4) (call map_value c 10 7)
    (call map_value c 2 2) (call map_value c 6 1) (call map_value c 12 6)
    (call x64.store8 c (call x64.mem (call rsp) 4116) (call rcx))
    ;; the header, then the name, as much as fits
    (call emit_room c -1 24)
    (call x64.lea c 64 (call rsi) (call x64.mem (call rsp) 4096))
    (call x64.lea c 64 (call rdi) (call x64.mem_index (call r15) (call r13) 1 0))
    (call x64.alu_rr c 64 (call x64.op_add) (call rdi) (call r12))
    (call x64.alu_rr c 64 (call x64.op_add) (call r12) (call rcx))
    (call x64.rep_movsb c)
    (call x64.alu_rr c 64 (call x64.op_cmp) (call r12) (call r14))
    (let full1:i32 (call x64.jcc c (call x64.cc_ae)))
    (call emit_room c (call r11) 0)
    (call x64.lea c 64 (call rsi) (call x64.mem_index (call rsp) (call r10) 1 19))
    (call x64.lea c 64 (call rdi) (call x64.mem_index (call r15) (call r13) 1 0))
    (call x64.alu_rr c 64 (call x64.op_add) (call rdi) (call r12))
    (call x64.alu_rr c 64 (call x64.op_add) (call r12) (call rcx))
    (call x64.rep_movsb c)
    (call x64.alu_rr c 64 (call x64.op_cmp) (call r12) (call r14))
    (let full2:i32 (call x64.jcc c (call x64.cc_ae)))
    ;; the next Linux entry: its reclen, a u16 at 16
    (call x64.load c 32 (call rax) (call x64.mem_index (call rsp) (call r10) 1 16))
    (call x64.alu_ri c 32 (call x64.op_and) (call rax) 65535)
    (call x64.alu_rr c 64 (call x64.op_add) (call r10) (call rax))
    (call x64.patch_rel32 c (call x64.jmp c) entry)
    ;; done: *bufused = r12
    (call x64.patch_rel32 c at_end (call buf.len c))
    (call x64.patch_rel32 c full1 (call buf.len c))
    (call x64.patch_rel32 c full2 (call buf.len c))
    (call x64.alu_ri c 64 (call x64.op_add) (call rsp) 4128)
    (call x64.store c 32 (call x64.mem_index (call r15) (call r9) 1 0) (call r12))
    (call emit_return_errno c 0)
    (call x64.patch_rel32 c read_failed (call buf.len c))
    (call x64.alu_ri c 64 (call x64.op_add) (call rsp) 4128)
    (call x64.patch_rel32 c seek_failed (call buf.len c))
    (call emit_errno_return l w)
    (call patch_all c badf)
    (call emit_return_errno c 8))

  ;; path_filestat_get(dirfd, flags, path, path_len, out) -> errno. The path
  ;; is opened beneath dirfd (O_PATH, following symlinks with
  ;; SYMLINK_FOLLOW), fstatat(fd, "", AT_EMPTY_PATH) reads it, and the Linux
  ;; stat becomes a WASI filestat: dev, ino, filetype, nlink, size, and the
  ;; three times in nanoseconds.
  (fn emit_path_filestat [l:(ptr lower.L) w:(ptr W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let badf:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (call arg c 32 5 0 (call rbx))
    (call emit_fd_lookup l w (call rbx) (call rbx) badf)
    (call arg c 32 5 2 (call r13))
    (call arg c 32 5 3 (call r14))
    (call emit_guest_check l w (call r13) (call r14) 1)
    (call arg c 32 5 4 (call r9))
    (call x64.mov_ri32 c (call r8) 64)
    (call emit_guest_check l w (call r9) (call r8) 8)
    ;; O_PATH | O_CLOEXEC, and O_NOFOLLOW without SYMLINK_FOLLOW (1)
    (call x64.mov_ri32 c (call r8) 2621440)
    (call arg c 32 5 1 (call rax))
    (call x64.test_ri c 32 (call rax) 1)
    (let follow:i32 (call x64.jcc c (call x64.cc_ne)))
    (call x64.alu_ri c 32 (call x64.op_or) (call r8) 131072)
    (call x64.patch_rel32 c follow (call buf.len c))
    (call emit_path_to_stack l w)
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_rr c 64 (call rsi) (call rsp))
    (call x64.mov_rr c 64 (call rdx) (call r8))
    (call emit_openat2 c (not (get w W.sandbox)))
    (call x64.mov_rr c 64 (call rsp) (call r12))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let open_failed:i32 (call x64.jcc c (call x64.cc_s)))
    ;; newfstatat(fd, "", rsp+16, AT_EMPTY_PATH), the "" at rsp; then close
    (call x64.mov_rr c 64 (call r13) (call rax))
    (call x64.alu_ri c 64 (call x64.op_sub) (call rsp) 160)
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.store c 64 (call x64.mem (call rsp) 0) (call rax))
    (call x64.mov_rr c 64 (call rdi) (call r13))
    (call x64.mov_rr c 64 (call rsi) (call rsp))
    (call x64.lea c 64 (call rdx) (call x64.mem (call rsp) 16))
    (call x64.mov_ri32 c (call r10) 4096)
    (call x64.mov_ri32 c (call rax) 262)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call r14) (call rax))
    (call x64.mov_rr c 64 (call rdi) (call r13))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (call x64.test_rr c 64 (call r14) (call r14))
    (let stat_failed:i32 (call x64.jcc c (call x64.cc_s)))
    ;; the WASI filestat at the guest's out
    (call x64.lea c 64 (call rbx) (call x64.mem_index (call r15) (call r9) 1 0))
    (call x64.load c 64 (call rax) (call x64.mem (call rsp) 16))
    (call x64.store c 64 (call x64.mem (call rbx) 0) (call rax))
    (call x64.load c 64 (call rax) (call x64.mem (call rsp) 24))
    (call x64.store c 64 (call x64.mem (call rbx) 8) (call rax))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.store c 64 (call x64.mem (call rbx) 16) (call rax))
    (call x64.load c 32 (call rax) (call x64.mem (call rsp) 40))
    (call x64.alu_ri c 32 (call x64.op_and) (call rax) 61440)
    (call x64.alu_rr c 32 (call x64.op_xor) (call rcx) (call rcx))
    (call map_value c 16384 3) (call map_value c 32768 4) (call map_value c 40960 7)
    (call map_value c 8192 2) (call map_value c 24576 1) (call map_value c 49152 6)
    (call x64.store8 c (call x64.mem (call rbx) 16) (call rcx))
    (call x64.load c 64 (call rax) (call x64.mem (call rsp) 32))
    (call x64.store c 64 (call x64.mem (call rbx) 24) (call rax))
    (call x64.load c 64 (call rax) (call x64.mem (call rsp) 64))
    (call x64.store c 64 (call x64.mem (call rbx) 32) (call rax))
    (call emit_time c 88 40) (call emit_time c 104 48) (call emit_time c 120 56)
    (call x64.alu_ri c 64 (call x64.op_add) (call rsp) 160)
    (call emit_return_errno c 0)
    (call x64.patch_rel32 c stat_failed (call buf.len c))
    (call x64.alu_ri c 64 (call x64.op_add) (call rsp) 160)
    (call x64.mov_rr c 64 (call rax) (call r14))
    (call x64.patch_rel32 c open_failed (call buf.len c))
    (call emit_errno_return l w)
    (call patch_all c badf)
    (call emit_return_errno c 8))

  ;; [rbx + to] = seconds * 1e9 + nanoseconds, from the stat at rsp+16 (the
  ;; seconds at rsp + at, the nanoseconds after them).
  (fn emit_time [c:(ptr buf.Buf) at:i32 to:i32] -> void
    (call x64.load c 64 (call rax) (call x64.mem (call rsp) at))
    (call x64.mov_ri32 c (call rcx) 1000000000)
    (call x64.imul_rr c 64 (call rax) (call rcx))
    (call x64.load c 64 (call rcx) (call x64.mem (call rsp) (+ at 8)))
    (call x64.alu_rr c 64 (call x64.op_add) (call rax) (call rcx))
    (call x64.store c 64 (call x64.mem (call rbx) to) (call rax)))

  ;; r8 |= linux if (reg & wasi) != 0
  (fn map_flag [c:(ptr buf.Buf) reg:i32 wasi:i32 linux:i32] -> void
    (call x64.test_ri c 32 reg wasi)
    (let off:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_ri c 32 (call x64.op_or) (call r8) linux)
    (call x64.patch_rel32 c off (call buf.len c)))

  ;; With the path's copy at rsp (emit_path_to_stack; r14 its length): rsi =
  ;; the directory part (the copy cut at its last '/', or "." when it has
  ;; none) and r13 = the last component, for the calls that cannot resolve a
  ;; path beneath a directory themselves (unlinkat, fchmodat, renameat), whose
  ;; parent is opened that way instead. `tmp` is a scratch register; rax too.
  (fn emit_split_parent [l:(ptr lower.L) tmp:i32] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call x64.mov_rr c 64 tmp (call r14))
    (let top:i32 (call buf.len c))
    (call x64.test_rr c 64 tmp tmp)
    (let no_slash:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_ri c 64 (call x64.op_sub) tmp 1)
    (call x64.load8u c (call rax) (call x64.mem_index (call rsp) tmp 1 0))
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rax) 47)
    (call x64.patch_rel32 c (call x64.jcc c (call x64.cc_ne)) top)
    ;; parent = the copy cut at the slash, base after it
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.store8 c (call x64.mem_index (call rsp) tmp 1 0) (call rax))
    (call x64.mov_rr c 64 (call rsi) (call rsp))
    (call x64.lea c 64 (call r13) (call x64.mem_index (call rsp) tmp 1 1))
    (let have_parent:i32 (call x64.jmp c))
    (call x64.patch_rel32 c no_slash (call buf.len c))
    (call x64.mov_ri32 c (call rsi) (call lower.data_text l "."))
    (call buf.push_byte (get l lower.L.data) 0)
    (call x64.mov_rr c 64 (call r13) (call rsp))
    (call x64.patch_rel32 c have_parent (call buf.len c)))

  ;; path_unlink_file(dirfd, path, path_len) -> errno, and with flags 512
  ;; (AT_REMOVEDIR) path_remove_directory. unlinkat cannot resolve beneath a
  ;; directory, so the parent directory is opened that way (O_PATH) and the
  ;; last component removed inside it.
  (fn emit_path_unlink [l:(ptr lower.L) w:(ptr W) flags:i32] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let badf:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (call arg c 32 3 0 (call rbx))
    (call emit_fd_lookup l w (call rbx) (call rbx) badf)
    (call arg c 32 3 1 (call r13))
    (call arg c 32 3 2 (call r14))
    (call emit_guest_check l w (call r13) (call r14) 1)
    (call emit_path_to_stack l w)
    (call emit_split_parent l (call r9))
    ;; parent fd = openat2(dir, parent, O_PATH | O_DIRECTORY | O_CLOEXEC)
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_ri32 c (call rdx) 2752512)
    (call emit_openat2 c (not (get w W.sandbox)))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let no_parent:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.mov_rr c 64 (call rbx) (call rax))
    ;; unlinkat(parent fd, base, 0), then close the parent
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_rr c 64 (call rsi) (call r13))
    (if (eq flags 0)
        (call x64.alu_rr c 32 (call x64.op_xor) (call rdx) (call rdx))
        (call x64.mov_ri32 c (call rdx) flags))
    (call x64.mov_ri32 c (call rax) 263)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call r13) (call rax))
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call rax) (call r13))
    (call x64.patch_rel32 c no_parent (call buf.len c))
    (call x64.mov_rr c 64 (call rsp) (call r12))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let failed:i32 (call x64.jcc c (call x64.cc_s)))
    (call emit_return_errno c 0)
    (call x64.patch_rel32 c failed (call buf.len c))
    (call emit_errno_return l w)
    (call patch_all c badf)
    (call emit_return_errno c 8))

  ;; path_rename(old_fd, old_path, old_len, new_fd, new_path, new_len) ->
  ;; errno. renameat cannot resolve beneath a directory either, so each
  ;; path's parent is opened that way (O_PATH, as path_unlink_file does) and
  ;; renameat moves the last component between the two. The new path is
  ;; handled first, its parent's descriptor and last component kept in r8
  ;; and r9 while the old path is copied below it; rbx holds the old
  ;; directory until its parent is open.
  (fn emit_path_rename [l:(ptr lower.L) w:(ptr W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let badf:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (call x64.mov_rr c 64 (call r12) (call rsp))
    (call saved_arg c 32 6 0 (call rbx))
    (call emit_fd_lookup l w (call rbx) (call rbx) badf)
    (call saved_arg c 32 6 3 (call r8))
    (call emit_fd_lookup l w (call r8) (call r8) badf)
    (call saved_arg c 32 6 1 (call r13))
    (call saved_arg c 32 6 2 (call r14))
    (call emit_guest_check l w (call r13) (call r14) 1)
    (call saved_arg c 32 6 4 (call r13))
    (call saved_arg c 32 6 5 (call r14))
    (call emit_guest_check l w (call r13) (call r14) 1)
    ;; the new path: its parent's descriptor (r8) and last component (r9)
    (call emit_copy_path l w)
    (call emit_split_parent l (call r9))
    (call x64.mov_rr c 64 (call r9) (call r13))
    (call x64.mov_rr c 64 (call rdi) (call r8))
    (call x64.mov_ri32 c (call rdx) 2752512)
    (call emit_openat2 c (not (get w W.sandbox)))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let new_failed:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.mov_rr c 64 (call r8) (call rax))
    ;; the old path, below it
    (call saved_arg c 32 6 1 (call r13))
    (call saved_arg c 32 6 2 (call r14))
    (call emit_copy_path l w)
    (call emit_split_parent l (call r10))
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_ri32 c (call rdx) 2752512)
    (call emit_openat2 c (not (get w W.sandbox)))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let old_failed:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.mov_rr c 64 (call rbx) (call rax))
    ;; renameat(old parent, old name, new parent, new name), then close both
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_rr c 64 (call rsi) (call r13))
    (call x64.mov_rr c 64 (call rdx) (call r8))
    (call x64.mov_rr c 64 (call r10) (call r9))
    (call x64.mov_ri32 c (call rax) 264)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call r13) (call rax))
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call rdi) (call r8))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call rax) (call r13))
    (let finish:i32 (call x64.jmp c))
    ;; the old parent did not open: close the new one, keeping the error
    (call x64.patch_rel32 c old_failed (call buf.len c))
    (call x64.mov_rr c 64 (call rbx) (call rax))
    (call x64.mov_rr c 64 (call rdi) (call r8))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call rax) (call rbx))
    (call x64.patch_rel32 c finish (call buf.len c))
    (call x64.patch_rel32 c new_failed (call buf.len c))
    (call x64.mov_rr c 64 (call rsp) (call r12))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let failed:i32 (call x64.jcc c (call x64.cc_s)))
    (call emit_return_errno c 0)
    (call x64.patch_rel32 c failed (call buf.len c))
    (call emit_errno_return l w)
    (call patch_all c badf)
    (call emit_return_errno c 8))

  ;; reg = argument i (of n) of a routine whose entry rsp is saved in r12,
  ;; for after rsp has moved (arg reads from rsp itself).
  (fn saved_arg [c:(ptr buf.Buf) sz:i32 n:i32 i:i32 reg:i32] -> void
    (call x64.load c sz reg (call x64.mem (call r12) (+ 8 (* 8 (- (- n 1) i))))))

  ;; With a Linux result (-errno) in rax: returns minus the WASI errno, the
  ;; way aipl_sys_v1's imports report an error.
  (fn emit_negated_errno_return [l:(ptr lower.L) w:(ptr W)] -> void
    (call emit_negated_errno l w)
    (call x64.ret (get l lower.L.code)))

  ;; The cell holding the host address of the environment the process started with.
  (fn env_cell [w:(ptr W)] -> i32 (pub) (get w W.envp_cell))

  ;; With a Linux result (-errno) in rax: leaves minus the WASI errno there.
  ;; Clobbers rcx.
  (fn emit_negated_errno [l:(ptr lower.L) w:(ptr W)] -> void (pub)
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (call x64.mov_rr c 64 (call rcx) (call rax))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.alu_rr c 64 (call x64.op_sub) (call rax) (call rcx))
    (call x64.alu_ri c 64 (call x64.op_cmp) (call rax) 64)
    (let unlisted:i32 (call x64.jcc c (call x64.cc_ae)))
    (call x64.mov_ri32 c (call rcx) (get w W.errno_table))
    (call x64.load8u c (call rax) (call x64.mem_index (call rcx) (call rax) 1 0))
    (let listed:i32 (call x64.jmp c))
    (call x64.patch_rel32 c unlisted (call buf.len c))
    (call x64.mov_ri32 c (call rax) 29)
    (call x64.patch_rel32 c listed (call buf.len c))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rcx) (call rcx))
    (call x64.alu_rr c 64 (call x64.op_sub) (call rcx) (call rax))
    (call x64.mov_rr c 64 (call rax) (call rcx)))

  ;; aipl_sys_v1's chmod(dirfd, path, path_len, mode) -> 0, or minus the WASI
  ;; errno (docs/design/SYS_PLAN.md). A mode with a bit outside 0o777 is
  ;; EINVAL (-28) and a descriptor that is not open is EBADF (-8), as in
  ;; src/sys.rs. The file is opened beneath its directory as path_open opens
  ;; one (so --sandbox confines it as every open is), read-only and without
  ;; blocking, then given its mode by fchmod and closed: a file the program
  ;; cannot open for reading cannot be given a mode this way.
  (fn emit_sys_chmod [l:(ptr lower.L) w:(ptr W)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let badf:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 2))
    (call arg c 32 4 1 (call r13))
    (call arg c 32 4 2 (call r14))
    ;; a path outside the program's memory is EFAULT (-21), a value and not a
    ;; trap, as in src/sys.rs and aipl-run
    (call x64.mov_rr c 64 (call r11) (call r13))
    (call x64.alu_rr c 64 (call x64.op_add) (call r11) (call r14))
    (call lower.load_mem_size l (call r10))
    (call x64.alu_rr c 64 (call x64.op_cmp) (call r11) (call r10))
    (let in_bounds:i32 (call x64.jcc c (call x64.cc_be)))
    (call emit_return_errno c -21)
    (call x64.patch_rel32 c in_bounds (call buf.len c))
    (call arg c 32 4 0 (call rbx))
    (call emit_fd_lookup l w (call rbx) (call rbx) badf)
    (call arg c 32 4 3 (call r8))
    (call x64.test_ri c 32 (call r8) -512)
    (let bad_mode:i32 (call x64.jcc c (call x64.cc_ne)))
    (call emit_path_to_stack l w)
    ;; fd = openat2(dir, path, O_RDONLY | O_NONBLOCK | O_NOCTTY | O_CLOEXEC)
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_rr c 64 (call rsi) (call rsp))
    (call x64.mov_ri32 c (call rdx) 526592)
    (call emit_openat2 c (not (get w W.sandbox)))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let opened:i32 (call x64.jcc c (call x64.cc_ns)))
    (call x64.alu_ri c 64 (call x64.op_cmp) (call rax) -13)
    (let unreadable:i32 (call x64.jcc c (call x64.cc_e)))
    (let open_failed:i32 (call x64.jmp c))
    (call x64.patch_rel32 c opened (call buf.len c))
    ;; fchmod(fd, mode), then close the descriptor
    (call x64.mov_rr c 64 (call rbx) (call rax))
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_rr c 64 (call rsi) (call r8))
    (call x64.mov_ri32 c (call rax) 91)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call r13) (call rax))
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call rax) (call r13))
    (let chmodded:i32 (call x64.jmp c))
    ;; A file the program may not read (mode 0, say) cannot be opened to be
    ;; given a mode, and the program must be able to give it one back. The
    ;; parent directory is opened beneath the directory as path_unlink_file
    ;; does, and fchmodat names the file in it: unless the file is a symbolic
    ;; link, which fchmodat would follow out of the directory unchecked.
    (call x64.patch_rel32 c unreadable (call buf.len c))
    (call emit_split_parent l (call r9))
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_ri32 c (call rdx) 2752512)
    (call emit_openat2 c (not (get w W.sandbox)))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let no_parent:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.mov_rr c 64 (call rbx) (call rax))
    ;; newfstatat(parent, base, &stat, AT_SYMLINK_NOFOLLOW): st_mode is at 24
    (call x64.alu_ri c 64 (call x64.op_sub) (call rsp) 160)
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_rr c 64 (call rsi) (call r13))
    (call x64.mov_rr c 64 (call rdx) (call rsp))
    (call x64.mov_ri32 c (call r10) 256)
    (call x64.mov_ri32 c (call rax) 262)
    (call x64.syscall c)
    (call x64.test_rr c 64 (call rax) (call rax))
    (let stat_failed:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.load c 32 (call rax) (call x64.mem (call rsp) 24))
    (call x64.alu_ri c 32 (call x64.op_and) (call rax) 61440)
    (call x64.alu_ri c 32 (call x64.op_cmp) (call rax) 40960)
    (let is_link:i32 (call x64.jcc c (call x64.cc_e)))
    ;; fchmodat(parent, base, mode)
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_rr c 64 (call rsi) (call r13))
    (call x64.mov_rr c 64 (call rdx) (call r8))
    (call x64.mov_ri32 c (call rax) 268)
    (call x64.syscall c)
    (let done:i32 (call x64.jmp c))
    (call x64.patch_rel32 c is_link (call buf.len c))
    (call x64.mov_ri32 c (call rax) -13)
    (call x64.patch_rel32 c stat_failed (call buf.len c))
    (call x64.patch_rel32 c done (call buf.len c))
    ;; close the parent, keeping the result
    (call x64.mov_rr c 64 (call r14) (call rax))
    (call x64.mov_rr c 64 (call rdi) (call rbx))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (call x64.mov_rr c 64 (call rax) (call r14))
    (call x64.patch_rel32 c no_parent (call buf.len c))
    (call x64.patch_rel32 c open_failed (call buf.len c))
    (call x64.patch_rel32 c chmodded (call buf.len c))
    (call x64.mov_rr c 64 (call rsp) (call r12))
    (call x64.test_rr c 64 (call rax) (call rax))
    (let failed:i32 (call x64.jcc c (call x64.cc_s)))
    (call emit_return_errno c 0)
    (call x64.patch_rel32 c failed (call buf.len c))
    (call emit_negated_errno_return l w)
    (call patch_all c badf)
    (call emit_return_errno c -8)
    (call x64.patch_rel32 c bad_mode (call buf.len c))
    (call emit_return_errno c -28))

  ;; Start-up: opens the preopened directories, fd 3 = "." and fd 4 = "/"
  ;; (skipped with sandbox), as O_PATH directory descriptors.
  (fn emit_preopens [l:(ptr lower.L) w:(ptr W) sandbox:bool] -> void (pub)
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (when sandbox (call emit_openat2_probe l))
    (call emit_preopen l w 3 ".")
    (when (not sandbox) (call emit_preopen l w 4 "/")))

  ;; A --sandbox program confines every open with openat2, so one that cannot
  ;; (the kernel is older than 5.6, or Rosetta 2, or a seccomp profile refuses
  ;; it) stops at start with a message, not at its first file with an error
  ;; that does not say why.
  (fn emit_openat2_probe [l:(ptr lower.L)] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let here:i32 (call lower.data_text l "."))
    (call buf.push_byte (get l lower.L.data) 0)
    (let said:str "this program was built with --sandbox, which needs the openat2 system call (Linux 5.6 or newer, and not Rosetta 2)\n")
    (let msg:i32 (call lower.data_text l said))
    ;; openat2(AT_FDCWD, ".", { O_PATH | O_DIRECTORY | O_CLOEXEC, 0, 0 }, 24)
    (call x64.alu_ri c 64 (call x64.op_sub) (call rsp) 32)
    (call x64.mov_ri32 c (call rax) 2752512)
    (call x64.store c 64 (call x64.mem (call rsp) 0) (call rax))
    (call x64.alu_rr c 32 (call x64.op_xor) (call rax) (call rax))
    (call x64.store c 64 (call x64.mem (call rsp) 8) (call rax))
    (call x64.store c 64 (call x64.mem (call rsp) 16) (call rax))
    (call x64.mov_ri32 c (call rdi) -100)
    (call x64.mov_ri32 c (call rsi) here)
    (call x64.mov_rr c 64 (call rdx) (call rsp))
    (call x64.mov_ri32 c (call r10) 24)
    (call x64.mov_ri32 c (call rax) 437)
    (call x64.syscall c)
    (call x64.alu_ri c 64 (call x64.op_add) (call rsp) 32)
    (call x64.alu_ri c 64 (call x64.op_cmp) (call rax) -38)
    (let enosys:i32 (call x64.jcc c (call x64.cc_e)))
    (call x64.alu_ri c 64 (call x64.op_cmp) (call rax) -1)
    (let eperm:i32 (call x64.jcc c (call x64.cc_e)))
    ;; supported: close the probe's descriptor, if it opened one
    (call x64.test_rr c 64 (call rax) (call rax))
    (let other_error:i32 (call x64.jcc c (call x64.cc_s)))
    (call x64.mov_rr c 64 (call rdi) (call rax))
    (call x64.mov_ri32 c (call rax) 3)
    (call x64.syscall c)
    (let supported:i32 (call x64.jmp c))
    ;; unsupported: write(2, msg), exit_group(1)
    (call x64.patch_rel32 c enosys (call buf.len c))
    (call x64.patch_rel32 c eperm (call buf.len c))
    (call x64.mov_ri32 c (call rax) 1)
    (call x64.mov_ri32 c (call rdi) 2)
    (call x64.mov_ri32 c (call rsi) msg)
    (call x64.mov_ri32 c (call rdx) (str.len said))
    (call x64.syscall c)
    (call x64.mov_ri32 c (call rax) 231)
    (call x64.mov_ri32 c (call rdi) 1)
    (call x64.syscall c)
    (call x64.patch_rel32 c other_error (call buf.len c))
    (call x64.patch_rel32 c supported (call buf.len c)))

  (fn emit_preopen [l:(ptr lower.L) w:(ptr W) fd:i32 path:str] -> void
    (let c:(ptr buf.Buf) (get l lower.L.code))
    (let at:i32 (call lower.data_text l path))
    (call buf.push_byte (get l lower.L.data) 0)
    ;; openat(AT_FDCWD, path, O_PATH | O_DIRECTORY | O_CLOEXEC)
    (call x64.mov_ri32 c (call rdi) -100)
    (call x64.mov_ri32 c (call rsi) at)
    (call x64.mov_ri32 c (call rdx) 2752512)
    (call x64.mov_ri32 c (call rax) 257)
    (call x64.syscall c)
    ;; a failure leaves the slot closed (-1); errors are negative anyway
    (call x64.mov_ri32 c (call rcx) (+ (get w W.fd_table) (* 4 fd)))
    (call x64.store c 32 (call x64.mem (call rcx) 0) (call rax)))

  ;; Emits the routine for import `name`; false if it is not one of these.
  (fn emit_import [l:(ptr lower.L) w:(ptr W) name:str.Bytes] -> bool (pub)
    (cond
      ((call is name "fd_write") (call emit_fd_rw l w false) true)
      ((call is name "fd_read") (call emit_fd_rw l w true) true)
      ((call is name "fd_close") (call emit_fd_close l w) true)
      ((call is name "args_sizes_get") (call emit_strings_sizes l w (get w W.argc_cell) (get w W.argv_cell)) true)
      ((call is name "args_get") (call emit_strings_get l w (get w W.argc_cell) (get w W.argv_cell)) true)
      ((call is name "environ_sizes_get") (call emit_strings_sizes l w (get w W.envc_cell) (get w W.envp_cell)) true)
      ((call is name "environ_get") (call emit_strings_get l w (get w W.envc_cell) (get w W.envp_cell)) true)
      ((call is name "clock_time_get") (call emit_clock_time_get l w) true)
      ((call is name "random_get") (call emit_random_get l w) true)
      ((call is name "path_open") (call emit_path_open l w) true)
      ((call is name "path_unlink_file") (call emit_path_unlink l w 0) true)
      ((call is name "path_remove_directory") (call emit_path_unlink l w 512) true)
      ((call is name "path_rename") (call emit_path_rename l w) true)
      ((call is name "fd_readdir") (call emit_fd_readdir l w) true)
      ((call is name "path_filestat_get") (call emit_path_filestat l w) true)
      (else false)))

  ;; Emits the routine for the aipl_sys_v1 import `name`; false if it is not
  ;; one of these.
  (fn emit_sys_import [l:(ptr lower.L) w:(ptr W) name:str.Bytes] -> bool (pub)
    (cond
      ((call is name "chmod") (call emit_sys_chmod l w) true)
      (else false)))

  (fn is [name:str.Bytes want:str] -> bool
    (call str.bytes_eq name (call str.from_str want)))
)
