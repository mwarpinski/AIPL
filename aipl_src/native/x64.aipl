;; x64: an x86-64 machine-code encoder (native backend task NE3,
;; docs/design/NATIVE_BACKEND_PLAN.md). One function per instruction form the
;; lowering needs, each appending its bytes to a code buffer (std/buf).
;;
;; Registers are numbered as the hardware numbers them:
;;   0 rax  1 rcx  2 rdx  3 rbx  4 rsp  5 rbp  6 rsi  7 rdi
;;   8 r8   9 r9  10 r10 11 r11 12 r12 13 r13 14 r14 15 r15
;; `sz` is the operand size in bits, 32 or 64. A 32-bit write clears the
;; register's upper half (hardware behaviour). Operand order is Intel's:
;; destination first. Memory operands are `Mem` records (see `mem`).
;;
;; Jumps and calls to labels use 32-bit relative displacements: the emitting
;; function returns the buffer position of the displacement, and
;; `patch_rel32` fills it in once the target is known.
;;
;;   (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 256))
;;   (call x64.mov_rr c 64 0 7)          ;; mov rax, rdi
;;   (call x64.alu_ri c 32 (call x64.op_add) 0 1)  ;; add eax, 1
;;   (call x64.ret c)
(module x64
  (import alloc) (import str)
  (import buf)

  ;; [base + index * scale + disp]. index -1 = no index. base is required
  ;; (no absolute or rip-relative forms).
  (struct Mem [base:i32 index:i32 scale:i32 disp:i32])

  ;; ===== Operands =====

  (fn mem [base:i32 disp:i32] -> (ptr Mem)
    (req (and (gte base 0) (lte base 15)))
    (let m:(ptr Mem) (new Mem))
    (put m Mem.base base)
    (put m Mem.index -1)
    (put m Mem.scale 1)
    (put m Mem.disp disp)
    m)

  ;; rsp (4) cannot be an index; scale is 1, 2, 4 or 8.
  (fn mem_index [base:i32 index:i32 scale:i32 disp:i32] -> (ptr Mem)
    (req (and (gte base 0) (lte base 15)))
    (req (and (and (gte index 0) (lte index 15)) (neq index 4)))
    (req (or (eq scale 1) (or (eq scale 2) (or (eq scale 4) (eq scale 8)))))
    (let m:(ptr Mem) (new Mem))
    (put m Mem.base base)
    (put m Mem.index index)
    (put m Mem.scale scale)
    (put m Mem.disp disp)
    m)

  ;; Condition codes for jcc and setcc (the low nibble of their opcodes).
  ;; Unsigned: b ae be a. Signed: l ge le g.
  (fn cc_o [] -> i32 0)   (fn cc_no [] -> i32 1)
  (fn cc_b [] -> i32 2)   (fn cc_ae [] -> i32 3)
  (fn cc_e [] -> i32 4)   (fn cc_ne [] -> i32 5)
  (fn cc_be [] -> i32 6)  (fn cc_a [] -> i32 7)
  (fn cc_s [] -> i32 8)   (fn cc_ns [] -> i32 9)
  (fn cc_p [] -> i32 10)  (fn cc_np [] -> i32 11)
  (fn cc_l [] -> i32 12)  (fn cc_ge [] -> i32 13)
  (fn cc_le [] -> i32 14) (fn cc_g [] -> i32 15)

  ;; ALU operation numbers for alu_rr / alu_ri (the ModRM /digit of the
  ;; immediate forms).
  (fn op_add [] -> i32 0)
  (fn op_or [] -> i32 1)
  (fn op_and [] -> i32 4)
  (fn op_sub [] -> i32 5)
  (fn op_xor [] -> i32 6)
  (fn op_cmp [] -> i32 7)

  ;; ===== Bytes =====

  (fn byte [c:(ptr buf.Buf) v:i32] -> void
    (call buf.push_byte c (bitand v 255)))

  (fn u32 [c:(ptr buf.Buf) v:i32] -> void
    (call byte c v)
    (call byte c (shru v 8))
    (call byte c (shru v 16))
    (call byte c (shru v 24)))

  (fn u64 [c:(ptr buf.Buf) v:i64] -> void
    (call u32 c (i32.wrap v))
    (call u32 c (i32.wrap (shru v 32i64))))

  (fn fits8 [v:i32] -> bool (and (gte v -128) (lte v 127)))

  (fn reg_ok [r:i32] -> bool (and (gte r 0) (lte r 15)))
  (fn size_ok [sz:i32] -> bool (or (eq sz 32) (eq sz 64)))
  (fn alu_ok [op:i32] -> bool (or (lte op 1) (and (gte op 4) (lte op 7))))

  ;; REX prefix: W (64-bit operand), R (ModRM.reg high bit), X (SIB.index
  ;; high bit), B (ModRM.rm / SIB.base / opcode register high bit). Emitted
  ;; when any bit is set, or when `force` (byte access to spl bpl sil dil).
  (fn rex [c:(ptr buf.Buf) w:bool r:i32 x:i32 b:i32 force:bool] -> void
    (let v:i32 (bitor (if w 8 0) (bitor (shl (bitand (shr r 3) 1) 2) (bitor (shl (bitand (shr x 3) 1) 1) (bitand (shr b 3) 1)))))
    (if (or (neq v 0) force) (call byte c (bitor 64 v)) (block)))

  ;; One- or two-byte opcode: values above 255 are 0x0F-prefixed (0x0FAF).
  (fn opcode [c:(ptr buf.Buf) op:i32] -> void
    (if (gt op 255) (call byte c 15) (block))
    (call byte c op))

  ;; op with ModRM register-direct: reg field `reg` (a register or /digit),
  ;; rm = register `rm`. `byte_regs`: the operands are 8-bit registers.
  (fn rr [c:(ptr buf.Buf) sz:i32 op:i32 reg:i32 rm:i32 byte_regs:bool] -> void
    (let force:bool (and byte_regs (or (and (gte reg 4) (lte reg 7)) (and (gte rm 4) (lte rm 7)))))
    (call rex c (eq sz 64) reg 0 rm force)
    (call opcode c op)
    (call byte c (bitor 192 (bitor (shl (bitand reg 7) 3) (bitand rm 7)))))

  ;; op with a memory operand. Picks the shortest displacement (none, 8-bit,
  ;; 32-bit); rbp/r13 bases always carry one, rsp/r12 bases need a SIB byte.
  (fn rm [c:(ptr buf.Buf) sz:i32 op:i32 reg:i32 m:(ptr Mem) byte_regs:bool] -> void
    (let base:i32 (get m Mem.base))
    (let index:i32 (get m Mem.index))
    (let disp:i32 (get m Mem.disp))
    (let force:bool (and byte_regs (and (gte reg 4) (lte reg 7))))
    (call rex c (eq sz 64) reg (if (lt index 0) 0 index) base force)
    (call opcode c op)
    (let md:i32 (cond ((and (eq disp 0) (neq (bitand base 7) 5)) 0)
                      ((call fits8 disp) 1)
                      (else 2)))
    (let r3:i32 (shl (bitand reg 7) 3))
    (cond
      ((gte index 0)
       (call byte c (bitor (shl md 6) (bitor r3 4)))
       (let ss:i32 (cond ((eq (get m Mem.scale) 1) 0) ((eq (get m Mem.scale) 2) 1) ((eq (get m Mem.scale) 4) 2) (else 3)))
       (call byte c (bitor (shl ss 6) (bitor (shl (bitand index 7) 3) (bitand base 7)))))
      ((eq (bitand base 7) 4)
       (call byte c (bitor (shl md 6) (bitor r3 4)))
       (call byte c 36)) ;; SIB: no index, base rsp/r12
      (else (call byte c (bitor (shl md 6) (bitor r3 (bitand base 7))))))
    (cond ((eq md 1) (call byte c disp))
          ((eq md 2) (call u32 c disp))
          (else (block))))

  ;; ===== Moves =====

  ;; mov dst, src
  (fn mov_rr [c:(ptr buf.Buf) sz:i32 dst:i32 src:i32] -> void
    (req (and (call size_ok sz) (and (call reg_ok dst) (call reg_ok src))))
    (call rr c sz 137 src dst false))

  ;; mov dst32, imm32 (clears the upper half)
  (fn mov_ri32 [c:(ptr buf.Buf) dst:i32 imm:i32] -> void
    (req (call reg_ok dst))
    (call rex c false 0 0 dst false)
    (call byte c (+ 184 (bitand dst 7)))
    (call u32 c imm))

  ;; mov dst64, imm64: the sign-extended 32-bit form when it fits, else movabs
  (fn mov_ri64 [c:(ptr buf.Buf) dst:i32 imm:i64] -> void
    (req (call reg_ok dst))
    (if (and (gte imm -2147483648i64) (lte imm 2147483647i64))
        (block
          (call rr c 64 199 0 dst false)
          (call u32 c (i32.wrap imm)))
        (block
          (call rex c true 0 0 dst false)
          (call byte c (+ 184 (bitand dst 7)))
          (call u64 c imm))))

  ;; mov dst, [m]
  (fn load [c:(ptr buf.Buf) sz:i32 dst:i32 m:(ptr Mem)] -> void
    (req (and (call size_ok sz) (call reg_ok dst)))
    (call rm c sz 139 dst m false))

  ;; mov [m], src
  (fn store [c:(ptr buf.Buf) sz:i32 m:(ptr Mem) src:i32] -> void
    (req (and (call size_ok sz) (call reg_ok src)))
    (call rm c sz 137 src m false))

  ;; mov byte [m], src8 (the low byte of src)
  (fn store8 [c:(ptr buf.Buf) m:(ptr Mem) src:i32] -> void
    (req (call reg_ok src))
    (call rm c 32 136 src m true))

  ;; movzx dst32, byte [m]
  (fn load8u [c:(ptr buf.Buf) dst:i32 m:(ptr Mem)] -> void
    (req (call reg_ok dst))
    (call rm c 32 4022 dst m false))

  ;; movzx dst32, src8 (the low byte of src)
  (fn movzx8 [c:(ptr buf.Buf) dst:i32 src:i32] -> void
    (req (and (call reg_ok dst) (call reg_ok src)))
    (call rr c 32 4022 dst src true))

  ;; movsxd dst64, src32 (sign-extend)
  (fn movsxd [c:(ptr buf.Buf) dst:i32 src:i32] -> void
    (req (and (call reg_ok dst) (call reg_ok src)))
    (call rr c 64 99 dst src false))

  ;; lea dst, [m]
  (fn lea [c:(ptr buf.Buf) sz:i32 dst:i32 m:(ptr Mem)] -> void
    (req (and (call size_ok sz) (call reg_ok dst)))
    (call rm c sz 141 dst m false))

  (fn push [c:(ptr buf.Buf) r:i32] -> void
    (req (call reg_ok r))
    (call rex c false 0 0 r false)
    (call byte c (+ 80 (bitand r 7))))

  (fn pop [c:(ptr buf.Buf) r:i32] -> void
    (req (call reg_ok r))
    (call rex c false 0 0 r false)
    (call byte c (+ 88 (bitand r 7))))

  ;; ===== Arithmetic =====

  ;; add/or/and/sub/xor/cmp dst, src (op from op_add .. op_cmp)
  (fn alu_rr [c:(ptr buf.Buf) sz:i32 op:i32 dst:i32 src:i32] -> void
    (req (and (call size_ok sz) (and (call alu_ok op) (and (call reg_ok dst) (call reg_ok src)))))
    (call rr c sz (+ (* op 8) 1) src dst false))

  ;; add/or/and/sub/xor/cmp dst, imm (sign-extended to 64 bits when sz = 64).
  ;; 8-bit immediates when they fit; the short eax/rax form otherwise.
  (fn alu_ri [c:(ptr buf.Buf) sz:i32 op:i32 dst:i32 imm:i32] -> void
    (req (and (call size_ok sz) (and (call alu_ok op) (call reg_ok dst))))
    (cond
      ((call fits8 imm) (call rr c sz 131 op dst false) (call byte c imm))
      ((eq dst 0) (call rex c (eq sz 64) 0 0 0 false) (call byte c (+ (* op 8) 5)) (call u32 c imm))
      (else (call rr c sz 129 op dst false) (call u32 c imm))))

  ;; test a, b (flags from a AND b)
  (fn test_rr [c:(ptr buf.Buf) sz:i32 a:i32 b:i32] -> void
    (req (and (call size_ok sz) (and (call reg_ok a) (call reg_ok b))))
    (call rr c sz 133 b a false))

  ;; test r, imm32 (short eax/rax form for register 0)
  (fn test_ri [c:(ptr buf.Buf) sz:i32 r:i32 imm:i32] -> void
    (req (and (call size_ok sz) (call reg_ok r)))
    (if (eq r 0)
        (block (call rex c (eq sz 64) 0 0 0 false) (call byte c 169))
        (call rr c sz 247 0 r false))
    (call u32 c imm))

  ;; Shift kinds for shift_ri / shift_cl.
  (fn sh_shl [] -> i32 4)
  (fn sh_shr [] -> i32 5)
  (fn sh_sar [] -> i32 7)

  ;; shl/shr/sar r, imm (the one-byte form for a count of 1)
  (fn shift_ri [c:(ptr buf.Buf) sz:i32 kind:i32 r:i32 count:i32] -> void
    (req (and (call size_ok sz) (call reg_ok r)))
    (req (or (eq kind 4) (or (eq kind 5) (eq kind 7))))
    (req (and (gte count 0) (lt count sz)))
    (if (eq count 1)
        (call rr c sz 209 kind r false)
        (block (call rr c sz 193 kind r false) (call byte c count))))

  ;; shl/shr/sar r, cl
  (fn shift_cl [c:(ptr buf.Buf) sz:i32 kind:i32 r:i32] -> void
    (req (and (call size_ok sz) (call reg_ok r)))
    (req (or (eq kind 4) (or (eq kind 5) (eq kind 7))))
    (call rr c sz 211 kind r false))

  ;; imul dst, src
  (fn imul_rr [c:(ptr buf.Buf) sz:i32 dst:i32 src:i32] -> void
    (req (and (call size_ok sz) (and (call reg_ok dst) (call reg_ok src))))
    (call rr c sz 4015 dst src false))

  ;; div src: unsigned edx:eax / src (rdx:rax for 64); quotient in eax, remainder in edx
  (fn div_r [c:(ptr buf.Buf) sz:i32 src:i32] -> void
    (req (and (call size_ok sz) (call reg_ok src)))
    (call rr c sz 247 6 src false))

  ;; idiv src: the signed form of div_r
  (fn idiv_r [c:(ptr buf.Buf) sz:i32 src:i32] -> void
    (req (and (call size_ok sz) (call reg_ok src)))
    (call rr c sz 247 7 src false))

  ;; cdq: sign-extend eax into edx (before a 32-bit idiv)
  (fn cdq [c:(ptr buf.Buf)] -> void (call byte c 153))

  ;; cqo: sign-extend rax into rdx (before a 64-bit idiv)
  (fn cqo [c:(ptr buf.Buf)] -> void (call byte c 72) (call byte c 153))

  ;; setcc dst8: the low byte of dst = 1 if the condition holds, else 0
  (fn setcc [c:(ptr buf.Buf) cc:i32 dst:i32] -> void
    (req (and (and (gte cc 0) (lte cc 15)) (call reg_ok dst)))
    (call rr c 32 (+ 3984 cc) 0 dst true))

  ;; ===== Atomics (memory operand; put `lock` first) =====

  (fn lock [c:(ptr buf.Buf)] -> void (call byte c 240))

  ;; xadd [m], src: src = old [m], [m] = old + src
  (fn xadd [c:(ptr buf.Buf) sz:i32 m:(ptr Mem) src:i32] -> void
    (req (and (call size_ok sz) (call reg_ok src)))
    (call rm c sz 4033 src m false))

  ;; xchg [m], src (always locked by the hardware)
  (fn xchg [c:(ptr buf.Buf) sz:i32 m:(ptr Mem) src:i32] -> void
    (req (and (call size_ok sz) (call reg_ok src)))
    (call rm c sz 135 src m false))

  ;; cmpxchg [m], src: if [m] = eax then [m] = src, else eax = [m]
  (fn cmpxchg [c:(ptr buf.Buf) sz:i32 m:(ptr Mem) src:i32] -> void
    (req (and (call size_ok sz) (call reg_ok src)))
    (call rm c sz 4017 src m false))

  ;; ===== Control =====

  ;; jmp rel32 with a zero displacement; returns the displacement's position
  (fn jmp [c:(ptr buf.Buf)] -> i32
    (call byte c 233)
    (let at:i32 (call buf.len c))
    (call u32 c 0)
    at)

  ;; jcc rel32 (cc from cc_o .. cc_g); returns the displacement's position
  (fn jcc [c:(ptr buf.Buf) cc:i32] -> i32
    (req (and (gte cc 0) (lte cc 15)))
    (call byte c 15)
    (call byte c (+ 128 cc))
    (let at:i32 (call buf.len c))
    (call u32 c 0)
    at)

  ;; call rel32; returns the displacement's position
  (fn call_rel [c:(ptr buf.Buf)] -> i32
    (call byte c 232)
    (let at:i32 (call buf.len c))
    (call u32 c 0)
    at)

  ;; Points the displacement at `at` (from jmp, jcc or call_rel) to buffer
  ;; position `target`, forward or backward.
  (fn patch_rel32 [c:(ptr buf.Buf) at:i32 target:i32] -> void
    (req (and (gte at 0) (lte (+ at 4) (call buf.len c))))
    (unsafe (let rel:i32 (- target (+ at 4)))
    (let p:i32 (+ (get c buf.Buf.data) at))
    (loop k 0 3 1
      (mem.store8 (+ p k) (bitand (shru rel (* 8 k)) 255)))))

  ;; call r (indirect)
  (fn call_r [c:(ptr buf.Buf) r:i32] -> void
    (req (call reg_ok r))
    (call rr c 32 255 2 r false))

  (fn ret [c:(ptr buf.Buf)] -> void (call byte c 195))
  (fn syscall [c:(ptr buf.Buf)] -> void (call byte c 15) (call byte c 5))
  (fn ud2 [c:(ptr buf.Buf)] -> void (call byte c 15) (call byte c 11))

  ;; ===== Self-tests =====

  ;; The buffer as lowercase hex, two digits per byte, no separators.
  (fn hex [c:(ptr buf.Buf)] -> (ptr str.Bytes)
    (unsafe (let out:(ptr buf.Buf) (call buf.make (call alloc.default) (+ 2 (* 2 (call buf.len c)))))
    (loop i 0 (- (call buf.len c) 1) 1
      (let v:i32 (mem.load8 (+ (get c buf.Buf.data) i)))
      (call buf.push_byte out (call hex_digit (shru v 4)))
      (call buf.push_byte out (call hex_digit (bitand v 15))))
    (call buf.bytes out)))

  (fn hex_digit [d:i32] -> i32 (if (lt d 10) (+ 48 d) (+ 87 d)))

  ;; 1 if the buffer holds exactly `expected` (hex), else prints both and 0.
  (fn check [name:str c:(ptr buf.Buf) expected:str] -> i32
    (unsafe (let got:(ptr str.Bytes) (call hex c))
    (if (call str.bytes_eq got (call str.from_str expected))
        1
        (block
          (sys.print "x64 test failed:" name "got:")
          (call buf.clear c)
          (call buf.push_bytes c got)
          (call buf.push_byte c 10)
          (call buf.push_str c "want:")
          (call buf.push_byte c 10)
          (call buf.push_str c expected)
          (call buf.push_byte c 10)
          (fs.write 1 (get c buf.Buf.data) (call buf.len c))
          0))))

  ;; X64_TESTS_BEGIN
  ;; Test vectors are GNU as (binutils) output for the same instruction
  ;; sequences in Intel syntax, pasted in as hex; they are never produced by
  ;; this encoder (python3 tools/x64_vectors.py regenerates them). Each loop covers every register in both halves of the
  ;; register file. p(r) = (7r + 3) mod 16 pairs each register with a
  ;; different one, so every register also appears in the other operand.
  (fn p [r:i32] -> i32 (bitand (+ (* r 7) 3) 15))
  ;; an index register for base b (never rsp) and a scale
  (fn ix [b:i32] -> i32 (let i:i32 (bitand (+ (* b 3) 1) 15)) (if (eq i 4) 9 i))
  (fn sc [b:i32] -> i32 (shl 1 (bitand b 3)))

  (fn test_moves [] -> i32
    (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 1024))
    (loop r 0 15 1
      (call mov_rr c 64 r (call p r))
      (call mov_rr c 32 r (call p r))
      (call mov_ri32 c r -5)
      (call mov_ri64 c r -5i64)
      (call mov_ri64 c r 4886718345i64)
      (call movsxd c r (call p r))
      (call movzx8 c r (call p r))
      (call push c r)
      (call pop c r)
      (call call_r c r)
      (call mov_ri64 c r 2147483647i64)
      (call mov_ri64 c r -2147483648i64)
      (call mov_ri64 c r 2147483648i64)
      (call mov_ri64 c r -2147483649i64))
    (call check "moves" c ""))

  (fn test_alu [] -> i32
    (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 4096))
    (loop k 0 5 1
      (let op:i32 (cond ((eq k 0) (call op_add)) ((eq k 1) (call op_or)) ((eq k 2) (call op_and))
                        ((eq k 3) (call op_sub)) ((eq k 4) (call op_xor)) (else (call op_cmp))))
      (loop r 0 15 1
        (call alu_rr c 32 op r (call p r))
        (call alu_rr c 64 op (call p r) r)
        (call alu_ri c 32 op r 5)
        (call alu_ri c 64 op r -100)
        (call alu_ri c 32 op r 1000)
        (call alu_ri c 64 op r -70000)
        (call alu_ri c 32 op r 127)
        (call alu_ri c 64 op r -128)
        (call alu_ri c 32 op r 128)
        (call alu_ri c 64 op r -129)))
    (loop r 0 15 1
      (call test_rr c 32 r (call p r))
      (call test_rr c 64 r (call p r))
      (call test_ri c 32 r 255)
      (call test_ri c 64 r 65536))
    (call check "alu" c ""))

  (fn test_muldiv [] -> i32
    (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 2048))
    (loop r 0 15 1
      (loop k 0 2 1
        (let kind:i32 (cond ((eq k 0) (call sh_shl)) ((eq k 1) (call sh_shr)) (else (call sh_sar))))
        (call shift_ri c 32 kind r 1)
        (call shift_ri c 64 kind r 5)
        (call shift_ri c 32 kind r 31)
        (call shift_ri c 64 kind r 63)
        (call shift_cl c 64 kind r)
        (call shift_cl c 32 kind r))
      (call imul_rr c 32 r (call p r))
      (call imul_rr c 64 r (call p r))
      (call div_r c 32 r)
      (call div_r c 64 r)
      (call idiv_r c 32 r)
      (call idiv_r c 64 r)
      (call cdq c)
      (call cqo c)
      (call setcc c r r)
      (call setcc c (bitand (+ r 5) 15) (call p r)))
    (call check "muldiv" c ""))

  (fn test_memory [] -> i32
    (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 2048))
    (loop b 0 15 1
      (let r:i32 (call p b))
      (call load c 32 r (call mem b 0))
      (call load c 64 r (call mem b 8))
      (call store c 32 (call mem b -200) r)
      (call store c 64 (call mem b 100000) r)
      (call store8 c (call mem b 1) r)
      (call load8u c r (call mem b -1))
      (call lea c 64 r (call mem b 16))
      (call load c 64 r (call mem_index b (call ix b) (call sc b) 0))
      (call store c 32 (call mem_index b (call ix b) (call sc b) -8) r)
      (call lea c 32 r (call mem_index b (call ix b) (call sc b) 1024))
      (call store8 c (call mem_index b (call ix b) (call sc b) 127) r)
      (call load8u c r (call mem_index b (call ix b) (call sc b) 128)))
    (call check "memory" c ""))

  (fn test_atomics [] -> i32
    (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 1024))
    (loop b 0 15 1
      (let r:i32 (call p b))
      (call lock c) (call xadd c 32 (call mem b 0) r)
      (call lock c) (call xadd c 64 (call mem_index b (call ix b) (call sc b) 8) r)
      (call xchg c 32 (call mem_index b (call ix b) (call sc b) 4) r)
      (call xchg c 64 (call mem b 0) r)
      (call lock c) (call cmpxchg c 32 (call mem b -4) r)
      (call lock c) (call cmpxchg c 64 (call mem_index b (call ix b) (call sc b) 0) r))
    (call check "atomics" c ""))

  ;; forward jumps patched once the label is known, backward ones at once
  (fn test_control [] -> i32
    (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 256))
    (let j:i32 (call jmp c))
    (let je:i32 (call jcc c (call cc_e)))
    (call patch_rel32 c (call call_rel c) 0)
    (call ud2 c)
    (call patch_rel32 c j (call buf.len c))
    (call patch_rel32 c je (call buf.len c))
    (call ret c)
    (call syscall c)
    (loop k 0 15 1 (call patch_rel32 c (call jcc c k) 0))
    (call patch_rel32 c (call jmp c) 0)
    (call check "control" c "e90d0000000f8407000000e8f0ffffff0f0bc30f050f80e5ffffff0f81dfffffff0f82d9ffffff0f83d3ffffff0f84cdffffff0f85c7ffffff0f86c1ffffff0f87bbffffff0f88b5ffffff0f89afffffff0f8aa9ffffff0f8ba3ffffff0f8c9dffffff0f8d97ffffff0f8e91ffffff0f8f8bffffffe986ffffff"))

  ;; Pass count; test_suite.aipl expects 9.
  (fn run_x64_tests [] -> i32
    (+ (call test_moves) (+ (call test_alu) (+ (call test_muldiv) (+ (call test_memory) (+ (call test_atomics) (+ (call test_control) (+ (call test_strings) (+ (call test_sse) (call test_tls))))))))))
  ;; X64_TESTS_END

  ;; ===== Forms added after NE3 =====
  ;; (Kept below the tests so the test vectors above stay where they are.)

  ;; rep movsb: copies rcx bytes from [rsi] to [rdi] (NE8: data segments)
  (fn rep_movsb [c:(ptr buf.Buf)] -> void (call byte c 243) (call byte c 164))

  (fn test_strings [] -> i32
    (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 16))
    (call rep_movsb c)
    (call check "strings" c "f3a4"))

  ;; ===== SSE2 (NE13): floats in xmm registers 0-15 =====

  ;; One SSE2 instruction, register to register: an optional mandatory
  ;; prefix (0x66, 0xF2, 0xF3; 0 for none), then REX (W for 64-bit integer
  ;; operands), 0x0F, op, and ModRM with `reg` and `rm`.
  (fn sse [c:(ptr buf.Buf) prefix:i32 wide:bool op:i32 reg:i32 rm:i32] -> void
    (req (and (call reg_ok reg) (call reg_ok rm)))
    (if (neq prefix 0) (call byte c prefix) (block))
    (call rex c wide reg 0 rm false)
    (call byte c 15)
    (call byte c op)
    (call byte c (bitor 192 (bitor (shl (bitand reg 7) 3) (bitand rm 7)))))

  ;; movq xmm, r64 / movq r64, xmm: a double's bits between the registers
  (fn movq_xr [c:(ptr buf.Buf) xmm:i32 r:i32] -> void (call sse c 102 true 110 xmm r))
  (fn movq_rx [c:(ptr buf.Buf) r:i32 xmm:i32] -> void (call sse c 102 true 126 xmm r))
  ;; movd xmm, r32 / movd r32, xmm: a float's bits
  (fn movd_xr [c:(ptr buf.Buf) xmm:i32 r:i32] -> void (call sse c 102 false 110 xmm r))
  (fn movd_rx [c:(ptr buf.Buf) r:i32 xmm:i32] -> void (call sse c 102 false 126 xmm r))

  ;; Arithmetic kinds for float_op: add, sub, mul, div (their opcodes)
  (fn f_add [] -> i32 88)
  (fn f_sub [] -> i32 92)
  (fn f_mul [] -> i32 89)
  (fn f_div [] -> i32 94)

  ;; addsd/subsd/mulsd/divsd (sz 64) or the ss forms (sz 32): dst op= src
  (fn float_op [c:(ptr buf.Buf) sz:i32 kind:i32 dst:i32 src:i32] -> void
    (req (call size_ok sz))
    (req (or (eq kind 88) (or (eq kind 92) (or (eq kind 89) (eq kind 94)))))
    (call sse c (if (eq sz 64) 242 243) false kind dst src))

  ;; ucomisd / ucomiss a, b: flags as an unsigned compare of a with b; an
  ;; unordered result (a NaN) sets ZF, PF, and CF
  (fn ucomi [c:(ptr buf.Buf) sz:i32 a:i32 b:i32] -> void
    (req (call size_ok sz))
    (call sse c (if (eq sz 64) 102 0) false 46 a b))

  ;; sqrtsd dst, src: the correctly rounded square root (f64.sqrt)
  (fn sqrtsd [c:(ptr buf.Buf) dst:i32 src:i32] -> void (call sse c 242 false 81 dst src))

  ;; cvtsi2sd xmm, r64 (signed integer to double)
  (fn cvtsi2sd [c:(ptr buf.Buf) xmm:i32 r:i32] -> void (call sse c 242 true 42 xmm r))
  ;; cvttsd2si r64, xmm (double to signed integer, truncating)
  (fn cvttsd2si [c:(ptr buf.Buf) r:i32 xmm:i32] -> void (call sse c 242 true 44 r xmm))

  ;; Every form over every register pair p(r) (vectors: tools/x64_vectors.py sse)
  (fn test_sse [] -> i32
    (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 2048))
    (loop r 0 15 1
      (call movq_xr c r (call p r))
      (call movq_rx c (call p r) r)
      (call movd_xr c r (call p r))
      (call movd_rx c (call p r) r)
      (call float_op c 64 (call f_add) r (call p r))
      (call float_op c 64 (call f_sub) r (call p r))
      (call float_op c 64 (call f_mul) r (call p r))
      (call float_op c 64 (call f_div) r (call p r))
      (call float_op c 32 (call f_add) r (call p r))
      (call float_op c 32 (call f_sub) r (call p r))
      (call float_op c 32 (call f_mul) r (call p r))
      (call float_op c 32 (call f_div) r (call p r))
      (call ucomi c 64 r (call p r))
      (call ucomi c 32 r (call p r))
      (call cvtsi2sd c r (call p r))
      (call cvttsd2si c (call p r) r)
      (call sqrtsd c r (call p r)))
    (call check "sse" c ""))

  ;; ===== Thread-local storage (NE15): FS-relative accesses =====

  ;; The FS segment prefix: the next memory operand is relative to the
  ;; thread's FS base (each thread's own globals block).
  (fn fs [c:(ptr buf.Buf)] -> void (call byte c 100))

  (fn test_tls [] -> i32
    (let c:(ptr buf.Buf) (call buf.make (call alloc.default) 256))
    (loop r 0 15 1
      (call fs c) (call load c 64 r (call mem (call p r) 8))
      (call fs c) (call store c 64 (call mem (call p r) 16) r)
      (call fs c) (call load c 32 r (call mem (call p r) 0)))
    (call check "tls" c ""))

)
