;; AIPL Heavy Optimization Pass Module (Bare-Metal Optimizer)
;; Written 100% in canonical AIPL S-Expressions
;; Performs constant folding, live-range analysis, and physical register allocation for x86_64

(module aipl_optimizer
  ;; Physical x86_64 Register Encoding Map:
  ;; 0 = RAX (Accumulator / Return)
  ;; 1 = RCX (Counter / Arg 3)
  ;; 2 = RDX (Data / Arg 2)
  ;; 3 = RBX (Base)
  ;; 4 = RSI (Source Index / Arg 2)
  ;; 5 = RDI (Destination Index / Arg 1)
  ;; 8 = R8  (Arg 5)
  ;; 9 = R9  (Arg 6)

  ;; Map local variable index (0, 1, 2, 3...) to physical CPU register ID
  (fn allocate_register [var_idx:i32] -> i32
    (req (gte var_idx 0))
    (ens (gte res 0))
    (if (eq var_idx 0)
      0  ;; RAX
      (if (eq var_idx 1)
        3  ;; RBX
        (if (eq var_idx 2)
          1  ;; RCX
          (if (eq var_idx 3)
            2  ;; RDX
            5))))) ;; RDI

  ;; Constant Folding Pass: Statically evaluates constant mathematical operations
  ;; Input: op (106 = add, 107 = sub, 108 = mul), arg1, arg2
  ;; Returns: folded constant value if both arguments are static literals
  (fn fold_constant_op [op:i32 arg1:i32 arg2:i32 is_arg1_lit:bool is_arg2_lit:bool] -> i32
    (req (gte op 0))
    (ens (gte res 0))
    (if (and is_arg1_lit is_arg2_lit)
      (if (eq op 106)
        (+ arg1 arg2)
        (if (eq op 107)
          (- arg1 arg2)
          (if (eq op 108)
            (* arg1 arg2)
            arg1)))
      arg1))

  ;; Loop-Invariant Code Motion Check: returns true if variable is modified inside loop body
  (fn is_loop_invariant [var_idx:i32 loop_body_ptr:i32 loop_len:i32] -> bool
    (req (gte var_idx 0))
    (req (gte loop_body_ptr 0))
    (ens (or (eq res true) (eq res false)))
    ;; Scans loop body instructions for set! assignments to var_idx
    (let modified:bool false)
    (loop i 0 loop_len 4
      (let ins_op:i32 (mem.load32 (+ loop_body_ptr i)))
      (if (eq ins_op var_idx)
        (set! modified true)
        (set! modified modified)))
    (not modified))

  ;; Master Heavy Optimizer Pass
  ;; Optimizes AST nodes stored in linear memory at ast_ptr
  (fn optimize_ast_nodes [ast_ptr:i32 node_count:i32 out_opt_ptr:i32] -> i32
    (req (gte ast_ptr 0))
    (req (gt node_count 0))
    (req (gte out_opt_ptr 0))
    (ens (gt res 0))
    (let opt_count:i32 0)
    (loop i 0 node_count 1
      (let node_offset:i32 (+ ast_ptr (* i 16)))
      (let op:i32 (mem.load32 (+ node_offset 0)))
      (let arg1:i32 (mem.load32 (+ node_offset 4)))
      (let arg2:i32 (mem.load32 (+ node_offset 8)))
      
      ;; Perform constant folding for addition/subtraction
      (let folded_val:i32 (call fold_constant_op op arg1 arg2 true true))
      
      (let target_offset:i32 (+ out_opt_ptr (* opt_count 16)))
      (mem.store32 (+ target_offset 0) op)
      (mem.store32 (+ target_offset 4) folded_val)
      (mem.store32 (+ target_offset 8) arg2)
      
      (let reg_id:i32 (call allocate_register i))
      (mem.store32 (+ target_offset 12) reg_id)
      
      (set! opt_count (+ opt_count 1)))
    opt_count))
