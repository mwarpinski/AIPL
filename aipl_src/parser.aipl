;; The AIPL parser in AIPL: compiler.aipl's tokens to ast.aipl's typed tree,
;; a port of src/parser.rs (Parser::parse_module and everything it calls)
;; that accepts the same programs and reports the same first error, word for
;; word (docs/design/CHECKER_PLAN.md).
;;
;; Errors: AIPL has no exceptions, so the first error is recorded in P.err
;; and the parser jumps to the end of the tokens. Every loop then stops (they
;; all stop at the end, as Rust's do), later errors are ignored, and the
;; caller reads P.failed. Functions return placeholder values after an error.
(module parser
  (import alloc)
  (import compiler)
  (import ast)
  (import str)
  (import buf)
  (import vec)
  (import map)
  (import suggest)

  ;; The forms of src/parser.rs parse_expr that are not operators.
  (enum Form [none let_ set if_ loop for_ when_ while_ call ok err make match_ block match_result get_ put_
              sizeof return_ break_ continue_ cond ref call_ref arr_len ptr_null arr_null ptr_cast
              arr_cast ptr_addr arr_addr enum_ord enum_cast arr_get arr_set mem_free float_mem unsafe_ with_
              ptr_make arr_make ptr_gen arr_gen fmt_surface])

  (struct P [src:i32 toks:i32 n:i32 pos:i32
             unions:(ptr (map.Map str.Bytes i32))
             values:(ptr (map.Map str.Bytes i32))
             forms:(ptr (map.Map str.Bytes Form))
             ops:(ptr (map.Map str.Bytes i32))
             err:(ptr buf.Buf) err_at:i32 last_at:i32 failed:bool])

  ;; ===== Tokens =====

  (fn tok [p:(ptr P) i:i32] -> (ptr compiler.Token) (call compiler.token_at (get p P.toks) i))
  (fn kind_at [p:(ptr P) i:i32] -> compiler.Kind
    (if (and (gte i 0) (lt i (get p P.n))) (get (call tok p i) compiler.Token.kind) compiler.Kind.none))
  (fn peek [p:(ptr P)] -> compiler.Kind (call kind_at p (get p P.pos)))

  ;; The next token's index, consumed, or -1 at the end.
  (fn next [p:(ptr P)] -> i32
    (let i:i32 (get p P.pos))
    (when (gte i (get p P.n)) (return -1))
    (put p P.pos (+ i 1))
    i)

  ;; src/parser.rs cur_pos: the next token's position, else the last token's.
  (fn cur_pos [p:(ptr P)] -> i32
    (cond
      ((lt (get p P.pos) (get p P.n)) (get (call tok p (get p P.pos)) compiler.Token.pos))
      ((gt (get p P.n) 0) (get (call tok p (- (get p P.n) 1)) compiler.Token.pos))
      (else 0)))

  (fn tpos [p:(ptr P) i:i32] -> i32 (get (call tok p i) compiler.Token.pos))

  ;; A symbol-like token's text (symbol; a string's body; i64 and float literals).
  (fn text [p:(ptr P) i:i32] -> str.Bytes
    (unsafe (let t:(ptr compiler.Token) (call tok p i))
    (call str.bytes (+ (get p P.src) (get t compiler.Token.a)) (get t compiler.Token.b))))

  ;; An int token's literal as written.
  (fn int_text [p:(ptr P) i:i32] -> str.Bytes (call text p i))

  (fn is_sym [p:(ptr P) i:i32 s:str] -> bool
    (and (eq (call kind_at p i) compiler.Kind.symbol)
         (call compiler.span_is (get p P.src) (get (call tok p i) compiler.Token.a) (get (call tok p i) compiler.Token.b) s)))

  ;; The value of an integer literal's text (an optional sign, then digits;
  ;; the tokenizer has checked it fits in i64).
  (fn i64_value [b:str.Bytes] -> i64
    (let c0:i32 (call str.byte_at b 0))
    (let start:i32 (if (or (eq c0 45) (eq c0 43)) 1 0))
    (let v:i64 0i64)
    (for k start (get b str.Bytes.len)
      (set! v (- (* v 10i64) (i64.extend_s (- (call str.byte_at b k) 48)))))
    (if (eq c0 45) v (- 0i64 v)))

  ;; ===== Messages =====

  ;; A message for the error at source offset `at` (the position goes with
  ;; it to fail; front.aipl puts "line:col: " in front).
  (fn msg [p:(ptr P) at:i32] -> (ptr buf.Buf)
    (put p P.last_at at)
    (call buf.make (call alloc.default) 96))

  ;; Records the first error and ends the parse.
  (fn fail [p:(ptr P) b:(ptr buf.Buf)] -> void
    (when (not (get p P.failed))
          (put p P.failed true)
          (put p P.err b)
          (put p P.err_at (get p P.last_at)))
    (put p P.pos (get p P.n)))

  (fn fail_str [p:(ptr P) at:i32 s:str] -> void
    (let b:(ptr buf.Buf) (call msg p at))
    (call buf.push_str b s)
    (call fail p b))

  ;; A string literal as AIPL writes it (src/parser.rs TokenKind's
  ;; Display): its escapes as written (only \" \\ \n \t \r \0 exist), a raw
  ;; newline, tab, return, or NUL escaped, other bytes as they are.
  (fn push_string_text [b:(ptr buf.Buf) raw:str.Bytes] -> void
    (call buf.push_byte b 34)
    (let k:i32 0)
    (while (lt k (get raw str.Bytes.len))
      (let c:i32 (call str.byte_at raw k))
      (cond
        ((eq c 92)
         (call buf.push_byte b 92)
         (call buf.push_byte b (call str.byte_at raw (+ k 1)))
         (set! k (+ k 1)))
        ((eq c 10) (call buf.push_str b "\\n"))
        ((eq c 9) (call buf.push_str b "\\t"))
        ((eq c 13) (call buf.push_str b "\\r"))
        ((eq c 0) (call buf.push_str b "\\0"))
        (else (call buf.push_byte b c)))
      (set! k (+ k 1)))
    (call buf.push_byte b 34))

  ;; Token i as AIPL source writes it, in quotes (src/parser.rs TokenKind's
  ;; Display): '(' 'x' '42' '42i64' '1.5e3' (as written) 'true' '"a"'.
  (fn push_token_text [p:(ptr P) b:(ptr buf.Buf) i:i32] -> void
    (unsafe (let k:compiler.Kind (call kind_at p i))
    (let t:(ptr compiler.Token) (call tok p i))
    (call buf.push_byte b 39)
    (cond
      ((eq k compiler.Kind.lparen) (call buf.push_str b "("))
      ((eq k compiler.Kind.rparen) (call buf.push_str b ")"))
      ((eq k compiler.Kind.lbracket) (call buf.push_str b "["))
      ((eq k compiler.Kind.rbracket) (call buf.push_str b "]"))
      ((eq k compiler.Kind.colon) (call buf.push_str b ":"))
      ((eq k compiler.Kind.arrow) (call buf.push_str b "->"))
      ((eq k compiler.Kind.int) (call buf.push_i64 b (call i64_value (call int_text p i))))
      ((eq k compiler.Kind.int64)
       (let s:str.Bytes (call text p i))
       (call buf.push_i64 b (call i64_value (call str.bytes (call str.addr s) (- (get s str.Bytes.len) 3))))
       (call buf.push_str b "i64"))
      ((eq k compiler.Kind.bool) (call buf.push_str b (if (eq (get t compiler.Token.a) 0) "false" "true")))
      ((eq k compiler.Kind.string) (call push_string_text b (call text p i)))
      ;; a symbol or a float literal: as written
      (else (call buf.push_bytes b (call text p i))))
    (call buf.push_byte b 39)))

  ;; "Expected WHAT, got TOKEN" at the token, or "got EOF" at `eof_at`
  ;; (the message, to add to before it fails).
  (fn expected_msg [p:(ptr P) i:i32 what:str eof_at:i32] -> (ptr buf.Buf)
    (let b:(ptr buf.Buf) (call msg p (if (gte i 0) (call tpos p i) eof_at)))
    (call buf.push_str b "Expected ")
    (call buf.push_str b what)
    (call buf.push_str b ", got ")
    (if (gte i 0) (call push_token_text p b i) (call buf.push_str b "EOF"))
    b)

  (fn fail_expected [p:(ptr P) i:i32 what:str eof_at:i32] -> void
    (call fail p (call expected_msg p i what eof_at)))

  ;; An error at the next token, or the last one.
  (fn fail_here [p:(ptr P) s:str] -> void (call fail_str p (call cur_pos p) s))

  (fn kind_name [k:compiler.Kind] -> str
    (cond
      ((eq k compiler.Kind.lparen) "'('")
      ((eq k compiler.Kind.rparen) "')'")
      ((eq k compiler.Kind.lbracket) "'['")
      ((eq k compiler.Kind.rbracket) "']'")
      ((eq k compiler.Kind.colon) "':'")
      (else "'->'")))

  ;; src/parser.rs expect_kind: the token's index, or -1 after an error.
  (fn expect [p:(ptr P) k:compiler.Kind] -> i32
    (let at:i32 (call cur_pos p))
    (let i:i32 (call next p))
    (when (and (gte i 0) (eq (call kind_at p i) k)) (return i))
    (call fail_expected p i (call kind_name k) at)
    -1)

  ;; expect, with what to write after the usual message (src/parser.rs
  ;; expect_kind_hint).
  (fn want_hint [p:(ptr P) k:compiler.Kind hint:str] -> void
    (let at:i32 (call cur_pos p))
    (let i:i32 (call next p))
    (when (and (gte i 0) (eq (call kind_at p i) k))
        (return))
    (let b:(ptr buf.Buf) (call expected_msg p i (call kind_name k) at))
    (call buf.push_str b "; ")
    (call buf.push_str b hint)
    (call fail p b))

  ;; The ':' after a let's name.
  (fn want_let_colon [p:(ptr P) name:str.Bytes] -> void
    (let at:i32 (call cur_pos p))
    (let i:i32 (call next p))
    (when (and (gte i 0) (eq (call kind_at p i) compiler.Kind.colon))
        (return))
    (let b:(ptr buf.Buf) (call expected_msg p i "':'" at))
    (call buf.push_str b "; every let names its type: (let ")
    (call buf.push_bytes b name)
    (call buf.push_str b ":i32 5)")
    (call fail p b))

  ;; next, as a statement.
  (fn want_next [p:(ptr P)] -> void (let _i:i32 (call next p)) (block))

  ;; expect, as a statement.
  (fn want [p:(ptr P) k:compiler.Kind] -> void
    (let _i:i32 (call expect p k))
    (block))

  ;; src/parser.rs expect_symbol (and the inline "Expected X name" matches).
  (fn expect_symbol [p:(ptr P) what:str eof_at:i32] -> str.Bytes
    (let i:i32 (call next p))
    (when (and (gte i 0) (eq (call kind_at p i) compiler.Kind.symbol)) (return (call text p i)))
    (call fail_expected p i what eof_at)
    (call str.from_str ""))

  ;; expect_symbol, with a hint after the message unless the tokens ran out.
  (fn expect_symbol_hint [p:(ptr P) what:str eof_at:i32 hint:str] -> str.Bytes
    (let i:i32 (call next p))
    (when (and (gte i 0) (eq (call kind_at p i) compiler.Kind.symbol)) (return (call text p i)))
    (let b:(ptr buf.Buf) (call expected_msg p i what eof_at))
    (when (gte i 0)
      (call buf.push_str b "; ")
      (call buf.push_str b hint))
    (call fail p b)
    (call str.from_str ""))

  ;; ===== Building arrays =====

  (fn (to_arr T) [v:(ptr (vec.Vec T))] -> (arr T)
    (let a:(arr T) (arr.new T (call alloc.forever) (call (vec.len T) v)))
    (for k 0 (call (vec.len T) v) (arr.set T a k (call (vec.at T) v k)))
    a)

  (fn exprs [] -> (ptr (vec.Vec ast.Expr)) (call (vec.make ast.Expr) (call alloc.default) 4))

  ;; Expressions until the closing ')' (or the end).
  (fn parse_body [p:(ptr P)] -> (arr ast.Expr)
    (let v:(ptr (vec.Vec ast.Expr)) (call exprs))
    (while (and (neq (call peek p) compiler.Kind.rparen) (neq (call peek p) compiler.Kind.none))
      (call (vec.push ast.Expr) v (call parse_expr p)))
    (call (to_arr ast.Expr) v))

  ;; ===== Types =====

  (fn scalar_type [s:str.Bytes] -> ast.MaybeType
    (let t:ast.MaybeType (make ast.MaybeType.none))
    (when (call str.is s "i32") (set! t (make ast.MaybeType.some (make ast.Type.i32))))
    (when (call str.is s "i64") (set! t (make ast.MaybeType.some (make ast.Type.i64))))
    (when (call str.is s "f32") (set! t (make ast.MaybeType.some (make ast.Type.f32))))
    (when (call str.is s "f64") (set! t (make ast.MaybeType.some (make ast.Type.f64))))
    (when (call str.is s "bool") (set! t (make ast.MaybeType.some (make ast.Type.bool))))
    (when (call str.is s "str") (set! t (make ast.MaybeType.some (make ast.Type.str))))
    (when (call str.is s "void") (set! t (make ast.MaybeType.some (make ast.Type.void))))
    (when (call str.is s "u8") (set! t (make ast.MaybeType.some (make ast.Type.u8))))
    (when (call str.is s "i8") (set! t (make ast.MaybeType.some (make ast.Type.i8))))
    (when (call str.is s "u16") (set! t (make ast.MaybeType.some (make ast.Type.u16))))
    (when (call str.is s "i16") (set! t (make ast.MaybeType.some (make ast.Type.i16))))
    t)

  (fn is_scalar [s:str.Bytes] -> bool
    (match (call scalar_type s) (ast.MaybeType.none false) (ast.MaybeType.some [_] true)))

  ;; sizeof's operand: a struct by its bare name, or any type.
  (fn parse_sizeof_type [p:(ptr P) at:i32] -> ast.Type
    (let k:compiler.Kind (call peek p))
    (when (eq k compiler.Kind.none) (call fail_str p at "Expected a type in sizeof, got EOF") (return (make ast.Type.i32)))
    (when (eq k compiler.Kind.symbol)
          (let s:str.Bytes (call text p (get p P.pos)))
          (when (and (not (call is_scalar s)) (not (call (map.has str.Bytes i32) (get p P.unions) s))) (call want_next p) (return (make ast.Type.struct_ s))))
    (call parse_type p))

  (fn parse_type [p:(ptr P)] -> ast.Type
    (let start:i32 (call cur_pos p))
    (let i:i32 (call next p))
    (let k:compiler.Kind (call kind_at p i))
    (cond
      ((eq k compiler.Kind.symbol)
       (let s:str.Bytes (call text p i))
       (match (call scalar_type s)
         (ast.MaybeType.some [t] t)
         (ast.MaybeType.none
          (let c0:i32 (call str.byte_at s 0))
          (cond
            ((call (map.has str.Bytes i32) (get p P.unions) s) (make ast.Type.union_ s))
            ((call (map.has str.Bytes i32) (get p P.values) s) (make ast.Type.struct_ s))
            ((not (or (and (gte c0 48) (lte c0 57)) (eq c0 45))) (make ast.Type.enum_ s))
            (else
             (let b:(ptr buf.Buf) (call msg p (call tpos p i)))
             (call buf.push_str b "Unknown scalar type: ")
             (call buf.push_bytes b s)
             (call fail p b)
             (make ast.Type.i32))))))
      ((eq k compiler.Kind.lparen)
       (let at:i32 (call tpos p i))
       (let ctor:str.Bytes (call expect_symbol p "type constructor" at))
       (when (get p P.failed) (return (make ast.Type.i32)))
       (cond
         ((call str.is ctor "result")
          (let ok_t:ast.Type (call parse_type p))
          (let err_t:ast.Type (call parse_type p))
          (call want p compiler.Kind.rparen)
          (call ast.result_type (call alloc.default) ok_t err_t))
         ((call str.is ctor "arr")
          (let elem:ast.Type (call parse_type p))
          (when (eq (call peek p) compiler.Kind.int)
              (call fail_str p at "(arr T) takes no length; an array's length is set by (arr.new T n)"))
          (call want p compiler.Kind.rparen)
          (call ast.arr_type (call alloc.default) elem))
         ((call str.is ctor "fn")
          (call want_hint p compiler.Kind.lbracket "a function type is (fn [i32] -> i32): the parameters in brackets, then ->")
          (let ps:(ptr (vec.Vec ast.Type)) (call (vec.make ast.Type) (call alloc.default) 4))
          (while (and (neq (call peek p) compiler.Kind.rbracket) (neq (call peek p) compiler.Kind.none))
            (call (vec.push ast.Type) ps (call parse_type p)))
          (call want p compiler.Kind.rbracket)
          (call want_hint p compiler.Kind.arrow "a function type is (fn [i32] -> i32): the parameters in brackets, then ->")
          (let ret:ast.Type (call parse_type p))
          ;; (fn [..] -> r (no_leak)): only functions that keep no memory
          (let promise:bool (eq (call peek p) compiler.Kind.lparen))
          (when promise
            (call want p compiler.Kind.lparen)
            (let w_at:i32 (call cur_pos p))
            (let w:str.Bytes (call expect_symbol p "(no_leak) in a function type" w_at))
            (when (and (not (get p P.failed)) (not (call str.is w "no_leak")))
              (let b:(ptr buf.Buf) (call msg p w_at))
              (call buf.push_str b "a function type is (fn [params] -> ret), or (fn [params] -> ret (no_leak)); got (")
              (call buf.push_bytes b w)
              (call buf.push_str b " ...)")
              (call fail p b))
            (call want p compiler.Kind.rparen))
          (call want p compiler.Kind.rparen)
          (call ast.fn_type (call alloc.default) (call (to_arr ast.Type) ps) ret promise))
         ((call str.is ctor "ptr")
          (let name:str.Bytes (call expect_symbol p "struct name in (ptr S)" at))
          (when (and (not (get p P.failed)) (call is_scalar name))
                (let b:(ptr buf.Buf) (call msg p at))
                (call buf.push_str b "(ptr ")
                (call buf.push_bytes b name)
                (call buf.push_str b ") is not a type: ptr points to a struct; for a sequence of ")
                (call buf.push_bytes b name)
                (call buf.push_str b " use (arr ")
                (call buf.push_bytes b name)
                (call buf.push_byte b 41)
                (call fail p b))
          (call want p compiler.Kind.rparen)
          (call ast.ptr_type (call alloc.default) (make ast.Type.struct_ name)))
         (else
          (let b:(ptr buf.Buf) (call msg p at))
          (call buf.push_str b "Unknown compound type: ")
          (call buf.push_bytes b ctor)
          (call fail p b)
          (make ast.Type.i32))))
      (else
       (call fail_expected p i "type token" start)
       (make ast.Type.i32))))

  ;; ===== Module items =====

  (fn head_is [p:(ptr P) s:str] -> bool (call is_sym p (+ (get p P.pos) 1) s))

  (fn parse_module [p:(ptr P)] -> (ptr ast.Module)
    (let m:(ptr ast.Module) (new ast.Module (call alloc.forever) [name:(zero str.Bytes)
                                                                  imports:(zero (arr (ptr ast.Import)))
                                                                  structs:(zero (arr (ptr ast.StructDef)))
                                                                  enums:(zero (arr (ptr ast.EnumDef)))
                                                                  unions:(zero (arr (ptr ast.UnionDef)))
                                                                  fns:(zero (arr (ptr ast.FnDef)))]))
    (let start:i32 (call cur_pos p))
    (call want p compiler.Kind.lparen)
    (let i:i32 (call next p))
    (when (not (call is_sym p i "module")) (call fail_expected p i "'module' symbol" start))
    (put m ast.Module.name (call expect_symbol p "module name" start))
    (let imports:(ptr (vec.Vec (ptr ast.Import))) (call (vec.make (ptr ast.Import)) (call alloc.default) 4))
    (let structs:(ptr (vec.Vec (ptr ast.StructDef))) (call (vec.make (ptr ast.StructDef)) (call alloc.default) 8))
    (let enums:(ptr (vec.Vec (ptr ast.EnumDef))) (call (vec.make (ptr ast.EnumDef)) (call alloc.default) 4))
    (let unions:(ptr (vec.Vec (ptr ast.UnionDef))) (call (vec.make (ptr ast.UnionDef)) (call alloc.default) 4))
    (let fns:(ptr (vec.Vec (ptr ast.FnDef))) (call (vec.make (ptr ast.FnDef)) (call alloc.default) 16))
    (while (eq (call peek p) compiler.Kind.lparen)
      (cond
        ((call head_is p "import") (call (vec.push (ptr ast.Import)) imports (call parse_import p)))
        ((call head_is p "struct") (call (vec.push (ptr ast.StructDef)) structs (call parse_struct p)))
        ((call head_is p "enum") (call (vec.push (ptr ast.EnumDef)) enums (call parse_enum p)))
        ((call head_is p "union") (call (vec.push (ptr ast.UnionDef)) unions (call parse_union p)))
        ((call head_is p "const")
         (call fail_str p (call cur_pos p) "(const ...) is expanded during import resolution; parse the file with Resolver, not Parser::parse"))
        (else (call (vec.push (ptr ast.FnDef)) fns (call parse_fn p)))))
    (call want p compiler.Kind.rparen)
    (when (lt (get p P.pos) (get p P.n))
        (call fail_str p (call cur_pos p) "unexpected tokens after module end — check for an extra ')'"))
    (put m ast.Module.imports (call (to_arr (ptr ast.Import)) imports))
    (put m ast.Module.structs (call (to_arr (ptr ast.StructDef)) structs))
    (put m ast.Module.enums (call (to_arr (ptr ast.EnumDef)) enums))
    (put m ast.Module.unions (call (to_arr (ptr ast.UnionDef)) unions))
    (put m ast.Module.fns (call (to_arr (ptr ast.FnDef)) fns))
    m)

  (fn parse_import [p:(ptr P)] -> (ptr ast.Import)
    (let start:i32 (call cur_pos p))
    (let im:(ptr ast.Import) (new ast.Import (call alloc.forever) [name:(zero str.Bytes)
                                                                   alias:(zero str.Bytes)]))
    (call want p compiler.Kind.lparen)
    (call next p)
    (put im ast.Import.name (call expect_symbol p "module name in import" start))
    (put im ast.Import.alias (call str.absent))
    (when (call is_sym p (get p P.pos) "as")
          (call next p)
          (put im ast.Import.alias (call expect_symbol p "alias after 'as'" start)))
    (call want p compiler.Kind.rparen)
    im)

  ;; name:type ... up to ']' as fields; `what` names the name expected.
  (fn parse_fields [p:(ptr P) what:str eof_at:i32 close:compiler.Kind] -> (arr (ptr ast.Field))
    (let v:(ptr (vec.Vec (ptr ast.Field))) (call (vec.make (ptr ast.Field)) (call alloc.default) 4))
    (while (and (neq (call peek p) close) (neq (call peek p) compiler.Kind.none))
      (let name:str.Bytes (call expect_symbol p what eof_at))
      (call want p compiler.Kind.colon)
      (let f:(ptr ast.Field) (new ast.Field (call alloc.forever) [name:name ty:(call parse_type p)]))
      (call (vec.push (ptr ast.Field)) v f))
    (call (to_arr (ptr ast.Field)) v))

  (fn parse_struct [p:(ptr P)] -> (ptr ast.StructDef)
    (let s:(ptr ast.StructDef) (new ast.StructDef (call alloc.forever) [name:(zero str.Bytes)
                                                                        fields:(zero (arr (ptr ast.Field)))
                                                                        at:(zero i32)
                                                                        value:(zero bool)]))
    (let open:i32 (call expect p compiler.Kind.lparen))
    (let at:i32 (call tpos p open))
    (put s ast.StructDef.at at)
    (call next p)
    (put s ast.StructDef.name (call expect_symbol p "struct name" at))
    (call want p compiler.Kind.lbracket)
    (put s ast.StructDef.fields (call parse_fields p "field name" at compiler.Kind.rbracket))
    (call want p compiler.Kind.rbracket)
    ;; (value): a value struct
    (put s ast.StructDef.value false)
    (when (eq (call peek p) compiler.Kind.lparen)
          (let open2:i32 (call next p))
          (let m:i32 (call next p))
          (if (call is_sym p m "value")
              (put s ast.StructDef.value true)
              (call fail_expected p m "(value) or ')' after a struct's fields" (call tpos p open2)))
          (call want p compiler.Kind.rparen))
    (call want p compiler.Kind.rparen)
    s)

  (fn parse_enum [p:(ptr P)] -> (ptr ast.EnumDef)
    (let e:(ptr ast.EnumDef) (new ast.EnumDef (call alloc.forever) [name:(zero str.Bytes)
                                                                    members:(zero (arr (ptr ast.Member)))
                                                                    at:(zero i32)]))
    (let open:i32 (call expect p compiler.Kind.lparen))
    (let at:i32 (call tpos p open))
    (put e ast.EnumDef.at at)
    (call next p)
    (put e ast.EnumDef.name (call expect_symbol p "enum name" at))
    (let bracket:i32 (call expect p compiler.Kind.lbracket))
    (let members:(ptr (vec.Vec (ptr ast.Member))) (call (vec.make (ptr ast.Member)) (call alloc.default) 8))
    (let next_value:i64 0i64)
    (while (not (get p P.failed))
      (let mat:i32 (call cur_pos p))
      (let i:i32 (call next p))
      (let k:compiler.Kind (call kind_at p i))
      (let value:i64 next_value)
      (let name:str.Bytes (call str.absent))
      (cond
        ((eq k compiler.Kind.rbracket) (break))
        ((eq k compiler.Kind.symbol) (set! name (call text p i)))
        ((eq k compiler.Kind.lparen)
         (set! name (call expect_symbol p "enum member name" mat))
         (let vi:i32 (call next p))
         (if (eq (call kind_at p vi) compiler.Kind.int)
             (set! value (call i64_value (call int_text p vi)))
             (call fail_str p mat "an enum member with a value is (name INTEGER), e.g. (blue 5)"))
         (call want p compiler.Kind.rparen))
        ((eq k compiler.Kind.none) (call fail_str p (call tpos p bracket) "this bracket is never closed"))
        (else
         (let b:(ptr buf.Buf) (call msg p (call tpos p i)))
         (call buf.push_str b "an enum member is a name or (name INTEGER), got ")
         (call push_token_text p b i)
         (call fail p b)))
      (when (get p P.failed) (break))
      (when (or (lt value -2147483648i64) (gt value 2147483647i64))
            (let b:(ptr buf.Buf) (call msg p mat))
            (call buf.push_str b "enum member value ")
            (call buf.push_i64 b value)
            (call buf.push_str b " is not an i32")
            (call fail p b))
      (let mem:(ptr ast.Member) (new ast.Member (call alloc.forever) [name:name
                                                                      value:(i32.wrap value)]))
      (call (vec.push (ptr ast.Member)) members mem)
      (set! next_value (+ value 1i64)))
    (call want p compiler.Kind.rparen)
    (put e ast.EnumDef.members (call (to_arr (ptr ast.Member)) members))
    e)

  (fn parse_union [p:(ptr P)] -> (ptr ast.UnionDef)
    (let u:(ptr ast.UnionDef) (new ast.UnionDef (call alloc.forever) [name:(zero str.Bytes)
                                                                      variants:(zero (arr (ptr ast.Variant)))
                                                                      at:(zero i32)]))
    (let open:i32 (call expect p compiler.Kind.lparen))
    (let at:i32 (call tpos p open))
    (put u ast.UnionDef.at at)
    (call next p)
    (put u ast.UnionDef.name (call expect_symbol p "union name" at))
    (call want p compiler.Kind.lbracket)
    (let vs:(ptr (vec.Vec (ptr ast.Variant))) (call (vec.make (ptr ast.Variant)) (call alloc.default) 4))
    (while (and (neq (call peek p) compiler.Kind.rbracket) (neq (call peek p) compiler.Kind.none))
      (let vat:i32 (call cur_pos p))
      (when (neq (call peek p) compiler.Kind.lparen)
          (call fail_str p vat "a union variant is (name field:type ...), e.g. (circle radius:f64) or (empty)"))
      (call next p)
      (let v:(ptr ast.Variant) (new ast.Variant (call alloc.forever) [name:(call expect_symbol p "variant name" vat)
                                                                      fields:(call parse_fields p "field name" vat compiler.Kind.rparen)]))
      (call want p compiler.Kind.rparen)
      (call (vec.push (ptr ast.Variant)) vs v))
    (call want p compiler.Kind.rbracket)
    (call want p compiler.Kind.rparen)
    (put u ast.UnionDef.variants (call (to_arr (ptr ast.Variant)) vs))
    u)

  (fn parse_fn [p:(ptr P)] -> (ptr ast.FnDef)
    (let open:i32 (call expect p compiler.Kind.lparen))
    (let at:i32 (if (gte open 0) (call tpos p open) 0))
    (let i:i32 (call next p))
    (when (not (call is_sym p i "fn")) (call fail_expected p i "'fn'" at))
    (let name:str.Bytes (call expect_symbol p "fn name" at))
    (call want p compiler.Kind.lbracket)
    (let ps:(ptr (vec.Vec (ptr ast.Param))) (call (vec.make (ptr ast.Param)) (call alloc.default) 4))
    (while (and (neq (call peek p) compiler.Kind.rbracket) (neq (call peek p) compiler.Kind.none))
      (let pname:str.Bytes (call expect_symbol p "param name" at))
      (call want p compiler.Kind.colon)
      (let prm:(ptr ast.Param) (new ast.Param (call alloc.forever) [name:pname ty:(call parse_type p)]))
      (call (vec.push (ptr ast.Param)) ps prm))
    (call want p compiler.Kind.rbracket)
    (call want p compiler.Kind.arrow)
    (let params:(arr (ptr ast.Param)) (call (to_arr (ptr ast.Param)) ps))
    (let rt:ast.Type (call parse_type p))
    (let cs:(ptr (vec.Vec ast.Contract)) (call (vec.make ast.Contract) (call alloc.default) 2))
    (let body:(ptr (vec.Vec ast.Expr)) (call exprs))
    (let unsafe_:bool false)
    (let no_leak:bool false)
    (while (and (neq (call peek p) compiler.Kind.rparen) (neq (call peek p) compiler.Kind.none))
      (cond
        ((and (eq (call peek p) compiler.Kind.lparen)
              (or (call head_is p "req") (or (call head_is p "ens") (call head_is p "inv"))))
         (call (vec.push ast.Contract) cs (call parse_contract p)))
        ;; the clause (unsafe), which an (unsafe e...) block is not
        ((and (eq (call peek p) compiler.Kind.lparen)
              (and (call head_is p "unsafe")
                   (and (lt (+ (get p P.pos) 2) (get p P.n)) (eq (call kind_at p (+ (get p P.pos) 2)) compiler.Kind.rparen))))
         (put p P.pos (+ (get p P.pos) 3))
         (set! unsafe_ true))
        ;; the clause (no_leak)
        ((and (eq (call peek p) compiler.Kind.lparen)
              (and (call head_is p "no_leak")
                   (and (lt (+ (get p P.pos) 2) (get p P.n)) (eq (call kind_at p (+ (get p P.pos) 2)) compiler.Kind.rparen))))
         (put p P.pos (+ (get p P.pos) 3))
         (set! no_leak true))
        (else (call (vec.push ast.Expr) body (call parse_expr p)))))
    (call want p compiler.Kind.rparen)
    (new ast.FnDef (call alloc.forever) [name:name params:params ret:rt contracts:(call (to_arr ast.Contract) cs)
                                         body:(call (to_arr ast.Expr) body) at:at unsafe_:unsafe_ no_leak:no_leak]))

  (fn parse_contract [p:(ptr P)] -> ast.Contract
    (call want p compiler.Kind.lparen)
    (let i:i32 (call next p))
    (let e:ast.Expr (call parse_expr p))
    (let close_at:i32 (call cur_pos p))
    (let close:i32 (call next p))
    (when (not (and (gte close 0) (eq (call kind_at p close) compiler.Kind.rparen)))
      (let b:(ptr buf.Buf) (call expected_msg p close "')'" close_at))
      (call buf.push_str b "; a contract is one expression: (")
      (when (eq (call kind_at p i) compiler.Kind.symbol) (call buf.push_bytes b (call text p i)))
      (call buf.push_str b " (gt n 0))")
      (call fail p b))
    (cond
      ((call is_sym p i "req") (make ast.Contract.requires e))
      ((call is_sym p i "ens") (make ast.Contract.ensures e))
      (else (make ast.Contract.invariant e))))

  ;; ===== Expressions =====

  ;; Consumes one token and returns e unchanged.
  (fn skip [p:(ptr P) e:ast.Expr] -> ast.Expr (let _i:i32 (call next p)) e)

  (fn placeholder [at:i32] -> ast.Expr (make ast.Expr.lit_int at 0i64))

  (fn parse_expr [p:(ptr P)] -> ast.Expr
    (unsafe (let start:i32 (call cur_pos p))
    (let k:compiler.Kind (call peek p))
    (when (eq k compiler.Kind.none) (call fail_str p start "Unexpected EOF parsing expression") (return (call placeholder start)))
    (let i:i32 (get p P.pos))
    (let at:i32 (call tpos p i))
    (cond
      ((eq k compiler.Kind.int)
       (call next p)
       (let v:i64 (call i64_value (call int_text p i)))
       (when (or (lt v -2147483648i64) (gt v 4294967295i64))
             (let b:(ptr buf.Buf) (call msg p at))
             (call buf.push_str b "integer literal ")
             (call buf.push_i64 b v)
             (call buf.push_str b " does not fit in 32 bits; write ")
             (call buf.push_i64 b v)
             (call buf.push_str b "i64 for an i64")
             (call fail p b))
       (make ast.Expr.lit_int at v))
      ((eq k compiler.Kind.int64)
       (call next p)
       (let s:str.Bytes (call text p i))
       (make ast.Expr.lit_i64 at (call i64_value (call str.bytes (call str.addr s) (- (get s str.Bytes.len) 3)))))
      ((eq k compiler.Kind.float) (call next p) (make ast.Expr.lit_float at (call text p i)))
      ((eq k compiler.Kind.float32) (call next p) (make ast.Expr.lit_f32 at (call text p i)))
      ((eq k compiler.Kind.bool) (call next p) (make ast.Expr.lit_bool at (neq (get (call tok p i) compiler.Token.a) 0)))
      ((eq k compiler.Kind.string) (call next p) (make ast.Expr.lit_str at (call text p i)))
      ((eq k compiler.Kind.symbol) (call next p) (make ast.Expr.var at (call text p i)))
      ((eq k compiler.Kind.lparen) (call parse_group p))
      (else
       (let b:(ptr buf.Buf) (call msg p at))
       (call buf.push_str b "Unexpected token parsing expression: ")
       (call push_token_text p b i)
       (call fail p b)
       (call placeholder at)))))

  ;; "(" head ... ")": a form or an operator.
  (fn parse_group [p:(ptr P)] -> ast.Expr
    (let lp:i32 (call next p))
    (let at:i32 (call tpos p lp))
    (let hi:i32 (call next p))
    (when (neq (call kind_at p hi) compiler.Kind.symbol) (call fail_expected p hi "operator or keyword in expr" at) (return (call placeholder at)))
    (let head:str.Bytes (call text p hi))
    (let form:Form (call (map.get_or str.Bytes Form) (get p P.forms) head Form.none))
    (let e:ast.Expr (call parse_form p form head at))
    (call want p compiler.Kind.rparen)
    e)

  ;; Whether e is an empty (block).
  (fn is_empty_block [e:ast.Expr] -> bool
    (match e (ast.Expr.block [_ items] (eq (arr.len items) 0)) (else false)))

  (fn parse_form [p:(ptr P) form:Form head:str.Bytes at:i32] -> ast.Expr
    (cond
      ((eq form Form.let_)
       (let name:str.Bytes (call expect_symbol p "variable name" at))
       (call want_let_colon p name)
       (let ty:ast.Type (call parse_type p))
       (call ast.let_expr (call alloc.default) at name ty (call parse_expr p)))
      ((eq form Form.set)
       (let name:str.Bytes (call expect_symbol p "variable name" at))
       (call ast.set_expr (call alloc.default) at name (call parse_expr p)))
      ((eq form Form.if_)
       (let c:ast.Expr (call parse_expr p))
       (let t:ast.Expr (call parse_expr p))
       (when (eq (call peek p) compiler.Kind.rparen)
             (call fail_here p "Unexpected token parsing expression: ')'; if needs both branches: (if c then else); for one branch, write (when c then)")
             (return (call placeholder at)))
       (let e:ast.Expr (call parse_expr p))
       ;; one branch is when (CANONICAL_PLAN.md step 4; src/parser.rs "if")
       (cond
         ((call is_empty_block e) (call fail_str p (call ast.at e) "an if has two real branches, and this else is an empty (block): for one branch, write (when c then...)") (call placeholder at))
         ((call is_empty_block t) (call fail_str p (call ast.at t) "an if has two real branches, and this then is an empty (block): for an else alone, write (when (not c) else...)") (call placeholder at))
         (else (call ast.if_expr (call alloc.default) at c t e))))
      ((eq form Form.loop)
       (let var:str.Bytes (call expect_symbol p "loop var" at))
       (let s:ast.Expr (call parse_expr p))
       (let e:ast.Expr (call parse_expr p))
       (let st:ast.Expr (call parse_expr p))
       (call ast.loop_expr (call alloc.default) at var s e st (call parse_body p)))
      ;; (for i start end body...): the resolver rewrites it as counted_loop; read
      ;; here too, with the same end and step (src/parser.rs "for")
      ((eq form Form.for_)
       (let var:str.Bytes (call expect_symbol p "loop var" at))
       (let s:ast.Expr (call parse_expr p))
       (let e:ast.Expr (call parse_expr p))
       (when (eq (call peek p) compiler.Kind.int)
             (call fail_here p "a for has no step: (for i start end body...) counts up by one. A number here would be the first statement of the body, not a step; for another step, use while")
             (return (call placeholder at)))
       (let body:(arr ast.Expr) (call parse_body p))
       (let ends:(ptr (vec.Vec ast.Expr)) (call exprs))
       (call (vec.push ast.Expr) ends e)
       (call (vec.push ast.Expr) ends (make ast.Expr.lit_int at 1i64))
       (call ast.loop_expr (call alloc.default) at var s (make ast.Expr.op at ast.Op.sub (call (to_arr ast.Expr) ends))
             (make ast.Expr.lit_int at 1i64) body))
      ;; (when c body...): the resolver rewrites it as (if c (block body...) (block));
      ;; read here too, into that tree, every part at the when's place
      ;; (src/parser.rs "when")
      ((eq form Form.when_)
       (when (eq (call peek p) compiler.Kind.rparen) (call fail_str p at "when takes a condition and a body: (when c body...)") (return (call placeholder at)))
       (let wc:ast.Expr (call parse_expr p))
       (let wv:(ptr (vec.Vec ast.Expr)) (call exprs))
       (while (and (neq (call peek p) compiler.Kind.rparen) (neq (call peek p) compiler.Kind.none))
         (call (vec.push ast.Expr) wv (call parse_expr p)))
       ;; an empty block last: every expression of the body is a statement, its
       ;; value dropped, and the when has none (src/parser.rs "when")
       (call (vec.push ast.Expr) wv (make ast.Expr.block at (call (to_arr ast.Expr) (call exprs))))
       (call ast.if_expr (call alloc.default) at wc (make ast.Expr.block at (call (to_arr ast.Expr) wv)) (make ast.Expr.block at (call (to_arr ast.Expr) (call exprs)))))
      ((eq form Form.while_)
       (let c:ast.Expr (call parse_expr p))
       (call ast.while_expr (call alloc.default) at c (call parse_body p)))
      ((eq form Form.call)
       (let fname:str.Bytes (call expect_symbol p "func name in call" at))
       (make ast.Expr.call at fname (call parse_body p)))
      ((or (eq form Form.ok) (eq form Form.err))
       (let oty:ast.MaybeType (make ast.MaybeType.none))
       (when (eq (call peek p) compiler.Kind.colon) (call want_next p) (set! oty (make ast.MaybeType.some (call parse_type p))))
       (let v:ast.Expr (call parse_expr p))
       (if (eq form Form.ok) (call ast.ok_expr (call alloc.default) at v oty) (call ast.err_expr (call alloc.default) at v oty)))
      ((eq form Form.make)
       (let target:str.Bytes (call expect_symbol p "Union.variant in make" at))
       ;; a value struct's make: its fields
       (when (call (map.has str.Bytes i32) (get p P.values) target)
           (return (make ast.Expr.record at target (call parse_body p))))
       (let dot:i32 (call last_dot target))
       (when (and (lt dot 0) (not (get p P.failed)))
             (let b:(ptr buf.Buf) (call msg p at))
             (call buf.push_str b "make names a value struct or a union variant (Union.variant), got ")
             (call buf.push_bytes b target)
             (call fail p b))
       (let d:i32 (if (lt dot 0) 0 dot))
       (call ast.make_expr (call alloc.default) at (call prefix target d) (call suffix target (+ d 1)) (call parse_body p)))
      ((eq form Form.match_) (call parse_match p at))
      ((eq form Form.block) (make ast.Expr.block at (call parse_body p)))
      ((eq form Form.unsafe_) (make ast.Expr.unsafe_ at (call parse_body p)))
      ((eq form Form.match_result) (call parse_match_result p at))
      ((or (eq form Form.get_) (eq form Form.put_)) (call parse_get_put p (eq form Form.put_) at))
      ((eq form Form.with_)
       (let v:ast.Expr (call parse_expr p))
       (let fr:(ptr ast.Step) (call field_ref p "with" at))
       (call ast.with_expr (call alloc.default) at (get fr ast.Step.sname) (get fr ast.Step.fname) v (call parse_expr p)))
      ((eq form Form.sizeof) (make ast.Expr.sizeof at (call parse_sizeof_type p at)))
      ((eq form Form.return_)
       (if (eq (call peek p) compiler.Kind.rparen)
           (call ast.return_expr (call alloc.default) at (make ast.MaybeExpr.none))
           (call ast.return_expr (call alloc.default) at (make ast.MaybeExpr.some (call parse_expr p)))))
      ((eq form Form.break_) (make ast.Expr.break_ at))
      ((eq form Form.continue_) (make ast.Expr.continue_ at))
      ((eq form Form.cond) (call parse_cond p at))
      ((eq form Form.ref) (make ast.Expr.ref at (call expect_symbol p "function name in ref" at)))
      ((eq form Form.call_ref)
       (when (eq (call peek p) compiler.Kind.symbol)
             (let b:(ptr buf.Buf) (call expected_msg p (get p P.pos) "the function's type" at))
             (call buf.push_str b "; call_ref names the type first: (call_ref (fn [i32] -> i32) f args...)")
             (call fail p b)
             (return (call placeholder at)))
       (let sig:ast.Type (call parse_type p))
       (let callee:ast.Expr (call parse_expr p))
       (call ast.call_ref_expr (call alloc.default) at sig callee (call parse_body p)))
      ((eq form Form.arr_len) (call ast.arr_len_expr (call alloc.default) at (call parse_expr p)))
      ((eq form Form.ptr_null)
       (make ast.Expr.null at (call ast.ptr_type (call alloc.default) (make ast.Type.struct_ (call expect_symbol p "struct name in ptr.null" at)))))
      ((eq form Form.arr_null) (make ast.Expr.null at (call ast.arr_type (call alloc.default) (call parse_type p))))
      ((eq form Form.ptr_cast)
       (let name:str.Bytes (call expect_symbol p "struct name in ptr.cast" at))
       (call ast.cast_expr (call alloc.default) at (call ast.ptr_type (call alloc.default) (make ast.Type.struct_ name)) (call parse_expr p)))
      ((eq form Form.arr_cast)
       (let elem:ast.Type (call parse_type p))
       (call ast.cast_expr (call alloc.default) at (call ast.arr_type (call alloc.default) elem) (call parse_expr p)))
      ((eq form Form.ptr_make)
       (let name:str.Bytes (call expect_symbol p "struct name in ptr.make" at))
       (let addr:ast.Expr (call parse_expr p))
       (call ast.make_ptr_expr (call alloc.default) at (call ast.ptr_type (call alloc.default) (make ast.Type.struct_ name)) addr (call parse_expr p)))
      ((eq form Form.arr_make)
       (let elem:ast.Type (call parse_type p))
       (let addr:ast.Expr (call parse_expr p))
       (call ast.make_ptr_expr (call alloc.default) at (call ast.arr_type (call alloc.default) elem) addr (call parse_expr p)))
      ((eq form Form.ptr_gen) (call ast.addr_expr (call alloc.default) at (call parse_expr p) ast.AddrKind.ptr_gen))
      ((eq form Form.arr_gen) (call ast.addr_expr (call alloc.default) at (call parse_expr p) ast.AddrKind.arr_gen))
      ((eq form Form.ptr_addr) (call ast.addr_expr (call alloc.default) at (call parse_expr p) ast.AddrKind.ptr))
      ((eq form Form.arr_addr) (call ast.addr_expr (call alloc.default) at (call parse_expr p) ast.AddrKind.arr))
      ((eq form Form.enum_ord) (call ast.addr_expr (call alloc.default) at (call parse_expr p) ast.AddrKind.enum_))
      ((eq form Form.enum_cast)
       (let name:str.Bytes (call expect_symbol p "enum name in enum.cast" at))
       (call ast.cast_expr (call alloc.default) at (make ast.Type.enum_ name) (call parse_expr p)))
      ((eq form Form.arr_get)
       (let ty:ast.Type (call parse_type p))
       (let a:ast.Expr (call parse_expr p))
       (when (eq (call peek p) compiler.Kind.rparen)
             (call fail_here p "Unexpected token parsing expression: ')'; arr.get names the element type first: (arr.get i32 a i)")
             (return (call placeholder at)))
       (let e:ast.Expr (call ast.arr_get_expr (call alloc.default) at ty a (call parse_expr p)))
       ;; a path reads one field of a value struct element
       (while (and (neq (call peek p) compiler.Kind.rparen) (neq (call peek p) compiler.Kind.none))
         (let fr:(ptr ast.Step) (call field_ref p "arr.get" at))
         (set! e (call ast.get_expr (call alloc.default) at (get fr ast.Step.sname) (get fr ast.Step.fname) e)))
       e)
      ((eq form Form.arr_set)
       (let ty:ast.Type (call parse_type p))
       (let a:ast.Expr (call parse_expr p))
       (let ix:ast.Expr (call parse_expr p))
       (let path:(ptr (vec.Vec (ptr ast.Step))) (call (vec.make (ptr ast.Step)) (call alloc.default) 2))
       (let val:ast.Expr (call path_and_value p "arr.set" at path))
       (call ast.arr_set_expr (call alloc.default) at ty a ix val (call (to_arr (ptr ast.Step)) path)))
      ((eq form Form.fmt_surface)
       (let b:(ptr buf.Buf) (call msg p at))
       (call buf.push_str b "(")
       (call buf.push_bytes b head)
       (call buf.push_str b " ...) is expanded during import resolution; parse the file with Resolver, not Parser::parse")
       (call fail p b)
       (call placeholder at))
      ((eq form Form.mem_free)
       (call fail_str p at "there is no mem.free: memory from mem.alloc is never freed. Free single objects with std/heap, or everything in a region at once with std/arena")
       (call placeholder at))
      ((eq form Form.float_mem)
       (let b:(ptr buf.Buf) (call msg p at))
       (call buf.push_str b "there is no ")
       (call buf.push_bytes b head)
       (call buf.push_str b ": keep floats in struct fields or (arr f64), or move their bits with mem.load64/mem.store64 and f64.reinterpret_i64/i64.reinterpret_f64")
       (call fail p b)
       (call placeholder at))
      (else
       (when (not (call (map.has str.Bytes i32) (get p P.ops) head))
             (let b:(ptr buf.Buf) (call msg p at))
             (call buf.push_str b "Unknown op/keyword: ")
             (call buf.push_bytes b head)
             (call buf.push_str b "; ")
             (call push_head_hint p b head)
             (call fail p b)
             (return (call placeholder at)))
       (let op:ast.Op (enum.cast ast.Op (call (map.get_or str.Bytes i32) (get p P.ops) head 0)))
       (make ast.Expr.op at op (call parse_body p)))))

  ;; Every operator and keyword that can head a form, for "did you mean".
  (fn head_names [forms:(ptr (map.Map str.Bytes Form)) ops:(ptr (map.Map str.Bytes i32))] -> (ptr (vec.Vec str.Bytes))
    (let v:(ptr (vec.Vec str.Bytes)) (call (vec.make str.Bytes) (call alloc.default) 160))
    (let k:i32 0)
    (while (lt k (call (map.capacity str.Bytes Form) forms))
      (when (call (map.slot_used str.Bytes Form) forms k)
        (call (vec.push str.Bytes) v (call (map.slot_key str.Bytes Form) forms k)))
      (set! k (+ k 1)))
    (set! k 0)
    (while (lt k (call (map.capacity str.Bytes i32) ops))
      (when (call (map.slot_used str.Bytes i32) ops k)
        (call (vec.push str.Bytes) v (call (map.slot_key str.Bytes i32) ops k)))
      (set! k (+ k 1)))
    v)

  ;; The names, one per line, in no order (tests/test_checker_aipl.rs checks
  ;; them against src/parser.rs HEAD_NAMES).
  (fn head_names_text [] -> (ptr buf.Buf) (pub)
    (let names:(ptr (vec.Vec str.Bytes)) (call head_names (call form_table) (call op_table)))
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 1024))
    (let k:i32 0)
    (while (lt k (call (vec.len str.Bytes) names))
      (call buf.push_bytes b (call (vec.at str.Bytes) names k))
      (call buf.push_str b "\n")
      (set! k (+ k 1)))
    b)

  ;; An operator as C writes it, which AIPL spells as a form: its index in
  ;; push_head_hint's tables, or -1 (src/parser.rs c_operator).
  (fn c_operator [head:str.Bytes] -> i32
    (cond
      ((or (call str.is head "=") (call str.is head "==")) 0)
      ((call str.is head "!=") 1)
      ((call str.is head "<") 2)
      ((call str.is head ">") 3)
      ((call str.is head "<=") 4)
      ((call str.is head ">=") 5)
      ((call str.is head "&&") 6)
      ((call str.is head "||") 7)
      ((call str.is head "!") 8)
      (else -1)))

  ;; What to write after "Unknown op/keyword: HEAD; " (src/parser.rs).
  (fn push_head_hint [p:(ptr P) b:(ptr buf.Buf) head:str.Bytes] -> void
    (let names:(ptr (vec.Vec str.Bytes)) (call head_names (get p P.forms) (get p P.ops)))
    (let near:i32 (call suggest.nearest names head))
    (cond
      ((or (call str.is head "else") (call str.is head "elif") (call str.is head "switch")
           (call str.is head "case") (call str.is head "default"))
       (call buf.push_str b "there is no else if, elif, switch, or case: use (cond (test body...) ... (else body...))"))
      ((gte (call c_operator head) 0)
       (call buf.push_byte b 39)
       (call buf.push_bytes b head)
       (call buf.push_str b "' is not an operator; ")
       (let k:i32 (call c_operator head))
       (call buf.push_str b (arr.get str (arr.of str (call alloc.default) "equality" "inequality" "less than" "greater than" "at most" "at least" "and" "or" "not") k))
       (call buf.push_str b " is ")
       (call buf.push_str b (arr.get str (arr.of str (call alloc.default) "(eq a b)" "(neq a b)" "(lt a b)" "(gt a b)" "(lte a b)" "(gte a b)" "(and a b)" "(or a b)" "(not a)") k)))
      ((call str.is head "loop")
       (call buf.push_str b "loop is retired: (for i start end body...) counts from start up to end, end left out; for another step, use while"))
      ((gte near 0)
       (call buf.push_str b "did you mean ")
       (call buf.push_bytes b (call (vec.at str.Bytes) names near))
       (call buf.push_str b "?"))
      (else
       (call buf.push_str b "to call a function, write (call ")
       (call buf.push_bytes b head)
       (call buf.push_str b " args...)"))))

  (fn last_dot [s:str.Bytes] -> i32
    (let d:i32 -1)
    (for k 0 (get s str.Bytes.len) (when (eq (call str.byte_at s k) 46) (set! d k)))
    d)
  (fn prefix [s:str.Bytes n:i32] -> str.Bytes (unsafe (call str.bytes (call str.addr s) n)))
  (fn suffix [s:str.Bytes from:i32] -> str.Bytes
    (unsafe (call str.bytes (+ (call str.addr s) from) (- (get s str.Bytes.len) from))))

  ;; What follows a field-reference error (src/parser.rs FIELD_HINT).
  (fn push_field_hint [b:(ptr buf.Buf)] -> void
    (call buf.push_str b "; the struct and field are one symbol, as in (get p Point.x)"))

  ;; src/parser.rs field_ref: a Struct.field symbol split at its last '.'.
  (fn field_ref [p:(ptr P) form:str at:i32] -> (ptr ast.Step)
    (let r:(ptr ast.Step) (new ast.Step (call alloc.forever) [sname:(call str.from_str "")
                                                              fname:(call str.from_str "")]))
    (let i:i32 (call next p))
    (when (or (lt i 0) (neq (call kind_at p i) compiler.Kind.symbol))
          (let b:(ptr buf.Buf) (call msg p (if (gte i 0) (call tpos p i) at)))
          (call buf.push_str b "Expected 'Struct.field' symbol in ")
          (call buf.push_str b form)
          (call buf.push_str b ", got ")
          (if (gte i 0) (call push_token_text p b i) (call buf.push_str b "EOF"))
          (call push_field_hint b)
          (call fail p b)
          (return r))
    (let field:str.Bytes (call text p i))
    (let dot:i32 (call last_dot field))
    (when (or (lt dot 1) (eq dot (- (get field str.Bytes.len) 1)))
          (let b:(ptr buf.Buf) (call msg p at))
          (call buf.push_str b "Expected 'Struct.field' symbol in ")
          (call buf.push_str b form)
          (call buf.push_str b ", got '")
          (call buf.push_bytes b field)
          (call buf.push_byte b 39)
          (call push_field_hint b)
          (call fail p b)
          (return r))
    (put r ast.Step.sname (call prefix field dot))
    (put r ast.Step.fname (call suffix field (+ dot 1)))
    r)

  ;; src/parser.rs path_and_value: the rest of a put or arr.set, items up to
  ;; ')', the last the value, the ones before it field references (into path).
  (fn path_and_value [p:(ptr P) form:str at:i32 path:(ptr (vec.Vec (ptr ast.Step)))] -> ast.Expr
    (let items:(ptr (vec.Vec ast.Expr)) (call exprs))
    (while (and (neq (call peek p) compiler.Kind.rparen) (neq (call peek p) compiler.Kind.none))
      (call (vec.push ast.Expr) items (call parse_expr p)))
    (when (get p P.failed) (return (call placeholder at)))
    (when (eq (call (vec.len ast.Expr) items) 0)
          (let b:(ptr buf.Buf) (call msg p at))
          (call buf.push_str b form)
          (call buf.push_str b " needs a value to store: ")
          (call buf.push_str b (if (call str.same form "arr.set") "(arr.set i32 a i v) names the element type first" "(put p Point.x v)"))
          (call fail p b)
          (return (call placeholder at)))
    (let val:ast.Expr (call (vec.pop ast.Expr) items))
    (for k 0 (call (vec.len ast.Expr) items)
      (when (get p P.failed) (break))
      (match (call (vec.at ast.Expr) items k)
        (ast.Expr.var [vat name]
          (let dot:i32 (call last_dot name))
          (if (or (lt dot 1) (eq dot (- (get name str.Bytes.len) 1)))
              (block
                (let b:(ptr buf.Buf) (call msg p vat))
                (call buf.push_str b "Expected 'Struct.field' symbol in ")
                (call buf.push_str b form)
                (call buf.push_str b ", got '")
                (call buf.push_bytes b name)
                (call buf.push_byte b 39)
                (call push_field_hint b)
                (call fail p b))
              (block
                (let st:(ptr ast.Step) (new ast.Step (call alloc.forever) [sname:(call prefix name dot)
                                                                           fname:(call suffix name (+ dot 1))]))
                (call (vec.push (ptr ast.Step)) path st))))
        (else
          (let b:(ptr buf.Buf) (call msg p (call ast.at (call (vec.at ast.Expr) items k))))
          (call buf.push_str b form)
          (call buf.push_str b " takes one value to store, after its field path")
          (call fail p b))))
    val)

  ;; (get p S.f ...) / (put p S.f ... v): src/parser.rs get and put.
  (fn parse_get_put [p:(ptr P) is_put:bool at:i32] -> ast.Expr
    (let ptr:ast.Expr (call parse_expr p))
    (when is_put
          (let fr:(ptr ast.Step) (call field_ref p "put" at))
          (let path:(ptr (vec.Vec (ptr ast.Step))) (call (vec.make (ptr ast.Step)) (call alloc.default) 2))
          (let val:ast.Expr (call path_and_value p "put" at path))
          (return (call ast.put_expr (call alloc.default) at (get fr ast.Step.sname) (get fr ast.Step.fname) ptr val (call (to_arr (ptr ast.Step)) path))))
    ;; a path: one field of a value struct held in the field before it
    (let e:ast.Expr ptr)
    (let more:bool true)
    (while more
      (let fr:(ptr ast.Step) (call field_ref p "get" at))
      (set! e (call ast.get_expr (call alloc.default) at (get fr ast.Step.sname) (get fr ast.Step.fname) e))
      (when (or (get p P.failed) (or (eq (call peek p) compiler.Kind.rparen) (eq (call peek p) compiler.Kind.none)))
          (set! more false)))
    e)

  (fn parse_match [p:(ptr P) at:i32] -> ast.Expr
    (let value:ast.Expr (call parse_expr p))
    (let arms:(ptr (vec.Vec (ptr ast.Arm))) (call (vec.make (ptr ast.Arm)) (call alloc.default) 4))
    (let else_body:(arr ast.Expr) (arr.null ast.Expr))
    (while (and (neq (call peek p) compiler.Kind.rparen) (neq (call peek p) compiler.Kind.none))
      (let open:i32 (call expect p compiler.Kind.lparen))
      (let aat:i32 (if (gte open 0) (call tpos p open) at))
      (let member:str.Bytes (call expect_symbol p "Name.member or else in a match arm" aat))
      (when (and (not (get p P.failed)) (neq else_body (arr.null ast.Expr)))
          (call fail_str p aat "the (else ...) arm of a match comes last"))
      (let binders:(arr str.Bytes) (arr.null str.Bytes))
      (when (eq (call peek p) compiler.Kind.lbracket)
            (call next p)
            (let names:(ptr (vec.Vec str.Bytes)) (call (vec.make str.Bytes) (call alloc.default) 4))
            (while (and (neq (call peek p) compiler.Kind.rbracket) (neq (call peek p) compiler.Kind.none))
              (call (vec.push str.Bytes) names (call expect_symbol p "a binder name" aat)))
            (call want p compiler.Kind.rbracket)
            (set! binders (call (to_arr str.Bytes) names)))
      (let body:(arr ast.Expr) (call parse_body p))
      (call want p compiler.Kind.rparen)
      (if (call str.is member "else")
          (block
            (when (and (not (get p P.failed)) (neq binders (arr.null str.Bytes)))
                (call fail_str p aat "the else arm of a match binds nothing"))
            (set! else_body body))
          (block
            (let arm:(ptr ast.Arm) (new ast.Arm (call alloc.forever) [member:member
                                                                      binders:binders
                                                                      body:body
                                                                      at:aat]))
            (call (vec.push (ptr ast.Arm)) arms arm))))
    (call ast.match_expr (call alloc.default) at value (call (to_arr (ptr ast.Arm)) arms) else_body))

  (fn parse_match_result [p:(ptr P) at:i32] -> ast.Expr
    (let value:ast.Expr (call parse_expr p))
    (call want p compiler.Kind.lparen)
    (let i:i32 (call next p))
    (when (not (call is_sym p i "ok")) (call fail_expected p i "'ok' arm in match_result" at))
    (let ok_var:str.Bytes (call expect_symbol_hint p "ok var" at "match_result arms bind without brackets: (ok v ...) (err e ...)"))
    (let ok_body:(arr ast.Expr) (call parse_body p))
    (call want p compiler.Kind.rparen)
    (call want p compiler.Kind.lparen)
    (let j:i32 (call next p))
    (when (not (call is_sym p j "err")) (call fail_expected p j "'err' arm in match_result" at))
    (let err_var:str.Bytes (call expect_symbol_hint p "err var" at "match_result arms bind without brackets: (ok v ...) (err e ...)"))
    (let err_body:(arr ast.Expr) (call parse_body p))
    (call want p compiler.Kind.rparen)
    (call ast.match_result_expr (call alloc.default) at value ok_var ok_body err_var err_body))

  ;; (cond (c1 e...) ... (else e...)) is (if c1 (block e...) (if ... (block e...))),
  ;; each if and block at its clause's '('.
  (struct Clause [test:ast.Expr body:(arr ast.Expr) at:i32])

  (fn parse_cond [p:(ptr P) at:i32] -> ast.Expr
    (let clauses:(ptr (vec.Vec (ptr Clause))) (call (vec.make (ptr Clause)) (call alloc.default) 4))
    (let else_body:(arr ast.Expr) (arr.null ast.Expr))
    (let else_at:i32 0)
    (while (eq (call peek p) compiler.Kind.lparen)
      (let open:i32 (call expect p compiler.Kind.lparen))
      (let cat:i32 (call tpos p open))
      (when (neq else_body (arr.null ast.Expr)) (call fail_str p cat "cond: the else clause must be last"))
      (let is_else:bool (call is_sym p (get p P.pos) "else"))
      (let test:ast.Expr (call placeholder cat))
      (if is_else (set! test (call skip p test)) (set! test (call parse_expr p)))
      (let body:(arr ast.Expr) (call parse_body p))
      (call want p compiler.Kind.rparen)
      (when (and (not (get p P.failed)) (eq (arr.len body) 0)) (call fail_str p cat "cond clause needs a body"))
      (if is_else
          (block (set! else_body body) (set! else_at cat))
          (block
            (let cl:(ptr Clause) (new Clause (call alloc.forever) [test:test body:body at:cat]))
            (call (vec.push (ptr Clause)) clauses cl))))
    (when (and (not (get p P.failed)) (eq else_body (arr.null ast.Expr)))
          (call fail_str p at "cond needs a final (else ...) clause, as if needs an else branch")
          (return (call placeholder at)))
    (when (and (not (get p P.failed)) (eq (call (vec.len (ptr Clause)) clauses) 0))
        (call fail_str p at "cond needs at least one (test body...) clause before else"))
    (when (get p P.failed) (return (call placeholder at)))
    (let acc:ast.Expr (make ast.Expr.block else_at else_body))
    (let k:i32 (- (call (vec.len (ptr Clause)) clauses) 1))
    (while (gte k 0)
      (let cl:(ptr Clause) (call (vec.at (ptr Clause)) clauses k))
      (set! acc (call ast.if_expr (call alloc.default) (get cl Clause.at) (get cl Clause.test)
                      (make ast.Expr.block (get cl Clause.at) (get cl Clause.body)) acc))
      (set! k (- k 1)))
    acc)

  ;; ===== Tables =====

  (fn form [m:(ptr (map.Map str.Bytes Form)) s:str f:Form] -> void
    (call (map.set str.Bytes Form) m (call str.from_str s) f))

  (fn form_table [] -> (ptr (map.Map str.Bytes Form))
    (let m:(ptr (map.Map str.Bytes Form)) (call (map.make str.Bytes Form) (call alloc.default) 64))
    (call form m "let" Form.let_) (call form m "set!" Form.set) (call form m "if" Form.if_)
    (call form m "counted_loop" Form.loop) (call form m "for" Form.for_) (call form m "when" Form.when_) (call form m "while" Form.while_) (call form m "call" Form.call)
    (call form m "ok" Form.ok) (call form m "err" Form.err) (call form m "make" Form.make)
    (call form m "match" Form.match_) (call form m "block" Form.block) (call form m "unsafe" Form.unsafe_) (call form m "match_result" Form.match_result)
    (call form m "new" Form.fmt_surface) (call form m "get" Form.get_) (call form m "put" Form.put_)
    (call form m "sizeof" Form.sizeof) (call form m "return" Form.return_) (call form m "break" Form.break_)
    (call form m "continue" Form.continue_) (call form m "cond" Form.cond) (call form m "ref" Form.ref)
    (call form m "call_ref" Form.call_ref) (call form m "arr.len" Form.arr_len) (call form m "ptr.null" Form.ptr_null)
    (call form m "arr.null" Form.arr_null) (call form m "ptr.cast" Form.ptr_cast) (call form m "arr.cast" Form.arr_cast)
    (call form m "ptr.addr" Form.ptr_addr) (call form m "arr.addr" Form.arr_addr) (call form m "enum.ord" Form.enum_ord)
    (call form m "ptr.make" Form.ptr_make) (call form m "arr.make" Form.arr_make)
    (call form m "ptr.gen" Form.ptr_gen) (call form m "arr.gen" Form.arr_gen)
    (call form m "enum.cast" Form.enum_cast) (call form m "arr.new" Form.fmt_surface) (call form m "arr.of" Form.fmt_surface) (call form m "zero" Form.fmt_surface) (call form m "arr.get" Form.arr_get)
    (call form m "arr.set" Form.arr_set) (call form m "mem.free" Form.mem_free) (call form m "with" Form.with_)
    (call form m "mem.load_f32" Form.float_mem) (call form m "mem.load_f64" Form.float_mem)
    (call form m "mem.store_f32" Form.float_mem) (call form m "mem.store_f64" Form.float_mem)
    (call form m "format" Form.fmt_surface) (call form m "format_to" Form.fmt_surface) (call form m "print" Form.fmt_surface)
    (call form m "println" Form.fmt_surface) (call form m "eprintln" Form.fmt_surface) (call form m "dbg" Form.fmt_surface) (call form m "expect" Form.fmt_surface)
    m)

  (fn op [m:(ptr (map.Map str.Bytes i32)) s:str o:ast.Op] -> void
    (call (map.set str.Bytes i32) m (call str.from_str s) (enum.ord o)))

  ;; Operator spellings (src/parser.rs parse_expr's op table).
  (fn op_table [] -> (ptr (map.Map str.Bytes i32))
    (let m:(ptr (map.Map str.Bytes i32)) (call (map.make str.Bytes i32) (call alloc.default) 128))
    (call op m "+" ast.Op.add) (call op m "-" ast.Op.sub) (call op m "*" ast.Op.mul) (call op m "/" ast.Op.div)
    (call op m "%" ast.Op.mod) (call op m "^" ast.Op.bitxor) (call op m "shl" ast.Op.shl) (call op m "shr" ast.Op.shr)
    (call op m "shru" ast.Op.shru) (call op m "bitand" ast.Op.bitand) (call op m "bitor" ast.Op.bitor)
    (call op m "mem.load8" ast.Op.mem_load8) (call op m "mem.load32" ast.Op.mem_load32) (call op m "mem.load64" ast.Op.mem_load64)
    (call op m "mem.store8" ast.Op.mem_store8) (call op m "mem.store32" ast.Op.mem_store32) (call op m "mem.store64" ast.Op.mem_store64)
    (call op m "mem.load8_s" ast.Op.mem_load8_s) (call op m "mem.load16_u" ast.Op.mem_load16_u)
    (call op m "mem.load16_s" ast.Op.mem_load16_s) (call op m "mem.store16" ast.Op.mem_store16)
    (call op m "mem.alloc" ast.Op.mem_alloc) (call op m "mem.grow" ast.Op.mem_grow)
    (call op m "str.len" ast.Op.str_len) (call op m "str.ptr" ast.Op.str_ptr)
    (call op m "format.str" ast.Op.format_str) (call op m "format.to" ast.Op.format_to)
    (call op m "format.print" ast.Op.format_print) (call op m "format.println" ast.Op.format_println)
    (call op m "format.eprintln" ast.Op.format_eprintln) (call op m "format.piece" ast.Op.format_piece)
    (call op m "try" ast.Op.try_) (call op m "try_opt" ast.Op.try_opt) (call op m "try_or" ast.Op.try_or) (call op m "defer" ast.Op.defer) (call op m "format.dbg" ast.Op.format_dbg) (call op m "format.expect" ast.Op.format_expect)
    (call op m "atomic.add" ast.Op.atomic_add) (call op m "atomic.cas" ast.Op.atomic_cas)
    (call op m "atomic.lock" ast.Op.atomic_lock) (call op m "atomic.unlock" ast.Op.atomic_unlock)
    (call op m "eq" ast.Op.eq) (call op m "neq" ast.Op.neq) (call op m "lt" ast.Op.lt) (call op m "lte" ast.Op.lte)
    (call op m "ltu" ast.Op.ltu) (call op m "checked.add" ast.Op.checked_add) (call op m "checked.sub" ast.Op.checked_sub)
    (call op m "checked.mul" ast.Op.checked_mul) (call op m "lteu" ast.Op.lteu) (call op m "gtu" ast.Op.gtu)
    (call op m "gteu" ast.Op.gteu) (call op m "gt" ast.Op.gt) (call op m "gte" ast.Op.gte)
    (call op m "and" ast.Op.and) (call op m "or" ast.Op.or) (call op m "not" ast.Op.not)
    (call op m "sys.print" ast.Op.sys_print) (call op m "sys.time" ast.Op.sys_time) (call op m "sys.monotonic" ast.Op.sys_monotonic)
    (call op m "sys.random" ast.Op.sys_random) (call op m "sys.exit" ast.Op.sys_exit)
    (call op m "fs.open" ast.Op.fs_open) (call op m "fs.read" ast.Op.fs_read) (call op m "fs.write" ast.Op.fs_write)
    (call op m "fs.close" ast.Op.fs_close) (call op m "fs.delete" ast.Op.fs_delete)
    (call op m "fs.opendir" ast.Op.fs_opendir) (call op m "fs.readdir" ast.Op.fs_readdir) (call op m "fs.stat" ast.Op.fs_stat)
    (call op m "fs.chmod" ast.Op.fs_chmod) (call op m "fs.rename" ast.Op.fs_rename)
    (call op m "net.listen" ast.Op.net_listen) (call op m "net.accept" ast.Op.net_accept) (call op m "net.recv" ast.Op.net_recv)
    (call op m "net.send" ast.Op.net_send) (call op m "net.close" ast.Op.net_close)
    (call op m "proc.spawn" ast.Op.proc_spawn) (call op m "proc.stream" ast.Op.proc_stream) (call op m "proc.read" ast.Op.proc_read)
    (call op m "proc.write" ast.Op.proc_write) (call op m "proc.close" ast.Op.proc_close) (call op m "proc.wait" ast.Op.proc_wait)
    (call op m "proc.exec" ast.Op.proc_exec)
    (call op m "args.sizes" ast.Op.args_sizes) (call op m "args.get" ast.Op.args_get)
    (call op m "env.sizes" ast.Op.env_sizes) (call op m "env.get" ast.Op.env_get)
    (call op m "thread.spawn" ast.Op.thread_spawn) (call op m "thread.join" ast.Op.thread_join)
    (call op m "divu" ast.Op.divu) (call op m "remu" ast.Op.remu)
    (call op m "i64.extend_s" ast.Op.i64_extend_s) (call op m "f64.convert_i64_s" ast.Op.f64_convert_i64_s)
    (call op m "f32.demote" ast.Op.f32_demote) (call op m "f64.promote" ast.Op.f64_promote)
    (call op m "f32.convert_i32_s" ast.Op.f32_convert_i32_s) (call op m "f32.convert_i64_s" ast.Op.f32_convert_i64_s)
    (call op m "f64.convert_i32_s" ast.Op.f64_convert_i32_s) (call op m "i32.trunc_f32_s" ast.Op.i32_trunc_f32_s)
    (call op m "i32.trunc_f64_s" ast.Op.i32_trunc_f64_s) (call op m "i64.trunc_f32_s" ast.Op.i64_trunc_f32_s)
    (call op m "f32.reinterpret_i32" ast.Op.f32_reinterpret_i32) (call op m "i32.reinterpret_f32" ast.Op.i32_reinterpret_f32)
    (call op m "f64.sqrt" ast.Op.f64_sqrt) (call op m "i64.trunc_f64_s" ast.Op.i64_trunc_f64_s)
    (call op m "f64.reinterpret_i64" ast.Op.f64_reinterpret_i64) (call op m "i64.reinterpret_f64" ast.Op.i64_reinterpret_f64)
    (call op m "i64.extend_u" ast.Op.i64_extend_u) (call op m "i32.wrap" ast.Op.i32_wrap)
    m)

  ;; ===== Entry =====

  ;; The result of a parse: the module, or the first error's message.
  (struct Parsed [(pub module:(ptr ast.Module)) (pub ok:bool) (pub err:(ptr buf.Buf)) (pub err_at:i32)] (pub))

  ;; Parses the n tokens at toks (from compiler.tokenize over src). A bad
  ;; token (always last) is the tokenizer's error, reported first, as Rust's
  ;; tokenizer fails before its parser runs.
  (fn parse_tokens [src:i32 toks:i32 n:i32] -> (ptr Parsed) (pub)
    (let p:(ptr P) (new P (call alloc.forever) [src:src
                                                toks:toks
                                                n:n
                                                pos:0
                                                unions:(zero (ptr (map.Map str.Bytes i32)))
                                                values:(zero (ptr (map.Map str.Bytes i32)))
                                                forms:(zero (ptr (map.Map str.Bytes Form)))
                                                ops:(zero (ptr (map.Map str.Bytes i32)))
                                                err:(zero (ptr buf.Buf))
                                                err_at:(zero i32)
                                                last_at:(zero i32)
                                                failed:false]))
    (put p P.forms (call form_table))
    (put p P.ops (call op_table))
    (put p P.unions (call (map.make str.Bytes i32) (call alloc.default) 16))
    ;; the program's unions: `( union NAME`
    (for k 0 (- n 2)
      (when (and (eq (call kind_at p k) compiler.Kind.lparen) (and (call is_sym p (+ k 1) "union") (eq (call kind_at p (+ k 2)) compiler.Kind.symbol)))
          (call (map.set str.Bytes i32) (get p P.unions) (call text p (+ k 2)) 1)))
    ;; and its value structs: `( struct NAME [ ... ] ( value )` (src/parser.rs value_struct_names)
    (put p P.values (call (map.make str.Bytes i32) (call alloc.default) 16))
    (for k 0 (- n 3)
      (when (and (eq (call kind_at p k) compiler.Kind.lparen)
               (and (call is_sym p (+ k 1) "struct")
                    (and (eq (call kind_at p (+ k 2)) compiler.Kind.symbol) (eq (call kind_at p (+ k 3)) compiler.Kind.lbracket))))
            (let depth:i32 0)
            (let j:i32 (+ k 3))
            (let closed:bool false)
            (while (and (lt j n) (not closed))
              (let kj:compiler.Kind (call kind_at p j))
              (cond
                ((or (eq kj compiler.Kind.lbracket) (eq kj compiler.Kind.lparen)) (set! depth (+ depth 1)))
                ((or (eq kj compiler.Kind.rbracket) (eq kj compiler.Kind.rparen))
                 (set! depth (- depth 1))
                 (when (eq depth 0) (set! closed true)))
                (else (block)))
              (when (not closed) (set! j (+ j 1))))
            (when (and (eq (call kind_at p (+ j 1)) compiler.Kind.lparen)
                     (and (call is_sym p (+ j 2) "value") (eq (call kind_at p (+ j 3)) compiler.Kind.rparen)))
                (call (map.set str.Bytes i32) (get p P.values) (call text p (+ k 2)) 1))))
    (let r:(ptr Parsed) (new Parsed (call alloc.forever) [module:(zero (ptr ast.Module))
                                                          ok:(zero bool)
                                                          err:(zero (ptr buf.Buf))
                                                          err_at:(zero i32)]))
    (when (and (gt n 0) (eq (call kind_at p (- n 1)) compiler.Kind.bad))
          (call tokenizer_error p (- n 1))
          (put r Parsed.module (new ast.Module (call alloc.forever) [name:(zero str.Bytes)
                                                                     imports:(zero (arr (ptr ast.Import)))
                                                                     structs:(zero (arr (ptr ast.StructDef)))
                                                                     enums:(zero (arr (ptr ast.EnumDef)))
                                                                     unions:(zero (arr (ptr ast.UnionDef)))
                                                                     fns:(zero (arr (ptr ast.FnDef)))]))
          (put r Parsed.ok false)
          (put r Parsed.err (get p P.err))
          (put r Parsed.err_at (get p P.err_at))
          (return r))
    (put r Parsed.module (call parse_module p))
    (put r Parsed.ok (not (get p P.failed)))
    (put r Parsed.err (get p P.err))
    (put r Parsed.err_at (get p P.err_at))
    r)

  ;; src/parser.rs tokenize's messages for compiler.tokenize's bad token.
  (fn tokenizer_error [p:(ptr P) i:i32] -> void
    (let t:(ptr compiler.Token) (call tok p i))
    (let b:(ptr buf.Buf) (call msg p (get t compiler.Token.pos)))
    (call push_token_error b (get p P.src) t)
    (call fail p b))

  ;; The message for a bad token from compiler.tokenize over src (no position).
  (fn push_token_error [b:(ptr buf.Buf) src:i32 t:(ptr compiler.Token)] -> void (pub)
    (unsafe (let why:compiler.TokErr (enum.cast compiler.TokErr (get t compiler.Token.a)))
    (match why
      (compiler.TokErr.unterminated_string (call buf.push_str b "Unterminated string literal"))
      (compiler.TokErr.unknown_escape
       (call buf.push_str b "Unknown escape sequence \\")
       (call buf.push_byte b (mem.load8 (+ src (get t compiler.Token.pos))))
       (call buf.push_str b " in string literal"))
      (compiler.TokErr.stray_whitespace
       (call buf.push_str b "unexpected whitespace character U+")
       (call push_hex4 b (get t compiler.Token.b))
       (call buf.push_str b "; separate tokens with spaces, tabs, or newlines")))))

  ;; {:04X}: at least four uppercase hex digits.
  (fn push_hex4 [b:(ptr buf.Buf) c:i32] -> void
    (for k 0 4
      (let d:i32 (bitand (shru c (* 4 (- 3 k))) 15))
      (call buf.push_byte b (if (lt d 10) (+ d 48) (+ d 55)))))

  ;; The one expression at the start of the len bytes at src (what follows
  ;; it is ignored), for codegen.aipl's contract messages. The program's
  ;; unions are not known here, so a union named in a type parses as a
  ;; struct's name, which prints the same.
  (fn parse_expr_text [src:i32 len:i32] -> ast.Expr (pub)
    (let toks:i32 (mem.alloc (* (sizeof compiler.Token) (+ (call compiler.count_tokens src len) 1))))
    (let n:i32 (call compiler.tokenize src len toks))
    (let p:(ptr P) (new P (call alloc.forever) [src:src
                                                toks:toks
                                                n:n
                                                pos:0
                                                unions:(zero (ptr (map.Map str.Bytes i32)))
                                                values:(zero (ptr (map.Map str.Bytes i32)))
                                                forms:(zero (ptr (map.Map str.Bytes Form)))
                                                ops:(zero (ptr (map.Map str.Bytes i32)))
                                                err:(zero (ptr buf.Buf))
                                                err_at:(zero i32)
                                                last_at:(zero i32)
                                                failed:false]))
    (put p P.forms (call form_table))
    (put p P.ops (call op_table))
    (put p P.unions (call (map.make str.Bytes i32) (call alloc.default) 16))
    (put p P.values (call (map.make str.Bytes i32) (call alloc.default) 16))
    (call parse_expr p))

  ;; Tokenizes and parses len bytes at src.
  (fn parse [src:i32 len:i32] -> (ptr Parsed) (pub)
    (let toks:i32 (mem.alloc (* (sizeof compiler.Token) (+ (call compiler.count_tokens src len) 1))))
    (let n:i32 (call compiler.strip_marks src toks (call compiler.tokenize src len toks)))
    (call parse_tokens src toks n)))
