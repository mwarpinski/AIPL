;; Prints an ast.aipl module as canonical AIPL source, the way
;; src/printer.rs does, so the AIPL parser can be checked by round trip:
;; for a program the Rust printer printed, parser.aipl then printer.aipl
;; give back the same text (docs/design/CHECKER_PLAN.md).
;;
;; Float and string literals print as written in the source (src/printer.rs
;; prints the value's shortest spelling and re-escapes strings, which is the
;; same text when the source came from it), except that a tab, CR, or NUL
;; written raw inside a string prints as its escape.
(module printer
  (import alloc)
  (import ast)
  (import str)
  (import buf)

  (fn s [b:(ptr buf.Buf) x:str] -> void (call buf.push_str b x))
  (fn by [b:(ptr buf.Buf) x:str.Bytes] -> void (call buf.push_bytes b x))

  (fn print_module [m:(ptr ast.Module)] -> (ptr buf.Buf) (pub)
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 4096))
    (call s b "(module ")
    (call by b (get m ast.Module.name))
    (call s b "\n")
    (let ims:(arr (ptr ast.Import)) (get m ast.Module.imports))
    (for k 0 (arr.len ims)
      (let im:(ptr ast.Import) (arr.get (ptr ast.Import) ims k))
      (call s b "  (import ")
      (call by b (get im ast.Import.name))
      (when (call str.present (get im ast.Import.alias)) (call s b " as ") (call by b (get im ast.Import.alias)))
      (call s b ")\n"))
    (let es:(arr (ptr ast.EnumDef)) (get m ast.Module.enums))
    (for k 0 (arr.len es)
      (let e:(ptr ast.EnumDef) (arr.get (ptr ast.EnumDef) es k))
      (call s b "  (enum ")
      (call by b (get e ast.EnumDef.name))
      (call s b " [")
      (let ms:(arr (ptr ast.Member)) (get e ast.EnumDef.members))
      (for j 0 (arr.len ms)
        (let mem:(ptr ast.Member) (arr.get (ptr ast.Member) ms j))
        (when (gt j 0) (call s b " "))
        (call s b "(")
        (call by b (get mem ast.Member.name))
        (call s b " ")
        (call buf.push_int b (get mem ast.Member.value))
        (call s b ")"))
      (call s b "])\n"))
    (let us:(arr (ptr ast.UnionDef)) (get m ast.Module.unions))
    (for k 0 (arr.len us)
      (let u:(ptr ast.UnionDef) (arr.get (ptr ast.UnionDef) us k))
      (call s b "  (union ")
      (call by b (get u ast.UnionDef.name))
      (call s b " [")
      (let vs:(arr (ptr ast.Variant)) (get u ast.UnionDef.variants))
      (for j 0 (arr.len vs)
        (let v:(ptr ast.Variant) (arr.get (ptr ast.Variant) vs j))
        (when (gt j 0) (call s b " "))
        (call s b "(")
        (call by b (get v ast.Variant.name))
        (let fs:(arr (ptr ast.Field)) (get v ast.Variant.fields))
        (for q 0 (arr.len fs)
          (call s b " ")
          (call field b (arr.get (ptr ast.Field) fs q)))
        (call s b ")"))
      (call s b "])\n"))
    (let ss:(arr (ptr ast.StructDef)) (get m ast.Module.structs))
    (for k 0 (arr.len ss)
      (let st:(ptr ast.StructDef) (arr.get (ptr ast.StructDef) ss k))
      (call s b "  (struct ")
      (call by b (get st ast.StructDef.name))
      (call s b " [")
      (let fs:(arr (ptr ast.Field)) (get st ast.StructDef.fields))
      (for j 0 (arr.len fs)
        (when (gt j 0) (call s b " "))
        (call field b (arr.get (ptr ast.Field) fs j)))
      (call s b (if (get st ast.StructDef.value) "] (value))\n" "])\n")))
    (let fns:(arr (ptr ast.FnDef)) (get m ast.Module.fns))
    (for k 0 (arr.len fns)
      (call print_fn b (arr.get (ptr ast.FnDef) fns k)))
    (call s b ")")
    b)

  (fn field [b:(ptr buf.Buf) f:(ptr ast.Field)] -> void
    (call by b (get f ast.Field.name))
    (call s b ":")
    (call print_type b (get f ast.Field.ty)))

  (fn print_fn [b:(ptr buf.Buf) f:(ptr ast.FnDef)] -> void
    (call s b "  (fn ")
    (call by b (get f ast.FnDef.name))
    (call s b " [")
    (let ps:(arr (ptr ast.Param)) (get f ast.FnDef.params))
    (for j 0 (arr.len ps)
      (let prm:(ptr ast.Param) (arr.get (ptr ast.Param) ps j))
      (when (gt j 0) (call s b " "))
      (call by b (get prm ast.Param.name))
      (call s b ":")
      (call print_type b (get prm ast.Param.ty)))
    (call s b "] -> ")
    (call print_type b (get f ast.FnDef.ret))
    (when (get f ast.FnDef.unsafe_) (call s b "\n    (unsafe)"))
    (when (get f ast.FnDef.no_leak) (call s b "\n    (no_leak)"))
    (let cs:(arr ast.Contract) (get f ast.FnDef.contracts))
    (for j 0 (arr.len cs)
      (call s b "\n    (")
      (match (arr.get ast.Contract cs j)
        (ast.Contract.requires [e] (call s b "req ") (call print_expr b e))
        (ast.Contract.ensures [e] (call s b "ens ") (call print_expr b e))
        (ast.Contract.invariant [e] (call s b "inv ") (call print_expr b e)))
      (call s b ")"))
    (let body:(arr ast.Expr) (get f ast.FnDef.body))
    (for j 0 (arr.len body)
      (call s b "\n    ")
      (call print_expr b (arr.get ast.Expr body j)))
    (call s b ")\n"))

  (fn print_type [b:(ptr buf.Buf) t:ast.Type] -> void (pub)
    (match t
      (ast.Type.i32 (call s b "i32"))
      (ast.Type.u8 (call s b "u8"))
      (ast.Type.i8 (call s b "i8"))
      (ast.Type.u16 (call s b "u16"))
      (ast.Type.i16 (call s b "i16"))
      (ast.Type.i64 (call s b "i64"))
      (ast.Type.f32 (call s b "f32"))
      (ast.Type.f64 (call s b "f64"))
      (ast.Type.bool (call s b "bool"))
      (ast.Type.str (call s b "str"))
      (ast.Type.void (call s b "void"))
      (ast.Type.ptr [n_ptr] (let inner:ast.Type (get n_ptr ast.PtrType.inner)) (call s b "(ptr ") (call print_type b inner) (call s b ")"))
      (ast.Type.struct_ [name] (call by b name))
      (ast.Type.result [n_result] (let ok_t:ast.Type (get n_result ast.ResultType.ok)) (let err_t:ast.Type (get n_result ast.ResultType.err)) (call s b "(result ") (call print_type b ok_t) (call s b " ") (call print_type b err_t) (call s b ")"))
      (ast.Type.arr [n_arr] (let elem:ast.Type (get n_arr ast.ArrType.elem)) (call s b "(arr ") (call print_type b elem) (call s b ")"))
      (ast.Type.fn_ [n_fn] (let params:(arr ast.Type) (get n_fn ast.FnType.params)) (let ret:ast.Type (get n_fn ast.FnType.ret))
       (call s b "(fn [")
       (for j 0 (arr.len params)
         (when (gt j 0) (call s b " "))
         (call print_type b (arr.get ast.Type params j)))
       (call s b "] -> ")
       (call print_type b ret)
       (when (get n_fn ast.FnType.no_leak) (call s b " (no_leak)"))
       (call s b ")"))
      (ast.Type.enum_ [name] (call by b name))
      (ast.Type.union_ [name] (call by b name))))

  ;; src/printer.rs struct_name / elem: a ptr or arr type's inner name.
  (fn print_inner [b:(ptr buf.Buf) t:ast.Type] -> void
    (match t
      (ast.Type.ptr [n_ptr] (let inner:ast.Type (get n_ptr ast.PtrType.inner)) (call print_type b inner))
      (ast.Type.arr [n_arr] (let elem:ast.Type (get n_arr ast.ArrType.elem)) (call print_type b elem))
      (else (call print_type b t))))

  (fn print_raw_string [b:(ptr buf.Buf) raw:str.Bytes] -> void
    (call s b "\"")
    (for k 0 (get raw str.Bytes.len)
      (let c:i32 (call str.byte_at raw k))
      (cond
        ((eq c 9) (call s b "\\t"))
        ((eq c 13) (call s b "\\r"))
        ((eq c 0) (call s b "\\0"))
        (else (call buf.push_byte b c))))
    (call s b "\""))

  (fn print_float [b:(ptr buf.Buf) t:str.Bytes] -> void (call by b t))

  ;; (head e1 e2 ...), or (head) for no expressions.
  (fn with_body [b:(ptr buf.Buf) body:(arr ast.Expr)] -> void
    (for j 0 (arr.len body)
      (call s b " ")
      (call print_expr b (arr.get ast.Expr body j)))
    (call s b ")"))

  ;; A put's or arr.set's field path: ` S.f V.g` (src/printer.rs path_str).
  (fn print_path [b:(ptr buf.Buf) path:(arr (ptr ast.Step))] -> void
    (for k 0 (arr.len path)
      (let st:(ptr ast.Step) (arr.get (ptr ast.Step) path k))
      (call s b " ") (call by b (get st ast.Step.sname)) (call s b ".") (call by b (get st ast.Step.fname))))

  ;; body less the empty block a parser ends a when's body with, if it is last.
  (fn without_last_empty [body:(arr ast.Expr)] -> (arr ast.Expr)
    (let n:i32 (arr.len body))
    (when (eq n 0) (return body))
    (let last_empty:bool (match (arr.get ast.Expr body (- n 1)) (ast.Expr.block [_ items] (eq (arr.len items) 0)) (else false)))
    (when (not last_empty) (return body))
    (let out:(arr ast.Expr) (arr.new ast.Expr (call alloc.forever) (- n 1)))
    (for k 0 (- n 1) (arr.set ast.Expr out k (arr.get ast.Expr body k)))
    out)

  ;; The body of the tree (when c body...) reads into (src/parser.rs): a then
  ;; that is a block and an else that is an empty one; else null.
  (fn when_body [t:ast.Expr f:ast.Expr] -> (arr ast.Expr)
    (match f
      (ast.Expr.block [_ none]
       (if (eq (arr.len none) 0)
           (match t (ast.Expr.block [_ body] (call without_last_empty body)) (else (arr.null ast.Expr)))
           (arr.null ast.Expr)))
      (else (arr.null ast.Expr))))

  (fn print_expr [b:(ptr buf.Buf) e:ast.Expr] -> void (pub)
    (match e
      (ast.Expr.lit_int [_ iv] (call buf.push_i64 b iv))
      (ast.Expr.lit_i64 [_ lv] (call buf.push_i64 b lv) (call s b "i64"))
      (ast.Expr.lit_float [_ text] (call print_float b text))
      (ast.Expr.lit_f32 [_ text] (call by b text))
      (ast.Expr.lit_bool [_ bv] (call s b (if bv "true" "false")))
      (ast.Expr.lit_str [_ raw] (call print_raw_string b raw))
      (ast.Expr.var [_ name] (call by b name))
      (ast.Expr.let_ [n_let] (let name:str.Bytes (get n_let ast.LetExpr.name)) (let ty:ast.Type (get n_let ast.LetExpr.ty)) (let val:ast.Expr (get n_let ast.LetExpr.val))
       (call s b "(let ") (call by b name) (call s b ":") (call print_type b ty) (call s b " ") (call print_expr b val) (call s b ")"))
      (ast.Expr.set [n_set] (let name:str.Bytes (get n_set ast.SetExpr.name)) (let val:ast.Expr (get n_set ast.SetExpr.val)) (call s b "(set! ") (call by b name) (call s b " ") (call print_expr b val) (call s b ")"))
      (ast.Expr.if_ [n_if] (let c:ast.Expr (get n_if ast.IfExpr.cond)) (let t:ast.Expr (get n_if ast.IfExpr.then_)) (let f:ast.Expr (get n_if ast.IfExpr.else_))
       (let wbody:(arr ast.Expr) (call when_body t f))
       (if (neq wbody (arr.null ast.Expr))
           (block (call s b "(when ") (call print_expr b c) (call with_body b wbody))
           (block (call s b "(if ") (call print_expr b c) (call s b " ") (call print_expr b t) (call s b " ") (call print_expr b f) (call s b ")"))))
      (ast.Expr.loop [n_loop] (let var:str.Bytes (get n_loop ast.LoopExpr.var)) (let start:ast.Expr (get n_loop ast.LoopExpr.start)) (let end:ast.Expr (get n_loop ast.LoopExpr.end)) (let step:ast.Expr (get n_loop ast.LoopExpr.step)) (let body:(arr ast.Expr) (get n_loop ast.LoopExpr.body))
       (call s b "(counted_loop ") (call by b var) (call s b " ") (call print_expr b start) (call s b " ")
       (call print_expr b end) (call s b " ") (call print_expr b step) (call with_body b body))
      (ast.Expr.while_ [n_while] (let c:ast.Expr (get n_while ast.WhileExpr.cond)) (let body:(arr ast.Expr) (get n_while ast.WhileExpr.body)) (call s b "(while ") (call print_expr b c) (call with_body b body))
      (ast.Expr.call [_ fname args] (call s b "(call ") (call by b fname) (call with_body b args))
      (ast.Expr.op [_ op args] (call s b "(") (call s b (call op_name op)) (call with_body b args))
      (ast.Expr.ok [n_ok] (let val:ast.Expr (get n_ok ast.OkExpr.val)) (let oty:ast.MaybeType (get n_ok ast.OkExpr.ty)) (call print_result b "ok" val oty))
      (ast.Expr.err [n_err] (let val:ast.Expr (get n_err ast.ErrExpr.val)) (let oty:ast.MaybeType (get n_err ast.ErrExpr.ty)) (call print_result b "err" val oty))
      (ast.Expr.match_result [n_match_result] (let val:ast.Expr (get n_match_result ast.MatchResultExpr.val)) (let ok_var:str.Bytes (get n_match_result ast.MatchResultExpr.ok_var)) (let ok_body:(arr ast.Expr) (get n_match_result ast.MatchResultExpr.ok_body)) (let err_var:str.Bytes (get n_match_result ast.MatchResultExpr.err_var)) (let err_body:(arr ast.Expr) (get n_match_result ast.MatchResultExpr.err_body))
       (call s b "(match_result ") (call print_expr b val)
       (call s b " (ok ") (call by b ok_var) (call with_body b ok_body)
       (call s b " (err ") (call by b err_var) (call with_body b err_body)
       (call s b ")"))
      (ast.Expr.block [_ body] (call s b "(block") (call with_body b body))
      (ast.Expr.unsafe_ [_ body] (call s b "(unsafe") (call with_body b body))
      (ast.Expr.get_ [n_get] (let sname:str.Bytes (get n_get ast.GetExpr.sname)) (let fname:str.Bytes (get n_get ast.GetExpr.fname)) (let ptr:ast.Expr (get n_get ast.GetExpr.ptr))
       (call s b "(get ") (call print_expr b ptr) (call s b " ") (call by b sname) (call s b ".") (call by b fname) (call s b ")"))
      (ast.Expr.put_ [n_put] (let sname:str.Bytes (get n_put ast.PutExpr.sname)) (let fname:str.Bytes (get n_put ast.PutExpr.fname)) (let ptr:ast.Expr (get n_put ast.PutExpr.ptr)) (let val:ast.Expr (get n_put ast.PutExpr.val)) (let path:(arr (ptr ast.Step)) (get n_put ast.PutExpr.path))
       (call s b "(put ") (call print_expr b ptr) (call s b " ") (call by b sname) (call s b ".") (call by b fname)
       (call print_path b path)
       (call s b " ") (call print_expr b val) (call s b ")"))
      (ast.Expr.sizeof [_ st] (call s b "(sizeof ") (call print_type b st) (call s b ")"))
      (ast.Expr.arr_get [n_arr_get] (let ty:ast.Type (get n_arr_get ast.ArrGetExpr.ty)) (let ptr:ast.Expr (get n_arr_get ast.ArrGetExpr.ptr)) (let index:ast.Expr (get n_arr_get ast.ArrGetExpr.index))
       (call s b "(arr.get ") (call print_type b ty) (call s b " ") (call print_expr b ptr) (call s b " ") (call print_expr b index) (call s b ")"))
      (ast.Expr.arr_set [n_arr_set] (let ty:ast.Type (get n_arr_set ast.ArrSetExpr.ty)) (let ptr:ast.Expr (get n_arr_set ast.ArrSetExpr.ptr)) (let index:ast.Expr (get n_arr_set ast.ArrSetExpr.index)) (let val:ast.Expr (get n_arr_set ast.ArrSetExpr.val)) (let path:(arr (ptr ast.Step)) (get n_arr_set ast.ArrSetExpr.path))
       (call s b "(arr.set ") (call print_type b ty) (call s b " ") (call print_expr b ptr) (call s b " ")
       (call print_expr b index) (call print_path b path) (call s b " ") (call print_expr b val) (call s b ")"))
      (ast.Expr.arr_len [n_arr_len] (let a:ast.Expr (get n_arr_len ast.ArrLenExpr.arr)) (call s b "(arr.len ") (call print_expr b a) (call s b ")"))
      (ast.Expr.null [_ ty]
       (match ty
         (ast.Type.arr [_] (call s b "(arr.null ") (call print_inner b ty) (call s b ")"))
         (else (call s b "(ptr.null ") (call print_inner b ty) (call s b ")"))))
      (ast.Expr.cast [n_cast] (let ty:ast.Type (get n_cast ast.CastExpr.ty)) (let addr:ast.Expr (get n_cast ast.CastExpr.addr))
       (match ty
         (ast.Type.arr [_] (call s b "(arr.cast ") (call print_inner b ty))
         (ast.Type.enum_ [name] (call s b "(enum.cast ") (call by b name))
         (else (call s b "(ptr.cast ") (call print_inner b ty)))
       (call s b " ") (call print_expr b addr) (call s b ")"))
      (ast.Expr.make_ptr [n_make_ptr] (let ty:ast.Type (get n_make_ptr ast.MakePtrExpr.ty)) (let addr:ast.Expr (get n_make_ptr ast.MakePtrExpr.addr)) (let g:ast.Expr (get n_make_ptr ast.MakePtrExpr.gen))
       (match ty
         (ast.Type.arr [_] (call s b "(arr.make ") (call print_inner b ty))
         (else (call s b "(ptr.make ") (call print_inner b ty)))
       (call s b " ") (call print_expr b addr) (call s b " ") (call print_expr b g) (call s b ")"))
      (ast.Expr.make [n_make] (let uname:str.Bytes (get n_make ast.MakeExpr.uname)) (let variant:str.Bytes (get n_make ast.MakeExpr.variant)) (let args:(arr ast.Expr) (get n_make ast.MakeExpr.args))
       (call s b "(make ") (call by b uname) (call s b ".") (call by b variant) (call with_body b args))
      (ast.Expr.record [_ sname args] (call s b "(make ") (call by b sname) (call with_body b args))
      (ast.Expr.with_ [n_with] (let sname:str.Bytes (get n_with ast.WithExpr.sname)) (let fname:str.Bytes (get n_with ast.WithExpr.fname)) (let val:ast.Expr (get n_with ast.WithExpr.val)) (let nv:ast.Expr (get n_with ast.WithExpr.new))
       (call s b "(with ") (call print_expr b val) (call s b " ") (call by b sname) (call s b ".") (call by b fname)
       (call s b " ") (call print_expr b nv) (call s b ")"))
      (ast.Expr.match_ [n_match] (let val:ast.Expr (get n_match ast.MatchExpr.val)) (let arms:(arr (ptr ast.Arm)) (get n_match ast.MatchExpr.arms)) (let else_body:(arr ast.Expr) (get n_match ast.MatchExpr.else_body))
       (call s b "(match ") (call print_expr b val)
       (for j 0 (arr.len arms)
         (let arm:(ptr ast.Arm) (arr.get (ptr ast.Arm) arms j))
         (call s b " (")
         (call by b (get arm ast.Arm.member))
         (let names:(arr str.Bytes) (get arm ast.Arm.binders))
         (when (neq names (arr.null str.Bytes))
               (call s b " [")
               (for q 0 (arr.len names)
                 (when (gt q 0) (call s b " "))
                 (call by b (arr.get str.Bytes names q)))
               (call s b "]"))
         (call with_body b (get arm ast.Arm.body)))
       (when (neq else_body (arr.null ast.Expr)) (call s b " (else") (call with_body b else_body))
       (call s b ")"))
      (ast.Expr.return_ [n_return] (let rv:ast.MaybeExpr (get n_return ast.ReturnExpr.val))
       (match rv
         (ast.MaybeExpr.none (call s b "(return)"))
         (ast.MaybeExpr.some [v] (call s b "(return ") (call print_expr b v) (call s b ")"))))
      (ast.Expr.break_ [_] (call s b "(break)"))
      (ast.Expr.continue_ [_] (call s b "(continue)"))
      (ast.Expr.ref [_ name] (call s b "(ref ") (call by b name) (call s b ")"))
      (ast.Expr.call_ref [n_call_ref] (let sig:ast.Type (get n_call_ref ast.CallRefExpr.sig)) (let callee:ast.Expr (get n_call_ref ast.CallRefExpr.func)) (let args:(arr ast.Expr) (get n_call_ref ast.CallRefExpr.args))
       (call s b "(call_ref ") (call print_type b sig) (call s b " ") (call print_expr b callee) (call with_body b args))
      (ast.Expr.addr [n_addr] (let val:ast.Expr (get n_addr ast.AddrExpr.val)) (let kind:ast.AddrKind (get n_addr ast.AddrExpr.kind))
       (call s b (match kind (ast.AddrKind.ptr "(ptr.addr ") (ast.AddrKind.arr "(arr.addr ") (ast.AddrKind.enum_ "(enum.ord ")
                         (ast.AddrKind.ptr_gen "(ptr.gen ") (ast.AddrKind.arr_gen "(arr.gen ")))
       (call print_expr b val) (call s b ")"))))

  (fn print_result [b:(ptr buf.Buf) head:str val:ast.Expr ty:ast.MaybeType] -> void
    (call s b "(")
    (call s b head)
    (match ty
      (ast.MaybeType.none (block))
      (ast.MaybeType.some [t] (call s b ":") (call print_type b t)))
    (call s b " ")
    (call print_expr b val)
    (call s b ")"))

  ;; src/printer.rs op_name.
  (fn op_name [o:ast.Op] -> str (pub)
    (match o
      (ast.Op.add "+") (ast.Op.sub "-") (ast.Op.mul "*") (ast.Op.div "/") (ast.Op.mod "%")
      (ast.Op.divu "divu") (ast.Op.remu "remu") (ast.Op.bitxor "^") (ast.Op.shl "shl") (ast.Op.shr "shr")
      (ast.Op.shru "shru") (ast.Op.bitand "bitand") (ast.Op.bitor "bitor")
      (ast.Op.mem_load8 "mem.load8") (ast.Op.mem_load32 "mem.load32") (ast.Op.mem_load64 "mem.load64")
      (ast.Op.mem_store8 "mem.store8") (ast.Op.mem_store32 "mem.store32") (ast.Op.mem_store64 "mem.store64")
      (ast.Op.mem_load8_s "mem.load8_s") (ast.Op.mem_load16_u "mem.load16_u") (ast.Op.mem_load16_s "mem.load16_s")
      (ast.Op.mem_store16 "mem.store16")
      (ast.Op.mem_alloc "mem.alloc") (ast.Op.mem_grow "mem.grow")
      (ast.Op.atomic_add "atomic.add") (ast.Op.atomic_cas "atomic.cas") (ast.Op.atomic_lock "atomic.lock") (ast.Op.atomic_unlock "atomic.unlock")
      (ast.Op.eq "eq") (ast.Op.neq "neq") (ast.Op.lt "lt") (ast.Op.lte "lte")
      (ast.Op.checked_add "checked.add") (ast.Op.checked_sub "checked.sub") (ast.Op.checked_mul "checked.mul")
      (ast.Op.ltu "ltu") (ast.Op.lteu "lteu") (ast.Op.gtu "gtu") (ast.Op.gteu "gteu") (ast.Op.gt "gt") (ast.Op.gte "gte")
      (ast.Op.and "and") (ast.Op.or "or") (ast.Op.not "not")
      (ast.Op.sys_print "sys.print") (ast.Op.sys_time "sys.time") (ast.Op.sys_monotonic "sys.monotonic")
      (ast.Op.sys_random "sys.random") (ast.Op.sys_exit "sys.exit")
      (ast.Op.fs_open "fs.open") (ast.Op.fs_read "fs.read") (ast.Op.fs_write "fs.write") (ast.Op.fs_close "fs.close") (ast.Op.fs_delete "fs.delete") (ast.Op.fs_opendir "fs.opendir") (ast.Op.fs_readdir "fs.readdir") (ast.Op.fs_stat "fs.stat") (ast.Op.fs_chmod "fs.chmod")
      (ast.Op.net_listen "net.listen") (ast.Op.net_accept "net.accept") (ast.Op.net_recv "net.recv") (ast.Op.net_send "net.send") (ast.Op.net_close "net.close")
