;; Import resolution in AIPL (P14). Turns a program spread over several files
;; into one flat, import-free source text: the input codegen.compile_module
;; takes. Mirrors src/resolver.rs, which stays as the reference:
;;   - (import m) searches the importing file's directory, the entry file's
;;     directory, then the standard library directory (AIPL_SPEC.md 11);
;;   - imports resolve depth-first, each module once (diamonds), and a module
;;     that imports itself through a chain is an error (cycles);
;;   - inside an imported module m, its own functions and structs become
;;     m.name, and alias-qualified names (u.f for (import util as u)) become
;;     canonical (util.f); the entry module keeps bare names;
;;   - output order: every struct, then every function, imported modules
;;     first in resolution order, then the entry module.
;; Comments are not carried over. After those two directories it searches the
;; standard library directory the host passes, then each entry of the
;; colon-separated AIPL_PATH environment variable (read with std/os).
(module resolver
  (import alloc)
  (import compiler)
  (import str)
  (import io)
  (import buf)
  (import map)
  (import os)
  (import generics)
  (import origins)
  (import parser)

  ;; A parsed file: its text, its (module ...) tree, and where its tokens'
  ;; origins are noted (file is its index there; -1 and null when not mapping).
  ;; error: why the file is not one well-formed (module NAME ...) form,
  ;; "PATH: L:C: message" as src/resolver.rs reports it, or null.
  (struct Src [text:(ptr str.Bytes) root:(ptr compiler.Node) file:i32 origins:(ptr origins.Origins) error:(ptr buf.Buf) path:(ptr str.Bytes)])

  ;; One module being emitted. prefix is the import name; imported is false
  ;; for the entry module, whose names stay bare. aliases maps an alias to the
  ;; address of the canonical module name (ptr str.Bytes).
  ;; templates holds the module's own generic templates; known, shared with
  ;; the State, the canonical names of every resolved module's templates.
  ;; decls holds the module's constants and enums.
  (struct Mod [src:(ptr Src) prefix:(ptr str.Bytes) imported:bool
               fns:(ptr (map.Map (ptr str.Bytes) i32)) structs:(ptr (map.Map (ptr str.Bytes) i32)) decls:(ptr (map.Map (ptr str.Bytes) i32))
               aliases:(ptr (map.Map (ptr str.Bytes) (ptr str.Bytes)))
               templates:(ptr (map.Map (ptr str.Bytes) i32)) known:(ptr (map.Map (ptr str.Bytes) i32))
               vis:(ptr Vis) name:(ptr str.Bytes) paths:(ptr (map.Map (ptr str.Bytes) (ptr str.Bytes)))
               item:(ptr compiler.Node) err:(ptr buf.Buf)])

  ;; What modules give each other (resolver.rs Vis): the canonical names of
  ;; (pub) items, and each struct's fields with their levels (0 private,
  ;; 1 (read x:T), 2 (pub x:T)).
  (struct Vis [public:(ptr (map.Map (ptr str.Bytes) i32))
               fields:(ptr (map.Map (ptr str.Bytes) (ptr (map.Map (ptr str.Bytes) i32))))])

  (struct State [entry_dir:(ptr str.Bytes) lib_dirs:(ptr str.Bytes)
                 done:(ptr (map.Map (ptr str.Bytes) i32)) active:(ptr (map.Map (ptr str.Bytes) i32))
                 structs_out:(ptr buf.Buf) fns_out:(ptr buf.Buf) err:(ptr buf.Buf)
                 known:(ptr (map.Map (ptr str.Bytes) i32))
                 paths:(ptr (map.Map (ptr str.Bytes) (ptr str.Bytes)))
                 found:(ptr (map.Map (ptr str.Bytes) (ptr str.Bytes)))
                 origins:(ptr origins.Origins) vis:(ptr Vis)])

  ;; Host-facing result: ok 1 with the flat source, or ok 0 with an error message.
  (struct Out [ok:i32 addr:i32 len:i32])

  ;; ===== Byte-string helpers =====

  (fn slice [t:(ptr str.Bytes) start:i32 len:i32] -> (ptr str.Bytes)
    (unsafe (call str.bytes (+ (get t str.Bytes.addr) start) len)))

  (fn concat [a:(ptr str.Bytes) b:(ptr str.Bytes)] -> (ptr str.Bytes)
    (let out:(ptr buf.Buf) (call buf.make (call alloc.default) (+ (get a str.Bytes.len) (get b str.Bytes.len))))
    (call buf.push_bytes out a)
    (call buf.push_bytes out b)
    (call buf.bytes out))

  (fn last_index [t:(ptr str.Bytes) c:i32] -> i32
    (let found:i32 -1)
    (loop i 0 (- (get t str.Bytes.len) 1) 1
      (if (eq (call str.byte_at t i) c) (set! found i) (block)))
    found)

  (fn eq_lit [t:(ptr str.Bytes) lit:str] -> bool
    (call str.bytes_eq t (call str.from_str lit)))

  ;; The directory part of a path, with its trailing '/', or "" for a bare name.
  (fn dirname [path:(ptr str.Bytes)] -> (ptr str.Bytes)
    (call slice path 0 (+ (call last_index path 47) 1)))

  ;; d with a trailing '/', so a file name can be appended.
  (fn as_dir [d:(ptr str.Bytes)] -> (ptr str.Bytes)
    (if (eq (call str.byte_at d (- (get d str.Bytes.len) 1)) 47) d (call concat d (call str.from_str "/"))))

  ;; ===== Parsed trees =====

  (fn load [path:(ptr str.Bytes) o:(ptr origins.Origins)] -> (ptr Src)
    (let text:(ptr str.Bytes) (call io.read_path path))
    (if (lt (get text str.Bytes.len) 0) (return (ptr.null Src)) (block))
    (let src:(ptr Src) (new Src))
    ;; not in the origins until it has read cleanly
    (put src Src.file -1)
    (put src Src.origins (ptr.null origins.Origins))
    (put src Src.text text)
    (put src Src.path path)
    (put src Src.error (ptr.null buf.Buf))
    (if (not (call str.valid_utf8 text))
        (block
          (put src Src.error (call path_message path))
          (call buf.push_str (get src Src.error) "Cannot read: stream did not contain valid UTF-8")
          (return src))
        (block))
    (let n:i32 (get text str.Bytes.len))
    (let tok:i32 (mem.alloc (* (sizeof compiler.Token) (+ (call compiler.count_tokens (get text str.Bytes.addr) n) 1))))
    (let count:i32 (call compiler.tokenize (get text str.Bytes.addr) n tok))
    (let problem:(ptr buf.Buf) (call structure_error (get text str.Bytes.addr) tok count))
    (if (neq problem (ptr.null buf.Buf))
        (block
          (put src Src.error (call path_message path))
          (call buf.push_bytes (get src Src.error) (call buf.bytes problem))
          (return src))
        (block))
    (let ast:i32 (mem.alloc (+ 8 (* (sizeof compiler.Node) (+ count 2)))))
    (put src Src.root (call compiler.parse_ast tok count ast))
    (put src Src.origins o)
    (put src Src.file (if (eq o (ptr.null origins.Origins)) -1 (call origins.add_file o path text)))
    src)

  ;; Names a loaded file in compiled code's line table (origins.File.name).
  (fn name_file [src:(ptr Src) name:(ptr str.Bytes)] -> void
    (if (and (neq src (ptr.null Src)) (and (gte (get src Src.file) 0) (neq (get src Src.origins) (ptr.null origins.Origins))))
        (put (call origins.file_at (get src Src.origins) (get src Src.file)) origins.File.name name)
        (block)))

  (fn first_child [g:(ptr compiler.Node)] -> (ptr compiler.Node)
    (get g compiler.Node.first))

  (fn nth [g:(ptr compiler.Node) i:i32] -> (ptr compiler.Node)
    (let c:(ptr compiler.Node) (call first_child g))
    (loop k 1 i 1
      (if (eq c (ptr.null compiler.Node)) (return c) (block))
      (set! c (get c compiler.Node.next)))
    c)

  ;; Source text of a symbol-like atom (symbol, i64 or float literal, string body).
  (fn text [src:(ptr Src) n:(ptr compiler.Node)] -> (ptr str.Bytes)
    (call slice (get src Src.text) (get n compiler.Node.a) (get n compiler.Node.b)))

  (fn is_symbol [n:(ptr compiler.Node)] -> bool
    (if (eq n (ptr.null compiler.Node)) false (eq (get n compiler.Node.kind) compiler.Kind.symbol)))

  ;; The head symbol of a (...) group, or "" when it has none.
  (fn head [src:(ptr Src) g:(ptr compiler.Node)] -> (ptr str.Bytes)
    (if (neq (get g compiler.Node.kind) compiler.Kind.paren) (return (call str.from_str "")) (block))
    (let h:(ptr compiler.Node) (call first_child g))
    (if (call is_symbol h) (call text src h) (call str.from_str "")))

  ;; ===== Renaming =====
  ;; Roles: 0 none, 1 function name, 2 struct name, 3 field reference S.f.

  (fn rename [m:(ptr Mod) t:(ptr str.Bytes) role:i32] -> (ptr str.Bytes)
    (unsafe (if (eq role 0) (return (call rename_decl m t)) (block))
    (let len:i32 (get t str.Bytes.len))
    (if (eq role 3)
        (block
          ;; S.f: rename the struct part, up to the last '.'
          (let dot:i32 (call last_index t 46))
          (if (lt dot 0) (return t) (block))
          (return (call concat (call rename m (call slice t 0 dot) 2) (call slice t dot (- len dot)))))
        (block))
    (let dot:i32 (call str.find_byte t 46))
    (if (gte dot 0)
        (block
          ;; alias.rest -> canonical.rest; any other qualified name is left alone
          (let alias:(ptr str.Bytes) (call slice t 0 dot))
          (if (call (map.has (ptr str.Bytes) (ptr str.Bytes)) (get m Mod.aliases) alias)
              (return (call concat (call (map.get_or (ptr str.Bytes) (ptr str.Bytes)) (get m Mod.aliases) alias (call str.bytes 0 -1))
                                   (call slice t dot (- len dot))))
              (return t)))
        (block))
    (let own:(ptr (map.Map (ptr str.Bytes) i32)) (if (eq role 1) (get m Mod.fns) (get m Mod.structs)))
    ;; a struct-name position may also hold an enum (a template's type argument)
    (if (and (get m Mod.imported) (or (call (map.has (ptr str.Bytes) i32) own t)
                                      (and (eq role 2) (call (map.has (ptr str.Bytes) i32) (get m Mod.decls) t))))
        (call concat (call concat (get m Mod.prefix) (call str.from_str ".")) t)
        t)))

  ;; A name in any position (resolver.rs rename_decl): one of this module's
  ;; constants or enums (MAX, Color), an enum member (Color.red), or an
  ;; alias-qualified name (c.MAX, c.Color.red). Anything else is unchanged.
  (fn rename_decl [m:(ptr Mod) t:(ptr str.Bytes)] -> (ptr str.Bytes)
    (unsafe (let len:i32 (get t str.Bytes.len))
    (let dot:i32 (call str.find_byte t 46))
    (if (and (gte dot 0) (call (map.has (ptr str.Bytes) (ptr str.Bytes)) (get m Mod.aliases) (call slice t 0 dot)))
        (return (call concat (call (map.get_or (ptr str.Bytes) (ptr str.Bytes)) (get m Mod.aliases) (call slice t 0 dot) (call str.bytes 0 -1))
                             (call slice t dot (- len dot))))
        (block))
    (if (not (get m Mod.imported)) (return t) (block))
    (let last:i32 (call last_index t 46))
    (if (or (call (map.has (ptr str.Bytes) i32) (get m Mod.decls) t)
            (and (gte last 0) (call (map.has (ptr str.Bytes) i32) (get m Mod.decls) (call slice t 0 last))))
        (call concat (call concat (get m Mod.prefix) (call str.from_str ".")) t)
        t)))

  ;; resolver.rs path_step: whether item k of a form with n items is a
  ;; further step of a field path (a put's or arr.set's value comes last).
  (fn path_step [h:(ptr str.Bytes) k:i32 n:i32] -> bool
    (cond
      ((call eq_lit h "get") (gte k 3))
      ((call eq_lit h "put") (and (gte k 3) (lt (+ k 1) n)))
      ((call eq_lit h "arr.get") (gte k 4))
      ((call eq_lit h "arr.set") (and (gte k 4) (lt (+ k 1) n)))
      (else false)))

  ;; Which role child i of group g plays, from the group's head symbol.
  (fn child_role [m:(ptr Mod) g:(ptr compiler.Node) i:i32] -> i32
    (let h:(ptr str.Bytes) (call head (get m Mod.src) g))
    (cond
      ((eq i 1)
       (cond
         ((or (call eq_lit h "fn") (or (call eq_lit h "call") (call eq_lit h "ref"))) 1)
         ((or (call eq_lit h "struct") (or (call eq_lit h "new") (or (call eq_lit h "sizeof")
            (or (call eq_lit h "ptr") (or (call eq_lit h "ptr.null") (call eq_lit h "ptr.cast")))))) 2)
         (else 0)))
      ((eq i 2) (if (or (call eq_lit h "get") (or (call eq_lit h "put") (call eq_lit h "with"))) 3 0))
      (else 0)))

  ;; ===== Printing =====

  (fn emit [m:(ptr Mod) n:(ptr compiler.Node) role:i32 out:(ptr buf.Buf)] -> void
    (let k:compiler.Kind (get n compiler.Node.kind))
    (let src:(ptr Src) (get m Mod.src))
    (if (and (neq k compiler.Kind.paren) (neq k compiler.Kind.bracket)) (call note m n out) (block))
    (cond
      ((or (eq k compiler.Kind.paren) (eq k compiler.Kind.bracket)) (call emit_group m n out))
      ((eq k compiler.Kind.symbol)
       (let renamed:(ptr str.Bytes) (call rename m (call text src n) role))
       (call buf.push_bytes out renamed)
       (cond
         ((or (eq role 1) (eq role 2)) (call check_item m renamed n))
         ;; a field reference S.f is checked with its get or put
         ((eq role 3) (block))
         (else (call check_decl m renamed n))))
      ((or (eq k compiler.Kind.int64) (eq k compiler.Kind.float)) (call buf.push_bytes out (call text src n)))
      ;; an int as written (its value is only the low 32 bits)
      ((eq k compiler.Kind.int) (call buf.push_bytes out (call slice (get src Src.text) (get n compiler.Node.a) (get n compiler.Node.b))))
      ((eq k compiler.Kind.bool) (call buf.push_str out (if (eq (get n compiler.Node.a) 0) "false" "true")))
      ((eq k compiler.Kind.string)
       (call buf.push_byte out 34)
       (call buf.push_bytes out (call text src n))
       (call buf.push_byte out 34))
      ((eq k compiler.Kind.colon) (call buf.push_byte out 58))
      ((eq k compiler.Kind.arrow) (call buf.push_str out "->"))
      (else (block))))

  ;; The canonical name of a group head that names a generic template: one
  ;; of this module's own, or another module's through an alias or by its
  ;; canonical name (resolver.rs template_ref). len -1 if h is not a template.
  (fn template_ref [m:(ptr Mod) h:(ptr str.Bytes)] -> (ptr str.Bytes)
    (unsafe (if (call (map.has (ptr str.Bytes) i32) (get m Mod.templates) h)
        (return (if (get m Mod.imported) (call concat (call concat (get m Mod.prefix) (call str.from_str ".")) h) h))
        (block))
    (let dot:i32 (call str.find_byte h 46))
    (if (and (gte dot 0) (call (map.has (ptr str.Bytes) (ptr str.Bytes)) (get m Mod.aliases) (call slice h 0 dot)))
        (block
          (let c:(ptr str.Bytes) (call concat (call (map.get_or (ptr str.Bytes) (ptr str.Bytes)) (get m Mod.aliases) (call slice h 0 dot) (call str.bytes 0 -1))
                                              (call slice h dot (- (get h str.Bytes.len) dot))))
          (if (call (map.has (ptr str.Bytes) i32) (get m Mod.known) c) (return c) (block)))
        (block))
    (if (call (map.has (ptr str.Bytes) i32) (get m Mod.known) h) (return h) (block))
    ;; an interface's function, (Hash.hash K): the interface's name, qualified
    (let last:i32 (call last_index h 46))
    (if (gte last 0)
        (block
          (let c:(ptr str.Bytes) (call template_ref m (call slice h 0 last)))
          (if (gte (get c str.Bytes.len) 0) (return (call concat c (call slice h last (- (get h str.Bytes.len) last)))) (block)))
        (block))
    (call str.bytes 0 -1)))

  ;; Children separated by spaces, except none around ':' (x:i32, ok:T). A
  ;; group whose head names a generic template prints its canonical name,
  ;; and its type arguments are renamed as struct names (a module's own
  ;; struct passed to a template, `(alloc Pair)`, becomes `m.Pair`).
  ;; Notes where the next token printed into out comes from (origins.aipl).
  (fn note [m:(ptr Mod) n:(ptr compiler.Node) out:(ptr buf.Buf)] -> void
    (let src:(ptr Src) (get m Mod.src))
    (call origins.note (get src Src.origins) out (get src Src.file) (get n compiler.Node.pos)))

  ;; Notes where group g's closing bracket came from (an error can point at it).
  (fn note_close [m:(ptr Mod) g:(ptr compiler.Node) out:(ptr buf.Buf)] -> void
    (let src:(ptr Src) (get m Mod.src))
    (if (gte (get g compiler.Node.a) 0) (call origins.note (get src Src.origins) out (get src Src.file) (get g compiler.Node.a)) (block)))

  (fn emit_group [m:(ptr Mod) g:(ptr compiler.Node) out:(ptr buf.Buf)] -> void
    (unsafe (let square:bool (eq (get g compiler.Node.kind) compiler.Kind.bracket))
    (call note m g out)
    (call buf.push_byte out (if square 91 40))
    (let c:(ptr compiler.Node) (call first_child g))
    (let tmpl:(ptr str.Bytes) (call str.bytes 0 -1))
    (if (and (not square) (call is_symbol c))
        (set! tmpl (call template_ref m (call text (get m Mod.src) c)))
        (block))
    (let i:i32 0)
    (let prev_colon:bool true)
    (let is_match:bool (and (not square) (call eq_lit (call head (get m Mod.src) g) "match")))
    (let gh:(ptr str.Bytes) (call head (get m Mod.src) g))
    (let members:bool (and (not square) (or (call eq_lit gh "interface") (call eq_lit gh "impl"))))
    (let decl_list:bool (and (not square) (or (call eq_lit gh "union") (call eq_lit gh "enum"))))
    (let field_op:bool (and (not square) (or (call eq_lit gh "get") (or (call eq_lit gh "put") (call eq_lit gh "with")))))
    ;; (with v V.f x) makes a value with field f written
    (let put:bool (and (not square) (or (call eq_lit gh "put") (call eq_lit gh "with"))))
    (let n_items:i32 (call count_kids g))
    (let top:bool (eq g (get m Mod.item)))
    ;; the struct of a generic field form, (get p (Name T) f)
    (let generic_struct:(ptr str.Bytes) (ptr.null str.Bytes))
    (while (neq c (ptr.null compiler.Node))
      (let colon:bool (eq (get c compiler.Node.kind) compiler.Kind.colon))
      (cond
        ;; an item's (pub) is taken out (emit_module checked where it is)
        ((and top (call is_pub_clause m c)) (block))
        (else
      (if (or prev_colon colon) (block) (call buf.push_byte out 32))
      (cond
        ((and top (and (eq i 2) (and (call eq_lit gh "struct") (neq (get c compiler.Node.kind) compiler.Kind.paren)))) (call emit_fields m c out))
        ((and is_match (and (gte i 2) (eq (get c compiler.Node.kind) compiler.Kind.paren))) (call emit_arm m c out))
        ((and decl_list (and (eq i 2) (eq (get c compiler.Node.kind) compiler.Kind.bracket))) (call emit_decl_members m c out))
        ((and members (and (gte i 2) (call eq_lit (call head (get m Mod.src) c) "fn"))) (call emit_member m c (call eq_lit gh "impl") out))
        ((and (eq i 0) (gte (get tmpl str.Bytes.len) 0))
         ;; a template, or an interface's function (Hash.hash T)
         (call check_item m (if (call (map.has (ptr str.Bytes) i32) (get m Mod.known) tmpl) tmpl (call before_last_dot tmpl)) c)
         (call note m c out) (call buf.push_bytes out tmpl))
        ;; the head of a (...) form is a keyword or an op (mem.alloc), never renamed
        ((and (eq i 0) (and (not square) (call is_symbol c))) (call note m c out) (call buf.push_bytes out (call text (get m Mod.src) c)))
        ((gte (get tmpl str.Bytes.len) 0)
         (call emit m c 2 out)
         ;; a struct type argument lets the template make one
         (if (call is_symbol c) (call check_makes m (call rename m (call text (get m Mod.src) c) 2) c) (block)))
        (else
         (let role:i32 (call child_role m g i))
         (call emit m c role out)
         (if (call is_symbol c)
             (block
               (let sym:(ptr str.Bytes) (call rename m (call text (get m Mod.src) c) role))
               (cond
                 ((and (eq i 1) (call eq_lit gh "new")) (call check_makes m sym c))
                 ;; (make V ...) of a value struct
                 ((and (eq i 1) (call eq_lit gh "make")) (call check_makes m sym c))
                 ;; (get p S.f), (put p S.f v)
                 ((and field_op (eq i 2))
                  (let dot:i32 (call last_index sym 46))
                  (if (gte dot 0)
                      (block
                        (let sname:(ptr str.Bytes) (call slice sym 0 dot))
                        (call check_item m sname c)
                        (call check_field m sname (call slice sym (+ dot 1) (- (get sym str.Bytes.len) (+ dot 1))) put c))
                      (block)))
                 ((and field_op (and (eq i 3) (neq generic_struct (ptr.null str.Bytes))))
                  (call check_field m generic_struct sym put c))
                 ;; a field path's further steps
                 ((and (not square) (call path_step gh i n_items))
                  (let pdot:i32 (call last_index sym 46))
                  (if (gte pdot 0)
                      (call check_field m (call slice sym 0 pdot) (call slice sym (+ pdot 1) (- (get sym str.Bytes.len) (+ pdot 1)))
                            (or put (call eq_lit gh "arr.set")) c)
                      (block)))
                 (else (block))))
             (if (and field_op (eq i 2))
                 (block
                   (let gh2:(ptr str.Bytes) (call head (get m Mod.src) c))
                   (let gt:(ptr str.Bytes) (call template_ref m gh2))
                   (set! generic_struct (if (gte (get gt str.Bytes.len) 0) gt gh2)))
                 (block)))))
      (set! prev_colon colon)))
      (set! i (+ i 1))
      (set! c (get c compiler.Node.next)))
    (call note_close m g out)
    (call buf.push_byte out (if square 93 41))))

  ;; ===== Visibility (resolver.rs Vis, Names::check_*) =====

  ;; (value): a value struct's mark.
  (fn is_value_mark [m:(ptr Mod) n:(ptr compiler.Node)] -> bool
    (and (neq n (ptr.null compiler.Node))
         (and (eq (get n compiler.Node.kind) compiler.Kind.paren)
              (and (eq (call count_kids n) 1) (call eq_lit (call head (get m Mod.src) n) "value")))))

  ;; resolver.rs is_value_struct: (struct NAME [fields] (value) ...).
  (fn is_value_struct [m:(ptr Mod) item:(ptr compiler.Node)] -> bool
    (and (call eq_lit (call head (get m Mod.src) item) "struct") (call is_value_mark m (call nth item 3))))

  (fn is_pub_clause [m:(ptr Mod) n:(ptr compiler.Node)] -> bool
    (and (eq (get n compiler.Node.kind) compiler.Kind.paren)
         (and (eq (call count_kids n) 1) (call eq_lit (call head (get m Mod.src) n) "pub"))))

  (fn count_kids [g:(ptr compiler.Node)] -> i32
    (let k:i32 0)
    (let c:(ptr compiler.Node) (call first_child g))
    (while (neq c (ptr.null compiler.Node)) (set! k (+ k 1)) (set! c (get c compiler.Node.next)))
    k)

  (fn before_last_dot [t:(ptr str.Bytes)] -> (ptr str.Bytes)
    (let dot:i32 (call last_index t 46))
    (if (lt dot 0) t (call slice t 0 dot)))

  ;; "PATH: L:C: msg" for node n, the first error only.
  (fn vis_fail [m:(ptr Mod) n:(ptr compiler.Node) msg:(ptr buf.Buf)] -> void
    (if (neq (get m Mod.err) (ptr.null buf.Buf)) (return) (block))
    (let src:(ptr Src) (get m Mod.src))
    (let lc:(ptr compiler.LineCol) (call compiler.line_col (get (get src Src.text) str.Bytes.addr) (get n compiler.Node.pos)))
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 160))
    (call buf.push_bytes b (get src Src.path))
    (call buf.push_str b ": ")
    (call buf.push_int b (get lc compiler.LineCol.line))
    (call buf.push_byte b 58)
    (call buf.push_int b (get lc compiler.LineCol.col))
    (call buf.push_str b ": ")
    (call buf.push_bytes b (call buf.bytes msg))
    (put m Mod.err b))

  (fn vis_msg [s:str] -> (ptr buf.Buf)
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 96))
    (call buf.push_str b s)
    b)

  ;; The module a canonical name belongs to, if it is another module; else len -1.
  (fn foreign [m:(ptr Mod) name:(ptr str.Bytes)] -> (ptr str.Bytes)
    (unsafe (let dot:i32 (call str.find_byte name 46))
    (if (lt dot 0) (return (call str.bytes 0 -1)) (block))
    (let first:(ptr str.Bytes) (call slice name 0 dot))
    (if (and (not (call str.bytes_eq first (get m Mod.name))) (call (map.has (ptr str.Bytes) (ptr str.Bytes)) (get m Mod.paths) first))
        first
        (call str.bytes 0 -1))))

  ;; name (canonical) may be used here: it is this module's, or (pub).
  (fn check_item [m:(ptr Mod) name:(ptr str.Bytes) n:(ptr compiler.Node)] -> void
    (let fm:(ptr str.Bytes) (call foreign m name))
    (if (and (gte (get fm str.Bytes.len) 0) (not (call (map.has (ptr str.Bytes) i32) (get (get m Mod.vis) Vis.public) name)))
        (block
          (let b:(ptr buf.Buf) (call vis_msg "'"))
          (call buf.push_bytes b name)
          (call buf.push_str b "' is private to module ")
          (call buf.push_bytes b fm)
          (call buf.push_str b ": mark it (pub) there to use it here")
          (call vis_fail m n b))
        (block)))

  ;; A constant, enum, union, or one of their members: the declaration is
  ;; the first two parts.
  (fn check_decl [m:(ptr Mod) name:(ptr str.Bytes) n:(ptr compiler.Node)] -> void
    (if (lt (get (call foreign m name) str.Bytes.len) 0) (return) (block))
    (let first:i32 (call str.find_byte name 46))
    (let rest:(ptr str.Bytes) (call slice name (+ first 1) (- (get name str.Bytes.len) (+ first 1))))
    (let second:i32 (call str.find_byte rest 46))
    (call check_item m (if (lt second 0) name (call slice name 0 (+ (+ first 1) second))) n))

  ;; Made outside its module: every field must be (pub).
  (fn check_makes [m:(ptr Mod) name:(ptr str.Bytes) n:(ptr compiler.Node)] -> void
    (let fm:(ptr str.Bytes) (call foreign m name))
    (if (lt (get fm str.Bytes.len) 0) (return) (block))
    (let fields:(ptr (map.Map (ptr str.Bytes) i32))
         (call (map.get_or (ptr str.Bytes) (ptr (map.Map (ptr str.Bytes) i32))) (get (get m Mod.vis) Vis.fields) name (ptr.null (map.Map (ptr str.Bytes) i32))))
    (if (eq fields (ptr.null (map.Map (ptr str.Bytes) i32))) (return) (block))
    (let closed:bool false)
    (loop i 0 (- (call (map.capacity (ptr str.Bytes) i32) fields) 1) 1
      (if (and (call (map.slot_used (ptr str.Bytes) i32) fields i) (neq (call (map.slot_val (ptr str.Bytes) i32) fields i) 2))
          (set! closed true)
          (block)))
    (if closed
        (block
          (let b:(ptr buf.Buf) (call vis_msg "'"))
          (call buf.push_bytes b name)
          (call buf.push_str b "' has fields private to module ")
          (call buf.push_bytes b fm)
          (call buf.push_str b ", so only ")
          (call buf.push_bytes b fm)
          (call buf.push_str b " can make one")
          (call vis_fail m n b))
        (block)))

  ;; Field f of struct s (canonical), read (get) or written (put).
  (fn check_field [m:(ptr Mod) s:(ptr str.Bytes) f:(ptr str.Bytes) put:bool n:(ptr compiler.Node)] -> void
    (let fm:(ptr str.Bytes) (call foreign m s))
    (if (lt (get fm str.Bytes.len) 0) (return) (block))
    (let fields:(ptr (map.Map (ptr str.Bytes) i32))
         (call (map.get_or (ptr str.Bytes) (ptr (map.Map (ptr str.Bytes) i32))) (get (get m Mod.vis) Vis.fields) s (ptr.null (map.Map (ptr str.Bytes) i32))))
    (let level:i32 (if (eq fields (ptr.null (map.Map (ptr str.Bytes) i32))) 0 (call (map.get_or (ptr str.Bytes) i32) fields f 0)))
    (if (or (eq level 0) (and put (eq level 1)))
        (block
          (let b:(ptr buf.Buf) (call vis_msg "field '"))
          (call buf.push_bytes b f)
          (call buf.push_str b "' of ")
          (call buf.push_bytes b s)
          (call buf.push_str b (if (eq level 0) " is private to module " " is read-only outside module "))
          (call buf.push_bytes b fm)
          (call vis_fail m n b))
        (block)))

  ;; A struct's field list with (read x:T) and (pub x:T) made plain x:T.
  (fn emit_fields [m:(ptr Mod) g:(ptr compiler.Node) out:(ptr buf.Buf)] -> void
    (call note m g out)
    (call buf.push_byte out (if (eq (get g compiler.Node.kind) compiler.Kind.bracket) 91 40))
    (let c:(ptr compiler.Node) (call first_child g))
    (let prev_colon:bool true)
    (while (neq c (ptr.null compiler.Node))
      (if (call field_group m c)
          (block
            (let p:(ptr compiler.Node) (get (call first_child c) compiler.Node.next))
            (while (neq p (ptr.null compiler.Node))
              (let pc:bool (eq (get p compiler.Node.kind) compiler.Kind.colon))
              (if (or prev_colon pc) (block) (call buf.push_byte out 32))
              (call emit m p 0 out)
              (set! prev_colon pc)
              (set! p (get p compiler.Node.next))))
          (block
            (let colon:bool (eq (get c compiler.Node.kind) compiler.Kind.colon))
            (if (or prev_colon colon) (block) (call buf.push_byte out 32))
            (call emit m c 0 out)
            (set! prev_colon colon)))
      (set! c (get c compiler.Node.next)))
    (call note_close m g out)
    (call buf.push_byte out (if (eq (get g compiler.Node.kind) compiler.Kind.bracket) 93 41)))

  (fn field_group [m:(ptr Mod) c:(ptr compiler.Node)] -> bool
    (let h:(ptr str.Bytes) (call head (get m Mod.src) c))
    (or (call eq_lit h "pub") (call eq_lit h "read")))

  ;; resolver.rs take_pub: whether item has (pub) where it belongs; a (pub)
  ;; anywhere else is an error.
  (fn take_pub [m:(ptr Mod) item:(ptr compiler.Node)] -> bool
    (let h:(ptr str.Bytes) (call head (get m Mod.src) item))
    ;; a value struct's (value) is part of its signature
    (let value:bool (and (call eq_lit h "struct") (call is_value_struct m item)))
    (let place:i32 (cond
                     ((or (call eq_lit h "fn") (call eq_lit h "const")) 5)
                     ((and (call eq_lit h "struct") value) 4)
                     ((or (call eq_lit h "struct") (or (call eq_lit h "union") (call eq_lit h "enum"))) 3)
                     ((call eq_lit h "interface") 2)
                     (else -1)))
    (if (neq (get item compiler.Node.kind) compiler.Kind.paren) (return false) (block))
    ;; (struct S [fields] (pub) (value))
    (let third:(ptr compiler.Node) (call nth item 3))
    (if (and (call eq_lit h "struct")
             (and (neq third (ptr.null compiler.Node))
                  (and (call is_pub_clause m third) (call is_value_mark m (call nth item 4)))))
        (block (call vis_fail m third (call vis_msg "(pub) comes right after the signature: (fn f [params] -> type (pub) ...), (struct S [fields] (pub)), (struct S [fields] (value) (pub)), (union U [variants] (pub)), (enum E [members] (pub)), (const NAME:type value (pub)), (interface (Name T) (pub) ...)")) (return false))
        (block))
    (let at:(ptr compiler.Node) (if (gte place 0) (call nth item place) (ptr.null compiler.Node)))
    (let found:bool (and (neq at (ptr.null compiler.Node)) (call is_pub_clause m at)))
    (let c:(ptr compiler.Node) (get (call first_child item) compiler.Node.next))
    (while (neq c (ptr.null compiler.Node))
      (if (and (call is_pub_clause m c) (not (and found (eq c at))))
          (block
            (call vis_fail m c (call vis_msg (if (call eq_lit h "impl")
                                                 "an implementation takes no (pub): it is as visible as its interface and its type"
                                                 "(pub) comes right after the signature: (fn f [params] -> type (pub) ...), (struct S [fields] (pub)), (struct S [fields] (value) (pub)), (union U [variants] (pub)), (enum E [members] (pub)), (const NAME:type value (pub)), (interface (Name T) (pub) ...)")))
            (return false))
          (block))
      (set! c (get c compiler.Node.next)))
    found)

  ;; resolver.rs take_field_marks: a struct's fields and their levels.
  (fn field_levels [m:(ptr Mod) item:(ptr compiler.Node)] -> (ptr (map.Map (ptr str.Bytes) i32))
    (let levels:(ptr (map.Map (ptr str.Bytes) i32)) (call (map.make (ptr str.Bytes) i32) (call alloc.default) 8))
    (let list:(ptr compiler.Node) (call nth item 2))
    (if (or (eq list (ptr.null compiler.Node)) (and (neq (get list compiler.Node.kind) compiler.Kind.paren) (neq (get list compiler.Node.kind) compiler.Kind.bracket)))
        (return levels)
        (block))
    (let src:(ptr Src) (get m Mod.src))
    (let k:i32 0)
    (let c:(ptr compiler.Node) (call first_child list))
    (while (neq c (ptr.null compiler.Node))
      (if (call field_group m c)
          (block
            (let nm:(ptr compiler.Node) (call nth c 1))
            (let ok:bool (and (eq (call count_kids c) 4)
                              (and (call is_symbol nm) (eq (get (call nth c 2) compiler.Node.kind) compiler.Kind.colon))))
            (if (or (not ok) (neq (% k 3) 0))
                (block (call vis_fail m c (call vis_msg "a field is written x:T, (read x:T), or (pub x:T)")) (return levels))
                (block))
            (call (map.set (ptr str.Bytes) i32) levels (call text src nm) (if (call eq_lit (call head src c) "pub") 2 1))
            (set! k (+ k 3)))
          (block
            (if (and (eq (% k 3) 0) (call is_symbol c))
                (if (call (map.has (ptr str.Bytes) i32) levels (call text src c))
                    (block)
                    (call (map.set (ptr str.Bytes) i32) levels (call text src c) 0))
                (block))
            (set! k (+ k 1))))
      (set! c (get c compiler.Node.next)))
    levels)

  ;; The name of an item: (fn NAME ...) or a template's (NAME T...); len -1.
  (fn item_name [m:(ptr Mod) item:(ptr compiler.Node)] -> (ptr str.Bytes)
    (unsafe (let n:(ptr compiler.Node) (call nth item 1))
    (cond
      ((eq n (ptr.null compiler.Node)) (call str.bytes 0 -1))
      ((call is_symbol n) (call text (get m Mod.src) n))
      ((and (eq (get n compiler.Node.kind) compiler.Kind.paren) (call is_symbol (call first_child n))) (call text (get m Mod.src) (call first_child n)))
      (else (call str.bytes 0 -1)))))

  ;; resolver.rs check_exposure: a (pub) item shows no private type of
  ;; this module in what it gives others.
  (fn check_exposure [m:(ptr Mod) own_pub:(ptr (map.Map (ptr str.Bytes) i32)) own_levels:(ptr (map.Map (ptr str.Bytes) (ptr (map.Map (ptr str.Bytes) i32))))] -> void
    (let src:(ptr Src) (get m Mod.src))
    (let own_types:(ptr (map.Map (ptr str.Bytes) i32)) (call (map.make (ptr str.Bytes) i32) (call alloc.default) 16))
    (let it:(ptr compiler.Node) (call first_item src))
    (while (neq it (ptr.null compiler.Node))
      (let h:(ptr str.Bytes) (call head src it))
      (if (and (or (call eq_lit h "struct") (or (call eq_lit h "union") (call eq_lit h "enum"))) (gte (get (call item_name m it) str.Bytes.len) 0))
          (call (map.set (ptr str.Bytes) i32) own_types (call item_name m it) 1)
          (block))
      (set! it (get it compiler.Node.next)))
    (set! it (call first_item src))
    (while (neq it (ptr.null compiler.Node))
      (let name:(ptr str.Bytes) (call item_name m it))
      (if (and (not (call eq_lit (call head src it) "import")) (and (gte (get name str.Bytes.len) 0) (call (map.has (ptr str.Bytes) i32) own_pub name)))
          (block
            (let types:(ptr (vec.Vec (ptr compiler.Node))) (call (vec.make (ptr compiler.Node)) (call alloc.default) 8))
            (let h:(ptr str.Bytes) (call head src it))
            (cond
              ((and (call eq_lit h "fn") (gte (call count_kids it) 5))
               (call third_of_triples (call nth it 2) types)
               (call (vec.push (ptr compiler.Node)) types (call nth it 4)))
              ((call eq_lit h "struct")
               (let levels:(ptr (map.Map (ptr str.Bytes) i32))
                    (call (map.get_or (ptr str.Bytes) (ptr (map.Map (ptr str.Bytes) i32))) own_levels name (ptr.null (map.Map (ptr str.Bytes) i32))))
               (call readable_field_types m (call nth it 2) levels types))
              ((call eq_lit h "union")
               (let vlist:(ptr compiler.Node) (call nth it 2))
               (let v:(ptr compiler.Node) (if (eq vlist (ptr.null compiler.Node)) vlist (call first_child vlist)))
               (while (neq v (ptr.null compiler.Node))
                 (call third_of_triples_from v 1 types)
                 (set! v (get v compiler.Node.next))))
              ((call eq_lit h "interface")
               (let f:(ptr compiler.Node) (call nth it 2))
               (while (neq f (ptr.null compiler.Node))
                 (if (gte (call count_kids f) 5)
                     (block
                       (call third_of_triples (call nth f 2) types)
                       (call (vec.push (ptr compiler.Node)) types (call nth f 4)))
                     (block))
                 (set! f (get f compiler.Node.next))))
              (else (block)))
            (loop k 0 (- (call (vec.len (ptr compiler.Node)) types) 1) 1
              (let bad:(ptr compiler.Node) (call private_in m (call (vec.at (ptr compiler.Node)) types k) own_types own_pub))
              (if (neq bad (ptr.null compiler.Node))
                  (block
                    (let bt:(ptr str.Bytes) (call text src bad))
                    (let b:(ptr buf.Buf) (call vis_msg "'"))
                    (call buf.push_bytes b name)
                    (call buf.push_str b "' is (pub) but its signature uses '")
                    (call buf.push_bytes b bt)
                    (call buf.push_str b "', which is private: mark '")
                    (call buf.push_bytes b bt)
                    (call buf.push_str b "' (pub) too")
                    (call vis_fail m bad b)
                    (return))
                  (block))))
          (block))
      (set! it (get it compiler.Node.next))))

  ;; The third of each triple of g's children (a parameter's type).
  (fn third_of_triples [g:(ptr compiler.Node) out:(ptr (vec.Vec (ptr compiler.Node)))] -> void
    (if (eq g (ptr.null compiler.Node)) (return) (block))
    (call third_of_triples_from g 0 out))

  (fn third_of_triples_from [g:(ptr compiler.Node) skip:i32 out:(ptr (vec.Vec (ptr compiler.Node)))] -> void
    (let c:(ptr compiler.Node) (call first_child g))
    (loop s 1 skip 1 (if (neq c (ptr.null compiler.Node)) (set! c (get c compiler.Node.next)) (block)))
    (let k:i32 0)
    (while (neq c (ptr.null compiler.Node))
      (if (eq (% k 3) 2) (call (vec.push (ptr compiler.Node)) out c) (block))
      (set! k (+ k 1))
      (set! c (get c compiler.Node.next))))

  ;; The types of a struct's readable fields, groups made plain.
  (fn readable_field_types [m:(ptr Mod) list:(ptr compiler.Node) levels:(ptr (map.Map (ptr str.Bytes) i32)) out:(ptr (vec.Vec (ptr compiler.Node)))] -> void
    (if (eq list (ptr.null compiler.Node)) (return) (block))
    (let src:(ptr Src) (get m Mod.src))
    ;; plain triples: the name, then the type two further on
    (let pending:(ptr compiler.Node) (ptr.null compiler.Node))
    (let k:i32 0)
    (let c:(ptr compiler.Node) (call first_child list))
    (while (neq c (ptr.null compiler.Node))
      (if (call field_group m c)
          (block
            (if (call readable m levels (call nth c 1)) (call (vec.push (ptr compiler.Node)) out (call nth c 3)) (block))
            (set! k (+ k 3)))
          (block
            (if (eq (% k 3) 0) (set! pending c) (block))
            (if (and (eq (% k 3) 2) (call readable m levels pending)) (call (vec.push (ptr compiler.Node)) out c) (block))
            (set! k (+ k 1))))
      (set! c (get c compiler.Node.next))))

  (fn readable [m:(ptr Mod) levels:(ptr (map.Map (ptr str.Bytes) i32)) name:(ptr compiler.Node)] -> bool
    (and (neq levels (ptr.null (map.Map (ptr str.Bytes) i32)))
         (and (call is_symbol name) (neq (call (map.get_or (ptr str.Bytes) i32) levels (call text (get m Mod.src) name) 0) 0))))

  ;; resolver.rs private_in: the first name in type t of one of this
  ;; module's types that is not (pub), or null.
  (fn private_in [m:(ptr Mod) t:(ptr compiler.Node) own_types:(ptr (map.Map (ptr str.Bytes) i32)) own_pub:(ptr (map.Map (ptr str.Bytes) i32))] -> (ptr compiler.Node)
    (let k:compiler.Kind (get t compiler.Node.kind))
    (if (and (neq k compiler.Kind.paren) (neq k compiler.Kind.bracket))
        (return (if (call is_bad m t own_types own_pub) t (ptr.null compiler.Node)))
        (block))
    (let c:(ptr compiler.Node) (call first_child t))
    (if (eq c (ptr.null compiler.Node)) (return c) (block))
    (if (call is_bad m c own_types own_pub) (return c) (block))
    (set! c (get c compiler.Node.next))
    (while (neq c (ptr.null compiler.Node))
      (let b:(ptr compiler.Node) (call private_in m c own_types own_pub))
      (if (neq b (ptr.null compiler.Node)) (return b) (block))
      (set! c (get c compiler.Node.next)))
    (ptr.null compiler.Node))

  (fn is_bad [m:(ptr Mod) n:(ptr compiler.Node) own_types:(ptr (map.Map (ptr str.Bytes) i32)) own_pub:(ptr (map.Map (ptr str.Bytes) i32))] -> bool
    (and (call is_symbol n)
         (and (call (map.has (ptr str.Bytes) i32) own_types (call text (get m Mod.src) n))
              (not (call (map.has (ptr str.Bytes) i32) own_pub (call text (get m Mod.src) n))))))

  ;; A union's variants or an enum's members, [(circle r:f64) ...]
  ;; (resolver.rs walk): the head of each is a member's name, even one a
  ;; template of this module also has.
  (fn emit_decl_members [m:(ptr Mod) g:(ptr compiler.Node) out:(ptr buf.Buf)] -> void
    (call note m g out)
    (call buf.push_byte out 91)
    (let c:(ptr compiler.Node) (call first_child g))
    (let first:bool true)
    (while (neq c (ptr.null compiler.Node))
      (if first (block) (call buf.push_byte out 32))
      (set! first false)
      (if (eq (get c compiler.Node.kind) compiler.Kind.paren)
          (block
            (call note m c out)
            (call buf.push_byte out 40)
            (let p:(ptr compiler.Node) (call first_child c))
            (let i:i32 0)
            (let prev_colon:bool true)
            (while (neq p (ptr.null compiler.Node))
              (let colon:bool (eq (get p compiler.Node.kind) compiler.Kind.colon))
              (if (or prev_colon colon) (block) (call buf.push_byte out 32))
              (if (and (eq i 0) (call is_symbol p))
                  (block (call note m p out) (call buf.push_bytes out (call text (get m Mod.src) p)))
                  (call emit m p 0 out))
              (set! prev_colon colon)
              (set! i (+ i 1))
              (set! p (get p compiler.Node.next)))
            (call note_close m c out)
            (call buf.push_byte out 41))
          (call emit m c 0 out))
      (set! c (get c compiler.Node.next)))
    (call note_close m g out)
    (call buf.push_byte out 93))

  ;; A function of an interface or an implementation (resolver.rs walk): its
  ;; name is the interface's, not this module's; an implementation's is
  ;; qualified with this module, so the expander can tell where it was
  ;; written (the orphan rule).
  (fn emit_member [m:(ptr Mod) g:(ptr compiler.Node) qualify:bool out:(ptr buf.Buf)] -> void
    (call note m g out)
    (call buf.push_byte out 40)
    (let c:(ptr compiler.Node) (call first_child g))
    (let i:i32 0)
    (let prev_colon:bool true)
    (while (neq c (ptr.null compiler.Node))
      (let colon:bool (eq (get c compiler.Node.kind) compiler.Kind.colon))
      (if (or prev_colon colon) (block) (call buf.push_byte out 32))
      (cond
        ((and (lt i 2) (call is_symbol c))
         (call note m c out)
         (if (and (eq i 1) (and qualify (get m Mod.imported)))
             (block (call buf.push_bytes out (get m Mod.prefix)) (call buf.push_byte out 46))
             (block))
         (call buf.push_bytes out (call text (get m Mod.src) c)))
        (else (call emit m c 0 out)))
      (set! prev_colon colon)
      (set! i (+ i 1))
      (set! c (get c compiler.Node.next)))
    (call note_close m g out)
    (call buf.push_byte out 41))

  ;; A match arm: its head names a member of the matched type, so it is
  ;; renamed like any name ((Shape.circle [r] ...) in module m is
  ;; m.Shape.circle), except else.
  (fn emit_arm [m:(ptr Mod) g:(ptr compiler.Node) out:(ptr buf.Buf)] -> void
    (call note m g out)
    (call buf.push_byte out 40)
    (let c:(ptr compiler.Node) (call first_child g))
    (let i:i32 0)
    (let prev_colon:bool true)
    (while (neq c (ptr.null compiler.Node))
      (let colon:bool (eq (get c compiler.Node.kind) compiler.Kind.colon))
      (if (or prev_colon colon) (block) (call buf.push_byte out 32))
      (if (and (eq i 0) (and (call is_symbol c) (call eq_lit (call text (get m Mod.src) c) "else")))
          (call buf.push_str out "else")
          (call emit m c 0 out))
      (set! prev_colon colon)
      (set! i (+ i 1))
      (set! c (get c compiler.Node.next)))
    (call buf.push_byte out 41))

  ;; ===== Modules =====

  ;; The first item of a (module name items...) tree.
;; ===== File structure (src/sexpr.rs read_one, src/resolver.rs read_module) =====

  ;; "PATH: ", the start of an error about a file.
  (fn path_message [path:(ptr str.Bytes)] -> (ptr buf.Buf)
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 96))
    (call buf.push_bytes b path)
    (call buf.push_str b ": ")
    b)

  ;; "L:C: what" at token i.
  (fn at_token [src:i32 toks:i32 i:i32 what:str] -> (ptr buf.Buf)
    (let lc:(ptr compiler.LineCol) (call compiler.line_col src (get (call compiler.token_at toks i) compiler.Token.pos)))
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 96))
    (call buf.push_int b (get lc compiler.LineCol.line))
    (call buf.push_byte b 58)
    (call buf.push_int b (get lc compiler.LineCol.col))
    (call buf.push_str b ": ")
    (call buf.push_str b what)
    b)

  (fn kind_at [toks:i32 i:i32] -> compiler.Kind (get (call compiler.token_at toks i) compiler.Token.kind))
  (fn is_opener [k:compiler.Kind] -> bool (or (eq k compiler.Kind.lparen) (eq k compiler.Kind.lbracket)))
  (fn is_closer [k:compiler.Kind] -> bool (or (eq k compiler.Kind.rparen) (eq k compiler.Kind.rbracket)))

  ;; Whether token i is the symbol `lit`.
  (fn symbol_is [src:i32 toks:i32 i:i32 lit:str] -> bool
    (unsafe (let t:(ptr compiler.Token) (call compiler.token_at toks i))
    (and (eq (get t compiler.Token.kind) compiler.Kind.symbol)
         (call eq_lit (call str.bytes (+ src (get t compiler.Token.a)) (get t compiler.Token.b)) lit))))

  ;; The index after the form starting at token i (brackets known to balance).
  (fn skip_form [toks:i32 i:i32] -> i32
    (if (not (call is_opener (call kind_at toks i))) (return (+ i 1)) (block))
    (let depth:i32 0)
    (let j:i32 i)
    (while true
      (let k:compiler.Kind (call kind_at toks j))
      (cond
        ((call is_opener k) (set! depth (+ depth 1)))
        ((call is_closer k) (set! depth (- depth 1)))
        (else (block)))
      (set! j (+ j 1))
      (if (eq depth 0) (break) (block)))
    j)

  ;; Why the `count` tokens of src are not one well-formed module file, as
  ;; Rust reports it ("L:C: message"), checked in Rust's order: a tokenizer
  ;; error; the first form's brackets; anything after it; the form being
  ;; (module NAME ...); each import's shape. Null if the file is well formed.
  (fn structure_error [src:i32 toks:i32 count:i32] -> (ptr buf.Buf)
    (if (and (gt count 0) (eq (call kind_at toks (- count 1)) compiler.Kind.bad))
        (block
          (let tb:(ptr buf.Buf) (call at_token src toks (- count 1) ""))
          (call parser.push_token_error tb src (call compiler.token_at toks (- count 1)))
          (return tb))
        (block))
    (if (eq count 0)
        (block (let eb:(ptr buf.Buf) (call buf.make (call alloc.default) 32)) (call buf.push_str eb "unexpected end of input") (return eb))
        (block))
    (if (call is_closer (call kind_at toks 0)) (return (call at_token src toks 0 "unexpected closing bracket")) (block))
    ;; the first form: a stack of open brackets (their token indices)
    (let stack:(arr i32) (arr.new i32 (+ count 1)))
    (let top:i32 0)
    (let i:i32 0)
    (if (call is_opener (call kind_at toks 0))
        (while true
          (if (eq i count) (return (call at_token src toks (arr.get i32 stack (- top 1)) "this bracket is never closed")) (block))
          (let k:compiler.Kind (call kind_at toks i))
          (cond
            ((call is_opener k) (arr.set i32 stack top i) (set! top (+ top 1)))
            ((call is_closer k)
             (let opened:compiler.Kind (call kind_at toks (arr.get i32 stack (- top 1))))
             (if (neq (eq opened compiler.Kind.lparen) (eq k compiler.Kind.rparen))
                 (return (call at_token src toks i "mismatched closing bracket"))
                 (block))
             (set! top (- top 1)))
            (else (block)))
          (set! i (+ i 1))
          (if (eq top 0) (break) (block)))
        (set! i 1))
    (if (lt i count) (return (call at_token src toks i "unexpected input after the module's closing ')'")) (block))
    ;; (module NAME item...)
    (if (or (neq (call kind_at toks 0) compiler.Kind.lparen) (or (lt count 3) (not (call symbol_is src toks 1 "module"))))
        (return (call at_token src toks 0 "a file must be one (module NAME ...) form"))
        (block))
    (if (neq (call kind_at toks 2) compiler.Kind.symbol) (return (call at_token src toks 0 "the module needs a name")) (block))
    (let j:i32 3)
    (while (lt j (- count 1))
      (let next:i32 (call skip_form toks j))
      (if (and (eq (call kind_at toks j) compiler.Kind.lparen) (call symbol_is src toks (+ j 1) "import"))
          (block
            ;; (import NAME) or (import NAME as ALIAS): the children after the head
            (let parts:i32 0)
            (let c:i32 (+ j 2))
            (let shape_ok:bool true)
            (while (lt c (- next 1))
              (set! parts (+ parts 1))
              (if (and (or (eq parts 1) (eq parts 3)) (neq (call kind_at toks c) compiler.Kind.symbol)) (set! shape_ok false) (block))
              (if (and (eq parts 2) (not (call symbol_is src toks c "as"))) (set! shape_ok false) (block))
              (set! c (call skip_form toks c)))
            (if (or (not shape_ok) (and (neq parts 1) (neq parts 3)))
                (return (call at_token src toks j "an import is (import NAME) or (import NAME as ALIAS)"))
                (block)))
          (block))
      (set! j next))
    (ptr.null buf.Buf))

  (fn first_item [src:(ptr Src)] -> (ptr compiler.Node)
    (call nth (get src Src.root) 2))

  (fn make_mod [src:(ptr Src) prefix:(ptr str.Bytes) imported:bool known:(ptr (map.Map (ptr str.Bytes) i32))] -> (ptr Mod)
    (let m:(ptr Mod) (new Mod))
    (put m Mod.src src)
    (put m Mod.prefix prefix)
    (put m Mod.imported imported)
    (put m Mod.fns (call (map.make (ptr str.Bytes) i32) (call alloc.default) 64))
    (put m Mod.structs (call (map.make (ptr str.Bytes) i32) (call alloc.default) 8))
    (put m Mod.decls (call (map.make (ptr str.Bytes) i32) (call alloc.default) 8))
    (put m Mod.aliases (call (map.make (ptr str.Bytes) (ptr str.Bytes)) (call alloc.default) 8))
    (put m Mod.templates (call (map.make (ptr str.Bytes) i32) (call alloc.default) 8))
    (put m Mod.known known)
    (let item:(ptr compiler.Node) (call first_item src))
    (while (neq item (ptr.null compiler.Node))
      (let h:(ptr str.Bytes) (call head src item))
      (let name:(ptr compiler.Node) (call nth item 1))
      ;; a template (fn (NAME T...) ...), (union (NAME T...) ...): its name is
      ;; the header's head (resolver.rs item_name, any item); an interface is
      ;; named like one, and (impl (Hash i32) ...) only refers to one
      (if (and (neq name (ptr.null compiler.Node)) (eq (get name compiler.Node.kind) compiler.Kind.paren))
          (block
            (let tname:(ptr compiler.Node) (call first_child name))
            (if (and (call is_symbol tname) (not (call eq_lit h "impl")))
                (block
                  (call (map.set (ptr str.Bytes) i32) (get m Mod.templates) (call text src tname) 1)
                  (set! name tname))
                (block)))
          (block))
      (cond
        ((and (call eq_lit h "fn") (call is_symbol name))
         (call (map.set (ptr str.Bytes) i32) (get m Mod.fns) (call text src name) 1))
        ((and (call eq_lit h "struct") (call is_symbol name))
         (call (map.set (ptr str.Bytes) i32) (get m Mod.structs) (call text src name) 1)
         ;; a value struct is also named where types and makes go
         (if (call is_value_struct m item) (call (map.set (ptr str.Bytes) i32) (get m Mod.decls) (call text src name) 1) (block)))
        ((and (or (call eq_lit h "const") (or (call eq_lit h "enum") (call eq_lit h "union"))) (call is_symbol name))
         (call (map.set (ptr str.Bytes) i32) (get m Mod.decls) (call text src name) 1))
        ((call eq_lit h "import")
         ;; (import name as alias)
         (let alias:(ptr compiler.Node) (call nth item 3))
         (if (call is_symbol alias)
             (call (map.set (ptr str.Bytes) (ptr str.Bytes)) (get m Mod.aliases) (call text src alias) (call module_name (call text src name)))
             (block)))
        (else (block)))
      (set! item (get item compiler.Node.next)))
    m)

  ;; Appends the module's structs and functions to the state's outputs,
  ;; checking that what it uses of other modules is theirs to give, and
  ;; leaving the visibility marks out (resolver.rs emit_module). False, with
  ;; the error in the state, on the first use of something private.
  (fn emit_module [st:(ptr State) m:(ptr Mod)] -> bool
    (let src:(ptr Src) (get m Mod.src))
    (put m Mod.vis (get st State.vis))
    (put m Mod.paths (get st State.paths))
    (put m Mod.name (if (get m Mod.imported) (get m Mod.prefix) (call text src (call nth (get src Src.root) 1))))
    (put m Mod.err (ptr.null buf.Buf))
    ;; (pub) and field marks, recorded
    (let own_pub:(ptr (map.Map (ptr str.Bytes) i32)) (call (map.make (ptr str.Bytes) i32) (call alloc.default) 16))
    (let own_levels:(ptr (map.Map (ptr str.Bytes) (ptr (map.Map (ptr str.Bytes) i32)))) (call (map.make (ptr str.Bytes) (ptr (map.Map (ptr str.Bytes) i32))) (call alloc.default) 8))
    (let vis:(ptr Vis) (get st State.vis))
    (let mark:(ptr compiler.Node) (call first_item src))
    (while (neq mark (ptr.null compiler.Node))
      (if (not (call eq_lit (call head src mark) "import"))
          (block
            (let public:bool (call take_pub m mark))
            (if (neq (get m Mod.err) (ptr.null buf.Buf)) (return (call vis_stop st m)) (block))
            (let named:(ptr str.Bytes) (call item_name m mark))
            (if (call eq_lit (call head src mark) "struct")
                (block
                  (let levels:(ptr (map.Map (ptr str.Bytes) i32)) (call field_levels m mark))
                  (if (neq (get m Mod.err) (ptr.null buf.Buf)) (return (call vis_stop st m)) (block))
                  (if (gte (get named str.Bytes.len) 0)
                      (block
                        (call (map.set (ptr str.Bytes) (ptr (map.Map (ptr str.Bytes) i32))) (get vis Vis.fields) (call canonical_of m named) levels)
                        (call (map.set (ptr str.Bytes) (ptr (map.Map (ptr str.Bytes) i32))) own_levels named levels))
                      (block)))
                (block))
            (if (and public (gte (get named str.Bytes.len) 0))
                (block
                  (call (map.set (ptr str.Bytes) i32) (get vis Vis.public) (call canonical_of m named) 1)
                  (call (map.set (ptr str.Bytes) i32) own_pub named 1))
                (block)))
          (block))
      (set! mark (get mark compiler.Node.next)))
    (if (get m Mod.imported) (call check_exposure m own_pub own_levels) (block))
    (if (neq (get m Mod.err) (ptr.null buf.Buf)) (return (call vis_stop st m)) (block))
    (let item:(ptr compiler.Node) (call first_item src))
    (while (neq item (ptr.null compiler.Node))
      (put m Mod.item item)
      (let h:(ptr str.Bytes) (call head src item))
      (cond
        ((or (call eq_lit h "struct") (or (call eq_lit h "const") (or (call eq_lit h "enum") (or (call eq_lit h "union") (call eq_lit h "interface")))))
         (call buf.push_str (get st State.structs_out) "  ")
         (call emit m item 0 (get st State.structs_out))
         (call buf.push_byte (get st State.structs_out) 10))
        ;; anything else but an import goes with the functions, as in
        ;; resolver.rs, where the parser reports what is wrong with it
        ((not (call eq_lit h "import"))
         (call buf.push_str (get st State.fns_out) "  ")
         (call emit m item 0 (get st State.fns_out))
         (call buf.push_byte (get st State.fns_out) 10))
        (else (block)))
      (if (neq (get m Mod.err) (ptr.null buf.Buf)) (return (call vis_stop st m)) (block))
      (set! item (get item compiler.Node.next)))
    ;; record this module's templates under their canonical names
    (let t:(ptr (map.Map (ptr str.Bytes) i32)) (get m Mod.templates))
    (loop i 0 (- (call (map.capacity (ptr str.Bytes) i32) t) 1) 1
      (if (call (map.slot_used (ptr str.Bytes) i32) t i)
          (call (map.set (ptr str.Bytes) i32) (get st State.known)
                (if (get m Mod.imported) (call concat (call concat (get m Mod.prefix) (call str.from_str ".")) (call (map.slot_key (ptr str.Bytes) i32) t i)) (call (map.slot_key (ptr str.Bytes) i32) t i))
                1)
          (block)))
    true)

  ;; Hands the module's visibility error to the state; false.
  (fn vis_stop [st:(ptr State) m:(ptr Mod)] -> bool
    (call buf.push_bytes (get st State.err) (call buf.bytes (get m Mod.err)))
    false)

  ;; An item's canonical name: prefixed in an imported module.
  (fn canonical_of [m:(ptr Mod) n:(ptr str.Bytes)] -> (ptr str.Bytes)
    (if (get m Mod.imported) (call concat (call concat (get m Mod.prefix) (call str.from_str ".")) n) n))

  ;; The error buffer, started with "IMPORTER: " (resolver.rs prefixes import
  ;; errors with the importing file).
  (fn importer_error [st:(ptr State) importer:(ptr str.Bytes)] -> (ptr buf.Buf)
    (let e:(ptr buf.Buf) (get st State.err))
    (call buf.push_bytes e importer)
    (call buf.push_str e ": ")
    e)

  ;; Adds 'path' to the list of places searched for a module.
  (fn note_tried [tried:(ptr buf.Buf) path:(ptr str.Bytes)] -> void
    (if (gt (call buf.len tried) 0) (call buf.push_str tried ", ") (block))
    (call buf.push_byte tried 39)
    (call buf.push_bytes tried path)
    (call buf.push_byte tried 39))

  ;; Reports a loaded file's structure error, if it has one.
  (fn malformed [st:(ptr State) src:(ptr Src)] -> bool
    (if (eq (get src Src.error) (ptr.null buf.Buf)) (return false) (block))
    (call buf.push_bytes (get st State.err) (call buf.bytes (get src Src.error)))
    true)

  (fn fail [st:(ptr State) msg:str name:(ptr str.Bytes)] -> bool
    (call buf.push_str (get st State.err) msg)
    (call buf.push_bytes (get st State.err) name)
    false)

  ;; Resolves every (import ...) of src, found relative to dir.
  (fn resolve_imports [st:(ptr State) src:(ptr Src) dir:(ptr str.Bytes)] -> bool
    (let item:(ptr compiler.Node) (call first_item src))
    (while (neq item (ptr.null compiler.Node))
      (if (call eq_lit (call head src item) "import")
          (if (call resolve_module st dir (call text src (call nth item 1)) (get src Src.path)) (block) (return false))
          (block))
      (set! item (get item compiler.Node.next)))
    true)

  (fn with_ext [dir:(ptr str.Bytes) name:(ptr str.Bytes)] -> (ptr str.Bytes)
    (call concat (call concat dir name) (call str.from_str ".aipl")))

;; Two different files may not share a module name; records name -> path.
  (fn check_name [st:(ptr State) name:(ptr str.Bytes) path:(ptr str.Bytes) importer:(ptr str.Bytes)] -> bool
    (unsafe (let seen:(ptr str.Bytes) (call (map.get_or (ptr str.Bytes) (ptr str.Bytes)) (get st State.paths) name (call str.bytes 0 -1)))
    (if (and (gte (get seen str.Bytes.len) 0) (not (call str.bytes_eq seen path)))
        (block
          (let e:(ptr buf.Buf) (call importer_error st importer))
          (call buf.push_str e "two different modules are named '")
          (call buf.push_bytes e name)
          (call buf.push_str e "': ")
          (call buf.push_bytes e seen)
          (call buf.push_str e " and ")
          (call buf.push_bytes e path)
          (return false))
        (block))
    (call (map.set (ptr str.Bytes) (ptr str.Bytes)) (get st State.paths) name path)
    true))

  ;; A module's name: the last segment of its import path
  ;; ((import native/wasm_reader) is the module wasm_reader), as resolver.rs.
  (fn module_name [import:(ptr str.Bytes)] -> (ptr str.Bytes)
    (let slash:i32 (call last_index import 47))
    (call slice import (+ slash 1) (- (get import str.Bytes.len) (+ slash 1))))

  ;; An import path is names separated by '/': relative, no '.' or '..'.
  (fn valid_import_path [p:(ptr str.Bytes)] -> bool
    (let n:i32 (get p str.Bytes.len))
    (if (eq n 0) (return false) (block))
    (let seg_len:i32 0)
    (loop i 0 (- n 1) 1
      (let c:i32 (call str.byte_at p i))
      (cond
        ((eq c 46) (return false))
        ((eq c 47) (if (eq seg_len 0) (return false) (set! seg_len 0)))
        (else (set! seg_len (+ seg_len 1)))))
    (gt seg_len 0))

  (fn resolve_module [st:(ptr State) dir:(ptr str.Bytes) import:(ptr str.Bytes) importer:(ptr str.Bytes)] -> bool
    (unsafe (if (not (call valid_import_path import))
        (block
          (let pe:(ptr buf.Buf) (call importer_error st importer))
          (call buf.push_byte pe 39)
          (call buf.push_bytes pe import)
          (call buf.push_str pe "' is not an import path: use names separated by '/', e.g. (import native/wasm_reader)")
          (return false))
        (block))
    (let name:(ptr str.Bytes) (call module_name import))
    ;; an import from the same directory resolves to the same file: search once
    (let key:(ptr str.Bytes) (call concat dir (call concat (call str.from_str "|") import)))
    (let known_path:(ptr str.Bytes) (call (map.get_or (ptr str.Bytes) (ptr str.Bytes)) (get st State.found) key (call str.bytes 0 -1)))
    (if (and (gte (get known_path str.Bytes.len) 0) (call (map.has (ptr str.Bytes) i32) (get st State.done) name))
        (return (call check_name st name known_path importer))
        (block))
    ;; search: importer's directory, entry's directory, standard library;
    ;; `tried` lists the candidates for the error (resolver.rs find_module_file)
    (let tried:(ptr buf.Buf) (call buf.make (call alloc.default) 256))
    (let path:(ptr str.Bytes) (call with_ext dir import))
    (call note_tried tried path)
    (let src:(ptr Src) (call load path (get st State.origins)))
    (if (and (eq src (ptr.null Src)) (not (call str.bytes_eq path (call with_ext (get st State.entry_dir) import))))
        (block
          (set! path (call with_ext (get st State.entry_dir) import))
          (call note_tried tried path)
          (set! src (call load path (get st State.origins))))
        (block))
    ;; then each library directory, in order
    (let dirs:(ptr str.Bytes) (get st State.lib_dirs))
    (let start:i32 0)
    (loop i 0 (get dirs str.Bytes.len) 1
      (if (eq src (ptr.null Src)) (block) (break))
      ;; a ':' or the end closes an entry
      (if (or (eq i (get dirs str.Bytes.len)) (eq (call str.byte_at dirs i) 58))
          (block
            (if (gt i start)
                (block
                  (set! path (call with_ext (call as_dir (call slice dirs start (- i start))) import))
                  (call note_tried tried path)
                  (set! src (call load path (get st State.origins))))
                (block))
            (set! start (+ i 1)))
          (block)))
    ;; a module's name in compiled code's line table is its import path
    (call name_file src (call concat import (call str.from_str ".aipl")))
    (if (eq src (ptr.null Src))
        (block
          (let e:(ptr buf.Buf) (call importer_error st importer))
          (call buf.push_str e "Cannot resolve import '")
          (call buf.push_bytes e import)
          (call buf.push_str e "': no '")
          (call buf.push_bytes e import)
          (call buf.push_str e ".aipl' found in ")
          (call buf.push_bytes e (call buf.bytes tried))
          (return false))
        (block))
    (if (call malformed st src) (return false) (block))
    (call (map.set (ptr str.Bytes) (ptr str.Bytes)) (get st State.found) key path)
    (if (not (call check_name st name path importer)) (return false) (block))
    (if (call (map.has (ptr str.Bytes) i32) (get st State.done) name) (return true) (block))
    (if (call (map.has (ptr str.Bytes) i32) (get st State.active) name)
        (block
          (let e:(ptr buf.Buf) (get st State.err))
          (call buf.push_bytes e path)
          (call buf.push_str e ": Circular import detected: '")
          (call buf.push_bytes e path)
          (call buf.push_str e "' is imported while already being resolved")
          (return false))
        (block))
    (call (map.set (ptr str.Bytes) i32) (get st State.active) name 1)
    (if (call resolve_imports st src (call dirname path)) (block) (return false))
    (if (not (call emit_module st (call make_mod src name true (get st State.known)))) (return false) (block))
    (call (map.remove (ptr str.Bytes) i32) (get st State.active) name)
    (call (map.set (ptr str.Bytes) i32) (get st State.done) name 1)
    true))

  ;; The library directories to search, colon-separated: std_dir, then AIPL_PATH.
  (fn library_dirs [std_dir:(ptr str.Bytes)] -> (ptr str.Bytes)
    (let path:(ptr str.Bytes) (call os.env "AIPL_PATH"))
    (if (gt (get path str.Bytes.len) 0)
        (call concat (call concat std_dir (call str.from_str ":")) path)
        std_dir))

  ;; Resolves the program whose entry file is `entry`, searching the
  ;; standard library directory `std_dir` and then AIPL_PATH after the
  ;; importer's and the entry's directories. Writes the flat source to `out`,
  ;; or an error message to `err` and returns false.
  (fn resolve [entry:(ptr str.Bytes) std_dir:(ptr str.Bytes) out:(ptr buf.Buf) err:(ptr buf.Buf)] -> bool
    ;; positions are tracked anyway, so an error in a generic names its file
    (call resolve_mapped entry std_dir out err (call origins.make) (ptr.null origins.Origins)))

  ;; resolve, noting where every token of the result comes from: `orig`
  ;; maps the resolver's flat text to the files, `gen` maps the result to
  ;; that flat text (empty when there were no generics: the same text).
  (fn resolve_mapped [entry:(ptr str.Bytes) std_dir:(ptr str.Bytes) out:(ptr buf.Buf) err:(ptr buf.Buf)
                      orig:(ptr origins.Origins) gen:(ptr origins.Origins)] -> bool
    (let flat:(ptr buf.Buf) (call buf.make (call alloc.default) 65536))
    (and (call flatten_mapped entry std_dir flat err orig) (call expand_generics flat out err orig gen)))

  ;; The flat program before generic expansion (resolver.rs flatten).
  (fn flatten_mapped [entry:(ptr str.Bytes) std_dir:(ptr str.Bytes) flat:(ptr buf.Buf) err:(ptr buf.Buf)
                      orig:(ptr origins.Origins)] -> bool (pub)
    (let src:(ptr Src) (call load entry orig))
    ;; the entry file's name in compiled code's line table is its file name
    (call name_file src (call slice entry (+ (call last_index entry 47) 1) (- (get entry str.Bytes.len) (+ (call last_index entry 47) 1))))
    (let st:(ptr State) (new State))
    (put st State.origins orig)
    (put st State.entry_dir (call dirname entry))
    (put st State.lib_dirs (call library_dirs std_dir))
    (put st State.done (call (map.make (ptr str.Bytes) i32) (call alloc.default) 16))
    (put st State.active (call (map.make (ptr str.Bytes) i32) (call alloc.default) 16))
    (put st State.structs_out (call buf.make (call alloc.default) 1024))
    (put st State.fns_out (call buf.make (call alloc.default) 65536))
    (put st State.err err)
    (put st State.known (call (map.make (ptr str.Bytes) i32) (call alloc.default) 16))
    (put st State.paths (call (map.make (ptr str.Bytes) (ptr str.Bytes)) (call alloc.default) 16))
    (put st State.found (call (map.make (ptr str.Bytes) (ptr str.Bytes)) (call alloc.default) 32))
    (let vis:(ptr Vis) (new Vis))
    (put vis Vis.public (call (map.make (ptr str.Bytes) i32) (call alloc.default) 256))
    (put vis Vis.fields (call (map.make (ptr str.Bytes) (ptr (map.Map (ptr str.Bytes) i32))) (call alloc.default) 64))
    (put st State.vis vis)
    (if (eq src (ptr.null Src)) (return (call fail st "cannot read entry file: " entry)) (block))
    (if (call malformed st src) (return false) (block))
    (if (call resolve_imports st src (call dirname entry)) (block) (return false))
    (let entry_mod:(ptr Mod) (call make_mod src (call str.from_str "") false (get st State.known)))
    (if (not (call emit_module st entry_mod)) (return false) (block))
    (call buf.push_str flat "(module ")
    (call buf.push_bytes flat (call text src (call nth (get src Src.root) 1)))
    (call buf.push_byte flat 10)
    (let structs_at:i32 (call buf.len flat))
    (call buf.push_bytes flat (call buf.bytes (get st State.structs_out)))
    (let fns_at:i32 (call buf.len flat))
    (call buf.push_bytes flat (call buf.bytes (get st State.fns_out)))
    (call buf.push_byte flat 41)
    (if (neq orig (ptr.null origins.Origins))
        (block
          (let parts:(arr (ptr buf.Buf)) (arr.new (ptr buf.Buf) 2))
          (arr.set (ptr buf.Buf) parts 0 (get st State.structs_out))
          (arr.set (ptr buf.Buf) parts 1 (get st State.fns_out))
          (let bases:(arr i32) (arr.new i32 2))
          (arr.set i32 bases 0 structs_at)
          (arr.set i32 bases 1 fns_at)
          (call origins.join orig parts bases))
        (block))
    true)

  ;; Expands the generic templates of a flat program into concrete items
  ;; (generics.aipl); an error there is reported in the file it is in, as
  ;; generics.rs does.
  (fn expand_generics [flat:(ptr buf.Buf) out:(ptr buf.Buf) err:(ptr buf.Buf) orig:(ptr origins.Origins) gen:(ptr origins.Origins)] -> bool (pub)
    (call expand_as flat out err orig gen false))

  ;; Every template once at placeholders for its type parameters, to check
  ;; (generics.aipl archetypes_mapped); `out` stays empty without templates.
  (fn archetypes_of [flat:(ptr buf.Buf) out:(ptr buf.Buf) err:(ptr buf.Buf) orig:(ptr origins.Origins) gen:(ptr origins.Origins)] -> bool (pub)
    (call expand_as flat out err orig gen true))

  (fn expand_as [flat:(ptr buf.Buf) out:(ptr buf.Buf) err:(ptr buf.Buf) orig:(ptr origins.Origins) gen:(ptr origins.Origins) archetypes:bool] -> bool
    (let failure:(ptr generics.Failure) (new generics.Failure))
    (put failure generics.Failure.at -1)
    (let gen_err:(ptr buf.Buf) (call buf.make (call alloc.default) 128))
    (if (if archetypes
            (call generics.archetypes_mapped (call buf.bytes flat) out gen_err gen failure)
            (call generics.expand_mapped (call buf.bytes flat) out gen_err gen failure))
        true
        (block
          (if (and (gte (get failure generics.Failure.at) 0) (neq orig (ptr.null origins.Origins)))
              (call push_location err orig (get failure generics.Failure.at))
              (block))
          (call buf.push_bytes err (call buf.bytes gen_err))
          false)))

  ;; "PATH: L:C: " for offset `at` of the flat program, through `orig`.
  (fn push_location [b:(ptr buf.Buf) orig:(ptr origins.Origins) at:i32] -> void
    (let r:(ptr origins.Entry) (call origins.find orig at))
    (if (or (eq r (ptr.null origins.Entry)) (lt (get r origins.Entry.file) 0)) (return) (block))
    (let f:(ptr origins.File) (call origins.file_at orig (get r origins.Entry.file)))
    (let lc:(ptr compiler.LineCol) (call compiler.line_col (get (get f origins.File.text) str.Bytes.addr) (get r origins.Entry.pos)))
    (call buf.push_bytes b (get f origins.File.path))
    (call buf.push_str b ": ")
    (call buf.push_int b (get lc compiler.LineCol.line))
    (call buf.push_byte b 58)
    (call buf.push_int b (get lc compiler.LineCol.col))
    (call buf.push_str b ": "))

  ;; ===== Host interface =====

  (fn host_alloc [n:i32] -> i32 (mem.alloc n))

  ;; Resolves the file at (path_addr, path_len), with the standard library
  ;; directory at (std_addr, std_len). The Out holds the flat source (ok 1)
  ;; or the error (ok 0).
  (fn resolve_file [path_addr:i32 path_len:i32 std_addr:i32 std_len:i32] -> (ptr Out)
    (unsafe (let out:(ptr buf.Buf) (call buf.make (call alloc.default) 65536))
    (let err:(ptr buf.Buf) (call buf.make (call alloc.default) 256))
    (let ok:bool (call resolve (call str.bytes path_addr path_len) (call str.bytes std_addr std_len) out err))
    (let res:(ptr Out) (new Out))
    (let b:(ptr str.Bytes) (call buf.bytes (if ok out err)))
    (put res Out.ok (if ok 1 0))
    (put res Out.addr (get b str.Bytes.addr))
    (put res Out.len (get b str.Bytes.len))
    res))

  ;; Pass count; test_suite.aipl expects 3. Paths are relative to the
  ;; repository root, where the suite runs.
  (fn run_resolver_tests [] -> i32 (pub)
    (let p:i32 0)
    (let out:(ptr buf.Buf) (call buf.make (call alloc.default) 1024))
    (let err:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (let ok:bool (call resolve (call str.from_str "examples/word_count.aipl") (call str.from_str "aipl_src/std/") out err))
    (let flat:(ptr str.Bytes) (call buf.bytes out))
    ;; word_count imports io (which imports str and fmt) and str: each once
    (let fns:i32 0)
    (let marker:(ptr str.Bytes) (call str.from_str "(fn str.count_lines "))
    (loop i 0 (- (get flat str.Bytes.len) (get marker str.Bytes.len)) 1
      (if (call str.bytes_eq (call slice flat i (get marker str.Bytes.len)) marker) (set! fns (+ fns 1)) (block)))
    (if (and ok (eq fns 1)) (set! p (+ p 1)) (block))
    ;; the entry keeps bare names and calls through qualified ones
    (let has_main:bool false)
    (let main_marker:(ptr str.Bytes) (call str.from_str "(fn main [] -> i32"))
    (loop i 0 (- (get flat str.Bytes.len) (get main_marker str.Bytes.len)) 1
      (if (call str.bytes_eq (call slice flat i (get main_marker str.Bytes.len)) main_marker) (set! has_main true) (block)))
    (if has_main (set! p (+ p 1)) (block))
    ;; a missing module is an error, not an empty program
    (let err2:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (if (call resolve (call str.from_str "examples/no_such_file.aipl") (call str.from_str "aipl_src/std/") (call buf.make (call alloc.default) 64) err2)
        (block)
        (if (gt (call buf.len err2) 0) (set! p (+ p 1)) (block)))
    p))
