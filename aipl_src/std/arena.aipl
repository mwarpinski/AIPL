;; std/arena: a region allocator. Allocate many values, then free them all at
;; once with reset (for freeing single objects, see std/heap). Typed, with no
;; casts at the call site:
;;
;;   (let a:(ptr arena.Arena) (call arena.make 65536))
;;   (let n:(ptr Node) (call (arena.alloc Node) a))   ;; zeroed, like (new Node)
;;   ...
;;   (call arena.reset a)    ;; everything allocated from a is free again
;;
;; Memory comes in chunks from mem.alloc; a full chunk moves on to the next
;; (allocating one if needed), and reset reuses them all, so an arena never
;; fails while memory remains. Each block has an 8-byte header holding its
;; size, so reset can mark every object freed (std/gen): a pointer from an
;; arena used after reset stops the program with "Use after free".
;;
;; A fast arena (make_fast, fast_alloc, fast_reset) has no headers and marks
;; nothing at reset, so it allocates in less memory and time and resets at
;; once. A pointer used after its reset is caught only once the memory
;; holds a new object; until then it reads the old object as it was (a
;; bug, but not unsafe: nothing else lives there, and a new object's memory
;; is zeroed first). Choose it where allocation speed matters and the code
;; drops its pointers at reset:
;;
;;   (let f:(ptr arena.Fast) (call arena.make_fast 65536))
;;   (let n:(ptr Node) (call (arena.fast_alloc Node) f))
;;   (call arena.fast_reset f)
(module arena
  (import gen)

  ;; The chunks form a list in the order they were taken; `current` is the
  ;; one being filled, `used` bytes into it (a chunk's own `used` is set
  ;; when the arena moves past it, and by reset).
  (struct Chunk [base:i32 cap:i32 used:i32 next:(ptr Chunk)])
  ;; A region allocator: alloc hands out memory, reset frees all of it
  ;; at once; a pointer used after reset stops the program.
  (struct Arena [first:(ptr Chunk) current:(ptr Chunk) used:i32 chunk_size:i32 gen:i32] (pub))
  ;; A faster arena that catches a pointer used after fast_reset only once
  ;; its memory is reused.
  (struct Fast [first:(ptr Chunk) current:(ptr Chunk) used:i32 chunk_size:i32 gen:i32] (pub))

  ;; An arena that takes memory in chunks of at least chunk_size bytes.
  (fn make [chunk_size:i32] -> (ptr Arena) (pub)
    (req (gt chunk_size 0))
    (let a:(ptr Arena) (new Arena))
    (put a Arena.chunk_size (bitand (+ chunk_size 7) -8))
    (put a Arena.first (call new_chunk (get a Arena.chunk_size)))
    (put a Arena.current (get a Arena.first))
    (put a Arena.used 0)
    (put a Arena.gen (call gen.fresh))
    a)

  (fn new_chunk [size:i32] -> (ptr Chunk)
    (let c:(ptr Chunk) (new Chunk))
    (put c Chunk.base (mem.alloc size))
    (put c Chunk.cap size)
    (put c Chunk.used 0)
    (put c Chunk.next (ptr.null Chunk))
    c)

  ;; n zeroed bytes, 8-aligned, after an 8-byte header holding the block's
  ;; size (header included).
  ;; (no_leak): after reset the arena hands out its chunks again; it takes
  ;; a new one only when they are all in use.
  (fn raw [a:(ptr Arena) n:i32] -> i32 (pub) (no_leak)
    (req (gt n 0))
    (unsafe (let size:i32 (+ (bitand (+ n 7) -8) 8))
    (let found:i32 -1)
    (while (eq found -1)
      (let c:(ptr Chunk) (get a Arena.current))
      (if (lte (+ (get a Arena.used) size) (get c Chunk.cap))
          (block
            (set! found (+ (get c Chunk.base) (+ (get a Arena.used) 8)))
            (mem.store32 (- found 8) size)
            (put a Arena.used (+ (get a Arena.used) size)))
          (block
            ;; on to the next chunk, taking a new one at the end of the list
            (if (eq (get c Chunk.next) (ptr.null Chunk))
                (put c Chunk.next (call new_chunk (if (gt size (get a Arena.chunk_size)) size (get a Arena.chunk_size))))
                (block))
            (put c Chunk.used (get a Arena.used))
            (put a Arena.current (get c Chunk.next))
            (put a Arena.used 0))))
    (loop i 0 (- (/ size 8) 2) 1 (mem.store64 (+ found (* 8 i)) 0i64))
    found))

  ;; A zeroed T from the arena. Everything allocated between two resets
  ;; shares the arena's generation: a reset marks them all freed and takes
  ;; a fresh one, so no allocation needs its own (std/gen).
  (fn (alloc T) [a:(ptr Arena)] -> (ptr T) (pub) (where (struct T))
    (unsafe (let base:i32 (call raw a (+ (sizeof T) 8)))
    (mem.store32 base (get a Arena.gen))
    (ptr.make T (+ base 8) (get a Arena.gen))))

  ;; Frees everything allocated from the arena: every block's object is
  ;; marked freed (std/gen), then the chunks are handed out again.
  (fn reset [a:(ptr Arena)] -> void (pub)
    (put (get a Arena.current) Chunk.used (get a Arena.used))
    (let c:(ptr Chunk) (get a Arena.first))
    (let more:bool true)
    (while more
      (call kill_blocks c)
      (if (eq c (get a Arena.current)) (set! more false) (set! c (get c Chunk.next))))
    (put a Arena.current (get a Arena.first))
    (put a Arena.used 0)
    (put a Arena.gen (call gen.fresh)))

  ;; Marks each block in c's used part freed, and empties c.
  (fn kill_blocks [c:(ptr Chunk)] -> void
    (unsafe (let q:i32 (get c Chunk.base))
    (let end:i32 (+ q (get c Chunk.used)))
    (while (lt q end)
      (call gen.kill (+ q 8))
      (set! q (+ q (mem.load32 q))))
    (put c Chunk.used 0)))

  ;; ===== Fast arenas =====

  ;; A fast arena taking its memory chunk_size bytes at a time.
  (fn make_fast [chunk_size:i32] -> (ptr Fast) (pub)
    (req (gt chunk_size 0))
    (let f:(ptr Fast) (new Fast))
    (put f Fast.chunk_size (bitand (+ chunk_size 7) -8))
    (put f Fast.first (call new_chunk (get f Fast.chunk_size)))
    (put f Fast.current (get f Fast.first))
    (put f Fast.used 0)
    (put f Fast.gen (call gen.fresh))
    f)

  ;; n zeroed bytes, 8-aligned (no header).
  ;; (no_leak): as raw.
  (fn fast_raw [f:(ptr Fast) n:i32] -> i32 (pub) (no_leak)
    (req (gt n 0))
    (unsafe (let size:i32 (bitand (+ n 7) -8))
    (let found:i32 -1)
    (while (eq found -1)
      (let c:(ptr Chunk) (get f Fast.current))
      (if (lte (+ (get f Fast.used) size) (get c Chunk.cap))
          (block
            (set! found (+ (get c Chunk.base) (get f Fast.used)))
            (put f Fast.used (+ (get f Fast.used) size)))
          (block
            (if (eq (get c Chunk.next) (ptr.null Chunk))
                (put c Chunk.next (call new_chunk (if (gt size (get f Fast.chunk_size)) size (get f Fast.chunk_size))))
                (block))
            (put f Fast.current (get c Chunk.next))
            (put f Fast.used 0))))
    (loop i 0 (- (/ size 8) 1) 1 (mem.store64 (+ found (* 8 i)) 0i64))
    found))

  ;; A zeroed T, with the fast arena's generation until its next reset.
  (fn (fast_alloc T) [f:(ptr Fast)] -> (ptr T) (pub) (where (struct T))
    (unsafe (let base:i32 (call fast_raw f (+ (sizeof T) 8)))
    (mem.store32 base (get f Fast.gen))
    (ptr.make T (+ base 8) (get f Fast.gen))))

  ;; Frees everything at once: a fresh generation for what comes next, so
  ;; an old pointer fails once its memory holds a new object.
  (fn fast_reset [f:(ptr Fast)] -> void (pub)
    (put f Fast.current (get f Fast.first))
    (put f Fast.used 0)
    (put f Fast.gen (call gen.fresh)))

  ;; Bytes the arena holds from the heap (all chunks).
  (fn reserved [a:(ptr Arena)] -> i32 (pub)
    (let total:i32 0)
    (let c:(ptr Chunk) (get a Arena.first))
    (while (neq c (ptr.null Chunk))
      (set! total (+ total (get c Chunk.cap)))
      (set! c (get c Chunk.next)))
    total)

  (struct Pair [left:i32 right:i64])

  ;; Pass count; test_suite.aipl expects 7.
  (fn run_arena_tests [] -> i32 (pub)
    (let p:i32 0)
    (let a:(ptr Arena) (call make 64))
    ;; typed, zeroed, distinct
    (let x:(ptr Pair) (call (alloc Pair) a))
    (let y:(ptr Pair) (call (alloc Pair) a))
    (put x Pair.left 7)
    (if (and (eq (get y Pair.left) 0) (neq (ptr.addr x) (ptr.addr y))) (set! p (+ p 1)) (block))
    ;; a full chunk moves on to a new one
    (loop i 1 10 1 (let _z:(ptr Pair) (call (alloc Pair) a)))
    (if (gt (call reserved a) 64) (set! p (+ p 1)) (block))
    ;; reset reuses the memory: the next allocation is where the first was
    (let before:i32 (call reserved a))
    (call reset a)
    (let x2:(ptr Pair) (call (alloc Pair) a))
    (if (eq (ptr.addr x2) (ptr.addr x)) (set! p (+ p 1)) (block))
    ;; and it is zeroed again, though x set it to 7
    (if (eq (get x2 Pair.left) 0) (set! p (+ p 1)) (block))
    ;; refilling after reset takes no new memory; an oversized request gets
    ;; a chunk of its own
    (loop i 1 10 1 (let _z:(ptr Pair) (call (alloc Pair) a)))
    (let big:i32 (call raw a 1000))
    (if (and (gte (- (call reserved a) before) 1000) (eq (bitand big 7) 0)) (set! p (+ p 1)) (block))
    ;; a fast arena packs objects without headers: 8 bytes closer together
    (let f:(ptr Fast) (call make_fast 4096))
    (let u:(ptr Pair) (call (fast_alloc Pair) f))
    (let w:(ptr Pair) (call (fast_alloc Pair) f))
    (let d:(ptr Arena) (call make 4096))
    (let du:(ptr Pair) (call (alloc Pair) d))
    (let dw:(ptr Pair) (call (alloc Pair) d))
    (if (eq (- (ptr.addr w) (ptr.addr u)) (- (- (ptr.addr dw) (ptr.addr du)) 8)) (set! p (+ p 1)) (block))
    ;; after its reset, the object where u was has another generation, so u
    ;; is caught once that memory is reused
    (call fast_reset f)
    (let u2:(ptr Pair) (call (fast_alloc Pair) f))
    (if (and (eq (ptr.addr u2) (ptr.addr u)) (unsafe (neq (ptr.gen u2) (ptr.gen u)))) (set! p (+ p 1)) (block))
    p))
