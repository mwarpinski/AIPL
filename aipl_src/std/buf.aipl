;; std/buf: a growable byte buffer for building text (a string builder).
;; (call buf.bytes b) views the contents as a (ptr str.Bytes) without copying;
;; later pushes may move the data (and free the old storage), so take the
;; view after building. Its memory comes from the allocator it is made with
;; (std/alloc); free releases it.
(module buf
  (import str)
  (import fmt)
  (import alloc)

  ;; A growable byte buffer; `data` is where its bytes start (they move
  ;; as it grows).
  (struct Buf [(read data:i32) len:i32 cap:i32 allocator:alloc.Allocator] (pub))

  ;; An empty buffer with room for `capacity` bytes (at least 16), from a.
  (fn make [a:alloc.Allocator capacity:i32] -> (ptr Buf) (pub)
    (let cap:i32 (if (lt capacity 16) 16 capacity))
    (let b:(ptr Buf) (call (alloc.create Buf) a))
    (put b Buf.data (call alloc.raw a cap))
    (put b Buf.len 0)
    (put b Buf.cap cap)
    (put b Buf.allocator a)
    b)

  ;; Frees the storage and the buffer itself (and so any view of them).
  (fn free [b:(ptr Buf)] -> void (pub)
    (unsafe (call alloc.free_raw (get b Buf.allocator) (get b Buf.data) (get b Buf.cap)))
    (call (alloc.destroy Buf) (get b Buf.allocator) b))

  ;; The number of bytes in b.
  (fn len [b:(ptr Buf)] -> i32 (pub) (get b Buf.len))
  ;; Byte i of b (0 <= i < len), without making a view.
  (fn byte_at [b:(ptr Buf) i:i32] -> i32 (pub)
    (req (and (gte i 0) (lt i (get b Buf.len))))
    (unsafe (mem.load8 (+ (get b Buf.data) i))))
  ;; Empties b, keeping its storage.
  (fn clear [b:(ptr Buf)] -> void (pub) (put b Buf.len 0))

  ;; Makes room for `extra` more bytes, doubling the storage as needed.
  (fn ensure [b:(ptr Buf) extra:i32] -> void
    (unsafe (let need:i32 (+ (get b Buf.len) extra))
    (if (lte need (get b Buf.cap)) (return) (block))
    (let cap:i32 (* 2 (get b Buf.cap)))
    (while (lt cap need) (set! cap (* cap 2)))
    (let data:i32 (call alloc.raw (get b Buf.allocator) cap))
    (loop i 0 (- (get b Buf.len) 1) 1
      (mem.store8 (+ data i) (mem.load8 (+ (get b Buf.data) i))))
    (call alloc.free_raw (get b Buf.allocator) (get b Buf.data) (get b Buf.cap))
    (put b Buf.data data)
    (put b Buf.cap cap)))

  ;; Appends the byte c (its low 8 bits).
  (fn push_byte [b:(ptr Buf) c:i32] -> void (pub)
    (unsafe (call ensure b 1)
    (mem.store8 (+ (get b Buf.data) (get b Buf.len)) c)
    (put b Buf.len (+ (get b Buf.len) 1))))

  ;; Appends the bytes of s.
  (fn push_bytes [b:(ptr Buf) s:(ptr str.Bytes)] -> void (pub)
    (unsafe (let n:i32 (get s str.Bytes.len))
    (call ensure b n)
    (let at:i32 (+ (get b Buf.data) (get b Buf.len)))
    (loop i 0 (- n 1) 1
      (mem.store8 (+ at i) (call str.byte_at s i)))
    (put b Buf.len (+ (get b Buf.len) n))))

  ;; (Copied straight from the string: no slice is made, so nothing is kept.)
  (fn push_str [b:(ptr Buf) s:str] -> void (pub)
    (unsafe (let n:i32 (str.len s))
    (call ensure b n)
    (let at:i32 (+ (get b Buf.data) (get b Buf.len)))
    (let from:i32 (str.ptr s))
    (loop i 0 (- n 1) 1
      (mem.store8 (+ at i) (mem.load8 (+ from i))))
    (put b Buf.len (+ (get b Buf.len) n))))

  ;; Inserts n copies of byte c at index `at` (0 .. len), moving what
  ;; follows it right.
  (fn insert [b:(ptr Buf) at:i32 n:i32 c:i32] -> void (pub)
    (req (and (gte at 0) (and (lte at (get b Buf.len)) (gte n 0))))
    (unsafe (call ensure b n)
    (let d:i32 (get b Buf.data))
    (let len:i32 (get b Buf.len))
    (loop j 0 (- (- len at) 1) 1
      (let i:i32 (- (- len 1) j))
      (mem.store8 (+ d (+ i n)) (mem.load8 (+ d i))))
    (loop i 0 (- n 1) 1 (mem.store8 (+ d (+ at i)) c))
    (put b Buf.len (+ len n))))

  ;; u read as unsigned (so -1i64 is 2^64 - 1), in base 2, 8, 10, or 16
  ;; (lowercase digits unless `upper`), with no sign or prefix.
  (fn push_unsigned [b:(ptr Buf) u:i64 base:i32 upper:bool] -> void (pub)
    (req (or (eq base 2) (or (eq base 8) (or (eq base 10) (eq base 16)))))
    (unsafe (call ensure b 64)
    (let d:i32 (get b Buf.data))
    (let start:i32 (get b Buf.len))
    (let n:i32 0)
    (let v:i64 u)
    (let bb:i64 (i64.extend_s base))
    (let first:bool true)
    (while (or first (neq v 0i64))
      (set! first false)
      (let r:i32 (i32.wrap (remu v bb)))
      (mem.store8 (+ d (+ start n)) (cond ((lt r 10) (+ 48 r)) (upper (+ 55 r)) (else (+ 87 r))))
      (set! n (+ n 1))
      (set! v (divu v bb)))
    ;; the digits went in least significant first
    (loop i 0 (- (/ n 2) 1) 1
      (let x:i32 (+ d (+ start i)))
      (let y:i32 (+ d (+ start (- (- n 1) i))))
      (let t:i32 (mem.load8 x))
      (mem.store8 x (mem.load8 y))
      (mem.store8 y t))
    (put b Buf.len (+ start n))))

  ;; Decimal, with '-' when negative.
  (fn push_int [b:(ptr Buf) n:i32] -> void (pub)
    (unsafe (call ensure b 11)
    (let k:i32 (call fmt.int_to_bytes n (+ (get b Buf.data) (get b Buf.len))))
    (put b Buf.len (+ (get b Buf.len) k))))

  ;; An i64 in decimal, with '-' when negative.
  (fn push_i64 [b:(ptr Buf) n:i64] -> void (pub)
    (unsafe (call ensure b 21)
    (let k:i32 (call fmt.int64_to_bytes n (+ (get b Buf.data) (get b Buf.len))))
    (put b Buf.len (+ (get b Buf.len) k))))

  ;; An f64 with `digits` decimals (fmt.f64_fixed: exact, ties to even).
  (fn push_f64 [b:(ptr Buf) x:f64 digits:i32] -> void (pub)
    (req (and (gte digits 0) (lte digits 40)))
    (unsafe (call ensure b (+ 312 digits))
    (let k:i32 (call fmt.f64_fixed x digits (+ (get b Buf.data) (get b Buf.len))))
    (put b Buf.len (+ (get b Buf.len) k))))

  ;; The contents as a view (no copy): good until the next push or free.
  (fn bytes [b:(ptr Buf)] -> (ptr str.Bytes) (pub)
    (unsafe (call str.bytes (get b Buf.data) (get b Buf.len))))

  ;; The contents as a new str: a copy, so later pushes and free leave it
  ;; alone. Never freed (str.from_bytes); the contents must be UTF-8.
  (fn to_str [b:(ptr Buf)] -> str (pub) (call str.from_bytes (call bytes b)))

  ;; Writes the contents to file descriptor fd; the bytes written, or a
  ;; negative errno (fs.write).
  (fn write [b:(ptr Buf) fd:i32] -> i32 (pub) (unsafe (fs.write fd (get b Buf.data) (get b Buf.len))))

  ;; Writes the contents to standard output: the usual end of a program that
  ;; builds its output in a buffer and prints it once.
  (fn print [b:(ptr Buf)] -> void (pub) (let _n:i32 (call write b 1)) (block))

  ;; Pass count; test_suite.aipl expects 3.
  (fn run_buf_tests [] -> i32 (pub)
    (let p:i32 0)
    (let b:(ptr Buf) (call make (call alloc.default) 0))
    (call push_str b "x=")
    (call push_int b -42)
    (call push_byte b 33)
    (if (call str.bytes_eq (call bytes b) (call str.from_str "x=-42!")) (set! p (+ p 1)) (block))
    ;; growth: 1000 pushes from a 16-byte start keep every byte
    (call clear b)
    (loop i 0 999 1 (call push_byte b (+ 97 (% i 26))))
    (let ok:bool (eq (call len b) 1000))
    (loop i 0 999 1
      (if (neq (call str.byte_at (call bytes b) i) (+ 97 (% i 26))) (set! ok false) (block)))
    (if ok (set! p (+ p 1)) (block))
    ;; numbers round-trip through text
    (let c:(ptr Buf) (call make (call alloc.default) 0))
    (call push_int c -2147483648)
    (match_result (call str.parse_int (call bytes c))
      (ok n (if (eq n -2147483648) (set! p (+ p 1)) (block)))
      (err e (block)))
    ;; to_str copies: pushes and free afterwards leave the str alone
    (let t:str (call to_str c))
    (call push_str c "0")
    (call free c)
    (if (call str.same t "-2147483648") (set! p (+ p 1)) (block))
    p))
