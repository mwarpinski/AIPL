;; std/encode: bytes as text and back: base64 (RFC 4648, standard and
;; URL-safe, padded or not), hex, and percent-encoding (as URLs use it).
;;
;;   (call encode.base64 "hello")              ;; "aGVsbG8="
;;   (call encode.base64_decode "aGVsbG8=")    ;; (ok "hello")
;;   (call encode.hex "AB")                    ;; "4142"
;;   (call encode.percent_encode "a b/c" "/")  ;; "a%20b/c"
;;
;; Each encoding comes as an `_to` function that appends to a buf.Buf (for
;; any bytes) and as one from str to str. Decoding is strict: it returns
;; the index of the first byte it cannot accept as the error, and appends
;; nothing then. What it accepts is what Python's binascii (strict_mode)
;; and urllib.parse accept (tests/aipl/encode, checked against Python).
(module encode
  (import str)
  (import buf)
  (import alloc)

  ;; Which 64 characters base64 uses: `+` and `/` for 62 and 63
  ;; (standard), or `-` and `_` (url_safe, safe in URLs and file names).
  (enum Alphabet [standard url_safe] (pub))
  ;; Whether base64 text ends in `=` to a multiple of 4 characters.
  (enum Padding [padded unpadded] (pub))

  ;; ===== base64 =====

  ;; The character for the 6-bit value d.
  (fn b64_char [d:i32 alphabet:Alphabet] -> i32
    (cond
      ((lt d 26) (+ 65 d))
      ((lt d 52) (+ 71 d))
      ((lt d 62) (- d 4))
      ((eq d 62) (if (eq alphabet Alphabet.standard) 43 45))
      (else (if (eq alphabet Alphabet.standard) 47 95))))

  ;; The 6-bit value of the character c, or -1 if it is not one.
  (fn b64_value [c:i32 alphabet:Alphabet] -> i32
    (cond
      ((and (gte c 65) (lte c 90)) (- c 65))
      ((and (gte c 97) (lte c 122)) (- c 71))
      ((and (gte c 48) (lte c 57)) (+ c 4))
      ((eq alphabet Alphabet.standard) (cond ((eq c 43) 62) ((eq c 47) 63) (else -1)))
      (else (cond ((eq c 45) 62) ((eq c 95) 63) (else -1)))))

  ;; Appends the base64 text of b to o.
  (fn base64_to [o:(ptr buf.Buf) b:(ptr str.Bytes) alphabet:Alphabet padding:Padding] -> void (pub)
    (let n:i32 (get b str.Bytes.len))
    (let i:i32 0)
    (while (lte (+ i 3) n)
      (let w:i32 (bitor (shl (call str.byte_at b i) 16) (bitor (shl (call str.byte_at b (+ i 1)) 8) (call str.byte_at b (+ i 2)))))
      (for k 0 4 (call buf.push_byte o (call b64_char (bitand (shru w (- 18 (* 6 k))) 63) alphabet)))
      (set! i (+ i 3)))
    (let left:i32 (- n i))
    (when (gt left 0)
      (let w:i32 (shl (call str.byte_at b i) 16))
      (when (eq left 2) (set! w (bitor w (shl (call str.byte_at b (+ i 1)) 8))))
      ;; 1 byte gives 2 characters, 2 bytes give 3
      (for k 0 (+ left 1) (call buf.push_byte o (call b64_char (bitand (shru w (- 18 (* 6 k))) 63) alphabet)))
      (when (eq padding Padding.padded)
        (for k left 3 (call buf.push_byte o 61)))))

  ;; Where the base64 text b first goes wrong, or -1 if it is valid: a
  ;; character outside the alphabet, data of 1 more than a multiple of 4
  ;; characters, or (padded) other than the `=`s that make a multiple of 4
  ;; (unpadded: any `=`).
  (fn base64_error [b:(ptr str.Bytes) alphabet:Alphabet padding:Padding] -> i32
    (let n:i32 (get b str.Bytes.len))
    (let p:i32 0)
    (while (and (lt p n) (neq (call str.byte_at b p) 61))
      (when (lt (call b64_value (call str.byte_at b p) alphabet) 0) (return p))
      (set! p (+ p 1)))
    (when (and (lt p n) (eq padding Padding.unpadded)) (return p))
    (when (lt p n)
      ;; leading padding
      (when (eq p 0) (return 0))
      (for k p n (when (neq (call str.byte_at b k) 61) (return k))))
    (when (eq (% p 4) 1) (return n))
    (when (eq padding Padding.padded)
      (let want:i32 (% (- 4 (% p 4)) 4))
      (when (neq (- n p) want) (return (if (lt (- n p) want) n (+ p want)))))
    -1)

  ;; Appends the bytes the base64 text b stands for; how many, or where b
  ;; goes wrong (with nothing appended). Bits left over in the last
  ;; character are ignored, as Python does.
  (fn base64_decode_to [o:(ptr buf.Buf) b:(ptr str.Bytes) alphabet:Alphabet padding:Padding] -> (result i32 i32) (pub)
    (let bad:i32 (call base64_error b alphabet padding))
    (when (gte bad 0) (return (err:i32 bad)))
    (let n:i32 (get b str.Bytes.len))
    (while (and (gt n 0) (eq (call str.byte_at b (- n 1)) 61)) (set! n (- n 1)))
    (let w:i32 0)
    (let bits:i32 0)
    (let out:i32 0)
    (for i 0 n
      (set! w (bitor (shl (bitand w 65535) 6) (call b64_value (call str.byte_at b i) alphabet)))
      (set! bits (+ bits 6))
      (when (gte bits 8)
        (set! bits (- bits 8))
        (call buf.push_byte o (bitand (shru w bits) 255))
        (set! out (+ out 1))))
    (ok:i32 out))

  ;; The standard, padded base64 text of s.
  (fn base64 [s:str] -> str (pub)
    (let o:(ptr buf.Buf) (call buf.make (call alloc.default) (+ (/ (* (str.len s) 4) 3) 4)))
    (call base64_to o (call str.from_str s) Alphabet.standard Padding.padded)
    (call finish o))

  ;; The bytes the standard, padded base64 text s stands for, or the index
  ;; where s goes wrong.
  (fn base64_decode [s:str] -> (result str i32) (pub)
    (let o:(ptr buf.Buf) (call buf.make (call alloc.default) (str.len s)))
    (match_result (call base64_decode_to o (call str.from_str s) Alphabet.standard Padding.padded)
      (ok _n (ok:i32 (call finish o)))
      (err at (call buf.free o) (err:str at))))

  ;; o's contents as a new str; frees o.
  (fn finish [o:(ptr buf.Buf)] -> str
    (let s:str (call buf.to_str o))
    (call buf.free o)
    s)

  ;; ===== hex =====

  ;; The digit for d (0 to 15).
  (fn hex_digit [d:i32 upper:bool] -> i32
    (cond ((lt d 10) (+ 48 d)) (upper (+ 55 d)) (else (+ 87 d))))

  ;; The value of the hex digit c (either case), or -1.
  (fn hex_value [c:i32] -> i32 (pub)
    (cond
      ((and (gte c 48) (lte c 57)) (- c 48))
      ((and (gte c 97) (lte c 102)) (- c 87))
      ((and (gte c 65) (lte c 70)) (- c 55))
      (else -1)))

  ;; Appends two hex digits for each byte of b (A-F if upper, else a-f).
  (fn hex_to [o:(ptr buf.Buf) b:(ptr str.Bytes) upper:bool] -> void (pub)
    (for i 0 (get b str.Bytes.len)
      (let c:i32 (call str.byte_at b i))
      (call buf.push_byte o (call hex_digit (shru c 4) upper))
      (call buf.push_byte o (call hex_digit (bitand c 15) upper))))

  ;; Appends the bytes whose hex digits (either case, no spaces) are b; how
  ;; many, or where b goes wrong (its length if that is odd).
  (fn hex_decode_to [o:(ptr buf.Buf) b:(ptr str.Bytes)] -> (result i32 i32) (pub)
    (let n:i32 (get b str.Bytes.len))
    (for i 0 n (when (lt (call hex_value (call str.byte_at b i)) 0) (return (err:i32 i))))
    (when (eq (% n 2) 1) (return (err:i32 n)))
    (for i 0 (/ n 2)
      (call buf.push_byte o (bitor (shl (call hex_value (call str.byte_at b (* 2 i))) 4) (call hex_value (call str.byte_at b (+ (* 2 i) 1))))))
    (ok:i32 (/ n 2)))

  ;; The lowercase hex digits of s's bytes.
  (fn hex [s:str] -> str (pub)
    (let o:(ptr buf.Buf) (call buf.make (call alloc.default) (* 2 (str.len s))))
    (call hex_to o (call str.from_str s) false)
    (call finish o))

  ;; The bytes whose hex digits are s, or where s goes wrong.
  (fn hex_decode [s:str] -> (result str i32) (pub)
    (let o:(ptr buf.Buf) (call buf.make (call alloc.default) (str.len s)))
    (match_result (call hex_decode_to o (call str.from_str s))
      (ok _n (ok:i32 (call finish o)))
      (err at (call buf.free o) (err:str at))))

  ;; ===== percent-encoding =====

  ;; Whether c is left as it is in every case: A-Z, a-z, 0-9, and `_.-~`
  ;; (RFC 3986's unreserved characters).
  (fn unreserved [c:i32] -> bool
    (or (or (and (gte c 65) (lte c 90)) (and (gte c 97) (lte c 122)))
        (or (and (gte c 48) (lte c 57)) (or (or (eq c 95) (eq c 46)) (or (eq c 45) (eq c 126))))))

  ;; Appends b with each byte other than the unreserved ones and the ASCII
  ;; characters of `keep` written as `%` and two uppercase hex digits; with
  ;; plus, a space is written `+` (as HTML forms send it), as Python's
  ;; urllib.parse.quote(b, safe=keep) and quote_plus do.
  (fn percent_encode_to [o:(ptr buf.Buf) b:(ptr str.Bytes) keep:str plus:bool] -> void (pub)
    (let ks:(ptr str.Bytes) (call str.from_str keep))
    (for i 0 (get b str.Bytes.len)
      (let c:i32 (call str.byte_at b i))
      (cond
        ((and plus (eq c 32)) (call buf.push_byte o 43))
        ((or (call unreserved c) (and (lt c 128) (gte (call str.find_byte ks c) 0))) (call buf.push_byte o c))
        (else
          (call buf.push_byte o 37)
          (call buf.push_byte o (call hex_digit (shru c 4) true))
          (call buf.push_byte o (call hex_digit (bitand c 15) true))))))

  ;; Appends the bytes b stands for, each `%` and two hex digits (either
  ;; case) becoming that byte and, with plus, each `+` a space; how many,
  ;; or the index of a `%` without two hex digits after it. (Python's
  ;; unquote leaves such a `%` as it is; this stops instead.)
  (fn percent_decode_to [o:(ptr buf.Buf) b:(ptr str.Bytes) plus:bool] -> (result i32 i32) (pub)
    (let n:i32 (get b str.Bytes.len))
    (for i 0 n
      (when (eq (call str.byte_at b i) 37)
        (when (gte (+ i 2) n) (return (err:i32 i)))
        (when (or (lt (call hex_value (call str.byte_at b (+ i 1))) 0) (lt (call hex_value (call str.byte_at b (+ i 2))) 0)) (return (err:i32 i)))))
    (let i:i32 0)
    (let out:i32 0)
    (while (lt i n)
      (let c:i32 (call str.byte_at b i))
      (cond
        ((eq c 37)
         (call buf.push_byte o (bitor (shl (call hex_value (call str.byte_at b (+ i 1))) 4) (call hex_value (call str.byte_at b (+ i 2)))))
         (set! i (+ i 3)))
        ((and plus (eq c 43)) (call buf.push_byte o 32) (set! i (+ i 1)))
        (else (call buf.push_byte o c) (set! i (+ i 1))))
      (set! out (+ out 1)))
    (ok:i32 out))

  ;; s percent-encoded, keeping the unreserved characters and those of
  ;; keep: (call encode.percent_encode "a b/c" "/") is "a%20b/c".
  (fn percent_encode [s:str keep:str] -> str (pub)
    (let o:(ptr buf.Buf) (call buf.make (call alloc.default) (* 3 (str.len s))))
    (call percent_encode_to o (call str.from_str s) keep false)
    (call finish o))

  ;; The bytes the percent-encoded s stands for (`+` stays `+`), or the
  ;; index of a `%` without two hex digits after it.
  (fn percent_decode [s:str] -> (result str i32) (pub)
    (let o:(ptr buf.Buf) (call buf.make (call alloc.default) (str.len s)))
    (match_result (call percent_decode_to o (call str.from_str s) false)
      (ok _n (ok:i32 (call finish o)))
      (err at (call buf.free o) (err:str at)))))
