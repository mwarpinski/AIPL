      ((call str.is n "AElig") 198)
      ((call str.is n "AMP") 38)
      ((call str.is n "Aacute") 193)
      ((call str.is n "Acirc") 194)
      ((call str.is n "Agrave") 192)
      ((call str.is n "Alpha") 913)
      ((call str.is n "Aring") 197)
