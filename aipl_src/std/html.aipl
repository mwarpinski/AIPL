      ((call str.is n "Eacute") 201)
      ((call str.is n "Ecirc") 202)
      ((call str.is n "Egrave") 200)
      ((call str.is n "Epsilon") 917)
      ((call str.is n "Eta") 919)
      ((call str.is n "Euml") 203)
      ((call str.is n "GT") 62)
