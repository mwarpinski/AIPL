  ;; Whether name may come without its ';' (HTML5's legacy names).
  (fn legacy [n:str.Bytes] -> bool
    (cond
      ((call str.is n "AElig") true)
      ((call str.is n "AMP") true)
      ((call str.is n "Aacute") true)
      ((call str.is n "Acirc") true)
      ((call str.is n "Agrave") true)
