  ;; The character a numeric reference to n means instead of n, or -1
  ;; (html._invalid_charrefs: mostly the Windows-1252 range).
  (fn replaced [n:i32] -> i32
    (cond
      ((eq n 0) 65533)
      ((eq n 13) 13)
      ((eq n 128) 8364)
      ((eq n 129) 129)
      ((eq n 130) 8218)
      ((eq n 131) 402)
      ((eq n 132) 8222)
      ((eq n 133) 8230)
      ((eq n 134) 8224)
      ((eq n 135) 8225)
      ((eq n 136) 710)
      ((eq n 137) 8240)
      ((eq n 138) 352)
      ((eq n 139) 8249)
      ((eq n 140) 338)
      ((eq n 141) 141)
      ((eq n 142) 381)
      ((eq n 143) 143)
      ((eq n 144) 144)
      ((eq n 145) 8216)
      ((eq n 146) 8217)
      ((eq n 147) 8220)
      ((eq n 148) 8221)
      ((eq n 149) 8226)
      ((eq n 150) 8211)
      ((eq n 151) 8212)
      ((eq n 152) 732)
      ((eq n 153) 8482)
      ((eq n 154) 353)
      ((eq n 155) 8250)
      ((eq n 156) 339)
      ((eq n 157) 157)
      ((eq n 158) 382)
      ((eq n 159) 376)
      (else -1)))
  ;; @end

  ;; Whether a reference to cp means nothing (Python's _invalid_codepoints:
  ;; controls, noncharacters).
  (fn invalid [cp:i32] -> bool
    (or (or (and (gte cp 1) (lte cp 8)) (eq cp 11))
        (or (or (and (gte cp 14) (lte cp 31)) (and (gte cp 127) (lte cp 159)))
            (or (and (gte cp 64976) (lte cp 65007)) (eq (bitand cp 65534) 65534))))))
