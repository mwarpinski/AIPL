;; std/html: text made safe to put in HTML, and character references read
;; back, as Python's html module does.
;;
;;   (call html.escape "<a href=\"x\">")   ;; "&lt;a href=&quot;x&quot;&gt;"
;;   (call html.unescape "caf&eacute; &#x263A;")
;;
;; unescape knows the numeric references (decimal and hex, with or
;; without the ';', mapped as Python maps them: the Windows-1252 range to
;; its characters, a surrogate or a number past U+10FFFF to U+FFFD) and
;; HTML 4's named ones with &apos; (259 names); HTML5's legacy names
;; (&amp, &copy, &eacute, ...) also without the ';', the longest such
;; prefix of a longer name winning (&notit; is "¬it;"). A name it does not
;; know stays as it is. Python knows all 2,231 of HTML5's names; the
;; others are what differs (tests/aipl/html, checked against Python).
(module html
  (import str)
  (import buf)
  (import alloc)
  (import utf8)

  ;; Appends b with & < > written &amp; &lt; &gt;, and with quote also
  ;; " and ' as &quot; and &#x27; (for attribute values), as Python's
  ;; html.escape does.
  (fn escape_to [o:(ptr buf.Buf) b:str.Bytes quote:bool] -> void (pub)
    (for i 0 (get b str.Bytes.len)
      (let c:i32 (call str.byte_at b i))
      (cond
        ((eq c 38) (call buf.push_str o "&amp;"))
        ((eq c 60) (call buf.push_str o "&lt;"))
        ((eq c 62) (call buf.push_str o "&gt;"))
        ((and quote (eq c 34)) (call buf.push_str o "&quot;"))
        ((and quote (eq c 39)) (call buf.push_str o "&#x27;"))
        (else (call buf.push_byte o c)))))

  ;; s escaped for anywhere in HTML, quotes included.
  (fn escape [s:str] -> str (pub)
    (let o:(ptr buf.Buf) (call buf.make (call alloc.default) (+ (str.len s) 16)))
    (call escape_to o (call str.from_str s) true)
    (call finish o))

  ;; s with its character references replaced.
  (fn unescape [s:str] -> str (pub)
    (let o:(ptr buf.Buf) (call buf.make (call alloc.default) (+ (str.len s) 16)))
    (call unescape_to o (call str.from_str s))
    (call finish o))

  (fn finish [o:(ptr buf.Buf)] -> str
    (let s:str (call buf.to_str o))
    (call buf.free o)
    s)

  (fn is_digit [c:i32] -> bool (and (gte c 48) (lte c 57)))
  (fn hex_value [c:i32] -> i32
    (cond
      ((call is_digit c) (- c 48))
      ((and (gte c 97) (lte c 102)) (- c 87))
      ((and (gte c 65) (lte c 70)) (- c 55))
      (else -1)))

  ;; Appends b with its character references replaced (b is UTF-8).
  (fn unescape_to [o:(ptr buf.Buf) b:str.Bytes] -> void (pub)
    (let n:i32 (get b str.Bytes.len))
    (let i:i32 0)
    (while (lt i n)
      (let c:i32 (call str.byte_at b i))
      (if (neq c 38)
          (block (call buf.push_byte o c) (set! i (+ i 1)))
          (set! i (call reference o b (+ i 1))))))

  ;; After an '&' at i - 1: appends what the reference there means (or the
  ;; '&' alone if there is none); the index after it.
  (fn reference [o:(ptr buf.Buf) b:str.Bytes i:i32] -> i32
    (let n:i32 (get b str.Bytes.len))
    (when (and (lt i n) (eq (call str.byte_at b i) 35)) (return (call numeric o b (+ i 1))))
    ;; a name: up to 32 characters that are not \t \n \f space < & # ;
    (let end:i32 i)
    (let chars:i32 0)
    (while (and (lt end n) (lt chars 32))
      (let c:i32 (call str.byte_at b end))
      (when (or (or (eq c 9) (eq c 10)) (or (or (eq c 12) (eq c 32)) (or (eq c 60) (or (eq c 38) (or (eq c 35) (eq c 59)))))) (break))
      (set! end (+ end (call utf8.step (call utf8.decode b end))))
      (set! chars (+ chars 1)))
    (when (eq end i) (call buf.push_byte o 38) (return i))
    (let semi:bool (and (lt end n) (eq (call str.byte_at b end) 59)))
    (let after:i32 (if semi (+ end 1) end))
    (let name:str.Bytes (call str.slice b i (- end i)))
    (let cp:i32 (if semi (call named name) (if (call legacy name) (call named name) -1)))
    (when (gte cp 0) (call utf8.encode o cp) (return after))
    ;; the longest legacy name the text starts with (at least 2 characters)
    (let x:i32 (- end 1))
    (when semi (set! x end))
    (while (gte (- x i) 2)
      ;; x on a character boundary
      (when (neq (bitand (call str.byte_at b x) 192) 128)
        (let prefix:str.Bytes (call str.slice b i (- x i)))
        (when (call legacy prefix)
          (call utf8.encode o (call named prefix))
          (return x)))
      (set! x (- x 1)))
    (call buf.push_byte o 38)
    i)

  ;; After "&#" at i: a decimal or (after x or X) hex number, then an
  ;; optional ';'. No digits: the '&' alone.
  (fn numeric [o:(ptr buf.Buf) b:str.Bytes i:i32] -> i32
    (let n:i32 (get b str.Bytes.len))
    (let hex:bool (and (lt i n) (or (eq (call str.byte_at b i) 120) (eq (call str.byte_at b i) 88))))
    (let p:i32 (if hex (+ i 1) i))
    (let start:i32 p)
    (let v:i32 0)
    (while (and (lt p n) (if hex (gte (call hex_value (call str.byte_at b p)) 0) (call is_digit (call str.byte_at b p))))
      (let d:i32 (if hex (call hex_value (call str.byte_at b p)) (- (call str.byte_at b p) 48)))
      ;; past U+10FFFF it is U+FFFD however large: stop growing
      (when (lte v 1114111) (set! v (+ (* v (if hex 16 10)) d)))
      (set! p (+ p 1)))
    (when (eq p start) (call buf.push_byte o 38) (return (- i 1)))
    (when (and (lt p n) (eq (call str.byte_at b p) 59)) (set! p (+ p 1)))
    (let r:i32 (call replaced v))
    (cond
      ((gte r 0) (call utf8.encode o r))
      ((or (and (gte v 55296) (lte v 57343)) (gt v 1114111)) (call utf8.encode o 65533))
      ((call invalid v) (block))
      (else (call utf8.encode o v)))
    p)

  ;; ===== the tables =====

  ;; @tables (tools/html_tables.py)
  ;; The code point of the named reference name (without its ';'), or -1.
  (fn named [n:str.Bytes] -> i32
