;; std/http: HTTP/1.1 messages (RFC 9112): read a request or a response from
;; bytes, and write one; and fetch a URL over a connection.
;;
;;   (match_result (call http.parse_request a text (call http.default_limits))
;;     (ok m ... (get m http.Message.method) (call http.header m "host") ...)
;;     (err e ... (get e http.Error.what) ...))
;;   (call http.start_response o 200)
;;   (call http.add_header o "Content-Type" (call http.mime_type "page.html"))
;;   (call http.end_head o body)               ;; Content-Length, then body
;;
;; Reading is strict where leniency lets two readers disagree about where
;; a message ends (request smuggling): a space before a header's ':', a
;; folded header line, both Transfer-Encoding and Content-Length, two
;; different Content-Lengths, or a transfer coding other than a final
;; "chunked" is an error. Lines may end with CRLF or a bare LF (RFC 9112,
;; 2.2). Limits cap the head, the number of headers, and the body. A
;; program can read a saved request, or one piped through stdin, and
;; answer on stdout.
;;
;;   (match_result (call http.fetch a "http://127.0.0.1:9000/stock?item=7" (call http.default_limits))
;;     (ok m ... (get m http.Message.status) (get m http.Message.body) ... (call http.free_message m))
;;     (err e ... (get e http.Error.what) ...))
;;
;; fetch is a GET over a connection (std/net), which the program must be granted
;; (--allow-connect ADDR:PORT): plain http:// to an address, not a name, and not https:// (no
;; TLS here). It sends `Connection: close`, reads to the end, and does not follow redirects.
(module http
  (import str)
  (import buf)
  (import alloc)
  (import vec)
  (import option)
  (import ip)
  (import net)
  (import url)

  ;; Why a message was refused, and the byte offset where; the response
  ;; status the refusal calls for (400, or 413 for a body over the limit,
  ;; 431 for a head or header count over it); and whether the bytes were
  ;; only cut short, so that more of them could make a whole message (a
  ;; server reading a request a piece at a time reads on).
  (struct Error [(read at:i32) (read what:str) (read status:i32) (read incomplete:bool)] (pub))

  ;; A header as it came (name and value without the spaces around it).
  (struct Header [(read name:str.Bytes) (read value:str.Bytes)] (value) (pub))

  ;; The most a message may hold: bytes of head (the start line and the
  ;; headers), headers, and bytes of body.
  (struct Limits [(read head_bytes:i32) (read headers:i32) (read body_bytes:i32)] (value) (pub))

  ;; A message read: a request's method and target, or a response's status
  ;; and reason; the version ("HTTP/1.1"); the headers in order; the body
  ;; (chunked bodies put together); and length, the bytes it took (another
  ;; message may follow). The views point into the text read, but a
  ;; chunked body is the message's own (free_message frees it).
  (struct Message [(read is_request:bool) (read method:str.Bytes) (read target:str.Bytes)
                   (read status:i32) (read reason:str.Bytes) (read version:str.Bytes)
                   (read headers:(ptr (vec.Vec Header))) (read body:str.Bytes) (read length:i32)
                   chunks:(ptr buf.Buf) a:alloc.Allocator text:(ptr buf.Buf)] (pub))

  ;; 64 KiB of head, 100 headers, 8 MiB of body.
  (fn default_limits [] -> Limits (pub) (make Limits [head_bytes:65536
                                                      headers:100
                                                      body_bytes:8388608]))

  ;; Limits of your own.
  (fn limits [head_bytes:i32 headers:i32 body_bytes:i32] -> Limits (pub)
    (req (and (gt head_bytes 0) (and (gte headers 0) (gte body_bytes 0))))
    (make Limits [head_bytes:head_bytes headers:headers body_bytes:body_bytes]))

  (fn error [a:alloc.Allocator at:i32 what:str] -> (ptr Error)
    (call error_as a at what 400 false))

  (fn error_as [a:alloc.Allocator at:i32 what:str status:i32 incomplete:bool] -> (ptr Error)
    (let e:(ptr Error) (new Error a [at:at what:what status:status incomplete:incomplete]))
    e)

  ;; Cut short: more bytes could complete the message.
  (fn short [a:alloc.Allocator at:i32 what:str] -> (ptr Error)
    (call error_as a at what 400 true))

  ;; Frees an Error parse_request or parse_response gave.
  (fn free_error [a:alloc.Allocator e:(ptr Error)] -> void (pub) (call (alloc.destroy Error) a e))

  ;; Frees the message (its header list and any chunked body).
  (fn free_message [m:(ptr Message)] -> void (pub)
    (let a:alloc.Allocator (get m Message.a))
    (call (vec.free Header) (get m Message.headers))
    (when (neq (get m Message.chunks) (ptr.null buf.Buf)) (call buf.free (get m Message.chunks)))
    (when (neq (get m Message.text) (ptr.null buf.Buf)) (call buf.free (get m Message.text)))
    (call (alloc.destroy Message) a m))

  ;; ===== fetching =====

  ;; The response to a GET of `url` (http://ADDR[:PORT][/path][?query], read by std/url; port 80 unless
  ;; given; an address, not a name), or why there is none: an Error with status 0 for a failure before
  ;; or after the exchange (a URL that is not one this reads, a connection not granted or refused, a
  ;; response that is cut short, over the limits, or not HTTP) and the message's own refusal
  ;; otherwise. The message holds the bytes it was read from: free_message gives them back.
  (fn fetch [a:alloc.Allocator url:str lim:Limits] -> (result (ptr Message) (ptr Error)) (pub)
    (match_result (call url.parse a (call str.from_str url))
      (ok u
        (let out:(result (ptr Message) (ptr Error)) (call fetch_url a u lim))
        (call url.free u)
        out)
      (err e
        (let why:(ptr Error) (call error_as a (get e url.Error.at) (get e url.Error.what) 0 false))
        (call url.free_error a e)
        (err:(ptr Message) why))))

  (fn fetch_url [a:alloc.Allocator u:(ptr url.Url) lim:Limits] -> (result (ptr Message) (ptr Error))
    (let scheme:str.Bytes (get u url.Url.scheme))
    (when (call str.eq_ignore_case scheme (call str.from_str "https"))
      (return (err:(ptr Message) (call error_as a 0 "https:// needs TLS, which AIPL does not have yet: use http://, or a TLS proxy in front" 0 false))))
    (when (not (call str.eq_ignore_case scheme (call str.from_str "http")))
      (return (err:(ptr Message) (call error_as a 0 "not an http:// URL" 0 false))))
    (when (get u url.Url.has_user)
      (return (err:(ptr Message) (call error_as a 0 "a URL with user information is not supported" 0 false))))
    (match (call ip.parse (get u url.Url.host))
      ((option.Option ip.Addr) none
       (err:(ptr Message) (call error_as a 0 "not an address: this reads http://ADDR[:PORT]/ (127.0.0.1:9000, [::1]:9000), not a name (there is no resolver yet)" 0 false)))
      ((option.Option ip.Addr) some [ad]
       (let port:i32 (if (lt (get u url.Url.port) 0) 80 (get u url.Url.port)))
       ;; the target: the path (or /), then ?query
       (let target:(ptr buf.Buf) (call buf.make a 64))
       (if (eq (get (get u url.Url.path) str.Bytes.len) 0)
           (call buf.push_byte target 47)
           (call buf.push_bytes target (get u url.Url.path)))
       (when (get u url.Url.has_query)
         (call buf.push_byte target 63)
         (call buf.push_bytes target (get u url.Url.query)))
       (let out:(result (ptr Message) (ptr Error))
         (match_result (call net.connect_to a (call ip.endpoint ad port))
           (ok c (call exchange a c (get u url.Url.authority) (call buf.to_str target) lim))
           (err why (err:(ptr Message) (call error_as a 0 (call net.message why) 0 false)))))
       (call buf.free target)
       out)))

  ;; GET target on the connection c (closed before this returns), and the response read to the end.
  (fn exchange [a:alloc.Allocator c:net.Socket authority:str.Bytes target:str lim:Limits] -> (result (ptr Message) (ptr Error))
    (let req:(ptr buf.Buf) (call buf.make a 256))
    (call start_request req "GET" target)
    (call buf.push_str req "Host: ")
    (call buf.push_bytes req authority)
    (call buf.push_str req "\r\nConnection: close\r\nAccept: */*\r\n\r\n")
    (let sent:bool (call net.send c (call buf.bytes req)))
    (call buf.free req)
    (when (not sent)
      (call net.close c)
      (return (err:(ptr Message) (call error_as a 0 "the request could not be sent" 0 false))))
    ;; everything to the end of the connection, within the limits (and a little more, for chunk framing)
    (let cap:i32 (+ (+ (get lim Limits.head_bytes) (get lim Limits.body_bytes)) 65536))
    (let text:(ptr buf.Buf) (call buf.make a 4096))
    (let reading:bool true)
    (while reading
      (let got:i32 (call net.recv c text 8192))
      (cond ((lt got 0) (call buf.free text) (call net.close c)
             (return (err:(ptr Message) (call error_as a 0 "the connection failed while reading the response" 0 false))))
            ((eq got 0) (set! reading false))
            ((gt (call buf.len text) cap) (call buf.free text) (call net.close c)
             (return (err:(ptr Message) (call error_as a (call buf.len text) "the response is larger than the limits" 502 false))))
            (else (block))))
    (call net.close c)
    (match_result (call parse_response a (call buf.bytes text) lim)
      (ok m
        ;; the message's views point into text: it is the message's now
        (put m Message.text text)
        (ok:(ptr Error) m))
      (err e (call buf.free text) (err:(ptr Message) e))))

  ;; ===== reading =====

  ;; A token's characters (RFC 9110, 5.6.2): what names and methods are made of.
  (fn tchar [c:i32] -> bool
    (or (and (gte c 48) (lte c 57)) (and (gte c 65) (lte c 90)) (and (gte c 97) (lte c 122))
        (eq c 33) (eq c 35) (eq c 36) (eq c 37) (eq c 38) (eq c 39) (eq c 42) (eq c 43)
        (eq c 45) (eq c 46) (eq c 94) (eq c 95) (eq c 96) (eq c 124) (eq c 126)))

  ;; The end of the line starting at p (the index of its LF, or of the CR
  ;; before it), or -1 if no line ends before limit.
  (fn line_end [b:str.Bytes p:i32 limit:i32] -> i32
    (let n:i32 (if (lt (get b str.Bytes.len) limit) (get b str.Bytes.len) limit))
    (for i p n
      (when (eq (call str.byte_at b i) 10)
        (return (if (and (gt i p) (eq (call str.byte_at b (- i 1)) 13)) (- i 1) i))))
    -1)

  ;; The index after the line ending at end.
  (fn next_line [b:str.Bytes end:i32] -> i32 (if (eq (call str.byte_at b end) 13) (+ end 2) (+ end 1)))

  (fn view [b:str.Bytes from:i32 to:i32] -> str.Bytes (call str.slice b from (- to from)))

  ;; Whether b[from..to) is "HTTP/" digit "." digit.
  (fn is_version [b:str.Bytes from:i32 to:i32] -> bool
    (and (eq (- to from) 8)
         (and (call str.is_at b from "HTTP/")
              (and (call is_digit (call str.byte_at b (+ from 5)))
                   (and (eq (call str.byte_at b (+ from 6)) 46) (call is_digit (call str.byte_at b (+ from 7))))))))

  (fn is_digit [c:i32] -> bool (and (gte c 48) (lte c 57)))

  ;; The request in text (from its start), or why it is not one.
  (fn parse_request [a:alloc.Allocator text:str.Bytes lim:Limits] -> (result (ptr Message) (ptr Error)) (pub)
    (call parse a text lim true))

  ;; The response in text (from its start), or why it is not one. The body
  ;; of a response with neither Content-Length nor Transfer-Encoding is the
  ;; rest of text (it ends when the connection closes); a 1xx, 204, or 304
  ;; response has none.
  (fn parse_response [a:alloc.Allocator text:str.Bytes lim:Limits] -> (result (ptr Message) (ptr Error)) (pub)
    (call parse a text lim false))

  (fn parse [a:alloc.Allocator text:str.Bytes lim:Limits request:bool] -> (result (ptr Message) (ptr Error))
    (let n:i32 (get text str.Bytes.len))
    (let head_limit:i32 (get lim Limits.head_bytes))
    (let empty:str.Bytes (call view text 0 0))
    (let first:i32 (call line_end text 0 head_limit))
    (when (lt first 0) (return (err:(ptr Message) (call head_error a text head_limit))))
    ;; the start line: three parts with one space between each
    (let s1:i32 (call find_byte text 0 first 32))
    (when (eq s1 first) (return (err:(ptr Message) (call error a 0 "a start line without spaces"))))
    (let s2:i32 (call find_byte text (+ s1 1) first 32))
    (when (and request (eq s2 first)) (return (err:(ptr Message) (call error a s1 "a request line without a version"))))
    (let method:str.Bytes empty)
    (let target:str.Bytes empty)
    (let version:str.Bytes empty)
    (let status:i32 0)
    (let reason:str.Bytes empty)
    (if request
        (block
          (when (eq s1 0) (return (err:(ptr Message) (call error a 0 "an empty method"))))
          (for i 0 s1 (when (not (call tchar (call str.byte_at text i))) (return (err:(ptr Message) (call error a i "a method that is not a token")))))
          (when (or (eq s2 (+ s1 1)) (lt (call find_byte text (+ s1 1) s2 9) s2)) (return (err:(ptr Message) (call error a (+ s1 1) "an empty or spaced target"))))
          (when (not (call is_version text (+ s2 1) first)) (return (err:(ptr Message) (call error a (+ s2 1) "a version that is not HTTP/d.d"))))
          (set! method (call view text 0 s1))
          (set! target (call view text (+ s1 1) s2))
          (set! version (call view text (+ s2 1) first)))
        (block
          (when (not (call is_version text 0 s1)) (return (err:(ptr Message) (call error a 0 "a version that is not HTTP/d.d"))))
          (let code_end:i32 (if (lt s2 first) s2 first))
          (when (or (neq (- code_end (+ s1 1)) 3) (not (and (call is_digit (call str.byte_at text (+ s1 1))) (and (call is_digit (call str.byte_at text (+ s1 2))) (call is_digit (call str.byte_at text (+ s1 3)))))))
            (return (err:(ptr Message) (call error a (+ s1 1) "a status that is not three digits"))))
          (set! status (+ (* 100 (- (call str.byte_at text (+ s1 1)) 48)) (+ (* 10 (- (call str.byte_at text (+ s1 2)) 48)) (- (call str.byte_at text (+ s1 3)) 48))))
          (set! version (call view text 0 s1))
          (set! reason (if (lt s2 first) (call view text (+ s2 1) first) empty))))
    ;; the headers, to an empty line
    (let headers:(ptr (vec.Vec Header)) (call (vec.make Header) a 8))
    (let p:i32 (call next_line text first))
    (let done:bool false)
    (while (not done)
      (let end:i32 (call line_end text p head_limit))
      (when (lt end 0) (call (vec.free Header) headers) (return (err:(ptr Message) (call head_error a text head_limit))))
      (if (eq end p)
          (set! done true)
          (block
            (let c0:i32 (call str.byte_at text p))
            (when (or (eq c0 32) (eq c0 9)) (call (vec.free Header) headers) (return (err:(ptr Message) (call error a p "a folded header line (obs-fold)"))))
            (let colon:i32 (call find_byte text p end 58))
            (when (eq colon end) (call (vec.free Header) headers) (return (err:(ptr Message) (call error a p "a header line without a ':'"))))
            (when (eq colon p) (call (vec.free Header) headers) (return (err:(ptr Message) (call error a p "an empty header name"))))
            (for i p colon
              (when (not (call tchar (call str.byte_at text i)))
                (call (vec.free Header) headers)
                (return (err:(ptr Message) (call error a i (if (or (eq (call str.byte_at text i) 32) (eq (call str.byte_at text i) 9)) "a space in or after a header name" "a header name that is not a token"))))))
            (let vs:i32 (+ colon 1))
            (let ve:i32 end)
            (while (and (lt vs ve) (call is_ows (call str.byte_at text vs))) (set! vs (+ vs 1)))
            (while (and (gt ve vs) (call is_ows (call str.byte_at text (- ve 1)))) (set! ve (- ve 1)))
            (for i vs ve
              (let c:i32 (call str.byte_at text i))
              (when (or (eq c 0) (or (eq c 13) (eq c 10))) (call (vec.free Header) headers) (return (err:(ptr Message) (call error a i "a NUL, CR, or LF in a header value")))))
            (when (gte (call (vec.len Header) headers) (get lim Limits.headers))
              (call (vec.free Header) headers)
              (return (err:(ptr Message) (call error_as a p "more headers than the limit" 431 false))))
            (call (vec.push Header) headers (make Header [name:(call view text p colon)
                                                          value:(call view text vs ve)]))))
      (set! p (call next_line text end)))
    (let m:(ptr Message) (new Message a [is_request:request
                                         method:method
                                         target:target
                                         status:status
                                         reason:reason
                                         version:version
                                         headers:headers
                                         body:(zero str.Bytes)
                                         length:(zero i32)
                                         chunks:(ptr.null buf.Buf)
                                         a:a
                                         text:(ptr.null buf.Buf)]))
    (put m Message.body empty)
    (put m Message.length p)
    (match_result (call read_body m text p lim)
      (ok _e (ok:(ptr Error) m))
      (err e (call free_message m) (err:(ptr Message) e))))

  (fn is_ows [c:i32] -> bool (or (eq c 32) (eq c 9)))

  ;; The index of byte c in b[from..to), or to.
  (fn find_byte [b:str.Bytes from:i32 to:i32 c:i32] -> i32
    (for i from to (when (eq (call str.byte_at b i) c) (return i)))
    to)

  ;; The error for a head with no end: past the limit, or cut short.
  (fn head_error [a:alloc.Allocator text:str.Bytes limit:i32] -> (ptr Error)
    (if (gte (get text str.Bytes.len) limit)
        (call error_as a limit "a head over the limit" 431 false)
        (call short a (get text str.Bytes.len) "the head ends early")))

  ;; Sets the body from text at p, by Transfer-Encoding or Content-Length.
  (fn read_body [m:(ptr Message) text:str.Bytes p:i32 lim:Limits] -> (result i32 (ptr Error))
    (let a:alloc.Allocator (get m Message.a))
    (let n:i32 (get text str.Bytes.len))
    (let te:i32 -1)
    (let cl:i64 -1i64)
    (let headers:(ptr (vec.Vec Header)) (get m Message.headers))
    (for k 0 (call (vec.len Header) headers)
      (let h:Header (call (vec.at Header) headers k))
      (let name:str.Bytes (get h Header.name))
      (when (call str.eq_ignore_case name (call str.from_str "transfer-encoding"))
        (when (gte te 0) (return (err:i32 (call error a p "two Transfer-Encoding headers"))))
        (set! te k))
      (when (call str.eq_ignore_case name (call str.from_str "content-length"))
        (let v:str.Bytes (get h Header.value))
        (when (eq (get v str.Bytes.len) 0) (return (err:i32 (call error a p "an empty Content-Length"))))
        (let declared:i64 0i64)
        (for i 0 (get v str.Bytes.len)
          (let d:i32 (call str.byte_at v i))
          (when (not (call is_digit d)) (return (err:i32 (call error a p "a Content-Length that is not a number"))))
          (set! declared (+ (* declared 10i64) (i64.extend_u (- d 48))))
          (when (gt declared 4294967296i64) (set! declared 4294967296i64)))
        (when (and (gte cl 0i64) (neq cl declared)) (return (err:i32 (call error a p "two different Content-Lengths"))))
        (set! cl declared)))
    (let status:i32 (get m Message.status))
    (let request:bool (get m Message.is_request))
    ;; responses that never have a body
    (when (and (not request) (or (and (gte status 100) (lt status 200)) (or (eq status 204) (eq status 304)))) (return (ok:(ptr Error) 0)))
    (when (and (gte te 0) (gte cl 0i64)) (return (err:i32 (call error a p "both Transfer-Encoding and Content-Length"))))
    (let body_limit:i32 (get lim Limits.body_bytes))
    (cond
      ((gte te 0)
       (let v:str.Bytes (get (call (vec.at Header) headers te) Header.value))
       (when (not (call str.eq_ignore_case v (call str.from_str "chunked"))) (return (err:i32 (call error a p "a transfer coding other than chunked"))))
       (call read_chunks m text p body_limit))
      ((gte cl 0i64)
       (when (gt cl (i64.extend_u body_limit)) (return (err:i32 (call error_as a p "a body over the limit" 413 false))))
       (let len:i32 (i32.wrap cl))
       (when (gt (+ p len) n) (return (err:i32 (call short a n "the body ends early"))))
       (put m Message.body (call view text p (+ p len)))
       (put m Message.length (+ p len))
       (ok:(ptr Error) len))
      (request (ok:(ptr Error) 0))
      (else
        (when (gt (- n p) body_limit) (return (err:i32 (call error_as a p "a body over the limit" 413 false))))
        (put m Message.body (call view text p n))
        (put m Message.length n)
        (ok:(ptr Error) (- n p)))))

  ;; A chunked body (RFC 9112, 7.1): chunks of a hex size (extensions
  ;; after ';' ignored), CRLF, the bytes, CRLF; a 0 chunk; trailer lines
  ;; (ignored); an empty line.
  (fn read_chunks [m:(ptr Message) text:str.Bytes p0:i32 limit:i32] -> (result i32 (ptr Error))
    (let a:alloc.Allocator (get m Message.a))
    (let n:i32 (get text str.Bytes.len))
    (let o:(ptr buf.Buf) (call buf.make a 256))
    (put m Message.chunks o)
    (let p:i32 p0)
    (while true
      (let end:i32 (call line_end text p n))
      (when (lt end 0) (return (err:i32 (call short a n "the body ends early"))))
      (let size:i64 0i64)
      (let i:i32 p)
      (while (and (lt i end) (gte (call hex_value (call str.byte_at text i)) 0))
        (set! size (+ (* size 16i64) (i64.extend_u (call hex_value (call str.byte_at text i)))))
        (when (gt size 4294967296i64) (set! size 4294967296i64))
        (set! i (+ i 1)))
      (when (eq i p) (return (err:i32 (call error a p "a chunk size that is not hex"))))
      (when (and (lt i end) (not (or (eq (call str.byte_at text i) 59) (call is_ows (call str.byte_at text i))))) (return (err:i32 (call error a i "text after a chunk size"))))
      (set! p (call next_line text end))
      (when (eq size 0i64)
        ;; trailers, to an empty line
        (let tend:i32 (call line_end text p n))
        (while (gt tend p)
          (set! p (call next_line text tend))
          (set! tend (call line_end text p n)))
        (when (lt tend 0) (return (err:i32 (call short a n "the body ends early"))))
        (put m Message.body (call buf.bytes o))
        (put m Message.length (call next_line text tend))
        (return (ok:(ptr Error) (call buf.len o))))
      (when (gt (+ (i64.extend_u (call buf.len o)) size) (i64.extend_u limit)) (return (err:i32 (call error_as a p "a body over the limit" 413 false))))
      (let len:i32 (i32.wrap size))
      (when (gt (+ p len) n) (return (err:i32 (call short a n "the body ends early"))))
      (call buf.push_bytes o (call view text p (+ p len)))
      (set! p (+ p len))
      ;; the chunk's CRLF
      (let after:i32 (call line_end text p n))
      (when (neq after p) (return (err:i32 (call error a p "a chunk without its line end"))))
      (set! p (call next_line text after)))
    (ok:(ptr Error) 0))

  (fn hex_value [c:i32] -> i32
    (cond
      ((call is_digit c) (- c 48))
      ((and (gte c 97) (lte c 102)) (- c 87))
      ((and (gte c 65) (lte c 70)) (- c 55))
      (else -1)))

  ;; The value of the first header named name (ignoring case), if any.
  (fn header [m:(ptr Message) name:str] -> (option.Option str.Bytes) (pub)
    (let headers:(ptr (vec.Vec Header)) (get m Message.headers))
    (let want:str.Bytes (call str.from_str name))
    (for k 0 (call (vec.len Header) headers)
      (let h:Header (call (vec.at Header) headers k))
      (when (call str.eq_ignore_case (get h Header.name) want) (return (make (option.Option str.Bytes) some (get h Header.value)))))
    (make (option.Option str.Bytes) none))

  ;; ===== writing =====

  ;; Whether s can go in a start line or header as it is: no CR, LF, or NUL.
  (fn clean [s:str] -> bool (pub)
    (let b:str.Bytes (call str.from_str s))
    (for i 0 (get b str.Bytes.len)
      (let c:i32 (call str.byte_at b i))
      (when (or (eq c 0) (or (eq c 13) (eq c 10))) (return false)))
    true)

  ;; Whether s is a token (RFC 9110, 5.6.2): what header names and
  ;; methods must be.
  (fn token [s:str] -> bool (pub)
    (let b:str.Bytes (call str.from_str s))
    (when (eq (get b str.Bytes.len) 0) (return false))
    (for i 0 (get b str.Bytes.len) (when (not (call tchar (call str.byte_at b i))) (return false)))
    true)

  ;; Appends a request line, "METHOD target HTTP/1.1".
  (fn start_request [o:(ptr buf.Buf) method:str target:str] -> void (pub)
    (req (and (call token method) (call clean target)))
    (call buf.push_str o method)
    (call buf.push_byte o 32)
    (call buf.push_str o target)
    (call buf.push_str o " HTTP/1.1\r\n"))

  ;; Appends a status line, "HTTP/1.1 200 OK", with the status's reason.
  (fn start_response [o:(ptr buf.Buf) status:i32] -> void (pub)
    (req (and (gte status 100) (lte status 999)))
    (call buf.push_str o "HTTP/1.1 ")
    (call buf.push_int o status)
    (call buf.push_byte o 32)
    (call buf.push_str o (call reason status))
    (call buf.push_str o "\r\n"))

  ;; ===== reason phrases =====

  ;; The reason phrase for status (as Python's http.HTTPStatus has them),
  ;; or "Unknown".
  ;; @tables (tools/http_tables.py)
  (fn reason [status:i32] -> str (pub)
    (cond
      ((eq status 100) "Continue")
      ((eq status 101) "Switching Protocols")
      ((eq status 102) "Processing")
      ((eq status 103) "Early Hints")
      ((eq status 200) "OK")
      ((eq status 201) "Created")
      ((eq status 202) "Accepted")
      ((eq status 203) "Non-Authoritative Information")
      ((eq status 204) "No Content")
      ((eq status 205) "Reset Content")
      ((eq status 206) "Partial Content")
      ((eq status 207) "Multi-Status")
      ((eq status 208) "Already Reported")
      ((eq status 226) "IM Used")
      ((eq status 300) "Multiple Choices")
      ((eq status 301) "Moved Permanently")
      ((eq status 302) "Found")
      ((eq status 303) "See Other")
      ((eq status 304) "Not Modified")
      ((eq status 305) "Use Proxy")
      ((eq status 307) "Temporary Redirect")
      ((eq status 308) "Permanent Redirect")
      ((eq status 400) "Bad Request")
      ((eq status 401) "Unauthorized")
      ((eq status 402) "Payment Required")
      ((eq status 403) "Forbidden")
      ((eq status 404) "Not Found")
      ((eq status 405) "Method Not Allowed")
      ((eq status 406) "Not Acceptable")
      ((eq status 407) "Proxy Authentication Required")
      ((eq status 408) "Request Timeout")
      ((eq status 409) "Conflict")
      ((eq status 410) "Gone")
      ((eq status 411) "Length Required")
      ((eq status 412) "Precondition Failed")
      ((eq status 413) "Content Too Large")
      ((eq status 414) "URI Too Long")
      ((eq status 415) "Unsupported Media Type")
      ((eq status 416) "Range Not Satisfiable")
      ((eq status 417) "Expectation Failed")
      ((eq status 418) "I'm a Teapot")
      ((eq status 421) "Misdirected Request")
      ((eq status 422) "Unprocessable Content")
      ((eq status 423) "Locked")
      ((eq status 424) "Failed Dependency")
      ((eq status 425) "Too Early")
      ((eq status 426) "Upgrade Required")
      ((eq status 428) "Precondition Required")
      ((eq status 429) "Too Many Requests")
      ((eq status 431) "Request Header Fields Too Large")
      ((eq status 451) "Unavailable For Legal Reasons")
      ((eq status 500) "Internal Server Error")
      ((eq status 501) "Not Implemented")
      ((eq status 502) "Bad Gateway")
      ((eq status 503) "Service Unavailable")
      ((eq status 504) "Gateway Timeout")
      ((eq status 505) "HTTP Version Not Supported")
      ((eq status 506) "Variant Also Negotiates")
      ((eq status 507) "Insufficient Storage")
      ((eq status 508) "Loop Detected")
      ((eq status 510) "Not Extended")
      ((eq status 511) "Network Authentication Required")
      (else "Unknown")))
  ;; @end

  ;; Appends a header line, "Name: value".
  (fn add_header [o:(ptr buf.Buf) name:str value:str] -> void (pub)
    (req (and (call token name) (call clean value)))
    (call buf.push_str o name)
    (call buf.push_str o ": ")
    (call buf.push_str o value)
    (call buf.push_str o "\r\n"))

  ;; Appends Content-Length for body, the empty line, and body.
  (fn end_head [o:(ptr buf.Buf) body:str.Bytes] -> void (pub)
    (call buf.push_str o "Content-Length: ")
    (call buf.push_int o (get body str.Bytes.len))
    (call buf.push_str o "\r\n\r\n")
    (call buf.push_bytes o body))

  ;; The content type for a file name, by its extension (ignoring case),
  ;; from a fixed table of the common ones (text types with charset=utf-8);
  ;; application/octet-stream for others.
  (fn mime_type [name:str] -> str (pub)
    (let b:str.Bytes (call str.from_str name))
    (let dot:i32 -1)
    (for i 0 (get b str.Bytes.len)
      (let c:i32 (call str.byte_at b i))
      (when (eq c 46) (set! dot i))
      (when (eq c 47) (set! dot -1)))
    (when (lt dot 0) (return "application/octet-stream"))
    (let e:str.Bytes (call str.slice b (+ dot 1) (- (- (get b str.Bytes.len) dot) 1)))
    (cond
      ((call ext e "html") "text/html; charset=utf-8")
      ((call ext e "htm") "text/html; charset=utf-8")
      ((call ext e "css") "text/css; charset=utf-8")
      ((call ext e "js") "text/javascript; charset=utf-8")
      ((call ext e "mjs") "text/javascript; charset=utf-8")
      ((call ext e "json") "application/json")
      ((call ext e "txt") "text/plain; charset=utf-8")
      ((call ext e "md") "text/markdown; charset=utf-8")
      ((call ext e "csv") "text/csv; charset=utf-8")
      ((call ext e "xml") "application/xml")
      ((call ext e "svg") "image/svg+xml")
      ((call ext e "png") "image/png")
      ((call ext e "jpg") "image/jpeg")
      ((call ext e "jpeg") "image/jpeg")
      ((call ext e "gif") "image/gif")
      ((call ext e "webp") "image/webp")
      ((call ext e "ico") "image/vnd.microsoft.icon")
      ((call ext e "wasm") "application/wasm")
      ((call ext e "pdf") "application/pdf")
      ((call ext e "zip") "application/zip")
      ((call ext e "gz") "application/gzip")
      ((call ext e "tar") "application/x-tar")
      ((call ext e "woff") "font/woff")
      ((call ext e "woff2") "font/woff2")
      ((call ext e "ttf") "font/ttf")
      ((call ext e "otf") "font/otf")
      ((call ext e "mp3") "audio/mpeg")
      ((call ext e "wav") "audio/wav")
      ((call ext e "ogg") "audio/ogg")
      ((call ext e "mp4") "video/mp4")
      ((call ext e "webm") "video/webm")
      (else "application/octet-stream")))

  (fn ext [e:str.Bytes s:str] -> bool (call str.eq_ignore_case e (call str.from_str s))))
