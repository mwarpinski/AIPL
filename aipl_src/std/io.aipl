;; std/io: printing and whole-file reads/writes over fs.*. fds 1 and 2 are
;; stdout and stderr in both the VM and under WASI.
(module io
  (import str)
  (import fmt)
  (import alloc)

  ;; Writes s to file descriptor fd (1 is stdout, 2 stderr).
  (fn write_str [fd:i32 s:str] -> void (pub)
    (unsafe (fs.write fd (str.ptr s) (str.len s))))

  ;; Writes s and a newline to standard output.
  (fn println [s:str] -> void (pub)
    (call write_str 1 s)
    (call write_str 1 "\n"))

  ;; Writes s and a newline to standard error.
  (fn eprintln [s:str] -> void (pub)
    (call write_str 2 s)
    (call write_str 2 "\n"))

  ;; Decimal, with '-' when negative. Its scratch bytes come from the
  ;; shared heap and go back to it, as in print_i64 and print_f64.
  (fn print_int [n:i32] -> void (pub)
    (let a:alloc.Allocator (call alloc.default))
    (unsafe (let buf:i32 (call alloc.raw a 16))
    (fs.write 1 buf (call fmt.int_to_bytes n buf))
    (call alloc.free_raw a buf 16)))

  ;; An i64 in decimal.
  (fn print_i64 [n:i64] -> void (pub)
    (let a:alloc.Allocator (call alloc.default))
    (unsafe (let buf:i32 (call alloc.raw a 24))
    (fs.write 1 buf (call fmt.int64_to_bytes n buf))
    (call alloc.free_raw a buf 24)))

  ;; label, then the i64 n, then a newline.
  (fn println_i64 [label:str n:i64] -> void (pub)
    (call write_str 1 label)
    (call print_i64 n)
    (call write_str 1 "\n"))

  ;; An f64 with `digits` decimals, as printf("%.*f") prints it.
  (fn print_f64 [x:f64 digits:i32] -> void (pub)
    (req (and (gte digits 0) (lte digits 40)))
    (let a:alloc.Allocator (call alloc.default))
    (unsafe (let buf:i32 (call alloc.raw a (+ 312 digits)))
    (fs.write 1 buf (call fmt.f64_fixed x digits buf))
    (call alloc.free_raw a buf (+ 312 digits))))

  ;; label, then x with `digits` decimals, then a newline.
  (fn println_f64 [label:str x:f64 digits:i32] -> void (pub)
    (call write_str 1 label)
    (call print_f64 x digits)
    (call write_str 1 "\n"))

  ;; label, then n, then a newline: (call io.println_int "lines: " 4) prints "lines: 4".
  (fn println_int [label:str n:i32] -> void (pub)
    (call write_str 1 label)
    (call print_int n)
    (call write_str 1 "\n"))

  ;; The whole file in a buffer that is never freed (read_fd), or len -1 if
  ;; it cannot be opened or read.
  (fn read_file [path:str] -> str.Bytes (pub)
    (call read_path (call str.from_str path)))

  ;; read_file for a path held as bytes (e.g. one built at run time).
  (fn read_path [path:str.Bytes] -> str.Bytes (pub)
    (unsafe (let fd:i32 (fs.open (call str.addr path) (get path str.Bytes.len) 0))
    (if (lt fd 0) (return (call str.bytes 0 -1)) (block))
    (let b:str.Bytes (call read_fd fd))
    (fs.close fd)
    b))

  ;; Everything on standard input, until end of input (len -1 on a read error).
  (fn read_stdin [] -> str.Bytes (pub)
    (call read_fd 0))

  ;; Reads fd to its end into a buffer from the shared heap that doubles
  ;; as it fills (each outgrown one freed); the view is checked. The last
  ;; buffer is never freed: for a program that reads as it goes for a long
  ;; time, use std/stream with an allocator of its own.
  (fn read_fd [fd:i32] -> str.Bytes (pub)
    (let a:alloc.Allocator (call alloc.default))
    (let data:(arr u8) (arr.new u8 a 4096))
    (let len:i32 0)
    (while true
      (when (eq len (arr.len data))
        (let bigger:(arr u8) (arr.new u8 a (* 2 (arr.len data))))
        (unsafe (for i 0 len (mem.store8 (+ (arr.addr bigger) i) (mem.load8 (+ (arr.addr data) i)))))
        (call (alloc.free_array u8) a data)
        (set! data bigger))
      (let n:i32 (unsafe (fs.read fd (+ (arr.addr data) len) (- (arr.len data) len))))
      (cond
        ((lt n 0) (call (alloc.free_array u8) a data) (return (call str.absent)))
        ((eq n 0) (break))
        (else (set! len (+ len n)))))
    (call str.of_array data 0 len))

  ;; Creates or truncates the file; returns bytes written, or -1.
  (fn write_file [path:str b:str.Bytes] -> i32 (pub)
    (call write_path (call str.from_str path) b))

  ;; write_file for a path held as bytes.
  (fn write_path [path:str.Bytes b:str.Bytes] -> i32 (pub)
    (unsafe (let fd:i32 (fs.open (call str.addr path) (get path str.Bytes.len) 1))
    (if (lt fd 0)
        -1
        (block
          (let n:i32 (fs.write fd (call str.addr b) (get b str.Bytes.len)))
          (fs.close fd)
          n))))

  ;; Pass count; test_suite.aipl expects 2. Uses a scratch file in the cwd.
  (fn run_io_tests [] -> i32 (pub)
    (unsafe (let p:i32 0)
    (let data:str.Bytes (call str.from_str "io\nround trip\n"))
    (let wrote:i32 (call write_file "_io_test.tmp" data))
    (let back:str.Bytes (call read_file "_io_test.tmp"))
    (fs.delete (str.ptr "_io_test.tmp") (str.len "_io_test.tmp"))
    (if (and (eq wrote 14) (call str.bytes_eq back data)) (set! p (+ p 1)) (block))
    (if (eq (get (call read_file "_io_missing.tmp") str.Bytes.len) -1) (set! p (+ p 1)) (block))
    p)))
