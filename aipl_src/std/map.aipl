;; std/map: hash map from i32 keys to values of any type (open addressing,
;; linear probing, tombstones; grows at 75% load). Generic in the value type
;; (AIPL_SPEC.md 4.H):
;;   (let m:(ptr (map.Map i32)) (call (map.make i32) 0))
;;   (call (map.set i32) m 7 70)
;;   (call (map.get_or i32) m 7 0)
(module map

  ;; state per slot: 0 empty, 1 used, 2 deleted
  (struct (Map V) [keys:(arr i32) vals:(arr V) states:(arr i32) count:i32 used:i32])

  ;; murmur3 finalizer: spreads nearby keys across the table
  (fn hash [k:i32] -> i32
    (let h:i32 (^ k (shru k 16)))
    (set! h (* h -2048144789))
    (set! h (^ h (shru h 13)))
    (set! h (* h -1028477387))
    (^ h (shru h 16)))

  (fn (alloc_slots V) [m:(ptr (Map V)) cap:i32] -> void
    (put m (Map V) keys (arr.new i32 cap))
    (put m (Map V) vals (arr.new V cap))
    (put m (Map V) states (arr.new i32 cap))
    (put m (Map V) count 0)
    (put m (Map V) used 0))

  (fn (make V) [capacity:i32] -> (ptr (Map V))
    (let cap:i32 8)
    (while (lt cap capacity) (set! cap (* cap 2)))
    (let m:(ptr (Map V)) (new (Map V)))
    (call (alloc_slots V) m cap)
    m)

  (fn (capacity V) [m:(ptr (Map V))] -> i32 (arr.len (get m (Map V) keys)))
  (fn (count V) [m:(ptr (Map V))] -> i32 (get m (Map V) count))

  ;; The slot holding k, else the first reusable slot on k's probe path.
  (fn (slot_for V) [m:(ptr (Map V)) k:i32] -> i32
    (let mask:i32 (- (call (capacity V) m) 1))
    (let i:i32 (bitand (call hash k) mask))
    (let tomb:i32 -1)
    (while true
      (let st:i32 (arr.get i32 (get m (Map V) states) i))
      (cond
        ((eq st 0) (return (if (neq tomb -1) tomb i)))
        ((eq st 1) (if (eq (arr.get i32 (get m (Map V) keys) i) k) (return i) (block)))
        ((eq tomb -1) (set! tomb i))
        (else (block)))
      (set! i (bitand (+ i 1) mask)))
    -1)

  ;; Rehashes into a table twice the size when it is mostly live entries,
  ;; else the same size (just clearing tombstones).
  (fn (grow V) [m:(ptr (Map V))] -> void
    (let old_keys:(arr i32) (get m (Map V) keys))
    (let old_vals:(arr V) (get m (Map V) vals))
    (let old_states:(arr i32) (get m (Map V) states))
    (let old_cap:i32 (arr.len old_keys))
    (call (alloc_slots V) m (if (gt (* 2 (get m (Map V) count)) old_cap) (* 2 old_cap) old_cap))
    (loop i 0 (- old_cap 1) 1
      (if (eq (arr.get i32 old_states i) 1)
          (call (set V) m (arr.get i32 old_keys i) (arr.get V old_vals i))
          (block))))

  ;; Adds k -> v, or replaces k's value.
  (fn (set V) [m:(ptr (Map V)) k:i32 v:V] -> void
    (if (gte (* 4 (+ (get m (Map V) used) 1)) (* 3 (call (capacity V) m))) (call (grow V) m) (block))
    (let i:i32 (call (slot_for V) m k))
    (let st:i32 (arr.get i32 (get m (Map V) states) i))
    (if (neq st 1)
        (block
          (if (eq st 0) (put m (Map V) used (+ (get m (Map V) used) 1)) (block))
          (arr.set i32 (get m (Map V) states) i 1)
          (arr.set i32 (get m (Map V) keys) i k)
          (put m (Map V) count (+ (get m (Map V) count) 1)))
        (block))
    (arr.set V (get m (Map V) vals) i v))

  ;; k's value, or `default` when k is absent.
  (fn (get_or V) [m:(ptr (Map V)) k:i32 default:V] -> V
    (let i:i32 (call (slot_for V) m k))
    (if (eq (arr.get i32 (get m (Map V) states) i) 1) (arr.get V (get m (Map V) vals) i) default))

  (fn (has V) [m:(ptr (Map V)) k:i32] -> bool
    (eq (arr.get i32 (get m (Map V) states) (call (slot_for V) m k)) 1))

  ;; Removes k; false if it was absent.
  (fn (remove V) [m:(ptr (Map V)) k:i32] -> bool
    (let i:i32 (call (slot_for V) m k))
    (if (neq (arr.get i32 (get m (Map V) states) i) 1) (return false) (block))
    (arr.set i32 (get m (Map V) states) i 2)
    (put m (Map V) count (- (get m (Map V) count) 1))
    true)

  ;; Iterate with (loop i 0 (- (call (map.capacity V) m) 1) 1 (if (call (map.slot_used V) m i) ...)).
  (fn (slot_used V) [m:(ptr (Map V)) i:i32] -> bool (eq (arr.get i32 (get m (Map V) states) i) 1))
  (fn (slot_key V) [m:(ptr (Map V)) i:i32] -> i32 (arr.get i32 (get m (Map V) keys) i))
  (fn (slot_val V) [m:(ptr (Map V)) i:i32] -> V (arr.get V (get m (Map V) vals) i))

  ;; Pass count; test_suite.aipl expects 4.
  (fn run_map_tests [] -> i32
    (let p:i32 0)
    (let m:(ptr (Map i32)) (call (make i32) 0))
    ;; 2000 keys including 0 and negatives, forcing several resizes
    (loop i -1000 999 1 (call (set i32) m i (* i 2)))
    (if (and (eq (call (count i32) m) 2000) (and (eq (call (get_or i32) m -1000 0) -2000) (and (eq (call (get_or i32) m 0 7) 0) (eq (call (get_or i32) m 5000 -1) -1))))
        (set! p (+ p 1))
        (block))
    (call (set i32) m 7 70)
    (if (and (eq (call (count i32) m) 2000) (eq (call (get_or i32) m 7 0) 70)) (set! p (+ p 1)) (block))
    ;; remove every even key, then check membership and the count
    (loop i -1000 999 1
      (if (eq (% i 2) 0) (call (remove i32) m i) false))
    (if (and (eq (call (count i32) m) 1000) (and (not (call (has i32) m 10)) (and (call (has i32) m 11) (not (call (remove i32) m 10)))))
        (set! p (+ p 1))
        (block))
    ;; iteration sees exactly the live entries
    (let seen:i32 0)
    (let vsum:i32 0)
    (loop i 0 (- (call (capacity i32) m) 1) 1
      (if (call (slot_used i32) m i)
          (block (set! seen (+ seen 1)) (set! vsum (+ vsum (- (call (slot_val i32) m i) (* 2 (call (slot_key i32) m i))))))
          (block)))
    (if (and (eq seen 1000) (eq vsum 56)) (set! p (+ p 1)) (block))
    p))
