;; std/map: hash map from keys of any type with a cmp.Hash implementation
;; to values of any type (open addressing, linear probing, tombstones; grows
;; at 75% load). Generic in both (AIPL_SPEC.md 4.H):
;;   (let m:(ptr (map.Map i32 str)) (call (map.make i32 str) (call alloc.default) 0))
;;   (call (map.set i32 str) m 7 "seven")
;;   (call (map.get_or i32 str) m 7 "")
;;   (call (map.add str) counts "word" 1)        ;; a count, in one lookup
;;   (match (call (map.find i32 i64) m 7)
;;     ((option.Option i64) some [v] ...) ((option.Option i64) none ...))
;; Keys hash and compare through (cmp.Hash K): i32, i64, str, and
;; str.Bytes (by contents) are implemented in std/cmp; a module
;; implements it for its own key types. A str.Bytes key is kept as the
;; pointer, so its bytes must not change while it is in the map.
(module map
  (import alloc)
  (import cmp)
  (import str)
  (import option)

  ;; state per slot: 0 empty, 1 used, 2 deleted
  (struct (Map K V) [keys:(arr K) vals:(arr V) states:(arr i32) count:i32 used:i32 allocator:alloc.Allocator] (pub)
    (where (cmp.Hash K)))

  (fn (alloc_slots K V) [m:(ptr (Map K V)) cap:i32] -> void (where (cmp.Hash K))
    (let a:alloc.Allocator (get m (Map K V) allocator))
    (put m (Map K V) keys (arr.new K a cap))
    (put m (Map K V) vals (arr.new V a cap))
    (put m (Map K V) states (arr.new i32 a cap))
    (put m (Map K V) count 0)
    (put m (Map K V) used 0))

  ;; An empty map with room for about `capacity` entries, from a.
  (fn (make K V) [a:alloc.Allocator capacity:i32] -> (ptr (Map K V)) (pub) (where (cmp.Hash K))
    (let cap:i32 8)
    (while (lt cap capacity) (set! cap (* cap 2)))
    (let m:(ptr (Map K V)) (new (Map K V) a))
    (put m (Map K V) allocator a)
    (call (alloc_slots K V) m cap)
    m)

  ;; Frees the table and the map itself; neither may be used afterwards.
  (fn (free K V) [m:(ptr (Map K V))] -> void (pub) (where (cmp.Hash K))
    (call (free_slots K V) (get m (Map K V) allocator) (get m (Map K V) keys) (get m (Map K V) vals) (get m (Map K V) states))
    (call (alloc.destroy (Map K V)) (get m (Map K V) allocator) m))

  (fn (free_slots K V) [a:alloc.Allocator keys:(arr K) vals:(arr V) states:(arr i32)] -> void
    (call (alloc.free_array K) a keys)
    (call (alloc.free_array V) a vals)
    (call (alloc.free_array i32) a states))

  ;; The number of slots (for iterating with slot_used, slot_key, slot_val).
  (fn (capacity K V) [m:(ptr (Map K V))] -> i32 (pub) (where (cmp.Hash K)) (arr.len (get m (Map K V) keys)))
  ;; The number of entries.
  (fn (count K V) [m:(ptr (Map K V))] -> i32 (pub) (where (cmp.Hash K)) (get m (Map K V) count))

  ;; The slot holding k, else the first reusable slot on k's probe path.
  (fn (slot_for K V) [m:(ptr (Map K V)) k:K] -> i32 (where (cmp.Hash K))
    (let mask:i32 (- (call (capacity K V) m) 1))
    (let i:i32 (bitand (call (cmp.Hash.hash K) k) mask))
    (let tomb:i32 -1)
    (while true
      (let st:i32 (arr.get i32 (get m (Map K V) states) i))
      (cond
        ((eq st 0) (return (if (neq tomb -1) tomb i)))
        ((eq st 1) (when (call (cmp.Hash.same K) (arr.get K (get m (Map K V) keys) i) k) (return i)))
        ((eq tomb -1) (set! tomb i))
        (else (block)))
      (set! i (bitand (+ i 1) mask)))
    -1)

  ;; Rehashes into a table twice the size when it is mostly live entries,
  ;; else the same size (just clearing tombstones).
  (fn (grow K V) [m:(ptr (Map K V))] -> void (where (cmp.Hash K))
    (let old_keys:(arr K) (get m (Map K V) keys))
    (let old_vals:(arr V) (get m (Map K V) vals))
    (let old_states:(arr i32) (get m (Map K V) states))
    (let old_cap:i32 (arr.len old_keys))
    (call (alloc_slots K V) m (if (gt (* 2 (get m (Map K V) count)) old_cap) (* 2 old_cap) old_cap))
    (for i 0 old_cap
      (when (eq (arr.get i32 old_states i) 1)
          (call (set K V) m (arr.get K old_keys i) (arr.get V old_vals i))))
    (call (free_slots K V) (get m (Map K V) allocator) old_keys old_vals old_states))

  ;; k's slot, k added with the value `fresh` if it was absent (one lookup,
  ;; for set and add).
  (fn (claim K V) [m:(ptr (Map K V)) k:K fresh:V] -> i32 (where (cmp.Hash K))
    (when (gte (* 4 (+ (get m (Map K V) used) 1)) (* 3 (call (capacity K V) m))) (call (grow K V) m))
    (let i:i32 (call (slot_for K V) m k))
    (let st:i32 (arr.get i32 (get m (Map K V) states) i))
    (when (neq st 1)
          (when (eq st 0) (put m (Map K V) used (+ (get m (Map K V) used) 1)))
          (arr.set i32 (get m (Map K V) states) i 1)
          (arr.set K (get m (Map K V) keys) i k)
          (arr.set V (get m (Map K V) vals) i fresh)
          (put m (Map K V) count (+ (get m (Map K V) count) 1)))
    i)

  ;; Adds k -> v, or replaces k's value.
  (fn (set K V) [m:(ptr (Map K V)) k:K v:V] -> void (pub) (where (cmp.Hash K))
    ;; claim first: it may grow the table, replacing vals
    (let i:i32 (call (claim K V) m k v))
    (arr.set V (get m (Map K V) vals) i v))

  ;; Adds d to k's count (0 when k is absent) and returns the new count: one
  ;; lookup, where get_or and then set take two (word counts, histograms).
  (fn (add K) [m:(ptr (Map K i32)) k:K d:i32] -> i32 (pub) (where (cmp.Hash K))
    (let i:i32 (call (claim K i32) m k 0))
    (let v:i32 (+ (arr.get i32 (get m (Map K i32) vals) i) d))
    (arr.set i32 (get m (Map K i32) vals) i v)
    v)

  ;; k's value, or `default` when k is absent.
  (fn (get_or K V) [m:(ptr (Map K V)) k:K default:V] -> V (pub) (where (cmp.Hash K))
    (let i:i32 (call (slot_for K V) m k))
    (if (eq (arr.get i32 (get m (Map K V) states) i) 1) (arr.get V (get m (Map K V) vals) i) default))

  ;; The value for k, or none. An Option is a value when V fits in one
  ;; (AIPL_SPEC.md 4.J: not a str, at most 7 scalars), so nothing is
  ;; allocated for it.
  (fn (find K V) [m:(ptr (Map K V)) k:K] -> (option.Option V) (pub) (where (cmp.Hash K))
    (let i:i32 (call (slot_for K V) m k))
    (if (eq (arr.get i32 (get m (Map K V) states) i) 1)
        (make (option.Option V) some (arr.get V (get m (Map K V) vals) i))
        (make (option.Option V) none)))

  ;; Whether k has an entry.
  (fn (has K V) [m:(ptr (Map K V)) k:K] -> bool (pub) (where (cmp.Hash K))
    (eq (arr.get i32 (get m (Map K V) states) (call (slot_for K V) m k)) 1))

  ;; Removes k; false if it was absent.
  (fn (remove K V) [m:(ptr (Map K V)) k:K] -> bool (pub) (where (cmp.Hash K))
    (let i:i32 (call (slot_for K V) m k))
    (when (neq (arr.get i32 (get m (Map K V) states) i) 1) (return false))
    (arr.set i32 (get m (Map K V) states) i 2)
    (put m (Map K V) count (- (get m (Map K V) count) 1))
    true)

  ;; Iterate with (for i 0 (call (map.capacity K V) m) (if (call (map.slot_used K V) m i) ...)).
  (fn (slot_used K V) [m:(ptr (Map K V)) i:i32] -> bool (pub) (where (cmp.Hash K)) (eq (arr.get i32 (get m (Map K V) states) i) 1))
  ;; The key in slot i (slot_used must be true for it).
  (fn (slot_key K V) [m:(ptr (Map K V)) i:i32] -> K (pub) (where (cmp.Hash K)) (arr.get K (get m (Map K V) keys) i))
  ;; The value in slot i (slot_used must be true for it).
  (fn (slot_val K V) [m:(ptr (Map K V)) i:i32] -> V (pub) (where (cmp.Hash K)) (arr.get V (get m (Map K V) vals) i))

  ;; ===== Tests =====

  ;; Pass count; test_suite.aipl expects 10.
  (fn run_map_tests [] -> i32 (pub)
    (+ (call i32_cases) (call bytes_cases)))

  ;; i32 keys
  (fn i32_cases [] -> i32
    (let p:i32 0)
    (let m:(ptr (Map i32 i32)) (call (make i32 i32) (call alloc.default) 0))
    ;; 2000 keys including 0 and negatives, forcing several resizes
    (for i -1000 1000 (call (set i32 i32) m i (* i 2)))
    (when (and (eq (call (count i32 i32) m) 2000) (and (eq (call (get_or i32 i32) m -1000 0) -2000) (and (eq (call (get_or i32 i32) m 0 7) 0) (eq (call (get_or i32 i32) m 5000 -1) -1))))
        (set! p (+ p 1)))
    (call (set i32 i32) m 7 70)
    (when (and (eq (call (count i32 i32) m) 2000) (eq (call (get_or i32 i32) m 7 0) 70)) (set! p (+ p 1)))
    ;; find: some for a key there, none for one not
    (let found:i32 (match (call (find i32 i32) m 7) ((option.Option i32) some [v] v) ((option.Option i32) none -1)))
    (let missing:bool (call (option.is_none i32) (call (find i32 i32) m 5000)))
    (when (and (eq found 70) missing) (set! p (+ p 1)))
    ;; remove every even key, then check membership and the count
    (for i -1000 1000
      (if (eq (% i 2) 0) (call (remove i32 i32) m i) false))
    (when (and (eq (call (count i32 i32) m) 1000) (and (not (call (has i32 i32) m 10)) (and (call (has i32 i32) m 11) (not (call (remove i32 i32) m 10)))))
        (set! p (+ p 1)))
    ;; iteration sees exactly the live entries
    (let seen:i32 0)
    (let vsum:i32 0)
    (for i 0 (call (capacity i32 i32) m)
      (when (call (slot_used i32 i32) m i) (set! seen (+ seen 1)) (set! vsum (+ vsum (- (call (slot_val i32 i32) m i) (* 2 (call (slot_key i32 i32) m i)))))))
    (when (and (eq seen 1000) (eq vsum 56)) (set! p (+ p 1)))
    p)

  ;; byte-string keys, by their contents
  (fn bytes_cases [] -> i32
    (unsafe (let p:i32 0)
    ;; word frequencies of a small text, splitting on spaces by hand
    (let text:str.Bytes (call str.from_str "the cat and the hat and the bat"))
    (let m:(ptr (Map str.Bytes i32)) (call (make str.Bytes i32) (call alloc.default) 0))
    (let start:i32 0)
    (for i 0 (+ (get text str.Bytes.len) 1)
      (when (or (eq i (get text str.Bytes.len)) (eq (mem.load8 (+ (call str.addr text) i)) 32))
            (let w:str.Bytes (call str.bytes (+ (call str.addr text) start) (- i start)))
            (call (set str.Bytes i32) m w (+ (call (get_or str.Bytes i32) m w 0) 1))
            (set! start (+ i 1))))
    (when (and (eq (call (count str.Bytes i32) m) 5)
             (and (eq (call (get_or str.Bytes i32) m (call str.from_str "the") 0) 3)
                  (and (eq (call (get_or str.Bytes i32) m (call str.from_str "and") 0) 2)
                       (eq (call (get_or str.Bytes i32) m (call str.from_str "dog") -1) -1))))
        (set! p (+ p 1)))
    (when (and (call (remove str.Bytes i32) m (call str.from_str "cat")) (and (not (call (has str.Bytes i32) m (call str.from_str "cat"))) (eq (call (count str.Bytes i32) m) 4)))
        (set! p (+ p 1)))
    ;; 300 distinct generated keys survive resizing
    (let big:(ptr (Map str.Bytes i32)) (call (make str.Bytes i32) (call alloc.default) 0))
    (for i 0 300
      (let k:i32 (mem.alloc 2))
      (mem.store8 k (+ 65 (/ i 26)))
      (mem.store8 (+ k 1) (+ 65 (% i 26)))
      (call (set str.Bytes i32) big (call str.bytes k 2) i))
    (let ok:bool (eq (call (count str.Bytes i32) big) 300))
    (for i 0 300
      (let k:i32 (mem.alloc 2))
      (mem.store8 k (+ 65 (/ i 26)))
      (mem.store8 (+ k 1) (+ 65 (% i 26)))
      (when (neq (call (get_or str.Bytes i32) big (call str.bytes k 2) -1) i) (set! ok false)))
    (when ok (set! p (+ p 1)))
    ;; counts in one lookup each: add returns the new count, and a key
    ;; removed and added again starts from 0, not its old count
    (let c:(ptr (Map str.Bytes i32)) (call (make str.Bytes i32) (call alloc.default) 0))
    (let the:str.Bytes (call str.from_str "the"))
    (let hat:str.Bytes (call str.from_str "hat"))
    (let firsts:i32 (+ (call (add str.Bytes) c the 1) (call (add str.Bytes) c hat 5)))
    (let again:i32 (call (add str.Bytes) c the 2))
    (let gone:bool (call (remove str.Bytes i32) c the))
    (let back:i32 (call (add str.Bytes) c the 1))
    (when (and (eq firsts 6) (and (eq again 3) (and gone (and (eq back 1) (eq (call (get_or str.Bytes i32) c hat 0) 5)))))
        (set! p (+ p 1)))
    ;; non-i32 values: a map to byte strings
    (let names:(ptr (Map str.Bytes str.Bytes)) (call (make str.Bytes str.Bytes) (call alloc.default) 0))
    (call (set str.Bytes str.Bytes) names (call str.from_str "k") (call str.from_str "value"))
    (when (eq (get (call (get_or str.Bytes str.Bytes) names (call str.from_str "k") (call str.bytes 0 -1)) str.Bytes.len) 5)
        (set! p (+ p 1)))
    p)))
