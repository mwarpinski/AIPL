;; std/map: hash map from i32 keys to i32 values (open addressing, linear
;; probing, tombstones; grows at 75% load). Store struct pointers as values
;; with ptr.addr / ptr.cast, as with std/vec.
(module map

  ;; state per slot: 0 empty, 1 used, 2 deleted
  (struct Map [keys:(arr i32) vals:(arr i32) states:(arr i32) count:i32 used:i32])

  ;; murmur3 finalizer: spreads nearby keys across the table
  (fn hash [k:i32] -> i32
    (let h:i32 (^ k (shru k 16)))
    (set! h (* h -2048144789))
    (set! h (^ h (shru h 13)))
    (set! h (* h -1028477387))
    (^ h (shru h 16)))

  (fn alloc_slots [m:(ptr Map) cap:i32] -> void
    (put m Map.keys (arr.new i32 cap))
    (put m Map.vals (arr.new i32 cap))
    (put m Map.states (arr.new i32 cap))
    (put m Map.count 0)
    (put m Map.used 0))

  ;; capacity rounds up to a power of two, at least 8
  (fn make [capacity:i32] -> (ptr Map)
    (let cap:i32 8)
    (while (lt cap capacity) (set! cap (* cap 2)))
    (let m:(ptr Map) (new Map))
    (call alloc_slots m cap)
    m)

  (fn capacity [m:(ptr Map)] -> i32 (arr.len (get m Map.keys)))
  (fn count [m:(ptr Map)] -> i32 (get m Map.count))

  ;; The slot holding k, or the slot where k would be inserted.
  (fn slot_for [m:(ptr Map) k:i32] -> i32
    (let mask:i32 (- (call capacity m) 1))
    (let i:i32 (bitand (call hash k) mask))
    (let tomb:i32 -1)
    (while true
      (let st:i32 (arr.get i32 (get m Map.states) i))
      (cond
        ((eq st 0) (return (if (neq tomb -1) tomb i)))
        ((and (eq st 1) (eq (arr.get i32 (get m Map.keys) i) k)) (return i))
        ((and (eq st 2) (eq tomb -1)) (set! tomb i))
        (else (block)))
      (set! i (bitand (+ i 1) mask)))
    -1)

  ;; Rehashes into a table twice the size (or the same size when most of the
  ;; load is tombstones).
  (fn grow [m:(ptr Map)] -> void
    (let old_keys:(arr i32) (get m Map.keys))
    (let old_vals:(arr i32) (get m Map.vals))
    (let old_states:(arr i32) (get m Map.states))
    (let old_cap:i32 (arr.len old_keys))
    (call alloc_slots m (if (gt (* 2 (get m Map.count)) old_cap) (* 2 old_cap) old_cap))
    (loop i 0 (- old_cap 1) 1
      (if (eq (arr.get i32 old_states i) 1)
          (call put m (arr.get i32 old_keys i) (arr.get i32 old_vals i))
          (block))))

  (fn put [m:(ptr Map) k:i32 v:i32] -> void
    (if (gte (* 4 (+ (get m Map.used) 1)) (* 3 (call capacity m))) (call grow m) (block))
    (let i:i32 (call slot_for m k))
    (let st:i32 (arr.get i32 (get m Map.states) i))
    (if (neq st 1)
        (block
          (if (eq st 0) (put m Map.used (+ (get m Map.used) 1)) (block))
          (arr.set i32 (get m Map.states) i 1)
          (arr.set i32 (get m Map.keys) i k)
          (put m Map.count (+ (get m Map.count) 1)))
        (block))
    (arr.set i32 (get m Map.vals) i v))

  ;; The value for k, or `default` when k is absent.
  (fn get [m:(ptr Map) k:i32 default:i32] -> i32
    (let i:i32 (call slot_for m k))
    (if (eq (arr.get i32 (get m Map.states) i) 1) (arr.get i32 (get m Map.vals) i) default))

  (fn has [m:(ptr Map) k:i32] -> bool
    (eq (arr.get i32 (get m Map.states) (call slot_for m k)) 1))

  ;; True if k was present.
  (fn remove [m:(ptr Map) k:i32] -> bool
    (let i:i32 (call slot_for m k))
    (if (neq (arr.get i32 (get m Map.states) i) 1) (return false) (block))
    (arr.set i32 (get m Map.states) i 2)
    (put m Map.count (- (get m Map.count) 1))
    true)

  ;; Iteration over slots 0 .. capacity-1:
  ;;   (loop i 0 (- (call map.capacity m) 1) 1
  ;;     (if (call map.slot_used m i) ... (call map.slot_key m i) (call map.slot_val m i) ...))
  (fn slot_used [m:(ptr Map) i:i32] -> bool (eq (arr.get i32 (get m Map.states) i) 1))
  (fn slot_key [m:(ptr Map) i:i32] -> i32 (arr.get i32 (get m Map.keys) i))
  (fn slot_val [m:(ptr Map) i:i32] -> i32 (arr.get i32 (get m Map.vals) i))

  ;; Pass count; test_suite.aipl expects 4.
  (fn run_map_tests [] -> i32
    (let p:i32 0)
    (let m:(ptr Map) (call make 0))
    ;; 2000 keys including 0 and negatives, forcing several resizes
    (loop i -1000 999 1 (call put m i (* i 2)))
    (if (and (eq (call count m) 2000) (and (eq (call get m -1000 0) -2000) (and (eq (call get m 0 7) 0) (eq (call get m 5000 -1) -1))))
        (set! p (+ p 1))
        (block))
    (call put m 7 70)
    (if (and (eq (call count m) 2000) (eq (call get m 7 0) 70)) (set! p (+ p 1)) (block))
    ;; remove every even key, then check membership and the count
    (loop i -1000 999 1
      (if (eq (% i 2) 0) (call remove m i) false))
    (if (and (eq (call count m) 1000) (and (not (call has m 10)) (and (call has m 11) (not (call remove m 10)))))
        (set! p (+ p 1))
        (block))
    ;; iteration sees exactly the live entries
    (let seen:i32 0)
    (let vsum:i32 0)
    (loop i 0 (- (call capacity m) 1) 1
      (if (call slot_used m i)
          (block (set! seen (+ seen 1)) (set! vsum (+ vsum (- (call slot_val m i) (* 2 (call slot_key m i))))))
          (block)))
    (if (and (eq seen 1000) (eq vsum 56)) (set! p (+ p 1)) (block))
    p))
