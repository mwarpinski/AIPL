    (let y1:f64 (if (eq ih 0) fw (call neg fw)))
    (call (alloc.free_array i32) al ipio2)
    (call (alloc.free_array f64) al pio2)
    (call (alloc.free_array f64) al f)
    (call (alloc.free_array f64) al fq)
    (call (alloc.free_array f64) al q)
    (call (alloc.free_array i32) al iq)
