        (* (+ (- x e) (- 1.0 uf)) twopk)
        (* (+ (- x (+ e uf)) 1.0) twopk)))

  (const S1:f64 -0.16666666666666632)
  (const S2:f64 0.00833333333332249)
  (const S3:f64 -0.0001984126982985795)
  (const S4:f64 2.7557313707070068e-6)
  (const S5:f64 -2.5050760253406863e-8)
  (const S6:f64 1.58969099521155e-10)
  (const C1:f64 0.0416666666666666)
  (const C2:f64 -0.001388888888887411)
  (const C3:f64 2.480158728947673e-5)
  (const C4:f64 -2.7557314351390663e-7)
  (const C5:f64 2.087572321298175e-9)
  (const C6:f64 -1.1359647557788195e-11)
  (const INV_PIO2:f64 0.6366197723675814)
  (const PIO2_1:f64 1.5707963267341256)
  (const PIO2_1T:f64 6.077100506506192e-11)
  (const PIO2_2:f64 6.077100506303966e-11)
  (const PIO2_2T:f64 2.0222662487959506e-21)
  (const PIO2_3:f64 2.0222662487111665e-21)
  (const PIO2_3T:f64 8.4784276603689e-32)
  (const PIO4:f64 0.7853981633974483)
  (const PIO4_LO:f64 3.061616997868383e-17)
  (const TO_INT:f64 6755399441055744.0)

  ;; sin of x + y, for |x| <= pi/4 (FreeBSD k_sin.c): a degree-13 polynomial, y the tail of the reduced argument
  ;; (iy 0 when there is none).
  (fn k_sin [x:f64 y:f64 iy:i32] -> f64
    (let z:f64 (* x x))
    (let w:f64 (* z z))
    (let r:f64 (+ (+ S2 (* z (+ S3 (* z S4)))) (* (* z w) (+ S5 (* z S6)))))
    (let v:f64 (* z x))
    (if (eq iy 0)
        (+ x (* v (+ S1 (* z r))))
        (- x (- (- (* z (- (* 0.5 y) (* v r))) y) (* v S1)))))

  ;; cos of x + y, for |x| <= pi/4 (FreeBSD k_cos.c): a degree-14 polynomial.
  (fn k_cos [x:f64 y:f64] -> f64
    (let z:f64 (* x x))
    (let w:f64 (* z z))
    (let r:f64 (+ (* z (+ C1 (* z (+ C2 (* z C3))))) (* (* w w) (+ C4 (* z (+ C5 (* z C6)))))))
    (let hz:f64 (* 0.5 z))
    (let v:f64 (- 1.0 hz))
    (+ v (+ (- (- 1.0 v) hz) (- (* z r) (* x y)))))

  ;; tan of x + y (cot, negated, when odd is 1) for |x| <= pi/4 (FreeBSD k_tan.c): a degree-27 polynomial,
  ;; and for |x| >= 0.6744 the identity tan(pi/4 - x).
  (fn k_tan [x0:f64 y0:f64 odd:i32] -> f64
    (let x:f64 x0)
    (let y:f64 y0)
    (let hx:i32 (call hi_word x))
    (let big:bool (gte (bitand hx 2147483647) 1072010280))
    (when big
      (when (lt hx 0)
        (set! x (call neg x))
        (set! y (call neg y)))
      (set! x (+ (- PIO4 x) (- PIO4_LO y)))
      (set! y 0.0))
    (let z:f64 (* x x))
    (let w:f64 (* z z))
    (let r1:f64 (+ 0.13333333333320124 (* w (+ 0.021869488294859542 (* w (+ 0.0035920791075913124 (* w (+ 0.0005880412408202641 (* w (+ 7.817944429395571e-5 (* w -1.8558637485527546e-5)))))))))))
    (let v:f64 (* z (+ 0.05396825397622605 (* w (+ 0.0088632398235993 (* w (+ 0.0014562094543252903 (* w (+ 0.0002464631348184699 (* w (+ 7.140724913826082e-5 (* w 2.590730518636337e-5))))))))))))
    (let s:f64 (* z x))
    (let r:f64 (+ (+ y (* z (+ (* s (+ r1 v)) y))) (* s 0.3333333333333341)))
    (let w2:f64 (+ x r))
    (when big
      (let sg:f64 (- 1.0 (* 2.0 (f64.convert_i32_s odd))))
      (let v2:f64 (- sg (* 2.0 (+ x (- r (/ (* w2 w2) (+ w2 sg)))))))
      (return (if (lt hx 0) (call neg v2) v2)))
    (when (eq odd 0) (return w2))
    ;; -1 / (x + r), with its low word cleared for the correction
    (let w0:f64 (call clear_lo w2))
    (let v3:f64 (- r (- w0 x)))
    (let a:f64 (/ -1.0 w2))
    (let a0:f64 (call clear_lo a))
    (+ a0 (* a (+ (+ 1.0 (* a0 w0)) (* a0 v3)))))

  ;; n, y0, y1 of an argument reduction: x = n * pi/2 + y0 + y1 (with |y0 + y1| <= pi/4, y1 the tail).
  (struct Rem [n:i32 y0:f64 y1:f64] (value))

  ;; x - k * pi/2 for k from 1 to 4, in two parts, for x near k * pi/2 (the sign of x says which way).
  (fn rem_multiple [x:f64 k:i32 sign:i32] -> Rem
    (let kf:f64 (f64.convert_i32_s k))
    (if (eq sign 0)
        (block
          (let z:f64 (- x (* kf PIO2_1)))
          (let y0:f64 (- z (* kf PIO2_1T)))
          (make Rem [n:k y0:y0 y1:(- (- z y0) (* kf PIO2_1T))]))
        (block
          (let z:f64 (+ x (* kf PIO2_1)))
          (let y0:f64 (+ z (* kf PIO2_1T)))
          (make Rem [n:(- 0 k) y0:y0 y1:(+ (- z y0) (* kf PIO2_1T))]))))

  ;; The reduction for |x| below 2^20 pi/2 (the "medium" case): n = round(x * 2/pi), then x - n pi/2 in up
  ;; to three steps of 33 bits each, as many as the cancellation needs.
  (fn rem_medium [x:f64 ix:i32] -> Rem
    (let tmp:f64 (+ (* x INV_PIO2) TO_INT))
    (let f_n:f64 (- tmp TO_INT))
    (let n:i32 (i32.trunc_f64_s f_n))
    (let r:f64 (- x (* f_n PIO2_1)))
    (let w:f64 (* f_n PIO2_1T))
    (let y0:f64 (- r w))
    (let ey:i32 (bitand (shru (call hi_word y0) 20) 2047))
    (let ex:i32 (shru ix 20))
    (when (gt (- ex ey) 16)
      (let t:f64 r)
      (set! w (* f_n PIO2_2))
      (set! r (- t w))
      (set! w (- (* f_n PIO2_2T) (- (- t r) w)))
      (set! y0 (- r w))
      (let ey2:i32 (bitand (shru (call hi_word y0) 20) 2047))
      (when (gt (- ex ey2) 49)
        (let t2:f64 r)
        (set! w (* f_n PIO2_3))
        (set! r (- t2 w))
        (set! w (- (* f_n PIO2_3T) (- (- t2 r) w)))
        (set! y0 (- r w))))
    (make Rem [n:n y0:y0 y1:(- (- r y0) w)]))

  ;; The reduction of a huge argument (FreeBSD k_rem_pio2.c, double precision): the argument as three 24-bit
  ;; pieces tx[0..nx), the exponent e0 of the first, multiplied by 2/pi kept to 396 hex digits.
  (fn rem_large [tx:(arr f64) nx:i32 e0:i32] -> Rem
    (let al:alloc.Allocator (call alloc.default))
    (let ipio2:(arr i32) (arr.of i32 al
                                 10680707 7228996 1387004 2578385 16069853 12639074 9804092 4427841 16666979 11263675 12935607
                                 2387514 4345298 14681673 3074569 13734428 16653803 1880361 10960616 8533493 3062596 8710556
                                 7349940 6258241 3772886 3769171 3798172 8675211 12450088 3874808 9961438 366607 15675153
                                 9132554 7151469 3571407 2607881 12013382 4155038 6285869 7677882 13102053 15825725 473591
                                 9065106 15363067 6271263 9264392 5636912 4652155 7056368 13614112 10155062 1944035 9527646
                                 15080200 6658437 6231200 6832269 16767104 5075751 3212806 1398474 7579849 6349435 12618859))
    (let pio2:(arr f64) (arr.of f64 al 1.570796251296997 7.549789415861596e-8 5.390302529957765e-15 3.282003415807913e-22 1.270655753080676e-29 1.2293330898111133e-36 2.7337005381646456e-44 2.1674168387780482e-51))
    (let f:(arr f64) (arr.new f64 al 20))
    (let fq:(arr f64) (arr.new f64 al 20))
    (let q:(arr f64) (arr.new f64 al 20))
    (let iq:(arr i32) (arr.new i32 al 20))
    (for i 0 20
      (arr.set f64 f i 0.0)
      (arr.set f64 fq i 0.0)
      (arr.set f64 q i 0.0)
      (arr.set i32 iq i 0))
    (let jk:i32 4)
    (let jx:i32 (- nx 1))
    (let jv:i32 (/ (- e0 3) 24))
    (when (lt jv 0) (set! jv 0))
    (let q0:i32 (- e0 (* 24 (+ jv 1))))
    (let j:i32 (- jv jx))
    (for i 0 (+ (+ jx jk) 1)
      (arr.set f64 f i (if (lt j 0) 0.0 (f64.convert_i32_s (arr.get i32 ipio2 j))))
      (set! j (+ j 1)))
    (let fw:f64 0.0)
    (for i 0 (+ jk 1)
      (set! fw 0.0)
      (for jj 0 (+ jx 1)
        (set! fw (+ fw (* (arr.get f64 tx jj) (arr.get f64 f (- (+ jx i) jj))))))
      (arr.set f64 q i fw))
    (let jz:i32 jk)
    (let z:f64 0.0)
    (let n:i32 0)
    (let ih:i32 0)
    (let again:bool true)
    (while again
      (set! again false)
      (let i:i32 0)
      (set! z (arr.get f64 q jz))
      (let jj:i32 jz)
      (while (gte jj 1)
        (set! fw (f64.convert_i32_s (i32.trunc_f64_s (* 5.960464477539063e-8 z))))
        (arr.set i32 iq i (i32.trunc_f64_s (- z (* 16777216.0 fw))))
        (set! z (+ (arr.get f64 q (- jj 1)) fw))
        (set! i (+ i 1))
        (set! jj (- jj 1)))
      (set! z (call scalbn z q0))
      (set! z (- z (* 8.0 (call floor (* z 0.125)))))
      (set! n (i32.trunc_f64_s z))
      (set! z (- z (f64.convert_i32_s n)))
      (set! ih 0)
      (cond
        ((gt q0 0)
         (set! i (shr (arr.get i32 iq (- jz 1)) (- 24 q0)))
         (set! n (+ n i))
         (arr.set i32 iq (- jz 1) (- (arr.get i32 iq (- jz 1)) (shl i (- 24 q0))))
         (set! ih (shr (arr.get i32 iq (- jz 1)) (- 23 q0))))
        ((eq q0 0) (set! ih (shr (arr.get i32 iq (- jz 1)) 23)))
        ((gte z 0.5) (set! ih 2))
        (else (block)))
      (when (gt ih 0)
        (set! n (+ n 1))
        (let carry:i32 0)
        (for ci 0 jz
          (let cj:i32 (arr.get i32 iq ci))
          (if (eq carry 0)
              (when (neq cj 0)
                (set! carry 1)
                (arr.set i32 iq ci (- 16777216 cj)))
              (arr.set i32 iq ci (- 16777215 cj))))
        (when (gt q0 0)
          (cond
            ((eq q0 1) (arr.set i32 iq (- jz 1) (bitand (arr.get i32 iq (- jz 1)) 8388607)))
            ((eq q0 2) (arr.set i32 iq (- jz 1) (bitand (arr.get i32 iq (- jz 1)) 4194303)))
            (else (block))))
        (when (eq ih 2)
          (set! z (- 1.0 z))
          (when (neq carry 0) (set! z (- z (call scalbn 1.0 q0))))))
      (when (eq z 0.0)
        (let bits:i32 0)
        (let ii:i32 (- jz 1))
        (while (gte ii jk)
          (set! bits (bitor bits (arr.get i32 iq ii)))
          (set! ii (- ii 1)))
        (when (eq bits 0)
          (let k:i32 1)
          (while (eq (arr.get i32 iq (- jk k)) 0) (set! k (+ k 1)))
          (for ki (+ jz 1) (+ (+ jz k) 1)
            (arr.set f64 f (+ jx ki) (f64.convert_i32_s (arr.get i32 ipio2 (+ jv ki))))
            (set! fw 0.0)
            (for jj2 0 (+ jx 1)
              (set! fw (+ fw (* (arr.get f64 tx jj2) (arr.get f64 f (- (+ jx ki) jj2))))))
            (arr.set f64 q ki fw))
          (set! jz (+ jz k))
          (set! again true))))
    (if (eq z 0.0)
        (block
          (set! jz (- jz 1))
          (set! q0 (- q0 24))
          (while (eq (arr.get i32 iq jz) 0)
            (set! jz (- jz 1))
            (set! q0 (- q0 24))))
        (block
          (set! z (call scalbn z (- 0 q0)))
          (if (gte z 16777216.0)
              (block
                (set! fw (f64.convert_i32_s (i32.trunc_f64_s (* 5.960464477539063e-8 z))))
                (arr.set i32 iq jz (i32.trunc_f64_s (- z (* 16777216.0 fw))))
                (set! jz (+ jz 1))
                (set! q0 (+ q0 24))
                (arr.set i32 iq jz (i32.trunc_f64_s fw)))
              (arr.set i32 iq jz (i32.trunc_f64_s z)))))
    (set! fw (call scalbn 1.0 q0))
    (let qi:i32 jz)
    (while (gte qi 0)
      (arr.set f64 q qi (* fw (f64.convert_i32_s (arr.get i32 iq qi))))
      (set! fw (* fw 5.960464477539063e-8))
      (set! qi (- qi 1)))
    (let fi:i32 jz)
    (while (gte fi 0)
      (set! fw 0.0)
      (let kk:i32 0)
      (while (and (lte kk jk) (lte kk (- jz fi)))
        (set! fw (+ fw (* (arr.get f64 pio2 kk) (arr.get f64 q (+ fi kk)))))
        (set! kk (+ kk 1)))
      (arr.set f64 fq (- jz fi) fw)
      (set! fi (- fi 1)))
