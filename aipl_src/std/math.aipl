  ;; x = n * pi/2 + y0 + y1 for any finite x (FreeBSD e_rem_pio2.c): a few multiples of pi/2 by subtraction
  ;; for |x| < 5 pi, Cody-Waite steps up to 2^20 pi/2, and rem_large beyond. n is only right modulo 8.
  (fn rem_pio2 [x:f64] -> Rem
    (let sign:i32 (shru (call hi_word x) 31))
    (let ix:i32 (bitand (call hi_word x) 2147483647))
    (when (lte ix 1074752122)
      (when (eq (bitand ix 1048575) 598523) (return (call rem_medium x ix)))
      (return (call rem_multiple x (if (lte ix 1073928572) 1 2) sign)))
    (when (lte ix 1075594811)
      (if (lte ix 1075183036)
          (block
            (when (eq ix 1074977148) (return (call rem_medium x ix)))
            (return (call rem_multiple x 3 sign)))
          (block
            (when (eq ix 1075388923) (return (call rem_medium x ix)))
            (return (call rem_multiple x 4 sign)))))
    (when (lt ix 1094263291) (return (call rem_medium x ix)))
    (when (gte ix 2146435072)
      (let y:f64 (- x x))
      (return (make Rem [n:0 y0:y y1:y])))
    ;; x as 2^23 * (1 + f) in three 24-bit pieces
    (let bits:i64 (i64.reinterpret_f64 x))
    (let z0:f64 (f64.reinterpret_i64 (bitor (bitand bits 4503599627370495i64) (shl 1046i64 52i64))))
    (let a:alloc.Allocator (call alloc.default))
    (let tx:(arr f64) (arr.new f64 a 3))
    (let z:f64 z0)
    (for i 0 2
      (arr.set f64 tx i (f64.convert_i32_s (i32.trunc_f64_s z)))
      (set! z (* (- z (arr.get f64 tx i)) 16777216.0)))
    (arr.set f64 tx 2 z)
    (let nx:i32 3)
    (while (and (gt nx 1) (eq (arr.get f64 tx (- nx 1)) 0.0))
      (set! nx (- nx 1)))
    (let r:Rem (call rem_large tx nx (- (shr ix 20) 1046)))
    (call (alloc.free_array f64) a tx)
    (if (neq sign 0)
        (make Rem [n:(- 0 (get r Rem.n)) y0:(call neg (get r Rem.y0)) y1:(call neg (get r Rem.y1))])
        r))

  ;; The sine (FreeBSD s_sin.c).
  (fn sin [x:f64] -> f64 (pub)
    (let ix:i32 (bitand (call hi_word x) 2147483647))
    (when (lte ix 1072243195)
      (when (lt ix 1045430272) (return x))
      (return (call k_sin x 0.0 0)))
    (when (gte ix 2146435072) (return (- x x)))
    (let r:Rem (call rem_pio2 x))
    (let m:i32 (bitand (get r Rem.n) 3))
    (cond
      ((eq m 0) (call k_sin (get r Rem.y0) (get r Rem.y1) 1))
      ((eq m 1) (call k_cos (get r Rem.y0) (get r Rem.y1)))
      ((eq m 2) (call neg (call k_sin (get r Rem.y0) (get r Rem.y1) 1)))
      (else (call neg (call k_cos (get r Rem.y0) (get r Rem.y1))))))

  ;; The cosine (FreeBSD s_cos.c).
  (fn cos [x:f64] -> f64 (pub)
    (let ix:i32 (bitand (call hi_word x) 2147483647))
    (when (lte ix 1072243195)
      (when (and (lt ix 1044816030) (eq (i32.trunc_f64_s x) 0)) (return 1.0))
      (return (call k_cos x 0.0)))
    (when (gte ix 2146435072) (return (- x x)))
    (let r:Rem (call rem_pio2 x))
    (let m:i32 (bitand (get r Rem.n) 3))
    (cond
      ((eq m 0) (call k_cos (get r Rem.y0) (get r Rem.y1)))
      ((eq m 1) (call neg (call k_sin (get r Rem.y0) (get r Rem.y1) 1)))
      ((eq m 2) (call neg (call k_cos (get r Rem.y0) (get r Rem.y1))))
      (else (call k_sin (get r Rem.y0) (get r Rem.y1) 1))))

  ;; The tangent (FreeBSD s_tan.c).
  (fn tan [x:f64] -> f64 (pub)
    (let ix:i32 (bitand (call hi_word x) 2147483647))
    (when (lte ix 1072243195)
      (when (lt ix 1044381696) (return x))
      (return (call k_tan x 0.0 0)))
    (when (gte ix 2146435072) (return (- x x)))
    (let r:Rem (call rem_pio2 x))
    (call k_tan (get r Rem.y0) (get r Rem.y1) (bitand (get r Rem.n) 1)))

