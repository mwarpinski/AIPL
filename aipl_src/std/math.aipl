;; std/math: the small arithmetic a program reaches for and the language does
;; not spell: min, max, abs, clamp, the floor-rounding division and remainder
;; of Python's // and %, gcd, integer powers and square roots, floor, ceil,
;; trunc, and round for f64, and the transcendental functions (exp, ln,
;; pow_f64, sin, cos, atan2, and the rest: ports of fdlibm). Integers: i32 as the plain names, i64 with an
;; _i64 suffix; f64 with _f64 where the name would clash.
;;
;;   (call math.max 3 7)                 ;; 7
;;   (call math.floor_div -7 2)          ;; -4 (the operator / gives -3)
;;   (call math.floor_mod -7 2)          ;; 1 (the operator % gives -1)
;;   (call math.gcd 12 18)               ;; 6
;;   (call math.isqrt 99)                ;; 9
;;   (call math.floor 2.7)               ;; 2.0
;;   (call math.ln 10.0)                 ;; 2.302585092994046
;;   (call math.pow_f64 2.0 0.5)         ;; 1.4142135623730951
;;
;; Where a result cannot be represented the program stops, as the rest of the
;; language does: abs of the smallest integer, pow past the range, a division
;; by zero (the f64 functions return NaN or an infinity, as C does). Not here:
;; gcd or pow on big numbers (std/bigint).
(module math
  (import alloc)
  ;; The ratio of a circle's circumference to its diameter, as an f64.
  (const PI:f64 3.141592653589793 (pub))

  ;; A full turn in radians, 2 * PI.
  (const TAU:f64 6.283185307179586 (pub))

  ;; ===== i32 =====

  ;; The smaller of two numbers.
  (fn min [a:i32 b:i32] -> i32 (pub) (if (lt a b) a b))

  ;; The larger of two numbers.
  (fn max [a:i32 b:i32] -> i32 (pub) (if (gt a b) a b))

  ;; x without its sign. The smallest i32 has no positive twin, so it stops
  ;; the program.
  (fn abs [x:i32] -> i32 (pub)
    (req (neq x -2147483648))
    (if (lt x 0) (- 0 x) x))

  ;; -1, 0, or 1: the sign of x.
  (fn sign [x:i32] -> i32 (pub) (cond ((lt x 0) -1) ((gt x 0) 1) (else 0)))

  ;; x, held between lo and hi.
  (fn clamp [x:i32 lo:i32 hi:i32] -> i32 (pub)
    (req (lte lo hi))
    (if (lt x lo) lo (if (gt x hi) hi x)))

  ;; a divided by b, rounded toward negative infinity, as Python's a // b:
  ;; (floor_div -7 2) is -4, where (/ -7 2) is -3.
  (fn floor_div [a:i32 b:i32] -> i32 (pub)
    (req (neq b 0))
    (let q:i32 (/ a b))
    (if (and (neq (% a b) 0) (neq (lt a 0) (lt b 0))) (- q 1) q))

  ;; What is left of a after floor_div: the sign of b (or 0), as Python's
  ;; a % b: (floor_mod -7 2) is 1, where (% -7 2) is -1.
  (fn floor_mod [a:i32 b:i32] -> i32 (pub)
    (req (neq b 0))
    (let r:i32 (% a b))
    (if (and (neq r 0) (neq (lt r 0) (lt b 0))) (+ r b) r))

  ;; The greatest common divisor, never negative; (gcd 0 0) is 0.
  (fn gcd [a:i32 b:i32] -> i32 (pub)
    (let x:i32 (call abs a))
    (let y:i32 (call abs b))
    (while (neq y 0)
      (let t:i32 (% x y))
      (set! x y)
      (set! y t))
    x)

  ;; x to the power n, n not negative: (pow 3 4) is 81, (pow x 0) is 1.
  ;; Stops the program when the answer does not fit.
  (fn pow [x:i32 n:i32] -> i32 (pub)
    (req (gte n 0))
    (let result:i32 1)
    (let base:i32 x)
    (let k:i32 n)
    (while (gt k 0)
      (when (neq (bitand k 1) 0) (set! result (checked.mul result base)))
      (set! k (shru k 1))
      (when (gt k 0) (set! base (checked.mul base base))))
    result)

  ;; The whole part of the square root of x, x not negative: the largest r
  ;; with r * r <= x, so (isqrt 99) is 9 and (isqrt 100) is 10.
  (fn isqrt [x:i32] -> i32 (pub)
    (req (gte x 0))
    (let r:i32 (i32.trunc_f64_s (f64.sqrt (f64.convert_i32_s x))))
    (while (gt (* r r) x) (set! r (- r 1)))
    r)

  ;; ===== i64 =====

  ;; The smaller of two numbers.
  (fn min_i64 [a:i64 b:i64] -> i64 (pub) (if (lt a b) a b))

  ;; The larger of two numbers.
  (fn max_i64 [a:i64 b:i64] -> i64 (pub) (if (gt a b) a b))

  ;; x without its sign; the smallest i64 stops the program.
  (fn abs_i64 [x:i64] -> i64 (pub)
    (req (neq x -9223372036854775808i64))
    (if (lt x 0i64) (- 0i64 x) x))

  ;; x, held between lo and hi.
  (fn clamp_i64 [x:i64 lo:i64 hi:i64] -> i64 (pub)
    (req (lte lo hi))
    (if (lt x lo) lo (if (gt x hi) hi x)))

  ;; a // b as Python writes it, for i64.
  (fn floor_div_i64 [a:i64 b:i64] -> i64 (pub)
    (req (neq b 0i64))
    (let q:i64 (/ a b))
    (if (and (neq (% a b) 0i64) (neq (lt a 0i64) (lt b 0i64))) (- q 1i64) q))

  ;; a % b as Python writes it, for i64.
  (fn floor_mod_i64 [a:i64 b:i64] -> i64 (pub)
    (req (neq b 0i64))
    (let r:i64 (% a b))
    (if (and (neq r 0i64) (neq (lt r 0i64) (lt b 0i64))) (+ r b) r))

  ;; The greatest common divisor, never negative.
  (fn gcd_i64 [a:i64 b:i64] -> i64 (pub)
    (let x:i64 (call abs_i64 a))
    (let y:i64 (call abs_i64 b))
    (while (neq y 0i64)
      (let t:i64 (% x y))
      (set! x y)
      (set! y t))
    x)

  ;; x to the power n, n not negative; stops the program when the answer
  ;; does not fit.
  (fn pow_i64 [x:i64 n:i32] -> i64 (pub)
    (req (gte n 0))
    (let result:i64 1i64)
    (let base:i64 x)
    (let k:i32 n)
    (while (gt k 0)
      (when (neq (bitand k 1) 0) (set! result (checked.mul result base)))
      (set! k (shru k 1))
      (when (gt k 0) (set! base (checked.mul base base))))
    result)

  ;; The whole part of the square root of x, x not negative.
  (fn isqrt_i64 [x:i64] -> i64 (pub)
    (req (gte x 0i64))
    ;; 3037000499 is the largest r whose square fits in an i64
    (let r:i64 (i64.trunc_f64_s (f64.sqrt (f64.convert_i64_s x))))
    (when (gt r 3037000499i64) (set! r 3037000499i64))
    (while (gt (* r r) x) (set! r (- r 1i64)))
    (while (and (lt r 3037000499i64) (lte (* (+ r 1i64) (+ r 1i64)) x)) (set! r (+ r 1i64)))
    r)

  ;; ===== f64 =====

  ;; Whether x is not a number.
  (fn is_nan [x:f64] -> bool (pub) (neq x x))

  ;; The smaller of two numbers; not a number when either is.
  (fn min_f64 [a:f64 b:f64] -> f64 (pub)
    (cond ((neq a a) a) ((neq b b) b) ((lt a b) a) (else b)))

  ;; The larger of two numbers; not a number when either is.
  (fn max_f64 [a:f64 b:f64] -> f64 (pub)
    (cond ((neq a a) a) ((neq b b) b) ((gt a b) a) (else b)))

  ;; x without its sign (including a negative zero's).
  (fn abs_f64 [x:f64] -> f64 (pub)
    (f64.reinterpret_i64 (bitand (i64.reinterpret_f64 x) 9223372036854775807i64)))

  ;; Whether x has no fraction to drop: 2^52 and beyond, where every double is
  ;; a whole number, or not a number at all (which stays as it is).
  (fn whole [x:f64] -> bool
    (or (neq x x) (gte x 4503599627370496.0) (lte x -4503599627370496.0)))

  ;; x with its fraction dropped (rounded toward zero): (trunc -2.7) is -2.0.
  ;; A zero result has no sign.
  (fn trunc [x:f64] -> f64 (pub)
    (if (call whole x) x (f64.convert_i64_s (i64.trunc_f64_s x))))

  ;; The largest whole number not above x: (floor 2.7) is 2.0, (floor -2.7)
  ;; is -3.0.
  (fn floor [x:f64] -> f64 (pub)
    (let t:f64 (call trunc x))
    (if (and (not (call whole x)) (gt t x)) (- t 1.0) t))

  ;; The smallest whole number not below x: (ceil 2.1) is 3.0, (ceil -2.1) is
  ;; -2.0.
  (fn ceil [x:f64] -> f64 (pub)
    (let t:f64 (call trunc x))
    (if (and (not (call whole x)) (lt t x)) (+ t 1.0) t))

  ;; x to the nearest whole number, halves away from zero as C's round:
  ;; (round 2.5) is 3.0, (round -2.5) is -3.0, (round 0.4999999999999999) is 0.0.
  (fn round [x:f64] -> f64 (pub)
    (let t:f64 (call trunc x))
    (let d:f64 (- x t))
    (cond
      ((call whole x) x)
      ((gte d 0.5) (+ t 1.0))
      ((lte d -0.5) (- t 1.0))
      (else t)))

  ;; x to the power n, n a whole number, by repeated multiplication (a negative
  ;; n divides): exact where every step is, otherwise within a few units of
  ;; the last place, not always libm's last bit.
  (fn powi [x:f64 n:i32] -> f64 (pub)
    (req (neq n -2147483648))
    (let result:f64 1.0)
    (let base:f64 x)
    (let k:i32 (call abs n))
    (while (gt k 0)
      (when (neq (bitand k 1) 0) (set! result (* result base)))
      (set! k (shru k 1))
      (when (gt k 0) (set! base (* base base))))
    (if (lt n 0) (/ 1.0 result) result))

  ;; ===== Transcendental functions: ports of fdlibm =====
  ;;
  ;; exp, expm1, ln, log10, log2, log1p, pow_f64, sin, cos, tan, asin, acos, atan, atan2, sinh, cosh,
  ;; tanh, hypot, and cbrt are written in AIPL, from FreeBSD's msun (the fdlibm that musl and the Rust
  ;; `libm` crate carry), with only IEEE arithmetic, `f64.sqrt`, and bit operations: every backend, the
  ;; interpreter included, gives the same bits. referee/tests/test_math_float.rs checks each against the `libm`
  ;; crate bit for bit on generated inputs. glibc, which Python's `math` calls, uses other algorithms
  ;; and differs from fdlibm in the last place for some arguments; both are within 1 ulp of the true
  ;; value (fdlibm's functions are under 1 ulp, tanh a little over, and cbrt, FreeBSD's, is under 0.667
  ;; ulp: not the correctly rounded cube root newer libraries give). As in C, a result that does not exist is NaN or an
  ;; infinity, not a stop (ln of 0 is -inf, ln of a negative number is NaN); a NaN's sign and payload are
  ;; whatever the machine's arithmetic makes (WebAssembly leaves them open).

  ;; The high 32 bits of x's representation, as an i32 (the sign in bit 31).
  (fn hi_word [x:f64] -> i32 (shr (i32.wrap (shru (i64.reinterpret_f64 x) 32i64)) 0))

  ;; The low 32 bits.
  (fn lo_word [x:f64] -> i32 (i32.wrap (i64.reinterpret_f64 x)))

  ;; The f64 with these high and low words.
  (fn from_words [hi:i32 lo:i32] -> f64
    (f64.reinterpret_i64 (bitor (shl (i64.extend_u hi) 32i64) (i64.extend_u lo))))

  ;; x with its low word replaced by zero.
  (fn clear_lo [x:f64] -> f64
    (f64.reinterpret_i64 (bitand (i64.reinterpret_f64 x) -4294967296i64)))

  ;; x times 2 to the n (exactly, if the result is a normal number; one rounding, if it is subnormal), as C's
  ;; scalbn.
  (fn scalbn [x:f64 n0:i32] -> f64 (pub)
    (let y:f64 x)
    (let n:i32 n0)
    (if (gt n 1023)
        (block
          (set! y (* y 8.98846567431158e307))
          (set! n (- n 1023))
          (when (gt n 1023)
            (set! y (* y 8.98846567431158e307))
            (set! n (- n 1023))
            (when (gt n 1023) (set! n 1023))))
        (when (lt n -1022)
          ;; the final n must be below -53, so that a subnormal result is rounded once
          (set! y (* y 2.004168360008973e-292))
          (set! n (+ n 969))
          (when (lt n -1022)
            (set! y (* y 2.004168360008973e-292))
            (set! n (+ n 969))
            (when (lt n -1022) (set! n -1022)))))
    (* y (f64.reinterpret_i64 (shl (i64.extend_s (+ 1023 n)) 52i64))))

  ;; e to the x (FreeBSD e_exp.c): x = k ln 2 + r, |r| <= ln 2 / 2, exp(r) from a degree-5 polynomial in r*r,
  ;; scaled by 2^k. Under 1 ulp. exp(+inf) is +inf, exp(-inf) is 0, exp(NaN) is NaN.
  (fn exp [x0:f64] -> f64 (pub)
    (let x:f64 x0)
    (let hx:i32 (call hi_word x))
    (let sign:i32 (shru hx 31))
    (set! hx (bitand hx 2147483647))
    (when (gte hx 1082535467)
      (when (call is_nan x) (return x))
      (when (gt x 709.782712893384) (return (* x 8.98846567431158e307)))
      (when (and (lt x -708.3964185322641) (lt x -745.1332191019411)) (return 0.0)))
    (let k:i32 0)
    (let hi:f64 0.0)
    (let lo:f64 0.0)
    (if (gt hx 1071001154)
        (block
          (if (gte hx 1072734898)
              (set! k (i32.trunc_f64_s (+ (* 1.4426950408889634 x) (if (eq sign 0) 0.5 -0.5))))
              (set! k (- (- 1 sign) sign)))
          (set! hi (- x (* (f64.convert_i32_s k) 0.6931471803691238)))
          (set! lo (* (f64.convert_i32_s k) 1.9082149292705877e-10))
          (set! x (- hi lo)))
        (if (gt hx 1043333120)
            (set! hi x)
            (return (+ 1.0 x))))
    (let xx:f64 (* x x))
    (let c:f64 (- x (* xx (+ 0.16666666666666602 (* xx (+ -0.0027777777777015593 (* xx (+ 6.613756321437934e-05 (* xx (+ -1.6533902205465252e-06 (* xx 4.1381367970572385e-08)))))))))))
    (let y:f64 (+ 1.0 (+ (- (/ (* x c) (- 2.0 c)) lo) hi)))
    (if (eq k 0) y (call scalbn y k)))

  (const LN2_HI:f64 0.6931471803691238)
  (const LN2_LO:f64 1.9082149292705877e-10)
  (const INVLN2:f64 1.4426950408889634)
  (const LG1:f64 0.6666666666666735)
  (const LG2:f64 0.3999999999940942)
  (const LG3:f64 0.2857142874366239)
  (const LG4:f64 0.22222198432149784)
  (const LG5:f64 0.1818357216161805)
  (const LG6:f64 0.15313837699209373)
  (const LG7:f64 0.14798198605116586)
  (const IVLN2HI:f64 1.4426950407214463)
  (const IVLN2LO:f64 1.6751713164886512e-10)
  (const IVLN10HI:f64 0.4342944818781689)
  (const IVLN10LO:f64 2.5082946711645275e-11)
  (const LOG10_2HI:f64 0.30102999566361177)
  (const LOG10_2LO:f64 3.694239077158931e-13)
  (const O_THRESHOLD:f64 709.782712893384)
  (const Q1:f64 -0.03333333333333313)
  (const Q2:f64 0.0015873015872548146)
  (const Q3:f64 -7.93650757867488e-5)
  (const Q4:f64 4.008217827329362e-6)
  (const Q5:f64 -2.0109921818362437e-7)

  ;; What the logarithms have in common (FreeBSD e_log.c): x = 2^k * (1 + f) with 1 + f in [sqrt(2)/2, sqrt(2)],
  ;; and R, the polynomial that log(1 + f) = f - hfsq + s * (hfsq + R) needs, s = f / (2 + f). `done` is set
  ;; when the answer needs no more (a zero, a negative number, infinity, NaN, 1): it is `v`.
  (struct LogParts [f:f64 hfsq:f64 s:f64 r:f64 k:i32 done:bool v:f64] (value))

  (fn log_split [x0:f64] -> LogParts
    (let x:f64 x0)
    (let bits:i64 (i64.reinterpret_f64 x))
    (let hx:i32 (call hi_word x))
    (let k:i32 0)
    (if (lt hx 1048576)
        (block
          (when (eq (shl bits 1i64) 0i64)
            (return (make LogParts [f:0.0 hfsq:0.0 s:0.0 r:0.0 k:0 done:true v:(/ -1.0 (* x x))])))
          (when (lt hx 0)
            (return (make LogParts [f:0.0 hfsq:0.0 s:0.0 r:0.0 k:0 done:true v:(/ (- x x) 0.0)])))
          (set! k -54)
          (set! x (* x 18014398509481984.0))
          (set! bits (i64.reinterpret_f64 x))
          (set! hx (call hi_word x)))
        (if (gte hx 2146435072)
            (return (make LogParts [f:0.0 hfsq:0.0 s:0.0 r:0.0 k:0 done:true v:x]))
            (when (and (eq hx 1072693248) (eq (i32.wrap bits) 0))
              (return (make LogParts [f:0.0 hfsq:0.0 s:0.0 r:0.0 k:0 done:true v:0.0])))))
    (set! hx (wrap.add hx 614242))
    (set! k (+ k (- (shru hx 20) 1023)))
    (set! hx (+ (bitand hx 1048575) 1072079006))
    (set! x (call from_words hx (i32.wrap bits)))
    (let f:f64 (- x 1.0))
    (let hfsq:f64 (* (* 0.5 f) f))
    (let s:f64 (/ f (+ 2.0 f)))
    (let z:f64 (* s s))
    (let w:f64 (* z z))
    (let t1:f64 (* w (+ LG2 (* w (+ LG4 (* w LG6))))))
    (let t2:f64 (* z (+ LG1 (* w (+ LG3 (* w (+ LG5 (* w LG7))))))))
    (make LogParts [f:f hfsq:hfsq s:s r:(+ t2 t1) k:k done:false v:0.0]))

  ;; The natural logarithm (FreeBSD e_log.c). ln(0) is -inf, ln of a negative number is NaN, ln(+inf) is +inf.
  (fn ln [x:f64] -> f64 (pub)
    (let p:LogParts (call log_split x))
    (when (get p LogParts.done) (return (get p LogParts.v)))
    (let f:f64 (get p LogParts.f))
    (let hfsq:f64 (get p LogParts.hfsq))
    (let dk:f64 (f64.convert_i32_s (get p LogParts.k)))
    (+ (+ (- (+ (* (get p LogParts.s) (+ hfsq (get p LogParts.r))) (* dk LN2_LO)) hfsq) f) (* dk LN2_HI)))

  ;; The logarithm base 2 (FreeBSD e_log2.c), with the high and low parts of 1/ln 2 kept apart for accuracy.
  (fn log2 [x:f64] -> f64 (pub)
    (let p:LogParts (call log_split x))
    (when (get p LogParts.done) (return (get p LogParts.v)))
    (let f:f64 (get p LogParts.f))
    (let hfsq:f64 (get p LogParts.hfsq))
    (let hi:f64 (call clear_lo (- f hfsq)))
    (let lo:f64 (+ (- (- f hi) hfsq) (* (get p LogParts.s) (+ hfsq (get p LogParts.r)))))
    (let val_hi:f64 (* hi IVLN2HI))
    (let val_lo:f64 (+ (* (+ lo hi) IVLN2LO) (* lo IVLN2HI)))
    (let y:f64 (f64.convert_i32_s (get p LogParts.k)))
    (let w:f64 (+ y val_hi))
    (set! val_lo (+ val_lo (+ (- y w) val_hi)))
    (+ val_lo w))

  ;; The logarithm base 10 (FreeBSD e_log10.c).
  (fn log10 [x:f64] -> f64 (pub)
    (let p:LogParts (call log_split x))
    (when (get p LogParts.done) (return (get p LogParts.v)))
    (let f:f64 (get p LogParts.f))
    (let hfsq:f64 (get p LogParts.hfsq))
    (let hi:f64 (call clear_lo (- f hfsq)))
    (let lo:f64 (+ (- (- f hi) hfsq) (* (get p LogParts.s) (+ hfsq (get p LogParts.r)))))
    (let val_hi:f64 (* hi IVLN10HI))
    (let dk:f64 (f64.convert_i32_s (get p LogParts.k)))
    (let y:f64 (* dk LOG10_2HI))
    (let val_lo:f64 (+ (+ (* dk LOG10_2LO) (* (+ lo hi) IVLN10LO)) (* lo IVLN10HI)))
    (let w:f64 (+ y val_hi))
    (set! val_lo (+ val_lo (+ (- y w) val_hi)))
    (+ val_lo w))

  ;; log(1 + x), exact for small x (FreeBSD s_log1p.c). log1p(-1) is -inf; below -1 it is NaN.
  (fn log1p [x:f64] -> f64 (pub)
    (let hx:i32 (call hi_word x))
    (let k:i32 1)
    (let f:f64 0.0)
    (let c:f64 0.0)
    (if (lt hx 1071284858)
        (block
          (when (gteu hx -1074790400)
            (when (eq x -1.0) (return (/ x 0.0)))
            (return (/ (- x x) 0.0)))
          (when (ltu (shl hx 1) 2034237440) (return x))
          (when (lteu hx -1076707644)
            (set! k 0)
            (set! f x)))
        (when (gte hx 2146435072) (return x)))
    (when (gt k 0)
      (let u:f64 (+ 1.0 x))
      (let hu:i32 (+ (call hi_word u) 614242))
      (set! k (- (shru hu 20) 1023))
      (if (lt k 54)
          (block
            (set! c (if (gte k 2) (- 1.0 (- u x)) (- x (- u 1.0))))
            (set! c (/ c u)))
          (set! c 0.0))
      (set! hu (+ (bitand hu 1048575) 1072079006))
      (set! f (- (call from_words hu (call lo_word u)) 1.0)))
    (let hfsq:f64 (* (* 0.5 f) f))
    (let s:f64 (/ f (+ 2.0 f)))
    (let z:f64 (* s s))
    (let w:f64 (* z z))
    (let t1:f64 (* w (+ LG2 (* w (+ LG4 (* w LG6))))))
    (let t2:f64 (* z (+ LG1 (* w (+ LG3 (* w (+ LG5 (* w LG7))))))))
    (let r:f64 (+ t2 t1))
    (let dk:f64 (f64.convert_i32_s k))
    (+ (+ (- (+ (* s (+ hfsq r)) (+ (* dk LN2_LO) c)) hfsq) f) (* dk LN2_HI)))

  ;; e^x - 1, exact for small x (FreeBSD s_expm1.c). expm1(-inf) is -1, expm1(+inf) is +inf.
  (fn expm1 [x0:f64] -> f64 (pub)
    (let x:f64 x0)
    (let hx:i32 (bitand (call hi_word x) 2147483647))
    (let sign:i32 (shru (call hi_word x) 31))
    (when (gte hx 1078159482)
      (when (call is_nan x) (return x))
      (when (neq sign 0) (return -1.0))
      (when (gt x O_THRESHOLD) (return (* x 8.98846567431158e307))))
    (let hi:f64 0.0)
    (let lo:f64 0.0)
    (let k:i32 0)
    (let c:f64 0.0)
    (if (gt hx 1071001154)
        (block
          (if (lt hx 1072734898)
              (if (eq sign 0)
                  (block (set! hi (- x LN2_HI)) (set! lo LN2_LO) (set! k 1))
                  (block (set! hi (+ x LN2_HI)) (set! lo (call neg LN2_LO)) (set! k -1)))
              (block
                (set! k (i32.trunc_f64_s (+ (* INVLN2 x) (if (neq sign 0) -0.5 0.5))))
                (let t:f64 (f64.convert_i32_s k))
                (set! hi (- x (* t LN2_HI)))
                (set! lo (* t LN2_LO))))
          (set! x (- hi lo))
          (set! c (- (- hi x) lo)))
        (when (lt hx 1016070144) (return x)))
    (let hfx:f64 (* 0.5 x))
    (let hxs:f64 (* x hfx))
    (let r1:f64 (+ 1.0 (* hxs (+ Q1 (* hxs (+ Q2 (* hxs (+ Q3 (* hxs (+ Q4 (* hxs Q5)))))))))))
    (let t:f64 (- 3.0 (* r1 hfx)))
    (let e:f64 (* hxs (/ (- r1 t) (- 6.0 (* x t)))))
    (when (eq k 0) (return (- x (- (* x e) hxs))))
    (set! e (- (* x (- e c)) c))
    (set! e (- e hxs))
    (when (eq k -1) (return (- (* 0.5 (- x e)) 0.5)))
    (when (eq k 1)
      (when (lt x -0.25) (return (* -2.0 (- e (+ x 0.5)))))
      (return (+ 1.0 (* 2.0 (- x e)))))
    (let twopk:f64 (f64.reinterpret_i64 (shl (i64.extend_s (+ 1023 k)) 52i64)))
    (when (or (lt k 0) (gt k 56))
      (let y:f64 (+ (- x e) 1.0))
      (if (eq k 1024)
          (set! y (* (* y 2.0) 8.98846567431158e307))
          (set! y (* y twopk)))
      (return (- y 1.0)))
