;; std/net: TCP sockets (docs/design/NET_PLAN.md), over AIPL's own host
;; interface, aipl_net_v1: the same in the VM, under aipl-run, and in
;; native executables.
;;
;;   (let l:net.Socket (try (call net.listen a (call str.from_str "127.0.0.1:8080"))))
;;   (let c:net.Socket (try (call net.accept l)))
;;   (let r:(ptr stream.Reader) (call net.reader a c))
;;   (let w:(ptr stream.Writer) (call net.writer a c))
;;   ... read lines from r, write to w ...
;;   (let _ok:bool (call stream.close_writer w))   ;; flushes
;;   (call stream.close_reader r)
;;   (call net.close c)
;;
;;   (let c:net.Socket (try (call net.connect a (call str.from_str "127.0.0.1:9000"))))
;;   ... the same reader and writer, then (call net.close c) ...
;;
;; A program may listen only where it was granted: `aipl eval --listen
;; 127.0.0.1:8080 prog.aipl`, `aipl-run --listen ...`, or, fixed in a native
;; executable, `aipl compile --exe --listen ...`; elsewhere listen gives
;; Error.not_granted. It may connect only to a host granted with
;; `--allow-connect HOST:PORT` (HOST:* for any port), the same way; HOST is an address, or, for
;; connect_host and connect_tls, a name (granted by that name). Addresses are read by std/ip, as Rust reads them.
;; A Socket's handle is private to this module, so a socket cannot be given
;; to std/fs, or a file to it. Every call blocks until it is done; one
;; connection at a time for now (a pool of threads later). Nothing here
;; keeps memory: the address bytes listen needs come from its allocator
;; and go back to it, and a reader's or writer's memory comes from the
;; allocator it is made with.
(module net
  (import alloc)
  (import buf)
  (import str)
  (import ip)
  (import option)
  (import stream)

  ;; A listening socket or a connection.
  (struct Socket [h:i32] (value) (pub))

  ;; Why a call failed.
  (enum Error [not_an_address not_granted refused connect_not_granted no_host_support tls_failed no_such_host] (pub))

  ;; What went wrong, for a message.
  (fn message [e:Error] -> str (pub) (no_leak)
    (match e
      (Error.not_an_address "not an ADDR:PORT (127.0.0.1:8080, [::1]:8080)")
      (Error.not_granted "not granted: run the program with --listen ADDR:PORT")
      (Error.refused "refused by the system")
      (Error.connect_not_granted "not granted: run the program with --allow-connect HOST:PORT")
      (Error.no_host_support "host names and TLS are not in native executables: use an address and plain http, run it as a wasm module (aipl eval, aipl-run, compile --exe --target wasm), or put a proxy in front")
      (Error.tls_failed "the TLS handshake failed: an untrusted or mismatched certificate, or a server that does not speak TLS")
      (Error.no_such_host "the name did not resolve")))

  ;; A socket listening on `at` (ADDR:PORT), with SO_REUSEADDR and a
  ;; backlog of 128.
  (fn listen [a:alloc.Allocator at:str.Bytes] -> (result Socket Error) (pub) (no_leak)
    (match (call ip.parse_endpoint at)
      ((option.Option ip.Endpoint) none (err:Socket Error.not_an_address))
      ((option.Option ip.Endpoint) some [e]
       (let ad:ip.Addr (get e ip.Endpoint.addr))
       (let n:i32 (call ip.len ad))
       (let b:(arr u8) (arr.new u8 a n))
       (for i 0 n (arr.set u8 b i (call ip.byte_at ad i)))
       (let h:i32 (unsafe (net.listen (arr.addr b) n (get e ip.Endpoint.port))))
       (call (alloc.free_array u8) a b)
       (cond ((eq h -2) (err:Socket Error.not_granted))
             ((lt h 0) (err:Socket Error.refused))
             (else (ok:Error (make Socket [h:h])))))))

  ;; A connection to `at` (ADDR:PORT), if the program was granted it (--allow-connect); waits
  ;; for the system's answer.
  (fn connect [a:alloc.Allocator at:str.Bytes] -> (result Socket Error) (pub) (no_leak)
    (match (call ip.parse_endpoint at)
      ((option.Option ip.Endpoint) none (err:Socket Error.not_an_address))
      ((option.Option ip.Endpoint) some [e] (call connect_to a e))))

  ;; A connection to the host `host` (a name, or an address as text) on `port`, if the program was granted
  ;; it (`--allow-connect HOST:PORT`); the system's resolver finds the address. Not in native executables
  ;; (Error.no_host_support).
  (fn connect_host [a:alloc.Allocator host:str.Bytes port:i32] -> (result Socket Error) (pub) (no_leak)
    (let h:i32 (unsafe (net.connect_host (call str.addr host) (get host str.Bytes.len) port)))
    (cond ((eq h -2) (err:Socket Error.connect_not_granted))
          ((eq h -3) (err:Socket Error.no_host_support))
          ((eq h -5) (err:Socket Error.no_such_host))
          ((lt h 0) (err:Socket Error.refused))
          (else (ok:Error (make Socket [h:h])))))

  ;; A secure connection (TLS) to `host` on `port`: connect_host, then the handshake, in which the server's
  ;; certificate must be trusted (the Mozilla roots, and the file AIPL_CA_FILE names) and carry the name.
  ;; Everything sent and received after is plain bytes. Not in native executables (Error.no_host_support).
  (fn connect_tls [a:alloc.Allocator host:str.Bytes port:i32] -> (result Socket Error) (pub) (no_leak)
    (match_result (call connect_host a host port)
      (ok s
        (let r:i32 (unsafe (net.tls_connect (get s Socket.h) (call str.addr host) (get host str.Bytes.len))))
        (cond ((eq r 0) (ok:Error s))
              (else
               (call close s)
               (err:Socket (if (eq r -3) Error.no_host_support Error.tls_failed)))))
      (err e (err:Socket e))))

  ;; A connection to the endpoint e.
  (fn connect_to [a:alloc.Allocator e:ip.Endpoint] -> (result Socket Error) (pub) (no_leak)
    (let ad:ip.Addr (get e ip.Endpoint.addr))
    (let n:i32 (call ip.len ad))
    (let b:(arr u8) (arr.new u8 a n))
    (for i 0 n (arr.set u8 b i (call ip.byte_at ad i)))
    (let h:i32 (unsafe (net.connect (arr.addr b) n (get e ip.Endpoint.port))))
    (call (alloc.free_array u8) a b)
    (cond ((eq h -2) (err:Socket Error.connect_not_granted))
          ((lt h 0) (err:Socket Error.refused))
          (else (ok:Error (make Socket [h:h])))))

  ;; The next connection on listening socket l (waiting for one).
  (fn accept [l:Socket] -> (result Socket Error) (pub) (no_leak)
    (let h:i32 (unsafe (net.accept (get l Socket.h))))
    (if (lt h 0) (err:Socket Error.refused) (ok:Error (make Socket [h:h]))))

  ;; Up to max bytes from connection c, added to `into`: how many, 0 at the
  ;; end of the connection, or -1 on an error.
  (fn recv [c:Socket into:(ptr buf.Buf) max:i32] -> i32 (pub) (no_leak)
    (req (gte max 0))
    (unsafe
      (let at:i32 (call buf.room into max))
      (let n:i32 (net.recv (get c Socket.h) at max))
      (when (gt n 0) (call buf.grew into n))
      n))

  ;; Sends all of b on connection c; false on an error (the peer gone, say).
  (fn send [c:Socket b:str.Bytes] -> bool (pub) (no_leak)
    (let done:i32 0)
    (let n:i32 (get b str.Bytes.len))
    (while (lt done n)
      (let part:str.Bytes (call str.slice b done (- n done)))
      (let k:i32 (unsafe (net.send (get c Socket.h) (call str.addr part) (get part str.Bytes.len))))
      (when (lte k 0) (return false))
      (set! done (+ done k)))
    true)

  ;; Closes a socket (a connection is shut down first).
  (fn close [s:Socket] -> void (pub) (no_leak)
    (let _r:i32 (unsafe (net.close (get s Socket.h))))
    (block))

  ;; ===== Streams =====

  (fn fill [c:Socket into:(ptr buf.Buf)] -> i32 (no_leak)
    (call recv c into 8192))

  (fn drain [c:Socket b:str.Bytes] -> bool (no_leak)
    (call send c b))

  ;; A reader of connection c (std/stream: by lines, bytes, or all of it),
  ;; its window from a. close_reader leaves c open.
  (fn reader [a:alloc.Allocator c:Socket] -> (ptr stream.Reader) (pub) (no_leak)
    (call (stream.reader_of Socket) a c (ref fill)))

  ;; A writer to connection c, holding what it is given until 8 KB, flush,
  ;; or close_writer; close_writer leaves c open.
  (fn writer [a:alloc.Allocator c:Socket] -> (ptr stream.Writer) (pub) (no_leak)
    (call (stream.writer_of Socket) a c (ref drain)))
)
