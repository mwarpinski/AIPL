;; std/option: a value that may be missing, for any type T.
;;
;;   (let o:(option.Option i32) (make (option.Option i32) some 5))
;;   (let n:(option.Option i32) (make (option.Option i32) none))
;;   (match o
;;     ((option.Option i32) some [v] v)
;;     ((option.Option i32) none 0))
;;   (call (option.unwrap_or i32) n 0)       ;; => 0
;;
;; Use it instead of a sentinel (-1, a null pointer) when "nothing" is a
;; possible answer: the checker makes every match handle none.
(module option
  ;; A value of type T (some), or nothing (none).
  (union (Option T) [(some value:T) (none)] (pub))

  ;; Whether o holds a value.
  (fn (is_some T) [o:(Option T)] -> bool (pub)
    (match o ((Option T) some [_] true) ((Option T) none false)))

  ;; Whether o is none.
  (fn (is_none T) [o:(Option T)] -> bool (pub)
    (match o ((Option T) some [_] false) ((Option T) none true)))

  ;; The value, or `fallback` for none.
  (fn (unwrap_or T) [o:(Option T) fallback:T] -> T (pub)
    (match o ((Option T) some [v] v) ((Option T) none fallback)))

  ;; ===== Tests =====

  ;; Pass count; test_suite.aipl expects 7.
  (fn run_option_tests [] -> i32 (pub)
    (let p:i32 0)
    (let five:(Option i32) (make (Option i32) some 5))
    (let nothing:(Option i32) (make (Option i32) none))
    (when (call (is_some i32) five) (set! p (+ p 1)))
    (when (call (is_none i32) nothing) (set! p (+ p 1)))
    (when (eq (call (unwrap_or i32) five 0) 5) (set! p (+ p 1)))
    (when (eq (call (unwrap_or i32) nothing -1) -1) (set! p (+ p 1)))
    ;; 64-bit and float values, and an option of an option
    (when (eq (call (unwrap_or i64) (make (Option i64) some 5000000000i64) 0i64) 5000000000i64) (set! p (+ p 1)))
    (when (eq (call (unwrap_or f64) (make (Option f64) none) 2.5) 2.5) (set! p (+ p 1)))
    (let inner:(Option (Option bool)) (make (Option (Option bool)) some (make (Option bool) none)))
    (when (call (is_none bool) (call (unwrap_or (Option bool)) inner (make (Option bool) some true))) (set! p (+ p 1)))
    p))
