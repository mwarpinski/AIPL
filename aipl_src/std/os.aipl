;; std/os: the program's command line and environment, over the args.* and
;; env.* ops (WASI args_get / environ_get layout: a table of u32 pointers to
;; NUL-terminated strings). The same in the VM, where `aipl eval FILE -- a b`
;; supplies the arguments, and compiled, where the WASI host does
;; (`wasmtime run --invoke main prog.wasm a b`; environment variables only
;; when forwarded, e.g. `--env AIPL_PATH`). Each table is read once, on
;; first use, and kept (neither changes while the program runs), so arg
;; and env allocate nothing after the first call: a (no_leak) function may
;; use them.
(module os
  (import alloc)
  (import option)
  (import str)

  ;; A fetched table: count entries, entry i's address at argv + 4i.
  (struct Table [count:i32 argv:i32])

  ;; is_env false: the arguments; true: the KEY=VALUE environment entries.
  (fn fetch [is_env:bool] -> (ptr Table)
    (unsafe (let sizes:i32 (mem.alloc 8))
    (let ok:i32 (if is_env (env.sizes sizes (+ sizes 4)) (args.sizes sizes (+ sizes 4))))
    (let t:(ptr Table) (new Table (call alloc.forever)))
    (put t Table.count 0)
    (put t Table.argv 0)
    (when (neq ok 0) (return t))
    (let count:i32 (mem.load32 sizes))
    (let argv:i32 (mem.alloc (* 4 count)))
    (let buf:i32 (mem.alloc (mem.load32 (+ sizes 4))))
    (when (neq (if is_env (env.get argv buf) (args.get argv buf)) 0) (return t))
    (put t Table.count count)
    (put t Table.argv argv)
    t))

  ;; The table, read on first use and kept in cell 28 (the arguments) or 32
  ;; (the environment) of the runtime block (AIPL_SPEC.md 7.9). Two threads
  ;; reading it at once agree on one, as alloc.default does ((no_leak): it
  ;; is made once, then handed out each time).
  (fn table [is_env:bool] -> (ptr Table) (no_leak)
    (unsafe (let cell:i32 (if is_env 32 28))
    (when (eq (mem.load32 cell) 0) (let _won:bool (atomic.cas cell 0 (ptr.addr (call fetch is_env)))))
    (ptr.cast Table (mem.load32 cell))))

  ;; Entry i of a table, without its NUL.
  (fn entry [t:(ptr Table) i:i32] -> str.Bytes (no_leak)
    (req (and (gte i 0) (lt i (get t Table.count))))
    (unsafe (let p:i32 (mem.load32 (+ (get t Table.argv) (* 4 i))))
    (let n:i32 0)
    (while (neq (mem.load8 (+ p n)) 0) (set! n (+ n 1)))
    (call str.bytes p n)))

  ;; Number of command-line arguments, argv[0] (the program) included.
  (fn arg_count [] -> i32 (pub) (no_leak)
    (get (call table false) Table.count))

  ;; Argument i (0 is the program), or none when there is no argument i.
  (fn arg [i:i32] -> (option.Option str.Bytes) (pub) (no_leak)
    (let t:(ptr Table) (call table false))
    (if (and (gte i 0) (lt i (get t Table.count)))
        (make (option.Option str.Bytes) some (call entry t i))
        (make (option.Option str.Bytes) none)))

  ;; The value of environment variable `name`, or none when it is not set.
  (fn env [name:str] -> (option.Option str.Bytes) (pub) (no_leak)
    (unsafe (let key:str.Bytes (call str.from_str name))
    (let klen:i32 (get key str.Bytes.len))
    (let t:(ptr Table) (call table true))
    (for i 0 (get t Table.count)
      (let e:str.Bytes (call entry t i))
      (when (and (gt (get e str.Bytes.len) klen)
               (and (eq (call str.byte_at e klen) 61)
                    (call str.bytes_eq (call str.bytes (call str.addr e) klen) key)))
          (return (make (option.Option str.Bytes) some (call str.bytes (+ (call str.addr e) (+ klen 1)) (- (get e str.Bytes.len) (+ klen 1)))))))
    (make (option.Option str.Bytes) none)))

  ;; Argument i as a decimal i32, or `default` if there is no argument i or
  ;; it is not a number: (call os.arg_int 1 1000).
  (fn arg_int [i:i32 default:i32] -> i32 (pub) (no_leak)
    (when (or (lt i 0) (gte i (call arg_count))) (return default))
    (call str.parse_int_or (call entry (call table false) i) default))

  ;; A random i32 from the operating system's generator (sys.random).
  (fn random_i32 [] -> i32 (pub)
    (let a:alloc.Allocator (call alloc.default))
    (unsafe (let p:i32 (call alloc.raw a 8))
    (when (neq (sys.random p 4) 0) (sys.exit 70))
    (let r:i32 (mem.load32 p))
    (call alloc.free_raw a p 8)
    r))

  ;; Pass count; expects 3. A variable that is surely unset, an argument
  ;; index past the end, and arg_int's default (past the end, and argument
  ;; 0, the program's name, which is not a number).
  (fn run_os_tests [] -> i32 (pub)
    (let p:i32 0)
    (when (call (option.is_none str.Bytes) (call env "AIPL_OS_TEST_SURELY_UNSET")) (set! p (+ p 1)))
    (when (call (option.is_none str.Bytes) (call arg (call arg_count))) (set! p (+ p 1)))
    (when (and (eq (call arg_int (call arg_count) 5) 5) (eq (call arg_int 0 6) 6)) (set! p (+ p 1)))
    p))
