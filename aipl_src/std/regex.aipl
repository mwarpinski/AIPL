;; std/regex: regular expressions of the guaranteed-linear kind (as Go's
;; and RE2's): a pattern compiles to a program for a Pike virtual machine,
;; which follows every way of matching at once, so a search takes time in
;; proportion to the pattern's size times the text's length, whatever the
;; pattern. No backreferences and no lookaround: those are what make some
;; patterns take exponential time elsewhere.
;;
;;   (match_result (call regex.compile a "(?P<key>\\w+)=(\\d+)")
;;     (ok re ... (call regex.find re text) ...)
;;     (err e ... (get e regex.Error.at) (get e regex.Error.what) ...))
;;
;; Syntax: literals and escapes (\n \t \r \f \v \a \0 \xHH \uHHHH and any
;; punctuation), `.`, classes `[a-z]` and `[^...]`, \d \w \s and \D \W \S,
;; anchors ^ $ \A \Z \b \B, groups (capturing, `(?:...)`, `(?P<name>...)`),
;; `|`, the quantifiers * + ? {m} {m,} {,n} {m,n} and their lazy forms
;; (a `?` after), and flags at the start: (?i) (ASCII letters match either
;; case), (?m) (^ and $ at every line), (?s) (`.` matches a newline too).
;; Matches are what Python's re gives with re.ASCII: the leftmost match,
;; and of those the one a backtracking matcher finds first; $ (without m)
;; matches at the end and before a newline that ends the text, as in
;; Python. \d \w \s \b are ASCII, as in RE2. The text is UTF-8: `.` and
;; classes match a character (a byte that is not UTF-8 matches as U+FFFD),
;; and spans are byte offsets. Checked against Python's re on generated
;; patterns and texts (tests/aipl/regex).
;;
;; A Regex holds the machine's working lists, so one Regex searches on one
;; thread at a time.
(module regex
  (import str)
  (import buf)
  (import alloc)
  (import vec)
  (import option)
  (import utf8)

  ;; Why a pattern or a template was refused, and the byte offset where.
  (struct Error [(read at:i32) (read what:str)] (pub))
  ;; A match's or a group's bytes: from start up to end, end left out.
  (struct Span [(read start:i32) (read end:i32)] (value) (pub))

  ;; the machine's instructions: op, and its operands x and y (an
  ;; instruction that reads a character goes on at y)
  (const CHAR:i32 0)    ;; the character x
  (const FOLD:i32 1)    ;; the ASCII letter x (lowercase) in either case
  (const ANY:i32 2)     ;; any character but a newline
  (const ANYNL:i32 3)   ;; any character
  (const CLASS:i32 4)   ;; a character of class x
  (const SPLIT:i32 5)   ;; go on at x, and (less preferred) at y
  (const JMP:i32 6)     ;; go on at x
  (const SAVE:i32 7)    ;; note the position in capture slot x
  (const ASSERT:i32 8)  ;; go on if the position is of kind x
  (const MATCH:i32 9)

  ;; the kinds of position ASSERT checks
  (const AT_START:i32 0)    ;; \A, and ^ without m
  (const AT_END:i32 1)      ;; \Z
  (const LINE_START:i32 2)  ;; ^ with m
  (const LINE_END:i32 3)    ;; $ with m
  (const END_OR_NL:i32 4)   ;; $ without m: the end, or before a final newline
  (const WORD_EDGE:i32 5)   ;; \b
  (const NOT_EDGE:i32 6)    ;; \B

  ;; the parser's nodes: kind, and operands a b c d
  (const N_EMPTY:i32 0)   ;; matches the empty text (d = 1: a flags group)
  (const N_LIT:i32 1)     ;; the character a
  (const N_ANY:i32 2)
  (const N_CLASS:i32 3)   ;; class a
  (const N_CAT:i32 4)     ;; a then b
  (const N_ALT:i32 5)     ;; a, or else b
  (const N_REPEAT:i32 6)  ;; a, from b to c times (c = -1: no limit); d = 1 greedy
  (const N_GROUP:i32 7)   ;; a, as group b (-1: not capturing)
  (const N_ASSERT:i32 8)  ;; the position kind a

  ;; the most a count in {m,n} may be, the deepest groups may nest, and
  ;; the most instructions a pattern may compile to
  (const MAX_REPEAT:i32 1000)
  (const MAX_DEPTH:i32 250)
  (const MAX_PROGRAM:i32 100000)

  ;; The threads at one position: the instruction each is at and its
  ;; capture slots (ncap each), with mark[pc] = gen once pc is on the list.
  (struct Threads [pcs:(arr i32) caps:(arr i32) mark:(arr i32) count:i32 gen:i32])

  ;; A compiled pattern.
  (struct Regex [a:alloc.Allocator
                 op:(ptr (vec.Vec i32)) x:(ptr (vec.Vec i32)) y:(ptr (vec.Vec i32))
                 lo:(ptr (vec.Vec i32)) hi:(ptr (vec.Vec i32))
                 cstart:(ptr (vec.Vec i32)) ccount:(ptr (vec.Vec i32)) cneg:(ptr (vec.Vec i32))
                 ngroups:i32 names:(ptr (vec.Vec str)) name_group:(ptr (vec.Vec i32))
                 prefix:(ptr buf.Buf) lit:str.Bytes
                 ready:bool cur:(ptr Threads) nxt:(ptr Threads) scratch:(arr i32) found:(arr i32)] (pub))

  ;; A match's groups: spans[2i] and spans[2i + 1] are group i's start and
  ;; end, -1 if it took no part (group 0 is the whole match).
  (struct Captures [spans:(arr i32) n:i32 a:alloc.Allocator] (pub))

  (struct Parser [b:str.Bytes pos:i32 re:(ptr Regex)
                  kind:(ptr (vec.Vec i32)) na:(ptr (vec.Vec i32)) nb:(ptr (vec.Vec i32)) nc:(ptr (vec.Vec i32)) nd:(ptr (vec.Vec i32))
                  icase:bool multi:bool dotall:bool flags_end:i32 depth:i32
                  failed:bool err_at:i32 err_what:str])

  ;; ===== compiling =====

  ;; The program for pattern, from a, or why and where pattern is refused.
  (fn compile [a:alloc.Allocator pattern:str] -> (result (ptr Regex) (ptr Error)) (pub)
    (let re:(ptr Regex) (new Regex a [a:a
                                      op:(call (vec.make i32) a 32)
                                      x:(call (vec.make i32) a 32)
                                      y:(call (vec.make i32) a 32)
                                      lo:(call (vec.make i32) a 16)
                                      hi:(call (vec.make i32) a 16)
                                      cstart:(call (vec.make i32) a 4)
                                      ccount:(call (vec.make i32) a 4)
                                      cneg:(call (vec.make i32) a 4)
                                      ngroups:0
                                      names:(call (vec.make str) a 4)
                                      name_group:(call (vec.make i32) a 4)
                                      prefix:(call buf.make a 16)
                                      lit:(zero str.Bytes)
                                      ready:false
                                      cur:(zero (ptr Threads))
                                      nxt:(zero (ptr Threads))
                                      scratch:(zero (arr i32))
                                      found:(zero (arr i32))]))
    (let p:(ptr Parser) (new Parser a [b:(call str.from_str pattern)
                                       pos:0
                                       re:re
                                       kind:(call (vec.make i32) a 32)
                                       na:(call (vec.make i32) a 32)
                                       nb:(call (vec.make i32) a 32)
                                       nc:(call (vec.make i32) a 32)
                                       nd:(call (vec.make i32) a 32)
                                       icase:false
                                       multi:false
                                       dotall:false
                                       flags_end:0
                                       depth:0
                                       failed:false
                                       err_at:0
                                       err_what:""]))
    (let root:i32 (call parse_alt p))
    (when (and (not (get p Parser.failed)) (lt (get p Parser.pos) (get (get p Parser.b) str.Bytes.len)))
      ;; parse_alt stops only at the end or at a ')' with no '(' before it
      (let _u:i32 (call fail p (get p Parser.pos) "unbalanced parenthesis")))
    (when (not (get p Parser.failed))
      (let _s0:i32 (call emit p SAVE 0 0))
      (call compile_node p root)
      (let _s1:i32 (call emit p SAVE 1 0))
      (let _m:i32 (call emit p MATCH 0 0))
      (when (not (get p Parser.icase)) (call find_prefix p root)))
    (let failed:bool (get p Parser.failed))
    (let at:i32 (get p Parser.err_at))
    (let what:str (get p Parser.err_what))
    (call free_parser p)
    (when failed
      (call free re)
      (let e:(ptr Error) (new Error a [at:at what:what]))
      (return (err:(ptr Regex) e)))
    (call make_machine re)
    ;; one view of the prefix for every search (buf.bytes makes a new one)
    (put re Regex.lit (call buf.bytes (get re Regex.prefix)))
    (ok:(ptr Error) re))

  (fn free_parser [p:(ptr Parser)] -> void
    (call (vec.free i32) (get p Parser.kind))
    (call (vec.free i32) (get p Parser.na))
    (call (vec.free i32) (get p Parser.nb))
    (call (vec.free i32) (get p Parser.nc))
    (call (vec.free i32) (get p Parser.nd))
    (call (alloc.destroy Parser) (get (get p Parser.re) Regex.a) p))

  ;; Frees the regex (and the Error of a failed compile: free_error).
  (fn free [re:(ptr Regex)] -> void (pub)
    (let a:alloc.Allocator (get re Regex.a))
    (call (vec.free i32) (get re Regex.op))
    (call (vec.free i32) (get re Regex.x))
    (call (vec.free i32) (get re Regex.y))
    (call (vec.free i32) (get re Regex.lo))
    (call (vec.free i32) (get re Regex.hi))
    (call (vec.free i32) (get re Regex.cstart))
    (call (vec.free i32) (get re Regex.ccount))
    (call (vec.free i32) (get re Regex.cneg))
    (call (vec.free str) (get re Regex.names))
    (call (vec.free i32) (get re Regex.name_group))
    (call buf.free (get re Regex.prefix))
    (when (get re Regex.ready)
      (call free_threads a (get re Regex.cur))
      (call free_threads a (get re Regex.nxt))
      (call (alloc.free_array i32) a (get re Regex.scratch))
      (call (alloc.free_array i32) a (get re Regex.found)))
    (call (alloc.destroy Regex) a re))

  ;; Frees an Error that compile or replace_all gave.
  (fn free_error [a:alloc.Allocator e:(ptr Error)] -> void (pub)
    (call (alloc.destroy Error) a e))

  ;; The number of capturing groups (not counting the whole match).
  (fn groups [re:(ptr Regex)] -> i32 (pub) (get re Regex.ngroups))

  ;; The number of the group named name, or -1 if there is none.
  (fn group_index [re:(ptr Regex) name:str] -> i32 (pub)
    (let names:(ptr (vec.Vec str)) (get re Regex.names))
    (for i 0 (call (vec.len str) names)
      (when (call str.same (call (vec.at str) names i) name) (return (call (vec.at i32) (get re Regex.name_group) i))))
    -1)

  ;; Notes the first failure (at the byte offset at); gives -1, a node no
  ;; caller uses once failed is set.
  (fn fail [p:(ptr Parser) at:i32 what:str] -> i32
    (when (not (get p Parser.failed))
      (put p Parser.failed true)
      (put p Parser.err_at at)
      (put p Parser.err_what what))
    -1)

  (fn node [p:(ptr Parser) kind:i32 a:i32 b:i32 c:i32 d:i32] -> i32
    (call (vec.push i32) (get p Parser.kind) kind)
    (call (vec.push i32) (get p Parser.na) a)
    (call (vec.push i32) (get p Parser.nb) b)
    (call (vec.push i32) (get p Parser.nc) c)
    (call (vec.push i32) (get p Parser.nd) d)
    (- (call (vec.len i32) (get p Parser.kind)) 1))

  (fn kind_of [p:(ptr Parser) n:i32] -> i32 (call (vec.at i32) (get p Parser.kind) n))
  (fn na [p:(ptr Parser) n:i32] -> i32 (call (vec.at i32) (get p Parser.na) n))
  (fn nb [p:(ptr Parser) n:i32] -> i32 (call (vec.at i32) (get p Parser.nb) n))
  (fn nc [p:(ptr Parser) n:i32] -> i32 (call (vec.at i32) (get p Parser.nc) n))
  (fn nd [p:(ptr Parser) n:i32] -> i32 (call (vec.at i32) (get p Parser.nd) n))

  ;; The character at the parser's position, or -1 at the end.
  (fn peek [p:(ptr Parser)] -> i32
    (let b:str.Bytes (get p Parser.b))
    (if (lt (get p Parser.pos) (get b str.Bytes.len))
        (get (call utf8.decode b (get p Parser.pos)) utf8.Char.cp)
        -1))

  ;; The byte at offset k past the position, or -1 past the end.
  (fn byte_ahead [p:(ptr Parser) k:i32] -> i32
    (let b:str.Bytes (get p Parser.b))
    (let i:i32 (+ (get p Parser.pos) k))
    (if (lt i (get b str.Bytes.len)) (call str.byte_at b i) -1))

  (fn advance [p:(ptr Parser)] -> void
    (let b:str.Bytes (get p Parser.b))
    (put p Parser.pos (+ (get p Parser.pos) (call utf8.step (call utf8.decode b (get p Parser.pos))))))

  ;; alternatives: concat ('|' concat)*
  (fn parse_alt [p:(ptr Parser)] -> i32
    (put p Parser.depth (+ (get p Parser.depth) 1))
    (when (gt (get p Parser.depth) MAX_DEPTH) (return (call fail p (get p Parser.pos) "groups nested too deep")))
    (let left:i32 (call parse_concat p))
    (while (and (not (get p Parser.failed)) (eq (call peek p) 124))
      (call advance p)
      (let right:i32 (call parse_concat p))
      (set! left (call node p N_ALT left right 0 0)))
    (put p Parser.depth (- (get p Parser.depth) 1))
    left)

  ;; items up to a '|', a ')', or the end
  (fn parse_concat [p:(ptr Parser)] -> i32
    (let n:i32 (call node p N_EMPTY 0 0 0 0))
    (let first:bool true)
    (while (not (get p Parser.failed))
      (let c:i32 (call peek p))
      (when (or (eq c -1) (or (eq c 124) (eq c 41))) (break))
      (let item:i32 (call parse_repeat p))
      (if first (set! n item) (set! n (call node p N_CAT n item 0 0)))
      (set! first false))
    n)

  ;; Whether a quantifier starts at the position: * + ? or a brace
  ;; Python reads as one ({m} {m,} {,n} {m,n} {,}).
  (fn at_quantifier [p:(ptr Parser)] -> bool
    (let c:i32 (call peek p))
    (cond
      ((or (eq c 42) (or (eq c 43) (eq c 63))) true)
      ((eq c 123) (gte (call brace_length p) 0))
      (else false)))

  ;; The length of the brace quantifier at the position, or -1 if the '{'
  ;; there is a literal.
  (fn brace_length [p:(ptr Parser)] -> i32
    (let k:i32 1)
    (let digits:i32 0)
    (while (call is_digit (call byte_ahead p k)) (set! k (+ k 1)) (set! digits (+ digits 1)))
    (when (eq (call byte_ahead p k) 44)
      (set! k (+ k 1))
      (set! digits (+ digits 1))
      (while (call is_digit (call byte_ahead p k)) (set! k (+ k 1))))
    ;; "{}" is a literal brace pair
    (if (and (eq (call byte_ahead p k) 125) (gt k 1)) (+ k 1) -1))

  (fn is_digit [c:i32] -> bool (and (gte c 48) (lte c 57)))

  ;; The number of the digits at the position (none: -1), moving past
  ;; them; counts over MAX_REPEAT stop at MAX_REPEAT + 1.
  (fn read_count [p:(ptr Parser)] -> i32
    (when (not (call is_digit (call byte_ahead p 0))) (return -1))
    (let v:i32 0)
    (while (call is_digit (call byte_ahead p 0))
      (set! v (+ (* v 10) (- (call byte_ahead p 0) 48)))
      (when (gt v MAX_REPEAT) (set! v (+ MAX_REPEAT 1)))
      (put p Parser.pos (+ (get p Parser.pos) 1)))
    v)

  ;; an atom and its quantifier, if any
  (fn parse_repeat [p:(ptr Parser)] -> i32
    (let atom:i32 (call parse_atom p))
    (when (get p Parser.failed) (return -1))
    (when (not (call at_quantifier p)) (return atom))
    (let at:i32 (get p Parser.pos))
    (let k:i32 (call kind_of p atom))
    (when (or (eq k N_ASSERT) (and (eq k N_EMPTY) (eq (call nd p atom) 1))) (return (call fail p at "nothing to repeat")))
    (let c:i32 (call peek p))
    (let lo:i32 0)
    (let hi:i32 -1)
    (cond
      ((eq c 42) (call advance p))
      ((eq c 43) (call advance p) (set! lo 1))
      ((eq c 63) (call advance p) (set! hi 1))
      (else
        (put p Parser.pos (+ (get p Parser.pos) 1))
        (let m:i32 (call read_count p))
        (set! lo (if (lt m 0) 0 m))
        (if (eq (call byte_ahead p 0) 44)
            (block
              (put p Parser.pos (+ (get p Parser.pos) 1))
              (set! hi (call read_count p)))
            (set! hi m))
        (put p Parser.pos (+ (get p Parser.pos) 1))
        (when (or (gt lo MAX_REPEAT) (gt hi MAX_REPEAT)) (return (call fail p at "repeat count too large (at most 1000)")))
        (when (and (gte hi 0) (gt lo hi)) (return (call fail p at "min repeat greater than max repeat")))))
    (let greedy:i32 1)
    (cond
      ((eq (call peek p) 63) (call advance p) (set! greedy 0))
      ((eq (call peek p) 43) (return (call fail p (get p Parser.pos) "possessive quantifiers are not supported")))
      (else (block)))
    (when (call at_quantifier p) (return (call fail p (get p Parser.pos) "multiple repeat")))
    (call node p N_REPEAT atom lo hi greedy))

  (fn parse_atom [p:(ptr Parser)] -> i32
    (let at:i32 (get p Parser.pos))
    (let c:i32 (call peek p))
    (cond
      ((eq c 40) (call parse_group p))
      ((eq c 91) (call parse_class p))
      ((eq c 46) (call advance p) (call node p N_ANY 0 0 0 0))
      ((eq c 94) (call advance p) (call node p N_ASSERT (if (get p Parser.multi) LINE_START AT_START) 0 0 0))
      ((eq c 36) (call advance p) (call node p N_ASSERT (if (get p Parser.multi) LINE_END END_OR_NL) 0 0 0))
      ((eq c 92) (call parse_escape p))
      ((call at_quantifier p) (call fail p at "nothing to repeat"))
      (else (call advance p) (call node p N_LIT c 0 0 0))))

  (fn parse_group [p:(ptr Parser)] -> i32
    (let open:i32 (get p Parser.pos))
    (call advance p)
    (when (neq (call peek p) 63)
      ;; a capturing group, numbered by its '(' as Python numbers them
      (let k:i32 (+ (get (get p Parser.re) Regex.ngroups) 1))
      (put (get p Parser.re) Regex.ngroups k)
      (return (call group_body p open k)))
    (call advance p)
    (let c:i32 (call peek p))
    (cond
      ((eq c 58) (call advance p) (call group_body p open -1))
      ((eq c 80)
       (call advance p)
       (cond
         ((eq (call peek p) 60) (call advance p) (call named_group p open))
         ((eq (call peek p) 61) (call fail p open "backreferences are not supported"))
         (else (call fail p open "unknown extension ?P"))))
      ((or (eq c 105) (or (eq c 109) (eq c 115))) (call flags_group p open))
      ((or (eq c 61) (eq c 33)) (call fail p open "lookahead is not supported"))
      ((eq c 60) (call fail p open "lookbehind is not supported"))
      (else (call fail p open "unknown extension"))))

  ;; the inside of a group up to its ')'
  (fn group_body [p:(ptr Parser) open:i32 k:i32] -> i32
    (let inner:i32 (call parse_alt p))
    (when (get p Parser.failed) (return -1))
    (when (neq (call peek p) 41) (return (call fail p open "missing ), unterminated subpattern")))
    (call advance p)
    (call node p N_GROUP inner k 0 0))

  ;; (?P<name>...), after the '<'
  (fn named_group [p:(ptr Parser) open:i32] -> i32
    (let start:i32 (get p Parser.pos))
    (let c:i32 (call byte_ahead p 0))
    (when (not (or (call is_word c) (eq c 62))) (return (call fail p start "bad character in group name")))
    (when (call is_digit c) (return (call fail p start "bad character in group name")))
    (while (call is_word (call byte_ahead p 0)) (put p Parser.pos (+ (get p Parser.pos) 1)))
    (let len:i32 (- (get p Parser.pos) start))
    (when (eq len 0) (return (call fail p start "missing group name")))
    (when (neq (call byte_ahead p 0) 62) (return (call fail p (get p Parser.pos) "missing >, unterminated name")))
    (let name:str (call str.from_bytes (call str.slice (get p Parser.b) start len)))
    (put p Parser.pos (+ (get p Parser.pos) 1))
    (let re:(ptr Regex) (get p Parser.re))
    (when (gte (call group_index re name) 0) (return (call fail p start "redefinition of group name")))
    (let k:i32 (+ (get re Regex.ngroups) 1))
    (put re Regex.ngroups k)
    (call (vec.push str) (get re Regex.names) name)
    (call (vec.push i32) (get re Regex.name_group) k)
    (call group_body p open k))

  ;; (?ims), only at the start of the pattern (after other flag groups)
  (fn flags_group [p:(ptr Parser) open:i32] -> i32
    (when (neq open (get p Parser.flags_end)) (return (call fail p open "global flags not at the start of the expression")))
    (while (neq (call peek p) 41)
      (let c:i32 (call peek p))
      (cond
        ((eq c 105) (put p Parser.icase true))
        ((eq c 109) (put p Parser.multi true))
        ((eq c 115) (put p Parser.dotall true))
        ((eq c 58) (return (call fail p open "scoped flags (?flags:...) are not supported")))
        (else (return (call fail p (get p Parser.pos) "unknown flag"))))
      (call advance p))
    (call advance p)
    (put p Parser.flags_end (get p Parser.pos))
    (call node p N_EMPTY 0 0 0 1))

  (fn is_word [c:i32] -> bool
    (or (or (and (gte c 65) (lte c 90)) (and (gte c 97) (lte c 122))) (or (call is_digit c) (eq c 95))))

  ;; the value of the n hex digits at the position (moving past them), or
  ;; -1 if there are fewer
  (fn read_hex [p:(ptr Parser) n:i32] -> i32
    (let v:i32 0)
    (for k 0 n
      (let d:i32 (call hex_value (call byte_ahead p k)))
      (when (lt d 0) (return -1))
      (set! v (+ (* v 16) d)))
    (put p Parser.pos (+ (get p Parser.pos) n))
    v)

  (fn hex_value [c:i32] -> i32
    (cond
      ((call is_digit c) (- c 48))
      ((and (gte c 97) (lte c 102)) (- c 87))
      ((and (gte c 65) (lte c 70)) (- c 55))
      (else -1)))

  ;; An escape's character after the '\' (moving past it), -2 for a class
  ;; escape (\d \w \s and their negations: its ranges added to the class
  ;; being built), or -1 after a failure. in_class: \b is a backspace.
  (fn escape_char [p:(ptr Parser) at:i32 in_class:bool] -> i32
    (let c:i32 (call peek p))
    (when (eq c -1) (return (call fail p at "bad escape (end of pattern)")))
    (call advance p)
    (cond
      ((eq c 100) (call add_set (get p Parser.re) 0 false) -2)
      ((eq c 68) (call add_set (get p Parser.re) 0 true) -2)
      ((eq c 119) (call add_set (get p Parser.re) 1 false) -2)
      ((eq c 87) (call add_set (get p Parser.re) 1 true) -2)
      ((eq c 115) (call add_set (get p Parser.re) 2 false) -2)
      ((eq c 83) (call add_set (get p Parser.re) 2 true) -2)
      ((eq c 110) 10)
      ((eq c 116) 9)
      ((eq c 114) 13)
      ((eq c 102) 12)
      ((eq c 118) 11)
      ((eq c 97) 7)
      ((and in_class (eq c 98)) 8)
      ((eq c 120)
       (let v:i32 (call read_hex p 2))
       (if (lt v 0) (call fail p at "incomplete escape \\x") v))
      ((eq c 117)
       (let u:i32 (call read_hex p 4))
       (if (lt u 0) (call fail p at "incomplete escape \\u") u))
      ((eq c 48) (if (call is_digit (call byte_ahead p 0)) (call fail p at "octal escapes are not supported") 0))
      ((call is_digit c) (call fail p at (if in_class "octal escapes are not supported" "backreferences are not supported")))
      ((call is_word c) (call fail p at "bad escape"))
      (else c)))

  ;; an escape outside a class
  (fn parse_escape [p:(ptr Parser)] -> i32
    (let at:i32 (get p Parser.pos))
    (call advance p)
    (let c:i32 (call peek p))
    (cond
      ((eq c 98) (call advance p) (call node p N_ASSERT WORD_EDGE 0 0 0))
      ((eq c 66) (call advance p) (call node p N_ASSERT NOT_EDGE 0 0 0))
      ((eq c 65) (call advance p) (call node p N_ASSERT AT_START 0 0 0))
      ((eq c 90) (call advance p) (call node p N_ASSERT AT_END 0 0 0))
      (else
        (let re:(ptr Regex) (get p Parser.re))
        (let start:i32 (call (vec.len i32) (get re Regex.lo)))
        (let ch:i32 (call escape_char p at false))
        (cond
          ((eq ch -2) (call node p N_CLASS (call end_class p start false) 0 0 0))
          ((lt ch 0) -1)
          (else (call node p N_LIT ch 0 0 0))))))

  ;; [...]
  (fn parse_class [p:(ptr Parser)] -> i32
    (let open:i32 (get p Parser.pos))
    (call advance p)
    (let re:(ptr Regex) (get p Parser.re))
    (let start:i32 (call (vec.len i32) (get re Regex.lo)))
    (let neg:bool false)
    (when (eq (call peek p) 94) (call advance p) (set! neg true))
    (let first:bool true)
    (while true
      (let c:i32 (call peek p))
      (when (eq c -1) (return (call fail p open "unterminated character set")))
      (when (and (eq c 93) (not first)) (call advance p) (break))
      (set! first false)
      (let item_at:i32 (get p Parser.pos))
      (let lo:i32 (call class_item p))
      (when (get p Parser.failed) (return -1))
      (let range:bool (and (eq (call peek p) 45) (and (neq (call byte_ahead p 1) 93) (neq (call byte_ahead p 1) -1))))
      (cond
        ((and range (eq lo -2)) (return (call fail p item_at "bad character range")))
        (range
          (call advance p)
          (let hi:i32 (call class_item p))
          (when (get p Parser.failed) (return -1))
          (when (or (eq hi -2) (lt hi lo)) (return (call fail p item_at "bad character range")))
          (call add_range re lo hi))
        ((gte lo 0) (call add_range re lo lo))
        (else (block))))
    (call node p N_CLASS (call end_class p start neg) 0 0 0))

  ;; one character of a class, or -2 for a class escape (its ranges added)
  (fn class_item [p:(ptr Parser)] -> i32
    (let at:i32 (get p Parser.pos))
    (let c:i32 (call peek p))
    (if (eq c 92)
        (block (call advance p) (call escape_char p at true))
        (block (call advance p) c)))

  (fn add_range [re:(ptr Regex) lo:i32 hi:i32] -> void
    (call (vec.push i32) (get re Regex.lo) lo)
    (call (vec.push i32) (get re Regex.hi) hi))

  ;; Adds \d (which = 0), \w (1), or \s (2), or with neg every character
  ;; not in it.
  (fn add_set [re:(ptr Regex) which:i32 neg:bool] -> void
    (let los:(arr i32) (arr.new i32 (get re Regex.a) 4))
    (let his:(arr i32) (arr.new i32 (get re Regex.a) 4))
    (let n:i32 0)
    (cond
      ((eq which 0) (arr.set i32 los 0 48) (arr.set i32 his 0 57) (set! n 1))
      ((eq which 1)
       (arr.set i32 los 0 48) (arr.set i32 his 0 57)
       (arr.set i32 los 1 65) (arr.set i32 his 1 90)
       (arr.set i32 los 2 95) (arr.set i32 his 2 95)
       (arr.set i32 los 3 97) (arr.set i32 his 3 122)
       (set! n 4))
      (else (arr.set i32 los 0 9) (arr.set i32 his 0 13) (arr.set i32 los 1 32) (arr.set i32 his 1 32) (set! n 2)))
    (if neg
        (block
          (let next:i32 0)
          (for k 0 n
            (when (lt next (arr.get i32 los k)) (call add_range re next (- (arr.get i32 los k) 1)))
            (set! next (+ (arr.get i32 his k) 1)))
          (call add_range re next 1114111))
        (for k 0 n (call add_range re (arr.get i32 los k) (arr.get i32 his k))))
    (call (alloc.free_array i32) (get re Regex.a) los)
    (call (alloc.free_array i32) (get re Regex.a) his))

  ;; Ends the class whose ranges start at index start: with (?i), adds the
  ;; other case of each ASCII letter in it; gives its number.
  (fn end_class [p:(ptr Parser) start:i32 neg:bool] -> i32
    (let re:(ptr Regex) (get p Parser.re))
    (let end:i32 (call (vec.len i32) (get re Regex.lo)))
    (when (get p Parser.icase)
      (for k start end
        (let lo:i32 (call (vec.at i32) (get re Regex.lo) k))
        (let hi:i32 (call (vec.at i32) (get re Regex.hi) k))
        ;; the part in A-Z, as a-z; the part in a-z, as A-Z
        (let ulo:i32 (if (gt lo 65) lo 65))
        (let uhi:i32 (if (lt hi 90) hi 90))
        (when (lte ulo uhi) (call add_range re (+ ulo 32) (+ uhi 32)))
        (let llo:i32 (if (gt lo 97) lo 97))
        (let lhi:i32 (if (lt hi 122) hi 122))
        (when (lte llo lhi) (call add_range re (- llo 32) (- lhi 32)))))
    (call (vec.push i32) (get re Regex.cstart) start)
    (call (vec.push i32) (get re Regex.ccount) (- (call (vec.len i32) (get re Regex.lo)) start))
    (call (vec.push i32) (get re Regex.cneg) (if neg 1 0))
    (- (call (vec.len i32) (get re Regex.cstart)) 1))

  ;; Appends an instruction; gives its index.
  (fn emit [p:(ptr Parser) op:i32 x:i32 y:i32] -> i32
    (let re:(ptr Regex) (get p Parser.re))
    (call (vec.push i32) (get re Regex.op) op)
    (call (vec.push i32) (get re Regex.x) x)
    (call (vec.push i32) (get re Regex.y) y)
    (let pc:i32 (- (call (vec.len i32) (get re Regex.op)) 1))
    (when (gt pc MAX_PROGRAM) (let _f:i32 (call fail p 0 "pattern too large")))
    pc)

  ;; An instruction that reads a character, going on at the next one.
  (fn emit_read [p:(ptr Parser) op:i32 x:i32] -> void
    (let _pc:i32 (call emit p op x (+ (call here p) 1))))

  (fn reads [op:i32] -> bool (lte op CLASS))

  (fn here [p:(ptr Parser)] -> i32 (call (vec.len i32) (get (get p Parser.re) Regex.op)))

  ;; Points the split at pc to body and out, body first if greedy.
  (fn patch_split [p:(ptr Parser) pc:i32 body:i32 out:i32 greedy:bool] -> void
    (let re:(ptr Regex) (get p Parser.re))
    (call (vec.set i32) (get re Regex.x) pc (if greedy body out))
    (call (vec.set i32) (get re Regex.y) pc (if greedy out body)))

  (fn compile_node [p:(ptr Parser) n:i32] -> void
    (when (get p Parser.failed) (return))
    (let k:i32 (call kind_of p n))
    (cond
      ((eq k N_EMPTY) (block))
      ((eq k N_LIT)
       (let c:i32 (call na p n))
       (cond
         ((and (get p Parser.icase) (and (gte c 65) (lte c 90))) (call emit_read p FOLD (+ c 32)))
         ((and (get p Parser.icase) (and (gte c 97) (lte c 122))) (call emit_read p FOLD c))
         (else (call emit_read p CHAR c))))
      ((eq k N_ANY) (call emit_read p (if (get p Parser.dotall) ANYNL ANY) 0))
      ((eq k N_CLASS) (call emit_read p CLASS (call na p n)))
      ((eq k N_ASSERT) (let _f:i32 (call emit p ASSERT (call na p n) 0)))
      ((eq k N_CAT) (call compile_node p (call na p n)) (call compile_node p (call nb p n)))
      ((eq k N_ALT)
       (let s:i32 (call emit p SPLIT 0 0))
       (call compile_node p (call na p n))
       (let j:i32 (call emit p JMP 0 0))
       (let second:i32 (call here p))
       (call compile_node p (call nb p n))
       (call patch_split p s (+ s 1) second true)
       (call (vec.set i32) (get (get p Parser.re) Regex.x) j (call here p)))
      ((eq k N_GROUP)
       (let g:i32 (call nb p n))
       (if (lt g 0)
           (call compile_node p (call na p n))
           (block
             (let _s:i32 (call emit p SAVE (* 2 g) 0))
             (call compile_node p (call na p n))
             (let _t:i32 (call emit p SAVE (+ (* 2 g) 1) 0)))))
      (else (call compile_repeat p n))))

  ;; x{m,n}: m copies, then n - m optional ones, each inside the last;
  ;; x* is (x+)?, and x+ is x then a split back to x's start. When x can
  ;; match the empty text, an optional pass of it that matches nothing
  ;; ends the loop (as in Python's matcher): each optional pass is then
  ;; two copies of x, one before it has read a character and one after
  ;; (reading one moves a thread from the first to the second), and the
  ;; first's end leaves the loop. The copies keep the machine exact: the
  ;; instruction a thread is at says all that its future depends on.
  (fn compile_repeat [p:(ptr Parser) n:i32] -> void
    (let child:i32 (call na p n))
    (let lo:i32 (call nb p n))
    (let hi:i32 (call nc p n))
    (let greedy:bool (eq (call nd p n) 1))
    (let re:(ptr Regex) (get p Parser.re))
    (cond
      ((not (call nullable p child))
       (if (lt hi 0)
           (block
             (let first:i32 -1)
             (when (eq lo 0) (set! first (call emit p SPLIT 0 0)))
             (for _i 1 lo (call compile_node p child))
             (let body:i32 (call here p))
             (call compile_node p child)
             (let back:i32 (call emit p SPLIT 0 0))
             (let out:i32 (call here p))
             (call patch_split p back body out greedy)
             (when (gte first 0) (call patch_split p first body out greedy)))
           (block
             (for _j 0 lo (call compile_node p child))
             (let splits:(ptr (vec.Vec i32)) (call (vec.make i32) (get re Regex.a) 8))
             (for _k lo hi
               (when (not (get p Parser.failed))
                 (call (vec.push i32) splits (call emit p SPLIT 0 0))
                 (call compile_node p child)))
             (let out:i32 (call here p))
             (for i 0 (call (vec.len i32) splits)
               (let s:i32 (call (vec.at i32) splits i))
               (call patch_split p s (+ s 1) out greedy))
             (call (vec.free i32) splits))))
      (else
        (for _m 0 lo (call compile_node p child))
        (let splits:(ptr (vec.Vec i32)) (call (vec.make i32) (get re Regex.a) 8))
        (let exits:(ptr (vec.Vec i32)) (call (vec.make i32) (get re Regex.a) 8))
        (let passes:i32 (if (lt hi 0) 1 (- hi lo)))
        (let top:i32 (call here p))
        (for _q 0 passes
          (when (not (get p Parser.failed))
            (call (vec.push i32) splits (call emit p SPLIT 0 0))
            (let fresh:i32 (call here p))
            (call compile_node p child)
            (call (vec.push i32) exits (call emit p JMP 0 0))
            (let moved:i32 (call here p))
            (call compile_node p child)
            (call promote p fresh (- moved 1) (- moved fresh))
            ;; with no limit, the pass after reading goes back for another
            (when (lt hi 0) (let _b:i32 (call emit p JMP top 0)))))
        (let out:i32 (call here p))
        (for i 0 (call (vec.len i32) splits)
          (let s:i32 (call (vec.at i32) splits i))
          (call patch_split p s (+ s 1) out greedy))
        (for i 0 (call (vec.len i32) exits) (call (vec.set i32) (get re Regex.x) (call (vec.at i32) exits i) out))
        (call (vec.free i32) splits)
        (call (vec.free i32) exits))))

  ;; Moves the instructions from..to that read a character to go on off
  ;; further along (into the copy after reading).
  (fn promote [p:(ptr Parser) from:i32 to:i32 off:i32] -> void
    (let re:(ptr Regex) (get p Parser.re))
    (for pc from to
      (when (call reads (call (vec.at i32) (get re Regex.op) pc))
        (call (vec.set i32) (get re Regex.y) pc (+ (call (vec.at i32) (get re Regex.y) pc) off)))))

  ;; Whether node n can match the empty text.
  (fn nullable [p:(ptr Parser) n:i32] -> bool
    (let k:i32 (call kind_of p n))
    (cond
      ((or (eq k N_EMPTY) (eq k N_ASSERT)) true)
      ((or (eq k N_LIT) (or (eq k N_ANY) (eq k N_CLASS))) false)
      ((eq k N_CAT) (and (call nullable p (call na p n)) (call nullable p (call nb p n))))
      ((eq k N_ALT) (or (call nullable p (call na p n)) (call nullable p (call nb p n))))
      ((eq k N_GROUP) (call nullable p (call na p n)))
      (else (or (eq (call nb p n) 0) (call nullable p (call na p n))))))

  ;; The literal text every match starts with (the leading characters of
  ;; the pattern's top sequence), so a search can skip to it with str.find.
  (fn find_prefix [p:(ptr Parser) root:i32] -> void
    (let re:(ptr Regex) (get p Parser.re))
    (let leftmost:i32 root)
    (while (eq (call kind_of p leftmost) N_CAT) (set! leftmost (call na p leftmost)))
    ;; walk back up: the leftmost node, then each CAT's right side in order
    (let chain:(ptr (vec.Vec i32)) (call (vec.make i32) (get re Regex.a) 8))
    (call collect p root chain)
    (let i:i32 0)
    (while (and (lt i (call (vec.len i32) chain)) (eq (call kind_of p (call (vec.at i32) chain i)) N_LIT))
      (call utf8.encode (get re Regex.prefix) (call na p (call (vec.at i32) chain i)))
      (set! i (+ i 1)))
    (call (vec.free i32) chain))

  ;; the items of a CAT tree, in order
  (fn collect [p:(ptr Parser) n:i32 out:(ptr (vec.Vec i32))] -> void
    (if (eq (call kind_of p n) N_CAT)
        (block (call collect p (call na p n) out) (call collect p (call nb p n) out))
        (call (vec.push i32) out n)))

  ;; ===== the machine =====

  (fn make_threads [a:alloc.Allocator nprog:i32 ncap:i32] -> (ptr Threads)
    (let t:(ptr Threads) (new Threads a [pcs:(arr.new i32 a nprog)
                                         caps:(arr.new i32 a (* nprog ncap))
                                         mark:(zero (arr i32))
                                         count:(zero i32)
                                         gen:(zero i32)]))
    (let mark:(arr i32) (arr.new i32 a nprog))
    (for i 0 nprog (arr.set i32 mark i -1))
    (put t Threads.mark mark)
    (put t Threads.count 0)
    (put t Threads.gen 0)
    t)

  (fn free_threads [a:alloc.Allocator t:(ptr Threads)] -> void
    (call (alloc.free_array i32) a (get t Threads.pcs))
    (call (alloc.free_array i32) a (get t Threads.caps))
    (call (alloc.free_array i32) a (get t Threads.mark))
    (call (alloc.destroy Threads) a t))

  (fn make_machine [re:(ptr Regex)] -> void
    (let a:alloc.Allocator (get re Regex.a))
    (let nprog:i32 (call (vec.len i32) (get re Regex.op)))
    (let ncap:i32 (call ncap re))
    (put re Regex.cur (call make_threads a nprog ncap))
    (put re Regex.nxt (call make_threads a nprog ncap))
    (put re Regex.scratch (arr.new i32 a ncap))
    (put re Regex.found (arr.new i32 a ncap))
    (put re Regex.ready true))

  (fn ncap [re:(ptr Regex)] -> i32 (* 2 (+ (get re Regex.ngroups) 1)))

  ;; Empties t for a new position.
  (fn clear [t:(ptr Threads)] -> void
    (put t Threads.count 0)
    (let gen:i32 (+ (get t Threads.gen) 1))
    ;; start the marks over long before the count could wrap
    (when (gt gen 1000000000)
      (let mark:(arr i32) (get t Threads.mark))
      (for i 0 (arr.len mark) (arr.set i32 mark i -1))
      (set! gen 0))
    (put t Threads.gen gen))

  ;; Whether byte i of text is a word byte (false outside the text).
  (fn word_at [text:str.Bytes i:i32] -> bool
    (and (and (gte i 0) (lt i (get text str.Bytes.len))) (call is_word (call str.byte_at text i))))

  (fn holds [kind:i32 text:str.Bytes pos:i32] -> bool
    (let n:i32 (get text str.Bytes.len))
    (cond
      ((eq kind AT_START) (eq pos 0))
      ((eq kind AT_END) (eq pos n))
      ((eq kind LINE_START) (or (eq pos 0) (eq (call str.byte_at text (- pos 1)) 10)))
      ((eq kind LINE_END) (or (eq pos n) (eq (call str.byte_at text pos) 10)))
      ((eq kind END_OR_NL) (or (eq pos n) (and (eq pos (- n 1)) (eq (call str.byte_at text pos) 10))))
      ((eq kind WORD_EDGE) (neq (call word_at text (- pos 1)) (call word_at text pos)))
      (else (eq (call word_at text (- pos 1)) (call word_at text pos)))))

  ;; Adds the thread at pc, at position pos with the captures caps, to t,
  ;; following jumps, splits (in preference order), saves, and assertions
  ;; first: t gets only the instructions that read a character, and
  ;; MATCH. A pc already on t is not added again (the thread there came
  ;; first, so it is preferred).
  (fn add [re:(ptr Regex) t:(ptr Threads) pc:i32 pos:i32 caps:(arr i32) text:str.Bytes] -> void
    (let mark:(arr i32) (get t Threads.mark))
    (when (eq (arr.get i32 mark pc) (get t Threads.gen)) (return))
    (arr.set i32 mark pc (get t Threads.gen))
    (let op:i32 (call (vec.at i32) (get re Regex.op) pc))
    (let x:i32 (call (vec.at i32) (get re Regex.x) pc))
    (cond
      ((eq op JMP) (call add re t x pos caps text))
      ((eq op SPLIT)
       (call add re t x pos caps text)
       (call add re t (call (vec.at i32) (get re Regex.y) pc) pos caps text))
      ((eq op SAVE)
       (let old:i32 (arr.get i32 caps x))
       (arr.set i32 caps x pos)
       (call add re t (+ pc 1) pos caps text)
       (arr.set i32 caps x old))
      ((eq op ASSERT) (when (call holds x text pos) (call add re t (+ pc 1) pos caps text)))
      (else
        (let k:i32 (get t Threads.count))
        (arr.set i32 (get t Threads.pcs) k pc)
        (let ncap:i32 (arr.len caps))
        (let all:(arr i32) (get t Threads.caps))
        (for i 0 ncap (arr.set i32 all (+ (* k ncap) i) (arr.get i32 caps i)))
        (put t Threads.count (+ k 1)))))

  ;; Whether the character c is in class k.
  (fn in_class [re:(ptr Regex) k:i32 c:i32] -> bool
    (let start:i32 (call (vec.at i32) (get re Regex.cstart) k))
    (let found:bool false)
    (for i start (+ start (call (vec.at i32) (get re Regex.ccount) k))
      (when (and (gte c (call (vec.at i32) (get re Regex.lo) i)) (lte c (call (vec.at i32) (get re Regex.hi) i))) (set! found true)))
    (neq found (eq (call (vec.at i32) (get re Regex.cneg) k) 1)))

  (fn ascii_lower [c:i32] -> i32 (if (and (gte c 65) (lte c 90)) (+ c 32) c))

  ;; Searches text from byte from for the leftmost match (the one a
  ;; backtracking matcher would find first); whether there is one, its
  ;; groups then in re's found. must_advance: not an empty match at from
  ;; (Python's rule for the match after an empty one). first: stop at the
  ;; first match seen (for is_match; its groups are not the preferred).
  (fn search [re:(ptr Regex) text:str.Bytes from:i32 must_advance:bool first:bool] -> bool
    (let n:i32 (get text str.Bytes.len))
    (let cur:(ptr Threads) (get re Regex.cur))
    (let nxt:(ptr Threads) (get re Regex.nxt))
    (let scratch:(arr i32) (get re Regex.scratch))
    (let found:(arr i32) (get re Regex.found))
    (let ncap:i32 (arr.len scratch))
    (let prefix:str.Bytes (get re Regex.lit))
    (let skip:bool (gt (get prefix str.Bytes.len) 0))
    (call clear cur)
    (let matched:bool false)
    (let p:i32 from)
    (let done:bool false)
    (while (not done)
      (when (not matched)
        (when (and skip (eq (get cur Threads.count) 0))
          (let q:i32 (call str.find_from text prefix p))
          (if (lt q 0)
              (set! done true)
              (when (gt q p) (set! p q) (call clear cur))))
        (when (not done)
          (for i 0 ncap (arr.set i32 scratch i -1))
          (call add re cur 0 p scratch text)))
      (when (and matched (eq (get cur Threads.count) 0)) (set! done true))
      (when (not done)
        (let cp:i32 -1)
        (let width:i32 1)
        (when (lt p n)
          (let ch:utf8.Char (call utf8.decode text p))
          (if (eq (get ch utf8.Char.len) 0)
              (set! cp 65533)
              (block (set! cp (get ch utf8.Char.cp)) (set! width (get ch utf8.Char.len)))))
        (call clear nxt)
        (let i:i32 0)
        (let all:(arr i32) (get cur Threads.caps))
        (while (lt i (get cur Threads.count))
          (let pc:i32 (arr.get i32 (get cur Threads.pcs) i))
          (let op:i32 (call (vec.at i32) (get re Regex.op) pc))
          (let x:i32 (call (vec.at i32) (get re Regex.x) pc))
          (if (eq op MATCH)
              (block
                (let start:i32 (arr.get i32 all (* i ncap)))
                (if (and must_advance (and (eq start from) (eq p from)))
                    (set! i (+ i 1))
                    (block
                      (for k 0 ncap (arr.set i32 found k (arr.get i32 all (+ (* i ncap) k))))
                      (set! matched true)
                      (when first (set! done true))
                      ;; the threads after this one are less preferred: drop them
                      (set! i (get cur Threads.count)))))
              (block
                (let ok:bool
                  (cond
                    ((lt cp 0) false)
                    ((eq op CHAR) (eq cp x))
                    ((eq op FOLD) (eq (call ascii_lower cp) x))
                    ((eq op ANY) (neq cp 10))
                    ((eq op ANYNL) true)
                    (else (call in_class re x cp))))
                (when ok
                  (for k 0 ncap (arr.set i32 scratch k (arr.get i32 all (+ (* i ncap) k))))
                  (call add re nxt (call (vec.at i32) (get re Regex.y) pc) (+ p width) scratch text))
                (set! i (+ i 1)))))
        (let t:(ptr Threads) cur)
        (set! cur nxt)
        (set! nxt t)
        (if (gte p n) (set! done true) (set! p (+ p width)))))
    (put re Regex.cur cur)
    (put re Regex.nxt nxt)
    matched)

  ;; ===== searching =====

  ;; Whether text has a match.
  (fn is_match [re:(ptr Regex) text:str.Bytes] -> bool (pub)
    (call search re text 0 false true))

  ;; The leftmost match, if any.
  (fn find [re:(ptr Regex) text:str.Bytes] -> (option.Option Span) (pub)
    (call find_at re text 0))

  ;; The leftmost match starting at byte start or later (^, \b, and the
  ;; like still see the text before start).
  (fn find_at [re:(ptr Regex) text:str.Bytes start:i32] -> (option.Option Span) (pub)
    (req (and (gte start 0) (lte start (get text str.Bytes.len))))
    (if (call search re text start false false)
        (make (option.Option Span) some (make Span [start:(arr.get i32 (get re Regex.found) 0)
                                                    end:(arr.get i32 (get re Regex.found) 1)]))
        (make (option.Option Span) none)))

  ;; The leftmost match's groups, from a (free_captures), if there is a
  ;; match.
  (fn captures [a:alloc.Allocator re:(ptr Regex) text:str.Bytes] -> (option.Option (ptr Captures)) (pub)
    (when (not (call search re text 0 false false)) (return (make (option.Option (ptr Captures)) none)))
    (let ncap:i32 (call ncap re))
    (let c:(ptr Captures) (new Captures a [spans:(arr.new i32 a ncap) n:(/ ncap 2) a:a]))
    (let spans:(arr i32) (get c Captures.spans))
    (for i 0 ncap (arr.set i32 spans i (arr.get i32 (get re Regex.found) i)))
    (make (option.Option (ptr Captures)) some c))

  ;; Group i's span (0: the whole match), or none if it took no part.
  (fn group [c:(ptr Captures) i:i32] -> (option.Option Span) (pub)
    (req (and (gte i 0) (lt i (get c Captures.n))))
    (let s:i32 (arr.get i32 (get c Captures.spans) (* 2 i)))
    (if (lt s 0)
        (make (option.Option Span) none)
        (make (option.Option Span) some (make Span [start:s
                                                    end:(arr.get i32 (get c Captures.spans) (+ (* 2 i) 1))]))))

  ;; Frees the captures.
  (fn free_captures [c:(ptr Captures)] -> void (pub)
    (call (alloc.free_array i32) (get c Captures.a) (get c Captures.spans))
    (call (alloc.destroy Captures) (get c Captures.a) c))

  ;; Moves on from a match ending at end: the next search starts there, and
  ;; after an empty match may not be empty there (Python's re.finditer).
  (fn after [re:(ptr Regex)] -> i32 (arr.get i32 (get re Regex.found) 1))
  (fn was_empty [re:(ptr Regex)] -> bool (eq (arr.get i32 (get re Regex.found) 0) (arr.get i32 (get re Regex.found) 1)))

  ;; Every match, left to right, not overlapping, as a new vector from a
  ;; (Python's re.finditer: an empty match may follow a match, and the
  ;; match after an empty one is not empty at the same place).
  (fn find_all [a:alloc.Allocator re:(ptr Regex) text:str.Bytes] -> (ptr (vec.Vec Span)) (pub)
    (let out:(ptr (vec.Vec Span)) (call (vec.make Span) a 8))
    (let pos:i32 0)
    (let must:bool false)
    (while (call search re text pos must false)
      (call (vec.push Span) out (make Span [start:(arr.get i32 (get re Regex.found) 0)
                                            end:(arr.get i32 (get re Regex.found) 1)]))
      (set! must (call was_empty re))
      (set! pos (call after re)))
    out)

  ;; The text between the matches (as find_all finds them), as slices of
  ;; text in a new vector from a. (Python's re.split also gives each
  ;; group's text between them; this does not.)
  (fn split [a:alloc.Allocator re:(ptr Regex) text:str.Bytes] -> (ptr (vec.Vec str.Bytes)) (pub)
    (let out:(ptr (vec.Vec str.Bytes)) (call (vec.make str.Bytes) a 8))
    (let pos:i32 0)
    (let prev:i32 0)
    (let must:bool false)
    (while (call search re text pos must false)
      (let s:i32 (arr.get i32 (get re Regex.found) 0))
      (call (vec.push str.Bytes) out (call str.slice text prev (- s prev)))
      (set! prev (call after re))
      (set! must (call was_empty re))
      (set! pos (call after re)))
    (call (vec.push str.Bytes) out (call str.slice text prev (- (get text str.Bytes.len) prev)))
    out)

  ;; text with each match (as find_all finds them) replaced by template,
  ;; in which $1 (or ${1}) is group 1's text, $name (or ${name}) a named
  ;; group's, $0 the match's, and $$ a '$'; a group that took no part is
  ;; empty. A template naming no group the pattern has is an error.
  (fn replace_all [re:(ptr Regex) text:str.Bytes template:str] -> (result str (ptr Error)) (pub)
    (let a:alloc.Allocator (get re Regex.a))
    (let o:(ptr buf.Buf) (call buf.make a (+ (get text str.Bytes.len) 16)))
    (let tb:str.Bytes (call str.from_str template))
    ;; check the template before using it
    (let bad:(ptr Error) (call expand re tb text o false))
    (when (neq bad (ptr.null Error)) (call buf.free o) (return (err:str bad)))
    (let pos:i32 0)
    (let prev:i32 0)
    (let must:bool false)
    (while (call search re text pos must false)
      (let s:i32 (arr.get i32 (get re Regex.found) 0))
      (call buf.push_bytes o (call str.slice text prev (- s prev)))
      (let _e:(ptr Error) (call expand re tb text o true))
      (set! prev (call after re))
      (set! must (call was_empty re))
      (set! pos (call after re)))
    (call buf.push_bytes o (call str.slice text prev (- (get text str.Bytes.len) prev)))
    (let replaced:str (call buf.to_str o))
    (call buf.free o)
    (ok:(ptr Error) replaced))

  ;; Appends the template with re's found groups put in (when write), or
  ;; only checks it: the error, or ptr.null.
  (fn expand [re:(ptr Regex) tb:str.Bytes text:str.Bytes o:(ptr buf.Buf) write:bool] -> (ptr Error)
    (let n:i32 (get tb str.Bytes.len))
    (let i:i32 0)
    (while (lt i n)
      (let c:i32 (call str.byte_at tb i))
      (if (neq c 36)
          (block (when write (call buf.push_byte o c)) (set! i (+ i 1)))
          (block
            (let at:i32 i)
            (set! i (+ i 1))
            (let braced:bool (and (lt i n) (eq (call str.byte_at tb i) 123)))
            (when braced (set! i (+ i 1)))
            (let start:i32 i)
            (cond
              ((and (not braced) (and (lt i n) (eq (call str.byte_at tb i) 36)))
               (when write (call buf.push_byte o 36))
               (set! i (+ i 1)))
              (else
                (while (and (lt i n) (call is_word (call str.byte_at tb i))) (set! i (+ i 1)))
                (let name:str.Bytes (call str.slice tb start (- i start)))
                (when (eq (get name str.Bytes.len) 0) (return (call template_error re at "a $ in the template names no group (write $$ for a $)")))
                (when braced
                  (when (or (gte i n) (neq (call str.byte_at tb i) 125)) (return (call template_error re at "missing } in the template")))
                  (set! i (+ i 1)))
                (let g:i32 (call group_number re name))
                (when (lt g 0) (return (call template_error re at "the template names a group the pattern does not have")))
                (when write
                  (let gs:i32 (arr.get i32 (get re Regex.found) (* 2 g)))
                  (when (gte gs 0)
                    (call buf.push_bytes o (call str.slice text gs (- (arr.get i32 (get re Regex.found) (+ (* 2 g) 1)) gs))))))))))
    (ptr.null Error))

  ;; The group a template names (digits: by number), or -1.
  (fn group_number [re:(ptr Regex) name:str.Bytes] -> i32
    (let all_digits:bool true)
    (for k 0 (get name str.Bytes.len) (when (not (call is_digit (call str.byte_at name k))) (set! all_digits false)))
    (if all_digits
        (block
          (let v:i32 0)
          (for k 0 (get name str.Bytes.len)
            (set! v (+ (* v 10) (- (call str.byte_at name k) 48)))
            (when (gt v (get re Regex.ngroups)) (return -1)))
          v)
        (call group_index re (call str.from_bytes name))))

  (fn template_error [re:(ptr Regex) at:i32 what:str] -> (ptr Error)
    (let e:(ptr Error) (new Error (get re Regex.a) [at:at what:what]))
    e))
