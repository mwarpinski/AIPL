;; std/str: byte slices and byte-level text functions. Every function is plain
;; AIPL over mem.* and str.*, so it behaves the same in the VM and compiled.
(module str
  (import option)
  ;; A view of len bytes, a value (nothing is allocated to make one, and
  ;; nothing to free). A checked view reads bytes start .. start + len - 1
  ;; of the array data, so a view of memory that has been freed stops the
  ;; program ("Use after free") as a pointer would. A view made by the
  ;; unsafe bytes has no array (data is null) and reads the memory at the
  ;; address start, unchecked: for memory that is never freed (literals,
  ;; mem.alloc) or that the caller vouches for. A failed read has len -1.
  (struct Bytes [(read data:(arr u8)) (read start:i32) (read len:i32)] (value) (pub))

  ;; A view of len bytes at the address addr, unchecked. Unsafe to call:
  ;; the memory is the caller's word.
  (fn bytes [addr:i32 len:i32] -> Bytes (pub) (unsafe)
    (make Bytes [data:(arr.null u8) start:addr len:len]))

  ;; A checked view of bytes start .. start + len - 1 of a.
  (fn of_array [a:(arr u8) start:i32 len:i32] -> Bytes (pub)
    (req (and (gte start 0) (and (gte len 0) (lte (+ start len) (arr.len a)))))
    (make Bytes [data:a start:start len:len]))

  ;; Whether b is checked (it has an array; see Bytes).
  (fn checked [b:Bytes] -> bool (pub) (neq (get b Bytes.data) (arr.null u8)))

  ;; The address of b's first byte, for mem.* in unsafe code. A checked
  ;; view's array is checked here (a freed one stops the program), so a
  ;; loop that frees nothing may read through the address after.
  (fn addr [b:Bytes] -> i32 (pub)
    (if (call checked b)
        (block
          (let _n:i32 (arr.len (get b Bytes.data)))
          (+ (arr.addr (get b Bytes.data)) (get b Bytes.start)))
        (get b Bytes.start)))

  ;; The view that stands for no text where one may be missing (len -1, as
  ;; a failed read is).
  (fn absent [] -> Bytes (pub) (make Bytes [data:(arr.null u8) start:0 len:-1]))
  ;; Whether b is text (empty or not), not absent.
  (fn present [b:Bytes] -> bool (pub) (gte (get b Bytes.len) 0))

  ;; The bytes of a string, viewed in place (a str is never freed).
  (fn from_str [s:str] -> Bytes (pub)
    (unsafe (call bytes (str.ptr s) (str.len s))))

  ;; Byte i of b (0-255); i must be in range.
  (fn byte_at [b:Bytes i:i32] -> i32 (pub)
    (req (and (gte i 0) (lt i (get b Bytes.len))))
    (let d:(arr u8) (get b Bytes.data))
    (if (eq d (arr.null u8))
        (unsafe (mem.load8 (+ (get b Bytes.start) i)))
        (arr.get u8 d (+ (get b Bytes.start) i))))

  ;; Bytes start .. start + len - 1 of b, as a view of the same memory
  ;; (a value: nothing is allocated).
  (fn slice [b:Bytes start:i32 len:i32] -> Bytes (pub)
    (req (and (gte start 0) (and (gte len 0) (lte (+ start len) (get b Bytes.len)))))
    (make Bytes [data:(get b Bytes.data) start:(+ (get b Bytes.start) start) len:len]))

  ;; Sets byte i of b to c (its low 8 bits).
  (fn set_byte [b:Bytes i:i32 c:i32] -> void (pub)
    (req (and (gte i 0) (lt i (get b Bytes.len))))
    (if (call checked b)
        (arr.set u8 (get b Bytes.data) (+ (get b Bytes.start) i) c)
        (unsafe (mem.store8 (+ (get b Bytes.start) i) c))))

  ;; ASCII whitespace: space, \t \n \v \f \r.
  (fn is_space [c:i32] -> bool (pub)
    (or (eq c 32) (and (gte c 9) (lte c 13))))

  ;; Whether a and b hold the same bytes.
  (fn bytes_eq [a:Bytes b:Bytes] -> bool (pub)
    (when (neq (get a Bytes.len) (get b Bytes.len)) (return false))
    ;; each view checked once (addr), then a loop that frees nothing
    (unsafe (let pa:i32 (call addr a))
    (let pb:i32 (call addr b))
    (for i 0 (get a Bytes.len)
      (when (neq (mem.load8 (+ pa i)) (mem.load8 (+ pb i))) (return false)))
    true))

  ;; Whether b spells the literal s, without allocating.
  (fn is [b:Bytes s:str] -> bool (pub)
    (unsafe (when (neq (get b Bytes.len) (str.len s)) (return false))
    (let pb:i32 (call addr b))
    (for i 0 (get b Bytes.len)
      (when (neq (mem.load8 (+ pb i)) (mem.load8 (+ (str.ptr s) i))) (return false)))
    true))

  ;; Whether b holds the bytes of s at index i (false if they would run
  ;; past its end), without allocating.
  (fn is_at [b:Bytes i:i32 s:str] -> bool (pub)
    (unsafe (when (or (lt i 0) (gt (+ i (str.len s)) (get b Bytes.len))) (return false))
    (for k 0 (str.len s)
      (when (neq (call byte_at b (+ i k)) (mem.load8 (+ (str.ptr s) k))) (return false)))
    true))

;; ===== Searching and trimming =====
  ;; Nothing here allocates but the slices it returns (std/text has the
  ;; functions that build). Searches take linear time in constant space: a
  ;; needle of up to 64 bytes is compared where its first byte matches, a
  ;; longer one by the Two-Way algorithm (Crochemore and Perrin; as musl's
  ;; memmem, without its shift table).

  ;; Whether b's bytes from i are p's (i + |p| <= |b|).
  (fn at_is [b:Bytes p:Bytes i:i32] -> bool
    (unsafe (let ba:i32 (+ (call addr b) i))
    (let pa:i32 (call addr p))
    (for k 0 (get p Bytes.len)
      (when (neq (mem.load8 (+ ba k)) (mem.load8 (+ pa k))) (return false)))
    true))

  ;; Whether b begins with p.
  (fn starts_with [b:Bytes p:Bytes] -> bool (pub)
    (and (lte (get p Bytes.len) (get b Bytes.len)) (call at_is b p 0)))

  ;; Whether b ends with p.
  (fn ends_with [b:Bytes p:Bytes] -> bool (pub)
    (and (lte (get p Bytes.len) (get b Bytes.len)) (call at_is b p (- (get b Bytes.len) (get p Bytes.len)))))

  ;; The first index at or after `from` where p occurs in b, or -1 (an
  ;; empty p occurs at `from`).
  (fn find_from [b:Bytes p:Bytes from:i32] -> i32 (pub)
    (req (and (gte from 0) (lte from (get b Bytes.len))))
    (let n:i32 (get b Bytes.len))
    (let m:i32 (get p Bytes.len))
    (when (eq m 0) (return from))
    (when (gt m 64) (return (call two_way b p from false)))
    (unsafe (let ba:i32 (call addr b))
    (let first:i32 (mem.load8 (call addr p)))
    (for i from (+ (- n m) 1)
      (when (and (eq (mem.load8 (+ ba i)) first) (call at_is b p i)) (return i)))
    -1))

  ;; The first index where p occurs in b, or -1.
  (fn find [b:Bytes p:Bytes] -> i32 (pub) (call find_from b p 0))

  ;; Whether p occurs in b.
  (fn contains [b:Bytes p:Bytes] -> bool (pub) (gte (call find b p) 0))

  ;; The last index where p occurs in b, or -1 (an empty p: b's length).
  (fn rfind [b:Bytes p:Bytes] -> i32 (pub)
    (let n:i32 (get b Bytes.len))
    (let m:i32 (get p Bytes.len))
    (when (eq m 0) (return n))
    (when (gt m 64)
          ;; the first match in the reversed bytes is the last one
          (let r:i32 (call two_way b p 0 true))
          (return (if (lt r 0) -1 (- (- n m) r))))
    (for j 0 (+ (- n m) 1)
      (let i:i32 (- (- n m) j))
      (when (call at_is b p i) (return i)))
    -1)

  ;; Byte i of x, or of x reversed (rev).
  (fn nth [x:Bytes i:i32 rev:bool] -> i32
    (unsafe (mem.load8 (+ (call addr x) (if rev (- (- (get x Bytes.len) 1) i) i)))))

  ;; The first index at or after `from` where p occurs in h (reversed:
  ;; both read backwards, and the index counts from h's end), or -1. p has
  ;; at least two bytes. The needle is cut at its critical factorization
  ;; (from the two maximal suffixes); the right part is matched left to
  ;; right, then the left part right to left; a mismatch shifts by the
  ;; distance matched, or by the period, remembering the prefix a periodic
  ;; needle shares with itself (mem).
  (fn two_way [h:Bytes p:Bytes from:i32 rev:bool] -> i32
    (let l:i32 (get p Bytes.len))
    (let n:i32 (get h Bytes.len))
    ;; the maximal suffix for <, then for >
    (let ip:i32 -1)
    (let jp:i32 0)
    (let k:i32 1)
    (let per:i32 1)
    (while (lt (+ jp k) l)
      (let a:i32 (call nth p (+ ip k) rev))
      (let c:i32 (call nth p (+ jp k) rev))
      (cond
        ((eq a c) (if (eq k per) (block (set! jp (+ jp per)) (set! k 1)) (set! k (+ k 1))))
        ((gt a c) (set! jp (+ jp k)) (set! k 1) (set! per (- jp ip)))
        (else (set! ip jp) (set! jp (+ jp 1)) (set! k 1) (set! per 1))))
    (let ms:i32 ip)
    (let p0:i32 per)
    (set! ip -1) (set! jp 0) (set! k 1) (set! per 1)
    (while (lt (+ jp k) l)
      (let a:i32 (call nth p (+ ip k) rev))
      (let c:i32 (call nth p (+ jp k) rev))
      (cond
        ((eq a c) (if (eq k per) (block (set! jp (+ jp per)) (set! k 1)) (set! k (+ k 1))))
        ((lt a c) (set! jp (+ jp k)) (set! k 1) (set! per (- jp ip)))
        (else (set! ip jp) (set! jp (+ jp 1)) (set! k 1) (set! per 1))))
    (if (gt (+ ip 1) (+ ms 1)) (set! ms ip) (set! per p0))
    ;; periodic: the needle's first ms+1 bytes recur after one period
    (let periodic:bool true)
    (for i 0 (+ ms 1)
      (when (neq (call nth p i rev) (call nth p (+ i per) rev)) (set! periodic false)))
    (let mem0:i32 0)
    (if periodic
        (set! mem0 (- l per))
        (set! per (+ (if (gt ms (- (- l ms) 1)) ms (- (- l ms) 1)) 1)))
    (let mem:i32 0)
    (let pos:i32 from)
    (while (lte (+ pos l) n)
      ;; the right part, left to right
      (let j:i32 (if (gt (+ ms 1) mem) (+ ms 1) mem))
      (while (and (lt j l) (eq (call nth p j rev) (call nth h (+ pos j) rev))) (set! j (+ j 1)))
      (if (lt j l)
          (block (set! pos (+ pos (- j ms))) (set! mem 0))
          (block
            ;; the left part, right to left
            (let q:i32 (+ ms 1))
            (while (and (gt q mem) (eq (call nth p (- q 1) rev) (call nth h (+ pos (- q 1)) rev))) (set! q (- q 1)))
            (when (lte q mem) (return pos))
            (set! pos (+ pos per))
            (set! mem mem0))))
    -1)

  ;; How many times p occurs in b, not overlapping, from the left.
  (fn count [b:Bytes p:Bytes] -> i32 (pub)
    (req (gt (get p Bytes.len) 0))
    (let k:i32 0)
    (let i:i32 (call find_from b p 0))
    (while (gte i 0)
      (set! k (+ k 1))
      (let next:i32 (+ i (get p Bytes.len)))
      (set! i (if (lte next (get b Bytes.len)) (call find_from b p next) -1)))
    k)

  ;; b without its leading, trailing, or both runs of ASCII whitespace.
  (fn trim_start [b:Bytes] -> Bytes (pub)
    (let i:i32 0)
    (while (and (lt i (get b Bytes.len)) (call is_space (call byte_at b i))) (set! i (+ i 1)))
    (call slice b i (- (get b Bytes.len) i)))

  ;; b without trailing ASCII whitespace (a view).
  (fn trim_end [b:Bytes] -> Bytes (pub)
    (let n:i32 (get b Bytes.len))
    (while (and (gt n 0) (call is_space (call byte_at b (- n 1)))) (set! n (- n 1)))
    (call slice b 0 n))

  ;; b without leading or trailing ASCII whitespace (a view).
  (fn trim [b:Bytes] -> Bytes (pub) (call trim_end (call trim_start b)))

  ;; The text before and after the first sep.
  (struct Halves [(read before:Bytes) (read after:Bytes)] (value) (pub))

  ;; The text before and after the first sep in b, or none if sep does
  ;; not occur.
  (fn split_once [b:Bytes sep:Bytes] -> (option.Option Halves) (pub)
    (req (gt (get sep Bytes.len) 0))
    (let i:i32 (call find b sep))
    (when (lt i 0) (return (make (option.Option Halves) none)))
    (let j:i32 (+ i (get sep Bytes.len)))
    (make (option.Option Halves) some (make Halves [before:(call slice b 0 i)
                                                    after:(call slice b j (- (get b Bytes.len) j))])))

  ;; Whether a and b are equal but for the case of ASCII letters.
  (fn eq_ignore_case [a:Bytes b:Bytes] -> bool (pub)
    (when (neq (get a Bytes.len) (get b Bytes.len)) (return false))
    (for i 0 (get a Bytes.len)
      (when (neq (call lower (call byte_at a i)) (call lower (call byte_at b i))) (return false)))
    true)

  (fn lower [c:i32] -> i32 (if (and (gte c 65) (lte c 90)) (+ c 32) c))

  ;; Byte order: -1, 0, or 1 (a prefix first).
  (fn cmp [a:Bytes b:Bytes] -> i32 (pub)
    (let n:i32 (if (lt (get a Bytes.len) (get b Bytes.len)) (get a Bytes.len) (get b Bytes.len)))
    (let pa:i32 (call addr a))
    (let pb:i32 (call addr b))
    (for i 0 n
      (let x:i32 (unsafe (mem.load8 (+ pa i))))
      (let y:i32 (unsafe (mem.load8 (+ pb i))))
      (when (lt x y) (return -1))
      (when (gt x y) (return 1)))
    (cond ((lt (get a Bytes.len) (get b Bytes.len)) -1) ((gt (get a Bytes.len) (get b Bytes.len)) 1) (else 0)))

  ;; b as a decimal i64: an optional sign, then digits; or (err i), the
  ;; index of the first byte that is not a digit, or of the digit past which
  ;; the value no longer fits.
  (fn parse_i64 [b:Bytes] -> (result i64 i32) (pub)
    (let n:i32 (get b Bytes.len))
    (let c0:i32 (if (gt n 0) (call byte_at b 0) 0))
    (let neg:bool (eq c0 45))
    (let start:i32 (if (or neg (eq c0 43)) 1 0))
    (when (lte n start) (return (err:i64 n)))
    ;; built negative, which reaches the lowest i64
    (let v:i64 0i64)
    (for i start n
      (let c:i32 (call byte_at b i))
      (when (or (lt c 48) (gt c 57)) (return (err:i64 i)))
      (let d:i64 (i64.extend_s (- c 48)))
      (when (lt v -922337203685477580i64) (return (err:i64 i)))
      (when (and (eq v -922337203685477580i64) (gt d 8i64)) (return (err:i64 i)))
      (set! v (- (* v 10i64) d)))
    (if neg
        (ok:i32 v)
        (if (eq v -9223372036854775808i64) (err:i64 (- n 1)) (ok:i32 (- 0i64 v)))))

  ;; "true" or "false"; else (err 0).
  (fn parse_bool [b:Bytes] -> (result bool i32) (pub)
    (cond ((call is b "true") (ok:i32 true)) ((call is b "false") (ok:i32 false)) (else (err:bool 0))))

;; ===== Making strings (AIPL_SPEC.md 4.B) =====
  ;; A str made at run time is a copy, never freed: it has no generation for
  ;; a use to be checked against, so its memory (from mem.alloc) stays for
  ;; the rest of the run. Make one from finished text; to build text in a
  ;; loop, push onto a std/buf and make the str once, at the end.

  ;; Whether a and b hold the same bytes. (eq on str is an error: it would
  ;; compare addresses compiled and contents in the VM.)
  (fn same [a:str b:str] -> bool (pub)
    (unsafe (when (neq (str.len a) (str.len b)) (return false))
    (let pa:i32 (str.ptr a))
    (let pb:i32 (str.ptr b))
    (for i 0 (str.len a)
      (when (neq (mem.load8 (+ pa i)) (mem.load8 (+ pb i))) (return false)))
    true))

  ;; A str holding a copy of b's bytes, which must be UTF-8 (check untrusted
  ;; input with valid_utf8 first).
  (fn from_bytes [b:Bytes] -> str (pub)
    (req (call valid_utf8 b))
    (unsafe (let s:i32 (call room (get b Bytes.len)))
    (call copy s (call addr b) (get b Bytes.len))
    (call at s)))

  ;; a followed by b, as a new str.
  (fn concat [a:str b:str] -> str (pub)
    (unsafe (let s:i32 (call room (+ (str.len a) (str.len b))))
    (call copy s (str.ptr a) (str.len a))
    (call copy (+ s (str.len a)) (str.ptr b) (str.len b))
    (call at s)))

  ;; Never-freed room for a str of n bytes: [the str's address][n][bytes].
  ;; Returns the bytes' address. Unsafe to call: the caller fills them.
  (fn room [n:i32] -> i32 (unsafe)
    (unsafe (let base:i32 (mem.alloc (+ n 8)))
    (mem.store32 base (+ base 8))
    (mem.store32 (+ base 4) n)
    (+ base 8)))

  (fn copy [to:i32 from:i32 n:i32] -> void (unsafe)
    (unsafe (for i 0 n (mem.store8 (+ to i) (mem.load8 (+ from i))))))

  ;; The str whose bytes room returned at s: the word before its length
  ;; holds its address, read as a str field (in wasm that is the address
  ;; itself; the VM reads the length and the bytes).
  (struct Cell [s:str])
  (fn at [s:i32] -> str (unsafe)
    (unsafe (get (ptr.cast Cell (- s 8)) Cell.s)))

  ;; Index of the first byte equal to c, or -1.
  (fn find_byte [b:Bytes c:i32] -> i32 (pub)
    (for i 0 (get b Bytes.len)
      (when (eq (call byte_at b i) c) (return i)))
    -1)

  ;; The number of bytes in b equal to c.
  (fn count_byte [b:Bytes c:i32] -> i32 (pub)
    (let n:i32 0)
    (for i 0 (get b Bytes.len)
      (when (eq (call byte_at b i) c) (set! n (+ n 1))))
    n)

  ;; Newlines, plus one for a final line without a newline.
  (fn count_lines [b:Bytes] -> i32 (pub)
    (unsafe (let len:i32 (get b Bytes.len))
    (let n:i32 (call count_byte b 10))
    (if (and (gt len 0) (neq (mem.load8 (+ (call addr b) (- len 1))) 10)) (+ n 1) n)))

  ;; Runs of non-whitespace bytes.
  (fn count_words [b:Bytes] -> i32 (pub)
    (let words:i32 0)
    (let in_word:bool false)
    (for i 0 (get b Bytes.len)
      (if (call is_space (call byte_at b i))
          (set! in_word false)
          (when (not in_word) (set! words (+ words 1)) (set! in_word true))))
    words)

  ;; Decimal integer with an optional leading '-': (ok:i32 n), or (err:i32 i) where i
  ;; is the index of the first byte that is not part of a number (0 for an
  ;; empty input or a lone '-'). Values outside i32 wrap.
  (fn parse_int [b:Bytes] -> (result i32 i32) (pub)
    (unsafe (let len:i32 (get b Bytes.len))
    (let neg:bool (and (gt len 0) (eq (mem.load8 (call addr b)) 45)))
    (let start:i32 (if neg 1 0))
    (when (lte len start) (return (err:i32 0)))
    (let n:i32 0)
    (for i start len
      (let c:i32 (call byte_at b i))
      (when (or (lt c 48) (gt c 57)) (return (err:i32 i)))
      (set! n (- (* n 10) (- c 48))))
    (ok:i32 (if neg n (- 0 n)))))

  ;; b as a decimal i32 (parse_int), or `default` if it is not one.
  (fn parse_int_or [b:Bytes default:i32] -> i32 (pub)
    (match_result (call parse_int b) (ok n n) (err e default)))

  ;; Whether b is valid UTF-8 (as Rust's str::from_utf8 decides: no
  ;; overlong forms, no surrogates, nothing past U+10FFFF).
  (fn valid_utf8 [b:Bytes] -> bool (pub)
    (let n:i32 (get b Bytes.len))
    (let i:i32 0)
    (while (lt i n)
      (let c:i32 (call byte_at b i))
      (let need:i32 (cond ((lt c 128) 0) ((and (gte c 194) (lte c 223)) 1) ((and (gte c 224) (lte c 239)) 2) ((and (gte c 240) (lte c 244)) 3) (else -1)))
      (when (or (lt need 0) (gt (+ i need) (- n 1))) (when (not (eq need 0)) (return false)))
      (when (gt need 0)
            ;; the second byte's range depends on the first (overlong, surrogate, and range limits)
            (let c1:i32 (call byte_at b (+ i 1)))
            (let lo:i32 (cond ((eq c 224) 160) ((eq c 240) 144) (else 128)))
            (let hi:i32 (cond ((eq c 237) 159) ((eq c 244) 143) (else 191)))
            (when (or (lt c1 lo) (gt c1 hi)) (return false))
            (for k 2 (+ need 1)
              (let ck:i32 (call byte_at b (+ i k)))
              (when (or (lt ck 128) (gt ck 191)) (return false))))
      (set! i (+ i (+ need 1))))
    true)

  ;; Pass count; test_suite.aipl expects 10.
  (fn run_str_tests [] -> i32 (pub)
    (unsafe (let ab:Bytes (call from_str "a b\nc"))
    (let p:i32 0)
    (when (and (call is_space 9) (and (call is_space 32) (not (call is_space 97)))) (set! p (+ p 1)))
    (when (and (call bytes_eq ab (call from_str "a b\nc")) (not (call bytes_eq ab (call from_str "a b")))) (set! p (+ p 1)))
    (when (and (eq (call find_byte ab 10) 3) (eq (call find_byte ab 122) -1)) (set! p (+ p 1)))
    (when (eq (call count_byte ab 32) 1) (set! p (+ p 1)))
    (when (and (eq (call count_lines ab) 2) (and (eq (call count_lines (call from_str "x\n")) 1) (eq (call count_lines (call from_str "")) 0))) (set! p (+ p 1)))
    (when (and (eq (call count_words ab) 3) (eq (call count_words (call from_str " \t\n")) 0)) (set! p (+ p 1)))
    (let good:i32 (match_result (call parse_int (call from_str "-305")) (ok n n) (err e 9999)))
    (let bad:i32 (match_result (call parse_int (call from_str "12x4")) (ok n -1) (err e e)))
    (let empty:i32 (match_result (call parse_int (call from_str "-")) (ok n -1) (err e e)))
    (when (and (eq good -305) (and (eq bad 2) (eq empty 0))) (set! p (+ p 1)))
    (when (and (eq (call parse_int_or (call from_str "42") 7) 42) (eq (call parse_int_or (call from_str "4x") 7) 7)) (set! p (+ p 1)))
    ;; valid_utf8: text and multi-byte characters pass; a lone continuation
    ;; byte, a truncated sequence, an overlong form, and a surrogate fail
    (let u:i32 (mem.alloc 8))
    (mem.store8 u 226) (mem.store8 (+ u 1) 130) (mem.store8 (+ u 2) 172)   ;; U+20AC, the euro sign
    (mem.store8 (+ u 3) 192) (mem.store8 (+ u 4) 175)                     ;; an overlong '/'
    (mem.store8 (+ u 5) 237) (mem.store8 (+ u 6) 160) (mem.store8 (+ u 7) 128)   ;; a surrogate
    (when (and (call valid_utf8 ab)
             (and (call valid_utf8 (call bytes u 3))
                  (and (not (call valid_utf8 (call bytes (+ u 1) 2)))
                       (and (not (call valid_utf8 (call bytes u 2)))
                            (and (not (call valid_utf8 (call bytes (+ u 3) 2)))
                                 (not (call valid_utf8 (call bytes (+ u 5) 3))))))))
        (set! p (+ p 1)))
    ;; same compares contents; concat and from_bytes make new strs
    (let hw:str (call concat "hello, " "world"))
    (when (and (call same hw "hello, world")
             (and (not (call same hw "hello, worle"))
                  (and (not (call same hw "hello"))
                       (and (eq (str.len (call concat "" "")) 0)
                            (call same (call from_bytes (call slice (call from_str hw) 7 5)) "world")))))
        (set! p (+ p 1)))
    p)))
