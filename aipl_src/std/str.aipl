;; std/str: byte slices and byte-level text functions. Every function is plain
;; AIPL over mem.* and str.*, so it behaves the same in the VM and compiled.
(module str
  ;; `len` bytes starting at address `addr`. A failed read has len -1.
  (struct Bytes [addr:i32 len:i32])

  (fn bytes [addr:i32 len:i32] -> (ptr Bytes) (unsafe)
    (let b:(ptr Bytes) (new Bytes))
    (put b Bytes.addr addr)
    (put b Bytes.len len)
    b)

  ;; The bytes of a string (the VM copies them into the heap; wasm does not).
  (fn from_str [s:str] -> (ptr Bytes)
    (unsafe (call bytes (str.ptr s) (str.len s))))

  (fn byte_at [b:(ptr Bytes) i:i32] -> i32
    (req (and (gte i 0) (lt i (get b Bytes.len))))
    (unsafe (mem.load8 (+ (get b Bytes.addr) i))))

  ;; Bytes start .. start + len - 1 of b, as a view of the same memory.
  (fn slice [b:(ptr Bytes) start:i32 len:i32] -> (ptr Bytes)
    (req (and (gte start 0) (and (gte len 0) (lte (+ start len) (get b Bytes.len)))))
    (unsafe (call bytes (+ (get b Bytes.addr) start) len)))

  ;; Sets byte i of b to c (its low 8 bits).
  (fn set_byte [b:(ptr Bytes) i:i32 c:i32] -> void
    (req (and (gte i 0) (lt i (get b Bytes.len))))
    (unsafe (mem.store8 (+ (get b Bytes.addr) i) c)))

  ;; ASCII whitespace: space, \t \n \v \f \r.
  (fn is_space [c:i32] -> bool
    (or (eq c 32) (and (gte c 9) (lte c 13))))

  (fn bytes_eq [a:(ptr Bytes) b:(ptr Bytes)] -> bool
    (if (neq (get a Bytes.len) (get b Bytes.len)) (return false) (block))
    (loop i 0 (- (get a Bytes.len) 1) 1
      (if (neq (call byte_at a i) (call byte_at b i)) (return false) (block)))
    true)

  ;; Whether b spells the literal s, without allocating.
  (fn is [b:(ptr Bytes) s:str] -> bool
    (unsafe (if (neq (get b Bytes.len) (str.len s)) (return false) (block))
    (loop i 0 (- (get b Bytes.len) 1) 1
      (if (neq (call byte_at b i) (mem.load8 (+ (str.ptr s) i))) (return false) (block)))
    true))

  ;; Index of the first byte equal to c, or -1.
  (fn find_byte [b:(ptr Bytes) c:i32] -> i32
    (loop i 0 (- (get b Bytes.len) 1) 1
      (if (eq (call byte_at b i) c) (return i) (block)))
    -1)

  (fn count_byte [b:(ptr Bytes) c:i32] -> i32
    (let n:i32 0)
    (loop i 0 (- (get b Bytes.len) 1) 1
      (if (eq (call byte_at b i) c) (set! n (+ n 1)) (block)))
    n)

  ;; Newlines, plus one for a final line without a newline.
  (fn count_lines [b:(ptr Bytes)] -> i32
    (unsafe (let len:i32 (get b Bytes.len))
    (let n:i32 (call count_byte b 10))
    (if (and (gt len 0) (neq (mem.load8 (+ (get b Bytes.addr) (- len 1))) 10)) (+ n 1) n)))

  ;; Runs of non-whitespace bytes.
  (fn count_words [b:(ptr Bytes)] -> i32
    (let words:i32 0)
    (let in_word:bool false)
    (loop i 0 (- (get b Bytes.len) 1) 1
      (if (call is_space (call byte_at b i))
          (set! in_word false)
          (if in_word
              (block)
              (block (set! words (+ words 1)) (set! in_word true)))))
    words)

  ;; Decimal integer with an optional leading '-': (ok n), or (err i) where i
  ;; is the index of the first byte that is not part of a number (0 for an
  ;; empty input or a lone '-'). Values outside i32 wrap.
  (fn parse_int [b:(ptr Bytes)] -> (result i32 i32)
    (unsafe (let len:i32 (get b Bytes.len))
    (let neg:bool (and (gt len 0) (eq (mem.load8 (get b Bytes.addr)) 45)))
    (let start:i32 (if neg 1 0))
    (if (lte len start) (return (err 0)) (block))
    (let n:i32 0)
    (loop i start (- len 1) 1
      (let c:i32 (call byte_at b i))
      (if (or (lt c 48) (gt c 57)) (return (err i)) (block))
      (set! n (- (* n 10) (- c 48))))
    (ok (if neg n (- 0 n)))))

  ;; b as a decimal i32 (parse_int), or `default` if it is not one.
  (fn parse_int_or [b:(ptr Bytes) default:i32] -> i32
    (match_result (call parse_int b) (ok n n) (err e default)))

  ;; Pass count; test_suite.aipl expects 8.
  ;; Whether b is valid UTF-8 (as Rust's str::from_utf8 decides: no
  ;; overlong forms, no surrogates, nothing past U+10FFFF).
  (fn valid_utf8 [b:(ptr Bytes)] -> bool
    (let n:i32 (get b Bytes.len))
    (let i:i32 0)
    (while (lt i n)
      (let c:i32 (call byte_at b i))
      (let need:i32 (cond ((lt c 128) 0) ((and (gte c 194) (lte c 223)) 1) ((and (gte c 224) (lte c 239)) 2) ((and (gte c 240) (lte c 244)) 3) (else -1)))
      (if (or (lt need 0) (gt (+ i need) (- n 1))) (if (eq need 0) (block) (return false)) (block))
      (if (gt need 0)
          (block
            ;; the second byte's range depends on the first (overlong, surrogate, and range limits)
            (let c1:i32 (call byte_at b (+ i 1)))
            (let lo:i32 (cond ((eq c 224) 160) ((eq c 240) 144) (else 128)))
            (let hi:i32 (cond ((eq c 237) 159) ((eq c 244) 143) (else 191)))
            (if (or (lt c1 lo) (gt c1 hi)) (return false) (block))
            (loop k 2 need 1
              (let ck:i32 (call byte_at b (+ i k)))
              (if (or (lt ck 128) (gt ck 191)) (return false) (block))))
          (block))
      (set! i (+ i (+ need 1))))
    true)

  (fn run_str_tests [] -> i32
    (unsafe (let ab:(ptr Bytes) (call from_str "a b\nc"))
    (let p:i32 0)
    (if (and (call is_space 9) (and (call is_space 32) (not (call is_space 97)))) (set! p (+ p 1)) (block))
    (if (and (call bytes_eq ab (call from_str "a b\nc")) (not (call bytes_eq ab (call from_str "a b")))) (set! p (+ p 1)) (block))
    (if (and (eq (call find_byte ab 10) 3) (eq (call find_byte ab 122) -1)) (set! p (+ p 1)) (block))
    (if (eq (call count_byte ab 32) 1) (set! p (+ p 1)) (block))
    (if (and (eq (call count_lines ab) 2) (and (eq (call count_lines (call from_str "x\n")) 1) (eq (call count_lines (call from_str "")) 0))) (set! p (+ p 1)) (block))
    (if (and (eq (call count_words ab) 3) (eq (call count_words (call from_str " \t\n")) 0)) (set! p (+ p 1)) (block))
    (let good:i32 (match_result (call parse_int (call from_str "-305")) (ok n n) (err e 9999)))
    (let bad:i32 (match_result (call parse_int (call from_str "12x4")) (ok n -1) (err e e)))
    (let empty:i32 (match_result (call parse_int (call from_str "-")) (ok n -1) (err e e)))
    (if (and (eq good -305) (and (eq bad 2) (eq empty 0))) (set! p (+ p 1)) (block))
    (if (and (eq (call parse_int_or (call from_str "42") 7) 42) (eq (call parse_int_or (call from_str "4x") 7) 7)) (set! p (+ p 1)) (block))
    ;; valid_utf8: text and multi-byte characters pass; a lone continuation
    ;; byte, a truncated sequence, an overlong form, and a surrogate fail
    (let u:i32 (mem.alloc 8))
    (mem.store8 u 226) (mem.store8 (+ u 1) 130) (mem.store8 (+ u 2) 172)   ;; U+20AC, the euro sign
    (mem.store8 (+ u 3) 192) (mem.store8 (+ u 4) 175)                     ;; an overlong '/'
    (mem.store8 (+ u 5) 237) (mem.store8 (+ u 6) 160) (mem.store8 (+ u 7) 128)   ;; a surrogate
    (if (and (call valid_utf8 ab)
             (and (call valid_utf8 (call bytes u 3))
                  (and (not (call valid_utf8 (call bytes (+ u 1) 2)))
                       (and (not (call valid_utf8 (call bytes u 2)))
                            (and (not (call valid_utf8 (call bytes (+ u 3) 2)))
                                 (not (call valid_utf8 (call bytes (+ u 5) 3))))))))
        (set! p (+ p 1))
        (block))
    p)))
