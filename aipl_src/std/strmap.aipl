;; std/strmap: hash map from byte strings to values of any type (symbol
;; tables, word counts). Generic in the value type (AIPL_SPEC.md 4.H):
;;   (let m:(ptr (strmap.StrMap i32)) (call (strmap.make i32) (call alloc.default) 0))
;;   (call (strmap.set i32) m key 1)
;;   (call (strmap.get_or i32) m key 0)
;; Keys are (ptr str.Bytes); the map keeps the pointer, so a key's bytes must
;; not change while it is in the map. Same design as std/map.
(module strmap
  (import alloc)
  (import str)

  ;; state per slot: 0 empty, 1 used, 2 deleted
  (struct (StrMap V) [keys:(arr (ptr str.Bytes)) vals:(arr V) states:(arr i32) count:i32 used:i32 allocator:alloc.Allocator])

  ;; FNV-1a over the bytes
  (fn hash [b:(ptr str.Bytes)] -> i32
    (let h:i32 -2128831035)
    (loop i 0 (- (get b str.Bytes.len) 1) 1
      (set! h (* (^ h (call str.byte_at b i)) 16777619)))
    h)

  (fn (alloc_slots V) [m:(ptr (StrMap V)) cap:i32] -> void
    (let a:alloc.Allocator (get m (StrMap V) allocator))
    (put m (StrMap V) keys (call (alloc.array (ptr str.Bytes)) a cap))
    (put m (StrMap V) vals (call (alloc.array V) a cap))
    (put m (StrMap V) states (call (alloc.array i32) a cap))
    (put m (StrMap V) count 0)
    (put m (StrMap V) used 0))

  (fn (make V) [a:alloc.Allocator capacity:i32] -> (ptr (StrMap V))
    (let cap:i32 8)
    (while (lt cap capacity) (set! cap (* cap 2)))
    (let m:(ptr (StrMap V)) (call (alloc.create (StrMap V)) a))
    (put m (StrMap V) allocator a)
    (call (alloc_slots V) m cap)
    m)

  ;; Frees the table and the map itself; neither may be used afterwards.
  (fn (free V) [m:(ptr (StrMap V))] -> void
    (call (free_slots V) (get m (StrMap V) allocator) (get m (StrMap V) keys) (get m (StrMap V) vals) (get m (StrMap V) states))
    (call (alloc.destroy (StrMap V)) (get m (StrMap V) allocator) m))

  (fn (free_slots V) [a:alloc.Allocator keys:(arr (ptr str.Bytes)) vals:(arr V) states:(arr i32)] -> void
    (call (alloc.free_array (ptr str.Bytes)) a keys)
    (call (alloc.free_array V) a vals)
    (call (alloc.free_array i32) a states))

  (fn (capacity V) [m:(ptr (StrMap V))] -> i32 (arr.len (get m (StrMap V) keys)))
  (fn (count V) [m:(ptr (StrMap V))] -> i32 (get m (StrMap V) count))

  (fn (slot_for V) [m:(ptr (StrMap V)) k:(ptr str.Bytes)] -> i32
    (let mask:i32 (- (call (capacity V) m) 1))
    (let i:i32 (bitand (call hash k) mask))
    (let tomb:i32 -1)
    (while true
      (let st:i32 (arr.get i32 (get m (StrMap V) states) i))
      (cond
        ((eq st 0) (return (if (neq tomb -1) tomb i)))
        ((eq st 1) (if (call str.bytes_eq (arr.get (ptr str.Bytes) (get m (StrMap V) keys) i) k) (return i) (block)))
        ((eq tomb -1) (set! tomb i))
        (else (block)))
      (set! i (bitand (+ i 1) mask)))
    -1)

  (fn (grow V) [m:(ptr (StrMap V))] -> void
    (let old_keys:(arr (ptr str.Bytes)) (get m (StrMap V) keys))
    (let old_vals:(arr V) (get m (StrMap V) vals))
    (let old_states:(arr i32) (get m (StrMap V) states))
    (let old_cap:i32 (arr.len old_keys))
    (call (alloc_slots V) m (if (gt (* 2 (get m (StrMap V) count)) old_cap) (* 2 old_cap) old_cap))
    (loop i 0 (- old_cap 1) 1
      (if (eq (arr.get i32 old_states i) 1)
          (call (set V) m (arr.get (ptr str.Bytes) old_keys i) (arr.get V old_vals i))
          (block)))
    (call (free_slots V) (get m (StrMap V) allocator) old_keys old_vals old_states))

  ;; Adds k -> v, or replaces k's value.
  (fn (set V) [m:(ptr (StrMap V)) k:(ptr str.Bytes) v:V] -> void
    (if (gte (* 4 (+ (get m (StrMap V) used) 1)) (* 3 (call (capacity V) m))) (call (grow V) m) (block))
    (let i:i32 (call (slot_for V) m k))
    (let st:i32 (arr.get i32 (get m (StrMap V) states) i))
    (if (neq st 1)
        (block
          (if (eq st 0) (put m (StrMap V) used (+ (get m (StrMap V) used) 1)) (block))
          (arr.set i32 (get m (StrMap V) states) i 1)
          (arr.set (ptr str.Bytes) (get m (StrMap V) keys) i k)
          (put m (StrMap V) count (+ (get m (StrMap V) count) 1)))
        (block))
    (arr.set V (get m (StrMap V) vals) i v))

  ;; k's value, or `default` when k is absent.
  (fn (get_or V) [m:(ptr (StrMap V)) k:(ptr str.Bytes) default:V] -> V
    (let i:i32 (call (slot_for V) m k))
    (if (eq (arr.get i32 (get m (StrMap V) states) i) 1) (arr.get V (get m (StrMap V) vals) i) default))

  (fn (has V) [m:(ptr (StrMap V)) k:(ptr str.Bytes)] -> bool
    (eq (arr.get i32 (get m (StrMap V) states) (call (slot_for V) m k)) 1))

  (fn (remove V) [m:(ptr (StrMap V)) k:(ptr str.Bytes)] -> bool
    (let i:i32 (call (slot_for V) m k))
    (if (neq (arr.get i32 (get m (StrMap V) states) i) 1) (return false) (block))
    (arr.set i32 (get m (StrMap V) states) i 2)
    (put m (StrMap V) count (- (get m (StrMap V) count) 1))
    true)

  ;; Iterate with (loop i 0 (- (call (strmap.capacity V) m) 1) 1 (if (call (strmap.slot_used V) m i) ...)).
  (fn (slot_used V) [m:(ptr (StrMap V)) i:i32] -> bool (eq (arr.get i32 (get m (StrMap V) states) i) 1))
  (fn (slot_key V) [m:(ptr (StrMap V)) i:i32] -> (ptr str.Bytes) (arr.get (ptr str.Bytes) (get m (StrMap V) keys) i))
  (fn (slot_val V) [m:(ptr (StrMap V)) i:i32] -> V (arr.get V (get m (StrMap V) vals) i))

  ;; Pass count; test_suite.aipl expects 4.
  (fn run_strmap_tests [] -> i32
    (let p:i32 0)
    ;; word frequencies of a small text, splitting on spaces by hand
    (let text:(ptr str.Bytes) (call str.from_str "the cat and the hat and the bat"))
    (let m:(ptr (StrMap i32)) (call (make i32) (call alloc.default) 0))
    (let start:i32 0)
    (loop i 0 (get text str.Bytes.len) 1
      (if (or (eq i (get text str.Bytes.len)) (eq (mem.load8 (+ (get text str.Bytes.addr) i)) 32))
          (block
            (let w:(ptr str.Bytes) (call str.bytes (+ (get text str.Bytes.addr) start) (- i start)))
            (call (set i32) m w (+ (call (get_or i32) m w 0) 1))
            (set! start (+ i 1)))
          (block)))
    (if (and (eq (call (count i32) m) 5)
             (and (eq (call (get_or i32) m (call str.from_str "the") 0) 3)
                  (and (eq (call (get_or i32) m (call str.from_str "and") 0) 2)
                       (eq (call (get_or i32) m (call str.from_str "dog") -1) -1))))
        (set! p (+ p 1))
        (block))
    (if (and (call (remove i32) m (call str.from_str "cat")) (and (not (call (has i32) m (call str.from_str "cat"))) (eq (call (count i32) m) 4)))
        (set! p (+ p 1))
        (block))
    ;; 300 distinct generated keys survive resizing
    (let big:(ptr (StrMap i32)) (call (make i32) (call alloc.default) 0))
    (loop i 0 299 1
      (let k:i32 (mem.alloc 2))
      (mem.store8 k (+ 65 (/ i 26)))
      (mem.store8 (+ k 1) (+ 65 (% i 26)))
      (call (set i32) big (call str.bytes k 2) i))
    (let ok:bool (eq (call (count i32) big) 300))
    (loop i 0 299 1
      (let k:i32 (mem.alloc 2))
      (mem.store8 k (+ 65 (/ i 26)))
      (mem.store8 (+ k 1) (+ 65 (% i 26)))
      (if (neq (call (get_or i32) big (call str.bytes k 2) -1) i) (set! ok false) (block)))
    (if ok (set! p (+ p 1)) (block))
    ;; non-i32 values: a map to byte strings
    (let names:(ptr (StrMap (ptr str.Bytes))) (call (make (ptr str.Bytes)) (call alloc.default) 0))
    (call (set (ptr str.Bytes)) names (call str.from_str "k") (call str.from_str "value"))
    (if (eq (get (call (get_or (ptr str.Bytes)) names (call str.from_str "k") (call str.bytes 0 -1)) str.Bytes.len) 5)
        (set! p (+ p 1))
        (block))
    p))
