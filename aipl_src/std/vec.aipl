;; std/vec: a growable list of any element type (storage doubles when full).
;; Generic (AIPL_SPEC.md 4.H): every use names the element type. Its memory
;; comes from the allocator it is made with (std/alloc); growing frees the
;; old storage, and free releases it all.
;;   (let v:(ptr (vec.Vec i32)) (call (vec.make i32) (call alloc.default) 0))
;;   (call (vec.push i32) v 7)
;;   (call (vec.at i32) v 0)
;;   (call (vec.free i32) v)
(module vec
  (import cmp)
  (import alloc)

  ;; A growable list of T; len is how many it holds.
  (struct (Vec T) [items:(arr T) (read len:i32) allocator:alloc.Allocator] (pub))

  ;; An empty list with room for `capacity` items, from a.
  (fn (make T) [a:alloc.Allocator capacity:i32] -> (ptr (Vec T)) (pub)
    (req (gte capacity 0))
    (let cap:i32 (if (lt capacity 4) 4 capacity))
    (let v:(ptr (Vec T)) (new (Vec T) a [items:(arr.new T a cap) len:0 allocator:a]))
    v)

  ;; Frees the storage and the vec itself; neither may be used afterwards.
  (fn (free T) [v:(ptr (Vec T))] -> void (pub)
    (let a:alloc.Allocator (get v (Vec T) allocator))
    (call (alloc.free_array T) a (get v (Vec T) items))
    (call (alloc.destroy (Vec T)) a v))

  ;; The number of items in v.
  (fn (len T) [v:(ptr (Vec T))] -> i32 (pub)
    (get v (Vec T) len))

  ;; Element i.
  (fn (at T) [v:(ptr (Vec T)) i:i32] -> T (pub)
    (req (and (gte i 0) (lt i (get v (Vec T) len))))
    (arr.get T (get v (Vec T) items) i))

  ;; Replaces item i of v (0 <= i < len) with x.
  (fn (set T) [v:(ptr (Vec T)) i:i32 x:T] -> void (pub)
    (req (and (gte i 0) (lt i (get v (Vec T) len))))
    (arr.set T (get v (Vec T) items) i x))

  ;; Appends x, doubling the storage when full.
  (fn (push T) [v:(ptr (Vec T)) x:T] -> void (pub)
    (let n:i32 (get v (Vec T) len))
    (let items:(arr T) (get v (Vec T) items))
    (when (eq n (arr.len items))
          (let bigger:(arr T) (arr.new T (get v (Vec T) allocator) (* 2 n)))
          (for i 0 n
            (arr.set T bigger i (arr.get T items i)))
          (call (alloc.free_array T) (get v (Vec T) allocator) items)
          (put v (Vec T) items bigger))
    (arr.set T (get v (Vec T) items) n x)
    (put v (Vec T) len (+ n 1)))

  ;; Removes and returns the last element.
  (fn (pop T) [v:(ptr (Vec T))] -> T (pub)
    (req (gt (get v (Vec T) len) 0))
    (let n:i32 (- (get v (Vec T) len) 1))
    (put v (Vec T) len n)
    (arr.get T (get v (Vec T) items) n))

  ;; Keeps the first n elements.
  (fn (truncate T) [v:(ptr (Vec T)) n:i32] -> void (pub)
    (req (and (gte n 0) (lte n (get v (Vec T) len))))
    (put v (Vec T) len n))

  ;; Empties v, keeping its storage.
  (fn (clear T) [v:(ptr (Vec T))] -> void (pub)
    (put v (Vec T) len 0))

  ;; Index of the first element equal to x (eq: same value, or same address
  ;; for pointers), or -1.
  (fn (index_of T) [v:(ptr (Vec T)) x:T] -> i32 (pub) (where (cmp.Eq T))
    (for i 0 (get v (Vec T) len)
      (when (call (cmp.Eq.same T) (arr.get T (get v (Vec T) items) i) x) (return i)))
    -1)

  (fn min_i32 [a:i32 b:i32] -> i32 (if (lt a b) a b))

  ;; -1, 0, 1 as a < b, a = b, a > b (no subtraction, so no overflow).
  (fn cmp_i32 [a:i32 b:i32] -> i32 (pub)
    (cond ((lt a b) -1) ((gt a b) 1) (else 0)))

  ;; Stable sort by cmp: a negative result puts a before b, positive puts b
  ;; before a, zero keeps their order. Bottom-up merge sort, O(n log n).
  (fn (sort_by T) [v:(ptr (Vec T)) cmp:(fn [T T] -> i32 (no_leak))] -> void (pub)
    (let n:i32 (get v (Vec T) len))
    (when (lt n 2) (return))
    (let src:(arr T) (get v (Vec T) items))
    (let scratch:(arr T) (arr.new T (get v (Vec T) allocator) n))
    (let dst:(arr T) scratch)
    (let width:i32 1)
    (while (lt width n)
      (let lo:i32 0)
      (while (lt lo n)
        (let mid:i32 (call min_i32 (+ lo width) n))
        (let hi:i32 (call min_i32 (+ lo (* 2 width)) n))
        (let i:i32 lo)
        (let j:i32 mid)
        (for k lo hi
          (cond
            ((gte i mid)
             (arr.set T dst k (arr.get T src j))
             (set! j (+ j 1)))
            ((gte j hi)
             (arr.set T dst k (arr.get T src i))
             (set! i (+ i 1)))
            ((lte (call_ref (fn [T T] -> i32 (no_leak)) cmp (arr.get T src i) (arr.get T src j)) 0)
             (arr.set T dst k (arr.get T src i))
             (set! i (+ i 1)))
            (else
             (arr.set T dst k (arr.get T src j))
             (set! j (+ j 1)))))
        (set! lo hi))
      (let tmp:(arr T) src)
      (set! src dst)
      (set! dst tmp)
      (set! width (* width 2)))
    ;; the sorted run is in src; copy it back if that is the scratch array
    (when (neq (arr.addr src) (arr.addr (get v (Vec T) items)))
        (for i 0 n
          (arr.set T (get v (Vec T) items) i (arr.get T src i))))
    (call (alloc.free_array T) (get v (Vec T) allocator) scratch))

  ;; sort_by, with a context passed to every comparison: (cmp ctx a b). AIPL
  ;; has no closures, so this is how a comparison sees data of its own, a
  ;; map of counts, say (AIPL_SPEC.md 4.G). The same merge sort as sort_by,
  ;; kept as its own copy: sort_by on top of this would cost an extra
  ;; indirect call per comparison (9% on a million i32s).
  (fn (sort_by_with T C) [v:(ptr (Vec T)) ctx:C cmp:(fn [C T T] -> i32 (no_leak))] -> void (pub)
    (let n:i32 (get v (Vec T) len))
    (when (lt n 2) (return))
    (let src:(arr T) (get v (Vec T) items))
    (let scratch:(arr T) (arr.new T (get v (Vec T) allocator) n))
    (let dst:(arr T) scratch)
    (let width:i32 1)
    (while (lt width n)
      (let lo:i32 0)
      (while (lt lo n)
        (let mid:i32 (call min_i32 (+ lo width) n))
        (let hi:i32 (call min_i32 (+ lo (* 2 width)) n))
        (let i:i32 lo)
        (let j:i32 mid)
        (for k lo hi
          (cond
            ((gte i mid)
             (arr.set T dst k (arr.get T src j))
             (set! j (+ j 1)))
            ((gte j hi)
             (arr.set T dst k (arr.get T src i))
             (set! i (+ i 1)))
            ((lte (call_ref (fn [C T T] -> i32 (no_leak)) cmp ctx (arr.get T src i) (arr.get T src j)) 0)
             (arr.set T dst k (arr.get T src i))
             (set! i (+ i 1)))
            (else
             (arr.set T dst k (arr.get T src j))
             (set! j (+ j 1)))))
        (set! lo hi))
      (let tmp:(arr T) src)
      (set! src dst)
      (set! dst tmp)
      (set! width (* width 2)))
    ;; the sorted run is in src; copy it back if that is the scratch array
    (when (neq (arr.addr src) (arr.addr (get v (Vec T) items)))
        (for i 0 n
          (arr.set T (get v (Vec T) items) i (arr.get T src i))))
    (call (alloc.free_array T) (get v (Vec T) allocator) scratch))

  ;; Ascending by T's order (std/cmp's Ord: i32, i64, str, or a type that
  ;; implements it), stable: (call (vec.sort str) names). The same merge
  ;; sort as sort_by, calling T's compare directly: no indirect call, and
  ;; any implementation of Ord sorts (sort_by's comparator must keep no
  ;; memory; here a compare that keeps some makes only this sort may-leak).
  (fn (sort T) [v:(ptr (Vec T))] -> void (pub) (where (cmp.Ord T))
    (let n:i32 (get v (Vec T) len))
    (when (lt n 2) (return))
    (let src:(arr T) (get v (Vec T) items))
    (let scratch:(arr T) (arr.new T (get v (Vec T) allocator) n))
    (let dst:(arr T) scratch)
    (let width:i32 1)
    (while (lt width n)
      (let lo:i32 0)
      (while (lt lo n)
        (let mid:i32 (call min_i32 (+ lo width) n))
        (let hi:i32 (call min_i32 (+ lo (* 2 width)) n))
        (let i:i32 lo)
        (let j:i32 mid)
        (for k lo hi
          (cond
            ((gte i mid)
             (arr.set T dst k (arr.get T src j))
             (set! j (+ j 1)))
            ((gte j hi)
             (arr.set T dst k (arr.get T src i))
             (set! i (+ i 1)))
            ((lte (call (cmp.Ord.compare T) (arr.get T src i) (arr.get T src j)) 0)
             (arr.set T dst k (arr.get T src i))
             (set! i (+ i 1)))
            (else
             (arr.set T dst k (arr.get T src j))
             (set! j (+ j 1)))))
        (set! lo hi))
      (let tmp:(arr T) src)
      (set! src dst)
      (set! dst tmp)
      (set! width (* width 2)))
    ;; the sorted run is in src; copy it back if that is the scratch array
    (when (neq (arr.addr src) (arr.addr (get v (Vec T) items)))
        (for i 0 n
          (arr.set T (get v (Vec T) items) i (arr.get T src i))))
    (call (alloc.free_array T) (get v (Vec T) allocator) scratch))


  ;; Ascending.
  (fn sort_i32 [v:(ptr (Vec i32))] -> void (pub)
    (call (sort_by i32) v (ref cmp_i32)))

  ;; for the stability test: compares only the tens digit and up
  (fn cmp_tens [a:i32 b:i32] -> i32
    (call cmp_i32 (/ a 10) (/ b 10)))

  ;; for the element-type test
  (struct Point [x:i32 y:i32])
  (fn by_x [a:(ptr Point) b:(ptr Point)] -> i32 (call cmp_i32 (get a Point.x) (get b Point.x)))

  ;; Pass count; test_suite.aipl expects 8.
  (fn run_vec_tests [] -> i32 (pub)
    (let p:i32 0)
    (let v:(ptr (Vec i32)) (call (make i32) (call alloc.default) 0))
    (for i 0 1000 (call (push i32) v (* i 3)))
    (when (and (eq (call (len i32) v) 1000) (and (eq (call (at i32) v 0) 0) (eq (call (at i32) v 999) 2997))) (set! p (+ p 1)))
    (call (set i32) v 5 -7)
    (when (and (eq (call (pop i32) v) 2997) (and (eq (call (len i32) v) 999) (eq (call (at i32) v 5) -7))) (set! p (+ p 1)))
    (when (and (eq (call (index_of i32) v 30) 10) (eq (call (index_of i32) v 31) -1)) (set! p (+ p 1)))
    ;; sort 200 pseudo-random values; sorted and the same multiset (sum, count)
    (let r:(ptr (Vec i32)) (call (make i32) (call alloc.default) 4))
    (let x:i32 12345)
    (let sum:i32 0)
    (for i 1 201
      (set! x (+ (* x 1103515245) 12345))
      (call (push i32) r (bitand (shru x 8) 1023))
      (set! sum (+ sum (bitand (shru x 8) 1023))))
    (call sort_i32 r)
    (let ok:bool true)
    (let sum2:i32 0)
    (for i 0 200
      (set! sum2 (+ sum2 (call (at i32) r i)))
      (when (and (gt i 0) (gt (call (at i32) r (- i 1)) (call (at i32) r i))) (set! ok false)))
    (when (and ok (eq sum sum2)) (set! p (+ p 1)))
    ;; stability: equal keys keep their order
    (let s:(ptr (Vec i32)) (call (make i32) (call alloc.default) 4))
    (call (push i32) s 31) (call (push i32) s 12) (call (push i32) s 35) (call (push i32) s 10) (call (push i32) s 33)
    (call (sort_by i32) s (ref cmp_tens))
    (when (and (eq (call (at i32) s 0) 12) (and (eq (call (at i32) s 1) 10) (and (eq (call (at i32) s 2) 31) (and (eq (call (at i32) s 3) 35) (eq (call (at i32) s 4) 33)))))
        (set! p (+ p 1)))
    ;; other element types: i64 values and struct pointers, sorted by a field
    (let big:(ptr (Vec i64)) (call (make i64) (call alloc.default) 0))
    (call (push i64) big 5000000000i64)
    (let pts:(ptr (Vec (ptr Point))) (call (make (ptr Point)) (call alloc.default) 0))
    (for i 0 5
      (let pt:(ptr Point) (new Point (call alloc.forever) [x:(- 10 i) y:(zero i32)]))
      (call (push (ptr Point)) pts pt))
    (call (sort_by (ptr Point)) pts (ref by_x))
    (when (and (eq (call (at i64) big 0) 5000000000i64) (eq (get (call (at (ptr Point)) pts 0) Point.x) 6))
        (set! p (+ p 1)))
    ;; a context: positions sorted by the scores they index, highest first
    (let scores:(arr i32) (arr.new i32 (call alloc.forever) 4))
    (arr.set i32 scores 0 30) (arr.set i32 scores 1 90) (arr.set i32 scores 2 10) (arr.set i32 scores 3 50)
    (let idx:(ptr (Vec i32)) (call (make i32) (call alloc.default) 4))
    (for i 0 4 (call (push i32) idx i))
    (call (sort_by_with i32 (arr i32)) idx scores (ref by_score))
    (when (and (eq (call (at i32) idx 0) 1) (and (eq (call (at i32) idx 1) 3) (and (eq (call (at i32) idx 2) 0) (eq (call (at i32) idx 3) 2))))
        (set! p (+ p 1)))
    ;; sort by cmp.Ord: str (bytewise, a prefix first) and i64
    (let names:(ptr (Vec str)) (call (make str) (call alloc.default) 4))
    (call (push str) names "pear") (call (push str) names "apple") (call (push str) names "app") (call (push str) names "Zoo")
    (call (sort str) names)
    (let ns:(ptr (Vec i64)) (call (make i64) (call alloc.default) 4))
    (call (push i64) ns 5000000000i64) (call (push i64) ns -3i64) (call (push i64) ns 0i64)
    (call (sort i64) ns)
    (when (and (call (cmp.Eq.same str) (call (at str) names 0) "Zoo")
             (call (cmp.Eq.same str) (call (at str) names 1) "app")
             (call (cmp.Eq.same str) (call (at str) names 2) "apple")
             (call (cmp.Eq.same str) (call (at str) names 3) "pear")
             (eq (call (at i64) ns 0) -3i64) (eq (call (at i64) ns 2) 5000000000i64))
        (set! p (+ p 1)))
    p)

  ;; higher scores first
  (fn by_score [scores:(arr i32) a:i32 b:i32] -> i32
    (call cmp_i32 (arr.get i32 scores b) (arr.get i32 scores a))))
