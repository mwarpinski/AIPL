;; Where the self-hosted commands (aipl.aipl, driver.aipl, doc.aipl) find
;; the standard library; src/library.rs is the Rust command's. In order:
;; $AIPL_STD; share/aipl/std/ beside the executable's folder, as a kit or an
;; install lays it out (<prefix>/bin/aipl-native reads
;; <prefix>/share/aipl/std/), when the command was started by a path (an
;; argv[0] with a /); else aipl_src/std/ below the working directory (the
;; repository's root, as bootstrap/build.sh runs it).
(module stdpath
  (import alloc)
  (import buf)
  (import fs)
  (import option)
  (import os)
  (import str)

  ;; The standard library's directory, ending in /.
  (fn find [] -> str.Bytes (pub)
    (let env:str.Bytes (call (option.unwrap_or str.Bytes) (call os.env "AIPL_STD") (call str.from_str "")))
    (when (gt (get env str.Bytes.len) 0) (return env))
    (let exe:str.Bytes (call (option.unwrap_or str.Bytes) (call os.arg 0) (call str.from_str "")))
    (let slash:i32 -1)
    (for i 0 (get exe str.Bytes.len)
      (when (eq (call str.byte_at exe i) 47) (set! slash i)))
    (when (gte slash 0)
          (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
          (call buf.push_bytes b (call str.slice exe 0 slash))
          (call buf.push_str b "/../share/aipl/std/")
          (let dir:str.Bytes (call buf.bytes b))
          (when (call has_std dir) (return dir)))
    (call str.from_str "aipl_src/std/"))

  ;; Whether dir holds the standard library (its str.aipl).
  (fn has_std [dir:str.Bytes] -> bool
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 64))
    (call buf.push_bytes b dir)
    (call buf.push_str b "str.aipl")
    (match (call fs.info_path (call buf.bytes b))
      ((option.Option fs.Info) some [_] true)
      ((option.Option fs.Info) none false))))
