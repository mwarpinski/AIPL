;; Master AIPL Test Suite
;; The single terminal-facing entrypoint for running this project's tests:
;;   aipl test aipl_src/test_suite.aipl
;; All the "what counts as pass/fail" and reporting logic lives here, in
;; AIPL, using sys.print - not in Rust. Rust's role (src/main.rs's `test`
;; subcommand) is just: resolve imports, type-check, invoke run_all, and
;; turn the returned failure count into a process exit code.
;;
;; It covers every module whose self-test has been verified to do real work
;; (and to fail when the code under test is broken). Add an import + report
;; line here as each new module gets such a test; don't add one just to make
;; the suite look bigger.


(module test_suite
  (import compiler)
  (import codegen)
  (import memory)
  (import file_io)
  (import str)
  (import fmt)
  (import io)
  (import vec)
  (import map)
  (import strmap)
  (import buf)
  (import thread_sync)
  (import resolver)
  (import os)

  ;; Prints a [PASS]/[FAIL] line for one module's test group and returns
  ;; 0 (contributes no failures) or 1 (contributes one failure) for the
  ;; caller to sum.
  (fn report [label:str result:i32 expected:i32] -> i32
    (if (eq result expected)
        (block (sys.print (+ "[PASS] " label)) 0)
        (block (sys.print (+ "[FAIL] " label)) 1)))

  ;; Runs every verified-real module's self-test, prints one line each, and
  ;; returns the total number of failing groups (0 = everything passed).
  (fn run_all [] -> i32
    (let failures:i32 0)
    (set! failures (+ failures (call report "compiler: tokenizer (2 tests)" (call compiler.run_tokenizer_tests) 2)))
    (set! failures (+ failures (call report "compiler: parser (2 tests)" (call compiler.run_parser_tests) 2)))
    (set! failures (+ failures (call report "codegen: signatures + 3 real wasm modules (4 tests)" (call codegen.run_codegen_tests) 4)))
    (set! failures (+ failures (call report "memory: allocator + arena" (call memory.run_memory_tests) 1)))
    (set! failures (+ failures (call report "file_io: real disk round-trip" (call file_io.run_file_io_tests) 1)))
    (set! failures (+ failures (call report "std/str: byte slices + parse_int (7 tests)" (call str.run_str_tests) 7)))
    (set! failures (+ failures (call report "std/fmt: number formatting (6 tests)" (call fmt.run_fmt_tests) 6)))
    (set! failures (+ failures (call report "resolver: imports in AIPL (3 tests)" (call resolver.run_resolver_tests) 3)))
    (set! failures (+ failures (call report "std/os: arguments + environment (2 tests)" (call os.run_os_tests) 2)))
    (set! failures (+ failures (call report "std/io: file round trip (2 tests)" (call io.run_io_tests) 2)))
    (set! failures (+ failures (call report "std/vec: growable list + stable sort (5 tests)" (call vec.run_vec_tests) 5)))
    (set! failures (+ failures (call report "std/map: i32 hash map (4 tests)" (call map.run_map_tests) 4)))
    (set! failures (+ failures (call report "std/strmap: byte-string hash map (3 tests)" (call strmap.run_strmap_tests) 3)))
    (set! failures (+ failures (call report "std/buf: string builder (3 tests)" (call buf.run_buf_tests) 3)))
    (set! failures (+ failures (call report "thread_sync: 4 threads x 1000 atomic adds = 4000" (call thread_sync.run_thread_tests) 1)))
    failures))
