;; Threads and atomics (AIPL_SPEC.md 4.D): thin wrappers over thread.spawn,
;; thread.join, and atomic.*, plus a self-test. In the VM thread.spawn starts
;; a std::thread sharing the program's linear memory; compiled, the module is
;; a threaded module (shared memory, wasi-threads' thread-spawn) and runs
;; under AIPL's runner. atomic.lock waits on a real lock word in that memory.

(module thread_sync

  (fn atomic_add [ptr:i32 val:i32] -> i32
    (req (gte ptr 0))
    (unsafe (atomic.add ptr val)))

  (fn atomic_cas [ptr:i32 expected:i32 new_val:i32] -> bool
    (req (gte ptr 0))
    (unsafe (atomic.cas ptr expected new_val)))

  ;; Acquires the lock word at mutex_ptr, waiting while another thread holds it. mutex_ptr must be an address dedicated to this lock,
  ;; distinct from any data it protects - the lock word IS that memory.
  (fn atomic_lock [mutex_ptr:i32] -> i32
    (req (gte mutex_ptr 0))
    (unsafe (atomic.lock mutex_ptr)
    1))

  (fn atomic_unlock [mutex_ptr:i32] -> i32
    (req (gte mutex_ptr 0))
    (unsafe (atomic.unlock mutex_ptr)
    0))

  ;; Runs worker(arg) on a new OS thread; returns a handle for thread_join.
  (fn thread_spawn [worker:(fn [i32] -> i32) arg:i32] -> i32
    (unsafe (thread.spawn worker arg)))

  ;; Blocks until the given thread finishes; returns its function's result.
  (fn thread_join [handle:i32] -> i32
    (unsafe (thread.join handle)))

  ;; Worker used by the self-test: increments the shared counter whose
  ;; address is passed as the thread argument, 1000 times. (The counter is
  ;; heap-allocated by the test; nothing below address 1024 is ours to use.)
  (fn worker_increment [counter_ptr:i32] -> i32
    (loop i 0 999 1
      (let _r:i32 (call atomic_add counter_ptr 1)))
    0)

  ;; Master Multithreading Self-Test: spawns 4 REAL OS threads that each
  ;; increment a SHARED counter 1000 times via atomic.add, joins all of them,
  ;; and checks the final total is exactly 4000. This can only pass if the
  ;; threads are real, the memory is genuinely shared across them, and
  ;; atomic.add is genuinely atomic - if any of those were faked, concurrent
  ;; increments would very likely lose updates under real OS scheduling and
  ;; the total would come out wrong.
  (fn run_thread_tests [] -> i32
    (unsafe (let counter:i32 (mem.alloc 4))
    (mem.store32 counter 0)
    (let worker:(fn [i32] -> i32) (ref worker_increment))

    (let t1:i32 (call thread_spawn worker counter))
    (let t2:i32 (call thread_spawn worker counter))
    (let t3:i32 (call thread_spawn worker counter))
    (let t4:i32 (call thread_spawn worker counter))
    (let _j1:i32 (call thread_join t1))
    (let _j2:i32 (call thread_join t2))
    (let _j3:i32 (call thread_join t3))
    (let _j4:i32 (call thread_join t4))

    (if (eq (mem.load32 counter) 4000) 1 0))))
