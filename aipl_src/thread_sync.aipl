;; Native Stage 0 Multithreading & Atomic Synchronization Module
;; Thin AIPL wrappers over real thread.spawn/thread.join/atomic.* opcodes.
;; thread.spawn launches a genuine OS thread (std::thread in the VM, see
;; src/vm.rs) sharing this program's real linear memory; atomic.lock/unlock
;; is a real spinlock backed by that shared memory, not a side-table that
;; nothing ever waits on. The previous version of this file's thread_spawn
;; took its arguments, did nothing with them, and returned the literal 101 -
;; that has been replaced with the real opcode below.
;; The wasm backend does not support thread.spawn/join yet (needs shared
;; memory + wasi-threads); compiling a program that uses them to .wasm is a
;; compile error, not a silent no-op - see src/compiler/wasm.rs.

(module thread_sync

  (fn atomic_add [ptr:i32 val:i32] -> i32
    (req (gte ptr 0))
    (atomic.add ptr val))

  (fn atomic_cas [ptr:i32 expected:i32 new_val:i32] -> bool
    (req (gte ptr 0))
    (atomic.cas ptr expected new_val))

  ;; Real spinlock acquire: blocks (busy-waits) until the memory word at
  ;; mutex_ptr is free. mutex_ptr must be an address dedicated to this lock,
  ;; distinct from any data it protects - the lock word IS that memory.
  (fn atomic_lock [mutex_ptr:i32] -> i32
    (req (gte mutex_ptr 0))
    (atomic.lock mutex_ptr)
    1)

  (fn atomic_unlock [mutex_ptr:i32] -> i32
    (req (gte mutex_ptr 0))
    (atomic.unlock mutex_ptr)
    0)

  ;; Spawns a real OS thread running `fn_name` (named by pointer+length into
  ;; linear memory - AIPL has no first-class function values yet, so a
  ;; pointer to a symbol table entry isn't an option either) with a single
  ;; i32 argument. Returns a thread handle for thread_join.
  (fn thread_spawn [fn_name_ptr:i32 fn_name_len:i32 arg:i32] -> i32
    (req (gte fn_name_ptr 0))
    (req (gt fn_name_len 0))
    (thread.spawn fn_name_ptr fn_name_len arg))

  ;; Blocks until the given thread finishes; returns its function's result.
  (fn thread_join [handle:i32] -> i32
    (thread.join handle))

  ;; Worker used by the self-test: increments the shared counter at address
  ;; 700, `count` times.
  (fn worker_increment [count:i32] -> i32
    (loop i 0 (- count 1) 1
      (let _r:i32 (call atomic_add 700 1)))
    0)

  ;; Master Multithreading Self-Test: spawns 4 REAL OS threads that each
  ;; increment a SHARED counter 1000 times via atomic.add, joins all of them,
  ;; and checks the final total is exactly 4000. This can only pass if the
  ;; threads are real, the memory is genuinely shared across them, and
  ;; atomic.add is genuinely atomic - if any of those were faked, concurrent
  ;; increments would very likely lose updates under real OS scheduling and
  ;; the total would come out wrong.
  (fn run_thread_tests [] -> i32
    (mem.store32 700 0)
    (mem.store8 (+ 800 0) 119) ;; 'w'
    (mem.store8 (+ 800 1) 111) ;; 'o'
    (mem.store8 (+ 800 2) 114) ;; 'r'
    (mem.store8 (+ 800 3) 107) ;; 'k'
    (mem.store8 (+ 800 4) 101) ;; 'e'
    (mem.store8 (+ 800 5) 114) ;; 'r'
    (mem.store8 (+ 800 6) 95)  ;; '_'
    (mem.store8 (+ 800 7) 105) ;; 'i'
    (mem.store8 (+ 800 8) 110) ;; 'n'
    (mem.store8 (+ 800 9) 99)  ;; 'c'
    (mem.store8 (+ 800 10) 114) ;; 'r'
    (mem.store8 (+ 800 11) 101) ;; 'e'
    (mem.store8 (+ 800 12) 109) ;; 'm'
    (mem.store8 (+ 800 13) 101) ;; 'e'
    (mem.store8 (+ 800 14) 110) ;; 'n'
    (mem.store8 (+ 800 15) 116) ;; 't'
    (let name_len:i32 16)

    (let t1:i32 (call thread_spawn 800 name_len 1000))
    (let t2:i32 (call thread_spawn 800 name_len 1000))
    (let t3:i32 (call thread_spawn 800 name_len 1000))
    (let t4:i32 (call thread_spawn 800 name_len 1000))
    (let _j1:i32 (call thread_join t1))
    (let _j2:i32 (call thread_join t2))
    (let _j3:i32 (call thread_join t3))
    (let _j4:i32 (call thread_join t4))

    (if (eq (mem.load32 700) 4000) 1 0)))
