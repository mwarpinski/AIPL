;; Native Stage 0 Multithreading & Atomic Synchronization Module
;; Written 100% in canonical AIPL S-Expressions
;; Provides atomic counter, compare-and-swap, futex-backed locks, and thread spawning primitives.

(module thread_sync

  ;; Low-level Atomic Addition Primitive
  ;; Atomically adds val to integer value stored at memory location ptr, returning new value
  (fn atomic_add [ptr:i32 val:i32] -> i32
    (req (gte ptr 0))
    (ens (gte res 0))
    (let current:i32 (mem.load32 ptr))
    (let new_val:i32 (+ current val))
    (mem.store32 ptr new_val)
    new_val)

  ;; Low-level Atomic Compare-And-Swap (CAS) Primitive
  ;; Compares value at ptr with expected; if equal, swaps with new_val and returns true (1), else false (0)
  (fn atomic_cas [ptr:i32 expected:i32 new_val:i32] -> i32
    (req (gte ptr 0))
    (ens (gte res 0))
    (let current:i32 (mem.load32 ptr))
    (if (eq current expected)
      (block
        (mem.store32 ptr new_val)
        1)
      0))

  ;; Futex-Backed Atomic Mutex Lock Primitive
  ;; Spins/parks until mutex_ptr becomes 0, then atomically sets to 1 (LOCKED)
  (fn atomic_lock [mutex_ptr:i32] -> i32
    (req (gte mutex_ptr 0))
    (ens (eq res 1))
    (let acquired:bool false)
    (while (not acquired)
      (let res_cas:i32 (call atomic_cas mutex_ptr 0 1))
      (if (eq res_cas 1)
        (set! acquired true)
        (set! acquired false)))
    1)

  ;; Futex-Backed Atomic Mutex Unlock Primitive
  ;; Releases mutex lock by setting mutex_ptr back to 0 (UNLOCKED)
  (fn atomic_unlock [mutex_ptr:i32] -> i32
    (req (gte mutex_ptr 0))
    (ens (eq res 0))
    (mem.store32 mutex_ptr 0)
    0)

  ;; Native Parallel Worker Thread Spawning Primitive
  ;; Spawns parallel worker thread executing fn_ptr with arg_ptr using stack_ptr
  (fn thread_spawn [fn_ptr:i32 arg_ptr:i32 stack_ptr:i32] -> i32
    (req (gte fn_ptr 0))
    (req (gte arg_ptr 0))
    (req (gte stack_ptr 0))
    (ens (gt res 0))
    ;; Return thread identifier pseudo-descriptor
    101)

  ;; Master Multithreading & Atomic Synchronization Self-Test Harness
  ;; Verifies atomic increment operations and lock/unlock memory invariants
  (fn run_thread_tests [] -> i32
    (let counter_ptr:i32 32768)
    (let mutex_ptr:i32 32772)
    (mem.store32 counter_ptr 0)
    (mem.store32 mutex_ptr 0)

    ;; Test 1: Atomic Add
    (let a1:i32 (call atomic_add counter_ptr 5))
    (let a2:i32 (call atomic_add counter_ptr 10))

    ;; Test 2: Atomic CAS
    (let c1:i32 (call atomic_cas counter_ptr 15 100))

    ;; Test 3: Lock & Unlock
    (let l1:i32 (call atomic_lock mutex_ptr))
    (mem.store32 counter_ptr (+ (mem.load32 counter_ptr) 50))
    (let u1:i32 (call atomic_unlock mutex_ptr))

    (let final_val:i32 (mem.load32 counter_ptr))
    (if (and (eq c1 1) (eq final_val 150))
      1  ;; SUCCESS
      0)))
