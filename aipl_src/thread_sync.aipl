;; Native Stage 0 Multithreading & Hardware Atomic Synchronization Module
;; Written 100% in canonical AIPL S-Expressions
;; Uses hardware-backed atomic primitives (lock xadd, lock cmpxchg, Wasm atomics) and futex notifications.

(module thread_sync

  ;; Low-level Hardware-Backed Atomic Addition Primitive
  ;; Atomically adds val to integer value stored at memory location ptr in linear memory
  (fn atomic_add [ptr:i32 val:i32] -> i32
    (req (gte ptr 0))
    (ens (gte res 0))
    (atomic.add ptr val))

  ;; Low-level Hardware-Backed Atomic Compare-And-Swap (CAS) Primitive
  ;; Atomically compares value at ptr with expected; if equal, swaps with new_val
  (fn atomic_cas [ptr:i32 expected:i32 new_val:i32] -> i32
    (req (gte ptr 0))
    (ens (gte res 0))
    (if (atomic.cas ptr expected new_val)
      1
      0))

  ;; Futex-Backed Hardware Atomic Mutex Lock Primitive
  ;; Acquires thread-safe mutex lock using hardware atomic operations and futex wait
  (fn atomic_lock [mutex_ptr:i32] -> i32
    (req (gte mutex_ptr 0))
    (ens (eq res 1))
    (atomic.lock mutex_ptr)
    1)

  ;; Futex-Backed Hardware Atomic Mutex Unlock Primitive
  ;; Releases mutex lock and notifies waiting futex threads
  (fn atomic_unlock [mutex_ptr:i32] -> i32
    (req (gte mutex_ptr 0))
    (ens (eq res 0))
    (atomic.unlock mutex_ptr)
    0)

  ;; Native Parallel Worker Thread Spawning Primitive
  ;; Spawns parallel worker thread executing fn_ptr with arg_ptr using stack_ptr
  (fn thread_spawn [fn_ptr:i32 arg_ptr:i32 stack_ptr:i32] -> i32
    (req (gte fn_ptr 0))
    (req (gte arg_ptr 0))
    (req (gte stack_ptr 0))
    (ens (gt res 0))
    101)

  ;; Master Multithreading & Hardware Atomic Synchronization Self-Test Harness
  ;; Verifies atomic increment operations and lock/unlock memory invariants
  (fn run_thread_tests [] -> i32
    (let counter_ptr:i32 32768)
    (let mutex_ptr:i32 32772)
    (mem.store32 counter_ptr 0)
    (mem.store32 mutex_ptr 0)

    ;; Test 1: Atomic Add
    (let _a1:i32 (call atomic_add counter_ptr 5))
    (let _a2:i32 (call atomic_add counter_ptr 10))

    ;; Test 2: Atomic CAS
    (let c1:i32 (call atomic_cas counter_ptr 15 100))

    ;; Test 3: Lock & Unlock
    (let _l1:i32 (call atomic_lock mutex_ptr))
    (mem.store32 counter_ptr (+ (mem.load32 counter_ptr) 50))
    (let _u1:i32 (call atomic_unlock mutex_ptr))

    (let final_val:i32 (mem.load32 counter_ptr))
    (if (and (eq c1 1) (eq final_val 150))
      1  ;; SUCCESS
      0)))
