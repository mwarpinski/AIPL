;; fannkuch: the Benchmarks Game's fannkuch-redux (single-threaded). For every
;; permutation of 0..n-1, repeatedly reverse the first perm[0]+1 elements
;; until 0 comes first, counting flips; report a checksum and the most
;; flips. Pure integer arrays and loops.
;;
;;   ./fannkuch 7   ->   228 / Pfannkuchen(7) = 16
(module fannkuch
  (import io)
  (import os)
  (import str)
  (import buf)
  (import time)

  (fn size_wanted [] -> i32
    (if (gt (call os.arg_count) 1)
        (match_result (call str.parse_int (call os.arg 1)) (ok v v) (err e 7))
        7))

  (fn main [] -> i32
    (let started:i64 (call time.now))
    (let n:i32 (call size_wanted))
    (let perm:(arr i32) (arr.new i32 n))
    (let perm1:(arr i32) (arr.new i32 n))
    (let count:(arr i32) (arr.new i32 n))
    (loop i 0 (- n 1) 1 (arr.set i32 perm1 i i))
    (let max_flips:i32 0)
    (let checksum:i32 0)
    (let perm_count:i32 0)
    (let r:i32 n)
    (let done:bool false)
    (while (not done)
      (while (neq r 1)
        (arr.set i32 count (- r 1) r)
        (set! r (- r 1)))
      (loop i 0 (- n 1) 1 (arr.set i32 perm i (arr.get i32 perm1 i)))
      ;; flip until 0 is first
      (let flips:i32 0)
      (let k:i32 (arr.get i32 perm 0))
      (while (neq k 0)
        (let lo:i32 0)
        (let hi:i32 k)
        (while (lt lo hi)
          (let t:i32 (arr.get i32 perm lo))
          (arr.set i32 perm lo (arr.get i32 perm hi))
          (arr.set i32 perm hi t)
          (set! lo (+ lo 1))
          (set! hi (- hi 1)))
        (set! flips (+ flips 1))
        (set! k (arr.get i32 perm 0)))
      (if (gt flips max_flips) (set! max_flips flips) (block))
      (set! checksum (if (eq (% perm_count 2) 0) (+ checksum flips) (- checksum flips)))
      ;; the next permutation, by rotating prefixes
      (let next:bool false)
      (while (not next)
        (if (eq r n)
            (block (set! done true) (set! next true))
            (block
              (let perm0:i32 (arr.get i32 perm1 0))
              (loop i 0 (- r 1) 1 (arr.set i32 perm1 i (arr.get i32 perm1 (+ i 1))))
              (arr.set i32 perm1 r perm0)
              (arr.set i32 count r (- (arr.get i32 count r) 1))
              (if (gt (arr.get i32 count r) 0) (set! next true) (set! r (+ r 1))))))
      (set! perm_count (+ perm_count 1)))
    (let b:(ptr buf.Buf) (call buf.make 64))
    (call buf.push_int b checksum)
    (call buf.push_str b "\nPfannkuchen(")
    (call buf.push_int b n)
    (call buf.push_str b ") = ")
    (call buf.push_int b max_flips)
    (call buf.push_byte b 10)
    (let _w:i32 (fs.write 1 (get b buf.Buf.data) (call buf.len b)))
    (call time.report "fannkuch computed in" started)
    0))
