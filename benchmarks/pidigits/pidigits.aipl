;; pidigits: the first N digits of pi (default 1000) by Gibbons' unbounded
;; spigot, as in the Benchmarks Game, on std/bigint. Output as spigot: ten
;; digits per line, then a tab, a colon, and the count so far.
;;
;;   aipl compile --exe benchmarks/pidigits/pidigits.aipl -o pidigits && ./pidigits 1000
;; Prints the time the computation took on stderr (std/time).
(module pidigits
  (import alloc)
  (import os)
  (import buf)
  (import time)
  (import bigint)

  ;; The state (numer, accum, denom) and a scratch number, all reused.
  ;; accum goes negative at times.
  (struct State [numer:(ptr bigint.Int) accum:(ptr bigint.Int) denom:(ptr bigint.Int) t:(ptr bigint.Int)])
  (struct Out [b:(ptr buf.Buf) count:i32])

  (fn next_term [s:(ptr State) k:i32] -> void
    (let k2:i32 (+ (* k 2) 1))
    (call bigint.add_mul_small (get s State.accum) (get s State.numer) 2)
    (call bigint.mul_small (get s State.accum) k2)
    (call bigint.mul_small (get s State.denom) k2)
    (call bigint.mul_small (get s State.numer) k))

  ;; (numer * nth + accum) / denom, which is a single digit here (it is
  ;; only asked for when accum >= numer > 0)
  (fn extract_digit [s:(ptr State) nth:i32] -> i32
    (let t:(ptr bigint.Int) (get s State.t))
    (call bigint.assign t (get s State.accum))
    (call bigint.add_mul_small t (get s State.numer) nth)
    (call bigint.div_small_quotient t (get s State.denom)))

  (fn eliminate_digit [s:(ptr State) d:i32] -> void
    (call bigint.sub_mul_small (get s State.accum) (get s State.denom) d)
    (call bigint.mul_small (get s State.accum) 10)
    (call bigint.mul_small (get s State.numer) 10))

  (fn emit [o:(ptr Out) d:i32] -> void
    (let b:(ptr buf.Buf) (get o Out.b))
    (call buf.push_byte b (+ 48 d))
    (put o Out.count (+ (get o Out.count) 1))
    (if (eq (% (get o Out.count) 10) 0)
        (block (call buf.push_str b "\t:") (call buf.push_int b (get o Out.count)) (call buf.push_byte b 10))
        (block)))

  (fn finish [o:(ptr Out)] -> void
    (let b:(ptr buf.Buf) (get o Out.b))
    (let left:i32 (% (get o Out.count) 10))
    (if (neq left 0)
        (block
          (loop k left 9 1 (call buf.push_byte b 32))
          (call buf.push_str b "\t:")
          (call buf.push_int b (get o Out.count))
          (call buf.push_byte b 10))
        (block)))

  (fn main [] -> i32
    (let started:i64 (call time.now))
    (let n:i32 (call os.arg_int 1 1000))
    (let s:(ptr State) (new State))
    (put s State.numer (call bigint.from_i32 1))
    (put s State.accum (call bigint.from_i32 0))
    (put s State.denom (call bigint.from_i32 1))
    (put s State.t (call bigint.from_i32 0))
    (let o:(ptr Out) (new Out))
    (put o Out.b (call buf.make (call alloc.default) (+ (* n 2) 64)))
    (put o Out.count 0)
    (let k:i32 0)
    (while (lt (get o Out.count) n)
      (set! k (+ k 1))
      (call next_term s k)
      (if (lte (call bigint.compare (get s State.numer) (get s State.accum)) 0)
          (block
            (let d:i32 (call extract_digit s 3))
            (if (eq d (call extract_digit s 4))
                (block (call emit o d) (call eliminate_digit s d))
                (block)))
          (block)))
    (call finish o)
    ;; the computation's own time, on stderr (the digits stay the output)
    (call time.report "pidigits computed in" started)
    (let out:(ptr buf.Buf) (get o Out.b))
    (call buf.print out)
    0))
