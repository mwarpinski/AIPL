;; Formally Verified Quicksort Partition Step written in AIPL
(module sorting_algo
  (fn partition_step [pivot:i32 val1:i32 val2:i32] -> i32
    (req (gte pivot 0))
    (ens (gte res 0))
    (if (lt val1 pivot)
        val1
        val2))

  (fn sort_trio [a:i32 b:i32 c:i32] -> i32
    (let p:i32 (call partition_step b a c))
    p))
