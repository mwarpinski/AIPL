;; spectralnorm (benchmarks/spectralnorm) with its matrix-vector products
;; on several threads through std/par, with no unsafe: each row of a
;; product is one element of par.map's output, each part gets its own copy
;; of the vector, and the context is a plain value struct.
;;
;;   aipl compile --exe examples/spectralnorm_par.aipl -o snp
;;   ./snp 1000 8        ->   1.274224153 (n = 1000 on 8 threads)
(module spectralnorm_par
  (import alloc)
  (import io)
  (import os)
  (import par)

  (struct Size [n:i32 transposed:bool] (value))

  (fn a [i:i32 j:i32] -> f64
    (/ 1.0 (f64.convert_i64_s (i64.extend_s (+ (/ (* (+ i j) (+ (+ i j) 1)) 2) (+ i 1))))))

  ;; row i of A v
  (fn row [s:Size v:(arr f64) i:i32] -> f64
    (let sum:f64 0.0)
    (for j 0 (get s Size.n)
      (set! sum (+ sum (* (call a i j) (arr.get f64 v j)))))
    sum)

  ;; row i of A' v
  (fn row_transposed [s:Size v:(arr f64) i:i32] -> f64
    (let sum:f64 0.0)
    (for j 0 (get s Size.n)
      (set! sum (+ sum (* (call a j i) (arr.get f64 v j)))))
    sum)

  (fn times [n:i32 v:(arr f64) out:(arr f64) transposed:bool threads:i32] -> void
    (call (par.map f64 f64 Size) out (if transposed (ref row_transposed) (ref row)) (make Size [n:n
                                                                                                transposed:transposed]) v threads))

  (fn main [] -> i32
    (let n:i32 (call os.arg_int 1 100))
    (let threads:i32 (call os.arg_int 2 4))
    (let u:(arr f64) (arr.new f64 (call alloc.forever) n))
    (let v:(arr f64) (arr.new f64 (call alloc.forever) n))
    (let tmp:(arr f64) (arr.new f64 (call alloc.forever) n))
    (for i 0 n (arr.set f64 u i 1.0))
    (for round 1 11
      (call times n u tmp false threads)
      (call times n tmp v true threads)
      (call times n v tmp false threads)
      (call times n tmp u true threads))
    (let vbv:f64 0.0)
    (let vv:f64 0.0)
    (for i 0 n
      (set! vbv (+ vbv (* (arr.get f64 u i) (arr.get f64 v i))))
      (set! vv (+ vv (* (arr.get f64 v i) (arr.get f64 v i)))))
    (call io.print_f64 (f64.sqrt (/ vbv vv)) 9)
    (call io.println "")
    0))
