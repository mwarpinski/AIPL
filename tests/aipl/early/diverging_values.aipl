(module diverging_values
  (import io)
  (struct V [x:i32 y:f64] (value))
  (fn c1 [n:i32] -> i32
    (let t:i32 (cond ((lt n 0) (return -1)) ((eq n 0) 0) (else (* n 2))))
    (+ t 1))
  (fn c2 [n:i32] -> i32
    (let t:i32 (cond ((gt n 0) 5) ((eq n 0) (return 0)) (else (return -5))))
    t)
  (fn r [n:i32] -> (result V i32) (if (gt n 0) (ok:i32 (make V n 2.5)) (err:V n)))
  (fn vr [n:i32] -> f64
    (let v:V (match_result (call r n) (ok x x) (err e (return (f64.convert_i64_s (i64.extend_s e))))))
    (get v V.y))
  (fn main [] -> i32
    (call io.println_int "" (call c1 -3))
    (call io.println_int "" (call c1 0))
    (call io.println_int "" (call c1 4))
    (call io.println_int "" (call c2 1))
    (call io.println_int "" (call c2 -1))
    (call io.println_f64 "" (call vr 3) 1)
    (call io.println_f64 "" (call vr -2) 1)
    0))
