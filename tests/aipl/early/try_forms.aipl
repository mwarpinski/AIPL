(module try_forms
  (import str)
  (import option)
  (fn digit [c:i32] -> (result i32 str)
    (if (and (gte c 48) (lte c 57)) (ok:str (- c 48)) (err:i32 "not a digit")))
  (fn two [s:str.Bytes] -> (result i32 str)
    (let a:i32 (try (call digit (call str.byte_at s 0))))
    (let b:i32 (try (call digit (call str.byte_at s 1))))
    (ok:str (+ (* a 10) b)))
  (fn half [n:i32] -> (option.Option i32)
    (if (eq (% n 2) 0) (make (option.Option i32) some (/ n 2)) (make (option.Option i32) none)))
  (fn quarter [n:i32] -> (option.Option i32)
    (let h:i32 (try_opt (call half n)))
    (call half h))
  (fn half_or [n:i32] -> (result i32 str)
    (ok:str (+ 1000 (try_or (call half n) "odd"))))
  (fn nested [n:i32] -> (result i32 str)
    (ok:str (try (call digit (+ 48 (try_or (call half n) "odd"))))))
  (fn main [] -> i32
    (match_result (call two (call str.from_str "42")) (ok v (println "two 42 = {v}")) (err e (println "err {e}")))
    (match_result (call two (call str.from_str "4x")) (ok v (println "two 4x = {v}")) (err e (println "err {e}")))
    (match (call quarter 12) ((option.Option i32) some [q] (println "quarter 12 = {q}")) ((option.Option i32) none (println "none")))
    (match (call quarter 6) ((option.Option i32) some [q] (println "quarter 6 = {q}")) ((option.Option i32) none (println "quarter 6: none")))
    (match_result (call half_or 8) (ok v (println "half_or 8 = {v}")) (err e (println "err {e}")))
    (match_result (call half_or 7) (ok v (println "half_or 7 = {v}")) (err e (println "half_or 7: {e}")))
    (match_result (call nested 14) (ok v (println "nested 14 = {v}")) (err e (println "err {e}")))
    (match_result (call nested 30) (ok v (println "nested 30 = {v}")) (err e (println "nested 30: {e}")))
    0))
