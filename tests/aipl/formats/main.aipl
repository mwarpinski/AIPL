;; The formatting forms (AIPL_SPEC.md 4.K) in every backend: tests/test_formats.rs.
(module main
  (import buf)
  (import alloc)
  (import vec)
  (import lib)
  (enum Color [red green (blue 7)])
  (const LIMIT:i32 99)
  (struct P [x:f64 y:i32])
  (struct (Box T) [v:T])
  (fn (describe T) [b:(ptr (Box T)) label:str] -> str (format "{label}: boxed"))
  (fn (count_to T) [xs:(ptr (vec.Vec T)) n:i32] -> void
    (for i 1 (+ n 1) (println "item {i} of {n}")))
  (fn main [] -> i32
    (let name:str "Ada")
    (let n:i32 3)
    (let mean:f64 2.71828)
    (println "{name} ran {n} tests, mean {mean:.2}")
    (let p:(ptr P) (new P (call alloc.forever)))
    (put p P.x 1.5)
    (let s:str (format "{n:>5}|{(get p P.x)}|{{}}|{LIMIT:x}|{Color.blue}"))
    (println "s = [{s}] len {(str.len s)}")
    (let b:(ptr buf.Buf) (call buf.make (call alloc.default) 16))
    (for i 1 4 (format_to b "row {i}: {(* i i):03};"))
    (println "{(call buf.bytes b)}")
    (print "no newline {true} ")
    (println "{0.1} {1.0e16} {100.0} {(/ 1.0 3.0)} {-7i64:08} {-2.5f32:+} {255:#>6X} {5:b}")
    (eprintln "to stderr")
    (call lib.report 21)
    (let bx:(ptr (Box i32)) (new (Box i32) (call alloc.forever)))
    (let d:str (call (describe i32) bx "x"))
    (println "{d}")
    (call (count_to f64) (call (vec.make f64) (call alloc.default) 4) 2)
    (let c:Color Color.green)
    (println "color {c} {Color.red:>8}| {(str.len name)}")
    0))
