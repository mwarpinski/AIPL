;; Values std/show cannot print on its own, through the printers formatting
;; generates (tests/test_formats.rs; formats.rs debug_functions): structs
;; behind pointers, value structs, arrays, unions, results, and generic
;; instances of them, in every backend and both toolchains.
(module values
  (import str)
  (import option)
  (struct Q [k:i32])
  (struct V [a:i32 b:f64] (value))
  (struct Pair [left:V right:V] (value))
  (struct Small [tiny:u8 neg:i16 f:(fn [i32] -> i32)])
  (struct Row [n:i32 name:str q:(ptr Q) xs:(arr i32) at:V sh:Shade label:str.Bytes none:(ptr Q)])
  (struct (Box T) [item:T])
  (enum Shade [light dark])
  (union Shape [(circle r:f64) (boxed w:i32 h:i32) (empty)])
  (union Tree [(leaf n:i32) (node left:Tree right:Tree)])

  (fn inc [x:i32] -> i32 (+ x 1))

  (fn main [] -> i32
    (let r:(ptr Row) (new Row))
    (put r Row.n 2)
    (put r Row.name "a")
    (put r Row.q (new Q))
    (put r Row.xs (arr.new i32 3))
    (put r Row.at (make V 1 2.5))
    (put r Row.sh Shade.dark)
    (put r Row.label (call str.from_str "lab"))
    (put r Row.none (ptr.null Q))
    (println "{r}")
    (println "{(ptr.null Row)}")
    (let xs:(arr i32) (arr.new i32 20))
    (arr.set i32 xs 3 7)
    (println "{xs}")
    (let names:(arr str) (arr.new str 2))
    (arr.set str names 0 "x")
    (arr.set str names 1 "y")
    (println "{names} {(arr.new f64 0)}")
    (println "{(make Shape.boxed 2 3)} {(make Shape.empty)} {(make Shape.circle 0.5)}")
    (let t:Tree (make Tree.node (make Tree.leaf 1) (make Tree.node (make Tree.leaf 2) (make Tree.leaf 3))))
    (println "{t}")
    (let os:(option.Option str) (make (option.Option str) some "x"))
    (let no:(option.Option i32) (make (option.Option i32) none))
    (println "{os} {no}")
    (let good:(result i32 str) (ok:str 4))
    (let bad:(result i32 str) (err:i32 "bad"))
    (println "{good} {bad}")
    (println "{(make Pair (make V 1 0.5) (make V 2 1.5))}")
    (let s:(ptr Small) (new Small))
    (put s Small.tiny 255)
    (put s Small.neg -3)
    (put s Small.f (ref inc))
    (println "{s}")
    (let b:(ptr (Box i32)) (new (Box i32)))
    (put b (Box i32) item 9)
    (println "box {b} done")
    0))
