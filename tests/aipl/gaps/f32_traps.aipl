(module f32_traps
  (import io)
  (import os)
  (fn main [] -> i32
    (let m:i32 (call os.arg_int 1 0))
    (cond
      ((eq m 1) (println "{(i32.trunc_f32_s (/ 0.0f32 0.0f32))}"))
      ((eq m 2) (println "{(i32.trunc_f64_s 2147483648.0)}"))
      ((eq m 3) (println "{(i32.trunc_f64_s -2147483648.9)}"))
      ((eq m 4) (println "{(i32.trunc_f64_s -2147483649.0)}"))
      ((eq m 5) (println "{(i32.trunc_f32_s -2147483648.0f32)}"))
      ((eq m 6) (println "{(i32.trunc_f32_s 2147483648.0f32)}"))
      ((eq m 7) (println "{(i64.trunc_f32_s -9223372036854775808.0f32)}"))
      ((eq m 8) (println "{(i64.trunc_f32_s 9223372036854775808.0f32)}"))
      ((eq m 9) (println "{(i32.trunc_f32_s -2147483904.0f32)}"))
      ((eq m 10) (println "{(i32.trunc_f64_s (/ 0.0 0.0))}"))
      ((eq m 11) (println "{(i64.trunc_f32_s (/ 1.0f32 0.0f32))}"))
      ((eq m 12) (println "{(i32.trunc_f32_s 2147483520.0f32)}"))
      (else (block)))
    0))
