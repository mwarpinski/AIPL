(module f32_values
  (import io)
  (import os)
  (struct P [x:f32 y:f32])
  (fn show [label:str x:f32] -> void (call io.println_f64 label (f64.promote x) 9))
  (fn main [] -> i32
    (let mode:i32 (call os.arg_int 1 0))
    (let a:f32 0.1f32)
    (let b:f32 (+ a 0.2f32))                   ;; rounds to f32 each step
    (call show "0.1+0.2 " b)
    (call io.println_int "bits " (i32.reinterpret_f32 b))
    (call io.println_int "bits 1.0 " (i32.reinterpret_f32 1.0f32))
    (call show "third " (/ 1.0f32 3.0f32))
    (call show "demote " (f32.demote 3.141592653589793))
    (call show "from i32 " (f32.convert_i32_s 16777217))   ;; rounds to 16777216
    (call show "from i64 " (f32.convert_i64_s 9007199254740993i64))
    (call io.println_f64 "f64 from i32 " (f64.convert_i32_s -7) 1)
    (call io.println_int "trunc f32 " (i32.trunc_f32_s -2.9f32))
    (call io.println_int "trunc f64 " (i32.trunc_f64_s 2147483647.9))
    (call io.println_i64 "trunc f32 i64 " (i64.trunc_f32_s 1.0e10f32))
    (call show "reinterpret " (f32.reinterpret_i32 1078530011))
    (let p:(ptr P) (new P))
    (put p P.x 1.5f32)
    (put p P.y (* (get p P.x) 2.0f32))
    (call show "field " (get p P.y))
    (if (lt a b) (call io.println "lt ok") (block))
    (if (eq (+ 0.5f32 0.25f32) 0.75f32) (call io.println "eq ok") (block))
    (cond
      ((eq mode 1) (call io.println_int "nan " (i32.trunc_f32_s (/ 0.0f32 0.0f32))))
      ((eq mode 2) (call io.println_int "big " (i32.trunc_f64_s 2147483648.0)))
      (else (block)))
    0))
