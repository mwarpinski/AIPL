(module storage
  (import alloc)
  (import pixel)
  (import io)
  (struct Rec [tag:u8 delta:i8 len:u16 off:i16 x:i32])
  (fn main [] -> i32 (unsafe)
    (let r:(ptr Rec) (new Rec (call alloc.forever) [tag:300
                                                    delta:(zero i8)
                                                    len:(zero u16)
                                                    off:(zero i16)
                                                    x:(zero i32)]))         ;; keeps the low 8 bits: 44
    (put r Rec.delta 200)       ;; -56 as i8
    (put r Rec.len 70000)       ;; 4464
    (put r Rec.off -2)
    (put r Rec.x 7)
    (call io.println_int "tag " (get r Rec.tag))
    (call io.println_int "delta " (get r Rec.delta))
    (call io.println_int "len " (get r Rec.len))
    (call io.println_int "off " (get r Rec.off))
    (call io.println_int "sizeof Rec " (sizeof Rec))
    (call io.println_int "sizeof u16 " (sizeof u16))
    (let bytes:(arr u8) (arr.new u8 (call alloc.forever) 5))
    (for i 0 5 (arr.set u8 bytes i (* i 100)))
    (let t:i32 0)
    (for i 0 5 (set! t (+ t (arr.get u8 bytes i))))
    (call io.println_int "sum of bytes " t)     ;; 0 100 200 44 144 = 488
    (let s:(arr i16) (arr.new i16 (call alloc.forever) 2))
    (arr.set i16 s 1 -300)
    (call io.println_int "i16 " (arr.get i16 s 1))
    (let p:(ptr pixel.Pixel) (new pixel.Pixel (call alloc.forever) [r:30 g:60 b:90 a:(zero u8)]))
    (call io.println_int "gray " (call pixel.gray p))
    (let m:i32 (mem.alloc 8))
    (mem.store16 m -2)
    (call io.println_int "load16_u " (mem.load16_u m))
    (call io.println_int "load16_s " (mem.load16_s m))
    (call io.println_int "load8_s " (mem.load8_s m))
    (call io.println_int "load8 " (mem.load8 m))
    0))
