a.txt => file=a.txt v=false q=false min=1 out= more=0
-v a.txt b c => file=a.txt v=true q=false min=1 out= more=2
-vq --min 3 a.txt => file=a.txt v=true q=true min=3 out= more=0
--min=4 -m5 --out=x a.txt => file=a.txt v=false q=false min=5 out=x more=0
-m 6 -- -v => file=-v v=false q=false min=6 out= more=0
- --verbose => file=- v=true q=false min=1 out= more=0
--min abc a.txt => file=a.txt v=false q=false min='abc' for min is not an integer out= more=0
