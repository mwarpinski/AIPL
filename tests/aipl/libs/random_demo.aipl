;; std/random and std/uuid (tests/test_libs.rs): PCG-32's reference
;; numbers, unbiased ranges, floats, a shuffle, a sample, normals, and
;; UUIDs, the same in every backend for one seed.
(module random_demo
  (import random)
  (import uuid)
  (import alloc)

  (fn main [] -> i32
    (let a:alloc.Allocator (call alloc.default))
    (let r:(ptr random.Rng) (call random.seeded a 42i64))
    ;; pcg32's demo, seed 42 on stream 54: a15c02b7 7b47f409 ba1d3330
    (let w:i64 (bitand (i64.extend_s (call random.next_u32 r)) 4294967295i64))
    (println "{w:x}")
    (let dice:(arr i32) (arr.new i32 (call alloc.forever) 7))
    (for k 0 6000 (let d:i32 (call random.range r 1 7)) (arr.set i32 dice d (+ (arr.get i32 dice d) 1)))
    (println "dice {(arr.get i32 dice 1)} {(arr.get i32 dice 2)} {(arr.get i32 dice 3)} {(arr.get i32 dice 4)} {(arr.get i32 dice 5)} {(arr.get i32 dice 6)}")
    (let lo:f64 1.0)
    (let hi:f64 0.0)
    (for k 0 1000
      (let x:f64 (call random.f64 r))
      (when (lt x lo) (set! lo x))
      (when (gt x hi) (set! hi x)))
    (println "f64 in [{lo:.3}, {hi:.3}]")
    (let xs:(arr i32) (arr.new i32 (call alloc.forever) 8))
    (for k 0 8 (arr.set i32 xs k k))
    (call (random.shuffle i32) r xs)
    (println "shuffled {xs}")
    (println "sample {(call (random.sample i32) a r xs 3)} choice {(call (random.choice i32) r xs)}")
    (let sum:f64 0.0)
    (for k 0 2000 (set! sum (+ sum (call random.normal r 10.0 2.0))))
    (println "normal mean {(/ sum 2000.0):.1}")
    (let id:str (call uuid.v4_from r))
    (println "uuid {id} valid {(call uuid.valid id)}")
    (let os:str (call uuid.v4))
    (println "os uuid valid {(call uuid.valid os)}")
    0))
