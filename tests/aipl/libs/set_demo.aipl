;; std/set (tests/test_libs.rs): adding, finding, removing, and the set
;; operations, over i32, str, and byte-string items.
(module set_demo
  (import set)
  (import alloc)
  (import str)
  (import vec)

  (fn main [] -> i32
    (let a:alloc.Allocator (call alloc.default))
    (let s:(ptr (set.Set i32)) (call (set.make i32) a 4))
    (for i 0 20 (let _n:bool (call (set.add i32) s (% i 7))))
    (println "count {(call (set.count i32) s)} has 3 {(call (set.has i32) s 3)} has 9 {(call (set.has i32) s 9)}")
    (println "add 3 again {(call (set.add i32) s 3)}, remove 3 {(call (set.remove i32) s 3)}, remove 3 again {(call (set.remove i32) s 3)}")
    (let t:(ptr (set.Set i32)) (call (set.make i32) a 4))
    (for i 4 10 (let _m:bool (call (set.add i32) t i)))
    (let u:(ptr (set.Set i32)) (call (set.union i32) a s t))
    (let n:(ptr (set.Set i32)) (call (set.intersection i32) a s t))
    (let d:(ptr (set.Set i32)) (call (set.difference i32) a s t))
    (println "union {(call (set.count i32) u)} both {(call (set.count i32) n)} only s {(call (set.count i32) d)} subset {(call (set.is_subset i32) n s)} {(call (set.is_subset i32) s n)}")
    (let both:(ptr (vec.Vec i32)) (call (set.items i32) a n))
    (let total:i32 0)
    (for k 0 (call (vec.len i32) both) (set! total (+ total (call (vec.at i32) both k))))
    (println "both sum {total}")
    (let w:(ptr (set.Set str)) (call (set.make str) a 8))
    (let _a:bool (call (set.add str) w "pear"))
    (let _b:bool (call (set.add str) w "fig"))
    (let _c:bool (call (set.add str) w "pear"))
    (let fig:bool (call (set.has str) w "fig"))
    (println "words {(call (set.count str) w)} fig {fig}")
    (let bs:(ptr (set.Set (ptr str.Bytes))) (call (set.make (ptr str.Bytes)) a 8))
    (let _d:bool (call (set.add (ptr str.Bytes)) bs (call str.from_str "ab")))
    (let ab:bool (call (set.has (ptr str.Bytes)) bs (call str.from_str "ab")))
    (println "bytes by contents {ab}")
    (call (set.free i32) s)
    0))
