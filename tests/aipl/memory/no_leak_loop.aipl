;; A (no_leak) handler run 10,000 times, each on a request arena reset
;; after it (tests/test_memory.rs): the checker accepts it, and the arena
;; holds no more memory after the last request than after the first.
(module no_leak_loop
  (import arena)
  (import alloc)
  (import buf)
  (import str)
  (fn handle [a:alloc.Allocator request:str.Bytes] -> i32 (no_leak)
    ;; a reply built in the request's own memory
    (let out:(ptr buf.Buf) (call buf.make a 64))
    (call buf.push_str out "you asked for ")
    (call buf.push_bytes out (call str.trim request))
    (call buf.push_int out (get request str.Bytes.len))
    (let n:i32 (call buf.len out))
    (call buf.free out)
    n)
  (fn main [] -> i32
    (let r:(ptr arena.Arena) (call arena.make 4096))
    (let a:alloc.Allocator (call alloc.of_arena r))
    (let total:i32 0)
    (let first:i32 0)
    (for i 0 10000
      (set! total (+ total (call handle a (call str.from_str "  /items/42  "))))
      (call arena.reset r)
      (when (eq i 0) (set! first (call arena.reserved r))))
    (println "{total} bytes of replies; arena {first} bytes after the first request, {(call arena.reserved r)} after the last")
    0))
