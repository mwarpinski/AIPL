;; Literals at the extremes of i32 and i64, folded and not, re-printed by
;; the optimizer (docs/NOTES_REVIEW.md, painpoints: "large literals
;; truncate to 32 bits when re-printed"): tools/opt_diff.py compares the
;; optimized build with the unoptimized one (both printed what aipl eval
;; prints, 2026-10-25).
(module literals
  (import io)
  (const BIG:i64 9000000000i64)
  (fn id64 [x:i64] -> i64 x)
  (fn id32 [x:i32] -> i32 x)
  (fn main [] -> i32
    (call io.println_i64 "a " 9000000000i64)
    (call io.println_i64 "b " -9223372036854775808i64)
    (call io.println_i64 "c " 9223372036854775807i64)
    (call io.println_i64 "d " (+ BIG 1i64))
    (call io.println_i64 "e " (call id64 (* 4294967296i64 3i64)))
    (call io.println_i64 "f " (i64.extend_u -1))
    (call io.println_i64 "g " (i64.extend_s -2147483648))
    (call io.println_int "h " (call id32 -2147483648))
    (call io.println_int "i " (i32.wrap 9000000000i64))
    (call io.println_int "j " (* 65536 65536))
    (call io.println_f64 "k " (f64.convert_i32_s 2147483647) 1)
    0))
