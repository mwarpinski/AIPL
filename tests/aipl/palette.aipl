;; Imported by tests/aipl/consts_enums.aipl: constants, an enum, an enum as a
;; struct field and as a generic type argument, all used from another module.
(module palette
  (import alloc)
  (import vec)
  (const LIMIT:i32 7 (pub))
  (const NAME:str "palette" (pub))
  (enum Color [red green (blue 10) cyan] (pub))
  (struct Swatch [(pub c:Color) (pub weight:i64)] (pub))
  (fn favourite [] -> Color (pub) Color.green)
  (fn is_red [c:Color] -> bool (pub) (eq c Color.red))
  (fn next [c:Color] -> Color (pub) (enum.cast Color (+ (enum.ord c) 1)))
  ;; the colours in order, as a generic list of the enum
  (fn all [] -> (ptr (vec.Vec Color)) (pub)
    (let v:(ptr (vec.Vec Color)) (call (vec.make Color) (call alloc.default) 4))
    (call (vec.push Color) v Color.red)
    (call (vec.push Color) v Color.green)
    (call (vec.push Color) v Color.blue)
    (call (vec.push Color) v Color.cyan)
    v))
