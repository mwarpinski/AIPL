;; Unions are values (AIPL_SPEC.md 4.J): every way one is made, matched,
;; passed, stored, and returned, and how a union that would contain itself
;; or need more than 8 slots holds a pointer instead, in one program whose
;; main returns a checksum. tests/test_values.rs runs it in every backend.
(module unions_by_value
  (import option)
  (import alloc)

  (struct Vec2 [x:f64 y:f64] (value))
  (struct Box [shape:Shape count:i32])
  (enum Color [red green blue])

  ;; every kind of slot (eight in all: the tag, an i32, two f32s, an i64,
  ;; three f64s); a value struct and an enum in a variant
  (union Shape [(dot) (circle at:Vec2 r:f64) (rect w:f32 h:f32) (big n:i64 color:Color)])
  ;; a whole Shape (eight slots) and a tag would be nine: the Shape is
  ;; behind a pointer
  (union Tagged [(plain s:(ptr Held)) (count n:i32)])
  (struct Held [s:Shape])
  ;; a union that would contain itself holds the rest through a pointer
  (union List [(nil) (cons head:i32 tail:(ptr Tail))])
  (struct Tail [l:List])
  ;; a value: a str is one slot
  (union Named [(name s:str) (anon)])
  ;; eight i64s and a tag would be nine slots: the fields are in a struct
  (union Wide [(nine n:(ptr Nine))])
  (struct Nine [a:i64 b:i64 c:i64 d:i64 e:i64 f:i64 g:i64 h:i64])
  ;; a union holding another
  (union HoldsWide [(w x:Wide) (none)])
  ;; a list of Shapes: a link's Shape and the rest beside it would be ten
  ;; slots, so both are in a struct
  (union Chain [(link n:(ptr Link)) (end)])
  (struct Link [s:Shape next:Chain])
  ;; a union holding one declared after it: decided after it (Inner's three
  ;; slots, then Outer's tag: four)
  (union Outer [(holds i:Inner) (empty)])
  (union Inner [(pair n:i32 f:f64)])

  (fn area [s:Shape] -> f64
    (match s
      (Shape.dot 0.0)
      (Shape.circle [at r] (+ (* 3.0 (* r r)) (get at Vec2.x)))
      (Shape.rect [w h] (* (f64.convert_i64_s (i64.extend_s (i32.wrap (i64.trunc_f64_s (* 1.0 0.0))))) 0.0))
      (Shape.big [n color] (if (eq color Color.blue) (f64.convert_i64_s n) -1.0))))

  ;; a match whose scrutinee is computed, yielding a union
  (fn grow [s:Shape] -> Shape
    (match (call identity s)
      (Shape.circle [at r] (make Shape.circle at (* r 2.0)))
      (else s)))

  (fn identity [s:Shape] -> Shape s)

  (fn tagged_area [t:Tagged] -> f64
    (match t
      (Tagged.plain [h] (call area (get h Held.s)))
      (Tagged.count [n] (f64.convert_i64_s (i64.extend_s n)))))

  (fn list_sum [l:List] -> i32
    (match l
      (List.nil 0)
      (List.cons [h t] (+ h (call list_sum (get t Tail.l))))))

  ;; head before rest, the cell from a
  (fn cons [a:alloc.Allocator head:i32 rest:List] -> List
    (let t:(ptr Tail) (call (alloc.create Tail) a))
    (put t Tail.l rest)
    (make List.cons head t))

  ;; a result holding a union by value: five slots (Shape's eight with the
  ;; result's tag would be nine, which is refused)
  (fn found [ok:bool] -> (result Outer i32)
    (if ok (ok:i32 (make Outer.holds (make Inner.pair 4 0.0))) (err:Outer 5)))

  (fn main [] -> i32
    (let a:alloc.Allocator (call alloc.default))
    (let total:f64 0.0)
    (let c:Shape (make Shape.circle (make Vec2 2.0 3.0) 1.0))
    (set! total (+ total (call area c)))                                      ;; 5
    (set! total (+ total (call area (call grow c))))                          ;; +14
    (set! total (+ total (call area (make Shape.big 40i64 Color.blue))))  ;; +40
    (set! total (+ total (call area (make Shape.dot))))                       ;; +0
    (let held:(ptr Held) (call (alloc.create Held) a))
    (put held Held.s c)
    (set! total (+ total (call tagged_area (make Tagged.plain held))))         ;; +5
    (set! total (+ total (call tagged_area (make Tagged.count 7))))           ;; +7 = 71
    ;; in a heap struct's field, and an array
    (let b:(ptr Box) (new Box))
    (put b Box.shape (make Shape.big 9i64 Color.blue))
    (set! total (+ total (call area (get b Box.shape))))                      ;; +9
    (let shapes:(arr Shape) (arr.new Shape 3))
    (arr.set Shape shapes 2 c)
    (set! total (+ total (call area (arr.get Shape shapes 2))))               ;; +5
    (set! total (+ total (call area (arr.get Shape shapes 0))))               ;; zero: dot, +0 = 85
    ;; a list, a name, a wide one, and a union holding it
    (let l:List (call cons a 3 (call cons a 4 (make List.nil))))
    (set! total (+ total (f64.convert_i64_s (i64.extend_s (call list_sum l)))))  ;; +7
    (let nm:Named (make Named.name "abc"))
    (match nm (Named.name [text] (set! total (+ total (f64.convert_i64_s (i64.extend_s (str.len text)))))) (Named.anon (block)))  ;; +3
    (let nine:(ptr Nine) (call (alloc.create Nine) a))
    (put nine Nine.h 8i64)
    (let hw:HoldsWide (make HoldsWide.w (make Wide.nine nine)))
    (match hw
      (HoldsWide.w [x] (match x (Wide.nine [w9] (set! total (+ total (f64.convert_i64_s (get w9 Nine.h)))))))  ;; +8
      (HoldsWide.none (block)))
    (let link:(ptr Link) (call (alloc.create Link) a))
    (put link Link.s (make Shape.big 2i64 Color.blue))
    (put link Link.next (make Chain.end))
    (let ch:Chain (make Chain.link link))
    (match ch (Chain.link [k] (set! total (+ total (call area (get k Link.s))))) (Chain.end (block)))  ;; +2 = 105
    ;; a result holding a union by value
    (match_result (call found true)
      (ok fo (match fo
               (Outer.holds [inner] (match inner (Inner.pair [pn pf] (set! total (+ total (+ (f64.convert_i64_s (i64.extend_s pn)) pf))))))
               (Outer.empty (block))))                                         ;; +4
      (err e (set! total (- total 100.0))))
    ;; Option of a value struct, and of a union
    (let o:(option.Option Vec2) (make (option.Option Vec2) some (make Vec2 0.5 0.25)))
    (match o
      ((option.Option Vec2) some [v] (set! total (+ total (* 4.0 (get v Vec2.y)))))  ;; +1
      ((option.Option Vec2) none (block)))
    (let os:(option.Option Outer) (make (option.Option Outer) some (make Outer.holds (make Inner.pair 5 0.0))))
    (match os
      ((option.Option Outer) some [so]
       (match so
         (Outer.holds [inner] (match inner (Inner.pair [pn pf] (set! total (+ total (+ (f64.convert_i64_s (i64.extend_s pn)) pf))))))
         (Outer.empty (block))))                                               ;; +5 = 115
      ((option.Option Outer) none (block)))
    (let ou:Outer (make Outer.holds (make Inner.pair 3 1.5)))
    (match ou
      (Outer.holds [inner] (match inner (Inner.pair [pn pf] (set! total (+ total (+ (f64.convert_i64_s (i64.extend_s pn)) pf))))))  ;; +4.5
      (Outer.empty (block)))
    (i32.wrap (i64.trunc_f64_s (* total 2.0)))))                              ;; 239
