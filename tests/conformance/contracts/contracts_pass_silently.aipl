;; @spec 7.6
;; @kind run
;; @out 3 0 2
(module contracts_pass_silently
  (fn clamp [n:i32 lo:i32 hi:i32] -> i32
    (req (lte lo hi))
    (ens (and (gte res lo) (lte res hi)))
    (if (lt n lo) lo (if (gt n hi) hi n)))
  (fn main [] -> i32
    (println "{(call clamp 5 0 3)} {(call clamp -1 0 3)} {(call clamp 2 0 3)}")
    0))
