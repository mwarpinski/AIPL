;; @spec 7.5
;; @kind run
;; @out bound
;; @out sum 3
;; @out i=1
;; @out i=2
;; @out i=3
(module for_bounds_evaluated_once
  (fn bound [] -> i32 (println "bound") 3)
  (fn main [] -> i32
    (let sum:i32 0)
    (for i 0 (call bound) (set! sum (+ sum i)))
    (println "sum {sum}")
    (for i 5 5 (println "never"))
    (for i 1 4 (println "i={i}"))
    0))
