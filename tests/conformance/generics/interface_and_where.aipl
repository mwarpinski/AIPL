;; @spec 4.H
;; @kind run
;; @out 9
(module interface_and_where
  (import cmp)
  (import alloc)
  (fn (largest T) [xs:(arr T)] -> T (where (cmp.Ord T))
    (let best:T (arr.get T xs 0))
    (for i 1 (arr.len xs)
      (when (gt (call (cmp.Ord.compare T) (arr.get T xs i) best) 0) (set! best (arr.get T xs i))))
    best)
  (fn main [] -> i32
    (let xs:(arr i64) (arr.new i64 (call alloc.forever) 3))
    (arr.set i64 xs 0 3i64) (arr.set i64 xs 1 9i64) (arr.set i64 xs 2 4i64)
    (println "{(call (largest i64) xs)}")
    0))
