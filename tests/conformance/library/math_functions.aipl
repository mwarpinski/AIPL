;; @spec 10
;; @kind run
;; @out 3 7 5 -1 10
;; @out -4 1 -3 -1
;; @out 6 81 9
(module math_functions
  (import math)
  (fn main [] -> i32
    (println "{(call math.min 3 7)} {(call math.max 3 7)} {(call math.abs -5)} {(call math.sign -9)} {(call math.clamp 15 0 10)}")
    (println "{(call math.floor_div -7 2)} {(call math.floor_mod -7 2)} {(/ -7 2)} {(% -7 2)}")
    (println "{(call math.gcd 12 18)} {(call math.pow 3 4)} {(call math.isqrt 99)}")
    0))
