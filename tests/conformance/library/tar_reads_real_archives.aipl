;; @out file 1024 664 1700000000 ./exact1024 - 11cb7930473bb0c2
;; @out file 512 664 1700000000 ./exact512 - 64164443bb63e338
;; @out file 2 664 1700000000 ./unicode-üñï-名前.txt - ea46748e171abd2d
;; @out == Python, ustar format, a name split into a prefix and a name
;; @out dir 0 775 1700000000 ./ - -
;; @out dir 0 775 1700000000 ./pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp/ - -
;; @out dir 0 775 1700000000 ./pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp/qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq/ - -
;; @out file 7 664 1700000000 ./pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp/qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq/rrrrrrrrrrrrrrrrrrrrrrrrrrrrrr - 5a958fd0cb043599
;; @out == Python, gnu format, a name twice and other kinds
;; @out file 1 644 1700000000 same - 6b86b273ff34fce1
;; @out file 1 644 1700000000 other - d4735e3a265e16ee
;; @out file 3 644 1700000000 same - 556d7dc3a1153563
;; @out other 0 644 1700000000 chr - -
;; @out other 0 644 1700000000 fifo - -
;; @out find same: entry 2, 3 bytes
;; @out find other: entry 1, 1 bytes
;; @out find missing: none
;; @out == Python, pax format, a global header and a fractional time
;; @out file 3 644 1700000000 fraction - ba7816bf8f01cfea
(module tar_reads_real_archives
  (import tar)
  (import deflate)
  (import encode)
  (import hash)
  (import buf)
  (import str)
  (import io)
  (import alloc)
  (import option)

  (fn kind_name [k:tar.Kind] -> str
    (cond
      ((eq k tar.Kind.file) "file")
      ((eq k tar.Kind.dir) "dir")
      ((eq k tar.Kind.symlink) "symlink")
      ((eq k tar.Kind.hardlink) "hardlink")
      (else "other")))

  ;; the bytes of a gzipped, base64 text
  (fn unpack [a:alloc.Allocator text:str] -> (ptr buf.Buf)
    (let raw:(ptr buf.Buf) (call buf.make a 4096))
    (let out:(ptr buf.Buf) (call buf.make a 16384))
    (match_result (call encode.base64_decode_to raw (call str.from_str text) encode.Alphabet.standard encode.Padding.padded)
      (ok n
        (match_result (call deflate.gzip_decompress_to a out (call buf.bytes raw) 1000000)
          (ok m (call buf.free raw))
          (err e (println "the test's own data is corrupt"))))
      (err at (println "the test's own data is not base64")))
    out)

  ;; one line to an entry: kind, size, mode in octal, modification time, name, link target, and the start of the
  ;; SHA-256 of the contents
  (fn push_sha [o:(ptr buf.Buf) a:alloc.Allocator data:str.Bytes] -> void
    (let d:(ptr buf.Buf) (call buf.make a 64))
    (let h:(ptr buf.Buf) (call buf.make a 64))
    (call hash.digest_to d hash.Algorithm.sha256 data)
    (call encode.hex_to h (call buf.bytes d) false)
    (call buf.push_bytes o (call str.slice (call buf.bytes h) 0 16))
    (call buf.free d)
    (call buf.free h))

  (fn show [a:alloc.Allocator title:str text:str] -> void
    (println "== {title}")
    (let data:(ptr buf.Buf) (call unpack a text))
    (match_result (call tar.open a (call buf.bytes data))
      (ok ar
        (let o:(ptr buf.Buf) (call buf.make a 256))
        (for i 0 (call tar.count ar)
          (call buf.clear o)
          (call buf.push_str o (call kind_name (call tar.kind ar i)))
          (call buf.push_str o " ")
          (call buf.push_int o (call tar.size ar i))
          (call buf.push_str o " ")
          (call buf.push_unsigned o (i64.extend_s (call tar.mode ar i)) 8 false)
          (call buf.push_str o " ")
          (call buf.push_i64 o (call tar.mtime ar i))
          (call buf.push_str o " ")
          (call buf.push_bytes o (call tar.name ar i))
          (call buf.push_str o " ")
          (if (or (eq (call tar.kind ar i) tar.Kind.symlink) (eq (call tar.kind ar i) tar.Kind.hardlink))
            (call buf.push_bytes o (call tar.link ar i))
            (call buf.push_str o "-"))
          (call buf.push_str o " ")
          (if (eq (call tar.kind ar i) tar.Kind.file)
            (call push_sha o a (call tar.data ar i))
            (call buf.push_str o "-"))
          (println "{(call buf.bytes o)}"))
        (call buf.free o)
        (call tar.free ar))
      (err e (println "error: {(get e tar.Error.what)} at {(get e tar.Error.at)}")))
    (call buf.free data))

  ;; find gives the last entry of a name, and an option
  (fn find_demo [a:alloc.Allocator] -> void
    (let text:str "H4sIAAAAAAACA+3VTQrDIBBA4TmKRxh/qucJJSFdlICm969kaVddNDX4vs2AO5HnlOk5y49pFUM4ZtXOyooNNxdS0nCcx6hRjMoJXmWfsjEyKCsY2bavc+6u/6Tq6P8MjgSGVrrY//5j/1ul/zN474lgYPc1y//713b/x5TE+Cv1317uIpbHsvX3/vX/t2Ii/z8AAAAAAAAAAMDX3urMY6IAKAAA")
    (let data:(ptr buf.Buf) (call unpack a text))
    (match_result (call tar.open a (call buf.bytes data))
      (ok ar
        (for k 0 3
          (let want:str (cond ((eq k 0) "same") ((eq k 1) "other") (else "missing")))
          (match (call tar.find ar (call str.from_str want))
            ((option.Option i32) some [i] (println "find {want}: entry {i}, {(get (call tar.data ar i) str.Bytes.len)} bytes"))
            ((option.Option i32) none [] (println "find {want}: none"))))
        (call tar.free ar))
      (err e (println "error")))
    (call buf.free data))

  (fn main [] -> i32
    (let a:alloc.Allocator (call alloc.default))
    (call show a "GNU tar, gnu format, long names" "")
    (call show a "GNU tar, oldgnu format, long names" "")
    (call show a "GNU tar, posix format, long names" "")
    (call show a "GNU tar, ustar format" "")
    (call show a "GNU tar, v7 format" "")
    (call show a "Python, ustar format" "")
    (call show a "Python, gnu format, long names" "")
    (call show a "Python, pax format, long names" "")
    (call show a "Python, ustar format, a name split into a prefix and a name" "H4sIAAAAAAACA+3TPQ7DIAxAYeaeIicIPzH4PB0aqVtKW6nHL2JrhiyISKjvW4y8MDx5tqY7V6jGOov9rG8vMYiqk7pPXpKZojnB+/m65vKl+U+z3RrYPv3DsoRI/zM8Gthe9y8uBj94/7bDGqN/PvTTPyU56K+7/hqimMnRv7st39b752IAAAAAAAAAAAAAAMC4vjQcn9wAKAAA")
    (call show a "Python, gnu format, a name twice and other kinds" "H4sIAAAAAAACA+3VTQrDIBBA4TmKRxh/qucJJSFdlICm969kaVddNDX4vs2AO5HnlOk5y49pFUM4ZtXOyooNNxdS0nCcx6hRjMoJXmWfsjEyKCsY2bavc+6u/6Tq6P8MjgSGVrrY//5j/1ul/zN474lgYPc1y//713b/x5TE+Cv1317uIpbHsvX3/vX/t2Ii/z8AAAAAAAAAAMDX3urMY6IAKAAA")
    (call find_demo a)
    (call show a "Python, pax format, a global header and a fractional time" "H4sIAAAAAAACA+3UzwqCMBzA8Z17ij3B3ObULkHHjr3CNBPBP2AGPn5ZRBB4XER+P5eNXX4w9p2KVLQ/+ulQ+lM5iCD009KqtbXv/XxutElTISvxBdfL6If7eLFOZiuLvm3LbtxVTZ/7ZiOwIuon+k8/+7cmFnKi/+Csle1Yt+XOZK/7Vwl/wGqcB1+Mdd+FnDE/qtS55f51LIxLrMsy7R7nWRJrITX9B+fzgggAAAAAAAAAAAAA4A/cAHo8uOAAKAAA")
    0))
