(module int_shifts_and_bits
  (fn main [] -> i32
    (println "{(shl 1 33)} {(shr -8 1)} {(shru -8 1)}")
    (println "{(rotl 0x80000001 1)} {(rotl 1 33)} {(rotr 1 1)}")
