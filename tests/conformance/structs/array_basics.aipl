;; @spec 4.E
;; @kind run
;; @out 4 0
;; @out 1 4 9
;; @out 0
(module array_basics
  (import alloc)
  (fn main [] -> i32
    (let a:(arr i32) (arr.new i32 (call alloc.default) 4))
    (println "{(arr.len a)} {(arr.get i32 a 0)}")
    (for i 0 (arr.len a) (arr.set i32 a i (* i i)))
    (println "{(arr.get i32 a 1)} {(arr.get i32 a 2)} {(arr.get i32 a 3)}")
    (let e:(arr i32) (arr.new i32 (call alloc.default) 0))
    (println "{(arr.len e)}")
    0))
