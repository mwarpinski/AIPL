;; @spec 4.J
;; @kind run
;; @out 12 15 0
(module match_union_variants
  (union Shape [(circle r:i32) (rect w:i32 h:i32) (dot)])
  (fn area [s:Shape] -> i32
    (match s
      (Shape.circle [r] (* 3 (* r r)))
      (Shape.rect [w h] (* w h))
      (Shape.dot 0)))
  (fn main [] -> i32
    (println "{(call area (make Shape.circle 2))} {(call area (make Shape.rect 3 5))} {(call area (make Shape.dot))}")
    0))
