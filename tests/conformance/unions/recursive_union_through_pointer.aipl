;; @spec 4.J
;; @kind run
;; @out 9
(module recursive_union_through_pointer
  (import alloc)
  (union Shape [(circle r:i32) (rect w:i32 h:i32) (dot)])
  (union List [(nil) (cons head:Shape tail:(ptr Rest))])
  (struct Rest [l:List])
  (fn area [s:Shape] -> i32
    (match s
      (Shape.circle [r] (* 3 (* r r)))
      (Shape.rect [w h] (* w h))
      (Shape.dot 0)))
  (fn cons [a:alloc.Allocator s:Shape rest:List] -> List
    (let r:(ptr Rest) (new Rest a [l:rest]))
    (make List.cons s r))
  (fn total [l:List] -> i32
    (match l
      (List.nil 0)
      (List.cons [h t] (+ (call area h) (call total (get t Rest.l))))))
  (fn main [] -> i32
    (let a:alloc.Allocator (call alloc.default))
    (let l:List (make List.nil))
    (set! l (call cons a (make Shape.rect 2 3) l))
    (set! l (call cons a (make Shape.circle 1) l))
    (println "{(call total l)}")
    0))
